-- ============================================================================
-- alb_nuklear.albi — thin ALB binding for vendor/nuklear (C ABI) v0.2
-- ============================================================================
-- Upstream: https://github.com/immediate-mode-ui/nuklear
-- System include: INCLUDE <alb_nuklear.albi>
-- Place alb_nuklear.dll, alb_glfw.dll, AND glfw3.dll beside the program.
-- ============================================================================

VERSION 0.2

-- Window flags (OR together)
#ALB_NK_WINDOW_BORDER = 1
#ALB_NK_WINDOW_MOVABLE = 2
#ALB_NK_WINDOW_SCALABLE = 4
#ALB_NK_WINDOW_CLOSABLE = 8
#ALB_NK_WINDOW_MINIMIZABLE = 16
#ALB_NK_WINDOW_NO_SCROLLBAR = 32
#ALB_NK_WINDOW_TITLE = 64
#ALB_NK_WINDOW_SCROLL_AUTO_HIDE = 128
#ALB_NK_TEXT_LEFT = 17
#ALB_NK_TEXT_CENTERED = 18
#ALB_NK_TEXT_RIGHT = 20
#ALB_NK_DYNAMIC = 0
#ALB_NK_STATIC = 1
#ALB_NK_TREE_NODE = 0
#ALB_NK_TREE_TAB = 1
#ALB_NK_CHART_LINES = 0
#ALB_NK_CHART_COLUMN = 1
#ALB_NK_THEME_DEFAULT = 0
#ALB_NK_THEME_WHITE = 1
#ALB_NK_THEME_RED = 2
#ALB_NK_THEME_BLUE = 3
#ALB_NK_THEME_DARK = 4
#ALB_NK_EDIT_FIELD = 608
#ALB_NK_EDIT_BOX = 1640
#ALB_NK_SYMBOL_X = 1
#ALB_NK_SYMBOL_PLUS = 11
#ALB_NK_SYMBOL_MINUS = 12
#ALB_NK_SYMBOL_TRIANGLE_RIGHT = 10
#ALB_NK_SYMBOL_CIRCLE_SOLID = 3
#ALB_NK_HEADING_UP = 0
#ALB_NK_POPUP_STATIC = 0
-- Lifecycle
IMPORT_DLL FUNCTION alb_nuklear_version() AS S32 FROM ("alb_nuklear.dll")
IMPORT_DLL FUNCTION alb_nuklear_context_create(desc AS S64, out_ctx AS S64) AS S32 FROM ("alb_nuklear.dll")
IMPORT_DLL FUNCTION alb_nuklear_context_create_simple(width AS S32, height AS S32) AS S64 FROM ("alb_nuklear.dll")
IMPORT_DLL FUNCTION alb_nuklear_context_create_window(width AS S32, height AS S32, visible AS S32, title AS S64) AS S64 FROM ("alb_nuklear.dll")
IMPORT_DLL PROCEDURE alb_nuklear_context_destroy(ctx AS S64) FROM ("alb_nuklear.dll")
IMPORT_DLL FUNCTION alb_nuklear_should_close(ctx AS S64) AS S32 FROM ("alb_nuklear.dll")
IMPORT_DLL FUNCTION alb_nuklear_new_frame(ctx AS S64) AS S32 FROM ("alb_nuklear.dll")
IMPORT_DLL FUNCTION alb_nuklear_render(ctx AS S64) AS S32 FROM ("alb_nuklear.dll")
IMPORT_DLL PROCEDURE alb_nuklear_set_clear_color(ctx AS S64, r AS F64, g AS F64, b AS F64, a AS F64) FROM ("alb_nuklear.dll")
IMPORT_DLL FUNCTION alb_nuklear_context_native(ctx AS S64) AS S64 FROM ("alb_nuklear.dll")
IMPORT_DLL FUNCTION alb_nuklear_context_glfw(ctx AS S64) AS S64 FROM ("alb_nuklear.dll")

-- Windows
IMPORT_DLL FUNCTION alb_nuklear_begin(ctx AS S64, title AS S64, x AS F64, y AS F64, w AS F64, h AS F64, flags AS S32) AS S32 FROM ("alb_nuklear.dll")
IMPORT_DLL FUNCTION alb_nuklear_begin_titled(ctx AS S64, name AS S64, title AS S64, x AS F64, y AS F64, w AS F64, h AS F64, flags AS S32) AS S32 FROM ("alb_nuklear.dll")
IMPORT_DLL PROCEDURE alb_nuklear_end(ctx AS S64) FROM ("alb_nuklear.dll")
IMPORT_DLL FUNCTION alb_nuklear_window_is_closed(ctx AS S64, name AS S64) AS S32 FROM ("alb_nuklear.dll")
IMPORT_DLL FUNCTION alb_nuklear_window_is_hovered(ctx AS S64) AS S32 FROM ("alb_nuklear.dll")
