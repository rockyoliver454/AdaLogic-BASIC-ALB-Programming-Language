BEGIN
VERSION 1.0
INCLUDE "../alb_win32.albi"

LET win = alb_win32_window_create_simple(640, 480)
IF win = 0 THEN
  PRINT "create failed"
ELSE
  FOR frame_idx = 0 TO 119 THEN
    alb_win32_poll_events()
    LET yaw = frame_idx * 0.03
    LET rc = alb_win32_window_fill_client(win, 0.08, 0.08, 0.12)
    IF rc = 0 THEN LET rc = alb_win32_window_draw_prism_tetra(win, yaw, 0.4, 1.0)
    IF rc != 0 THEN PRINT "frame failed " | frame_idx
    alb_win32_sleep_ms(8)
  END FOR
  CALL alb_win32_window_destroy(win)
  PRINT "prism_tetra PASS"
END IF
END