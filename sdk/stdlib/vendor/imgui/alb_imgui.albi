-- ============================================================================
-- alb_imgui.albi — thin ALB binding for vendor/imgui (C ABI)
-- ============================================================================
-- Place alb_imgui.dll, alb_glfw.dll, AND glfw3.dll beside the program.
--   INCLUDE "../stdlib/vendor/imgui/alb_imgui.albi"
--   INCLUDE "../stdlib/vendor/glfw/alb_glfw.albi"
-- ============================================================================

VERSION 0.1

IMPORT_DLL FUNCTION alb_imgui_version() AS S32 FROM ("alb_imgui.dll")

IMPORT_DLL FUNCTION alb_imgui_context_create(desc AS S64, out_ctx AS S64) AS S32 FROM ("alb_imgui.dll")
IMPORT_DLL PROCEDURE alb_imgui_context_destroy(ctx AS S64) FROM ("alb_imgui.dll")

IMPORT_DLL FUNCTION alb_imgui_new_frame(ctx AS S64) AS S32 FROM ("alb_imgui.dll")
IMPORT_DLL FUNCTION alb_imgui_render(ctx AS S64) AS S32 FROM ("alb_imgui.dll")

IMPORT_DLL PROCEDURE alb_imgui_show_demo_window(ctx AS S64, p_open AS S64) FROM ("alb_imgui.dll")
IMPORT_DLL FUNCTION alb_imgui_want_capture_mouse(ctx AS S64) AS S32 FROM ("alb_imgui.dll")
IMPORT_DLL FUNCTION alb_imgui_want_capture_keyboard(ctx AS S64) AS S32 FROM ("alb_imgui.dll")

IMPORT_DLL FUNCTION alb_imgui_begin(ctx AS S64, name AS S64, p_open AS S64) AS S32 FROM ("alb_imgui.dll")
IMPORT_DLL PROCEDURE alb_imgui_end(ctx AS S64) FROM ("alb_imgui.dll")

IMPORT_DLL PROCEDURE alb_imgui_text(ctx AS S64, msg AS S64) FROM ("alb_imgui.dll")
IMPORT_DLL PROCEDURE alb_imgui_separator(ctx AS S64) FROM ("alb_imgui.dll")
IMPORT_DLL PROCEDURE alb_imgui_same_line(ctx AS S64) FROM ("alb_imgui.dll")

IMPORT_DLL FUNCTION alb_imgui_button(ctx AS S64, label AS S64) AS S32 FROM ("alb_imgui.dll")
IMPORT_DLL FUNCTION alb_imgui_checkbox(ctx AS S64, label AS S64, v AS S64) AS S32 FROM ("alb_imgui.dll")
IMPORT_DLL FUNCTION alb_imgui_slider_float(ctx AS S64, label AS S64, v AS S64, v_min AS F64, v_max AS F64) AS S32 FROM ("alb_imgui.dll")
IMPORT_DLL FUNCTION alb_imgui_slider_int(ctx AS S64, label AS S64, v AS S64, v_min AS S32, v_max AS S32) AS S32 FROM ("alb_imgui.dll")
IMPORT_DLL FUNCTION alb_imgui_color_edit3(ctx AS S64, label AS S64, col AS S64) AS S32 FROM ("alb_imgui.dll")
IMPORT_DLL FUNCTION alb_imgui_color_edit4(ctx AS S64, label AS S64, col AS S64) AS S32 FROM ("alb_imgui.dll")

IMPORT_DLL FUNCTION alb_imgui_context_native(ctx AS S64) AS S64 FROM ("alb_imgui.dll")

IMPORT_DLL FUNCTION alb_imgui_test_demo_frames(frames AS S32) AS S32 FROM ("alb_imgui.dll")
IMPORT_DLL FUNCTION alb_imgui_test_widgets_frames(frames AS S32) AS S32 FROM ("alb_imgui.dll")
