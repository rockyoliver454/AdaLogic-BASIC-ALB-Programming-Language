BEGIN
VERSION 1.0
INCLUDE <alb_nuklear.albi>

LET nk AS S64 = 0
LET rc AS S32 = 0
LET i AS S32 = 0
LET flags AS S32 = 71
LET win_open AS S32 = 0
LET clicked AS S32 = 0

PRINT "nk string probe"
LET nk = alb_nuklear_context_create_window(640, 480, 1, "ALB Nuklear Probe")
PRINT "nk=" | nk
IF nk != 0 THEN
  FOR i = 1 TO 60 THEN
    LET rc = alb_nuklear_should_close(nk)
    IF rc != 0 THEN
      LET i = 60
    ELSE
      LET rc = alb_nuklear_new_frame(nk)
      LET win_open = alb_nuklear_begin(nk, "Control", 20.0, 20.0, 400.0, 300.0, flags)
      IF win_open != 0 THEN
        CALL alb_nuklear_layout_row_dynamic(nk, 30.0, 1)
        CALL alb_nuklear_label(nk, "Hello from pure ALB", 17)
        LET clicked = alb_nuklear_button_label(nk, "Click me")
        IF clicked != 0 THEN
          PRINT "clicked"
        END IF
      END IF
      CALL alb_nuklear_end(nk)
      LET rc = alb_nuklear_render(nk)
    END IF
  END FOR
  CALL alb_nuklear_context_destroy(nk)
  PRINT "nk probe done"
END IF
END