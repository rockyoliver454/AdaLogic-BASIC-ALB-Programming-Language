#SHAPE_COUNT = 7
#BLAS_MODE_COUNT = 5

BEGIN
VERSION 1.0
INCLUDE <alb_gfx.albi>
INCLUDE <alb_openblas.albi>
INCLUDE <alb_nuklear.albi>

LET i AS S32 = 0
LET rc AS S32 = 0
PRINT "consts ok count=" | #SHAPE_COUNT
FOR i = 0 TO #SHAPE_COUNT - 1 THEN
  PRINT "i=" | i
END FOR
LET rc = alb_openblas_test_all()
PRINT "blas=" | rc
LET rc = alb_nuklear_test_kitchen_frames(8)
PRINT "nk=" | rc
LET ctx AS S64 = gfx_init(640, 480)
PRINT "ctx=" | ctx
IF ctx != 0 THEN
  LET verts AS S64 = gfx_alloc_memory(84)
  LET tint AS F64 = 0.5
  LET ddot AS F64 = 0.0
  LET x AS S64 = gfx_alloc_memory(24)
  LET y AS S64 = gfx_alloc_memory(24)
  CALL gfx_write_f32(x, 0, 1.0)
  CALL gfx_write_f32(x, 1, 0.5)
  CALL gfx_write_f32(x, 2, 0.25)
  CALL gfx_write_f32(y, 0, 0.8)
  CALL gfx_write_f32(y, 1, 0.4)
  CALL gfx_write_f32(y, 2, 0.2)
  LET ddot = alb_openblas_ddot(3, x, 1, y, 1)
  LET tint = 0.2 + 0.5 * ddot
  CALL gfx_write_f32(verts, 0, 0.0)
  CALL gfx_write_f32(verts, 1, 0.75)
  CALL gfx_write_f32(verts, 2, 0.0)
  CALL gfx_write_f32(verts, 3, 1.0)
  CALL gfx_write_f32(verts, 4, tint)
  CALL gfx_write_f32(verts, 5, 0.2)
  CALL gfx_write_f32(verts, 6, 1.0)
  CALL gfx_write_f32(verts, 7, -0.75)
  CALL gfx_write_f32(verts, 8, -0.7)
  CALL gfx_write_f32(verts, 9, 0.0)
  CALL gfx_write_f32(verts, 10, tint)
  CALL gfx_write_f32(verts, 11, 1.0)
  CALL gfx_write_f32(verts, 12, 0.25)
  CALL gfx_write_f32(verts, 13, 1.0)
  CALL gfx_write_f32(verts, 14, 0.75)
  CALL gfx_write_f32(verts, 15, -0.7)
  CALL gfx_write_f32(verts, 16, 0.0)
  CALL gfx_write_f32(verts, 17, 0.25)
  CALL gfx_write_f32(verts, 18, tint)
  CALL gfx_write_f32(verts, 19, 1.0)
  CALL gfx_write_f32(verts, 20, 1.0)
  LET vb AS S64 = gfx_buffer_create(ctx, 84, #GFX_BUFFER_USAGE_DYNAMIC)
  CALL gfx_buffer_update(ctx, vb, 0, 84, verts)
  LET pipe AS S64 = gfx_pipeline_create(ctx, 0, 0, #GFX_TOPOLOGY_TRIANGLELIST)
  CALL gfx_pipeline_bind(ctx, pipe)
  CALL gfx_bind_vertex_buffer(ctx, vb)
  LET frame AS S32 = 0
  LET st AS S32 = 0
  FOR frame = 1 TO 60 THEN
    CALL gfx_poll_events()
    LET st = gfx_begin_frame(ctx)
    LET st = gfx_clear(ctx, 0.04, 0.05, 0.09, 1.0)
    CALL gfx_draw_arrays(ctx, 3, 0)
    LET st = gfx_end_frame(ctx, 1)
  END FOR
  CALL gfx_buffer_destroy(ctx, vb)
  CALL gfx_free_memory(verts)
  CALL gfx_free_memory(x)
  CALL gfx_free_memory(y)
  CALL gfx_shutdown(ctx)
  PRINT "gfx live ok"
END IF
PRINT "ALL OK"
END
