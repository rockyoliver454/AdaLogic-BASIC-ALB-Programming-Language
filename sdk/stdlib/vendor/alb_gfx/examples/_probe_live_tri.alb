BEGIN
VERSION 1.0
INCLUDE <alb_gfx.albi>
INCLUDE <alb_openblas.albi>
INCLUDE <alb_nuklear.albi>
PRINT "live-tri start"
LET gfx AS S64 = gfx_init(640, 400)
LET nk AS S64 = alb_nuklear_context_create_window(400, 500, 1, "CTRL")
LET verts AS S64 = gfx_alloc_memory(256)
LET vb AS S64 = gfx_buffer_create(gfx, 256, #GFX_BUFFER_USAGE_DYNAMIC)
LET pipe AS S64 = gfx_pipeline_create(gfx, 0, 0, #GFX_TOPOLOGY_TRIANGLELIST)
LET i AS S32 = 0
LET st AS S32 = 0
LET win_open AS S32 = 0
LET rot AS F64 = 0.0
LET cs AS F64 = 0.0
LET sn AS F64 = 0.0
LET x0 AS F64 = 0.0
LET y0 AS F64 = 0.0
FOR i = 1 TO 60 THEN
  CALL gfx_poll_events()
  LET st = alb_nuklear_new_frame(nk)
  LET win_open = alb_nuklear_begin(nk, "Panel", 8.0, 8.0, 300.0, 200.0, 87)
  IF win_open != 0 THEN
    CALL alb_nuklear_layout_row_dynamic(nk, 22.0, 1)
    CALL alb_nuklear_label(nk, "tri live", #ALB_NK_TEXT_LEFT)
  END IF
  CALL alb_nuklear_end(nk)
  LET st = alb_nuklear_render(nk)
  LET rot = rot + 0.05
  LET cs = COS(rot)
  LET sn = SIN(rot)
  LET x0 = 0.0 * cs - 0.5 * sn
  LET y0 = 0.0 * sn + 0.5 * cs
  CALL gfx_write_f32(verts, 0, x0)
  CALL gfx_write_f32(verts, 1, y0)
  CALL gfx_write_f32(verts, 2, 0.0)
  CALL gfx_write_f32(verts, 3, 0.2)
  CALL gfx_write_f32(verts, 4, 0.8)
  CALL gfx_write_f32(verts, 5, 1.0)
  CALL gfx_write_f32(verts, 6, 1.0)
  CALL gfx_write_f32(verts, 7, 0.5)
  CALL gfx_write_f32(verts, 8, -0.4)
  CALL gfx_write_f32(verts, 9, 0.0)
  CALL gfx_write_f32(verts, 10, 0.2)
  CALL gfx_write_f32(verts, 11, 0.8)
  CALL gfx_write_f32(verts, 12, 1.0)
  CALL gfx_write_f32(verts, 13, 1.0)
  CALL gfx_write_f32(verts, 14, -0.5)
  CALL gfx_write_f32(verts, 15, -0.4)
  CALL gfx_write_f32(verts, 16, 0.0)
  CALL gfx_write_f32(verts, 17, 0.2)
  CALL gfx_write_f32(verts, 18, 0.8)
  CALL gfx_write_f32(verts, 19, 1.0)
  CALL gfx_write_f32(verts, 20, 1.0)
  LET st = gfx_buffer_update(vb, verts, 0, 84)
  LET st = gfx_begin_frame(gfx)
  LET st = gfx_clear(gfx, 0.05, 0.1, 0.2, 1.0)
  CALL gfx_pipeline_bind(gfx, pipe)
  CALL gfx_bind_vertex_buffer(gfx, vb, 0, 28)
  CALL gfx_draw_arrays(gfx, 0, 3)
  LET st = gfx_end_frame(gfx, 1)
END FOR
CALL alb_nuklear_context_destroy(nk)
CALL gfx_shutdown(gfx)
PRINT "live-tri OK"
END
