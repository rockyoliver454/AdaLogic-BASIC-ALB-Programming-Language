BEGIN
VERSION 1.0
INCLUDE "../alb_opengl.albi"

-- Raw alb_gl* clear-cycle harness (no DLL test_*).
LET ctx AS S64 = alb_opengl_context_create_simple(320, 240)
IF ctx = 0 THEN
  PRINT "opengl clear_cycle FAIL create"
ELSE
  LET i AS S32 = 0
  LET status AS S32 = 0
  LET fails AS S32 = 0
  FOR i = 0 TO 59 THEN
    LET t AS F64 = i * 0.12
    LET r AS F64 = 0.1 + 0.5 * (0.5 + 0.5 * SIN(t))
    LET g AS F64 = 0.2 + 0.4 * (0.5 + 0.5 * SIN(t + 2.0))
    LET b AS F64 = 0.3 + 0.5 * (0.5 + 0.5 * SIN(t + 4.0))
    LET status = alb_opengl_context_begin_frame(ctx)
    IF status = 0 THEN LET status = alb_opengl_context_clear(ctx, r, g, b, 1.0)
    IF status = 0 THEN
      CALL alb_glClearColor(r, g, b, 1.0)
      CALL alb_glClear(#ALB_GL_COLOR_BUFFER_BIT)
    END IF
    IF status = 0 THEN LET status = alb_opengl_context_end_frame(ctx, 0)
    IF status != 0 THEN LET fails = fails + 1
  END FOR
  CALL alb_opengl_context_destroy(ctx)
  IF fails = 0 THEN
    PRINT "opengl clear_cycle PASS"
  ELSE
    PRINT "opengl clear_cycle FAIL " | fails
  END IF
END IF
END
