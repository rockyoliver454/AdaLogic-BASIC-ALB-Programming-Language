#ALB_GL_GEQUAL = 518
#ALB_GL_ALWAYS = 519

#ALB_GL_ZERO = 0
#ALB_GL_ONE = 1
#ALB_GL_SRC_ALPHA = 770
#ALB_GL_ONE_MINUS_SRC_ALPHA = 771

#ALB_GL_FRONT = 1028
#ALB_GL_BACK = 1029
#ALB_GL_FRONT_AND_BACK = 1032
#ALB_GL_CW = 2304
#ALB_GL_CCW = 2305
#ALB_GL_POINT = 6912
#ALB_GL_LINE = 6913
#ALB_GL_FILL = 6914

#ALB_GL_DEPTH_TEST = 2929
#ALB_GL_CULL_FACE = 2884
#ALB_GL_BLEND = 3042
#ALB_GL_SCISSOR_TEST = 3089
#ALB_GL_TEXTURE_2D = 3553
#ALB_GL_LIGHTING = 2896

#ALB_GL_MODELVIEW = 5888
#ALB_GL_PROJECTION = 5889
#ALB_GL_TEXTURE = 5890

#ALB_GL_VERTEX_ARRAY = 32884
#ALB_GL_NORMAL_ARRAY = 32885
#ALB_GL_COLOR_ARRAY = 32886
#ALB_GL_TEXTURE_COORD_ARRAY = 32888

#ALB_GL_TEXTURE_MAG_FILTER = 10240
#ALB_GL_TEXTURE_MIN_FILTER = 10241
#ALB_GL_NEAREST = 9728
#ALB_GL_LINEAR = 9729
#ALB_GL_RGBA = 6408
#ALB_GL_RGB = 6407
#ALB_GL_DEPTH_COMPONENT = 6402

#ALB_GL_ARRAY_BUFFER = 34962
#ALB_GL_ELEMENT_ARRAY_BUFFER = 34963
#ALB_GL_STREAM_DRAW = 35040
#ALB_GL_STATIC_DRAW = 35044
#ALB_GL_DYNAMIC_DRAW = 35048

#ALB_GL_FRAGMENT_SHADER = 35632
