IMPORT_DLL PROCEDURE alb_glDrawArrays(mode AS S32, first AS S32, count AS S32) FROM ("alb_opengl.dll")
IMPORT_DLL PROCEDURE alb_glDrawElements(mode AS S32, count AS S32, gltype AS S32, indices_ptr AS S64) FROM ("alb_opengl.dll")

-- Textures
