-- ============================================================================
-- alb_opengl.albi â€” REAL thin ALB binding for vendor/opengl (ABI 0.3)
-- ============================================================================
-- Place alb_opengl.dll beside the program (uses system opengl32.dll).
--   INCLUDE "../stdlib/vendor/opengl/alb_opengl.albi"
--
-- DLL = WGL lifecycle + raw alb_gl* only. Application builds demos itself.
-- Handles are opaque S64. Status 0 = OK.
-- ALB | is STRING CONCAT (not bitwise OR).
-- ============================================================================

VERSION 0.3

-- Status
#ALB_OPENGL_OK = 0
#ALB_OPENGL_ERR_INVALID_ARG = 1
#ALB_OPENGL_ERR_NO_LOADER = 2
#ALB_OPENGL_ERR_WINDOW = 3
#ALB_OPENGL_ERR_DC = 4
#ALB_OPENGL_ERR_PIXEL_FORMAT = 5
#ALB_OPENGL_ERR_CONTEXT = 6
#ALB_OPENGL_ERR_CURRENT = 7
#ALB_OPENGL_ERR_HWND = 8
#ALB_OPENGL_ERR_NOT_READY = 9
#ALB_OPENGL_ERR_INTERNAL = 100

-- GL constants (ALB_GL_*)
#ALB_GL_FALSE = 0
#ALB_GL_TRUE = 1
#ALB_GL_FLOAT = 5126
#ALB_GL_UNSIGNED_BYTE = 5121
#ALB_GL_UNSIGNED_INT = 5125
