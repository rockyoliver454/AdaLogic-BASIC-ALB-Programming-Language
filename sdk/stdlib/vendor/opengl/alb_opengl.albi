-- WGL lifecycle
IMPORT_DLL FUNCTION alb_opengl_version() AS S32 FROM ("alb_opengl.dll")
IMPORT_DLL FUNCTION alb_opengl_loader_init() AS S32 FROM ("alb_opengl.dll")
IMPORT_DLL PROCEDURE alb_opengl_loader_shutdown() FROM ("alb_opengl.dll")

IMPORT_DLL FUNCTION alb_opengl_device_create(desc AS S64, out_device AS S64) AS S32 FROM ("alb_opengl.dll")
IMPORT_DLL PROCEDURE alb_opengl_device_destroy(device AS S64) FROM ("alb_opengl.dll")
IMPORT_DLL FUNCTION alb_opengl_device_native(device AS S64) AS S64 FROM ("alb_opengl.dll")
IMPORT_DLL FUNCTION alb_opengl_device_hdc(device AS S64) AS S64 FROM ("alb_opengl.dll")
IMPORT_DLL FUNCTION alb_opengl_device_hwnd(device AS S64) AS S64 FROM ("alb_opengl.dll")
IMPORT_DLL FUNCTION alb_opengl_device_make_current(device AS S64) AS S32 FROM ("alb_opengl.dll")

IMPORT_DLL FUNCTION alb_opengl_context_create(desc AS S64, out_ctx AS S64) AS S32 FROM ("alb_opengl.dll")
IMPORT_DLL FUNCTION alb_opengl_context_create_simple(width AS S32, height AS S32) AS S64 FROM ("alb_opengl.dll")
IMPORT_DLL PROCEDURE alb_opengl_context_destroy(ctx AS S64) FROM ("alb_opengl.dll")
IMPORT_DLL FUNCTION alb_opengl_context_resize(ctx AS S64, width AS S32, height AS S32) AS S32 FROM ("alb_opengl.dll")
IMPORT_DLL FUNCTION alb_opengl_context_begin_frame(ctx AS S64) AS S32 FROM ("alb_opengl.dll")
IMPORT_DLL FUNCTION alb_opengl_context_clear(ctx AS S64, r AS F64, g AS F64, b AS F64, a AS F64) AS S32 FROM ("alb_opengl.dll")
IMPORT_DLL FUNCTION alb_opengl_context_end_frame(ctx AS S64, vsync AS S32) AS S32 FROM ("alb_opengl.dll")
IMPORT_DLL FUNCTION alb_opengl_context_device(ctx AS S64) AS S64 FROM ("alb_opengl.dll")
IMPORT_DLL FUNCTION alb_opengl_context_width(ctx AS S64) AS S32 FROM ("alb_opengl.dll")
IMPORT_DLL FUNCTION alb_opengl_context_height(ctx AS S64) AS S32 FROM ("alb_opengl.dll")
IMPORT_DLL FUNCTION alb_opengl_context_should_close(ctx AS S64) AS S32 FROM ("alb_opengl.dll")
IMPORT_DLL PROCEDURE alb_opengl_context_set_should_close(ctx AS S64, v AS S32) FROM ("alb_opengl.dll")
IMPORT_DLL PROCEDURE alb_opengl_poll_events() FROM ("alb_opengl.dll")
IMPORT_DLL PROCEDURE alb_opengl_sleep_ms(ms AS S32) FROM ("alb_opengl.dll")

IMPORT_DLL PROCEDURE alb_gl_load() FROM ("alb_opengl.dll")

-- Memory helpers
IMPORT_DLL FUNCTION alb_gl_alloc(size AS S64) AS S64 FROM ("alb_opengl.dll")
IMPORT_DLL PROCEDURE alb_gl_free(data_ptr AS S64) FROM ("alb_opengl.dll")
IMPORT_DLL PROCEDURE alb_gl_write_f32(data_ptr AS S64, index AS S32, value AS F64) FROM ("alb_opengl.dll")
IMPORT_DLL PROCEDURE alb_gl_write_i32(data_ptr AS S64, index AS S32, value AS S32) FROM ("alb_opengl.dll")
IMPORT_DLL FUNCTION alb_gl_read_u32(data_ptr AS S64, index AS S32) AS S32 FROM ("alb_opengl.dll")

