-- ====================================================================
-- C64_INPUT.ALBI
-- Keyboard helpers for ALB-65 (SDL scancodes mapped to C64 matrix).
-- ====================================================================

#C64_KEY_A = 4
#C64_KEY_D = 7
#C64_KEY_S = 22
#C64_KEY_W = 26
#C64_KEY_Q = 20
#C64_KEY_E = 8
#C64_KEY_SPACE = 44
#C64_KEY_RETURN = 40
#C64_KEY_ESCAPE = 41
#C64_KEY_LEFT = 80
#C64_KEY_RIGHT = 79
#C64_KEY_UP = 82
#C64_KEY_DOWN = 81
#C64_KEY_1 = 30
#C64_KEY_2 = 31
#C64_KEY_3 = 32
#C64_KEY_4 = 33
#C64_KEY_5 = 34
#C64_KEY_6 = 35
#C64_KEY_7 = 36
#C64_KEY_8 = 37
#C64_KEY_9 = 38
#C64_KEY_0 = 39

FUNCTION C64In_Down(code AS U8) AS BOOL
    IF KEY(code) > 0 THEN RETURN TRUE END IF
    RETURN FALSE
END FUNCTION

FUNCTION C64In_Left() AS BOOL
    IF C64In_Down(#C64_KEY_LEFT) THEN RETURN TRUE END IF
    IF C64In_Down(#C64_KEY_A) THEN RETURN TRUE END IF
    RETURN FALSE
END FUNCTION

FUNCTION C64In_Right() AS BOOL
    IF C64In_Down(#C64_KEY_RIGHT) THEN RETURN TRUE END IF
    IF C64In_Down(#C64_KEY_D) THEN RETURN TRUE END IF
    RETURN FALSE
END FUNCTION

FUNCTION C64In_Up() AS BOOL
    IF C64In_Down(#C64_KEY_UP) THEN RETURN TRUE END IF
    IF C64In_Down(#C64_KEY_W) THEN RETURN TRUE END IF
    RETURN FALSE
END FUNCTION

FUNCTION C64In_DownDir() AS BOOL
    IF C64In_Down(#C64_KEY_DOWN) THEN RETURN TRUE END IF
    IF C64In_Down(#C64_KEY_S) THEN RETURN TRUE END IF
    RETURN FALSE
END FUNCTION

FUNCTION C64In_Fire() AS BOOL
  IF C64In_Down(#C64_KEY_SPACE) THEN RETURN TRUE END IF
    IF C64In_Down(#C64_KEY_RETURN) THEN RETURN TRUE END IF
    RETURN FALSE
END FUNCTION

FUNCTION C64In_Cancel() AS BOOL
    IF C64In_Down(#C64_KEY_ESCAPE) THEN RETURN TRUE END IF
    IF C64In_Down(#C64_KEY_Q) THEN RETURN TRUE END IF
    RETURN FALSE
END FUNCTION
