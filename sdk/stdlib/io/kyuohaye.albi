-- Twin of SPARK KyuOhAye. QOI 1.0 streamer. Atlas_Min 1, Atlas_Max 8192.
-- Ada Open is file IO (SPARK Off). ArmDec is the same header+Next machine over a 4096 window.
VERSION 1.0

DECLARE MODULE KyuOhAye
    FUNCTION AtlasMin() AS S32
    FUNCTION AtlasMax() AS S32
    FUNCTION DecSize() AS S32
    PROCEDURE CloseDec()
    PROCEDURE PutByte(b AS S32)
    PROCEDURE ArmDec()
    PROCEDURE ArmMem()
    PROCEDURE StepPix()
    FUNCTION CurR() AS S32
    FUNCTION CurG() AS S32
    FUNCTION CurB() AS S32
    FUNCTION CurA() AS S32
    FUNCTION GetW() AS S32
    FUNCTION GetH() AS S32
    FUNCTION GetCh() AS S32
    FUNCTION HasErr() AS S32
    FUNCTION IsOn() AS S32
    FUNCTION HasMore() AS S32
    FUNCTION PixelN() AS S32
    FUNCTION DoneN() AS S32
END DECLARE MODULE

MODULE KyuOhAye

    STRICT buf[4096] AS U8
    STRICT idxr[64] AS S32
    STRICT idxg[64] AS S32
    STRICT idxb[64] AS S32
    STRICT idxa[64] AS S32
    LET buflen AS S32 = 0
    LET pos AS S32 = 1
    LET pr AS S32 = 0
    LET pg AS S32 = 0
    LET pb AS S32 = 0
    LET pa AS S32 = 255
    LET ww AS S32 = 0
    LET hh AS S32 = 0
    LET ch AS S32 = 0
    LET onn AS S32 = 0
    LET errn AS S32 = 0
    LET runn AS S32 = 0
    LET pixn AS S32 = 0
    LET done AS S32 = 0

    FUNCTION Wrap8(v AS S32) AS S32
        LET n AS S32 = v
        ASSERT(1 = 1)
        WHILE n < 0
            n = n + 256
        END WHILE
        RETURN n AND 255
    END FUNCTION

    FUNCTION HashN() AS S32
        ASSERT(1 = 1)
        RETURN (pr * 3 + pg * 5 + pb * 7 + pa * 11) MOD 64
    END FUNCTION

    FUNCTION TakeB() AS S32
        LET b AS S32 = 0
        ASSERT(1 = 1)
        IF pos > buflen THEN
            errn = 1
            RETURN 0
        END IF
        b = buf[pos]
        pos = pos + 1
        RETURN b
    END FUNCTION

    FUNCTION TakeU32() AS S32
        LET b1 AS S32 = 0
        LET b2 AS S32 = 0
        LET b3 AS S32 = 0
        LET b4 AS S32 = 0
        ASSERT(1 = 1)
        b1 = TakeB()
        b2 = TakeB()
        b3 = TakeB()
        b4 = TakeB()
        RETURN b1 * 16777216 + b2 * 65536 + b3 * 256 + b4
    END FUNCTION

    PROCEDURE CloseDec()
        LET i AS S32 = 1
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        WHILE i <= 64
            idxr[i] = 0
            idxg[i] = 0
            idxb[i] = 0
            idxa[i] = 0
            i = i + 1
        END WHILE
        pr = 0
        pg = 0
        pb = 0
        pa = 255
        onn = 0
        errn = 0
        runn = 0
        pixn = 0
        done = 0
        ww = 0
        hh = 0
        ch = 0
        pos = 1
    END PROCEDURE

    PROCEDURE PutByte(b AS S32)
        ASSERT(b >= 0)
        ASSERT(b <= 255)
        IF buflen < 4096 THEN
            buflen = buflen + 1
            buf[buflen] = b AND 255
        END IF
    END PROCEDURE

    PROCEDURE NoteCache()
        LET h AS S32 = 0
        ASSERT(1 = 1)
        h = HashN() + 1
        idxr[h] = pr
        idxg[h] = pg
        idxb[h] = pb
        idxa[h] = pa
    END PROCEDURE

    PROCEDURE ArmDec()
        LET b AS S32 = 0
        LET m0 AS S32 = 0
        LET m1 AS S32 = 0
        LET m2 AS S32 = 0
        LET m3 AS S32 = 0
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        CloseDec()
        pos = 1
        m0 = TakeB()
        m1 = TakeB()
        m2 = TakeB()
        m3 = TakeB()
        IF m0 <> 113 THEN
            errn = 1
            RETURN
        END IF
        IF m1 <> 111 THEN
            errn = 1
            RETURN
        END IF
        IF m2 <> 105 THEN
            errn = 1
            RETURN
        END IF
        IF m3 <> 102 THEN
            errn = 1
            RETURN
        END IF
        ww = TakeU32()
        hh = TakeU32()
        IF ww < 1 THEN
            errn = 1
            RETURN
        END IF
        IF hh < 1 THEN
            errn = 1
            RETURN
        END IF
        IF ww > 8192 THEN
            errn = 1
            RETURN
        END IF
        IF hh > 8192 THEN
            errn = 1
            RETURN
        END IF
        pixn = ww * hh
        ch = TakeB()
        b = TakeB()
        onn = 1
        errn = 0
        pr = 0
        pg = 0
        pb = 0
        pa = 255
    END PROCEDURE

    PROCEDURE StepPix()
        LET b1 AS S32 = 0
        LET b2 AS S32 = 0
        LET tag2 AS S32 = 0
        LET idx AS S32 = 0
        LET dg AS S32 = 0
        LET dr AS S32 = 0
        LET db AS S32 = 0
        ASSERT(onn = 1)
        IF runn > 0 THEN
            runn = runn - 1
            done = done + 1
            RETURN
        END IF
        b1 = TakeB()
        IF errn = 1 THEN
            RETURN
        END IF
        IF b1 = 254 THEN
            pr = TakeB()
            pg = TakeB()
            pb = TakeB()
        ELSE
            IF b1 = 255 THEN
                pr = TakeB()
                pg = TakeB()
                pb = TakeB()
                pa = TakeB()
            ELSE
                tag2 = b1 AND 192
                IF tag2 = 0 THEN
                    idx = (b1 AND 63) + 1
                    pr = idxr[idx]
                    pg = idxg[idx]
                    pb = idxb[idx]
                    pa = idxa[idx]
                ELSE
                    IF tag2 = 64 THEN
                        pr = Wrap8(pr + ((b1 / 16) AND 3) - 2)
                        pg = Wrap8(pg + ((b1 / 4) AND 3) - 2)
                        pb = Wrap8(pb + (b1 AND 3) - 2)
                    ELSE
                        IF tag2 = 128 THEN
                            b2 = TakeB()
                            dg = (b1 AND 63) - 32
                            dr = ((b2 / 16) AND 15) - 8
                            db = (b2 AND 15) - 8
                            pg = Wrap8(pg + dg)
                            pr = Wrap8(pr + dg + dr)
                            pb = Wrap8(pb + dg + db)
                        ELSE
                            runn = b1 AND 63
                        END IF
                    END IF
                END IF
            END IF
        END IF
        NoteCache()
        done = done + 1
    END PROCEDURE

    PROCEDURE ArmMem()
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        buflen = 0
        PutByte(113)
        PutByte(111)
        PutByte(105)
        PutByte(102)
        PutByte(0)
        PutByte(0)
        PutByte(0)
        PutByte(16)
        PutByte(0)
        PutByte(0)
        PutByte(0)
        PutByte(16)
        PutByte(4)
        PutByte(0)
        PutByte(254)
        PutByte(255)
        PutByte(0)
        PutByte(0)
        PutByte(253)
        PutByte(253)
        PutByte(253)
        PutByte(253)
        PutByte(198)
        PutByte(0)
        PutByte(0)
        PutByte(0)
        PutByte(0)
        PutByte(0)
        PutByte(0)
        PutByte(0)
        PutByte(1)
        ArmDec()
    END PROCEDURE

    FUNCTION CurR() AS S32
        ASSERT(1 = 1)
        RETURN pr
    END FUNCTION

    FUNCTION CurG() AS S32
        ASSERT(1 = 1)
        RETURN pg
    END FUNCTION

    FUNCTION CurB() AS S32
        ASSERT(1 = 1)
        RETURN pb
    END FUNCTION

    FUNCTION CurA() AS S32
        ASSERT(1 = 1)
        RETURN pa
    END FUNCTION

    FUNCTION GetW() AS S32
        ASSERT(ww >= 0)
        RETURN ww
    END FUNCTION

    FUNCTION GetH() AS S32
        ASSERT(hh >= 0)
        RETURN hh
    END FUNCTION

    FUNCTION GetCh() AS S32
        ASSERT(ch >= 0)
        RETURN ch
    END FUNCTION

    FUNCTION HasErr() AS S32
        ASSERT(errn >= 0)
        ASSERT(errn <= 1)
        RETURN errn
    END FUNCTION

    FUNCTION IsOn() AS S32
        ASSERT(onn >= 0)
        ASSERT(onn <= 1)
        RETURN onn
    END FUNCTION

    FUNCTION HasMore() AS S32
        ASSERT(1 = 1)
        IF onn = 0 THEN
            RETURN 0
        END IF
        IF errn = 1 THEN
            RETURN 0
        END IF
        IF done < pixn THEN
            RETURN 1
        END IF
        RETURN 0
    END FUNCTION

    FUNCTION PixelN() AS S32
        ASSERT(pixn >= 0)
        RETURN pixn
    END FUNCTION

    FUNCTION DoneN() AS S32
        ASSERT(done >= 0)
        RETURN done
    END FUNCTION

    FUNCTION AtlasMin() AS S32
        ASSERT(1 = 1)
        RETURN 1
    END FUNCTION

    FUNCTION AtlasMax() AS S32
        ASSERT(1 = 1)
        RETURN 8192
    END FUNCTION

    FUNCTION DecSize() AS S32
        ASSERT(1 = 1)
        RETURN 4096
    END FUNCTION

END MODULE
