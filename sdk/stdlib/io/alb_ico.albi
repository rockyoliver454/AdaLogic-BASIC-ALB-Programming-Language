-- ============================================================================
-- ALBIco — Windows ICO directory
-- ============================================================================
-- Reserved 0, type 1, then Count() images. W0()/H0()/Bpp0() describe
-- image 0. Width/height 0 in the directory means 256.
--
-- From release\examples\:
--   INCLUDE "../stdlib/io/alb_ico.albi"
--
-- ProbeBuf()  0 ok. Does not decode the DIB or PNG payload — only the
-- directory. CUR (type 2) is status 5.
-- ============================================================================

VERSION 1.0

DECLARE MODULE ALBIco
    PROCEDURE Reset()
    PROCEDURE PutByte(b AS U8)
    FUNCTION ProbeBuf() AS S32
    FUNCTION Count() AS S32
    FUNCTION W0() AS S32
    FUNCTION H0() AS S32
    FUNCTION Bpp0() AS S32
    FUNCTION Status() AS S32
END DECLARE MODULE

MODULE ALBIco

    -- 1-based window. ICONDIR + first ICONDIRENTRY. Not a BMP decoder.
    STRICT src[4096] AS U8
    LET srclen AS S32 = 0
    LET cnt AS S32 = 0
    LET w0 AS S32 = 0
    LET h0 AS S32 = 0
    LET bpp0 AS S32 = 0
    LET lastst AS S32 = 5

    PROCEDURE Reset()
        srclen = 0
        cnt = 0
        w0 = 0
        h0 = 0
        bpp0 = 0
        lastst = 5
    END PROCEDURE

    PROCEDURE PutByte(b AS U8)
        IF srclen >= 4096 THEN
            RETURN
        END IF
        srclen = srclen + 1
        src[srclen] = b
    END PROCEDURE

    FUNCTION GetU16(i AS S32) AS S32
        RETURN CAST(src[i] AS S32) + CAST(src[i + 1] AS S32) * 256
    END FUNCTION

    FUNCTION ProbeBuf() AS S32
        cnt = 0
        w0 = 0
        h0 = 0
        bpp0 = 0
        IF srclen < 22 THEN
            lastst = 4
            RETURN lastst
        END IF
        IF GetU16(1) <> 0 THEN
            lastst = 3
            RETURN lastst
        END IF
        IF GetU16(3) <> 1 THEN
            lastst = 3
            RETURN lastst
        END IF
        cnt = GetU16(5)
        IF cnt < 1 THEN
            lastst = 3
            RETURN lastst
        END IF
        w0 = CAST(src[7] AS S32)
        h0 = CAST(src[8] AS S32)
        IF w0 = 0 THEN
            w0 = 256
        END IF
        IF h0 = 0 THEN
            h0 = 256
        END IF
        bpp0 = GetU16(13)
        lastst = 0
        RETURN lastst
    END FUNCTION

    FUNCTION Count() AS S32
        RETURN cnt
    END FUNCTION

    FUNCTION W0() AS S32
        RETURN w0
    END FUNCTION

    FUNCTION H0() AS S32
        RETURN h0
    END FUNCTION

    FUNCTION Bpp0() AS S32
        RETURN bpp0
    END FUNCTION

    FUNCTION Status() AS S32
        RETURN lastst
    END FUNCTION

END MODULE
