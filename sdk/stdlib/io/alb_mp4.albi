-- ============================================================================
-- ALBMp4 — ISO BMFF / MP4 box walk (not a video decoder)
-- ============================================================================
-- Walks size+fourcc boxes. HasFtyp / HasMoov / HasMdat are 1 if that box
-- appeared. Brand0..Brand3 are the first four compatible-brand bytes of
-- ftyp (ASCII codes, 0 if missing).
--
-- From release\examples\:
--   INCLUDE "../stdlib/io/alb_mp4.albi"
--
-- WalkBuf()    0 ok. BoxCount() how many boxes (cap 128).
-- 64-bit largesize (size=1) and uuid boxes are skipped/fail-closed.
-- H.264 / AAC payloads inside mdat are not parsed here.
-- ============================================================================

VERSION 1.0

DECLARE MODULE ALBMp4
    PROCEDURE Reset()
    PROCEDURE PutByte(b AS U8)
    FUNCTION WalkBuf() AS S32
    FUNCTION BoxCount() AS S32
    FUNCTION HasFtyp() AS S32
    FUNCTION HasMoov() AS S32
    FUNCTION HasMdat() AS S32
    FUNCTION Brand0() AS S32
    FUNCTION Brand1() AS S32
    FUNCTION Brand2() AS S32
    FUNCTION Brand3() AS S32
    FUNCTION Status() AS S32
END DECLARE MODULE

MODULE ALBMp4

    -- 1-based window. Box size is big-endian at each box start.
    STRICT src[8192] AS U8
    LET srclen AS S32 = 0
    LET nbox AS S32 = 0
    LET ftyp AS S32 = 0
    LET moov AS S32 = 0
    LET mdat AS S32 = 0
    LET b0 AS S32 = 0
    LET b1 AS S32 = 0
    LET b2 AS S32 = 0
    LET b3 AS S32 = 0
    LET lastst AS S32 = 5

    PROCEDURE Reset()
        srclen = 0
        nbox = 0
        ftyp = 0
        moov = 0
        mdat = 0
        b0 = 0
        b1 = 0
        b2 = 0
        b3 = 0
        lastst = 5
    END PROCEDURE

    PROCEDURE PutByte(b AS U8)
        IF srclen >= 8192 THEN
            RETURN
        END IF
        srclen = srclen + 1
        src[srclen] = b
    END PROCEDURE

    FUNCTION Be32(i AS S32) AS S32
        RETURN CAST(src[i] AS S32) * 16777216 + CAST(src[i + 1] AS S32) * 65536 + CAST(src[i + 2] AS S32) * 256 + CAST(src[i + 3] AS S32)
    END FUNCTION

    FUNCTION WalkBuf() AS S32
        LET i AS S32 = 1
        LET sz AS S32 = 0
        LET t0 AS S32 = 0
        LET t1 AS S32 = 0
        LET t2 AS S32 = 0
        LET t3 AS S32 = 0
        nbox = 0
        ftyp = 0
        moov = 0
        mdat = 0
        IF srclen < 8 THEN
            lastst = 4
            RETURN lastst
        END IF
        WHILE i + 7 <= srclen
            IF nbox >= 128 THEN
                lastst = 2
                RETURN lastst
            END IF
            sz = Be32(i)
            t0 = CAST(src[i + 4] AS S32)
            t1 = CAST(src[i + 5] AS S32)
            t2 = CAST(src[i + 6] AS S32)
            t3 = CAST(src[i + 7] AS S32)
            IF sz = 1 THEN
                lastst = 5
                RETURN lastst
            END IF
            IF sz = 0 THEN
                sz = srclen - i + 1
            END IF
            IF sz < 8 THEN
                lastst = 3
                RETURN lastst
            END IF
            IF i + sz - 1 > srclen THEN
                lastst = 4
                RETURN lastst
            END IF
            nbox = nbox + 1
            IF t0 = 102 THEN
                IF t1 = 116 THEN
                    IF t2 = 121 THEN
                        IF t3 = 112 THEN
                            ftyp = 1
                            IF sz >= 16 THEN
                                b0 = CAST(src[i + 8] AS S32)
                                b1 = CAST(src[i + 9] AS S32)
                                b2 = CAST(src[i + 10] AS S32)
                                b3 = CAST(src[i + 11] AS S32)
                            END IF
                        END IF
                    END IF
                END IF
            END IF
            IF t0 = 109 THEN
                IF t1 = 111 THEN
                    IF t2 = 111 THEN
                        IF t3 = 118 THEN
                            moov = 1
                        END IF
                    END IF
                END IF
            END IF
            IF t0 = 109 THEN
                IF t1 = 100 THEN
                    IF t2 = 97 THEN
                        IF t3 = 116 THEN
                            mdat = 1
                        END IF
                    END IF
                END IF
            END IF
            i = i + sz
        END WHILE
        IF ftyp = 0 THEN
            lastst = 3
            RETURN lastst
        END IF
        lastst = 0
        RETURN lastst
    END FUNCTION

    FUNCTION BoxCount() AS S32
        RETURN nbox
    END FUNCTION

    FUNCTION HasFtyp() AS S32
        RETURN ftyp
    END FUNCTION

    FUNCTION HasMoov() AS S32
        RETURN moov
    END FUNCTION

    FUNCTION HasMdat() AS S32
        RETURN mdat
    END FUNCTION

    FUNCTION Brand0() AS S32
        RETURN b0
    END FUNCTION

    FUNCTION Brand1() AS S32
        RETURN b1
    END FUNCTION

    FUNCTION Brand2() AS S32
        RETURN b2
    END FUNCTION

    FUNCTION Brand3() AS S32
        RETURN b3
    END FUNCTION

    FUNCTION Status() AS S32
        RETURN lastst
    END FUNCTION

END MODULE
