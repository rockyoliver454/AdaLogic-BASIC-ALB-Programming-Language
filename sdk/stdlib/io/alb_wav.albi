-- ============================================================================
-- ALBWav — RIFF WAVE PCM header
-- ============================================================================
-- Requires RIFF....WAVE, fmt_ audio format 1 (PCM), and a data chunk.
-- Channels(), Rate() Hz, Bits() 8/16, DataBytes() size of the data chunk.
--
-- From release\examples\:
--   INCLUDE "../stdlib/io/alb_wav.albi"
--
-- ProbeBuf()  0 ok. WAVE_FORMAT_EXTENSIBLE, ADPCM, IEEE float → status 5.
-- Does not return samples; use the data chunk yourself after the header.
-- ============================================================================

VERSION 1.0

DECLARE MODULE ALBWav
    PROCEDURE Reset()
    PROCEDURE PutByte(b AS U8)
    FUNCTION ProbeBuf() AS S32
    FUNCTION Channels() AS S32
    FUNCTION Rate() AS S32
    FUNCTION Bits() AS S32
    FUNCTION DataBytes() AS S32
    FUNCTION Status() AS S32
END DECLARE MODULE

MODULE ALBWav

    -- 1-based window. PCM fmt chunk only (audio format 1).
    STRICT src[4096] AS U8
    LET srclen AS S32 = 0
    LET chn AS S32 = 0
    LET rate AS S32 = 0
    LET bitsn AS S32 = 0
    LET datan AS S32 = 0
    LET lastst AS S32 = 5

    PROCEDURE Reset()
        srclen = 0
        chn = 0
        rate = 0
        bitsn = 0
        datan = 0
        lastst = 5
    END PROCEDURE

    PROCEDURE PutByte(b AS U8)
        IF srclen >= 4096 THEN
            RETURN
        END IF
        srclen = srclen + 1
        src[srclen] = b
    END PROCEDURE

    FUNCTION GetU16(i AS S32) AS S32
        RETURN CAST(src[i] AS S32) + CAST(src[i + 1] AS S32) * 256
    END FUNCTION

    FUNCTION GetU32(i AS S32) AS S32
        RETURN GetU16(i) + GetU16(i + 2) * 65536
    END FUNCTION

    FUNCTION Four(i AS S32, a AS S32, b AS S32, c AS S32, d AS S32) AS S32
        IF CAST(src[i] AS S32) <> a THEN
            RETURN 0
        END IF
        IF CAST(src[i + 1] AS S32) <> b THEN
            RETURN 0
        END IF
        IF CAST(src[i + 2] AS S32) <> c THEN
            RETURN 0
        END IF
        IF CAST(src[i + 3] AS S32) <> d THEN
            RETURN 0
        END IF
        RETURN 1
    END FUNCTION

    FUNCTION ProbeBuf() AS S32
        LET i AS S32 = 13
        LET sz AS S32 = 0
        chn = 0
        rate = 0
        bitsn = 0
        datan = 0
        IF srclen < 44 THEN
            lastst = 4
            RETURN lastst
        END IF
        IF Four(1, 82, 73, 70, 70) = 0 THEN
            lastst = 3
            RETURN lastst
        END IF
        IF Four(9, 87, 65, 86, 69) = 0 THEN
            lastst = 3
            RETURN lastst
        END IF
        WHILE i + 8 <= srclen
            sz = GetU32(i + 4)
            IF Four(i, 102, 109, 116, 32) <> 0 THEN
                IF i + 8 + 16 - 1 > srclen THEN
                    lastst = 4
                    RETURN lastst
                END IF
                IF GetU16(i + 8) <> 1 THEN
                    lastst = 5
                    RETURN lastst
                END IF
                chn = GetU16(i + 10)
                rate = GetU32(i + 12)
                bitsn = GetU16(i + 22)
            END IF
            IF Four(i, 100, 97, 116, 97) <> 0 THEN
                datan = sz
            END IF
            IF sz < 0 THEN
                lastst = 3
                RETURN lastst
            END IF
            i = i + 8 + sz
            IF (sz AND 1) <> 0 THEN
                i = i + 1
            END IF
        END WHILE
        IF chn < 1 THEN
            lastst = 3
            RETURN lastst
        END IF
        lastst = 0
        RETURN lastst
    END FUNCTION

    FUNCTION Channels() AS S32
        RETURN chn
    END FUNCTION

    FUNCTION Rate() AS S32
        RETURN rate
    END FUNCTION

    FUNCTION Bits() AS S32
        RETURN bitsn
    END FUNCTION

    FUNCTION DataBytes() AS S32
        RETURN datan
    END FUNCTION

    FUNCTION Status() AS S32
        RETURN lastst
    END FUNCTION

END MODULE
