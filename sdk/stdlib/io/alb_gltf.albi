-- ============================================================================
-- ALBGltf — glTF 2.0 JSON probe
-- ============================================================================
-- Looks for the strings "asset" and "buffers" in the JSON text. Not a
-- scene graph and not GLB (binary glTF).
-- INCLUDE jaysoond.albi first if you also want a SAX walk; this module
-- itself only scans bytes.
--
-- From release\examples\:
--   INCLUDE "../stdlib/io/alb_gltf.albi"
--
-- ProbeBuf()     0 if it looks like JSON with those keys.
-- SawAsset() / SawBuffers()  1 if the key text appeared.
-- ============================================================================

VERSION 1.0

DECLARE MODULE ALBGltf
    PROCEDURE Reset()
    PROCEDURE PutByte(b AS U8)
    FUNCTION ProbeBuf() AS S32
    FUNCTION SawAsset() AS S32
    FUNCTION SawBuffers() AS S32
    FUNCTION Status() AS S32
END DECLARE MODULE

MODULE ALBGltf

    -- 1-based window. JSON glTF: looks for asset / buffers keys. Not GLB binary.
    STRICT src[8192] AS U8
    LET srclen AS S32 = 0
    LET asset AS S32 = 0
    LET buffers AS S32 = 0
    LET lastst AS S32 = 5

    PROCEDURE Reset()
        srclen = 0
        asset = 0
        buffers = 0
        lastst = 5
    END PROCEDURE

    PROCEDURE PutByte(b AS U8)
        IF srclen >= 8192 THEN
            RETURN
        END IF
        srclen = srclen + 1
        src[srclen] = b
    END PROCEDURE

    FUNCTION ProbeBuf() AS S32
        LET i AS S32 = 1
        LET tok AS S32 = 0
        LET kid AS S32 = 0
        asset = 0
        buffers = 0
        IF srclen < 2 THEN
            lastst = 4
            RETURN lastst
        END IF
        JaySoond.InitEmpty()
        WHILE i <= srclen
            JaySoond.PutByte(CAST(src[i] AS S32))
            i = i + 1
        END WHILE
        JaySoond.ArmScan()
        tok = JaySoond.NextTok()
        WHILE tok <> 12
            IF JaySoond.HasErr() <> 0 THEN
                lastst = 3
                RETURN lastst
            END IF
            IF tok = 7 THEN
                kid = JaySoond.KeyId()
                IF kid = 1 THEN
                    asset = 1
                END IF
            END IF
            tok = JaySoond.NextTok()
        END WHILE
        i = 1
        WHILE i + 5 <= srclen
            IF src[i] = 97 THEN
                IF src[i + 1] = 115 THEN
                    IF src[i + 2] = 115 THEN
                        IF src[i + 3] = 101 THEN
                            IF src[i + 4] = 116 THEN
                                asset = 1
                            END IF
                        END IF
                    END IF
                END IF
            END IF
            IF src[i] = 98 THEN
                IF src[i + 1] = 117 THEN
                    IF src[i + 2] = 102 THEN
                        IF src[i + 3] = 102 THEN
                            IF src[i + 4] = 101 THEN
                                IF src[i + 5] = 114 THEN
                                    buffers = 1
                                END IF
                            END IF
                        END IF
                    END IF
                END IF
            END IF
            i = i + 1
        END WHILE
        IF asset = 0 THEN
            lastst = 3
            RETURN lastst
        END IF
        lastst = 0
        RETURN lastst
    END FUNCTION

    FUNCTION SawAsset() AS S32
        RETURN asset
    END FUNCTION

    FUNCTION SawBuffers() AS S32
        RETURN buffers
    END FUNCTION

    FUNCTION Status() AS S32
        RETURN lastst
    END FUNCTION

END MODULE
