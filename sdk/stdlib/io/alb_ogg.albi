-- ============================================================================
-- ALBOgg — Ogg page container (RFC 3533)
-- ============================================================================
-- "OggS" pages. Kind() from the first codec magic found in the window:
--   1 Vorbis ("vorb")  2 Opus ("Opus")  3 FLAC ("fLaC")  0 unknown
-- Pages() counts OggS captures (not packet count).
--
-- From release\examples\:
--   INCLUDE "../stdlib/io/alb_ogg.albi"
--
-- ProbeBuf()  0 ok. Does not decode Vorbis/Opus/FLAC audio. Pair with
-- alb_opus.albi or alb_flac.albi if you have a raw header as well.
-- ============================================================================

VERSION 1.0

DECLARE MODULE ALBOgg
    PROCEDURE Reset()
    PROCEDURE PutByte(b AS U8)
    FUNCTION ProbeBuf() AS S32
    FUNCTION Kind() AS S32
    FUNCTION Pages() AS S32
    FUNCTION Status() AS S32
END DECLARE MODULE

MODULE ALBOgg

    -- 1-based window. OggS pages. kindn 1=Vorbis 2=Opus 3=FLAC.
    STRICT src[4096] AS U8
    LET srclen AS S32 = 0
    LET kindn AS S32 = 0
    LET npg AS S32 = 0
    LET lastst AS S32 = 5

    PROCEDURE Reset()
        srclen = 0
        kindn = 0
        npg = 0
        lastst = 5
    END PROCEDURE

    PROCEDURE PutByte(b AS U8)
        IF srclen >= 4096 THEN
            RETURN
        END IF
        srclen = srclen + 1
        src[srclen] = b
    END PROCEDURE

    FUNCTION Four(i AS S32, a AS S32, b AS S32, c AS S32, d AS S32) AS S32
        IF CAST(src[i] AS S32) <> a THEN
            RETURN 0
        END IF
        IF CAST(src[i + 1] AS S32) <> b THEN
            RETURN 0
        END IF
        IF CAST(src[i + 2] AS S32) <> c THEN
            RETURN 0
        END IF
        IF CAST(src[i + 3] AS S32) <> d THEN
            RETURN 0
        END IF
        RETURN 1
    END FUNCTION

    FUNCTION ProbeBuf() AS S32
        LET i AS S32 = 1
        kindn = 0
        npg = 0
        IF srclen < 27 THEN
            lastst = 4
            RETURN lastst
        END IF
        IF Four(1, 79, 103, 103, 83) = 0 THEN
            lastst = 3
            RETURN lastst
        END IF
        WHILE i + 3 <= srclen
            IF Four(i, 79, 103, 103, 83) <> 0 THEN
                npg = npg + 1
            END IF
            IF Four(i, 118, 111, 114, 98) <> 0 THEN
                kindn = 1
            END IF
            IF Four(i, 79, 112, 117, 115) <> 0 THEN
                kindn = 2
            END IF
            IF Four(i, 102, 76, 97, 67) <> 0 THEN
                kindn = 3
            END IF
            i = i + 1
        END WHILE
        lastst = 0
        RETURN lastst
    END FUNCTION

    FUNCTION Kind() AS S32
        RETURN kindn
    END FUNCTION

    FUNCTION Pages() AS S32
        RETURN npg
    END FUNCTION

    FUNCTION Status() AS S32
        RETURN lastst
    END FUNCTION

END MODULE
