-- ============================================================================
-- ALBAvi — RIFF AVI + MJPEG fourcc
-- ============================================================================
-- RIFF....AVI , then scans for "strh" (Streams() count) and "MJPG"
-- (IsMjpeg()=1). Does not demux chunks or decode JPEG frames.
--
-- From release\examples\:
--   INCLUDE "../stdlib/io/alb_avi.albi"
--
-- ProbeBuf()  0 ok. OpenDML / AVIX is not special-cased.
-- ============================================================================

VERSION 1.0

DECLARE MODULE ALBAvi
    PROCEDURE Reset()
    PROCEDURE PutByte(b AS U8)
    FUNCTION ProbeBuf() AS S32
    FUNCTION IsMjpeg() AS S32
    FUNCTION Streams() AS S32
    FUNCTION VideoStreams() AS S32
    FUNCTION AudioStreams() AS S32
    FUNCTION Width() AS S32
    FUNCTION Height() AS S32
    FUNCTION Frames() AS S32
    FUNCTION MicrosecondsPerFrame() AS S32
    FUNCTION Status() AS S32
END DECLARE MODULE

MODULE ALBAvi

    -- 1-based window. RIFF AVI. nstr counts strh; mjpeg is 1 if MJPG fourcc seen.
    STRICT src[4096] AS U8
    LET srclen AS S32 = 0
    LET mjpeg AS S32 = 0
    LET nstr AS S32 = 0
    LET nvstr AS S32 = 0
    LET nastr AS S32 = 0
    LET widthn AS S32 = 0
    LET heightn AS S32 = 0
    LET framesn AS S32 = 0
    LET usecn AS S32 = 0
    LET lastst AS S32 = 5

    PROCEDURE Reset()
        srclen = 0
        mjpeg = 0
        nstr = 0
        nvstr = 0
        nastr = 0
        widthn = 0
        heightn = 0
        framesn = 0
        usecn = 0
        lastst = 5
    END PROCEDURE

    PROCEDURE PutByte(b AS U8)
        IF srclen >= 4096 THEN
            RETURN
        END IF
        srclen = srclen + 1
        src[srclen] = b
    END PROCEDURE

    FUNCTION Four(i AS S32, a AS S32, b AS S32, c AS S32, d AS S32) AS S32
        IF CAST(src[i] AS S32) <> a THEN
            RETURN 0
        END IF
        IF CAST(src[i + 1] AS S32) <> b THEN
            RETURN 0
        END IF
        IF CAST(src[i + 2] AS S32) <> c THEN
            RETURN 0
        END IF
        IF CAST(src[i + 3] AS S32) <> d THEN
            RETURN 0
        END IF
        RETURN 1
    END FUNCTION

    FUNCTION U32Le(i AS S32) AS S32
        RETURN CAST(src[i] AS S32) + CAST(src[i + 1] AS S32) * 256 + CAST(src[i + 2] AS S32) * 65536 + CAST(src[i + 3] AS S32) * 16777216
    END FUNCTION

    FUNCTION ProbeBuf() AS S32
        LET i AS S32 = 1
        mjpeg = 0
        nstr = 0
        nvstr = 0
        nastr = 0
        widthn = 0
        heightn = 0
        framesn = 0
        usecn = 0
        IF srclen < 16 THEN
            lastst = 4
            RETURN lastst
        END IF
        IF Four(1, 82, 73, 70, 70) = 0 THEN
            lastst = 3
            RETURN lastst
        END IF
        IF Four(9, 65, 86, 73, 32) = 0 THEN
            lastst = 3
            RETURN lastst
        END IF
        WHILE i + 3 <= srclen
            IF Four(i, 115, 116, 114, 104) <> 0 THEN
                nstr = nstr + 1
                IF i + 11 <= srclen THEN
                    IF Four(i + 8, 118, 105, 100, 115) <> 0 THEN nvstr = nvstr + 1 END IF
                    IF Four(i + 8, 97, 117, 100, 115) <> 0 THEN nastr = nastr + 1 END IF
                END IF
            END IF
            IF Four(i, 97, 118, 105, 104) <> 0 THEN
                IF i + 47 <= srclen THEN
                    usecn = U32Le(i + 8)
                    framesn = U32Le(i + 24)
                    widthn = U32Le(i + 40)
                    heightn = U32Le(i + 44)
                END IF
            END IF
            IF Four(i, 77, 74, 80, 71) <> 0 THEN
                mjpeg = 1
            END IF
            i = i + 1
        END WHILE
        lastst = 0
        RETURN lastst
    END FUNCTION

    FUNCTION IsMjpeg() AS S32
        RETURN mjpeg
    END FUNCTION

    FUNCTION Streams() AS S32
        RETURN nstr
    END FUNCTION

    FUNCTION VideoStreams() AS S32
        RETURN nvstr
    END FUNCTION

    FUNCTION AudioStreams() AS S32
        RETURN nastr
    END FUNCTION

    FUNCTION Width() AS S32
        RETURN widthn
    END FUNCTION

    FUNCTION Height() AS S32
        RETURN heightn
    END FUNCTION

    FUNCTION Frames() AS S32
        RETURN framesn
    END FUNCTION

    FUNCTION MicrosecondsPerFrame() AS S32
        RETURN usecn
    END FUNCTION

    FUNCTION Status() AS S32
        RETURN lastst
    END FUNCTION

END MODULE
