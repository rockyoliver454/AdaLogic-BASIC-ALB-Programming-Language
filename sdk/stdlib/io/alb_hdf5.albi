-- ============================================================================
-- ALBHdf5 — HDF5 superblock
-- ============================================================================
-- Signature 89 48 44 46 0D 0A 1A 0A, then VerN() 0..3. OffSize() is the
-- size-of-offsets field (version 0 at byte 14, later versions nearby).
--
-- From release\examples\:
--   INCLUDE "../stdlib/io/alb_hdf5.albi"
--
-- ProbeBuf()  0 ok. Datasets, filters, and NetCDF-4 (which is HDF5) are
-- not walked. ALBSkip kind 2 / 3 send those blobs to Cairn.
-- ============================================================================

VERSION 1.0

DECLARE MODULE ALBHdf5
    PROCEDURE Reset()
    PROCEDURE PutByte(b AS U8)
    FUNCTION ProbeBuf() AS S32
    FUNCTION VerN() AS S32
    FUNCTION OffSize() AS S32
    FUNCTION Status() AS S32
END DECLARE MODULE

MODULE ALBHdf5

    -- 1-based window. Signature 89 48 44 46 0D 0A 1A 0A, then superblock version / offset size.
    STRICT src[4096] AS U8
    LET srclen AS S32 = 0
    LET vern AS S32 = 0
    LET offsz AS S32 = 0
    LET lastst AS S32 = 5

    PROCEDURE Reset()
        srclen = 0
        vern = 0
        offsz = 0
        lastst = 5
    END PROCEDURE

    PROCEDURE PutByte(b AS U8)
        IF srclen >= 4096 THEN
            RETURN
        END IF
        srclen = srclen + 1
        src[srclen] = b
    END PROCEDURE

    FUNCTION ProbeBuf() AS S32
        vern = 0
        offsz = 0
        IF srclen < 9 THEN
            lastst = 4
            RETURN lastst
        END IF
        IF src[1] <> 137 THEN
            lastst = 3
            RETURN lastst
        END IF
        IF src[2] <> 72 THEN
            lastst = 3
            RETURN lastst
        END IF
        IF src[3] <> 68 THEN
            lastst = 3
            RETURN lastst
        END IF
        IF src[4] <> 70 THEN
            lastst = 3
            RETURN lastst
        END IF
        IF src[5] <> 13 THEN
            lastst = 3
            RETURN lastst
        END IF
        IF src[6] <> 10 THEN
            lastst = 3
            RETURN lastst
        END IF
        IF src[7] <> 26 THEN
            lastst = 3
            RETURN lastst
        END IF
        IF src[8] <> 10 THEN
            lastst = 3
            RETURN lastst
        END IF
        vern = CAST(src[9] AS S32)
        IF vern > 3 THEN
            lastst = 5
            RETURN lastst
        END IF
        IF vern = 0 THEN
            IF srclen >= 15 THEN
                offsz = CAST(src[14] AS S32)
            END IF
        ELSE
            IF srclen >= 10 THEN
                offsz = CAST(src[10] AS S32)
            END IF
        END IF
        lastst = 0
        RETURN lastst
    END FUNCTION

    FUNCTION VerN() AS S32
        RETURN vern
    END FUNCTION

    FUNCTION OffSize() AS S32
        RETURN offsz
    END FUNCTION

    FUNCTION Status() AS S32
        RETURN lastst
    END FUNCTION

END MODULE
