-- ============================================================================
-- ALBTiff — TIFF 6.0 first IFD
-- ============================================================================
-- II little-endian or MM big-endian, magic 42, then IFD0. Latches tags
-- 256 ImageWidth, 257 ImageLength, 259 Compression. Comp()=1 is uncompressed.
--
-- From release\examples\:
--   INCLUDE "../stdlib/io/alb_tiff.albi"
--
-- ProbeBuf()  0 ok. W()/H(). JPEG/LZW/PackBits compression → status 5
-- (park the file in Cairn via ALBSkip kind 1 if you still need the bytes).
-- SHORT values are read from the IFD value slot; IFD offsets beyond the
-- window → status 4. Not a strip/tile raster decoder.
-- ============================================================================

VERSION 1.0

DECLARE MODULE ALBTiff
    PROCEDURE Reset()
    PROCEDURE PutByte(b AS U8)
    FUNCTION ProbeBuf() AS S32
    FUNCTION W() AS S32
    FUNCTION H() AS S32
    FUNCTION Comp() AS S32
    FUNCTION Status() AS S32
END DECLARE MODULE

MODULE ALBTiff

    -- 1-based window. be=1 means MM (big-endian). Comp 1 = none; other compressions are skip.
    STRICT src[8192] AS U8
    LET srclen AS S32 = 0
    LET tw AS S32 = 0
    LET th AS S32 = 0
    LET compn AS S32 = 0
    LET be AS S32 = 0
    LET lastst AS S32 = 5

    PROCEDURE Reset()
        srclen = 0
        tw = 0
        th = 0
        compn = 0
        be = 0
        lastst = 5
    END PROCEDURE

    PROCEDURE PutByte(b AS U8)
        IF srclen >= 8192 THEN
            RETURN
        END IF
        srclen = srclen + 1
        src[srclen] = b
    END PROCEDURE

    FUNCTION U16At(i AS S32) AS S32
        IF be <> 0 THEN
            RETURN CAST(src[i] AS S32) * 256 + CAST(src[i + 1] AS S32)
        END IF
        RETURN CAST(src[i] AS S32) + CAST(src[i + 1] AS S32) * 256
    END FUNCTION

    FUNCTION U32At(i AS S32) AS S32
        IF be <> 0 THEN
            RETURN CAST(src[i] AS S32) * 16777216 + CAST(src[i + 1] AS S32) * 65536 + CAST(src[i + 2] AS S32) * 256 + CAST(src[i + 3] AS S32)
        END IF
        RETURN U16At(i) + U16At(i + 2) * 65536
    END FUNCTION

    FUNCTION ProbeBuf() AS S32
        LET ifd AS S32 = 0
        LET nent AS S32 = 0
        LET e AS S32 = 0
        LET tag AS S32 = 0
        LET typn AS S32 = 0
        LET cnt AS S32 = 0
        LET val AS S32 = 0
        tw = 0
        th = 0
        compn = 1
        be = 0
        IF srclen < 8 THEN
            lastst = 4
            RETURN lastst
        END IF
        IF src[1] = 77 THEN
            IF src[2] = 77 THEN
                be = 1
            END IF
        ELSE
            IF src[1] <> 73 THEN
                lastst = 3
                RETURN lastst
            END IF
            IF src[2] <> 73 THEN
                lastst = 3
                RETURN lastst
            END IF
        END IF
        IF U16At(3) <> 42 THEN
            lastst = 3
            RETURN lastst
        END IF
        ifd = U32At(5) + 1
        IF ifd + 2 > srclen THEN
            lastst = 4
            RETURN lastst
        END IF
        nent = U16At(ifd)
        e = ifd + 2
        WHILE nent > 0
            IF e + 11 > srclen THEN
                lastst = 4
                RETURN lastst
            END IF
            tag = U16At(e)
            typn = U16At(e + 2)
            cnt = U32At(e + 4)
            val = U16At(e + 8)
            IF tag = 256 THEN
                tw = val
            END IF
            IF tag = 257 THEN
                th = val
            END IF
            IF tag = 259 THEN
                compn = val
            END IF
            e = e + 12
            nent = nent - 1
        END WHILE
        IF tw < 1 THEN
            lastst = 3
            RETURN lastst
        END IF
        IF compn <> 1 THEN
            lastst = 5
            RETURN lastst
        END IF
        lastst = 0
        RETURN lastst
    END FUNCTION

    FUNCTION W() AS S32
        RETURN tw
    END FUNCTION

    FUNCTION H() AS S32
        RETURN th
    END FUNCTION

    FUNCTION Comp() AS S32
        RETURN compn
    END FUNCTION

    FUNCTION Status() AS S32
        RETURN lastst
    END FUNCTION

END MODULE
