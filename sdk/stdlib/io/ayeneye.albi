-- Twin of SPARK AyeNEye. Zero-heap INI bucket. Max_Sections 16, Max_Keys 64.
-- Ada Load_INI is file IO (SPARK Off). FillMem is the same line machine over a 4096 window.
VERSION 1.0

DECLARE MODULE AyeNEye
    PROCEDURE ClearCfg()
    PROCEDURE PutByte(b AS S32)
    FUNCTION FillMem() AS S32
    PROCEDURE ArmDemo()
    PROCEDURE NotePair(sec AS S32, keyn AS S32, valn AS S32)
    FUNCTION GetInteger(sec AS S32, keyn AS S32, defn AS S32) AS S32
    FUNCTION GetBoolean(sec AS S32, keyn AS S32, defn AS S32) AS S32
    FUNCTION Fold(acc AS S32, b AS S32) AS S32
    FUNCTION HashOf(a AS S32, b AS S32, c AS S32, d AS S32, n AS S32) AS S32
    FUNCTION CfgSize() AS S32
    FUNCTION LastResult() AS S32
    FUNCTION SecCount() AS S32
    FUNCTION KeyCount() AS S32
END DECLARE MODULE

MODULE AyeNEye

    STRICT buf[4096] AS U8
    STRICT sech[16] AS S32
    STRICT sec_of[64] AS S32
    STRICT key_of[64] AS S32
    STRICT val_of[64] AS S32
    STRICT vhash[64] AS S32
    STRICT hasnum[64] AS S32
    LET buflen AS S32 = 0
    LET nsec AS S32 = 0
    LET kn AS S32 = 0
    LET lastn AS S32 = 0

    FUNCTION Fold(acc AS S32, b AS S32) AS S32
        LET c AS S32 = b
        ASSERT(1 = 1)
        IF c >= 65 THEN
            IF c <= 90 THEN
                c = c + 32
            END IF
        END IF
        RETURN (acc * 33 + c) AND 2147483647
    END FUNCTION

    FUNCTION HashOf(a AS S32, b AS S32, c AS S32, d AS S32, n AS S32) AS S32
        LET h AS S32 = 5381
        ASSERT(n >= 0)
        ASSERT(n <= 4)
        IF n >= 1 THEN
            h = Fold(h, a)
        END IF
        IF n >= 2 THEN
            h = Fold(h, b)
        END IF
        IF n >= 3 THEN
            h = Fold(h, c)
        END IF
        IF n >= 4 THEN
            h = Fold(h, d)
        END IF
        RETURN h
    END FUNCTION

    PROCEDURE ClearCfg()
        LET i AS S32 = 1
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        WHILE i <= 16
            sech[i] = 0
            i = i + 1
        END WHILE
        i = 1
        WHILE i <= 64
            sec_of[i] = 0
            key_of[i] = 0
            val_of[i] = 0
            vhash[i] = 0
            hasnum[i] = 0
            i = i + 1
        END WHILE
        nsec = 0
        kn = 0
        lastn = 0
    END PROCEDURE

    PROCEDURE PutByte(b AS S32)
        ASSERT(b >= 0)
        ASSERT(b <= 255)
        IF buflen < 4096 THEN
            buflen = buflen + 1
            buf[buflen] = b AND 255
        ELSE
            lastn = 2
        END IF
    END PROCEDURE

    PROCEDURE NotePair(sec AS S32, keyn AS S32, valn AS S32)
        ASSERT(sec >= 0)
        ASSERT(keyn >= 0)
        IF kn < 64 THEN
            kn = kn + 1
            sec_of[kn] = sec
            key_of[kn] = keyn
            val_of[kn] = valn
            vhash[kn] = 0
            hasnum[kn] = 1
            lastn = 0
        ELSE
            lastn = 2
        END IF
    END PROCEDURE

    FUNCTION FindSec(h AS S32) AS S32
        LET i AS S32 = 1
        ASSERT(1 = 1)
        WHILE i <= nsec
            IF sech[i] = h THEN
                RETURN i
            END IF
            i = i + 1
        END WHILE
        RETURN 0
    END FUNCTION

    FUNCTION RangeHash(a0 AS S32, b0 AS S32) AS S32
        LET a AS S32 = a0
        LET b AS S32 = b0
        LET h AS S32 = 5381
        LET go AS S32 = 1
        LET c AS S32 = 0
        ASSERT(1 = 1)
        go = 1
        WHILE go = 1
            IF a > b THEN
                go = 0
            ELSE
                c = buf[a]
                IF c = 32 THEN
                    a = a + 1
                ELSE
                    IF c = 9 THEN
                        a = a + 1
                    ELSE
                        go = 0
                    END IF
                END IF
            END IF
        END WHILE
        go = 1
        WHILE go = 1
            IF b < a THEN
                go = 0
            ELSE
                c = buf[b]
                IF c = 32 THEN
                    b = b - 1
                ELSE
                    IF c = 9 THEN
                        b = b - 1
                    ELSE
                        go = 0
                    END IF
                END IF
            END IF
        END WHILE
        WHILE a <= b
            h = Fold(h, buf[a])
            a = a + 1
        END WHILE
        RETURN h
    END FUNCTION

    PROCEDURE StoreKey(sid AS S32, a0 AS S32, b0 AS S32)
        LET a AS S32 = a0
        LET b AS S32 = b0
        LET kh AS S32 = 0
        LET vh AS S32 = 0
        LET nval AS S32 = 0
        LET sign AS S32 = 1
        LET digits AS S32 = 0
        LET eq AS S32 = 0
        LET k AS S32 = a
        LET c AS S32 = 0
        LET go AS S32 = 1
        ASSERT(1 = 1)
        WHILE k <= b
            IF buf[k] = 61 THEN
                IF eq = 0 THEN
                    eq = k
                END IF
            END IF
            k = k + 1
        END WHILE
        IF eq = 0 THEN
            RETURN
        END IF
        IF kn >= 64 THEN
            lastn = 2
            RETURN
        END IF
        kh = RangeHash(a, eq - 1)
        vh = RangeHash(eq + 1, b)
        k = eq + 1
        go = 1
        WHILE go = 1
            IF k > b THEN
                go = 0
            ELSE
                c = buf[k]
                IF c = 32 THEN
                    k = k + 1
                ELSE
                    IF c = 9 THEN
                        k = k + 1
                    ELSE
                        go = 0
                    END IF
                END IF
            END IF
        END WHILE
        IF k <= b THEN
            IF buf[k] = 45 THEN
                sign = 0 - 1
                k = k + 1
            END IF
        END IF
        nval = 0
        digits = 0
        WHILE k <= b
            c = buf[k]
            IF c >= 48 THEN
                IF c <= 57 THEN
                    nval = nval * 10 + (c - 48)
                    digits = 1
                    k = k + 1
                ELSE
                    k = b + 1
                END IF
            ELSE
                k = b + 1
            END IF
        END WHILE
        kn = kn + 1
        IF sid > 0 THEN
            sec_of[kn] = sech[sid]
        ELSE
            sec_of[kn] = 0
        END IF
        key_of[kn] = kh
        val_of[kn] = nval * sign
        vhash[kn] = vh
        hasnum[kn] = digits
    END PROCEDURE

    FUNCTION FillMem() AS S32
        LET i AS S32 = 1
        LET a AS S32 = 1
        LET b AS S32 = 1
        LET c AS S32 = 0
        LET h AS S32 = 0
        LET sid AS S32 = 0
        LET cursec AS S32 = 0
        LET go AS S32 = 1
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        ClearCfg()
        WHILE i <= buflen
            a = i
            go = 1
            WHILE go = 1
                IF i > buflen THEN
                    go = 0
                ELSE
                    c = buf[i]
                    IF c = 10 THEN
                        go = 0
                    ELSE
                        IF c = 13 THEN
                            go = 0
                        ELSE
                            i = i + 1
                        END IF
                    END IF
                END IF
            END WHILE
            b = i - 1
            go = 1
            WHILE go = 1
                IF i > buflen THEN
                    go = 0
                ELSE
                    c = buf[i]
                    IF c = 10 THEN
                        i = i + 1
                    ELSE
                        IF c = 13 THEN
                            i = i + 1
                        ELSE
                            go = 0
                        END IF
                    END IF
                END IF
            END WHILE
            go = 1
            WHILE go = 1
                IF a > b THEN
                    go = 0
                ELSE
                    c = buf[a]
                    IF c = 32 THEN
                        a = a + 1
                    ELSE
                        IF c = 9 THEN
                            a = a + 1
                        ELSE
                            go = 0
                        END IF
                    END IF
                END IF
            END WHILE
            go = 1
            WHILE go = 1
                IF b < a THEN
                    go = 0
                ELSE
                    c = buf[b]
                    IF c = 32 THEN
                        b = b - 1
                    ELSE
                        IF c = 9 THEN
                            b = b - 1
                        ELSE
                            go = 0
                        END IF
                    END IF
                END IF
            END WHILE
            IF a <= b THEN
                c = buf[a]
                IF c = 59 THEN
                    a = b + 1
                ELSE
                    IF c = 35 THEN
                        a = b + 1
                    ELSE
                        IF c = 91 THEN
                            IF buf[b] = 93 THEN
                                h = RangeHash(a + 1, b - 1)
                                sid = FindSec(h)
                                IF sid = 0 THEN
                                    IF nsec < 16 THEN
                                        nsec = nsec + 1
                                        sech[nsec] = h
                                        cursec = nsec
                                    ELSE
                                        lastn = 2
                                        RETURN 2
                                    END IF
                                ELSE
                                    cursec = sid
                                END IF
                            END IF
                        ELSE
                            StoreKey(cursec, a, b)
                            IF lastn = 2 THEN
                                RETURN 2
                            END IF
                        END IF
                    END IF
                END IF
            END IF
        END WHILE
        lastn = 0
        RETURN 0
    END FUNCTION

    FUNCTION GetInteger(sec AS S32, keyn AS S32, defn AS S32) AS S32
        LET i AS S32 = 1
        ASSERT(1 = 1)
        WHILE i <= kn
            IF sec_of[i] = sec THEN
                IF key_of[i] = keyn THEN
                    IF hasnum[i] = 1 THEN
                        RETURN val_of[i]
                    END IF
                    RETURN defn
                END IF
            END IF
            i = i + 1
        END WHILE
        RETURN defn
    END FUNCTION

    FUNCTION GetBoolean(sec AS S32, keyn AS S32, defn AS S32) AS S32
        LET i AS S32 = 1
        LET ht AS S32 = 0
        LET hy AS S32 = 0
        LET ho AS S32 = 0
        LET hf AS S32 = 0
        LET hn AS S32 = 0
        LET hf2 AS S32 = 0
        LET h1 AS S32 = 0
        LET h0 AS S32 = 0
        ASSERT(1 = 1)
        ht = HashOf(116, 114, 117, 101, 4)
        hy = HashOf(121, 101, 115, 0, 3)
        ho = HashOf(111, 110, 0, 0, 2)
        hf = Fold(HashOf(102, 97, 108, 115, 4), 101)
        hn = HashOf(110, 111, 0, 0, 2)
        hf2 = HashOf(111, 102, 102, 0, 3)
        h1 = HashOf(49, 0, 0, 0, 1)
        h0 = HashOf(48, 0, 0, 0, 1)
        WHILE i <= kn
            IF sec_of[i] = sec THEN
                IF key_of[i] = keyn THEN
                    IF vhash[i] = ht THEN
                        RETURN 1
                    END IF
                    IF vhash[i] = hy THEN
                        RETURN 1
                    END IF
                    IF vhash[i] = ho THEN
                        RETURN 1
                    END IF
                    IF vhash[i] = h1 THEN
                        RETURN 1
                    END IF
                    IF vhash[i] = hf THEN
                        RETURN 0
                    END IF
                    IF vhash[i] = hn THEN
                        RETURN 0
                    END IF
                    IF vhash[i] = hf2 THEN
                        RETURN 0
                    END IF
                    IF vhash[i] = h0 THEN
                        RETURN 0
                    END IF
                    IF hasnum[i] = 1 THEN
                        IF val_of[i] <> 0 THEN
                            RETURN 1
                        END IF
                        RETURN 0
                    END IF
                    RETURN defn
                END IF
            END IF
            i = i + 1
        END WHILE
        RETURN defn
    END FUNCTION

    FUNCTION CfgSize() AS S32
        ASSERT(1 = 1)
        RETURN 64
    END FUNCTION

    FUNCTION LastResult() AS S32
        ASSERT(lastn >= 0)
        ASSERT(lastn <= 3)
        RETURN lastn
    END FUNCTION

    FUNCTION SecCount() AS S32
        ASSERT(nsec >= 0)
        ASSERT(nsec <= 16)
        RETURN nsec
    END FUNCTION

    FUNCTION KeyCount() AS S32
        ASSERT(kn >= 0)
        ASSERT(kn <= 64)
        RETURN kn
    END FUNCTION

    PROCEDURE ArmDemo()
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        buflen = 0
        lastn = 0
        PutByte(91)
        PutByte(114)
        PutByte(101)
        PutByte(100)
        PutByte(93)
        PutByte(10)
        PutByte(109)
        PutByte(97)
        PutByte(112)
        PutByte(115)
        PutByte(61)
        PutByte(49)
        PutByte(51)
        PutByte(10)
        PutByte(112)
        PutByte(97)
        PutByte(99)
        PutByte(107)
        PutByte(61)
        PutByte(49)
        PutByte(52)
        PutByte(53)
        PutByte(54)
        PutByte(10)
        PutByte(109)
        PutByte(97)
        PutByte(112)
        PutByte(119)
        PutByte(61)
        PutByte(49)
        PutByte(50)
        PutByte(56)
        PutByte(10)
        PutByte(109)
        PutByte(97)
        PutByte(112)
        PutByte(104)
        PutByte(61)
        PutByte(56)
        PutByte(48)
        PutByte(10)
        lastn = FillMem()
    END PROCEDURE

END MODULE
