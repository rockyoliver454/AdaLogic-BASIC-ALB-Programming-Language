-- ============================================================================
-- ALBOpus — OpusHead identification header
-- ============================================================================
-- Scans for ASCII "OpusHead". Chn() is the channel count at byte 9 of
-- that header (1-based offset +9 from the 'O'). Works on a raw header
-- or an Ogg page that contains one (io_samples/tiny.opus, tiny.ogg).
--
-- From release\examples\:
--   INCLUDE "../stdlib/io/alb_opus.albi"
--
-- ProbeBuf()  0 ok. Mapping family and coupled streams are not parsed.
-- This is a header probe only — it does not decode Opus packets to PCM.
-- ============================================================================

VERSION 1.0

DECLARE MODULE ALBOpus
    PROCEDURE Reset()
    PROCEDURE PutByte(b AS U8)
    FUNCTION ProbeBuf() AS S32
    FUNCTION Chn() AS S32
    FUNCTION Status() AS S32
END DECLARE MODULE

MODULE ALBOpus

    -- 1-based window. Scans for OpusHead; Chn is byte 9 of that header.
    STRICT src[4096] AS U8
    LET srclen AS S32 = 0
    LET chnn AS S32 = 0
    LET lastst AS S32 = 5

    PROCEDURE Reset()
        srclen = 0
        chnn = 0
        lastst = 5
    END PROCEDURE

    PROCEDURE PutByte(b AS U8)
        IF srclen >= 4096 THEN
            RETURN
        END IF
        srclen = srclen + 1
        src[srclen] = b
    END PROCEDURE

    FUNCTION Four(i AS S32, a AS S32, b AS S32, c AS S32, d AS S32) AS S32
        IF CAST(src[i] AS S32) <> a THEN
            RETURN 0
        END IF
        IF CAST(src[i + 1] AS S32) <> b THEN
            RETURN 0
        END IF
        IF CAST(src[i + 2] AS S32) <> c THEN
            RETURN 0
        END IF
        IF CAST(src[i + 3] AS S32) <> d THEN
            RETURN 0
        END IF
        RETURN 1
    END FUNCTION

    FUNCTION ProbeBuf() AS S32
        LET i AS S32 = 1
        chnn = 0
        IF srclen < 8 THEN
            lastst = 4
            RETURN lastst
        END IF
        WHILE i + 7 <= srclen
            -- 79 112 117 115 / 72 101 97 100 = "OpusHead"
            IF Four(i, 79, 112, 117, 115) <> 0 THEN
                IF Four(i + 4, 72, 101, 97, 100) <> 0 THEN
                    IF i + 9 <= srclen THEN
                        chnn = CAST(src[i + 9] AS S32)
                    END IF
                    lastst = 0
                    RETURN lastst
                END IF
            END IF
            i = i + 1
        END WHILE
        lastst = 3
        RETURN lastst
    END FUNCTION

    FUNCTION Chn() AS S32
        RETURN chnn
    END FUNCTION

    FUNCTION Status() AS S32
        RETURN lastst
    END FUNCTION

END MODULE
