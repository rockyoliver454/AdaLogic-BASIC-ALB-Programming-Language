-- ============================================================================
-- ALBPcx — ZSoft PCX header
-- ============================================================================
-- Manufacturer 0x0A, version 0..5, encoding 1 (RLE), bits per plane,
-- window xmin/ymin/xmax/ymax → W()=xmax-xmin+1, H() similarly.
-- Planes() is the color-plane count at offset 65.
--
-- From release\examples\:
--   INCLUDE "../stdlib/io/alb_pcx.albi"
--
-- ProbeBuf()  0 ok. Does not un-RLE the image. Encoding ≠ 1 → status 5.
-- Header is 128 bytes; truncated files are status 4.
-- ============================================================================

VERSION 1.0

DECLARE MODULE ALBPcx
    PROCEDURE Reset()
    PROCEDURE PutByte(b AS U8)
    FUNCTION ProbeBuf() AS S32
    FUNCTION W() AS S32
    FUNCTION H() AS S32
    FUNCTION Bpp() AS S32
    FUNCTION Planes() AS S32
    FUNCTION Status() AS S32
END DECLARE MODULE

MODULE ALBPcx

    -- 1-based window. Manufacturer 10, then version/encoding/window/planes.
    STRICT src[4096] AS U8
    LET srclen AS S32 = 0
    LET pw AS S32 = 0
    LET ph AS S32 = 0
    LET bppn AS S32 = 0
    LET pln AS S32 = 0
    LET lastst AS S32 = 5

    PROCEDURE Reset()
        srclen = 0
        pw = 0
        ph = 0
        bppn = 0
        pln = 0
        lastst = 5
    END PROCEDURE

    PROCEDURE PutByte(b AS U8)
        IF srclen >= 4096 THEN
            RETURN
        END IF
        srclen = srclen + 1
        src[srclen] = b
    END PROCEDURE

    FUNCTION GetU16(i AS S32) AS S32
        RETURN CAST(src[i] AS S32) + CAST(src[i + 1] AS S32) * 256
    END FUNCTION

    FUNCTION ProbeBuf() AS S32
        LET xmin AS S32 = 0
        LET ymin AS S32 = 0
        LET xmax AS S32 = 0
        LET ymax AS S32 = 0
        pw = 0
        ph = 0
        bppn = 0
        pln = 0
        IF srclen < 128 THEN
            lastst = 4
            RETURN lastst
        END IF
        IF src[1] <> 10 THEN
            lastst = 3
            RETURN lastst
        END IF
        IF CAST(src[2] AS S32) > 5 THEN
            lastst = 3
            RETURN lastst
        END IF
        IF src[3] <> 1 THEN
            lastst = 5
            RETURN lastst
        END IF
        bppn = CAST(src[4] AS S32)
        xmin = GetU16(5)
        ymin = GetU16(7)
        xmax = GetU16(9)
        ymax = GetU16(11)
        pw = xmax - xmin + 1
        ph = ymax - ymin + 1
        pln = CAST(src[66] AS S32)
        IF pw < 1 THEN
            lastst = 3
            RETURN lastst
        END IF
        IF ph < 1 THEN
            lastst = 3
            RETURN lastst
        END IF
        lastst = 0
        RETURN lastst
    END FUNCTION

    FUNCTION W() AS S32
        RETURN pw
    END FUNCTION

    FUNCTION H() AS S32
        RETURN ph
    END FUNCTION

    FUNCTION Bpp() AS S32
        RETURN bppn
    END FUNCTION

    FUNCTION Planes() AS S32
        RETURN pln
    END FUNCTION

    FUNCTION Status() AS S32
        RETURN lastst
    END FUNCTION

END MODULE
