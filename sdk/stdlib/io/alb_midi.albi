-- ============================================================================
-- ALBMidi — MIDI 1.0 Standard MIDI File
-- ============================================================================
-- MThd (header length ≥ 6) then format, track count, division (ticks per
-- quarter or SMPTE). If 22+ bytes are present, the next chunk must be MTrk.
--
-- From release\examples\:
--   INCLUDE "../stdlib/io/alb_midi.albi"
--
-- ProbeBuf()   0 ok. Format() 0/1/2, Tracks(), Division().
-- This is not a sequencer — delta times and channel events are not walked.
-- ============================================================================

VERSION 1.0

DECLARE MODULE ALBMidi
    PROCEDURE Reset()
    PROCEDURE PutByte(b AS U8)
    FUNCTION ProbeBuf() AS S32
    FUNCTION Format() AS S32
    FUNCTION Tracks() AS S32
    FUNCTION Division() AS S32
    FUNCTION Status() AS S32
END DECLARE MODULE

MODULE ALBMidi

    -- 1-based window. MThd header: format, track count, division (PPQN or SMPTE).
    STRICT src[4096] AS U8
    LET srclen AS S32 = 0
    LET fmtn AS S32 = 0
    LET ntrk AS S32 = 0
    LET divn AS S32 = 0
    LET lastst AS S32 = 5

    PROCEDURE Reset()
        srclen = 0
        fmtn = 0
        ntrk = 0
        divn = 0
        lastst = 5
    END PROCEDURE

    PROCEDURE PutByte(b AS U8)
        IF srclen >= 4096 THEN
            RETURN
        END IF
        srclen = srclen + 1
        src[srclen] = b
    END PROCEDURE

    FUNCTION Be16(i AS S32) AS S32
        RETURN CAST(src[i] AS S32) * 256 + CAST(src[i + 1] AS S32)
    END FUNCTION

    FUNCTION Be32(i AS S32) AS S32
        RETURN CAST(src[i] AS S32) * 16777216 + CAST(src[i + 1] AS S32) * 65536 + CAST(src[i + 2] AS S32) * 256 + CAST(src[i + 3] AS S32)
    END FUNCTION

    FUNCTION Four(i AS S32, a AS S32, b AS S32, c AS S32, d AS S32) AS S32
        IF CAST(src[i] AS S32) <> a THEN
            RETURN 0
        END IF
        IF CAST(src[i + 1] AS S32) <> b THEN
            RETURN 0
        END IF
        IF CAST(src[i + 2] AS S32) <> c THEN
            RETURN 0
        END IF
        IF CAST(src[i + 3] AS S32) <> d THEN
            RETURN 0
        END IF
        RETURN 1
    END FUNCTION

    FUNCTION ProbeBuf() AS S32
        LET hlen AS S32 = 0
        fmtn = 0
        ntrk = 0
        divn = 0
        IF srclen < 14 THEN
            lastst = 4
            RETURN lastst
        END IF
        IF Four(1, 77, 84, 104, 100) = 0 THEN
            lastst = 3
            RETURN lastst
        END IF
        hlen = Be32(5)
        IF hlen < 6 THEN
            lastst = 3
            RETURN lastst
        END IF
        fmtn = Be16(9)
        ntrk = Be16(11)
        divn = Be16(13)
        IF ntrk < 1 THEN
            lastst = 3
            RETURN lastst
        END IF
        IF srclen >= 22 THEN
            IF Four(15, 77, 84, 114, 107) = 0 THEN
                lastst = 4
                RETURN lastst
            END IF
        END IF
        lastst = 0
        RETURN lastst
    END FUNCTION

    FUNCTION Format() AS S32
        RETURN fmtn
    END FUNCTION

    FUNCTION Tracks() AS S32
        RETURN ntrk
    END FUNCTION

    FUNCTION Division() AS S32
        RETURN divn
    END FUNCTION

    FUNCTION Status() AS S32
        RETURN lastst
    END FUNCTION

END MODULE
