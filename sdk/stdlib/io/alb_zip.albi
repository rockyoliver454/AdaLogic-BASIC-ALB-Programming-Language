-- ============================================================================
-- ALBZip — ZIP local headers, stored or deflate extract
-- ============================================================================
-- Walks PK\003\004 local file headers. First member is FileCount slot 0
-- in the getters (NameLen0, Method0, Uncomp0).
-- INCLUDE alb_inflate.albi before this file for method 8 (deflate).
--
-- From release\examples\:
--   INCLUDE "../stdlib/io/alb_crc32.albi"
--   INCLUDE "../stdlib/io/alb_inflate.albi"
--   INCLUDE "../stdlib/io/alb_zip.albi"
--
-- WalkBuf()     0 ok. FileCount() how many local headers fit the window.
-- Extract0()    inflate or copy member 0 into OutAt / OutLen.
-- Method 0 stored, method 8 deflate. Encrypt, Zip64, data descriptors
-- that omit sizes → status 5. Cap 64 members. LoadPath for binary.
-- ============================================================================

VERSION 1.0

DECLARE MODULE ALBZip
    PROCEDURE Reset()
    PROCEDURE PutByte(b AS U8)
    FUNCTION WalkBuf() AS S32
    FUNCTION FileCount() AS S32
    FUNCTION Method0() AS S32
    FUNCTION NameLen0() AS S32
    FUNCTION NameByte0(i AS S32) AS U8
    FUNCTION Flags0() AS S32
    FUNCTION Comp0() AS S32
    FUNCTION IsSafeName0() AS S32
    FUNCTION Uncomp0() AS S32
    FUNCTION Extract0() AS S32
    FUNCTION OutLen() AS S32
    FUNCTION OutAt(i AS S32) AS U8
    FUNCTION Status() AS S32
END DECLARE MODULE

MODULE ALBZip

    -- src[] local-header walk. outb[] is member 0 after Extract0 (1-based).
    STRICT src[8192] AS U8
    STRICT outb[4096] AS U8
    LET srclen AS S32 = 0
    LET nfile AS S32 = 0
    LET meth0 AS S32 = 0
    LET flags0 AS S32 = 0
    LET nlen0 AS S32 = 0
    LET name0 AS S32 = 0
    LET comp0 AS S32 = 0
    LET safe0 AS S32 = 0
    LET un0 AS S32 = 0
    LET csz0 AS S32 = 0
    LET data0 AS S32 = 0
    LET outn AS S32 = 0
    LET lastst AS S32 = 5

    PROCEDURE Reset()
        srclen = 0
        nfile = 0
        meth0 = 0
        flags0 = 0
        nlen0 = 0
        name0 = 0
        comp0 = 0
        safe0 = 0
        un0 = 0
        csz0 = 0
        data0 = 0
        outn = 0
        lastst = 5
    END PROCEDURE

    PROCEDURE PutByte(b AS U8)
        IF srclen >= 8192 THEN
            RETURN
        END IF
        srclen = srclen + 1
        src[srclen] = b
    END PROCEDURE

    FUNCTION GetU16(i AS S32) AS S32
        RETURN CAST(src[i] AS S32) + CAST(src[i + 1] AS S32) * 256
    END FUNCTION

    FUNCTION GetU32(i AS S32) AS S32
        RETURN GetU16(i) + GetU16(i + 2) * 65536
    END FUNCTION

    FUNCTION WalkBuf() AS S32
        LET i AS S32 = 1
        LET j AS S32 = 0
        LET flags AS S32 = 0
        LET meth AS S32 = 0
        LET nlen AS S32 = 0
        LET elen AS S32 = 0
        LET csz AS S32 = 0
        LET usz AS S32 = 0
        LET data_pos AS S32 = 0
        LET safe AS S32 = 1
        LET prev AS S32 = 0
        nfile = 0
        IF srclen < 30 THEN
            lastst = 4
            RETURN lastst
        END IF
        WHILE i <= srclen
            IF i + 3 > srclen THEN
                lastst = 4
                RETURN lastst
            END IF
            IF src[i] <> 80 OR src[i + 1] <> 75 THEN
                lastst = 3
                RETURN lastst
            END IF
            IF src[i + 2] = 1 AND src[i + 3] = 2 THEN
                i = srclen + 1
            ELSE
                IF src[i + 2] <> 3 OR src[i + 3] <> 4 THEN
                    lastst = 5
                    RETURN lastst
                END IF
                IF i + 29 > srclen THEN
                    lastst = 4
                    RETURN lastst
                END IF
                flags = GetU16(i + 6)
                meth = GetU16(i + 8)
                IF src[i + 21] > 127 OR src[i + 25] > 127 THEN
                    lastst = 2
                    RETURN lastst
                END IF
                csz = GetU32(i + 18)
                usz = GetU32(i + 22)
                nlen = GetU16(i + 26)
                elen = GetU16(i + 28)
                IF nlen < 1 THEN
                    lastst = 5
                    RETURN lastst
                END IF
                data_pos = i + 30 + nlen + elen
                IF data_pos < i OR data_pos > srclen + 1 THEN
                    lastst = 4
                    RETURN lastst
                END IF
                IF csz < 0 OR data_pos + csz - 1 > srclen THEN
                    lastst = 4
                    RETURN lastst
                END IF
                IF (flags AND 1) <> 0 OR (flags AND 8) <> 0 THEN
                    lastst = 5
                    RETURN lastst
                END IF
                IF meth <> 0 AND meth <> 8 THEN
                    lastst = 5
                    RETURN lastst
                END IF
                safe = 1
                j = 0
                prev = 0
                WHILE j < nlen
                    IF src[i + 30 + j] = 0 OR src[i + 30 + j] = 58 THEN safe = 0 END IF
                    IF j = 0 THEN
                        IF src[i + 30 + j] = 47 OR src[i + 30 + j] = 92 THEN safe = 0 END IF
                    END IF
                    IF src[i + 30 + j] = 46 AND prev = 46 THEN safe = 0 END IF
                    prev = CAST(src[i + 30 + j] AS S32)
                    j = j + 1
                END WHILE
                IF nfile = 0 THEN
                    flags0 = flags
                    meth0 = meth
                    nlen0 = nlen
                    name0 = i + 30
                    safe0 = safe
                    un0 = usz
                    csz0 = csz
                    comp0 = csz
                    data0 = data_pos
                END IF
                nfile = nfile + 1
                IF nfile > 64 THEN
                    lastst = 2
                    RETURN lastst
                END IF
                i = data_pos + csz
            END IF
        END WHILE
        IF nfile < 1 THEN
            lastst = 3
            RETURN lastst
        END IF
        lastst = 0
        RETURN lastst
    END FUNCTION

    FUNCTION Extract0() AS S32
        LET i AS S32 = 0
        outn = 0
        IF nfile < 1 THEN
            lastst = 3
            RETURN lastst
        END IF
        IF meth0 = 0 THEN
            IF un0 > 4096 THEN
                lastst = 2
                RETURN lastst
            END IF
            i = 0
            WHILE i < un0
                IF data0 + i > srclen THEN
                    lastst = 4
                    RETURN lastst
                END IF
                outb[i + 1] = src[data0 + i]
                i = i + 1
            END WHILE
            outn = un0
            lastst = 0
            RETURN lastst
        END IF
        IF meth0 = 8 THEN
            PeeEnGee_Inflate.SrcReset()
            i = 0
            WHILE i < csz0
                IF data0 + i > srclen THEN
                    lastst = 4
                    RETURN lastst
                END IF
                PeeEnGee_Inflate.SrcPut(src[data0 + i])
                i = i + 1
            END WHILE
            lastst = PeeEnGee_Inflate.InflateRaw()
            outn = PeeEnGee_Inflate.OutLen()
            RETURN lastst
        END IF
        lastst = 5
        RETURN lastst
    END FUNCTION

    FUNCTION FileCount() AS S32
        RETURN nfile
    END FUNCTION

    FUNCTION Method0() AS S32
        RETURN meth0
    END FUNCTION

    FUNCTION NameLen0() AS S32
        RETURN nlen0
    END FUNCTION

    FUNCTION NameByte0(i AS S32) AS U8
        IF i < 1 OR i > nlen0 THEN RETURN 0 END IF
        RETURN src[name0 + i - 1]
    END FUNCTION

    FUNCTION Flags0() AS S32
        RETURN flags0
    END FUNCTION

    FUNCTION Comp0() AS S32
        RETURN comp0
    END FUNCTION

    FUNCTION IsSafeName0() AS S32
        RETURN safe0
    END FUNCTION

    FUNCTION Uncomp0() AS S32
        RETURN un0
    END FUNCTION

    FUNCTION OutLen() AS S32
        IF meth0 = 8 THEN
            RETURN PeeEnGee_Inflate.OutLen()
        END IF
        RETURN outn
    END FUNCTION

    FUNCTION OutAt(i AS S32) AS U8
        IF meth0 = 8 THEN
            RETURN PeeEnGee_Inflate.OutAt(i)
        END IF
        IF i < 1 THEN
            RETURN 0
        END IF
        IF i > outn THEN
            RETURN 0
        END IF
        RETURN outb[i]
    END FUNCTION

    FUNCTION Status() AS S32
        RETURN lastst
    END FUNCTION

END MODULE
