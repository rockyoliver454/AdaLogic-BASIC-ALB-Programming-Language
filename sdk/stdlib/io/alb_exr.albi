-- ============================================================================
-- ALBExr — OpenEXR magic
-- ============================================================================
-- Magic 76 2F 31 01 (little-endian 20000630), VerN() version byte.
--
-- From release\examples\:
--   INCLUDE "../stdlib/io/alb_exr.albi"
--
-- ProbeBuf()  0 ok. Channel list, data windows, and PIZ/ZIP scanlines
-- are not parsed. 9 bytes is enough for the kit fixture.
-- ============================================================================

VERSION 1.0

DECLARE MODULE ALBExr
    PROCEDURE Reset()
    PROCEDURE PutByte(b AS U8)
    FUNCTION ProbeBuf() AS S32
    FUNCTION VerN() AS S32
    FUNCTION Status() AS S32
END DECLARE MODULE

MODULE ALBExr

    -- 1-based window. Magic 76 2F 31 01. VerN is the version byte at index 5.
    STRICT src[4096] AS U8
    LET srclen AS S32 = 0
    LET vern AS S32 = 0
    LET lastst AS S32 = 5

    PROCEDURE Reset()
        srclen = 0
        vern = 0
        lastst = 5
    END PROCEDURE

    PROCEDURE PutByte(b AS U8)
        IF srclen >= 4096 THEN
            RETURN
        END IF
        srclen = srclen + 1
        src[srclen] = b
    END PROCEDURE

    FUNCTION ProbeBuf() AS S32
        vern = 0
        IF srclen < 8 THEN
            lastst = 4
            RETURN lastst
        END IF
        -- 118 47 49 1 = OpenEXR magic 0x762F3101.
        IF src[1] <> 118 THEN
            lastst = 3
            RETURN lastst
        END IF
        IF src[2] <> 47 THEN
            lastst = 3
            RETURN lastst
        END IF
        IF src[3] <> 49 THEN
            lastst = 3
            RETURN lastst
        END IF
        IF src[4] <> 1 THEN
            lastst = 3
            RETURN lastst
        END IF
        vern = CAST(src[5] AS S32)
        lastst = 0
        RETURN lastst
    END FUNCTION

    FUNCTION VerN() AS S32
        RETURN vern
    END FUNCTION

    FUNCTION Status() AS S32
        RETURN lastst
    END FUNCTION

END MODULE
