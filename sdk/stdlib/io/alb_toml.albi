-- ============================================================================
-- ALBToml — TOML v1.0 line probe
-- ============================================================================
-- Counts [section] headers and `key = value` lines. Not a typed table,
-- not dotted keys, not arrays of tables.
--
-- From release\examples\:
--   INCLUDE "../stdlib/io/alb_toml.albi"
--
-- ParseBuf()   0 ok. Sections() / Keys() counts. UTF-8 file is fine if
-- you loaded with LoadText or LoadPath. Cap 64 keys in spirit of #IO_TOML_MAX_KEYS.
-- ============================================================================

VERSION 1.0

DECLARE MODULE ALBToml
    PROCEDURE Reset()
    PROCEDURE PutByte(b AS U8)
    FUNCTION ParseBuf() AS S32
    FUNCTION Sections() AS S32
    FUNCTION Keys() AS S32
    FUNCTION Status() AS S32
END DECLARE MODULE

MODULE ALBToml

    -- 1-based window. Counts [sections] and keys. Not a value store.
    STRICT src[8192] AS U8
    LET srclen AS S32 = 0
    LET nsec AS S32 = 0
    LET nkey AS S32 = 0
    LET lastst AS S32 = 5

    PROCEDURE Reset()
        srclen = 0
        nsec = 0
        nkey = 0
        lastst = 5
    END PROCEDURE

    PROCEDURE PutByte(b AS U8)
        IF srclen >= 8192 THEN
            RETURN
        END IF
        srclen = srclen + 1
        src[srclen] = b
    END PROCEDURE

    FUNCTION ParseBuf() AS S32
        LET i AS S32 = 1
        LET bol AS S32 = 1
        LET c AS S32 = 0
        LET skip AS S32 = 0
        nsec = 0
        nkey = 0
        IF srclen < 1 THEN
            lastst = 4
            RETURN lastst
        END IF
        WHILE i <= srclen
            c = CAST(src[i] AS S32)
            IF c = 10 THEN
                bol = 1
                skip = 0
            ELSE
                IF bol <> 0 THEN
                    IF c = 32 THEN
                    ELSE
                        IF c = 9 THEN
                        ELSE
                            bol = 0
                            IF c = 35 THEN
                                skip = 1
                            ELSE
                                IF c = 91 THEN
                                    nsec = nsec + 1
                                ELSE
                                    nkey = nkey + 1
                                    IF nkey > 64 THEN
                                        lastst = 2
                                        RETURN lastst
                                    END IF
                                END IF
                            END IF
                        END IF
                    END IF
                END IF
            END IF
            i = i + 1
        END WHILE
        lastst = 0
        RETURN lastst
    END FUNCTION

    FUNCTION Sections() AS S32
        RETURN nsec
    END FUNCTION

    FUNCTION Keys() AS S32
        RETURN nkey
    END FUNCTION

    FUNCTION Status() AS S32
        RETURN lastst
    END FUNCTION

END MODULE
