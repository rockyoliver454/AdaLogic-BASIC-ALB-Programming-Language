-- ============================================================================
-- ALBNetcdf — NetCDF classic (CDF\001) and 64-bit offset (CDF\002)
-- ============================================================================
-- Magic "CDF" + version byte 1 or 2, then NumRecs() (big-endian; 0 means
-- no records yet). Dimension / attribute / variable lists are not walked.
--
-- From release\examples\:
--   INCLUDE "../stdlib/io/alb_netcdf.albi"
--
-- ProbeBuf()  0 ok. NetCDF-4 is an HDF5 file — use ALBHdf5, not this module.
-- ============================================================================

VERSION 1.0

DECLARE MODULE ALBNetcdf
    PROCEDURE Reset()
    PROCEDURE PutByte(b AS U8)
    FUNCTION ProbeBuf() AS S32
    FUNCTION VerN() AS S32
    FUNCTION NumRecs() AS S32
    FUNCTION Status() AS S32
END DECLARE MODULE

MODULE ALBNetcdf

    -- 1-based window. CDF classic / 64-bit offset. NetCDF-4 lives in HDF5 (ALBSkip kind 3).
    STRICT src[4096] AS U8
    LET srclen AS S32 = 0
    LET vern AS S32 = 0
    LET nrec AS S32 = 0
    LET lastst AS S32 = 5

    PROCEDURE Reset()
        srclen = 0
        vern = 0
        nrec = 0
        lastst = 5
    END PROCEDURE

    PROCEDURE PutByte(b AS U8)
        IF srclen >= 4096 THEN
            RETURN
        END IF
        srclen = srclen + 1
        src[srclen] = b
    END PROCEDURE

    FUNCTION Be32(i AS S32) AS S32
        RETURN CAST(src[i] AS S32) * 16777216 + CAST(src[i + 1] AS S32) * 65536 + CAST(src[i + 2] AS S32) * 256 + CAST(src[i + 3] AS S32)
    END FUNCTION

    FUNCTION ProbeBuf() AS S32
        vern = 0
        nrec = 0
        IF srclen < 8 THEN
            lastst = 4
            RETURN lastst
        END IF
        IF src[1] <> 67 THEN
            lastst = 3
            RETURN lastst
        END IF
        IF src[2] <> 68 THEN
            lastst = 3
            RETURN lastst
        END IF
        IF src[3] <> 70 THEN
            lastst = 3
            RETURN lastst
        END IF
        vern = CAST(src[4] AS S32)
        IF vern <> 1 THEN
            IF vern <> 2 THEN
                lastst = 5
                RETURN lastst
            END IF
        END IF
        nrec = Be32(5)
        lastst = 0
        RETURN lastst
    END FUNCTION

    FUNCTION VerN() AS S32
        RETURN vern
    END FUNCTION

    FUNCTION NumRecs() AS S32
        RETURN nrec
    END FUNCTION

    FUNCTION Status() AS S32
        RETURN lastst
    END FUNCTION

END MODULE
