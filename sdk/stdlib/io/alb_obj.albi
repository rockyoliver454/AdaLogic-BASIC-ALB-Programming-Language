-- ============================================================================
-- ALBObj — Wavefront OBJ counters
-- ============================================================================
-- ASCII only. Counts `v` (VCount) and `f` (FCount). Does not store
-- coordinates or triangulate.
--
-- From release\examples\:
--   INCLUDE "../stdlib/io/alb_obj.albi"
--
-- ParseBuf()  0 ok. Cap 256 vertices' worth of lines in an 8192 window.
-- `vt` / `vn` / `o` / `g` are ignored. Binary OBJ does not exist here.
-- ============================================================================

VERSION 1.0

DECLARE MODULE ALBObj
    PROCEDURE Reset()
    PROCEDURE PutByte(b AS U8)
    FUNCTION ParseBuf() AS S32
    FUNCTION VCount() AS S32
    FUNCTION FCount() AS S32
    FUNCTION Status() AS S32
END DECLARE MODULE

MODULE ALBObj

    -- 1-based window. Counts v / vt / vn / f lines. Not a triangulator.
    STRICT src[8192] AS U8
    LET srclen AS S32 = 0
    LET nv AS S32 = 0
    LET nf AS S32 = 0
    LET lastst AS S32 = 5

    PROCEDURE Reset()
        srclen = 0
        nv = 0
        nf = 0
        lastst = 5
    END PROCEDURE

    PROCEDURE PutByte(b AS U8)
        IF srclen >= 8192 THEN
            RETURN
        END IF
        srclen = srclen + 1
        src[srclen] = b
    END PROCEDURE

    FUNCTION ParseBuf() AS S32
        LET i AS S32 = 1
        LET bol AS S32 = 1
        LET c AS S32 = 0
        nv = 0
        nf = 0
        IF srclen < 1 THEN
            lastst = 4
            RETURN lastst
        END IF
        WHILE i <= srclen
            c = CAST(src[i] AS S32)
            IF bol <> 0 THEN
                IF c = 118 THEN
                    IF i + 1 <= srclen THEN
                        IF src[i + 1] = 32 THEN
                            nv = nv + 1
                            IF nv > 256 THEN
                                lastst = 2
                                RETURN lastst
                            END IF
                        END IF
                    END IF
                END IF
                IF c = 102 THEN
                    IF i + 1 <= srclen THEN
                        IF src[i + 1] = 32 THEN
                            nf = nf + 1
                        END IF
                    END IF
                END IF
                bol = 0
            END IF
            IF c = 10 THEN
                bol = 1
            END IF
            i = i + 1
        END WHILE
        lastst = 0
        RETURN lastst
    END FUNCTION

    FUNCTION VCount() AS S32
        RETURN nv
    END FUNCTION

    FUNCTION FCount() AS S32
        RETURN nf
    END FUNCTION

    FUNCTION Status() AS S32
        RETURN lastst
    END FUNCTION

END MODULE
