-- Twin of Ada Shaders_Common: night vision + RF static.
VERSION 1.0

DECLARE MODULE GdCommonFx
    PROCEDURE PresentNv()
    PROCEDURE PresentStatic(n AS S32)
END DECLARE MODULE

MODULE GdCommonFx

    PROCEDURE PresentNv()
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        COLOR $14532D
        FILL RECT 0, 0, 640, 6
        COLOR $22C55E
        FILL RECT 0, 354, 640, 6
    END PROCEDURE

    PROCEDURE PresentStatic(n AS S32)
        LET i AS S32 = 0
        LET x AS S32 = 0
        LET y AS S32 = 0
        ASSERT(n >= 0)
        ASSERT(n <= 32)
        COLOR $94A3B8
        WHILE i < n
            x = (i * 73) MOD 640
            y = (i * 19) MOD 360
            FILL RECT x, y, 24, 1
            i = i + 1
        END WHILE
    END PROCEDURE

END MODULE
