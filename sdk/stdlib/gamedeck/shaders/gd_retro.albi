-- Twin of Ada Shaders_Retro. Apply* write the VGPU FB. Present* keep window bars.
VERSION 1.0

DECLARE MODULE GdRetro
    PROCEDURE PresentRaster()
    PROCEDURE PresentCopper()
    PROCEDURE PresentGb()
    PROCEDURE PresentDither()
    PROCEDURE PresentFloor7(t AS S32)
    PROCEDURE ApplyRaster(t AS S32)
    PROCEDURE ApplyCopper(t AS S32)
    PROCEDURE ApplyPlasma(t AS S32)
    PROCEDURE ApplyGb()
    PROCEDURE ApplyDither()
    PROCEDURE ApplyFloor7(t AS S32)
    FUNCTION SelfTest() AS S32
END DECLARE MODULE

MODULE GdRetro

    PROCEDURE PresentRaster()
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        COLOR $7C3AED
        FILL RECT 0, 40, 640, 6
        COLOR $2563EB
        FILL RECT 0, 56, 640, 6
        COLOR $DC2626
        FILL RECT 0, 72, 640, 6
    END PROCEDURE

    PROCEDURE PresentCopper()
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        COLOR $F59E0B
        FILL RECT 0, 90, 640, 4
        COLOR $FBBF24
        FILL RECT 0, 98, 640, 4
    END PROCEDURE

    PROCEDURE PresentGb()
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        COLOR $365314
        FILL RECT 480, 40, 140, 80
        COLOR $4ADE80
        FILL RECT 488, 48, 124, 64
    END PROCEDURE

    PROCEDURE PresentDither()
        LET i AS S32 = 0
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        COLOR $1F2937
        WHILE i < 16
            IF GdProc.Bayer(i, 0) > 1 THEN
                FILL RECT 8 + i * 8, 120, 6, 6
            END IF
            i = i + 1
        END WHILE
    END PROCEDURE

    PROCEDURE PresentFloor7(t AS S32)
        LET y AS S32 = 0
        LET w AS S32 = 0
        LET x AS S32 = 0
        ASSERT(t >= 0)
        ASSERT(t <= 255)
        WHILE y < 8
            w = 80 + y * 24 + (t AND 7)
            x = 320 - w / 2
            COLOR $334155
            FILL RECT x, 200 + y * 8, w, 7
            y = y + 1
        END WHILE
    END PROCEDURE

    PROCEDURE ApplyRaster(t AS S32)
        LET y AS S32 = 0
        LET idx AS S32 = 0
        ASSERT(t >= 0)
        ASSERT(1 = 1)
        WHILE y < GdVgpu.FbH()
            idx = 16 + ((y / 4 + t) AND 15)
            GdVgpu.RowFill(y, idx)
            y = y + 1
        END WHILE
    END PROCEDURE

    PROCEDURE ApplyCopper(t AS S32)
        LET y AS S32 = 0
        LET idx AS S32 = 0
        ASSERT(t >= 0)
        ASSERT(1 = 1)
        WHILE y < GdVgpu.FbH()
            idx = 40 + GdCordic.Sin8(y * 3 + t) / 4
            IF idx < 0 THEN
                idx = 0 - idx
            END IF
            GdVgpu.RowFill(y, idx AND 255)
            y = y + 1
        END WHILE
    END PROCEDURE

    PROCEDURE ApplyPlasma(t AS S32)
        LET x AS S32 = 0
        LET y AS S32 = 0
        LET v AS S32 = 0
        ASSERT(t >= 0)
        ASSERT(1 = 1)
        WHILE y < GdVgpu.FbH()
            x = 0
            WHILE x < GdVgpu.FbW()
                v = GdCordic.Sin8(x + t) + GdCordic.Cos8(y + t / 2)
                v = v + GdCordic.Sin8((x + y) / 2)
                IF v < 0 THEN
                    v = 0 - v
                END IF
                GdVgpu.Put(x, y, v AND 255)
                x = x + 1
            END WHILE
            y = y + 1
        END WHILE
    END PROCEDURE

    PROCEDURE ApplyGb()
        LET x AS S32 = 0
        LET y AS S32 = 0
        LET v AS S32 = 0
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        WHILE y < GdVgpu.FbH()
            x = 0
            WHILE x < GdVgpu.FbW()
                v = (GdVgpu.Get(x, y) / 64) * 20 + 32
                GdVgpu.Put(x, y, v)
                x = x + 1
            END WHILE
            y = y + 1
        END WHILE
    END PROCEDURE

    PROCEDURE ApplyDither()
        LET x AS S32 = 0
        LET y AS S32 = 0
        LET v AS S32 = 0
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        WHILE y < GdVgpu.FbH()
            x = 0
            WHILE x < GdVgpu.FbW()
                v = GdVgpu.Get(x, y) + GdProc.Bayer(x, y) * 8
                GdVgpu.Put(x, y, v AND 255)
                x = x + 1
            END WHILE
            y = y + 1
        END WHILE
    END PROCEDURE

    PROCEDURE ApplyFloor7(t AS S32)
        LET y AS S32 = 0
        LET x AS S32 = 0
        LET h AS S32 = 0
        LET cx AS S32 = 0
        LET row AS S32 = 0
        LET sc AS S32 = 0
        LET u AS S32 = 0
        LET v AS S32 = 0
        LET idx AS S32 = 0
        ASSERT(t >= 0)
        ASSERT(t <= 255)
        h = GdVgpu.FbH()
        cx = GdVgpu.FbW() / 2
        y = h / 2
        WHILE y < h
            row = y - h / 2 + 1
            sc = 256 / row
            x = 0
            WHILE x < GdVgpu.FbW()
                u = (x - cx) * sc / 8 + t
                v = sc + t
                idx = 16
                IF ((u / 8) AND 1) = ((v / 8) AND 1) THEN
                    idx = 28
                END IF
                GdVgpu.Put(x, y, idx)
                x = x + 1
            END WHILE
            y = y + 1
        END WHILE
    END PROCEDURE

    FUNCTION SelfTest() AS S32
        LET n AS S32 = 0
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        GdVgpu.WipeFb(0)
        ApplyRaster(4)
        IF GdVgpu.Get(0, 0) <> 0 THEN
            n = n + 1
        END IF
        IF GdVgpu.Get(0, 8) <> GdVgpu.Get(0, 0) THEN
            n = n + 1
        END IF
        GdVgpu.WipeFb(0)
        ApplyFloor7(0)
        IF GdVgpu.Get(80, 90) <> 0 THEN
            n = n + 1
        END IF
        IF n = 3 THEN
            RETURN 1
        END IF
        RETURN 0
    END FUNCTION

END MODULE
