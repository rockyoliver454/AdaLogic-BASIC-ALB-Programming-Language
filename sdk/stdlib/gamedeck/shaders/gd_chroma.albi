-- Software chromatic fringe. Not GLSL.
VERSION 1.0

DECLARE MODULE GdChroma
    PROCEDURE PresentFringe()
END DECLARE MODULE

MODULE GdChroma

    PROCEDURE PresentFringe()
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        COLOR $7F1D1D
        FILL RECT 0, 0, 2, 360
        COLOR $1E3A8A
        FILL RECT 638, 0, 2, 360
    END PROCEDURE

END MODULE
