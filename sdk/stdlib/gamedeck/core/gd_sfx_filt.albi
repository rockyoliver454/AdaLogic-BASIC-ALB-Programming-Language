-- Twin of C soundforge hi/lo/mid pass. Integer one-pole.
VERSION 1.0

DECLARE MODULE GdSfxFilt
    FUNCTION LoPass(x AS S32, prev AS S32) AS S32
    FUNCTION HiPass(x AS S32, prev AS S32) AS S32
    FUNCTION MidPass(x AS S32, prev AS S32) AS S32
END DECLARE MODULE

MODULE GdSfxFilt

    FUNCTION LoPass(x AS S32, prev AS S32) AS S32
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        RETURN (x + prev) / 2
    END FUNCTION
    FUNCTION HiPass(x AS S32, prev AS S32) AS S32
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        RETURN x - prev
    END FUNCTION
    FUNCTION MidPass(x AS S32, prev AS S32) AS S32
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        RETURN (LoPass(x, prev) + HiPass(x, prev)) / 2
    END FUNCTION

END MODULE
