-- Twin of Ada core_sfx_square.
VERSION 1.0

DECLARE MODULE GdSfxSq
    FUNCTION SampleAt(phase AS S32) AS S32
END DECLARE MODULE

MODULE GdSfxSq

    FUNCTION SampleAt(phase AS S32) AS S32
        LET a AS S32 = phase MOD 256
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        IF a < 0 THEN
            a = a + 256
        END IF
        IF a < 128 THEN
            RETURN 80
        END IF
        RETURN 0 - 80
    END FUNCTION

END MODULE
