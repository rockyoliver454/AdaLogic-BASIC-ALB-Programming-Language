-- Twin of Ada core_sfx_sine. Explicit sine sample.
VERSION 1.0

DECLARE MODULE GdSfxSine
    FUNCTION SampleAt(phase AS S32) AS S32
END DECLARE MODULE

MODULE GdSfxSine

    FUNCTION SampleAt(phase AS S32) AS S32
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        RETURN GdCordic.Sin8(phase)
    END FUNCTION

END MODULE
