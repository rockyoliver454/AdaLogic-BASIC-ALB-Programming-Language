-- Twin of Ada core_anisotropic. Directional RGB weight, not identity.
VERSION 1.0

DECLARE MODULE GdAniso
    FUNCTION PassRgb(c AS S32) AS S32
    PROCEDURE ApplyFb()
    FUNCTION SelfTest() AS S32
END DECLARE MODULE

MODULE GdAniso

    FUNCTION PassRgb(c AS S32) AS S32
        LET r AS S32 = 0
        LET g AS S32 = 0
        LET b AS S32 = 0
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        r = (c / 65536) AND 255
        g = (c / 256) AND 255
        b = c AND 255
        r = (r * 2 + g) / 3
        b = (b + g) / 2
        RETURN r * 65536 + g * 256 + b
    END FUNCTION

    PROCEDURE ApplyFb()
        LET x AS S32 = 1
        LET y AS S32 = 0
        LET a AS S32 = 0
        LET b AS S32 = 0
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        WHILE y < GdVgpu.FbH()
            x = 1
            WHILE x < GdVgpu.FbW()
                a = GdVgpu.Get(x - 1, y)
                b = GdVgpu.Get(x, y)
                GdVgpu.Put(x, y, (a + b * 3) / 4)
                x = x + 1
            END WHILE
            y = y + 1
        END WHILE
    END PROCEDURE

    FUNCTION SelfTest() AS S32
        LET a AS S32 = 0
        LET b AS S32 = 0
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        a = PassRgb(255)
        b = PassRgb(255 * 65536)
        IF a <> b THEN
            RETURN 1
        END IF
        RETURN 0
    END FUNCTION

END MODULE
