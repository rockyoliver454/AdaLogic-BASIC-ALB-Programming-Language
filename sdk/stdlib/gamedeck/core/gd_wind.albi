-- Twin of Ada desert_winds. Nav heading + audio Generate block (brown/pink/howl).
VERSION 1.0

DECLARE MODULE GdWind
    PROCEDURE Pulse()
    FUNCTION Heading() AS S32
    FUNCTION Strength() AS S32
    FUNCTION Sample() AS S32
    PROCEDURE Generate(n AS S32, intensity AS S32, seed AS S32)
    FUNCTION BlockAt(i AS S32) AS S32
    FUNCTION BlockN() AS S32
    FUNCTION Energy() AS S32
    FUNCTION SelfTest() AS S32
END DECLARE MODULE

MODULE GdWind

    STRICT blk[256] AS S32
    LET hd AS S32 = 40
    LET st AS S32 = 8
    LET bn AS S32 = 0
    LET brown AS S32 = 0
    LET eng AS S32 = 0

    PROCEDURE Pulse()
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        hd = (hd + 1) MOD 256
        st = 6 + (hd AND 7)
    END PROCEDURE

    FUNCTION Heading() AS S32
        ASSERT(hd >= 0)
        ASSERT(hd <= 255)
        RETURN hd
    END FUNCTION

    FUNCTION Strength() AS S32
        ASSERT(st >= 0)
        ASSERT(st <= 32)
        RETURN st
    END FUNCTION

    FUNCTION Sample() AS S32
        LET n AS S32 = 0
        LET p AS S32 = 0
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        n = GdHash.ByteOf(hd, st, 11) - 128
        p = GdPink.PinkAt(hd, st, 19) - 128
        brown = (brown * 7 + n) / 8
        RETURN ((brown + p / 2) * st) / 8
    END FUNCTION

    PROCEDURE Generate(n AS S32, intensity AS S32, seed AS S32)
        LET i AS S32 = 1
        LET w AS S32 = 0
        LET howl AS S32 = 0
        LET grit AS S32 = 0
        LET lim AS S32 = 0
        ASSERT(n >= 1)
        ASSERT(n <= 256)
        lim = n
        bn = lim
        eng = 0
        brown = 0
        i = 1
        WHILE i <= lim
            w = GdHash.ByteOf(i, seed, 3) - 128
            brown = (brown * 15 + w) / 16
            howl = GdPerlin.PerlAt(i / 4, seed AND 63, seed) - 128
            howl = (howl * intensity) / 256
            grit = GdPink.PinkAt(i, seed, 7) - 128
            grit = (grit * intensity) / 512
            blk[i] = brown + howl / 2 + grit / 4
            IF blk[i] < 0 THEN
                eng = eng - blk[i]
            ELSE
                eng = eng + blk[i]
            END IF
            i = i + 1
        END WHILE
    END PROCEDURE

    FUNCTION BlockAt(i AS S32) AS S32 REQUIRE i >= 1
        ASSERT(i >= 1)
        ASSERT(i <= 256)
        IF i > bn THEN
            RETURN 0
        END IF
        RETURN blk[i]
    END FUNCTION

    FUNCTION BlockN() AS S32
        ASSERT(bn >= 0)
        ASSERT(bn <= 256)
        RETURN bn
    END FUNCTION

    FUNCTION Energy() AS S32
        ASSERT(eng >= 0)
        RETURN eng
    END FUNCTION

    FUNCTION SelfTest() AS S32
        LET a AS S32 = 0
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        Pulse()
        Generate(128, 200, 9)
        a = Energy()
        IF a > 0 THEN
            IF Strength() >= 6 THEN
                IF BlockN() = 128 THEN
                    RETURN 1
                END IF
            END IF
        END IF
        RETURN 0
    END FUNCTION

END MODULE
