-- Twin of Ada core_console_persist. Eight slots of last cmd id, no file Load.
VERSION 1.0

DECLARE MODULE GdConPersist
    PROCEDURE Setup()
    PROCEDURE Store(slot AS S32)
    FUNCTION Stored() AS S32
    PROCEDURE SaveCmd(slot AS S32, cmd AS S32)
    FUNCTION CmdOf(slot AS S32) AS S32
END DECLARE MODULE

MODULE GdConPersist

    STRICT slotv[8] AS S32
    LET saved AS S32 = 1

    PROCEDURE Setup()
        LET i AS S32 = 1
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        WHILE i <= 8
            slotv[i] = 0
            i = i + 1
        END WHILE
        saved = 1
        GdConMore.NoteSlot(1)
    END PROCEDURE

    PROCEDURE Store(slot AS S32)
        ASSERT(slot >= 1)
        ASSERT(slot <= 8)
        saved = slot
        GdConMore.NoteSlot(slot)
    END PROCEDURE

    FUNCTION Stored() AS S32
        ASSERT(saved >= 1)
        ASSERT(saved <= 8)
        RETURN saved
    END FUNCTION

    PROCEDURE SaveCmd(slot AS S32, cmd AS S32)
        ASSERT(slot >= 1)
        ASSERT(slot <= 8)
        ASSERT(cmd >= 0)
        ASSERT(cmd <= 63)
        slotv[slot] = cmd
        saved = slot
        GdConMore.NoteSlot(slot)
    END PROCEDURE

    FUNCTION CmdOf(slot AS S32) AS S32
        ASSERT(slot >= 1)
        ASSERT(slot <= 8)
        RETURN slotv[slot]
    END FUNCTION

END MODULE
