-- Twin of Ada core_console_config. Caps only.
VERSION 1.0

DECLARE MODULE GdConCfg
    FUNCTION MaxLines() AS S32
    FUNCTION MaxHist() AS S32
    FUNCTION MaxCmds() AS S32
END DECLARE MODULE

MODULE GdConCfg

    FUNCTION MaxLines() AS S32
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        RETURN 256
    END FUNCTION
    FUNCTION MaxHist() AS S32
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        RETURN 64
    END FUNCTION
    FUNCTION MaxCmds() AS S32
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        RETURN 64
    END FUNCTION

END MODULE
