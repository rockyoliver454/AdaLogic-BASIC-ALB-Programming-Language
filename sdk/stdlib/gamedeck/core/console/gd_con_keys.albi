-- Twin of Ada core_console_keys. Grave toggles, not Raylib keys.
VERSION 1.0

DECLARE MODULE GdConKeys
    FUNCTION ToggleCode() AS S32
    FUNCTION CloseCode() AS S32
END DECLARE MODULE

MODULE GdConKeys

    FUNCTION ToggleCode() AS S32
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        RETURN 53
    END FUNCTION
    FUNCTION CloseCode() AS S32
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        RETURN 41
    END FUNCTION

END MODULE
