-- Twin of Ada core_console_security. Arm flag, not a secret token dump.
VERSION 1.0

DECLARE MODULE GdConSec
    PROCEDURE Arm()
    PROCEDURE Disarm()
    FUNCTION Armed() AS S32
END DECLARE MODULE

MODULE GdConSec

    LET flag AS S32 = 0

    PROCEDURE Arm()
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        flag = 1
    END PROCEDURE
    PROCEDURE Disarm()
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        flag = 0
    END PROCEDURE
    FUNCTION Armed() AS S32
        ASSERT(flag >= 0)
        ASSERT(flag <= 1)
        RETURN flag
    END FUNCTION

END MODULE
