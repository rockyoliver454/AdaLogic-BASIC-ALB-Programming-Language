-- Twin of Ada core_noise_jordan. Product of two ridged-like hash fields.
VERSION 1.0

DECLARE MODULE GdJordan
    FUNCTION JordanAt(x AS S32, y AS S32, seed AS S32) AS S32
    FUNCTION SelfTest() AS S32
END DECLARE MODULE

MODULE GdJordan

    FUNCTION RidgeLike(x AS S32, y AS S32, seed AS S32) AS S32
        LET n AS S32 = 0
        LET d AS S32 = 0
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        n = (GdHash.ByteOf(x, y, seed) * 8 + GdHash.ByteOf(x / 2, y / 2, seed + 1) * 4 + GdHash.ByteOf(x / 4, y / 4, seed + 2) * 2 + GdHash.ByteOf(x / 8, y / 8, seed + 3)) / 15
        d = n - 128
        IF d < 0 THEN
            d = 0 - d
        END IF
        n = 255 - d * 2
        RETURN GdVec2.ClipI(n, 0, 255)
    END FUNCTION

    FUNCTION JordanAt(x AS S32, y AS S32, seed AS S32) AS S32
        LET a AS S32 = 0
        LET b AS S32 = 0
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        a = RidgeLike(x, y, seed)
        b = RidgeLike(x / 2 + 3, y / 2 + 5, seed + 11)
        RETURN GdVec2.ClipI((a * b) / 255, 0, 255)
    END FUNCTION

    FUNCTION SelfTest() AS S32
        LET a AS S32 = 0
        LET b AS S32 = 0
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        a = JordanAt(0, 0, 3)
        b = JordanAt(40, 24, 3)
        IF a = b THEN
            RETURN 0
        END IF
        IF a < 0 THEN
            RETURN 0
        END IF
        IF a > 255 THEN
            RETURN 0
        END IF
        IF b < 0 THEN
            RETURN 0
        END IF
        IF b > 255 THEN
            RETURN 0
        END IF
        RETURN 1
    END FUNCTION

END MODULE
