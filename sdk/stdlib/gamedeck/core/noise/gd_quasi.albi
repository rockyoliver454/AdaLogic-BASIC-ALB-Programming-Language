-- Twin of Ada core_noise_quasicrystal. Four phase waves; table-free sin approx (no Cordic).
VERSION 1.0

DECLARE MODULE GdQuasi
    FUNCTION QuasiAt(x AS S32, y AS S32, t AS S32) AS S32
    FUNCTION SelfTest() AS S32
END DECLARE MODULE

MODULE GdQuasi

    FUNCTION Wave8(ph AS S32) AS S32
        LET p AS S32 = 0
        LET u AS S32 = 0
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        p = ph AND 255
        IF p > 128 THEN
            p = 256 - p
        END IF
        -- Parabola hump on 0..128: peak ~128 at p=64
        u = (p * (128 - p)) / 32
        RETURN GdVec2.ClipI(u, 0, 255)
    END FUNCTION

    FUNCTION QuasiAt(x AS S32, y AS S32, t AS S32) AS S32
        LET s AS S32 = 0
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        s = Wave8(x + t)
        s = s + Wave8((x * 2 + y) / 2 + t * 2)
        s = s + Wave8(y - t + 64)
        s = s + Wave8(x + y + t * 3 + 32)
        RETURN GdVec2.ClipI(s / 4, 0, 255)
    END FUNCTION

    FUNCTION SelfTest() AS S32
        LET a AS S32 = 0
        LET b AS S32 = 0
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        a = QuasiAt(0, 0, 3)
        b = QuasiAt(40, 24, 3)
        IF a = b THEN
            RETURN 0
        END IF
        IF a < 0 THEN
            RETURN 0
        END IF
        IF a > 255 THEN
            RETURN 0
        END IF
        IF b < 0 THEN
            RETURN 0
        END IF
        IF b > 255 THEN
            RETURN 0
        END IF
        RETURN 1
    END FUNCTION

END MODULE
