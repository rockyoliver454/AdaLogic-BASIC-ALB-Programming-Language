-- Twin of Ada core_noise_brown. Leaky integrator of white; x is time.
VERSION 1.0

DECLARE MODULE GdBrown
    FUNCTION BrownAt(x AS S32, y AS S32, seed AS S32) AS S32
    FUNCTION SelfTest() AS S32
END DECLARE MODULE

MODULE GdBrown

    LET acc AS S32 = 0
    LET acc_key AS S32 = 0

    FUNCTION BrownAt(x AS S32, y AS S32, seed AS S32) AS S32
        LET w AS S32 = 0
        LET akey AS S32 = 0
        LET outv AS S32 = 0
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        akey = seed XOR (y * 131)
        IF akey <> acc_key THEN
            acc = 0
            acc_key = akey
        END IF
        -- Hash of x as time sample
        w = GdHash.ByteOf(x, 0, seed)
        acc = (acc * 15 + (w - 128)) / 16
        outv = acc + 128
        RETURN GdVec2.ClipI(outv, 0, 255)
    END FUNCTION

    FUNCTION SelfTest() AS S32
        LET a AS S32 = 0
        LET b AS S32 = 0
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        a = BrownAt(0, 0, 3)
        b = BrownAt(40, 0, 3)
        IF a = b THEN
            RETURN 0
        END IF
        IF a < 0 THEN
            RETURN 0
        END IF
        IF a > 255 THEN
            RETURN 0
        END IF
        IF b < 0 THEN
            RETURN 0
        END IF
        IF b > 255 THEN
            RETURN 0
        END IF
        RETURN 1
    END FUNCTION

END MODULE
