-- Twin of Ada core_noise_curl. Finite difference of hash field, mapped 0..255.
VERSION 1.0

DECLARE MODULE GdCurl
    FUNCTION CurlX(x AS S32, y AS S32, seed AS S32) AS S32
    FUNCTION CurlY(x AS S32, y AS S32, seed AS S32) AS S32
    FUNCTION SelfTest() AS S32
END DECLARE MODULE

MODULE GdCurl

    FUNCTION CurlX(x AS S32, y AS S32, seed AS S32) AS S32
        LET d AS S32 = 0
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        d = GdHash.ByteOf(x, y + 1, seed) - GdHash.ByteOf(x, y - 1, seed)
        RETURN GdVec2.ClipI(d / 2 + 128, 0, 255)
    END FUNCTION

    FUNCTION CurlY(x AS S32, y AS S32, seed AS S32) AS S32
        LET d AS S32 = 0
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        d = GdHash.ByteOf(x - 1, y, seed) - GdHash.ByteOf(x + 1, y, seed)
        RETURN GdVec2.ClipI(d / 2 + 128, 0, 255)
    END FUNCTION

    FUNCTION SelfTest() AS S32
        LET a AS S32 = 0
        LET b AS S32 = 0
        LET c AS S32 = 0
        LET d AS S32 = 0
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        a = CurlX(0, 0, 3)
        b = CurlX(40, 24, 3)
        c = CurlY(0, 0, 3)
        d = CurlY(40, 24, 3)
        IF a = b THEN
            IF c = d THEN
                RETURN 0
            END IF
        END IF
        IF a < 0 THEN
            RETURN 0
        END IF
        IF a > 255 THEN
            RETURN 0
        END IF
        IF b < 0 THEN
            RETURN 0
        END IF
        IF b > 255 THEN
            RETURN 0
        END IF
        IF c < 0 THEN
            RETURN 0
        END IF
        IF c > 255 THEN
            RETURN 0
        END IF
        IF d < 0 THEN
            RETURN 0
        END IF
        IF d > 255 THEN
            RETURN 0
        END IF
        RETURN 1
    END FUNCTION

END MODULE
