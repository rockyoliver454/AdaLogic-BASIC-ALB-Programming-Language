-- White noise 0..255.
VERSION 1.0

DECLARE MODULE GdWhite
    FUNCTION WhiteAt(x AS S32, y AS S32, seed AS S32) AS S32
END DECLARE MODULE

MODULE GdWhite

    FUNCTION WhiteAt(x AS S32, y AS S32, seed AS S32) AS S32
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        RETURN GdHash.ByteOf(x, y, seed)
    END FUNCTION

END MODULE
