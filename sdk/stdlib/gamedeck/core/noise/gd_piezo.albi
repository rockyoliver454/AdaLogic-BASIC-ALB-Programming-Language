-- Twin of Ada core_noise_piezoelectric. Abs of differentiated hash field.
VERSION 1.0

DECLARE MODULE GdPiezo
    FUNCTION StrainAt(x AS S32, y AS S32, seed AS S32) AS S32
    FUNCTION SelfTest() AS S32
END DECLARE MODULE

MODULE GdPiezo

    FUNCTION StrainAt(x AS S32, y AS S32, seed AS S32) AS S32
        LET dx AS S32 = 0
        LET dy AS S32 = 0
        LET s AS S32 = 0
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        dx = GdHash.ByteOf(x + 1, y, seed) - GdHash.ByteOf(x - 1, y, seed)
        IF dx < 0 THEN
            dx = 0 - dx
        END IF
        dy = GdHash.ByteOf(x, y + 1, seed) - GdHash.ByteOf(x, y - 1, seed)
        IF dy < 0 THEN
            dy = 0 - dy
        END IF
        s = (dx + dy) / 2
        RETURN GdVec2.ClipI(s, 0, 255)
    END FUNCTION

    FUNCTION SelfTest() AS S32
        LET a AS S32 = 0
        LET b AS S32 = 0
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        a = StrainAt(0, 0, 3)
        b = StrainAt(40, 24, 3)
        IF a = b THEN
            RETURN 0
        END IF
        IF a < 0 THEN
            RETURN 0
        END IF
        IF a > 255 THEN
            RETURN 0
        END IF
        IF b < 0 THEN
            RETURN 0
        END IF
        IF b > 255 THEN
            RETURN 0
        END IF
        RETURN 1
    END FUNCTION

END MODULE
