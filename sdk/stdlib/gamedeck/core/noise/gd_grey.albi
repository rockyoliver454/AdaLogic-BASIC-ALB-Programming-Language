-- Twin of Ada core_noise_grey. Tilted white: extra bass (coarse octaves).
VERSION 1.0

DECLARE MODULE GdGrey
    FUNCTION GreyAt(x AS S32, y AS S32, seed AS S32) AS S32
    FUNCTION SelfTest() AS S32
END DECLARE MODULE

MODULE GdGrey

    FUNCTION GreyAt(x AS S32, y AS S32, seed AS S32) AS S32
        LET o0 AS S32 = 0
        LET o1 AS S32 = 0
        LET o2 AS S32 = 0
        LET o3 AS S32 = 0
        LET s AS S32 = 0
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        -- Heavier low-frequency tilt than pink (16+8+4+1 = 29)
        o0 = GdHash.ByteOf(x / 16, y / 16, seed)
        o1 = GdHash.ByteOf(x / 8, y / 8, seed + 1)
        o2 = GdHash.ByteOf(x / 4, y / 4, seed + 2)
        o3 = GdHash.ByteOf(x, y, seed + 3)
        s = (o0 * 16 + o1 * 8 + o2 * 4 + o3) / 29
        RETURN GdVec2.ClipI(s, 0, 255)
    END FUNCTION

    FUNCTION SelfTest() AS S32
        LET a AS S32 = 0
        LET b AS S32 = 0
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        a = GreyAt(0, 0, 3)
        b = GreyAt(40, 24, 3)
        IF a = b THEN
            RETURN 0
        END IF
        IF a < 0 THEN
            RETURN 0
        END IF
        IF a > 255 THEN
            RETURN 0
        END IF
        IF b < 0 THEN
            RETURN 0
        END IF
        IF b > 255 THEN
            RETURN 0
        END IF
        RETURN 1
    END FUNCTION

END MODULE
