-- Soft Int4 lanes. Twin of Ada core_simd / C AzSimd. Keep sat8 helpers.
VERSION 1.0

DECLARE MODULE GdSimd
    FUNCTION AddSat(a AS S32, b AS S32) AS S32
    FUNCTION MulSat(a AS S32, b AS S32) AS S32
    PROCEDURE Fill4(v AS S32)
    PROCEDURE Make(a AS S32, b AS S32, c AS S32, d AS S32)
    PROCEDURE AddL(a AS S32, b AS S32, c AS S32, d AS S32)
    PROCEDURE SubL(a AS S32, b AS S32, c AS S32, d AS S32)
    PROCEDURE MulL(a AS S32, b AS S32, c AS S32, d AS S32)
    PROCEDURE MulS(s AS S32)
    PROCEDURE Madd4(a AS S32, b AS S32, c AS S32, d AS S32, e AS S32, f AS S32, g AS S32, h AS S32)
    FUNCTION Lane(i AS S32) AS S32
    FUNCTION DotOf(a AS S32, b AS S32, c AS S32, d AS S32) AS S32
    FUNCTION PackPri(pos_y AS S32, pos_z AS S32) AS S32
    FUNCTION SelfTest() AS S32
END DECLARE MODULE

MODULE GdSimd

    STRICT acc[4] AS S32

    FUNCTION AddSat(a AS S32, b AS S32) AS S32
        LET s AS S32 = a + b
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        IF s > 255 THEN
            RETURN 255
        END IF
        IF s < 0 THEN
            RETURN 0
        END IF
        RETURN s
    END FUNCTION

    FUNCTION MulSat(a AS S32, b AS S32) AS S32
        LET s AS S32 = (a * b) / 255
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        IF s > 255 THEN
            RETURN 255
        END IF
        IF s < 0 THEN
            RETURN 0
        END IF
        RETURN s
    END FUNCTION

    PROCEDURE Fill4(v AS S32)
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        acc[1] = v
        acc[2] = v
        acc[3] = v
        acc[4] = v
    END PROCEDURE

    PROCEDURE Make(a AS S32, b AS S32, c AS S32, d AS S32)
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        acc[1] = a
        acc[2] = b
        acc[3] = c
        acc[4] = d
    END PROCEDURE

    PROCEDURE AddL(a AS S32, b AS S32, c AS S32, d AS S32)
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        acc[1] = acc[1] + a
        acc[2] = acc[2] + b
        acc[3] = acc[3] + c
        acc[4] = acc[4] + d
    END PROCEDURE

    PROCEDURE SubL(a AS S32, b AS S32, c AS S32, d AS S32)
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        acc[1] = acc[1] - a
        acc[2] = acc[2] - b
        acc[3] = acc[3] - c
        acc[4] = acc[4] - d
    END PROCEDURE

    PROCEDURE MulL(a AS S32, b AS S32, c AS S32, d AS S32)
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        acc[1] = GdFixed.Mul16(acc[1], a)
        acc[2] = GdFixed.Mul16(acc[2], b)
        acc[3] = GdFixed.Mul16(acc[3], c)
        acc[4] = GdFixed.Mul16(acc[4], d)
    END PROCEDURE

    PROCEDURE MulS(s AS S32)
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        acc[1] = GdFixed.Mul16(acc[1], s)
        acc[2] = GdFixed.Mul16(acc[2], s)
        acc[3] = GdFixed.Mul16(acc[3], s)
        acc[4] = GdFixed.Mul16(acc[4], s)
    END PROCEDURE

    PROCEDURE Madd4(a AS S32, b AS S32, c AS S32, d AS S32, e AS S32, f AS S32, g AS S32, h AS S32)
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        acc[1] = acc[1] + GdFixed.Mul16(a, e)
        acc[2] = acc[2] + GdFixed.Mul16(b, f)
        acc[3] = acc[3] + GdFixed.Mul16(c, g)
        acc[4] = acc[4] + GdFixed.Mul16(d, h)
    END PROCEDURE

    FUNCTION Lane(i AS S32) AS S32 REQUIRE i >= 1
        ASSERT(i >= 1)
        ASSERT(i <= 4)
        RETURN acc[i]
    END FUNCTION

    FUNCTION DotOf(a AS S32, b AS S32, c AS S32, d AS S32) AS S32
        LET s AS S32 = 0
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        s = GdFixed.Mul16(acc[1], a) + GdFixed.Mul16(acc[2], b)
        s = s + GdFixed.Mul16(acc[3], c) + GdFixed.Mul16(acc[4], d)
        RETURN s
    END FUNCTION

    FUNCTION PackPri(pos_y AS S32, pos_z AS S32) AS S32
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        RETURN pos_z * 100000 + pos_y
    END FUNCTION

    FUNCTION SelfTest() AS S32
        LET n AS S32 = 0
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        Make(1, 2, 3, 4)
        AddL(1, 1, 1, 1)
        IF Lane(1) = 2 THEN
            n = n + 1
        END IF
        IF PackPri(5, 2) = 200005 THEN
            n = n + 1
        END IF
        IF AddSat(200, 80) = 255 THEN
            n = n + 1
        END IF
        Fill4(GdFixed.One16())
        IF DotOf(65536, 0, 0, 0) = 65536 THEN
            n = n + 1
        END IF
        IF n = 4 THEN
            RETURN 1
        END IF
        RETURN 0
    END FUNCTION

END MODULE
