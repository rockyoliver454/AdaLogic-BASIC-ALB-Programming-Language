-- Twin of C sf_phonetics. Formant mix of two bands.
VERSION 1.0

DECLARE MODULE GdSfxPhone
    FUNCTION Vowel(x AS S32, y AS S32) AS S32
END DECLARE MODULE

MODULE GdSfxPhone

    FUNCTION Vowel(x AS S32, y AS S32) AS S32
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        RETURN (x * 2 + y) / 3
    END FUNCTION

END MODULE
