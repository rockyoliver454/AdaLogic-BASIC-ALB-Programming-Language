-- Twin of Ada core_sfx_sawtooth.
VERSION 1.0

DECLARE MODULE GdSfxSaw
    FUNCTION SampleAt(phase AS S32) AS S32
END DECLARE MODULE

MODULE GdSfxSaw

    FUNCTION SampleAt(phase AS S32) AS S32
        LET a AS S32 = phase MOD 256
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        IF a < 0 THEN
            a = a + 256
        END IF
        RETURN a - 128
    END FUNCTION

END MODULE
