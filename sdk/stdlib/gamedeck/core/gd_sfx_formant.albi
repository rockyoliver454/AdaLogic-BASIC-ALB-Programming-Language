-- Twin of Ada core_sfx_formant. Two-band mix.
VERSION 1.0

DECLARE MODULE GdSfxForm
    FUNCTION Band(s AS S32, f1 AS S32, f2 AS S32) AS S32
END DECLARE MODULE

MODULE GdSfxForm

    FUNCTION Band(s AS S32, f1 AS S32, f2 AS S32) AS S32
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        RETURN (s * f1 + (0 - s) * f2) / 16
    END FUNCTION

END MODULE
