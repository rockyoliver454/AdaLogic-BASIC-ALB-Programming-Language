-- Twin of C sf_modal. Integer resonator tap.
VERSION 1.0

DECLARE MODULE GdSfxModal
    FUNCTION Tap(x AS S32, prev AS S32) AS S32
END DECLARE MODULE

MODULE GdSfxModal

    FUNCTION Tap(x AS S32, prev AS S32) AS S32
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        RETURN (x + prev + prev) / 3
    END FUNCTION

END MODULE
