-- Twin of Ada code_information. Build stamp integers.
VERSION 1.0

DECLARE MODULE GdCodeInfo
    FUNCTION Epoch() AS S32
    FUNCTION Major() AS S32
END DECLARE MODULE

MODULE GdCodeInfo

    FUNCTION Epoch() AS S32
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        RETURN 8
    END FUNCTION

    FUNCTION Major() AS S32
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        RETURN 0
    END FUNCTION

END MODULE
