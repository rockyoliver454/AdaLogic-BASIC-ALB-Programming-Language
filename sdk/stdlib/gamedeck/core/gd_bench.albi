-- Twin of C proc_objects/proc_workbench.c.
VERSION 1.0

DECLARE MODULE GdBench
    PROCEDURE PresentBlock(x AS S32, y AS S32)
END DECLARE MODULE

MODULE GdBench

    PROCEDURE PresentBlock(x AS S32, y AS S32)
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        COLOR $57534E
        FILL RECT x, y, 40, 16
        COLOR $A8A29E
        FILL RECT x + 4, y + 2, 32, 6
    END PROCEDURE

END MODULE
