-- AABB occupancy table. Cap 64.
VERSION 1.0

DECLARE MODULE GdSpatial
    PROCEDURE Wipe()
    PROCEDURE InsertEnt(id AS S32, x AS S32, y AS S32)
    FUNCTION CountEnt() AS S32
    FUNCTION HitsId(x AS S32, y AS S32, w AS S32, h AS S32, ignore AS S32) AS S32
    FUNCTION HitsR(x AS S32, y AS S32, r AS S32, ignore AS S32) AS S32
    FUNCTION SelfTest() AS S32
END DECLARE MODULE

MODULE GdSpatial

    STRICT sid[64] AS S32
    STRICT sx[64] AS S32
    STRICT sy[64] AS S32
    STRICT used[64] AS U64
    LET n AS S32 = 0

    PROCEDURE Wipe()
        LET i AS S32 = 1
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        WHILE i <= 64
            used[i] = 0
            i = i + 1
        END WHILE
        n = 0
    END PROCEDURE

    PROCEDURE InsertEnt(id AS S32, x AS S32, y AS S32) REQUIRE id > 0
        LET i AS S32 = 1
        LET done AS U64 = 0
        ASSERT(id > 0)
        ASSERT(n <= 64)
        WHILE i <= 64
            IF used[i] = 0 THEN
                IF done = 0 THEN
                    sid[i] = id
                    sx[i] = x
                    sy[i] = y
                    used[i] = 1
                    n = n + 1
                    done = 1
                END IF
            END IF
            i = i + 1
        END WHILE
    END PROCEDURE

    FUNCTION CountEnt() AS S32
        ASSERT(n >= 0)
        ASSERT(n <= 64)
        RETURN n
    END FUNCTION

    FUNCTION HitsId(x AS S32, y AS S32, w AS S32, h AS S32, ignore AS S32) AS S32
        LET i AS S32 = 1
        LET found AS S32 = 0
        ASSERT(w > 0)
        ASSERT(h > 0)
        WHILE i <= 64
            IF used[i] = 1 THEN
                IF sid[i] <> ignore THEN
                    IF COLLIDE_RECT(x, y, w, h, sx[i], sy[i], 16, 16) THEN
                        IF found = 0 THEN
                            found = sid[i]
                        END IF
                    END IF
                END IF
            END IF
            i = i + 1
        END WHILE
        RETURN found
    END FUNCTION

    FUNCTION HitsR(x AS S32, y AS S32, r AS S32, ignore AS S32) AS S32
        LET i AS S32 = 1
        LET found AS S32 = 0
        LET dx AS S32 = 0
        LET dy AS S32 = 0
        ASSERT(r > 0)
        ASSERT(r <= 128)
        WHILE i <= 64
            IF used[i] = 1 THEN
                IF sid[i] <> ignore THEN
                    dx = sx[i] - x
                    dy = sy[i] - y
                    IF dx * dx + dy * dy <= r * r THEN
                        IF found = 0 THEN
                            found = sid[i]
                        END IF
                    END IF
                END IF
            END IF
            i = i + 1
        END WHILE
        RETURN found
    END FUNCTION

    FUNCTION SelfTest() AS S32
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        Wipe()
        InsertEnt(3, 10, 10)
        IF HitsR(10, 10, 4, 0) = 3 THEN
            IF HitsR(80, 80, 4, 0) = 0 THEN
                RETURN 1
            END IF
        END IF
        RETURN 0
    END FUNCTION

END MODULE
