-- Twin of Ada core_sfx_dsp. Cheap clip / gain.
VERSION 1.0

DECLARE MODULE GdSfxDsp
    FUNCTION Gain(s AS S32, g AS S32) AS S32
    FUNCTION ClipS(s AS S32) AS S32
    FUNCTION Lpf(prev AS S32, s AS S32, k AS S32) AS S32
END DECLARE MODULE

MODULE GdSfxDsp

    FUNCTION Gain(s AS S32, g AS S32) AS S32
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        RETURN (s * g) / 16
    END FUNCTION

    FUNCTION ClipS(s AS S32) AS S32
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        RETURN GdVec2.ClipI(s, 0 - 120, 120)
    END FUNCTION

    FUNCTION Lpf(prev AS S32, s AS S32, k AS S32) AS S32
        ASSERT(k >= 1)
        ASSERT(k <= 16)
        RETURN prev + ((s - prev) * k) / 16
    END FUNCTION

END MODULE
