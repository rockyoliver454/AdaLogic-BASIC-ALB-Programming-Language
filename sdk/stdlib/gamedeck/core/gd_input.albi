DECLARE MODULE GdInput
    FUNCTION Down(code AS S32) AS U64
    FUNCTION MouseX() AS S32
    FUNCTION MouseY() AS S32
    FUNCTION ClickLeft() AS U64
END DECLARE MODULE

MODULE GdInput

    FUNCTION Down(code AS S32) AS U64
        ASSERT(code >= 0)
        ASSERT(code <= 255)
        IF KEY(code) > 0 THEN
            RETURN 1
        END IF
        RETURN 0
    END FUNCTION

    FUNCTION MouseX() AS S32
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        RETURN MOUSE_X
    END FUNCTION

    FUNCTION MouseY() AS S32
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        RETURN MOUSE_Y
    END FUNCTION

    FUNCTION ClickLeft() AS U64
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        IF MOUSE_CLICK(0) > 0 THEN
            RETURN 1
        END IF
        RETURN 0
    END FUNCTION

END MODULE
