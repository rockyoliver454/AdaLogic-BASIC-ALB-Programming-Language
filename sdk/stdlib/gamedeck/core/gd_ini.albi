-- Twin of Ada AyeNEye: 8 integer slots, not an INI Load.
VERSION 1.0

DECLARE MODULE GdIni
    PROCEDURE Setup()
    PROCEDURE NoteVal(slot AS S32, v AS S32)
    FUNCTION ValOf(slot AS S32) AS S32
    FUNCTION CountN() AS S32
END DECLARE MODULE

MODULE GdIni

    STRICT val[8] AS S32
    LET n AS S32 = 0

    PROCEDURE Setup()
        LET i AS S32 = 1
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        WHILE i <= 8
            val[i] = 0
            i = i + 1
        END WHILE
        n = 0
    END PROCEDURE

    PROCEDURE NoteVal(slot AS S32, v AS S32)
        ASSERT(slot >= 1)
        ASSERT(slot <= 8)
        val[slot] = v
        IF slot > n THEN
            n = slot
        END IF
    END PROCEDURE

    FUNCTION ValOf(slot AS S32) AS S32
        ASSERT(slot >= 1)
        ASSERT(slot <= 8)
        RETURN val[slot]
    END FUNCTION

    FUNCTION CountN() AS S32
        ASSERT(n >= 0)
        ASSERT(n <= 8)
        RETURN n
    END FUNCTION

END MODULE
