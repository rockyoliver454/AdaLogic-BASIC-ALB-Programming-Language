-- Twin of Ada GD_CORDIC. 8-bit brad angle, amplitude -127..127. LUT filled once.
VERSION 1.0

DECLARE MODULE GdCordic
    PROCEDURE Setup()
    FUNCTION Sin8(angle AS S32) AS S32
    FUNCTION Cos8(angle AS S32) AS S32
    FUNCTION Atan2_8(y AS S32, x AS S32) AS S32
END DECLARE MODULE

MODULE GdCordic

    STRICT s_tab[256] AS S32
    STRICT c_tab[256] AS S32
    LET ready AS U64 = 0

    PROCEDURE Setup()
        LET a AS S32 = 0
        LET x AS S32 = 0
        LET y AS S32 = 0
        LET i AS S32 = 0
        LET nx AS S32 = 0
        LET ny AS S32 = 0
        LET da AS S32 = 0
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        WHILE a < 256
            x = 127
            y = 0
            i = 0
            da = a * 256
            WHILE i < 8
                IF da >= 0 THEN
                    nx = x - (y / (1 + i * 2))
                    ny = y + (x / (1 + i * 2))
                    da = da - (32 / (1 + i))
                    x = nx
                    y = ny
                ELSE
                    nx = x + (y / (1 + i * 2))
                    ny = y - (x / (1 + i * 2))
                    da = da + (32 / (1 + i))
                    x = nx
                    y = ny
                END IF
                i = i + 1
            END WHILE
            c_tab[a + 1] = x
            s_tab[a + 1] = y
            a = a + 1
        END WHILE
        ready = 1
    END PROCEDURE

    FUNCTION Sin8(angle AS S32) AS S32
        LET a AS S32 = angle MOD 256
        ASSERT(ready = 1)
        ASSERT(1 = 1)
        IF a < 0 THEN
            a = a + 256
        END IF
        RETURN s_tab[a + 1]
    END FUNCTION

    FUNCTION Cos8(angle AS S32) AS S32
        LET a AS S32 = angle MOD 256
        ASSERT(ready = 1)
        ASSERT(1 = 1)
        IF a < 0 THEN
            a = a + 256
        END IF
        RETURN c_tab[a + 1]
    END FUNCTION

    FUNCTION Atan2_8(y AS S32, x AS S32) AS S32
        LET a AS S32 = 0
        LET best AS S32 = 0
        LET bestd AS S32 = 999999
        LET d AS S32 = 0
        LET dx AS S32 = 0
        LET dy AS S32 = 0
        ASSERT(ready = 1)
        ASSERT(1 = 1)
        WHILE a < 256
            dx = Cos8(a) - x
            dy = Sin8(a) - y
            d = dx * dx + dy * dy
            IF d < bestd THEN
                bestd = d
                best = a
            END IF
            a = a + 1
        END WHILE
        RETURN best
    END FUNCTION

END MODULE
