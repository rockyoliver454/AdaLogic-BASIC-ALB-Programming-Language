-- Twin of Ada geo_entropy. Popcount-as-entropy of a U64 mask.
VERSION 1.0

DECLARE MODULE GdEntropy
    FUNCTION BitsOf(v AS U64) AS S32
END DECLARE MODULE

MODULE GdEntropy

    FUNCTION BitsOf(v AS U64) AS S32
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        RETURN GdBitboard.PopCount(v)
    END FUNCTION

END MODULE
