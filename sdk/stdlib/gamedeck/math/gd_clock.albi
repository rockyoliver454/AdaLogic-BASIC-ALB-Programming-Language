-- Twin of Ada math clock. Tick counter, not wall-clock FFI.
VERSION 1.0

DECLARE MODULE GdClock
    PROCEDURE ClearTicks()
    PROCEDURE Pulse()
    FUNCTION Ticks() AS S32
    FUNCTION WrapSec() AS S32
END DECLARE MODULE

MODULE GdClock

    LET n AS S32 = 0

    PROCEDURE ClearTicks()
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        n = 0
    END PROCEDURE

    PROCEDURE Pulse()
        ASSERT(n >= 0)
        ASSERT(1 = 1)
        n = n + 1
        IF n > 1000000 THEN
            n = 0
        END IF
    END PROCEDURE

    FUNCTION Ticks() AS S32
        ASSERT(n >= 0)
        ASSERT(n <= 1000000)
        RETURN n
    END FUNCTION

    FUNCTION WrapSec() AS S32
        ASSERT(n >= 0)
        ASSERT(1 = 1)
        RETURN (n / 60) MOD 60
    END FUNCTION

END MODULE
