-- Twin of Ada geo_transform. Rotate via 8-bit CORDIC.
VERSION 1.0

DECLARE MODULE GdXform
    FUNCTION RotX(x AS S32, y AS S32, ang AS S32) AS S32
    FUNCTION RotY(x AS S32, y AS S32, ang AS S32) AS S32
    FUNCTION ScaleXY(v AS S32, s AS S32) AS S32
    FUNCTION SelfTest() AS S32
END DECLARE MODULE

MODULE GdXform

    FUNCTION RotX(x AS S32, y AS S32, ang AS S32) AS S32
        LET c AS S32 = GdCordic.Cos8(ang)
        LET s AS S32 = GdCordic.Sin8(ang)
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        RETURN (x * c - y * s) / 127
    END FUNCTION

    FUNCTION RotY(x AS S32, y AS S32, ang AS S32) AS S32
        LET c AS S32 = GdCordic.Cos8(ang)
        LET s AS S32 = GdCordic.Sin8(ang)
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        RETURN (x * s + y * c) / 127
    END FUNCTION

    FUNCTION ScaleXY(v AS S32, s AS S32) AS S32
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        RETURN (v * s) / 256
    END FUNCTION

    FUNCTION SelfTest() AS S32
        LET a AS S32 = 0
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        a = RotX(127, 0, 0)
        IF a >= 120 THEN
            IF ScaleXY(256, 128) = 128 THEN
                RETURN 1
            END IF
        END IF
        RETURN 0
    END FUNCTION

END MODULE
