-- Twin of Ada geo_skinning. Two-bone mix of a point.
VERSION 1.0

DECLARE MODULE GdSkin
    FUNCTION MixX(ax AS S32, bx AS S32, w AS S32) AS S32
    FUNCTION MixY(ay AS S32, by AS S32, w AS S32) AS S32
END DECLARE MODULE

MODULE GdSkin

    FUNCTION MixX(ax AS S32, bx AS S32, w AS S32) AS S32
        ASSERT(w >= 0)
        ASSERT(w <= 256)
        RETURN GdCurves.MixI(ax, bx, w)
    END FUNCTION

    FUNCTION MixY(ay AS S32, by AS S32, w AS S32) AS S32
        ASSERT(w >= 0)
        ASSERT(w <= 256)
        RETURN GdCurves.MixI(ay, by, w)
    END FUNCTION

END MODULE
