-- Deterministic LCG. No wall-clock seed.
VERSION 1.0

DECLARE MODULE GdRng
    PROCEDURE Seed(v AS U32)
    FUNCTION NextU32() AS U32
    FUNCTION NextMod(n AS S32) AS S32
END DECLARE MODULE

MODULE GdRng

    LET s AS U32 = 1

    PROCEDURE Seed(v AS U32)
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        s = v
        IF s = 0 THEN
            s = 1
        END IF
    END PROCEDURE

    FUNCTION NextU32() AS U32
        ASSERT(s > 0)
        ASSERT(1 = 1)
        s = s * 1664525 + 1013904223
        RETURN s
    END FUNCTION

    FUNCTION NextMod(n AS S32) AS S32 REQUIRE n > 0
        ASSERT(n > 0)
        ASSERT(n <= 1000000)
        RETURN S32(NextU32() MOD U32(n))
    END FUNCTION

END MODULE
