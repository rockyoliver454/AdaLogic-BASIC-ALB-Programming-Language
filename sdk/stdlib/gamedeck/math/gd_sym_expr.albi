-- Twin of Ada Sym_Expr. Integer node id, not a float AST.
VERSION 1.0

DECLARE MODULE GdSym
    FUNCTION AddNode(a AS S32, b AS S32) AS S32
    FUNCTION EvalAdd(a AS S32, b AS S32) AS S32
END DECLARE MODULE

MODULE GdSym

    FUNCTION AddNode(a AS S32, b AS S32) AS S32
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        RETURN a + b
    END FUNCTION

    FUNCTION EvalAdd(a AS S32, b AS S32) AS S32
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        RETURN a + b
    END FUNCTION

END MODULE
