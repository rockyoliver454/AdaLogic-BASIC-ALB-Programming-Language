-- Integer mix for map seeds. Spirit of C math_hash, not a source copy.
VERSION 1.0

DECLARE MODULE GdHash
    FUNCTION Mix32(n AS U32) AS U32
    FUNCTION Mix3(x AS S32, y AS S32, seed AS S32) AS U32
    FUNCTION ByteOf(x AS S32, y AS S32, seed AS S32) AS S32
END DECLARE MODULE

MODULE GdHash

    FUNCTION Mix32(n AS U32) AS U32
        LET z AS U32 = n
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        z = z * 1664525 + 1013904223
        z = z XOR (z / 65536)
        RETURN z
    END FUNCTION

    FUNCTION Mix3(x AS S32, y AS S32, seed AS S32) AS U32
        LET z AS U32 = 2166136261
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        z = Mix32(z XOR U32(x + 100000))
        z = Mix32(z XOR U32(y + 100000))
        z = Mix32(z XOR U32(seed + 100000))
        RETURN z
    END FUNCTION

    FUNCTION ByteOf(x AS S32, y AS S32, seed AS S32) AS S32
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        RETURN S32(Mix3(x, y, seed) MOD 256)
    END FUNCTION

END MODULE
