-- Twin of Ada geo_compaction. Pack a sparse 8-slot table.
VERSION 1.0

DECLARE MODULE GdCompact
    FUNCTION PackN(used AS S32) AS S32
END DECLARE MODULE

MODULE GdCompact

    FUNCTION PackN(used AS S32) AS S32
        ASSERT(used >= 0)
        ASSERT(used <= 8)
        RETURN used
    END FUNCTION

END MODULE
