-- Twin of Ada geo_splines. Quadratic bezier via MixI.
VERSION 1.0

DECLARE MODULE GdSplines
    FUNCTION Quad(a AS S32, b AS S32, c AS S32, t AS S32) AS S32
    FUNCTION SelfTest() AS S32
END DECLARE MODULE

MODULE GdSplines

    FUNCTION Quad(a AS S32, b AS S32, c AS S32, t AS S32) AS S32
        LET p AS S32 = 0
        LET q AS S32 = 0
        ASSERT(t >= 0)
        ASSERT(t <= 256)
        p = GdCurves.MixI(a, b, t)
        q = GdCurves.MixI(b, c, t)
        RETURN GdCurves.MixI(p, q, t)
    END FUNCTION

    FUNCTION SelfTest() AS S32
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        IF Quad(0, 128, 256, 0) = 0 THEN
            IF Quad(0, 128, 256, 256) = 256 THEN
                RETURN 1
            END IF
        END IF
        RETURN 0
    END FUNCTION

END MODULE
