-- Twin of Ada geo_noise. Value field via hash.
VERSION 1.0

DECLARE MODULE GdGeoNoise
    FUNCTION FieldAt(x AS S32, y AS S32, seed AS S32) AS S32
    FUNCTION OctaveAt(x AS S32, y AS S32, seed AS S32) AS S32
    FUNCTION SelfTest() AS S32
END DECLARE MODULE

MODULE GdGeoNoise

    FUNCTION FieldAt(x AS S32, y AS S32, seed AS S32) AS S32
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        RETURN GdNoise.ValueAt(x, y, seed)
    END FUNCTION

    FUNCTION OctaveAt(x AS S32, y AS S32, seed AS S32) AS S32
        LET a AS S32 = 0
        LET b AS S32 = 0
        LET c AS S32 = 0
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        a = GdNoise.ValueAt(x, y, seed)
        b = GdNoise.ValueAt(x * 2, y * 2, seed + 1) / 2
        c = GdNoise.ValueAt(x * 4, y * 4, seed + 2) / 4
        RETURN a / 2 + b / 2 + c
    END FUNCTION

    FUNCTION SelfTest() AS S32
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        IF FieldAt(0, 0, 1) >= 0 THEN
            IF OctaveAt(3, 5, 1) >= 0 THEN
                RETURN 1
            END IF
        END IF
        RETURN 0
    END FUNCTION

END MODULE
