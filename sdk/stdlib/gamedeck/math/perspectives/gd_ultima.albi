-- Twin of C perspective_ultima.
VERSION 1.0

DECLARE MODULE GdUltima
    FUNCTION ProjX(x AS S32, y AS S32) AS S32
    FUNCTION ProjY(x AS S32, y AS S32) AS S32
END DECLARE MODULE

MODULE GdUltima

    FUNCTION ProjX(x AS S32, y AS S32) AS S32
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        RETURN x
    END FUNCTION

    FUNCTION ProjY(x AS S32, y AS S32) AS S32
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        RETURN y / 2
    END FUNCTION

END MODULE
