-- Twin of C perspective_dimetric.
VERSION 1.0

DECLARE MODULE GdDimetric
    FUNCTION ProjX(x AS S32, y AS S32) AS S32
    FUNCTION ProjY(x AS S32, y AS S32) AS S32
END DECLARE MODULE

MODULE GdDimetric

    FUNCTION ProjX(x AS S32, y AS S32) AS S32
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        RETURN x - y / 2
    END FUNCTION

    FUNCTION ProjY(x AS S32, y AS S32) AS S32
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        RETURN (x + y) / 4
    END FUNCTION

END MODULE
