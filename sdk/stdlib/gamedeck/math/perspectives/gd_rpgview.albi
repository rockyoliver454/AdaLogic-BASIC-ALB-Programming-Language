-- Twin of C perspective_rpg.
VERSION 1.0

DECLARE MODULE GdRpgView
    FUNCTION ProjX(x AS S32, y AS S32) AS S32
    FUNCTION ProjY(x AS S32, y AS S32) AS S32
END DECLARE MODULE

MODULE GdRpgView

    FUNCTION ProjX(x AS S32, y AS S32) AS S32
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        RETURN x
    END FUNCTION

    FUNCTION ProjY(x AS S32, y AS S32) AS S32
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        RETURN y
    END FUNCTION

END MODULE
