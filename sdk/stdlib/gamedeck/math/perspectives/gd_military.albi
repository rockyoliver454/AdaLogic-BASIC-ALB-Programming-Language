-- Twin of Ada perspective_military. 45-degree ground.
VERSION 1.0

DECLARE MODULE GdMilitary
    FUNCTION ProjX(x AS S32, y AS S32) AS S32
    FUNCTION ProjY(x AS S32, y AS S32) AS S32
END DECLARE MODULE

MODULE GdMilitary

    FUNCTION ProjX(x AS S32, y AS S32) AS S32
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        RETURN x - y
    END FUNCTION

    FUNCTION ProjY(x AS S32, y AS S32) AS S32
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        RETURN y
    END FUNCTION

END MODULE
