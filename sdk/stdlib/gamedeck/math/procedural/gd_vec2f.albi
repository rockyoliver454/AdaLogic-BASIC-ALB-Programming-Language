-- Twin of Ada geo_vec2f. Q8 vectors. InnerQ8 not Dot (reserved).
VERSION 1.0

DECLARE MODULE GdVec2f
    FUNCTION AddQ8(ax AS S32, ay AS S32) AS S32
    FUNCTION InnerQ8(ax AS S32, ay AS S32, bx AS S32, by AS S32) AS S32
    FUNCTION LenSqQ8(ax AS S32, ay AS S32) AS S32
END DECLARE MODULE

MODULE GdVec2f

    FUNCTION AddQ8(ax AS S32, ay AS S32) AS S32
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        RETURN ax + ay
    END FUNCTION
    FUNCTION InnerQ8(ax AS S32, ay AS S32, bx AS S32, by AS S32) AS S32
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        RETURN (ax * bx + ay * by) / 256
    END FUNCTION
    FUNCTION LenSqQ8(ax AS S32, ay AS S32) AS S32
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        RETURN ax * ax + ay * ay
    END FUNCTION

END MODULE
