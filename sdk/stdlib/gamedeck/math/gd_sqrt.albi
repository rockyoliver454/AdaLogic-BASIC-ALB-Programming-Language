-- Twin of Ada Fixed_Sqrt. Integer isqrt, no floats.
VERSION 1.0

DECLARE MODULE GdISqrt
    FUNCTION ISqrt(n AS S32) AS S32
    FUNCTION DistI(x1 AS S32, y1 AS S32, x2 AS S32, y2 AS S32) AS S32
END DECLARE MODULE

MODULE GdISqrt

    FUNCTION ISqrt(n AS S32) AS S32
        LET lo AS S32 = 0
        LET hi AS S32 = n
        LET mid AS S32 = 0
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        IF n <= 0 THEN
            RETURN 0
        END IF
        IF n < 4 THEN
            RETURN 1
        END IF
        IF hi > 46340 THEN
            hi = 46340
        END IF
        WHILE lo <= hi
            mid = (lo + hi) / 2
            IF mid * mid <= n THEN
                lo = mid + 1
            ELSE
                hi = mid - 1
            END IF
        END WHILE
        RETURN hi
    END FUNCTION

    FUNCTION DistI(x1 AS S32, y1 AS S32, x2 AS S32, y2 AS S32) AS S32
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        RETURN ISqrt(GdVec2.Dist2(x1, y1, x2, y2))
    END FUNCTION

END MODULE
