-- Twin of Ada float_expr as Q8 eval slots.
VERSION 1.0

DECLARE MODULE GdQ8Expr
    FUNCTION EvalAdd(a AS S32, b AS S32) AS S32
    FUNCTION EvalMul(a AS S32, b AS S32) AS S32
    FUNCTION EvalSub(a AS S32, b AS S32) AS S32
    FUNCTION EvalDiv(a AS S32, b AS S32) AS S32
    FUNCTION SelfTest() AS S32
END DECLARE MODULE

MODULE GdQ8Expr

    FUNCTION EvalAdd(a AS S32, b AS S32) AS S32
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        RETURN a + b
    END FUNCTION
    FUNCTION EvalMul(a AS S32, b AS S32) AS S32
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        RETURN (a * b) / 256
    END FUNCTION

    FUNCTION EvalSub(a AS S32, b AS S32) AS S32
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        RETURN a - b
    END FUNCTION

    FUNCTION EvalDiv(a AS S32, b AS S32) AS S32 REQUIRE b <> 0
        ASSERT(b <> 0)
        ASSERT(1 = 1)
        RETURN (a * 256) / b
    END FUNCTION

    FUNCTION SelfTest() AS S32
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        IF EvalAdd(10, 20) = 30 THEN
            IF EvalMul(256, 128) = 128 THEN
                RETURN 1
            END IF
        END IF
        RETURN 0
    END FUNCTION

END MODULE
