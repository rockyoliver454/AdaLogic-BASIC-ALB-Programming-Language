-- Twin of Ada geo_fields. Scalar field sample from hash.
VERSION 1.0

DECLARE MODULE GdFields
    FUNCTION SampleAt(x AS S32, y AS S32, seed AS S32) AS S32
    FUNCTION GradX(x AS S32, y AS S32, seed AS S32) AS S32
END DECLARE MODULE

MODULE GdFields

    FUNCTION SampleAt(x AS S32, y AS S32, seed AS S32) AS S32
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        RETURN GdHash.ByteOf(x, y, seed)
    END FUNCTION

    FUNCTION GradX(x AS S32, y AS S32, seed AS S32) AS S32
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        RETURN GdHash.ByteOf(x + 1, y, seed) - GdHash.ByteOf(x, y, seed)
    END FUNCTION

END MODULE
