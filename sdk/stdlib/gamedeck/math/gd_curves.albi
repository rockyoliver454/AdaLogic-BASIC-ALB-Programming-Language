-- Twin of Ada geo_curves: integer lerp.
VERSION 1.0

DECLARE MODULE GdCurves
    FUNCTION MixI(a AS S32, b AS S32, t AS S32) AS S32
    FUNCTION Cubic(a AS S32, b AS S32, c AS S32, d AS S32, t AS S32) AS S32
END DECLARE MODULE

MODULE GdCurves

    FUNCTION MixI(a AS S32, b AS S32, t AS S32) AS S32 REQUIRE t >= 0
        ASSERT(t >= 0)
        ASSERT(t <= 256)
        RETURN a + ((b - a) * t) / 256
    END FUNCTION

    FUNCTION Cubic(a AS S32, b AS S32, c AS S32, d AS S32, t AS S32) AS S32
        LET p AS S32 = 0
        LET q AS S32 = 0
        ASSERT(t >= 0)
        ASSERT(t <= 256)
        p = MixI(a, b, t)
        q = MixI(c, d, t)
        RETURN MixI(p, q, t)
    END FUNCTION

END MODULE
