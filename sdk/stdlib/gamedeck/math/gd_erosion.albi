-- Twin of Ada geo_erosion. Lower a height by a drip.
VERSION 1.0

DECLARE MODULE GdErosion
    FUNCTION Drip(h AS S32, rain AS S32) AS S32
END DECLARE MODULE

MODULE GdErosion

    FUNCTION Drip(h AS S32, rain AS S32) AS S32
        LET v AS S32 = h - (rain / 8)
        ASSERT(rain >= 0)
        ASSERT(1 = 1)
        IF v < 0 THEN
            RETURN 0
        END IF
        RETURN v
    END FUNCTION

END MODULE
