-- Twin of Ada Geo_Morton. 8-bit axes, 16-bit code.
VERSION 1.0

DECLARE MODULE GdMorton
    FUNCTION Encode2(x AS S32, y AS S32) AS S32
    FUNCTION DecodeX(code AS S32) AS S32
    FUNCTION DecodeY(code AS S32) AS S32
END DECLARE MODULE

MODULE GdMorton

    FUNCTION Encode2(x AS S32, y AS S32) AS S32
        LET i AS S32 = 0
        LET xx AS S32 = x AND 255
        LET yy AS S32 = y AND 255
        LET code AS S32 = 0
        LET bit AS S32 = 1
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        WHILE i < 8
            IF (xx AND 1) = 1 THEN
                code = code + bit
            END IF
            bit = bit * 2
            IF (yy AND 1) = 1 THEN
                code = code + bit
            END IF
            bit = bit * 2
            xx = xx / 2
            yy = yy / 2
            i = i + 1
        END WHILE
        RETURN code
    END FUNCTION

    FUNCTION DecodeX(code AS S32) AS S32
        LET i AS S32 = 0
        LET c AS S32 = code
        LET x AS S32 = 0
        LET p AS S32 = 1
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        WHILE i < 8
            IF (c AND 1) = 1 THEN
                x = x + p
            END IF
            c = c / 4
            p = p * 2
            i = i + 1
        END WHILE
        RETURN x
    END FUNCTION

    FUNCTION DecodeY(code AS S32) AS S32
        LET i AS S32 = 0
        LET c AS S32 = code / 2
        LET y AS S32 = 0
        LET p AS S32 = 1
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        WHILE i < 8
            IF (c AND 1) = 1 THEN
                y = y + p
            END IF
            c = c / 4
            p = p * 2
            i = i + 1
        END WHILE
        RETURN y
    END FUNCTION

END MODULE
