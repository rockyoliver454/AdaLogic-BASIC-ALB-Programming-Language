-- Twin of Ada geo_fracture2d. Split a span into two shards.
VERSION 1.0

DECLARE MODULE GdFracture
    FUNCTION SplitA(lo AS S32, hi AS S32) AS S32
    FUNCTION SplitB(lo AS S32, hi AS S32) AS S32
END DECLARE MODULE

MODULE GdFracture

    FUNCTION SplitA(lo AS S32, hi AS S32) AS S32 REQUIRE hi >= lo
        ASSERT(hi >= lo)
        ASSERT(1 = 1)
        RETURN lo
    END FUNCTION

    FUNCTION SplitB(lo AS S32, hi AS S32) AS S32 REQUIRE hi >= lo
        ASSERT(hi >= lo)
        ASSERT(1 = 1)
        RETURN (lo + hi) / 2
    END FUNCTION

END MODULE
