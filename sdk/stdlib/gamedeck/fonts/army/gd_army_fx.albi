-- Army HUD FX: wobble/tear offsets. Observed from C army_font_fx, new code.
VERSION 1.0

DECLARE MODULE GdArmyFx
    FUNCTION WobbleX(t AS S32) AS S32
    FUNCTION TearY(t AS S32) AS S32
    PROCEDURE PresentWobbleNum(n AS S32, px AS S32, py AS S32, t AS S32)
END DECLARE MODULE

MODULE GdArmyFx

    FUNCTION WobbleX(t AS S32) AS S32
        ASSERT(t >= 0)
        ASSERT(t <= 255)
        RETURN (t AND 3) - 1
    END FUNCTION
    FUNCTION TearY(t AS S32) AS S32
        ASSERT(t >= 0)
        ASSERT(t <= 255)
        IF (t AND 7) = 0 THEN
            RETURN 1
        END IF
        RETURN 0
    END FUNCTION

    PROCEDURE PresentWobbleNum(n AS S32, px AS S32, py AS S32, t AS S32)
        LET x AS S32 = 0
        LET y AS S32 = 0
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        x = px + WobbleX(t)
        y = py + TearY(t)
        GdArmyFont.PresentNum(n, x, y)
    END PROCEDURE

END MODULE
