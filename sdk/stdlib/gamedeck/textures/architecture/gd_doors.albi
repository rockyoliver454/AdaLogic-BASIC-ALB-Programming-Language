-- Twin of Ada DoorsWindows: wood, industrial, storefront, boarded, lattice.
VERSION 1.0

DECLARE MODULE GdDoors
    FUNCTION RgbOf(kind AS S32) AS S32
    PROCEDURE PresentTile(kind AS S32, x AS S32, y AS S32)
    FUNCTION KindN() AS S32
    FUNCTION AdaId(kind AS S32) AS S32
END DECLARE MODULE

MODULE GdDoors

    FUNCTION AdaId(kind AS S32) AS S32
        ASSERT(kind >= 0)
        ASSERT(kind <= 4)
        IF kind = 0 THEN RETURN 57 END IF
        IF kind = 1 THEN RETURN 89 END IF
        IF kind = 2 THEN RETURN 88 END IF
        IF kind = 3 THEN RETURN 96 END IF
        RETURN 58
    END FUNCTION

    FUNCTION RgbOf(kind AS S32) AS S32
        ASSERT(kind >= 0)
        ASSERT(kind <= 4)
        RETURN GdAdaTex.Rgb0(AdaId(kind))
    END FUNCTION

    PROCEDURE PresentTile(kind AS S32, x AS S32, y AS S32)
        ASSERT(kind >= 0)
        ASSERT(kind <= 4)
        GdAdaTex.Present(AdaId(kind), x, y)
    END PROCEDURE

    FUNCTION KindN() AS S32
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        RETURN 5
    END FUNCTION

END MODULE
