-- Twin of Ada Wall_Sand_Drift. Load -> ArmTex. Raster is GdAdaTex id 97.
VERSION 1.0

DECLARE MODULE WallSandDrift
    FUNCTION TexId() AS S32
    PROCEDURE ArmTex()
    PROCEDURE PresentAt(x AS S32, y AS S32)
    FUNCTION TileW() AS S32
    FUNCTION TileH() AS S32
    FUNCTION RgbA() AS S32
END DECLARE MODULE

MODULE WallSandDrift

    FUNCTION TexId() AS S32
        ASSERT(1 = 1)
        RETURN 97
    END FUNCTION

    PROCEDURE ArmTex()
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        GdAdaTex.BakeTile(TexId())
    END PROCEDURE

    PROCEDURE PresentAt(x AS S32, y AS S32)
        ASSERT(1 = 1)
        GdAdaTex.Present(97, x, y)
    END PROCEDURE

    FUNCTION TileW() AS S32
        ASSERT(1 = 1)
        RETURN 16
    END FUNCTION

    FUNCTION TileH() AS S32
        ASSERT(1 = 1)
        RETURN 16
    END FUNCTION

    FUNCTION RgbA() AS S32
        ASSERT(1 = 1)
        RETURN GdAdaTex.Rgb0(97)
    END FUNCTION

END MODULE
