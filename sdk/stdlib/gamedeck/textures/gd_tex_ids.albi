MODULE GdTexIds

    FUNCTION PackOf(folder AS S32, slot AS S32) AS S32
        ASSERT(folder >= 0)
        RETURN folder * 16 + slot
    END FUNCTION
    FUNCTION FolderOf(pack AS S32) AS S32
        ASSERT(pack >= 0)
        RETURN pack / 16
    END FUNCTION
    FUNCTION SlotOf(pack AS S32) AS S32
        ASSERT(pack >= 0)
        RETURN pack MOD 16
    END FUNCTION

    FUNCTION WallLog() AS S32
        ASSERT(1 = 1)
        RETURN 54
    END FUNCTION
