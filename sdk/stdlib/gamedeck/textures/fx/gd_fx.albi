-- Twin of Ada FX: wind, leaf, insect sprites as integer tints.
VERSION 1.0

DECLARE MODULE GdFx
    FUNCTION RgbOf(kind AS S32) AS S32
    PROCEDURE PresentSpeck(kind AS S32, x AS S32, y AS S32)
    FUNCTION KindN() AS S32
    FUNCTION AdaId(kind AS S32) AS S32
END DECLARE MODULE

MODULE GdFx

    FUNCTION AdaId(kind AS S32) AS S32
        ASSERT(kind >= 0)
        ASSERT(kind <= 2)
        IF kind = 0 THEN RETURN 51 END IF
        IF kind = 1 THEN RETURN 52 END IF
        RETURN 50
    END FUNCTION

    FUNCTION RgbOf(kind AS S32) AS S32
        ASSERT(kind >= 0)
        ASSERT(kind <= 2)
        RETURN GdAdaTex.Rgb0(AdaId(kind))
    END FUNCTION

    PROCEDURE PresentSpeck(kind AS S32, x AS S32, y AS S32)
        ASSERT(kind >= 0)
        ASSERT(kind <= 2)
        GdAdaTex.Present(AdaId(kind), x, y)
    END PROCEDURE

    FUNCTION KindN() AS S32
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        RETURN 3
    END FUNCTION

END MODULE
