-- Twin of Ada Sky/Elements: fog, water, snow, dust.
VERSION 1.0

DECLARE MODULE GdElem
    FUNCTION RgbOf(kind AS S32) AS S32
    PROCEDURE PresentBand(kind AS S32, y AS S32)
    FUNCTION KindN() AS S32
    FUNCTION AdaId(kind AS S32) AS S32
END DECLARE MODULE

MODULE GdElem

    FUNCTION AdaId(kind AS S32) AS S32
        ASSERT(kind >= 0)
        ASSERT(kind <= 3)
        IF kind = 0 THEN RETURN 32 END IF
        IF kind = 1 THEN RETURN 17 END IF
        IF kind = 2 THEN RETURN 20 END IF
        RETURN 33
    END FUNCTION

    FUNCTION RgbOf(kind AS S32) AS S32
        ASSERT(kind >= 0)
        ASSERT(kind <= 3)
        RETURN GdAdaTex.Rgb0(AdaId(kind))
    END FUNCTION

    PROCEDURE PresentBand(kind AS S32, y AS S32)
        LET i AS S32 = 0
        ASSERT(kind >= 0)
        ASSERT(kind <= 3)
        COLOR RgbOf(kind)
        FILL RECT 0, y, 640, 16
        WHILE i < 8
            GdAdaTex.Present(AdaId(kind), i * 80, y)
            i = i + 1
        END WHILE
    END PROCEDURE

    FUNCTION KindN() AS S32
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        RETURN 4
    END FUNCTION

END MODULE
