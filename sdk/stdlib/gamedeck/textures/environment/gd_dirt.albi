-- Twin of Ada Ground: dirt, cracked, plowed, sand, desert grit, sandstone.
VERSION 1.0

DECLARE MODULE GdDirt
    FUNCTION RgbOf(kind AS S32) AS S32
    PROCEDURE PresentTile(kind AS S32, x AS S32, y AS S32)
    FUNCTION KindN() AS S32
    FUNCTION AdaId(kind AS S32) AS S32
END DECLARE MODULE

MODULE GdDirt

    FUNCTION AdaId(kind AS S32) AS S32
        ASSERT(kind >= 0)
        ASSERT(kind <= 5)
        IF kind = 0 THEN RETURN 21 END IF
        IF kind = 1 THEN RETURN 25 END IF
        IF kind = 2 THEN RETURN 22 END IF
        IF kind = 3 THEN RETURN 18 END IF
        IF kind = 4 THEN RETURN 24 END IF
        RETURN 26
    END FUNCTION

    FUNCTION RgbOf(kind AS S32) AS S32
        ASSERT(kind >= 0)
        ASSERT(kind <= 5)
        RETURN GdAdaTex.Rgb0(AdaId(kind))
    END FUNCTION

    PROCEDURE PresentTile(kind AS S32, x AS S32, y AS S32)
        ASSERT(kind >= 0)
        ASSERT(kind <= 5)
        GdAdaTex.Present(AdaId(kind), x, y)
    END PROCEDURE

    FUNCTION KindN() AS S32
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        RETURN 6
    END FUNCTION

END MODULE
