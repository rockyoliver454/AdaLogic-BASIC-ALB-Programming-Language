-- Twin of Ada Roads: asphalt, concrete, dirt, cobble, pothole, manhole, sidewalk, lot.
VERSION 1.0

DECLARE MODULE GdRoads
    FUNCTION RgbOf(kind AS S32) AS S32
    FUNCTION ShadeAt(x AS S32, y AS S32, kind AS S32) AS S32
    PROCEDURE PresentTile(kind AS S32, x AS S32, y AS S32)
    FUNCTION KindN() AS S32
    FUNCTION AdaId(kind AS S32) AS S32
END DECLARE MODULE

MODULE GdRoads

    FUNCTION AdaId(kind AS S32) AS S32
        ASSERT(kind >= 0)
        ASSERT(kind <= 7)
        IF kind = 0 THEN RETURN 69 END IF
        IF kind = 1 THEN RETURN 70 END IF
        IF kind = 2 THEN RETURN 68 END IF
        IF kind = 3 THEN RETURN 71 END IF
        IF kind = 4 THEN RETURN 72 END IF
        IF kind = 5 THEN RETURN 73 END IF
        IF kind = 6 THEN RETURN 74 END IF
        RETURN 75
    END FUNCTION

    FUNCTION RgbOf(kind AS S32) AS S32
        ASSERT(kind >= 0)
        ASSERT(kind <= 7)
        RETURN GdAdaTex.Rgb0(AdaId(kind))
    END FUNCTION

    FUNCTION ShadeAt(x AS S32, y AS S32, kind AS S32) AS S32
        ASSERT(kind >= 0)
        ASSERT(kind <= 7)
        RETURN GdAdaTex.PixelRgb(AdaId(kind), x AND 15, y AND 15)
    END FUNCTION

    PROCEDURE PresentTile(kind AS S32, x AS S32, y AS S32)
        ASSERT(kind >= 0)
        ASSERT(kind <= 7)
        GdAdaTex.Present(AdaId(kind), x, y)
    END PROCEDURE

    FUNCTION KindN() AS S32
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        RETURN 8
    END FUNCTION

END MODULE
