    PROCEDURE BakeTile(idn AS S32)
        LET lx AS S32 = 0
        LET ly AS S32 = 0
        LET i AS S32 = 1
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        IF armed = 0 THEN
            ArmAll()
        END IF
        bake_id = idn
        ly = 0
        WHILE ly < 16
            lx = 0
            WHILE lx < 16
                bake[i] = PixelRgb(idn, lx, ly)
                i = i + 1
                lx = lx + 1
            END WHILE
            ly = ly + 1
        END WHILE
    END PROCEDURE

    FUNCTION BakeAt(i AS S32) AS S32 REQUIRE i >= 1
        ASSERT(i >= 1)
        ASSERT(i <= 256)
        RETURN bake[i]
    END FUNCTION

    FUNCTION BakeId() AS S32
        ASSERT(1 = 1)
        RETURN bake_id
    END FUNCTION

    FUNCTION Slot(idn AS S32) AS S32
        LET s AS S32 = idn + 1
        ASSERT(1 = 1)
        IF armed = 0 THEN
            ArmAll()
        END IF
        IF s < 1 THEN
            s = 1
        END IF
        IF s > 128 THEN
            s = 128
        END IF
        RETURN s
    END FUNCTION

    FUNCTION PixelRgb(idn AS S32, lx AS S32, ly AS S32) AS S32
        LET s AS S32 = 0
        LET p AS S32 = 0
        LET n AS S32 = 0
        LET a0 AS S32 = 0
        LET a1 AS S32 = 0
        LET a2 AS S32 = 0
        LET r AS S32 = 0
        LET g AS S32 = 0
        LET b AS S32 = 0
        LET mx AS S32 = lx
        LET my AS S32 = ly
        LET row AS S32 = 0
        LET col AS S32 = 0
        ASSERT(1 = 1)
        IF mx < 0 THEN mx = 0 END IF
        IF my < 0 THEN my = 0 END IF
        IF mx > 15 THEN mx = 15 END IF
        IF my > 15 THEN my = 15 END IF
        s = Slot(idn)
        p = pat[s]
        a0 = c0[s]
        a1 = c1[s]
        a2 = c2[s]
        n = GdHash.ByteOf(mx, my, idn)
        r = (a0 / 65536) AND 255
        g = (a0 / 256) AND 255
        b = a0 AND 255
        IF p = 0 THEN
            IF ((mx / 8) + (my / 8)) AND 1 THEN
                RETURN 16711935
            END IF
            RETURN 0
        END IF
        IF p = 1 THEN
            IF n > 180 THEN
                RETURN a1
            END IF
            IF (mx + my * 3) AND 2 THEN
                RETURN a2
            END IF
            RETURN a0
        END IF
        IF p = 2 THEN
            IF n > 220 THEN
                RETURN a2
            END IF
            IF n > 140 THEN
                RETURN a1
            END IF
            RETURN a0
        END IF
        IF p = 3 THEN
            row = my / 2
            col = mx
            IF (row AND 1) = 1 THEN
                col = mx + 4
            END IF
            IF (my AND 1) = 0 THEN
                RETURN a1
            END IF
            IF (col AND 7) = 0 THEN
                RETURN a1
            END IF
            IF n > 178 THEN
                RETURN a2
            END IF
            RETURN a0
        END IF
        IF p = 4 THEN
            row = my AND 3
            IF row = 3 THEN
                RETURN a2
            END IF
            IF row = 0 THEN
                RETURN a0
            END IF
            IF row = 1 THEN
                RETURN a1
            END IF
            IF n > 230 THEN
                RETURN a0
            END IF
            RETURN a1
        END IF
        IF p = 5 THEN
            IF (mx AND 3) = 0 THEN
                RETURN a2
            END IF
            IF n > 200 THEN
                RETURN a1
            END IF
            RETURN a0
        END IF
        IF p = 6 THEN
            IF my = 7 THEN
                IF (mx AND 4) = 0 THEN
                    RETURN a1
                END IF
            END IF
            IF n > 200 THEN
                RETURN a2
            END IF
            RETURN a0
        END IF
        IF p = 7 THEN
            IF (mx AND 3) = 0 THEN
                RETURN a2
            END IF
            IF (my AND 3) = 0 THEN
                RETURN a2
            END IF
            IF n > 160 THEN
                RETURN a1
            END IF
            RETURN a0
        END IF
        IF p = 8 THEN
            IF ((my + (mx / 2)) AND 3) = 0 THEN
                RETURN a1
            END IF
            RETURN a0
        END IF
        IF p = 9 THEN
            IF (my + n / 64) AND 2 THEN
                RETURN a1
            END IF
            RETURN a0
        END IF
        IF p = 10 THEN
            IF mx = 0 THEN
                RETURN a2
            END IF
            IF my = 0 THEN
                RETURN a2
            END IF
            IF mx = 8 THEN
                RETURN a2
            END IF
            IF n > 210 THEN
                RETURN a1
            END IF
            RETURN a0
        END IF
        IF p = 11 THEN
            IF n > 120 THEN
                RETURN a1
            END IF
            RETURN a0
        END IF
        IF p = 12 THEN
            IF (mx AND 7) = 0 THEN
                RETURN a2
            END IF
            IF (my AND 7) = 0 THEN
                RETURN a2
            END IF
            IF n > 170 THEN
                RETURN a1
            END IF
            RETURN a0
        END IF
        IF p = 13 THEN
            IF n > 200 THEN
                RETURN a1
            END IF
            RETURN a0
        END IF
        IF p = 14 THEN
            IF my > 11 THEN
                IF mx > 5 THEN
                    IF mx < 10 THEN
                        RETURN a2
                    END IF
                END IF
                RETURN 0
            END IF
            col = mx - 8
            row = 8 - my
            IF col < 0 THEN col = 0 - col END IF
            IF col + row / 2 < 7 THEN
                IF n > 200 THEN
                    RETURN a1
                END IF
                RETURN a0
            END IF
            RETURN 0
        END IF
        IF p = 15 THEN
            IF (mx AND 3) = 1 THEN
                IF my > 6 THEN
                    RETURN a0
                END IF
                RETURN a1
            END IF
            RETURN a2
        END IF
        IF p = 16 THEN
            IF mx = 0 THEN RETURN a2 END IF
            IF mx = 15 THEN RETURN a2 END IF
            IF my = 0 THEN RETURN a2 END IF
            IF my = 15 THEN RETURN a2 END IF
            IF mx = 11 THEN
                IF my > 7 THEN
                    IF my < 10 THEN
                        RETURN a1
                    END IF
                END IF
            END IF
            RETURN a0
        END IF
        IF p = 17 THEN
            IF (mx AND 7) = 0 THEN RETURN a2 END IF
            IF (my AND 7) = 0 THEN RETURN a2 END IF
            RETURN a0
        END IF
        IF p = 18 THEN
            IF ((mx + my) AND 1) = 0 THEN
                RETURN a1
            END IF
            RETURN a0
        END IF
        IF p = 19 THEN
            IF (my AND 3) = 1 THEN RETURN a0 END IF
            IF (mx AND 7) = 2 THEN RETURN a1 END IF
            RETURN 0
        END IF
        IF p = 20 THEN
            IF ((mx + my) AND 3) = 0 THEN RETURN a0 END IF
            IF ((mx - my) AND 3) = 0 THEN RETURN a0 END IF
            RETURN 0
        END IF
        IF p = 21 THEN
            IF mx > 3 THEN
                IF mx < 12 THEN
                    IF my > 2 THEN
                        RETURN a0
                    END IF
                END IF
            END IF
            RETURN 0
        END IF
        IF p = 22 THEN
            IF my < 4 THEN
                IF mx > 5 THEN
                    IF mx < 11 THEN
                        RETURN a1
                    END IF
                END IF
                RETURN 0
            END IF
            IF mx > 4 THEN
                IF mx < 12 THEN
                    RETURN a0
                END IF
            END IF
            RETURN 0
        END IF
        IF p = 23 THEN
            IF my > 6 THEN
                IF my < 10 THEN
                    IF mx > 2 THEN
                        RETURN a0
                    END IF
                END IF
            END IF
            IF mx > 11 THEN
                IF my > 4 THEN
                    IF my < 12 THEN
                        RETURN a1
                    END IF
                END IF
            END IF
            RETURN 0
        END IF
        IF p = 24 THEN
            IF n > 200 THEN RETURN a0 END IF
            RETURN 0
        END IF
        IF p = 25 THEN
            IF mx = 0 THEN RETURN a2 END IF
            IF my = 0 THEN RETURN a2 END IF
            IF mx = 15 THEN RETURN a2 END IF
            IF my = 15 THEN RETURN a2 END IF
            RETURN a0
        END IF
        IF p = 26 THEN
            IF n > 160 THEN RETURN a1 END IF
            RETURN a0
        END IF
        IF p = 27 THEN
            r = r + n / 8
            g = g + n / 8
            b = b + n / 8
            RETURN PackRgb(r, g, b)
        END IF
        IF p = 28 THEN
            IF mx > 6 THEN
                IF mx < 10 THEN
                    RETURN a0
                END IF
            END IF
            IF my > 4 THEN
                IF my < 8 THEN
                    IF mx > 3 THEN
                        IF mx < 13 THEN
                            RETURN a0
                        END IF
                    END IF
                END IF
            END IF
            RETURN 0
        END IF
        IF p = 29 THEN
            IF my < mx / 2 THEN RETURN 0 END IF
            IF (mx AND 2) = 0 THEN RETURN a1 END IF
            RETURN a0
        END IF
        IF p = 30 THEN
            IF (mx AND 7) = 0 THEN RETURN a2 END IF
            IF (my AND 3) = 0 THEN RETURN a2 END IF
            IF n > 190 THEN RETURN a1 END IF
            RETURN a0
        END IF
        IF p = 31 THEN
            IF n > 210 THEN RETURN a1 END IF
            RETURN a0
        END IF
        IF p = 32 THEN
            IF (my AND 3) = 0 THEN RETURN a2 END IF
            RETURN a0
        END IF
        IF p = 33 THEN
            IF mx = my THEN RETURN a2 END IF
            IF n > 180 THEN RETURN a1 END IF
            RETURN a0
        END IF
        IF p = 34 THEN
            col = mx - 8
            row = my - 8
            IF col < 0 THEN col = 0 - col END IF
            IF row < 0 THEN row = 0 - row END IF
            IF col + row < 7 THEN RETURN a1 END IF
            RETURN a0
        END IF
        IF p = 35 THEN
            col = mx - 8
            row = my - 9
            IF col < 0 THEN col = 0 - col END IF
            IF row < 0 THEN row = 0 - row END IF
            IF col + row < 5 THEN RETURN a2 END IF
            RETURN a0
        END IF
        IF p = 36 THEN
            IF mx > 6 THEN
                IF mx < 10 THEN
                    IF my > 4 THEN RETURN a0 END IF
                END IF
            END IF
            IF my > 6 THEN
                IF my < 9 THEN
                    IF mx > 4 THEN
                        IF mx < 12 THEN RETURN a1 END IF
                    END IF
                END IF
            END IF
            RETURN 0
        END IF
        IF p = 37 THEN
            IF mx = 8 THEN RETURN a0 END IF
            IF mx = 7 THEN RETURN a0 END IF
            IF my < 4 THEN
                IF mx > 4 THEN
                    IF mx < 12 THEN RETURN a1 END IF
                END IF
            END IF
            RETURN 0
        END IF
        IF p = 38 THEN
            IF mx = 2 THEN RETURN a2 END IF
            IF mx = 13 THEN RETURN a2 END IF
            IF my = 1 THEN RETURN a2 END IF
            IF my = 15 THEN RETURN a2 END IF
            IF mx > 4 THEN
                IF mx < 11 THEN
                    IF my > 3 THEN
                        IF my < 10 THEN RETURN a1 END IF
                    END IF
                END IF
            END IF
            RETURN a0
        END IF
        IF p = 39 THEN
            IF mx > 5 THEN
                IF mx < 11 THEN
                    IF my > 1 THEN RETURN a0 END IF
                END IF
            END IF
            RETURN 0
        END IF
        IF p = 40 THEN
            col = mx - 8
            row = my - 7
            IF col < 0 THEN col = 0 - col END IF
            IF row < 0 THEN row = 0 - row END IF
            IF col + row < 6 THEN RETURN a0 END IF
            RETURN 0
        END IF
        IF p = 41 THEN
            IF my > 8 THEN
                IF mx > 3 THEN
                    IF mx < 13 THEN RETURN a0 END IF
                END IF
            END IF
            RETURN 0
        END IF
        IF p = 42 THEN
            IF n > 90 THEN RETURN a0 END IF
            IF n > 40 THEN RETURN a1 END IF
            RETURN 0
        END IF
        IF p = 43 THEN
            IF (mx AND 1) = 0 THEN
                IF my > n / 32 THEN RETURN a0 END IF
            END IF
            RETURN 0
        END IF
        IF p = 44 THEN
            IF mx = 8 THEN RETURN a2 END IF
            IF my < 8 THEN
                col = mx - 8
                IF col < 0 THEN col = 0 - col END IF
                IF col < 4 THEN RETURN a0 END IF
            END IF
            RETURN 0
        END IF
        IF p = 45 THEN
            IF n > 200 THEN RETURN a1 END IF
            RETURN a0
        END IF
        IF p = 46 THEN
            IF my > 10 THEN RETURN a1 END IF
            IF my > 6 THEN RETURN a0 END IF
            RETURN a2
        END IF
        IF p = 47 THEN
            IF (my AND 3) = 0 THEN RETURN a2 END IF
            RETURN a0
        END IF
        IF p = 48 THEN
            IF n > 128 THEN RETURN a1 END IF
            RETURN a0
        END IF
        IF p = 49 THEN
            col = mx - 8
            row = my - 8
            IF col < 0 THEN col = 0 - col END IF
            IF row < 0 THEN row = 0 - row END IF
            IF col + row < 3 THEN RETURN a0 END IF
            RETURN a1
        END IF
        IF p = 50 THEN
            IF n > 200 THEN RETURN a0 END IF
            IF n > 170 THEN RETURN a1 END IF
            RETURN a2
        END IF
        IF p = 51 THEN
            IF n > 210 THEN RETURN a0 END IF
            RETURN 0
        END IF
        IF p = 52 THEN
            IF n > 240 THEN RETURN a0 END IF
            RETURN 0
        END IF
        IF p = 53 THEN
            IF ((my + mx / 2) AND 3) = 0 THEN RETURN a0 END IF
            RETURN 0
        END IF
        IF p = 54 THEN
            IF mx = 8 THEN RETURN a0 END IF
            IF my = 8 THEN RETURN a0 END IF
            RETURN 0
        END IF
        RETURN a0
    END FUNCTION

    PROCEDURE Present(idn AS S32, x AS S32, y AS S32)
        LET lx AS S32 = 0
        LET ly AS S32 = 0
        LET rgb AS S32 = 0
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        ly = 0
        WHILE ly < 16
            lx = 0
            WHILE lx < 16
                rgb = PixelRgb(idn, lx, ly)
                IF rgb <> 0 THEN
                    COLOR rgb
                    FILL RECT x + lx, y + ly, 1, 1
                END IF
                lx = lx + 1
            END WHILE
            ly = ly + 1
        END WHILE
    END PROCEDURE

    PROCEDURE PresentGrid(ox AS S32, oy AS S32, cols AS S32, start AS S32, n AS S32)
        LET i AS S32 = 0
        LET idn AS S32 = 0
        LET cap AS S32 = 0
        LET c AS S32 = cols
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        IF c < 1 THEN
            c = 1
        END IF
        cap = IdN()
        WHILE i < n
            idn = start + i
            IF idn >= 0 THEN
                IF idn < cap THEN
                    Present(idn, ox + (i MOD c) * 18, oy + (i / c) * 18)
                END IF
            END IF
            i = i + 1
        END WHILE
    END PROCEDURE

    FUNCTION Rgb0(idn AS S32) AS S32
        LET s AS S32 = Slot(idn)
        ASSERT(1 = 1)
        RETURN c0[s]
    END FUNCTION

    FUNCTION PatOf(idn AS S32) AS S32
        LET s AS S32 = Slot(idn)
        ASSERT(1 = 1)
        RETURN pat[s]
    END FUNCTION

    FUNCTION IdN() AS S32
        ASSERT(1 = 1)
        RETURN 126
    END FUNCTION

    FUNCTION TilePx() AS S32
        ASSERT(1 = 1)
        RETURN 16
    END FUNCTION

    FUNCTION SelfTest() AS S32
        LET a AS S32 = 0
        LET b AS S32 = 0
        LET c AS S32 = 0
        LET i AS S32 = 1
        LET nz AS S32 = 0
        ASSERT(1 = 1)
        ASSERT(0 = 0)
        BakeTile(13)
        a = BakeAt(1)
        BakeTile(12)
        b = BakeAt(1)
        IF BakeId() <> 12 THEN
            RETURN 0
        END IF
        IF a = b THEN
            RETURN 0
        END IF
        BakeTile(13)
        i = 1
        WHILE i <= 256
            c = BakeAt(i)
            IF c <> 0 THEN
                nz = nz + 1
            END IF
            i = i + 1
        END WHILE
        IF nz < 8 THEN
            RETURN 0
        END IF
        IF TilePx() <> 16 THEN
            RETURN 0
        END IF
        IF PatOf(13) <> PatOf(3) THEN
            IF PixelRgb(13, 2, 2) <> PixelRgb(3, 2, 2) THEN
                RETURN 1
            END IF
        END IF
        RETURN 1
    END FUNCTION

END MODULE

