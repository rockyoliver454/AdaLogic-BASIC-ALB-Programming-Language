-- Twin of Ada Core_Texture_Registry + every procedural Load() raster at 16x16.
-- PixelRgb is the CPU canvas Ada Plot() used before Register_Procedural.
VERSION 1.0

DECLARE MODULE GdAdaTex
    PROCEDURE ArmAll()
    PROCEDURE BakeTile(idn AS S32)
    FUNCTION IdN() AS S32
    FUNCTION PixelRgb(idn AS S32, lx AS S32, ly AS S32) AS S32
    FUNCTION BakeAt(i AS S32) AS S32
    FUNCTION BakeId() AS S32
    PROCEDURE Present(idn AS S32, x AS S32, y AS S32)
    PROCEDURE PresentGrid(ox AS S32, oy AS S32, cols AS S32, start AS S32, n AS S32)
    FUNCTION Rgb0(idn AS S32) AS S32
    FUNCTION PatOf(idn AS S32) AS S32
    FUNCTION TilePx() AS S32
    FUNCTION SelfTest() AS S32
END DECLARE MODULE

MODULE GdAdaTex

    STRICT c0[128] AS S32
    STRICT c1[128] AS S32
    STRICT c2[128] AS S32
    STRICT pat[128] AS S32
    STRICT bake[256] AS S32
    LET armed AS S32 = 0
    LET bake_id AS S32 = 0 - 1

    FUNCTION Clip8(v AS S32) AS S32
        LET n AS S32 = v
        ASSERT(1 = 1)
        IF n < 0 THEN
            RETURN 0
        END IF
        IF n > 255 THEN
            RETURN 255
        END IF
        RETURN n
    END FUNCTION

    FUNCTION PackRgb(r AS S32, g AS S32, b AS S32) AS S32
        ASSERT(1 = 1)
        RETURN Clip8(r) * 65536 + Clip8(g) * 256 + Clip8(b)
    END FUNCTION

