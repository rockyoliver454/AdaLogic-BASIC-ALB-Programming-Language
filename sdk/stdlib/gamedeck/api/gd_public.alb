-- Public C ABI for GameDeck-ALB math/registry helpers.
-- First-class EXPORT_DLL public ABI. No foreign imports. No native exposers.

INCLUDE "../standards/gd_limits.albi"
INCLUDE "../standards/gd_scenes.albi"
INCLUDE "../math/gd_rng.albi"
INCLUDE "../math/gd_vec2.albi"
INCLUDE "../math/gd_hash.albi"
INCLUDE "../math/gd_collision.albi"
INCLUDE "../core/gd_registry.albi"

IMPORT GdRng
IMPORT GdVec2
IMPORT GdHash
IMPORT GdCollision
IMPORT GdRegistry

EXPORT_DLL FUNCTION GdApi_Version() AS S32
EXPORT_DLL FUNCTION GdApi_Hash(x AS S32, y AS S32, seed AS S32) AS S32
EXPORT_DLL FUNCTION GdApi_Dist2(ax AS S32, ay AS S32, bx AS S32, by AS S32) AS S32
EXPORT_DLL FUNCTION GdApi_Hits(ax AS S32, ay AS S32, aw AS S32, ah AS S32, bx AS S32, by AS S32, bw AS S32, bh AS S32) AS S32
EXPORT_DLL FUNCTION GdApi_RngNext() AS S32
EXPORT_DLL FUNCTION GdApi_GetScene() AS S32
EXPORT_DLL PROCEDURE GdApi_SetScene(id AS S32)
EXPORT_DLL FUNCTION GdApi_SceneLast() AS S32
EXPORT_DLL PROCEDURE GdApi_Seed(v AS U32)

FUNCTION GdApi_Version() AS S32
    RETURN 8
END FUNCTION

FUNCTION GdApi_Hash(x AS S32, y AS S32, seed AS S32) AS S32
    RETURN GdHash.ByteOf(x, y, seed)
END FUNCTION

FUNCTION GdApi_Dist2(ax AS S32, ay AS S32, bx AS S32, by AS S32) AS S32
    RETURN GdVec2.Dist2(ax, ay, bx, by)
END FUNCTION

FUNCTION GdApi_Hits(ax AS S32, ay AS S32, aw AS S32, ah AS S32, bx AS S32, by AS S32, bw AS S32, bh AS S32) AS S32
    IF GdCollision.Aabb(ax, ay, aw, ah, bx, by, bw, bh) THEN
        RETURN 1
    END IF
    RETURN 0
END FUNCTION

FUNCTION GdApi_RngNext() AS S32
    RETURN S32(GdRng.NextU32() MOD 2147483647)
END FUNCTION

FUNCTION GdApi_GetScene() AS S32
    RETURN GdRegistry.GetScene()
END FUNCTION

FUNCTION GdApi_SceneLast() AS S32
    RETURN #SCENE_LAST
END FUNCTION

PROCEDURE GdApi_SetScene(id AS S32)
    IF id < 0 THEN
        RETURN
    END IF
    IF id > #SCENE_LAST THEN
        RETURN
    END IF
    GdRegistry.SetScene(id)
END PROCEDURE

PROCEDURE GdApi_Seed(v AS U32)
    GdRng.Seed(v)
END PROCEDURE

BEGIN
VERSION 1.0
END
