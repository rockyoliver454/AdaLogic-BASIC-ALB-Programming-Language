-- ====================================================================
-- DOS_EVENT.ALBI
-- Small frame/event latch helpers for DOS-style interaction loops.
-- ====================================================================

#DOSEVT_K_A = 4
#DOSEVT_K_D = 7
#DOSEVT_K_S = 22
#DOSEVT_K_W = 26
#DOSEVT_K_ENTER = 40
#DOSEVT_K_ESCAPE = 41
#DOSEVT_K_SPACE = 44
#DOSEVT_K_RIGHT = 79
#DOSEVT_K_LEFT = 80
#DOSEVT_K_DOWN = 81
#DOSEVT_K_UP = 82

LET DOSEVT_FRAME_COUNT AS U32 = 0

LET DOSEVT_LEFT_NOW AS BOOL = FALSE
LET DOSEVT_LEFT_PREV AS BOOL = FALSE
LET DOSEVT_RIGHT_NOW AS BOOL = FALSE
LET DOSEVT_RIGHT_PREV AS BOOL = FALSE
LET DOSEVT_UP_NOW AS BOOL = FALSE
LET DOSEVT_UP_PREV AS BOOL = FALSE
LET DOSEVT_DOWN_NOW AS BOOL = FALSE
LET DOSEVT_DOWN_PREV AS BOOL = FALSE
LET DOSEVT_CONFIRM_NOW AS BOOL = FALSE
LET DOSEVT_CONFIRM_PREV AS BOOL = FALSE
LET DOSEVT_CANCEL_NOW AS BOOL = FALSE
LET DOSEVT_CANCEL_PREV AS BOOL = FALSE

PROCEDURE DOSEVT_Reset()
    DOSEVT_FRAME_COUNT = 0
    DOSEVT_LEFT_NOW = FALSE
    DOSEVT_LEFT_PREV = FALSE
    DOSEVT_RIGHT_NOW = FALSE
    DOSEVT_RIGHT_PREV = FALSE
    DOSEVT_UP_NOW = FALSE
    DOSEVT_UP_PREV = FALSE
    DOSEVT_DOWN_NOW = FALSE
    DOSEVT_DOWN_PREV = FALSE
    DOSEVT_CONFIRM_NOW = FALSE
    DOSEVT_CONFIRM_PREV = FALSE
    DOSEVT_CANCEL_NOW = FALSE
    DOSEVT_CANCEL_PREV = FALSE
END PROCEDURE

PROCEDURE DOSEVT_Set_Frame(frame_value AS U32)
    DOSEVT_FRAME_COUNT = frame_value
END PROCEDURE

PROCEDURE DOSEVT_Advance_Frame()
    DOSEVT_FRAME_COUNT = DOSEVT_FRAME_COUNT + 1
END PROCEDURE

PROCEDURE DOSEVT_Update_Navigation(left_now AS BOOL, right_now AS BOOL, up_now AS BOOL, down_now AS BOOL, confirm_now AS BOOL, cancel_now AS BOOL)
    DOSEVT_FRAME_COUNT = DOSEVT_FRAME_COUNT + 1

    DOSEVT_LEFT_PREV = DOSEVT_LEFT_NOW
    DOSEVT_RIGHT_PREV = DOSEVT_RIGHT_NOW
    DOSEVT_UP_PREV = DOSEVT_UP_NOW
    DOSEVT_DOWN_PREV = DOSEVT_DOWN_NOW
    DOSEVT_CONFIRM_PREV = DOSEVT_CONFIRM_NOW
    DOSEVT_CANCEL_PREV = DOSEVT_CANCEL_NOW

    DOSEVT_LEFT_NOW = left_now
    DOSEVT_RIGHT_NOW = right_now
    DOSEVT_UP_NOW = up_now
    DOSEVT_DOWN_NOW = down_now
    DOSEVT_CONFIRM_NOW = confirm_now
    DOSEVT_CANCEL_NOW = cancel_now
END PROCEDURE

FUNCTION DOSEVT_Left_Pressed() AS BOOL
    IF DOSEVT_LEFT_NOW AND NOT DOSEVT_LEFT_PREV THEN RETURN TRUE END IF
    RETURN FALSE
END FUNCTION

FUNCTION DOSEVT_Right_Pressed() AS BOOL
    IF DOSEVT_RIGHT_NOW AND NOT DOSEVT_RIGHT_PREV THEN RETURN TRUE END IF
    RETURN FALSE
END FUNCTION

FUNCTION DOSEVT_Up_Pressed() AS BOOL
    IF DOSEVT_UP_NOW AND NOT DOSEVT_UP_PREV THEN RETURN TRUE END IF
    RETURN FALSE
END FUNCTION

FUNCTION DOSEVT_Down_Pressed() AS BOOL
    IF DOSEVT_DOWN_NOW AND NOT DOSEVT_DOWN_PREV THEN RETURN TRUE END IF
    RETURN FALSE
END FUNCTION

FUNCTION DOSEVT_Confirm_Pressed() AS BOOL
    IF DOSEVT_CONFIRM_NOW AND NOT DOSEVT_CONFIRM_PREV THEN RETURN TRUE END IF
    RETURN FALSE
END FUNCTION

FUNCTION DOSEVT_Cancel_Pressed() AS BOOL
    IF DOSEVT_CANCEL_NOW AND NOT DOSEVT_CANCEL_PREV THEN RETURN TRUE END IF
    RETURN FALSE
END FUNCTION

FUNCTION DOSEVT_Any_Navigation_Pressed() AS BOOL
    IF DOSEVT_Left_Pressed() THEN RETURN TRUE END IF
    IF DOSEVT_Right_Pressed() THEN RETURN TRUE END IF
    IF DOSEVT_Up_Pressed() THEN RETURN TRUE END IF
    IF DOSEVT_Down_Pressed() THEN RETURN TRUE END IF
    RETURN FALSE
END FUNCTION

FUNCTION DOSEVT_Frame_Mod(period_value AS U16) AS BOOL
    IF period_value = 0 THEN RETURN FALSE END IF
    IF DOSEVT_FRAME_COUNT MOD period_value = 0 THEN RETURN TRUE END IF
    RETURN FALSE
END FUNCTION

FUNCTION DOSEVT_Blink(on_frames AS U16, off_frames AS U16) AS BOOL
    LET total_frames AS U16 = on_frames + off_frames
    LET phase_value AS U16 = 0

    IF total_frames = 0 THEN RETURN TRUE END IF

    phase_value = CAST(DOSEVT_FRAME_COUNT MOD total_frames AS U16)
    IF phase_value < on_frames THEN RETURN TRUE END IF
    RETURN FALSE
END FUNCTION
