-- ====================================================================
-- DOS_INPUT.ALBI
-- Common DOS-friendly key mappings and menu helpers.
-- ====================================================================

#DOSINPUT_K_A = 4
#DOSINPUT_K_D = 7
#DOSINPUT_K_S = 22
#DOSINPUT_K_W = 26
#DOSINPUT_K_1 = 30
#DOSINPUT_K_2 = 31
#DOSINPUT_K_3 = 32
#DOSINPUT_K_4 = 33
#DOSINPUT_K_5 = 34
#DOSINPUT_K_6 = 35
#DOSINPUT_K_7 = 36
#DOSINPUT_K_8 = 37
#DOSINPUT_K_9 = 38
#DOSINPUT_K_0 = 39
#DOSINPUT_K_ENTER = 40
#DOSINPUT_K_ESCAPE = 41
#DOSINPUT_K_SPACE = 44
#DOSINPUT_K_RIGHT = 79
#DOSINPUT_K_LEFT = 80
#DOSINPUT_K_DOWN = 81
#DOSINPUT_K_UP = 82

FUNCTION DOSINPUT_Digit_Text(value AS U16) AS STRING
    SELECT value
        CASE 0 => RETURN "0"
        CASE 1 => RETURN "1"
        CASE 2 => RETURN "2"
        CASE 3 => RETURN "3"
        CASE 4 => RETURN "4"
        CASE 5 => RETURN "5"
        CASE 6 => RETURN "6"
        CASE 7 => RETURN "7"
        CASE 8 => RETURN "8"
        CASE ELSE => RETURN "9"
    END SELECT
END FUNCTION

FUNCTION DOSINPUT_Alpha_From_Index(slot AS U16) AS STRING
    SELECT slot
        CASE 1 => RETURN "A"
        CASE 2 => RETURN "B"
        CASE 3 => RETURN "C"
        CASE 4 => RETURN "D"
        CASE 5 => RETURN "E"
        CASE 6 => RETURN "F"
        CASE 7 => RETURN "G"
        CASE 8 => RETURN "H"
        CASE 9 => RETURN "I"
        CASE 10 => RETURN "J"
        CASE 11 => RETURN "K"
        CASE 12 => RETURN "L"
        CASE 13 => RETURN "M"
        CASE 14 => RETURN "N"
        CASE 15 => RETURN "O"
        CASE 16 => RETURN "P"
        CASE 17 => RETURN "Q"
        CASE 18 => RETURN "R"
        CASE 19 => RETURN "S"
        CASE 20 => RETURN "T"
        CASE 21 => RETURN "U"
        CASE 22 => RETURN "V"
        CASE 23 => RETURN "W"
        CASE 24 => RETURN "X"
        CASE 25 => RETURN "Y"
        CASE ELSE => RETURN "Z"
    END SELECT
END FUNCTION

FUNCTION DOSINPUT_Index_From_Alpha(ch AS STRING) AS U16
    IF ch = "A" THEN RETURN 1 END IF
    IF ch = "a" THEN RETURN 1 END IF
    IF ch = "B" THEN RETURN 2 END IF
    IF ch = "b" THEN RETURN 2 END IF
    IF ch = "C" THEN RETURN 3 END IF
    IF ch = "c" THEN RETURN 3 END IF
    IF ch = "D" THEN RETURN 4 END IF
    IF ch = "d" THEN RETURN 4 END IF
    IF ch = "E" THEN RETURN 5 END IF
    IF ch = "e" THEN RETURN 5 END IF
    IF ch = "F" THEN RETURN 6 END IF
    IF ch = "f" THEN RETURN 6 END IF
    IF ch = "G" THEN RETURN 7 END IF
    IF ch = "g" THEN RETURN 7 END IF
    IF ch = "H" THEN RETURN 8 END IF
    IF ch = "h" THEN RETURN 8 END IF
    IF ch = "I" THEN RETURN 9 END IF
    IF ch = "i" THEN RETURN 9 END IF
    IF ch = "J" THEN RETURN 10 END IF
    IF ch = "j" THEN RETURN 10 END IF
    IF ch = "K" THEN RETURN 11 END IF
    IF ch = "k" THEN RETURN 11 END IF
    IF ch = "L" THEN RETURN 12 END IF
    IF ch = "l" THEN RETURN 12 END IF
    IF ch = "M" THEN RETURN 13 END IF
    IF ch = "m" THEN RETURN 13 END IF
    IF ch = "N" THEN RETURN 14 END IF
    IF ch = "n" THEN RETURN 14 END IF
    IF ch = "O" THEN RETURN 15 END IF
    IF ch = "o" THEN RETURN 15 END IF
    IF ch = "P" THEN RETURN 16 END IF
    IF ch = "p" THEN RETURN 16 END IF
    IF ch = "Q" THEN RETURN 17 END IF
    IF ch = "q" THEN RETURN 17 END IF
    IF ch = "R" THEN RETURN 18 END IF
    IF ch = "r" THEN RETURN 18 END IF
    IF ch = "S" THEN RETURN 19 END IF
    IF ch = "s" THEN RETURN 19 END IF
    IF ch = "T" THEN RETURN 20 END IF
    IF ch = "t" THEN RETURN 20 END IF
    IF ch = "U" THEN RETURN 21 END IF
    IF ch = "u" THEN RETURN 21 END IF
    IF ch = "V" THEN RETURN 22 END IF
    IF ch = "v" THEN RETURN 22 END IF
    IF ch = "W" THEN RETURN 23 END IF
    IF ch = "w" THEN RETURN 23 END IF
    IF ch = "X" THEN RETURN 24 END IF
    IF ch = "x" THEN RETURN 24 END IF
    IF ch = "Y" THEN RETURN 25 END IF
    IF ch = "y" THEN RETURN 25 END IF
    IF ch = "Z" THEN RETURN 26 END IF
    IF ch = "z" THEN RETURN 26 END IF
    RETURN 0
END FUNCTION

FUNCTION DOSINPUT_Number_Key(index_value AS U16) AS U16
    SELECT index_value
        CASE 0 => RETURN #DOSINPUT_K_0
        CASE 1 => RETURN #DOSINPUT_K_1
        CASE 2 => RETURN #DOSINPUT_K_2
        CASE 3 => RETURN #DOSINPUT_K_3
        CASE 4 => RETURN #DOSINPUT_K_4
        CASE 5 => RETURN #DOSINPUT_K_5
        CASE 6 => RETURN #DOSINPUT_K_6
        CASE 7 => RETURN #DOSINPUT_K_7
        CASE 8 => RETURN #DOSINPUT_K_8
        CASE ELSE => RETURN #DOSINPUT_K_9
    END SELECT
END FUNCTION

FUNCTION DOSINPUT_Left_Nav(left_key AS BOOL, alt_left_key AS BOOL) AS BOOL
    IF left_key THEN RETURN TRUE END IF
    IF alt_left_key THEN RETURN TRUE END IF
    RETURN FALSE
END FUNCTION

FUNCTION DOSINPUT_Right_Nav(right_key AS BOOL, alt_right_key AS BOOL) AS BOOL
    IF right_key THEN RETURN TRUE END IF
    IF alt_right_key THEN RETURN TRUE END IF
    RETURN FALSE
END FUNCTION

FUNCTION DOSINPUT_Up_Nav(up_key AS BOOL, alt_up_key AS BOOL) AS BOOL
    IF up_key THEN RETURN TRUE END IF
    IF alt_up_key THEN RETURN TRUE END IF
    RETURN FALSE
END FUNCTION

FUNCTION DOSINPUT_Down_Nav(down_key AS BOOL, alt_down_key AS BOOL) AS BOOL
    IF down_key THEN RETURN TRUE END IF
    IF alt_down_key THEN RETURN TRUE END IF
    RETURN FALSE
END FUNCTION

FUNCTION DOSINPUT_Confirm_Action(confirm_key AS BOOL, alt_confirm_key AS BOOL) AS BOOL
    IF confirm_key THEN RETURN TRUE END IF
    IF alt_confirm_key THEN RETURN TRUE END IF
    RETURN FALSE
END FUNCTION

FUNCTION DOSINPUT_Cancel_Action(cancel_key AS BOOL) AS BOOL
    IF cancel_key THEN RETURN TRUE END IF
    RETURN FALSE
END FUNCTION

FUNCTION DOSINPUT_Menu_Choice_1_To_9(k1 AS BOOL, k2 AS BOOL, k3 AS BOOL, k4 AS BOOL, k5 AS BOOL, k6 AS BOOL, k7 AS BOOL, k8 AS BOOL, k9 AS BOOL) AS U16
    IF k1 THEN RETURN 1 END IF
    IF k2 THEN RETURN 2 END IF
    IF k3 THEN RETURN 3 END IF
    IF k4 THEN RETURN 4 END IF
    IF k5 THEN RETURN 5 END IF
    IF k6 THEN RETURN 6 END IF
    IF k7 THEN RETURN 7 END IF
    IF k8 THEN RETURN 8 END IF
    IF k9 THEN RETURN 9 END IF
    RETURN 0
END FUNCTION
