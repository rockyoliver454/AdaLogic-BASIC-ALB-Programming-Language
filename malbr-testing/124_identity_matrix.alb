-- 124 | Identity matrix
BEGIN
    STRICT m[4,4] AS S32;
    LET i AS S32 = 0;
    LET j AS S32 = 0;
    FOR i = 0 TO 3
        FOR j = 0 TO 3
            IF i = j THEN
                m[i,j] = 1;
            ELSE
                m[i,j] = 0;
            END IF
        END FOR
    END FOR
    FOR i = 0 TO 3
        PRINT$ m[i,0] | " " | m[i,1] | " " | m[i,2] | " " | m[i,3];
    END FOR
END
