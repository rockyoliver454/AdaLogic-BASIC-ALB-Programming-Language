-- 154 | Letter frequency -- count a-z occurrences in a fixed text
BEGIN
    LET msg AS STRING = "the quick brown fox jumps over the lazy dog"
    STRICT freq[26] AS S32;
    LET i AS S32 = 0
    FOR i = 0 TO LEN(msg) - 1
        LET c AS S32 = ASC(MID$(msg, i + 1, 1))
        IF c >= 97 AND c <= 122 THEN
            freq[c - 97] = freq[c - 97] + 1
        END IF
    END FOR
    FOR i = 0 TO 25
        IF freq[i] > 0 THEN
            PRINT$ CHR(i + 97) | "=" | freq[i]
        END IF
    END FOR
END
