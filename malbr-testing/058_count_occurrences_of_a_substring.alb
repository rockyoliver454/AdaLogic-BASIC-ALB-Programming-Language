-- 058 | Count occurrences of a substring -- sliding window with MID$
BEGIN
    LET hay AS STRING = "the quick brown fox jumps over the lazy dog, the end"
    LET needle AS STRING = "the"
    LET count AS S32 = 0
    LET i AS S32 = 0
    FOR i = 0 TO LEN(hay) - LEN(needle)
        IF MID$(hay, i + 1, LEN(needle)) = needle THEN
            count = count + 1
        END IF
    END FOR
    PRINT count
END
