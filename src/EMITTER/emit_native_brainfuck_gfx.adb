   procedure Emit_Message_Loop (Success : out Boolean) is
      S : Boolean := True;
   begin
      Active_Gfx := Gfx_Code;
      Gfx_Line ("alb_bf_gui_loop:", S);
      -- Win64: callee entry has RSP%16==8. sub 40 (==8 mod 16) restores
      -- RSP%16==0 for nested calls AND leaves [rsp+32] home for SDL varargs.
      -- (sub 128 keeps RSP misaligned → PollEvent then RenderClear AVs.)
      Gfx_Line ("  sub rsp, 40", S);
      Emit_Gfx_Message_Loop_Lines (S);
      Message_Loop_Emitted := S;
      Success := S;
   end Emit_Message_Loop;

   procedure Begin_On_Handler (Name : String; Success : out Boolean) is
      S : Boolean := True;
   begin
      Active_Gfx := Gfx_Code;
      Gfx_Newline (S);
      Gfx_Line ("; --- ALBB dual-emitted event handler (FASM in companion) ---", S);
      Gfx_Line (Name & ":", S);
      Gfx_Line ("  push rbx", S);
      Gfx_Line ("  sub rsp, 32", S);
      In_On_Handler := True;
      if Name = "ALB_ON_TICK" then
         On_Tick_Emitted := True;
      elsif Name = "ALB_ON_PAINT" then
         On_Paint_Emitted := True;
      elsif Name = "ALB_ON_EVENT" then
         On_Event_Emitted := True;
      end if;
      Success := S;
   end Begin_On_Handler;

   procedure End_On_Handler (Name : String; Success : out Boolean) is
      S : Boolean := True;
      pragma Unreferenced (Name);
   begin
      Active_Gfx := Gfx_Code;
      Gfx_Line ("  add rsp, 32", S);
      Gfx_Line ("  pop rbx", S);
      Gfx_Line ("  ret", S);
      Gfx_Newline (S);
      In_On_Handler := False;
      Success := S;
   end End_On_Handler;

   procedure Emit_Handler_Imm_Call
     (Callee : String; Imm_Hex : String; Success : out Boolean)
   is
      S : Boolean := True;
   begin
      if not In_On_Handler then
         Success := True;
         return;
      end if;
      Active_Gfx := Gfx_Code;
      Gfx_Line ("  mov rcx, " & Imm_Hex, S);
      Gfx_Line ("  call " & Callee, S);
      Success := S;
   end Emit_Handler_Imm_Call;

   procedure Emit_Handler_Current_Color_Clear (Success : out Boolean) is
      S : Boolean := True;
   begin
      if not In_On_Handler then
         Success := True;
         return;
      end if;
      Active_Gfx := Gfx_Code;
      -- CLEAR with no arg: use current draw color as clear color.
      Gfx_Line ("  mov rcx, qword [ALB_Current_Color]", S);
      Gfx_Line ("  call ALB_Set_Clear_Color", S);
      Success := S;
   end Emit_Handler_Current_Color_Clear;

   procedure Emit_Win32_Color_BGR (Color_Hex : String; Success : out Boolean) is
      S : Boolean := True;
   begin
      Gfx_Append ("0x", S);
      Gfx_Append (Color_Hex, S);
      Success := S;
   end Emit_Win32_Color_BGR;

   procedure Emit_Print_Function_Start (Success : out Boolean) is
      S : Boolean := True;
   begin
      Gfx_Append ("invoke printf, ", S);
      Success := S;
   end Emit_Print_Function_Start;

   procedure Emit_Put_Pixel_Fasm (Success : out Boolean) is
      S : Boolean := True;
   begin
      Active_Gfx := Gfx_Code;
      Gfx_Line ("; PUT_PIXEL — tape GFX_X/Y/COLOR -> ALB_Put_Pixel", S);
      Gfx_Line ("  movzx ecx, byte [tape + 65001]", S);
      Gfx_Line ("  movzx edx, byte [tape + 65002]", S);
      Gfx_Line ("  movzx eax, byte [tape + 65005]", S);
      Gfx_Line ("  mov qword [ALB_Current_Color], rax", S);
      Gfx_Line ("  call ALB_Put_Pixel", S);
      Success := S;
   end Emit_Put_Pixel_Fasm;

