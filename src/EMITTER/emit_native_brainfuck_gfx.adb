   function Companion_Fasm_Path (BF_File_Path : String) return String is
   begin
      return BF_File_Path & ".fasm";
   end Companion_Fasm_Path;

   procedure Write_BF_As_Db
     (File : Ada.Text_IO.File_Type; BF_Source : String)
   is
      Col : Natural := 0;
      Started : Boolean := False;
   begin
      for I in BF_Source'Range loop
         case BF_Source (I) is
            when '>' | '<' | '+' | '-' | '.' | ',' | '[' | ']' =>
               if not Started then
                  Ada.Text_IO.Put (File, "  db '");
                  Started := True;
                  Col := 0;
               end if;
               Ada.Text_IO.Put (File, BF_Source (I));
               Col := Col + 1;
               if Col >= 64 then
                  Ada.Text_IO.Put_Line (File, "'");
                  Started := False;
               end if;
            when others =>
               null;
         end case;
      end loop;
      if Started then
         Ada.Text_IO.Put_Line (File, "'");
      end if;
   end Write_BF_As_Db;

   procedure Write_Companion_Fasm
     (BF_File_Path : String;
      BF_Part_A    : String;
      BF_Part_B    : String;
      Success      : out Boolean)
   is
      File : Ada.Text_IO.File_Type;
      Path : constant String := Companion_Fasm_Path (BF_File_Path);
      Embed_BF : constant Boolean :=
        not Omit_BF_Payload
        and then (BF_Part_A'Length + BF_Part_B'Length) > 0
        and then (BF_Part_A'Length + BF_Part_B'Length) < 2_000_000;
   begin
      Success := True;
      begin
         Ada.Text_IO.Create (File, Ada.Text_IO.Out_File, Path);
         Ada.Text_IO.Put_Line (File, "; ==========================================================");
         Ada.Text_IO.Put_Line (File, "; ALBB graphics companion — PE64 GUI + SDL3");
         Ada.Text_IO.Put_Line (File, "; Generated beside " & BF_File_Path);
         Ada.Text_IO.Put_Line (File, "; Entry: SDL init → window → message loop (BF is NOT main).");
         Ada.Text_IO.Put_Line (File, "; Tape GFX ports: 65000=CMD 65001=X 65002=Y 65003=W 65004=H");
         Ada.Text_IO.Put_Line (File, ";   65005=COLOR 65009=KEY 65010=MX 65011=MY 65012=MBTN");
         if not Embed_BF then
            Ada.Text_IO.Put_Line (File, "; BF payload omitted (Omit_BF_Payload or oversized).");
         end if;
         Ada.Text_IO.Put_Line (File, "; ==========================================================");
         Ada.Text_IO.Put_Line (File, "format PE64 GUI");
         Ada.Text_IO.Put_Line (File, "entry start");
         Ada.Text_IO.Put_Line (File, "stack 100000h,100000h");
         Ada.Text_IO.Put_Line (File, "heap 100000h,100000h");
         Ada.Text_IO.Put_Line (File, "include 'win64a.inc'");
         Ada.Text_IO.Put_Line (File, "");
         Ada.Text_IO.Put_Line (File, "section '.data' data readable writeable");
         Ada.Text_IO.Put_Line (File, "  ALB_Fmt_Str db '%s', 10, 0");
         Ada.Text_IO.Put_Line (File, "  ALB_Running dq 1");
         Ada.Text_IO.Put_Line (File, "  ALB_Window dq 0");
         Ada.Text_IO.Put_Line (File, "  ALB_Renderer dq 0");
         Ada.Text_IO.Put_Line (File, "  ALB_Foreign_Load_Path rb 1024");
         Ada.Text_IO.Put_Line (File, "  ALB_Empty_Str db 0");
         Ada.Text_IO.Put_Line (File, "  hStdIn dq 0");
         Ada.Text_IO.Put_Line (File, "  hStdOut dq 0");
         Ada.Text_IO.Put_Line (File, "  ioCount dd 0");
         Ada.Text_IO.Put_Line (File, "  oneByte db 0");
         Ada.Text_IO.Put_Line (File, "");
         Ada.Text_IO.Put (File, Gfx_Data_Buf (1 .. Gfx_Data_Len));
         Ada.Text_IO.Put_Line (File, "");
         Ada.Text_IO.Put_Line (File, "bf_program:");
         if Embed_BF then
            Write_BF_As_Db (File, BF_Part_A);
            Write_BF_As_Db (File, BF_Part_B);
         end if;
         Ada.Text_IO.Put_Line (File, "  db 0");
         Ada.Text_IO.Put_Line (File, "bf_program_end:");
         Ada.Text_IO.Put_Line (File, "");
         -- Keep the BF tape in .data. A separate '.bss' before '.text' made FASM
         -- assign overlapping file offsets for BSS and code (loader mapped tape
         -- over .text → AV inside SDL_Init).
         Ada.Text_IO.Put_Line (File, "  tape rb 65536");
         Ada.Text_IO.Put_Line (File, "");
         Ada.Text_IO.Put_Line (File, "section '.text' code readable executable");
         Ada.Text_IO.Put_Line (File, "");
         -- Emit Load_Foreign before Gfx code so ALB_SDL_Load_Proc never
         -- forward-references across the multi-KB helper blob.
         Ada.Text_IO.Put_Line (File, "ALB_Load_Foreign_Symbol:");
         Ada.Text_IO.Put_Line (File, "  push rbx");
         Ada.Text_IO.Put_Line (File, "  push rdi");
         Ada.Text_IO.Put_Line (File, "  sub rsp, 32");
         Ada.Text_IO.Put_Line (File, "  mov rbx, rdx");
         Ada.Text_IO.Put_Line (File, "  mov rdi, rcx");
         Ada.Text_IO.Put_Line (File, "  mov rcx, rdi");
         Ada.Text_IO.Put_Line (File, "  call [LoadLibraryA]");
         Ada.Text_IO.Put_Line (File, "  test rax, rax");
         Ada.Text_IO.Put_Line (File, "  jz .fail");
         Ada.Text_IO.Put_Line (File, "  mov rcx, rax");
         Ada.Text_IO.Put_Line (File, "  mov rdx, rbx");
         Ada.Text_IO.Put_Line (File, "  call [GetProcAddress]");
         Ada.Text_IO.Put_Line (File, "  add rsp, 32");
         Ada.Text_IO.Put_Line (File, "  pop rdi");
         Ada.Text_IO.Put_Line (File, "  pop rbx");
         Ada.Text_IO.Put_Line (File, "  ret");
         Ada.Text_IO.Put_Line (File, ".fail:");
         Ada.Text_IO.Put_Line (File, "  xor rax, rax");
         Ada.Text_IO.Put_Line (File, "  add rsp, 32");
         Ada.Text_IO.Put_Line (File, "  pop rdi");
         Ada.Text_IO.Put_Line (File, "  pop rbx");
         Ada.Text_IO.Put_Line (File, "  ret");
         Ada.Text_IO.Put_Line (File, "");
         Ada.Text_IO.Put (File, Gfx_Code_Buf (1 .. Gfx_Code_Len));
         Ada.Text_IO.Put_Line (File, "");
         -- ALB_Delay is emitted by Emit_SDL3_Runtime_Support when graphics are
         -- active; only emit the Sleep-based fallback when SDL3 runtime was not.
         if not SDL3_Runtime_Emitted then
            Ada.Text_IO.Put_Line (File, "ALB_Delay:");
            Ada.Text_IO.Put_Line (File, "  sub rsp, 40");
            Ada.Text_IO.Put_Line (File, "  invoke Sleep, rcx");
            Ada.Text_IO.Put_Line (File, "  add rsp, 40");
            Ada.Text_IO.Put_Line (File, "  ret");
            Ada.Text_IO.Put_Line (File, "");
         end if;
         -- Empty-but-valid ON stubs only when dual-emit did not define them.
         if not On_Tick_Emitted then
            Ada.Text_IO.Put_Line (File, "ALB_ON_TICK:");
            Ada.Text_IO.Put_Line (File, "  ret");
         end if;
         if not On_Paint_Emitted then
            Ada.Text_IO.Put_Line (File, "ALB_ON_PAINT:");
            Ada.Text_IO.Put_Line (File, "  ret");
         end if;
         if not On_Event_Emitted then
            Ada.Text_IO.Put_Line (File, "ALB_ON_EVENT:");
            Ada.Text_IO.Put_Line (File, "  ret");
         end if;
         Ada.Text_IO.Put_Line (File, "");
         if not Message_Loop_Emitted then
            -- CREATE_WINDOW without LISTEN: keep a stable SDL pump so the
            -- window stays alive (no BF-as-main).
            Ada.Text_IO.Put_Line (File, "alb_bf_gui_loop:");
            Ada.Text_IO.Put_Line (File, "  sub rsp, 40");
            Ada.Text_IO.Put_Line (File, "  mov qword [ALB_Running], 1");
            Ada.Text_IO.Put_Line (File, ".alb_bf_idle:");
            Ada.Text_IO.Put_Line (File, "  cmp qword [ALB_Running], 0");
            Ada.Text_IO.Put_Line (File, "  je .alb_bf_idle_done");
            Ada.Text_IO.Put_Line (File, "  cmp qword [ALB_Renderer], 0");
            Ada.Text_IO.Put_Line (File, "  je .alb_bf_idle_sleep");
            Ada.Text_IO.Put_Line (File, "  lea rcx, [ALB_Event_Buffer]");
            Ada.Text_IO.Put_Line (File, "  mov rax, qword [ALB_SDL_PollEvent]");
            Ada.Text_IO.Put_Line (File, "  test rax, rax");
            Ada.Text_IO.Put_Line (File, "  jz .alb_bf_idle_sleep");
            Ada.Text_IO.Put_Line (File, "  call rax");
            Ada.Text_IO.Put_Line (File, "  cmp dword [ALB_Event_Buffer], 0x100");
            Ada.Text_IO.Put_Line (File, "  je .alb_bf_idle_done");
            Ada.Text_IO.Put_Line (File, "  call ALB_ON_TICK");
            Ada.Text_IO.Put_Line (File, "  call ALB_ON_PAINT");
            Ada.Text_IO.Put_Line (File, "  mov rcx, qword [ALB_Renderer]");
            Ada.Text_IO.Put_Line (File, "  mov rax, qword [ALB_SDL_RenderPresent]");
            Ada.Text_IO.Put_Line (File, "  test rax, rax");
            Ada.Text_IO.Put_Line (File, "  jz .alb_bf_idle_sleep");
            Ada.Text_IO.Put_Line (File, "  call rax");
            Ada.Text_IO.Put_Line (File, ".alb_bf_idle_sleep:");
            Ada.Text_IO.Put_Line (File, "  mov ecx, 16");
            Ada.Text_IO.Put_Line (File, "  call [Sleep]");
            Ada.Text_IO.Put_Line (File, "  jmp .alb_bf_idle");
            Ada.Text_IO.Put_Line (File, ".alb_bf_idle_done:");
            Ada.Text_IO.Put_Line (File, "  add rsp, 40");
            Ada.Text_IO.Put_Line (File, "  ret");
            Ada.Text_IO.Put_Line (File, "");
         end if;
         -- Optional BF interpreter (not called at startup). Bound-check tape;
         -- GFX ports dispatch Put_Pixel only. Kept for diagnostic hosts.
         Ada.Text_IO.Put_Line (File, "; --- BF interpreter with GFX port dispatch (optional) ---");
         Ada.Text_IO.Put_Line (File, "bf_dispatch_gfx:");
         Ada.Text_IO.Put_Line (File, "  sub rsp, 40");
         Ada.Text_IO.Put_Line (File, "  movzx eax, byte [tape + 65000]");
         Ada.Text_IO.Put_Line (File, "  test eax, eax");
         Ada.Text_IO.Put_Line (File, "  jz .done");
         Ada.Text_IO.Put_Line (File, "  cmp al, 1");
         Ada.Text_IO.Put_Line (File, "  jne .clr");
         Ada.Text_IO.Put_Line (File, "  movzx ecx, byte [tape + 65001]");
         Ada.Text_IO.Put_Line (File, "  movzx edx, byte [tape + 65002]");
         Ada.Text_IO.Put_Line (File, "  movzx eax, byte [tape + 65005]");
         Ada.Text_IO.Put_Line (File, "  mov qword [ALB_Current_Color], rax");
         Ada.Text_IO.Put_Line (File, "  call ALB_Put_Pixel");
         Ada.Text_IO.Put_Line (File, ".clr:");
         Ada.Text_IO.Put_Line (File, "  mov byte [tape + 65000], 0");
         Ada.Text_IO.Put_Line (File, ".done:");
         Ada.Text_IO.Put_Line (File, "  add rsp, 40");
         Ada.Text_IO.Put_Line (File, "  ret");
         Ada.Text_IO.Put_Line (File, "");
         Ada.Text_IO.Put_Line (File, "alb_bf_run_slice:");
         Ada.Text_IO.Put_Line (File, "bf_interpret:");
         Ada.Text_IO.Put_Line (File, "  push rbx");
         Ada.Text_IO.Put_Line (File, "  push rsi");
         Ada.Text_IO.Put_Line (File, "  push rdi");
         Ada.Text_IO.Put_Line (File, "  sub rsp, 40");
         Ada.Text_IO.Put_Line (File, "  lea rbx, [tape]");
         Ada.Text_IO.Put_Line (File, "  lea rsi, [bf_program]");
         Ada.Text_IO.Put_Line (File, ".loop:");
         Ada.Text_IO.Put_Line (File, "  mov al, byte [rsi]");
         Ada.Text_IO.Put_Line (File, "  test al, al");
         Ada.Text_IO.Put_Line (File, "  jz .done");
         Ada.Text_IO.Put_Line (File, "  cmp al, '>'");
         Ada.Text_IO.Put_Line (File, "  jne .lt");
         Ada.Text_IO.Put_Line (File, "  inc rbx");
         Ada.Text_IO.Put_Line (File, "  lea rax, [tape + 65535]");
         Ada.Text_IO.Put_Line (File, "  cmp rbx, rax");
         Ada.Text_IO.Put_Line (File, "  jbe .adv");
         Ada.Text_IO.Put_Line (File, "  lea rbx, [tape]");
         Ada.Text_IO.Put_Line (File, "  jmp .adv");
         Ada.Text_IO.Put_Line (File, ".lt:");
         Ada.Text_IO.Put_Line (File, "  cmp al, '<'");
         Ada.Text_IO.Put_Line (File, "  jne .plus");
         Ada.Text_IO.Put_Line (File, "  dec rbx");
         Ada.Text_IO.Put_Line (File, "  lea rax, [tape]");
         Ada.Text_IO.Put_Line (File, "  cmp rbx, rax");
         Ada.Text_IO.Put_Line (File, "  jae .adv");
         Ada.Text_IO.Put_Line (File, "  lea rbx, [tape + 65535]");
         Ada.Text_IO.Put_Line (File, "  jmp .adv");
         Ada.Text_IO.Put_Line (File, ".plus:");
         Ada.Text_IO.Put_Line (File, "  cmp al, '+'");
         Ada.Text_IO.Put_Line (File, "  jne .minus");
         Ada.Text_IO.Put_Line (File, "  inc byte [rbx]");
         Ada.Text_IO.Put_Line (File, "  jmp .adv");
         Ada.Text_IO.Put_Line (File, ".minus:");
         Ada.Text_IO.Put_Line (File, "  cmp al, '-'");
         Ada.Text_IO.Put_Line (File, "  jne .dot");
         Ada.Text_IO.Put_Line (File, "  dec byte [rbx]");
         Ada.Text_IO.Put_Line (File, "  jmp .adv");
         Ada.Text_IO.Put_Line (File, ".dot:");
         Ada.Text_IO.Put_Line (File, "  cmp al, '.'");
         Ada.Text_IO.Put_Line (File, "  jne .comma");
         Ada.Text_IO.Put_Line (File, "  movzx eax, byte [rbx]");
         Ada.Text_IO.Put_Line (File, "  mov [oneByte], al");
         Ada.Text_IO.Put_Line (File, "  invoke WriteFile, [hStdOut], oneByte, 1, ioCount, 0");
         Ada.Text_IO.Put_Line (File, "  jmp .adv");
         Ada.Text_IO.Put_Line (File, ".comma:");
         Ada.Text_IO.Put_Line (File, "  cmp al, ','");
         Ada.Text_IO.Put_Line (File, "  jne .lbr");
         Ada.Text_IO.Put_Line (File, "  invoke ReadFile, [hStdIn], oneByte, 1, ioCount, 0");
         Ada.Text_IO.Put_Line (File, "  cmp dword [ioCount], 0");
         Ada.Text_IO.Put_Line (File, "  je .adv");
         Ada.Text_IO.Put_Line (File, "  mov al, [oneByte]");
         Ada.Text_IO.Put_Line (File, "  mov [rbx], al");
         Ada.Text_IO.Put_Line (File, "  jmp .adv");
         Ada.Text_IO.Put_Line (File, ".lbr:");
         Ada.Text_IO.Put_Line (File, "  cmp al, '['");
         Ada.Text_IO.Put_Line (File, "  jne .rbr");
         Ada.Text_IO.Put_Line (File, "  cmp byte [rbx], 0");
         Ada.Text_IO.Put_Line (File, "  jne .adv");
         Ada.Text_IO.Put_Line (File, "  mov ecx, 1");
         Ada.Text_IO.Put_Line (File, ".skip_fwd:");
         Ada.Text_IO.Put_Line (File, "  inc rsi");
         Ada.Text_IO.Put_Line (File, "  mov al, byte [rsi]");
         Ada.Text_IO.Put_Line (File, "  test al, al");
         Ada.Text_IO.Put_Line (File, "  jz .done");
         Ada.Text_IO.Put_Line (File, "  cmp al, '['");
         Ada.Text_IO.Put_Line (File, "  jne .sf2");
         Ada.Text_IO.Put_Line (File, "  inc ecx");
         Ada.Text_IO.Put_Line (File, "  jmp .skip_fwd");
         Ada.Text_IO.Put_Line (File, ".sf2:");
         Ada.Text_IO.Put_Line (File, "  cmp al, ']'");
         Ada.Text_IO.Put_Line (File, "  jne .skip_fwd");
         Ada.Text_IO.Put_Line (File, "  dec ecx");
         Ada.Text_IO.Put_Line (File, "  jnz .skip_fwd");
         Ada.Text_IO.Put_Line (File, "  jmp .adv");
         Ada.Text_IO.Put_Line (File, ".rbr:");
         Ada.Text_IO.Put_Line (File, "  cmp al, ']'");
         Ada.Text_IO.Put_Line (File, "  jne .adv");
         Ada.Text_IO.Put_Line (File, "  cmp byte [rbx], 0");
         Ada.Text_IO.Put_Line (File, "  je .adv");
         Ada.Text_IO.Put_Line (File, "  mov ecx, 1");
         Ada.Text_IO.Put_Line (File, ".skip_back:");
         Ada.Text_IO.Put_Line (File, "  dec rsi");
         Ada.Text_IO.Put_Line (File, "  mov al, byte [rsi]");
         Ada.Text_IO.Put_Line (File, "  cmp al, ']'");
         Ada.Text_IO.Put_Line (File, "  jne .sb2");
         Ada.Text_IO.Put_Line (File, "  inc ecx");
         Ada.Text_IO.Put_Line (File, "  jmp .skip_back");
         Ada.Text_IO.Put_Line (File, ".sb2:");
         Ada.Text_IO.Put_Line (File, "  cmp al, '['");
         Ada.Text_IO.Put_Line (File, "  jne .skip_back");
         Ada.Text_IO.Put_Line (File, "  dec ecx");
         Ada.Text_IO.Put_Line (File, "  jnz .skip_back");
         Ada.Text_IO.Put_Line (File, "  jmp .adv");
         Ada.Text_IO.Put_Line (File, ".adv:");
         Ada.Text_IO.Put_Line (File, "  call bf_dispatch_gfx");
         Ada.Text_IO.Put_Line (File, "  inc rsi");
         Ada.Text_IO.Put_Line (File, "  jmp .loop");
         Ada.Text_IO.Put_Line (File, ".done:");
         Ada.Text_IO.Put_Line (File, "  add rsp, 40");
         Ada.Text_IO.Put_Line (File, "  pop rdi");
         Ada.Text_IO.Put_Line (File, "  pop rsi");
         Ada.Text_IO.Put_Line (File, "  pop rbx");
         Ada.Text_IO.Put_Line (File, "  ret");
         Ada.Text_IO.Put_Line (File, "");
         -- PE entry: align then SDL init + GUI loop. BF is NOT main.
         Ada.Text_IO.Put_Line (File, "start:");
         Ada.Text_IO.Put_Line (File, "  sub rsp, 8");
         Ada.Text_IO.Put_Line (File, "  mov rcx, -10");
         Ada.Text_IO.Put_Line (File, "  call [GetStdHandle]");
         Ada.Text_IO.Put_Line (File, "  mov [hStdIn], rax");
         Ada.Text_IO.Put_Line (File, "  mov rcx, -11");
         Ada.Text_IO.Put_Line (File, "  call [GetStdHandle]");
         Ada.Text_IO.Put_Line (File, "  mov [hStdOut], rax");
         Ada.Text_IO.Put_Line (File, "  call alb_sdl3_init_start");
         Ada.Text_IO.Put_Line (File, "  call alb_bf_gui_loop");
         Ada.Text_IO.Put_Line (File, "  xor ecx, ecx");
         Ada.Text_IO.Put_Line (File, "  call [ExitProcess]");
         Ada.Text_IO.Put_Line (File, "");
         Ada.Text_IO.Put_Line (File, "section '.idata' import data readable writeable");
         -- Ada string literals treat '\' as a literal character (not C-style escape).
         Ada.Text_IO.Put_Line (File, "  library kernel32,'KERNEL32.DLL',\");
         Ada.Text_IO.Put_Line (File, "          msvcrt,'MSVCRT.DLL'");
         Ada.Text_IO.Put_Line (File, "  import kernel32,\");
         Ada.Text_IO.Put_Line (File, "    ExitProcess,'ExitProcess',\");
         Ada.Text_IO.Put_Line (File, "    GetStdHandle,'GetStdHandle',\");
         Ada.Text_IO.Put_Line (File, "    ReadFile,'ReadFile',\");
         Ada.Text_IO.Put_Line (File, "    WriteFile,'WriteFile',\");
         Ada.Text_IO.Put_Line (File, "    LoadLibraryA,'LoadLibraryA',\");
         Ada.Text_IO.Put_Line (File, "    GetProcAddress,'GetProcAddress',\");
         Ada.Text_IO.Put_Line (File, "    Sleep,'Sleep'");
         Ada.Text_IO.Put_Line (File, "  import msvcrt,\");
         Ada.Text_IO.Put_Line (File, "    printf,'printf'");
         Ada.Text_IO.Close (File);
      exception
         when others =>
            Success := False;
      end;
   end Write_Companion_Fasm;

end Emit_Native_Brainfuck_Gfx;
