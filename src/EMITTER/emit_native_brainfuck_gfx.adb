   procedure Emit_Window_Creation (Title : String; Success : out Boolean) is
      S : Boolean := True;
      N : Natural;
   begin
      Graphics_Used := True;
      N := Natural'Min (Title'Length, Max_Title);
      Window_Title (1 .. N) := Title (Title'First .. Title'First + N - 1);
      Window_Title_Len := N;

      Active_Gfx := Gfx_Data;
      Emit_Window_Data_Decls (S);
      if S then
         Gfx_Append ("  ALB_Window_Title db '", S);
         Gfx_Append (Window_Title (1 .. Window_Title_Len), S);
         Gfx_Line ("',0", S);
      end if;
      if S then
         Emit_SDL3_Runtime_Support (S);
      end if;
      -- Emit_SDL3 switches Active_Gfx to Gfx_Code after its data decls.
      Active_Gfx := Gfx_Code;
      if S then
         -- Boot via raw LoadLibrary/GetProcAddress. Calling SDL_Init through
         -- ALB_Init_SDL3-bound pointers AVs in the companion PE; raw boot works.
         Gfx_Line ("alb_sdl3_init_start:", S);
         Gfx_Line ("sub rsp, 8", S);
         Gfx_Line ("sub rsp, 32", S);
         Gfx_Line ("lea rcx, [ALB_SDL3_Lib]", S);
         Gfx_Line ("call [LoadLibraryA]", S);
         Gfx_Line ("test rax, rax", S);
         Gfx_Line ("jz .alb_boot_fail", S);
         Gfx_Line ("mov qword [ALB_Foreign_Load_Path], rax", S);
         Gfx_Line ("mov rcx, rax", S);
         Gfx_Line ("lea rdx, [ALB_SDL_Init_Name]", S);
         Gfx_Line ("call [GetProcAddress]", S);
         Gfx_Line ("test rax, rax", S);
         Gfx_Line ("jz .alb_boot_fail", S);
         Gfx_Line ("mov qword [ALB_SDL_Init], rax", S);
         Gfx_Line ("mov ecx, 0x00000020", S);
         Gfx_Line ("call rax", S);
         Gfx_Line ("test al, al", S);
         Gfx_Line ("jz .alb_boot_fail", S);
         Gfx_Line ("add rsp, 32", S);
         Gfx_Line ("call ALB_Init_SDL3", S);
         Gfx_Line ("test eax, eax", S);
         Gfx_Line ("jz .alb_boot_fail_nobase", S);
         Gfx_Line ("sub rsp, 48", S);
         Gfx_Line ("lea rcx, [ALB_Window_Title]", S);
         Gfx_Line ("mov edx, dword [ALB_Screen_Width]", S);
         Gfx_Line ("mov r8d, dword [ALB_Screen_Height]", S);
         Gfx_Line ("xor r9d, r9d", S);
         Gfx_Line ("lea rax, [ALB_Window]", S);
         Gfx_Line ("mov qword [rsp + 32], rax", S);
         Gfx_Line ("lea rax, [ALB_Renderer]", S);
         Gfx_Line ("mov qword [rsp + 40], rax", S);
         Gfx_Line ("mov rax, qword [ALB_SDL_CreateWindowAndRenderer]", S);
         Gfx_Line ("call rax", S);
         Gfx_Line ("test al, al", S);
         Gfx_Line ("jnz .alb_sdl_window_ok", S);
         Gfx_Line ("add rsp, 48", S);
         Gfx_Line ("jmp .alb_boot_fail_nobase", S);
         Gfx_Line (".alb_sdl_window_ok:", S);
         Gfx_Line ("mov rax, qword [ALB_Screen_Width]", S);
         Gfx_Line ("mov qword [ALB_Virtual_Width], rax", S);
         Gfx_Line ("mov rax, qword [ALB_Screen_Height]", S);
         Gfx_Line ("mov qword [ALB_Virtual_Height], rax", S);
         Gfx_Line ("add rsp, 48", S);
         Gfx_Line ("add rsp, 8", S);
         Gfx_Line ("ret", S);
         Gfx_Line (".alb_boot_fail:", S);
         Gfx_Line ("add rsp, 32", S);
         Gfx_Line (".alb_boot_fail_nobase:", S);
         Gfx_Line ("mov ecx, 1", S);
         Gfx_Line ("call [ExitProcess]", S);
         Gfx_Newline (S);
         Emit_Gfx_Window_Helper_Lines (S);
      end if;
      Success := S;
   end Emit_Window_Creation;

