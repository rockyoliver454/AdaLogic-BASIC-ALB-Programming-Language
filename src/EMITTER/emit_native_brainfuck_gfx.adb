   procedure Emit_Gfx_Message_Loop_Lines (Success : in out Boolean) is
   begin
      Gfx_Line ("mov qword [ALB_Running], 1", Success);
      Gfx_Line ("cmp qword [ALB_Renderer], 0", Success);
      Gfx_Line ("jne .alb_gui_loop", Success);
      Gfx_Line (".alb_headless_loop:", Success);
      Gfx_Line ("cmp qword [ALB_Running], 0", Success);
      Gfx_Line ("je .end_loop", Success);
      Gfx_Line ("call ALB_ON_TICK", Success);
      Gfx_Line ("cmp qword [ALB_Running], 0", Success);
      Gfx_Line ("je .end_loop", Success);
      Gfx_Line ("mov ecx, 16", Success);
      Gfx_Line ("call ALB_Delay", Success);
      Gfx_Line ("jmp .alb_headless_loop", Success);
      Gfx_Newline (Success);
      Gfx_Line (".alb_gui_loop:", Success);
      Gfx_Line ("  .game_loop:", Success);
      Gfx_Line ("    cmp qword [ALB_Running], 0", Success);
      Gfx_Line ("    je .alb_sdl_shutdown", Success);
      Gfx_Line ("    mov dword [ALB_Mouse_Wheel], 0", Success);
      Gfx_Line ("    .msg_loop:", Success);
      Gfx_Line ("      lea rcx, [ALB_Event_Buffer]", Success);
      Gfx_Line ("      mov rax, qword [ALB_SDL_PollEvent]", Success);
      Gfx_Line ("      call rax", Success);
      Gfx_Line ("      test al, al", Success);
      Gfx_Line ("      jz .msg_done", Success);
      Gfx_Line ("      cmp dword [ALB_Event_Buffer], 0x100", Success);
      Gfx_Line ("      je .alb_sdl_shutdown", Success);
      Gfx_Line ("      cmp dword [ALB_Event_Buffer], 0x403", Success);
      Gfx_Line ("      jne .msg_loop", Success);
      Gfx_Line ("      cvttss2si eax, dword [ALB_Event_Buffer + 28]", Success);
      Gfx_Line ("      add dword [ALB_Mouse_Wheel], eax", Success);
      Gfx_Line ("      jmp .msg_loop", Success);
      Gfx_Line ("    .msg_done:", Success);
      Gfx_Newline (Success);
      Gfx_Line ("    call ALB_Update_Output_State", Success);
      Gfx_Line ("    call ALB_Update_Mouse_State", Success);
      Gfx_Newline (Success);
      Gfx_Line ("    call ALB_ON_EVENT", Success);
      Gfx_Line ("    cmp qword [ALB_Running], 0", Success);
      Gfx_Line ("    je .alb_sdl_shutdown", Success);
      Gfx_Newline (Success);
      Gfx_Line ("    call ALB_ON_TICK", Success);
      Gfx_Line ("    cmp qword [ALB_Running], 0", Success);
      Gfx_Line ("    je .alb_sdl_shutdown", Success);
      Gfx_Newline (Success);
      Gfx_Line ("    mov rcx, qword [ALB_Renderer]", Success);
      Gfx_Line ("    test rcx, rcx", Success);
      Gfx_Line ("    jz .skip_clear", Success);
      Gfx_Line ("    mov eax, dword [ALB_Clear_Color]", Success);
      Gfx_Line ("    mov edx, eax", Success);
      Gfx_Line ("    shr edx, 16", Success);
      Gfx_Line ("    and edx, 255", Success);
      Gfx_Line ("    mov r8d, eax", Success);
      Gfx_Line ("    shr r8d, 8", Success);
      Gfx_Line ("    and r8d, 255", Success);
      Gfx_Line ("    mov r9d, eax", Success);
      Gfx_Line ("    and r9d, 255", Success);
      Gfx_Line ("    mov dword [rsp + 32], 255", Success);
      Gfx_Line ("    mov rax, qword [ALB_SDL_SetRenderDrawColor]", Success);
      Gfx_Line ("    call rax", Success);
      Gfx_Line ("    mov rcx, qword [ALB_Renderer]", Success);
      Gfx_Line ("    mov rax, qword [ALB_SDL_RenderClear]", Success);
      Gfx_Line ("    call rax", Success);
      Gfx_Line ("    .skip_clear:", Success);
      Gfx_Newline (Success);
      Gfx_Line ("    call ALB_ON_PAINT", Success);
      Gfx_Newline (Success);
      Gfx_Line ("    mov rcx, qword [ALB_Renderer]", Success);
      Gfx_Line ("    test rcx, rcx", Success);
      Gfx_Line ("    jz .skip_present", Success);
      Gfx_Line ("    mov rax, qword [ALB_SDL_RenderPresent]", Success);
      Gfx_Line ("    call rax", Success);
      Gfx_Line ("    .skip_present:", Success);
      Gfx_Newline (Success);
      Gfx_Line ("    mov ecx, 16", Success);
      Gfx_Line ("    call ALB_Delay", Success);
      Gfx_Line ("    jmp .game_loop", Success);
      Gfx_Newline (Success);
      Gfx_Line (".alb_sdl_shutdown:", Success);
      Gfx_Line ("    mov rcx, qword [ALB_Renderer]", Success);
      Gfx_Line ("    test rcx, rcx", Success);
      Gfx_Line ("    jz .skip_renderer_destroy", Success);
      Gfx_Line ("    mov rax, qword [ALB_SDL_DestroyRenderer]", Success);
      Gfx_Line ("    call rax", Success);
      Gfx_Line ("    mov qword [ALB_Renderer], 0", Success);
      Gfx_Line ("    .skip_renderer_destroy:", Success);
      Gfx_Line ("    mov rcx, qword [ALB_Window]", Success);
      Gfx_Line ("    test rcx, rcx", Success);
      Gfx_Line ("    jz .skip_window_destroy", Success);
      Gfx_Line ("    mov rax, qword [ALB_SDL_DestroyWindow]", Success);
      Gfx_Line ("    call rax", Success);
      Gfx_Line ("    mov qword [ALB_Window], 0", Success);
      Gfx_Line ("    .skip_window_destroy:", Success);
      Gfx_Line ("    mov rcx, qword [ALB_Music_Stream]", Success);
      Gfx_Line ("    test rcx, rcx", Success);
      Gfx_Line ("    jz .skip_music_destroy", Success);
      Gfx_Line ("    mov rax, qword [ALB_SDL_DestroyAudioStream]", Success);
      Gfx_Line ("    call rax", Success);
      Gfx_Line ("    mov qword [ALB_Music_Stream], 0", Success);
      Gfx_Line ("    .skip_music_destroy:", Success);
      Gfx_Line ("    cmp qword [ALB_SDL_Quit], 0", Success);
      Gfx_Line ("    je .skip_sdl_quit", Success);
      Gfx_Line ("    mov rax, qword [ALB_SDL_Quit]", Success);
      Gfx_Line ("    call rax", Success);
      Gfx_Line ("    .skip_sdl_quit:", Success);
      Gfx_Line (".end_loop:", Success);
      -- Companion message loop is a callee (not inline in start). Must not fall
      -- through into ON stubs / BF interpreter — that AVs after quit or on
      -- accidental fallthrough. Exit the process cleanly.
      Gfx_Line ("  xor ecx, ecx", Success);
      Gfx_Line ("  call [ExitProcess]", Success);
   end Emit_Gfx_Message_Loop_Lines;



