pragma SPARK_Mode (Off);

with Ada.Text_IO;

package body Emit_Native_Brainfuck_Gfx is

   Max_Gfx_Size : constant Natural := 16_777_216;
   type Gfx_Target is (Gfx_Data, Gfx_Code);
   Active_Gfx   : Gfx_Target := Gfx_Data;
   Gfx_Data_Buf : String (1 .. Max_Gfx_Size) := (others => ' ');
   Gfx_Data_Len : Natural := 0;
   Gfx_Code_Buf : String (1 .. Max_Gfx_Size) := (others => ' ');
   Gfx_Code_Len : Natural := 0;

   Max_Title : constant Natural := 512;
   Window_Title : String (1 .. Max_Title) := (others => ' ');

   procedure Init is
   begin
      Gfx_Data_Len := 0;
      Gfx_Code_Len := 0;
      Active_Gfx := Gfx_Data;
      Graphics_Used := False;
      SDL3_Runtime_Emitted := False;
      Window_Title_Len := 0;
      Window_Title := (others => ' ');
      On_Tick_Emitted := False;
      On_Paint_Emitted := False;
      On_Event_Emitted := False;
      In_On_Handler := False;
      Message_Loop_Emitted := False;
      Screen_W := 800;
      Screen_H := 600;
      -- Omit_BF_Payload / Skip_Companion_Write are owned by albf (--build).
   end Init;

   procedure Set_Screen_Size (W, H : Natural) is
   begin
      if W > 0 then
         Screen_W := W;
      end if;
      if H > 0 then
         Screen_H := H;
      end if;
   end Set_Screen_Size;

   function Natural_Image_Trim (N : Natural) return String is
      Img : constant String := Natural'Image (N);
   begin
      if Img'Length > 0 and then Img (Img'First) = ' ' then
         return Img (Img'First + 1 .. Img'Last);
      end if;
      return Img;
   end Natural_Image_Trim;

   procedure Gfx_Append (Str : String; Success : in out Boolean) is
   begin
      if not Success then
         return;
      end if;
      if Active_Gfx = Gfx_Data then
         if Gfx_Data_Len + Str'Length <= Max_Gfx_Size then
            Gfx_Data_Buf (Gfx_Data_Len + 1 .. Gfx_Data_Len + Str'Length) := Str;
            Gfx_Data_Len := Gfx_Data_Len + Str'Length;
         else
            Success := False;
         end if;
      else
         if Gfx_Code_Len + Str'Length <= Max_Gfx_Size then
            Gfx_Code_Buf (Gfx_Code_Len + 1 .. Gfx_Code_Len + Str'Length) := Str;
            Gfx_Code_Len := Gfx_Code_Len + Str'Length;
         else
            Success := False;
         end if;
      end if;
   end Gfx_Append;

   procedure Gfx_Newline (Success : in out Boolean) is
   begin
      Gfx_Append (String'(1 => ASCII.LF), Success);
   end Gfx_Newline;

   procedure Gfx_Line (Text : String; Success : in out Boolean) is
   begin
      Gfx_Append (Text, Success);
      Gfx_Newline (Success);
   end Gfx_Line;

   procedure Emit_SDL_Decl
     (Stem : String; Symbol : String; Success : in out Boolean)
   is
   begin
      Gfx_Line ("  ALB_SDL_" & Stem & " dq 0", Success);
      Gfx_Line ("  ALB_SDL_" & Stem & "_Name db '" & Symbol & "',0", Success);
   end Emit_SDL_Decl;

   procedure Emit_SDL_Bind (Stem : String; Success : in out Boolean) is
   begin
      Gfx_Line ("  lea rcx, [ALB_SDL_" & Stem & "]", Success);
      Gfx_Line ("  lea rdx, [ALB_SDL_" & Stem & "_Name]", Success);
      Gfx_Line ("  call ALB_SDL_Load_Proc", Success);
      Gfx_Line ("  test rax, rax", Success);
      Gfx_Line ("  jz .fail", Success);
   end Emit_SDL_Bind;

   procedure Emit_SDL_Bind_Optional
     (Stem : String; Success : in out Boolean)
   is
   begin
      Gfx_Line ("  lea rcx, [ALB_SDL_" & Stem & "]", Success);
      Gfx_Line ("  lea rdx, [ALB_SDL_" & Stem & "_Name]", Success);
      Gfx_Line ("  call ALB_SDL_Load_Proc", Success);
   end Emit_SDL_Bind_Optional;

