      Add ("} catch (Exception ex) { throw new RuntimeException(ex); }");
      Decrease_Indent;
      Add ("}");
      Add ("private static void ALB_NET_SEND(long handle, Object src) {");
      Increase_Indent;
      Add ("try {");
      Increase_Indent;
      Add ("ALB_NetSocket sock = ALB_NET_TABLE.get(handle);");
      Add ("if (sock == null || sock.udp == null || sock.lastPeer == null) return;");
      Add ("int count = Math.min(ALB_ARRAY_COUNT(src), Math.max(1, sock.bufferSize));");
      Add ("byte[] payload = new byte[count];");
      Add ("for (int i = 0; i < count; i += 1) payload[i] = (byte) ALB_ARRAY_GET_LONG(src, i + 1);");
      Add ("java.net.DatagramPacket datagram = new java.net.DatagramPacket(payload, payload.length, sock.lastPeer);");
      Add ("sock.udp.send(datagram);");
      Decrease_Indent;
      Add ("} catch (Exception ex) { throw new RuntimeException(ex); }");
      Decrease_Indent;
      Add ("}");
      Add ("private static void ALB_NET_CLOSE(long[] handleRef) {");
      Increase_Indent;
      Add ("long handle = (handleRef != null && handleRef.length > 0) ? handleRef[0] : 0L;");
      Add ("if (handle <= 0L) return;");
      Add ("ALB_NetSocket sock = ALB_NET_TABLE.remove(handle);");
      Add ("if (sock != null && sock.udp != null) sock.udp.close();");
      Add ("if (handleRef != null && handleRef.length > 0) handleRef[0] = 0L;");
      Decrease_Indent;
      Add ("}");
      Add ("private static void ALB_LOCATE(long row) {");
      Increase_Indent;
      Add ("alb_text_cursor[0] = 0;");
      Add ("alb_text_cursor[1] = (int) row;");
      Decrease_Indent;
      Add ("}");
      Add ("private static void ALB_LOCATE(long row, long col) {");
      Increase_Indent;
      Add ("alb_text_cursor[0] = (int) col;");
      Add ("alb_text_cursor[1] = (int) row;");
      Decrease_Indent;
      Add ("}");
      Success := S;
   end Emit_Program_Start;

   procedure Emit_Program_End
     (Success : out Boolean) is
   begin
      Success := True;
   end Emit_Program_End;

   procedure Emit_Raw
     (Text    : String;
      Success : out Boolean) is
   begin
      Append_To_Current (Text, Success);
   end Emit_Raw;

   procedure Emit_Newline
     (Success : out Boolean) is
      LF : constant String := (1 => ASCII.LF);
   begin
      Append_To_Current (LF, Success);
   end Emit_Newline;

   procedure Emit_Indent
     (Success : out Boolean) is
      S : Boolean := True;
   begin
      for I in 1 .. Indent_Level loop
         Append_To_Current ("    ", S);
         exit when not S;
      end loop;
      Success := S;
   end Emit_Indent;

   procedure Increase_Indent is
   begin
      Indent_Level := Indent_Level + 1;
   end Increase_Indent;

   procedure Decrease_Indent is
   begin
      if Indent_Level > 0 then
         Indent_Level := Indent_Level - 1;
      end if;
   end Decrease_Indent;

   procedure Emit_Unsupported
     (Feature_Name : String;
      Success      : out Boolean) is
   begin
      Append_Line ("// TODO(flatjvm): " & Feature_Name, Success);
   end Emit_Unsupported;

   procedure Emit_Var_Decl
     (Name    : String;
      Tag     : ALB_Type_Tag;
      Success : out Boolean) is
      Saved_Buffer : constant Buffer_Target := Current_Buffer;
      Saved_Indent : constant Natural := Indent_Level;
      S            : Boolean := True;
      Slots_Image  : constant String := Trim_Image (Positive'Image (Java_Slot_Count (Tag)));
   begin
      Set_Active_Buffer (Buffer_Global);
      Append_Line
        ("private static final " & Java_Primitive_Name (Tag) & "[] " &
         Name & " = new " & Java_Primitive_Name (Tag) & "[" &
         Slots_Image & "];",
         S);
      Current_Buffer := Saved_Buffer;
      Indent_Level := Saved_Indent;
      Success := S;
   end Emit_Var_Decl;

   procedure Emit_Global_Var_Decl
     (Name    : String;
      Tag     : ALB_Type_Tag;
      Success : out Boolean) is
   begin
      Emit_Var_Decl (Name, Tag, Success);
   end Emit_Global_Var_Decl;

   procedure Emit_Strict_Array_Decl
     (Name       : String;
      Size_Bytes : Natural;
      Success    : out Boolean) is
      Saved_Buffer : constant Buffer_Target := Current_Buffer;
      Saved_Indent : constant Natural := Indent_Level;
      S            : Boolean := True;
      Size_Image   : constant String := Trim_Image (Natural'Image (Size_Bytes));
   begin
      Set_Active_Buffer (Buffer_Global);
      Append_Line
        ("private static final byte[] " & Name & " = new byte[" & Size_Image & "];",
         S);
      Current_Buffer := Saved_Buffer;
      Indent_Level := Saved_Indent;
      Success := S;
   end Emit_Strict_Array_Decl;

   procedure Emit_Slide_Array_Decl
     (Name      : String;
      Max_Bytes : Natural;
      Success   : out Boolean) is
      Saved_Buffer : constant Buffer_Target := Current_Buffer;
      Saved_Indent : constant Natural := Indent_Level;
      S            : Boolean := True;
      Size_Image   : constant String := Trim_Image (Natural'Image (Max_Bytes));
   begin
      Set_Active_Buffer (Buffer_Global);
      Append_Line
        ("private static final byte[] " & Name & " = new byte[" & Size_Image & "];",
         S);
      Current_Buffer := Saved_Buffer;
      Indent_Level := Saved_Indent;
      Success := S;
   end Emit_Slide_Array_Decl;

   procedure Emit_Let_Assign_Start
     (Type_Hint : String;
      Success   : out Boolean) is
      pragma Unreferenced (Type_Hint);
   begin
      Append_To_Current (" = ", Success);
   end Emit_Let_Assign_Start;

   procedure Emit_Variable_Ref
     (Name    : String;
      Success : out Boolean) is
   begin
      Append_To_Current (Name & "[0]", Success);
   end Emit_Variable_Ref;

   procedure Emit_Literal_U64
     (Value   : U64;
      Success : out Boolean) is
   begin
      Append_To_Current (Trim_Image (U64'Image (Value)) & "L", Success);
   end Emit_Literal_U64;

   procedure Emit_String_Literal
     (Text    : String;
      Success : out Boolean) is
      S : Boolean := True;
   begin
      Append_To_Current ("""", S);

      for I in Text'Range loop
         case Text (I) is
            when '"' =>
               Append_To_Current ((1 => '\'), S);
               if S then
                  Append_To_Current ("""", S);
               end if;

            when '\' =>
               Append_To_Current ((1 => '\'), S);
               if S then
                  Append_To_Current ((1 => '\'), S);
               end if;

            when ASCII.LF =>
               Append_To_Current ((1 => '\'), S);
               if S then
                  Append_To_Current ("n", S);
               end if;

            when ASCII.CR =>
               Append_To_Current ((1 => '\'), S);
               if S then
                  Append_To_Current ("r", S);
               end if;

            when others =>
               Append_To_Current ((1 => Text (I)), S);
         end case;

         exit when not S;
      end loop;

      if S then
         Append_To_Current ("""", S);
      end if;

      Success := S;
   end Emit_String_Literal;

   procedure Emit_Expression_Open
     (Success : out Boolean) is
   begin
      Append_To_Current ("(", Success);
   end Emit_Expression_Open;

   procedure Emit_Expression_Close
     (Success : out Boolean) is
   begin
      Append_To_Current (")", Success);
   end Emit_Expression_Close;

   procedure Emit_BinOp
     (Op      : ALB_Opcode;
      Success : out Boolean) is
   begin
      case Op is
         when OP_ADD          => Append_To_Current (" + ", Success);
         when OP_SUB          => Append_To_Current (" - ", Success);
         when OP_MUL          => Append_To_Current (" * ", Success);
         when OP_DIV          => Append_To_Current (" / ", Success);
         when OP_MOD          => Append_To_Current (" % ", Success);
         when OP_AND          => Append_To_Current (" & ", Success);
         when OP_OR           => Append_To_Current (" | ", Success);
         when OP_XOR          => Append_To_Current (" ^ ", Success);
         when OP_SHL          => Append_To_Current (" << ", Success);
         when OP_SHR          => Append_To_Current (" >> ", Success);
         when OP_CMP_EQ       => Append_To_Current (" == ", Success);
         when OP_CMP_NEQ      => Append_To_Current (" != ", Success);
         when OP_CMP_LT       => Append_To_Current (" < ", Success);
         when OP_CMP_GT       => Append_To_Current (" > ", Success);
         when OP_CMP_LTE      => Append_To_Current (" <= ", Success);
         when OP_CMP_GTE      => Append_To_Current (" >= ", Success);
         when OP_LOGICAL_AND  => Append_To_Current (" && ", Success);
         when OP_LOGICAL_OR   => Append_To_Current (" || ", Success);
         when others          => Append_To_Current (" /*OP?*/ ", Success);
      end case;
   end Emit_BinOp;

   procedure Emit_Procedure_Decl_Start
     (Name    : String;
      Success : out Boolean) is
   begin
      Append_Line ("// Procedure scaffold pending: " & Name, Success);
   end Emit_Procedure_Decl_Start;

   procedure Emit_Function_Decl_Start
     (Func_Name  : String;
      Return_Tag : ALB_Type_Tag;
      Success    : out Boolean) is
      pragma Unreferenced (Return_Tag);
   begin
      Append_Line ("// Function scaffold pending: " & Func_Name, Success);
   end Emit_Function_Decl_Start;

   procedure Emit_Procedure_End
     (Name    : String;
      Success : out Boolean) is
      pragma Unreferenced (Name);
   begin
      Success := True;
   end Emit_Procedure_End;

   procedure Emit_Return_Start
     (Success : out Boolean) is
   begin
      Append_To_Current ("return ", Success);
   end Emit_Return_Start;

   procedure Emit_Call_Start
     (Func_Name : String;
      Success   : out Boolean) is
   begin
      Append_To_Current (Func_Name & "(", Success);
   end Emit_Call_Start;

   procedure Emit_Call_End
     (Success : out Boolean) is
   begin
      Append_To_Current (")", Success);
   end Emit_Call_End;

   procedure Emit_Comma
     (Success : out Boolean) is
   begin
      Append_To_Current (", ", Success);
   end Emit_Comma;

   procedure Emit_Statement_End
     (Success : out Boolean) is
      S : Boolean := True;
   begin
      Append_To_Current (";", S);
      if S then
         Emit_Newline (S);
      end if;
      Success := S;
   end Emit_Statement_End;

   procedure Emit_Assign_Prefix
     (Success : out Boolean) is
   begin
      Success := True;
   end Emit_Assign_Prefix;

   procedure Emit_Print_Start
     (Tag     : ALB_Type_Tag;
      Piped   : Boolean;
      Success : out Boolean) is
      pragma Unreferenced (Tag);
   begin
      Emit_Indent (Success);
      if Success then
         if Piped then
            Append_To_Current ("System.out.print(", Success);
         else
            Append_To_Current ("System.out.println(", Success);
         end if;
      end if;
   end Emit_Print_Start;

   procedure Emit_Print_End
     (Tag     : ALB_Type_Tag;
      Piped   : Boolean;
      Success : out Boolean) is
      pragma Unreferenced (Tag, Piped);
      S : Boolean := True;
   begin
      Append_To_Current (");", S);
      if S then
         Emit_Newline (S);
      end if;
      Success := S;
   end Emit_Print_End;

   procedure Emit_Window_Creation
     (Title   : String;
      Width   : Natural;
      Height  : Natural;
      Success : out Boolean) is
      S : Boolean := True;
   begin
      Append_Line ("alb_window_title = " & Java_String_Literal_Image (Title) & ";", S);
      Append_Line ("alb_window_width[0] = " & Trim_Image (Natural'Image (Width)) & ";", S);
      Append_Line ("alb_window_height[0] = " & Trim_Image (Natural'Image (Height)) & ";", S);
      Success := S;
   end Emit_Window_Creation;

   procedure Emit_Message_Loop
     (Success : out Boolean) is
   begin
      Desktop_Loop_Required := True;
      Append_Line ("// LISTEN maps to the generated deterministic main loop.", Success);
   end Emit_Message_Loop;

   procedure Emit_Clear_Color
     (Color   : String;
      Success : out Boolean) is
   begin
      Append_Line ("ALB_CLEAR((long)(" & Color & "));", Success);
   end Emit_Clear_Color;

end Emit_Native_Java;
