package body Emit_Native_Java is

   Max_Buffer_Size : constant Natural := 8_388_608;

   Global_Buffer : String (1 .. Max_Buffer_Size) := (others => ' ');
   Global_Len    : Natural := 0;

   Boot_Buffer : String (1 .. Max_Buffer_Size) := (others => ' ');
   Boot_Len    : Natural := 0;

   Key_Buffer : String (1 .. Max_Buffer_Size) := (others => ' ');
   Key_Len    : Natural := 0;

   Tick_Buffer : String (1 .. Max_Buffer_Size) := (others => ' ');
   Tick_Len    : Natural := 0;

   Paint_Buffer : String (1 .. Max_Buffer_Size) := (others => ' ');
   Paint_Len    : Natural := 0;

   Main_Buffer : String (1 .. Max_Buffer_Size) := (others => ' ');
   Main_Len    : Natural := 0;

   Program_Name_Buffer : String (1 .. 128) := (others => ' ');
   Program_Name_Len    : Natural := 0;
   Desktop_Loop_Required : Boolean := False;

   function Trim_Image (S : String) return String is
      Start_At : Positive := S'First;
   begin
      while Start_At < S'Last and then S (Start_At) = ' ' loop
         Start_At := Start_At + 1;
      end loop;
      return S (Start_At .. S'Last);
   end Trim_Image;

   function Java_String_Literal_Image (S : String) return String is
      Buffer : String (1 .. 2048);
      Len    : Natural := 0;

      procedure Put (Text : String) is
      begin
         if Len + Text'Length <= Buffer'Length then
            Buffer (Len + 1 .. Len + Text'Length) := Text;
            Len := Len + Text'Length;
         end if;
      end Put;
   begin
      Put ("""");

      for I in S'Range loop
         case S (I) is
            when '"' =>
               Put ("\""");

            when '\' =>
               Put ("\\");

            when ASCII.LF =>
               Put ("\n");

            when ASCII.CR =>
               Put ("\r");

            when others =>
               Put ((1 => S (I)));
         end case;
      end loop;

      Put ("""");
      return Buffer (1 .. Len);
   end Java_String_Literal_Image;

   function Java_Primitive_Name (Tag : ALB_Type_Tag) return String is
   begin
      case Tag is
         when Type_U8 | Type_S8 | Type_Boolean | Type_HW8 =>
            return "byte";

         when Type_U16 | Type_S16 | Type_HW16 =>
            return "short";

         when Type_U32 | Type_S32 | Type_HW32 | Type_Reference =>
            return "int";

         when Type_U64 | Type_S64 | Type_HW64 | Type_Pure |
              Type_U128 | Type_S128 =>
            return "long";

         when Type_F32 =>
            return "float";

         when Type_F64 | Type_F128 =>
            return "double";

         when Type_Char =>
            return "int";

         when Type_F32x2 | Type_F32x4 | Type_Mat2x2 | Type_Mat3x3 |
              Type_Mat4x4 =>
            return "float";

         when Type_U32x4 | Type_S32x4 =>
            return "int";

         when Type_Binary =>
            return "int";

         when others =>
            return "long";
      end case;
   end Java_Primitive_Name;

   function Java_Slot_Count (Tag : ALB_Type_Tag) return Positive is
   begin
      case Tag is
         when Type_Pure | Type_U128 | Type_S128 =>
            return 2;

         when Type_F32x2 =>
            return 2;

         when Type_F32x4 | Type_U32x4 | Type_S32x4 | Type_Mat2x2 =>
            return 4;

         when Type_Mat3x3 =>
            return 9;

         when Type_Mat4x4 =>
            return 16;

         when others =>
            return 1;
      end case;
   end Java_Slot_Count;

   function Buffer_Base_Indent (Target : Buffer_Target) return Natural is
   begin
      case Target is
         when Buffer_Global =>
            return 1;

         when others =>
            return 2;
      end case;
   end Buffer_Base_Indent;

   procedure Append_To_Current (Text : String; Success : out Boolean) is
   begin
      case Current_Buffer is
         when Buffer_Global =>
            if Global_Len + Text'Length <= Max_Buffer_Size then
               Global_Buffer (Global_Len + 1 .. Global_Len + Text'Length) := Text;
               Global_Len := Global_Len + Text'Length;
               Success := True;
            else
               Success := False;
            end if;

         when Buffer_Boot =>
            if Boot_Len + Text'Length <= Max_Buffer_Size then
               Boot_Buffer (Boot_Len + 1 .. Boot_Len + Text'Length) := Text;
               Boot_Len := Boot_Len + Text'Length;
               Success := True;
            else
               Success := False;
            end if;

         when Buffer_Key =>
            if Key_Len + Text'Length <= Max_Buffer_Size then
               Key_Buffer (Key_Len + 1 .. Key_Len + Text'Length) := Text;
               Key_Len := Key_Len + Text'Length;
               Success := True;
            else
               Success := False;
            end if;

         when Buffer_Tick =>
            if Tick_Len + Text'Length <= Max_Buffer_Size then
               Tick_Buffer (Tick_Len + 1 .. Tick_Len + Text'Length) := Text;
               Tick_Len := Tick_Len + Text'Length;
               Success := True;
            else
               Success := False;
            end if;

         when Buffer_Paint =>
            if Paint_Len + Text'Length <= Max_Buffer_Size then
               Paint_Buffer (Paint_Len + 1 .. Paint_Len + Text'Length) := Text;
               Paint_Len := Paint_Len + Text'Length;
               Success := True;
            else
               Success := False;
            end if;

         when Buffer_Main =>
            if Main_Len + Text'Length <= Max_Buffer_Size then
               Main_Buffer (Main_Len + 1 .. Main_Len + Text'Length) := Text;
               Main_Len := Main_Len + Text'Length;
               Success := True;
            else
               Success := False;
            end if;
      end case;
   end Append_To_Current;

   procedure Append_Line (Text : String; Success : out Boolean) is
      S : Boolean := True;
   begin
      Emit_Indent (S);
      if S then
         Append_To_Current (Text, S);
      end if;
      if S then
         Emit_Newline (S);
      end if;
      Success := S;
   end Append_Line;

   procedure Put_Buffer
     (File    : in out Ada.Text_IO.File_Type;
      Buffer  : String;
      Length  : Natural) is
   begin
      if Length > 0 then
         Ada.Text_IO.Put
           (File,
            Buffer (Buffer'First .. Buffer'First + Length - 1));
      end if;
   end Put_Buffer;

   procedure Init_Emitter (Success : out Boolean) is
   begin
      Global_Len := 0;
      Boot_Len := 0;
      Key_Len := 0;
      Tick_Len := 0;
      Paint_Len := 0;
      Main_Len := 0;
      Program_Name_Buffer := (others => ' ');
      Program_Name_Len := 0;
      Desktop_Loop_Required := False;
      Current_Profile := Profile_FlatJVM;
      Current_Buffer := Buffer_Global;
      Indent_Level := Buffer_Base_Indent (Buffer_Global);
      Java_Emitter_Ready := True;
      Success := True;
   end Init_Emitter;

   procedure Flush_To_File
     (File_Path : String;
      Success   : out Boolean) is
      File : Ada.Text_IO.File_Type;
      Class_Name : constant String :=
        (if Program_Name_Len > 0
         then Program_Name_Buffer (1 .. Program_Name_Len)
         else "ALB_Core");
   begin
      Success := True;

      begin
         Ada.Text_IO.Create (File, Ada.Text_IO.Out_File, File_Path);

         Ada.Text_IO.Put_Line (File, "public final class " & Class_Name & " {");
         Put_Buffer (File, Global_Buffer, Global_Len);
         Ada.Text_IO.New_Line (File);

         Ada.Text_IO.Put_Line (File, "    public static void albBoot() throws Exception {");
         Put_Buffer (File, Boot_Buffer, Boot_Len);
         Ada.Text_IO.Put_Line (File, "    }");
         Ada.Text_IO.New_Line (File);

         Ada.Text_IO.Put_Line (File, "    public static void albOnKey() throws Exception {");
         Put_Buffer (File, Key_Buffer, Key_Len);
         Ada.Text_IO.Put_Line (File, "    }");
         Ada.Text_IO.New_Line (File);

         Ada.Text_IO.Put_Line (File, "    public static void albTick() throws Exception {");
         Put_Buffer (File, Tick_Buffer, Tick_Len);
         Ada.Text_IO.Put_Line (File, "    }");
         Ada.Text_IO.New_Line (File);

         Ada.Text_IO.Put_Line (File, "    public static void albPaint() throws Exception {");
         Put_Buffer (File, Paint_Buffer, Paint_Len);
         Ada.Text_IO.Put_Line (File, "    }");
         Ada.Text_IO.New_Line (File);

         Ada.Text_IO.Put_Line (File, "    public static void albRunFrame() throws Exception {");
         Ada.Text_IO.Put_Line (File, "        if (alb_running[0] == 0) {");
         Ada.Text_IO.Put_Line (File, "            return;");
         Ada.Text_IO.Put_Line (File, "        }");
         Ada.Text_IO.Put_Line (File, "        albOnKey();");
         Ada.Text_IO.Put_Line (File, "        albTick();");
         Ada.Text_IO.Put_Line (File, "        ALB_AUDIO_STEP();");
         Ada.Text_IO.Put_Line (File, "        albPaint();");
         Ada.Text_IO.Put_Line (File, "        alb_tick_counter[0] = alb_tick_counter[0] + 1L;");
         Ada.Text_IO.Put_Line (File, "        if (alb_tick_budget[0] > 0 && alb_tick_counter[0] >= (long) alb_tick_budget[0]) {");
         Ada.Text_IO.Put_Line (File, "            alb_running[0] = 0;");
         Ada.Text_IO.Put_Line (File, "        }");
         Ada.Text_IO.Put_Line (File, "        alb_mouse_click[0] = 0;");
         Ada.Text_IO.Put_Line (File, "        alb_mouse_click[1] = 0;");
         Ada.Text_IO.Put_Line (File, "    }");
         Ada.Text_IO.New_Line (File);

         Ada.Text_IO.Put_Line (File, "    public static boolean albNeedsDesktopLoop() {");
         Ada.Text_IO.Put_Line
           (File,
            "        return " &
            (if Desktop_Loop_Required then "true" else "false") &
            ";");
         Ada.Text_IO.Put_Line (File, "    }");
         Ada.Text_IO.New_Line (File);

         Ada.Text_IO.Put_Line (File, "    public static void main(String[] args) throws Exception {");
         Put_Buffer (File, Main_Buffer, Main_Len);
         Ada.Text_IO.Put_Line (File, "        albBoot();");
         if Desktop_Loop_Required then
            Ada.Text_IO.Put_Line (File, "        while (alb_running[0] != 0) {");
            Ada.Text_IO.Put_Line (File, "            albRunFrame();");
            Ada.Text_IO.Put_Line (File, "        }");
         else
            Ada.Text_IO.Put_Line (File, "        alb_running[0] = 0;");
         end if;
         Ada.Text_IO.Put_Line (File, "        System.exit(alb_exit_code[0]);");
         Ada.Text_IO.Put_Line (File, "    }");
         Ada.Text_IO.Put_Line (File, "}");

         Ada.Text_IO.Close (File);
      exception
         when others =>
            Success := False;
      end;
   end Flush_To_File;

   procedure Set_Active_Buffer (Target : Buffer_Target) is
   begin
      Current_Buffer := Target;
      Indent_Level := Buffer_Base_Indent (Target);
   end Set_Active_Buffer;

