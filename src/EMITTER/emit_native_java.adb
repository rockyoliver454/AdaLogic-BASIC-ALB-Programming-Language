   begin
      Program_Name_Buffer := (others => ' ');
      Program_Name_Len := Program_Name'Length;
      if Program_Name_Len > Program_Name_Buffer'Length then
         Program_Name_Len := Program_Name_Buffer'Length;
      end if;

      if Program_Name_Len > 0 then
         Program_Name_Buffer (1 .. Program_Name_Len) :=
           Program_Name (Program_Name'First .. Program_Name'First + Program_Name_Len - 1);
