   procedure Register_Foreign_Decl (Decl_Node : Node_Index) is
      Name_Node     : constant Node_Index := Tree(Decl_Node).Left_Child;
      Raw_Name      : constant String := Raw_Lexeme(Tree(Name_Node).Token_Index);
      Mod_Name      : constant String := (if Active_Module_Len > 0 then Active_Module_Name(1 .. Active_Module_Len) else "");
      Target_Name   : constant String := Forge_Backend_Name(Mod_Name, Raw_Name, False);
      H             : constant U32 := Hash_String(Target_Name);
      Arg_List      : constant Node_Index := Tree(Name_Node).Right_Child;
      Arg_Curr      : Node_Index := 0;
      Arity         : Natural := 0;
      Ref_Mask      : U64 := 0;
      Found         : Boolean;
      Dummy_Sym     : Symbol_Record;
      Local_Success : Boolean;
   begin
      if Arg_List /= 0 and then Tree(Arg_List).Kind = AST_Arg_List then
         Arg_Curr := Tree(Arg_List).Left_Child;
      end if;

      while Arg_Curr /= 0 loop
         Arity := Arity + 1;
         if Tree(Arg_Curr).Token_Index > 0 and then Tokens(Tree(Arg_Curr).Token_Index).Kind = Tok_Ref then
            Ref_Mask := Ref_Mask or U64(2 ** (Arity - 1));
         end if;
         Arg_Curr := Tree(Arg_Curr).Next_Sibling;
      end loop;

      for I in 1 .. Foreign_Count loop
         if Foreign_Sigs(I).Name_Hash = H then
            Foreign_Sigs(I).Arity := Arity;
            Foreign_Sigs(I).Ref_Mask := Ref_Mask;
            return;
         end if;
      end loop;

      if Foreign_Count < Max_Foreign_Sigs then
         Foreign_Count := Foreign_Count + 1;
         Foreign_Sigs(Foreign_Count) := (Name_Hash => H, Arity => Arity, Ref_Mask => Ref_Mask);
      end if;

      Find_Symbol(H, 0, Found, Dummy_Sym);
      if not Found then
         Add_Global_Symbol(H, Type_U64, (Target_None, 0), 0, 0, Local_Success);
      end if;
   end Register_Foreign_Decl;
   
   function Find_Foreign_Signature
     (Name : String; Sig : out Foreign_Signature) return Boolean is
      H : constant U32 := Hash_String (Name);
   begin
      for I in 1 .. Foreign_Count loop
         if Foreign_Sigs (I).Name_Hash = H then
            Sig := Foreign_Sigs (I);
            return True;
         end if;
      end loop;

      Sig := (Name_Hash => 0, Arity => 0, Ref_Mask => 0);
      return False;
   end Find_Foreign_Signature;

   function Is_Foreign_Name (Name : String) return Boolean is
      Dummy : Foreign_Signature;
   begin
      return Find_Foreign_Signature (Name, Dummy);
   end Is_Foreign_Name;

   
   procedure Validate_Foreign_Call
     (Name          : String;
      Arg_List_Node : Node_Index;
      Call_Tok_Idx  : Natural;
      Success       : in out Boolean;
      Diag          : in out Compiler_Diagnostic) is
      Sig      : Foreign_Signature := (Name_Hash => 0, Arity => 0, Ref_Mask => 0);
      Arg_Curr : Node_Index := Arg_List_Node;
      Pos      : Natural := 0;
      Need_Ref : Boolean;
      Clip_Len : Natural;
   begin
      if not Find_Foreign_Signature (Name, Sig) then
         return;
      end if;

      if Target /= Backend_C and then Target /= Backend_FASM then
         Diag.Success := False;
         Diag.Code := Err_Type_Conflict;
         Diag.Error_Line := Tokens (Call_Tok_Idx).Line;
         Diag.Error_Col := Tokens (Call_Tok_Idx).Column;
         Clip_Len := Name'Length;
         if Clip_Len > Diag.Culprit'Length then Clip_Len := Diag.Culprit'Length; end if;
         Diag.Culprit_Len := Clip_Len;
         Diag.Culprit (1 .. Clip_Len) := Name (Name'First .. Name'First + Clip_Len - 1);
         Success := False;
         return;
      end if;

      if Arg_Curr /= 0 and then Tree (Arg_Curr).Kind = AST_Arg_List then
         Arg_Curr := Tree (Arg_Curr).Left_Child;
      end if;

      while Arg_Curr /= 0 loop
         Pos := Pos + 1;
         Need_Ref := (Sig.Ref_Mask and U64 (2 ** (Pos - 1))) /= 0;

         if Need_Ref then
            if Tree (Arg_Curr).Kind /= AST_Ref_Expr then
               Diag.Success := False;
               Diag.Code := Err_Type_Conflict;
               Diag.Error_Line := Tokens (Call_Tok_Idx).Line;
               Diag.Error_Col := Tokens (Call_Tok_Idx).Column;
               Clip_Len := Name'Length;
               if Clip_Len > Diag.Culprit'Length then Clip_Len := Diag.Culprit'Length; end if;
               Diag.Culprit_Len := Clip_Len;
               Diag.Culprit (1 .. Clip_Len) := Name (Name'First .. Name'First + Clip_Len - 1);
               Success := False;
               return;
            end if;
         else
            if Tree (Arg_Curr).Kind = AST_Ref_Expr then
               Diag.Success := False;
               Diag.Code := Err_Type_Conflict;
               Diag.Error_Line := Tokens (Call_Tok_Idx).Line;
               Diag.Error_Col := Tokens (Call_Tok_Idx).Column;
               Clip_Len := Name'Length;
               if Clip_Len > Diag.Culprit'Length then Clip_Len := Diag.Culprit'Length; end if;
               Diag.Culprit_Len := Clip_Len;
               Diag.Culprit (1 .. Clip_Len) := Name (Name'First .. Name'First + Clip_Len - 1);
               Success := False;
               return;
            end if;
         end if;

         Arg_Curr := Tree (Arg_Curr).Next_Sibling;
      end loop;

      if Pos /= Sig.Arity then
         Diag.Success := False;
         Diag.Code := Err_Type_Conflict;
         Diag.Error_Line := Tokens (Call_Tok_Idx).Line;
         Diag.Error_Col := Tokens (Call_Tok_Idx).Column;
         Clip_Len := Name'Length;
         if Clip_Len > Diag.Culprit'Length then Clip_Len := Diag.Culprit'Length; end if;
         Diag.Culprit_Len := Clip_Len;
         Diag.Culprit (1 .. Clip_Len) := Name (Name'First .. Name'First + Clip_Len - 1);
         Success := False;
      end if;
   end Validate_Foreign_Call;
   
   function Type_Tag_From_Name (Name : String) return ALB_Type_Tag is
      U : constant String := To_Upper (Name);
      R : Natural := 0;
      T : ALB_Type_Tag := Type_None;
   begin
      T := Resolve_Type_Name (Name);
      if T /= Type_None then
         return T;
      end if;

      -- Named RANGE subtypes (registered separately from builtins).
      R := Find_Range_Type (U);
      if R > 0 then
         return Range_Types (R).Base_Tag;
      end if;

      -- Historical fallback for unresolved foreign/legacy names.
      return Type_U64;
   end Type_Tag_From_Name;

   function Type_Tag_Name (Tag : ALB_Type_Tag) return String is
   begin
      case Tag is
         when Type_U8      => return "U8";
         when Type_U16     => return "U16";
         when Type_U32     => return "U32";
         when Type_U64     => return "U64";
         when Type_U128    => return "U128";
         when Type_S8      => return "S8";
         when Type_S16     => return "S16";
         when Type_S32     => return "S32";
         when Type_S64     => return "S64";
         when Type_S128    => return "S128";
         when Type_F32     => return "F32";
         when Type_F64     => return "F64";
         when Type_F128    => return "F128";
         when Type_F32x2   => return "F32x2";
         when Type_F32x4   => return "F32x4";
         when Type_U32x4   => return "U32x4";
         when Type_S32x4   => return "S32x4";
         when Type_Mat2x2  => return "Mat2x2";
         when Type_Mat3x3  => return "Mat3x3";
         when Type_Mat4x4  => return "Mat4x4";
         when Type_Boolean => return "BOOLEAN";
         when Type_Char    => return "CHAR";
         when Type_Reference => return "REFERENCE";
         when Type_Pure    => return "PURE";
         when Type_HW8     => return "HW8";
         when Type_HW16    => return "HW16";
         when Type_HW32    => return "HW32";
         when Type_HW64    => return "HW64";
         when Type_Binary  => return "STRING/BINARY";
         when Type_None    => return "NONE";
      end case;
   end Type_Tag_Name;


   function Type_Tag_From_Type_Node (Type_Node : Node_Index) return ALB_Type_Tag is
   begin
      if Type_Node = 0 then
         return Type_U64;
      end if;

      return Type_Tag_From_Name (Raw_Lexeme (Tree(Type_Node).Token_Index));
   end Type_Tag_From_Type_Node;

   function Tags_Compatible
     (Expected : ALB_Type_Tag;
      Actual   : ALB_Type_Tag) return Boolean
   is
   begin
      if Expected = Actual then
         return True;
      end if;

      -- DA STRICT TYPING FORGE: No silent implicit coercions!
      -- All mismatched types must be explicitly CAST.
      return False;
   end Tags_Compatible;

   function Is_Scalar_Integer_Tag (Tag : ALB_Type_Tag) return Boolean is
   begin
      return Tag in Type_U8 | Type_U16 | Type_U32 | Type_U64 | Type_U128
        | Type_S8 | Type_S16 | Type_S32 | Type_S64 | Type_S128
        | Type_HW8 | Type_HW16 | Type_HW32 | Type_HW64;
   end Is_Scalar_Integer_Tag;

   function Integer_Call_Params_Compatible
     (Expected : ALB_Type_Tag;
      Actual   : ALB_Type_Tag) return Boolean
   is
   begin
      return Is_Scalar_Integer_Tag (Expected)
        and then Is_Scalar_Integer_Tag (Actual);
   end Integer_Call_Params_Compatible;

   procedure Fail_Call_Diagnostic
     (Name         : String;
      Call_Tok_Idx : Natural;
      Code         : Oracle_Code;
      Success      : in out Boolean;
      Diag         : in out Compiler_Diagnostic)
   is
      Clip_Len : Natural := Name'Length;
   begin
      Diag.Success := False;
      Diag.Code := Code;

      if Call_Tok_Idx > 0 then
         Diag.Error_Line := Tokens(Call_Tok_Idx).Line;
         Diag.Error_Col  := Tokens(Call_Tok_Idx).Column;
      else
         Diag.Error_Line := 1;
         Diag.Error_Col  := 1;
      end if;

      if Clip_Len > Diag.Culprit'Length then
         Clip_Len := Diag.Culprit'Length;
      end if;

      Diag.Culprit_Len := Clip_Len;
      Diag.Culprit(1 .. Clip_Len) :=
        Name(Name'First .. Name'First + Clip_Len - 1);

      Success := False;
   end Fail_Call_Diagnostic;

   procedure Resolve_ALB_Call_Name
     (Target_Node : Node_Index;
      Name        : out String;
      Len         : out Natural)
   is
   begin
      Name := (others => ' ');
      Len := 0;

      if Target_Node = 0 then
         return;
      end if;

      if Tree(Target_Node).Kind = AST_Member_Expr then
         declare
            M_Tok : Token := Tokens(Tree(Tree(Target_Node).Left_Child).Token_Index);
            F_Tok : Token := Tokens(Tree(Tree(Target_Node).Right_Child).Token_Index);
            M_Str : String := Input_Buffer(M_Tok.Start .. M_Tok.Start + M_Tok.Length - 1);
            F_Str : String := Input_Buffer(F_Tok.Start .. F_Tok.Start + F_Tok.Length - 1);
            T_Str : constant String := Forge_Backend_Name (M_Str, F_Str, False);
         begin
            Name(Name'First .. Name'First + T_Str'Length - 1) := T_Str;
            Len := T_Str'Length;
         end;

      --  elsif Tree(Target_Node).Kind = AST_Var_Expr then
      --     declare
      --        V_Tok : Token := Tokens(Tree(Target_Node).Token_Index);
      --        V_Str : String := Input_Buffer(V_Tok.Start .. V_Tok.Start + V_Tok.Length - 1);
      --     begin
      --        if Active_Module_Len > 0 then
      --           Name(Name'First .. Name'First + Active_Module_Len - 1) := Active_Module_Name(1 .. Active_Module_Len);
      --           Name(Name'First + Active_Module_Len) := '_';
      --           Name(Name'First + Active_Module_Len + 1 .. Name'First + Active_Module_Len + V_Str'Length) := V_Str;
      --           Len := Active_Module_Len + 1 + V_Str'Length;
      --        else
      --           Name(Name'First .. Name'First + V_Str'Length - 1) := V_Str;
      --           Len := V_Str'Length;
      --        end if;
      --     end;
      --  end if;
      elsif Tree(Target_Node).Kind = AST_Var_Expr then
         declare
            V_Tok : Token := Tokens(Tree(Target_Node).Token_Index);
            V_Str : String := Input_Buffer(V_Tok.Start .. V_Tok.Start + V_Tok.Length - 1);
         begin
            -- DA NEW ARMOR: Shield Built-ins frae Module Prefixing!
            if Is_ALB_Builtin_Call_Name(V_Str) then
               Name(Name'First .. Name'First + V_Str'Length - 1) := V_Str;
               Len := V_Str'Length;
            else
               declare
                  Mod_Name : constant String :=
                    (if Active_Module_Len > 0
                     then Active_Module_Name(1 .. Active_Module_Len)
                     else "");
                  T_Str : constant String := Forge_Backend_Name (Mod_Name, V_Str, False);
               begin
                  Name(Name'First .. Name'First + T_Str'Length - 1) := T_Str;
                  Len := T_Str'Length;
               end;
            end if;
         end;
      end if;
   end Resolve_ALB_Call_Name;
   
   function Is_ALB_Builtin_Call_Name (Name : String) return Boolean is
      U : constant String := To_Upper (Name);
   begin
      return U = "PURE"
        or else U = "RATIONAL"
        or else U = "PURE_ADD"
        or else U = "PURE_SUB"
        or else U = "PURE_MUL"
        or else U = "PURE_DIV"
        or else U = "PURE_POW"
        or else U = "PURE_NUM"
        or else U = "PURE_DEN"
        or else U = "PRINT_PURE"
        or else U = "HW8"
        or else U = "HW16"
        or else U = "HW32"
        or else U = "U8"
        or else U = "U16"
        or else U = "U32"
        or else U = "U64"
         or else U = "U128"
         or else U = "S8"
         or else U = "S16"
         or else U = "S32"
         or else U = "S64"
         or else U = "I8"
         or else U = "I16"
         or else U = "I32"
         or else U = "I64"
         or else U = "INT8"
         or else U = "INT16"
         or else U = "INT32"
         or else U = "INT64"
         or else U = "F64"
         or else U = "REAL"
        or else U = "LEN"
        or else U = "LEFT"
        or else U = "RIGHT"
        or else U = "MID"
        or else U = "MID$"
        or else U = "CHR"
        or else U = "ASC"
        or else U = "CONCAT"
        or else U = "SIN"
        or else U = "COS"
        or else U = "SQRT"
        or else U = "EXP"
        or else U = "COLLIDE_RECT"
        or else U = "ALB_COLLIDE_RECT"
        or else U = "VIRTUAL_ALLOC"
        or else U = "VIRTUAL_FREE"
        or else U = "VIRTUAL_PROTECT";
   end Is_ALB_Builtin_Call_Name;


   function Find_ALB_Signature
     (Name : String;
      Sig  : out ALB_Signature) return Boolean
   is
      H : constant U32 := Hash_String (Name);
   begin
      for I in 1 .. ALB_Sig_Count loop
         if ALB_Sigs(I).Name_Hash = H then
            Sig := ALB_Sigs(I);
            return True;
         end if;
      end loop;

      Sig :=
        (Name_Hash    => 0,
         Is_Function  => False,
         Return_Tag   => Type_None,
         Return_Range => 0,
         Param_Count  => 0,
         Param_Tags   => (others => Type_None),
         Param_Ranges => (others => 0),
         Param_Is_Out => (others => False));

      return False;
   end Find_ALB_Signature;

   procedure Register_ALB_Decl (Decl_Node : Node_Index) is
      Name_Node   : constant Node_Index := Tree(Decl_Node).Left_Child;
      Raw_Name    : constant String := Raw_Lexeme(Tree(Name_Node).Token_Index);
      Mod_Name    : constant String :=
        (if Active_Module_Len > 0 then Active_Module_Name(1 .. Active_Module_Len) else "");
      Target_Name : constant String := Forge_Backend_Name(Mod_Name, Raw_Name, False);
      H           : constant U32 := Hash_String(Target_Name);
      Arg_List    : constant Node_Index := Tree(Name_Node).Right_Child;
      Arg_Curr    : Node_Index := 0;
      Sig         : ALB_Signature;
      Found_Idx   : Natural := 0;
   begin
      Sig.Name_Hash := H;
      Sig.Is_Function := Tree(Decl_Node).Kind = AST_Function_Decl;

      if Sig.Is_Function then
         if Tree(Decl_Node).Token_Index > 0 then
            declare
               Ret_Lex : constant String := Raw_Lexeme(Tree(Decl_Node).Token_Index);
            begin
               Sig.Return_Tag := Type_Tag_From_Name(Ret_Lex);
               Sig.Return_Range := Find_Range_Type(Ret_Lex);
            end;
         else
            Sig.Return_Tag := Type_U64;
            Sig.Return_Range := 0;
         end if;
      else
         Sig.Return_Tag := Type_None;
         Sig.Return_Range := 0;
      end if;


      if Arg_List /= 0 and then Tree(Arg_List).Kind = AST_Arg_List then
         Arg_Curr := Tree(Arg_List).Left_Child;
      end if;

      while Arg_Curr /= 0 loop
         if Sig.Param_Count < Max_ALB_Params then
            declare
               Type_Node : Node_Index := 0;
            begin
               if Tree (Arg_Curr).Kind = AST_Param_Decl then
                  Type_Node := Tree (Arg_Curr).Right_Child;
               else
                  Type_Node := Tree (Arg_Curr).Right_Child;
               end if;

               Sig.Param_Count := Sig.Param_Count + 1;
               Sig.Param_Tags (Sig.Param_Count) :=
                 Type_Tag_From_Type_Node (Type_Node);
               Sig.Param_Is_Out (Sig.Param_Count) :=
                 Tree (Arg_Curr).Token_Index > 0
                 and then Tokens (Tree (Arg_Curr).Token_Index).Kind = Tok_Out;

               if Type_Node > 0 then
                  Sig.Param_Ranges (Sig.Param_Count) :=
                    Find_Range_Type
                      (Raw_Lexeme (Tree (Type_Node).Token_Index));
               else
                  Sig.Param_Ranges (Sig.Param_Count) := 0;
               end if;
            end;
         end if;

         Arg_Curr := Tree (Arg_Curr).Next_Sibling;
      end loop;

      for I in 1 .. ALB_Sig_Count loop
         if ALB_Sigs(I).Name_Hash = H then
            Found_Idx := I;
            exit;
         end if;
      end loop;

      if Found_Idx > 0 then
         ALB_Sigs(Found_Idx) := Sig;
      elsif ALB_Sig_Count < Max_ALB_Sigs then
         ALB_Sig_Count := ALB_Sig_Count + 1;
         ALB_Sigs(ALB_Sig_Count) := Sig;
      else
         Ada.Text_IO.Put_Line
           ("FATAL: ALB signature vault full (" & Natural'Image (Max_ALB_Sigs)
            & ") registering " & Target_Name);
      end if;
   end Register_ALB_Decl;

   procedure Validate_ALB_Call
     (Name             : String;
      Arg_List_Node    : Node_Index;
      Call_Tok_Idx     : Natural;
      Require_Function : Boolean;
      Success          : in out Boolean;
      Diag             : in out Compiler_Diagnostic);

   procedure Validate_Expression_Calls
     (Expr_Node    : Node_Index;
      Call_Tok_Idx : Natural;
      Success      : in out Boolean;
      Diag         : in out Compiler_Diagnostic);
   
   function Infer_Type_Tag (Idx : Node_Index) return ALB_Type_Tag;
   
   function Try_Literal_U64
     (Expr_Node : Node_Index;
      Value     : out U64) return Boolean;

   procedure Validate_Expression_Calls
     (Expr_Node    : Node_Index;
      Call_Tok_Idx : Natural;
      Success      : in out Boolean;
      Diag         : in out Compiler_Diagnostic)
   is
      TName : String (1 .. 128) := (others => ' ');
      TLen  : Natural := 0;
   begin
      if Expr_Node = 0 or else not Success or else not Diag.Success then
         return;
      end if;

      case Tree (Expr_Node).Kind is
         when AST_Func_Call =>
            Resolve_ALB_Call_Name(Tree(Expr_Node).Left_Child, TName, TLen);

            if TLen > 0 then
               if Is_ALB_Builtin_Call_Name(TName(1 .. TLen)) then
                  Validate_Expression_Calls(Tree(Expr_Node).Right_Child, Call_Tok_Idx, Success, Diag);
               else
                  Validate_Foreign_Call(TName(1 .. TLen), Tree(Expr_Node).Right_Child, Call_Tok_Idx, Success, Diag);
                  if not Success or else not Diag.Success then
                     return;
                  end if;

                  Validate_ALB_Call(TName(1 .. TLen), Tree(Expr_Node).Right_Child, Call_Tok_Idx, True, Success, Diag);
               end if;
            end if;

         when AST_Query
            | AST_Knows_Query
            | AST_Findall_Query =>
            declare
               Pred_Node : Node_Index := Tree (Expr_Node).Left_Child;
            begin
               if Pred_Node > 0 and then Tree (Pred_Node).Kind = AST_Func_Call then
                  Validate_Expression_Calls (Tree (Pred_Node).Right_Child, Call_Tok_Idx, Success, Diag);
               else
                  Validate_Expression_Calls (Pred_Node, Call_Tok_Idx, Success, Diag);
               end if;
            end;

         when AST_Find_Query =>
            declare
               Find_Node : Node_Index := Tree (Expr_Node).Left_Child;
            begin
               if Find_Node > 0 and then Tree (Find_Node).Kind = AST_Func_Call then
                  Validate_Expression_Calls (Tree (Find_Node).Right_Child, Call_Tok_Idx, Success, Diag);
               else
                  Validate_Expression_Calls (Find_Node, Call_Tok_Idx, Success, Diag);
               end if;
            end;

         when others =>
            Validate_Expression_Calls(Tree(Expr_Node).Left_Child, Call_Tok_Idx, Success, Diag);
            Validate_Expression_Calls(Tree(Expr_Node).Right_Child, Call_Tok_Idx, Success, Diag);
      end case;
   end Validate_Expression_Calls;

   procedure Validate_ALB_Call
     (Name             : String;
      Arg_List_Node    : Node_Index;
      Call_Tok_Idx     : Natural;
      Require_Function : Boolean;
      Success          : in out Boolean;
      Diag             : in out Compiler_Diagnostic)
   is
      Sig      : ALB_Signature;
      Arg_Curr : Node_Index := Arg_List_Node;
      Pos      : Natural := 0;
      Actual   : ALB_Type_Tag := Type_None;
   begin
      if Find_ALB_Signature(Name, Sig) then
         if Require_Function and then not Sig.Is_Function then
            Fail_Call_Diagnostic(Name, Call_Tok_Idx, Err_Type_Conflict, Success, Diag);
            return;
         end if;

         if Arg_Curr /= 0 and then Tree(Arg_Curr).Kind = AST_Arg_List then
            Arg_Curr := Tree(Arg_Curr).Left_Child;
         end if;

         while Arg_Curr /= 0 loop
            Pos := Pos + 1;

            Validate_Expression_Calls(Arg_Curr, Call_Tok_Idx, Success, Diag);
            if not Success or else not Diag.Success then
               return;
            end if;

            --  if Pos <= Sig.Param_Count then
            --     Actual := Infer_Type_Tag(Arg_Curr);
            --  
            --     if not Tags_Compatible(Sig.Param_Tags(Pos), Actual) then
            --        Fail_Call_Diagnostic(Name, Call_Tok_Idx, Err_Type_Conflict, Success, Diag);
            --        return;
            --     end if;
            --  end if;
            if Pos <= Sig.Param_Count then
               Actual := Infer_Type_Tag(Arg_Curr);

               if Tags_Compatible (Sig.Param_Tags (Pos), Actual)
                 or else Integer_Call_Params_Compatible (Sig.Param_Tags (Pos), Actual)
               then
                  null;
               else
                  declare
                     Sym_Found : Boolean := False;
                     Sym_Rec   : Symbol_Record;
                  begin
                     if Tree (Arg_Curr).Kind = AST_Var_Expr
                       and then Tree (Arg_Curr).Left_Child = 0
                     then
                        declare
                           Tok        : Token := Tokens (Tree (Arg_Curr).Token_Index);
                           Lex        : String :=
                             Input_Buffer (Tok.Start .. Tok.Start + Tok.Length - 1);
                           Target_Lex : constant String := Scoped_Lexeme (Lex);
                        begin
                           Find_Symbol
                             (Hash_String (Target_Lex), Current_Scope, Sym_Found, Sym_Rec);
                           if not Sym_Found then
                              Find_Symbol
                                (Hash_String (Lex), Current_Scope, Sym_Found, Sym_Rec);
                           end if;
                        end;
                     end if;

                     if Sym_Found
                       and then
                         (Tags_Compatible (Sig.Param_Tags (Pos), Sym_Rec.Tag)
                          or else Integer_Call_Params_Compatible
                                (Sig.Param_Tags (Pos), Sym_Rec.Tag))
                     then
                        null;
                     else
                        declare
                           Lit_Val : U64 := 0;
                        begin
                           if not Try_Literal_U64(Arg_Curr, Lit_Val) then
                              Fail_Call_Diagnostic(Name, Call_Tok_Idx, Err_Type_Conflict, Success, Diag);
                              return;
                           end if;
                           -- If it IS a literal, we let it slide and allow the compilation to proceed!
                        end;
                     end if;
                  end;
               end if;
            end if;

            Arg_Curr := Tree(Arg_Curr).Next_Sibling;
         end loop;

         if Pos /= Sig.Param_Count then
            Fail_Call_Diagnostic(Name, Call_Tok_Idx, Err_Type_Conflict, Success, Diag);
            return;
         end if;

      elsif Is_Foreign_Name(Name) then
         return;

      else
         Fail_Call_Diagnostic(Name, Call_Tok_Idx, Err_Proc_Not_Found, Success, Diag);
         return;
      end if;
   end Validate_ALB_Call;
   
   procedure Emit_Foreign_Import
     (Import_Node : Node_Index;
      Success     : in out Boolean;
      Diag        : in out Compiler_Diagnostic) is
      Decl_Node    : constant Node_Index := Tree (Import_Node).Left_Child;
      Lib_Node     : constant Node_Index := Tree (Import_Node).Right_Child;
      Name_Node    : constant Node_Index := Tree (Decl_Node).Left_Child;
      Raw_Name     : constant String := Raw_Lexeme (Tree (Name_Node).Token_Index);
      Mod_Name     : constant String := (if Active_Module_Len > 0 then Active_Module_Name (1 .. Active_Module_Len) else "");
      Target_Name  : constant String := Forge_Backend_Name (Mod_Name, Raw_Name, False);
      Lib_Text     : constant String := Strip_String_Node (Lib_Node);
      Ret_Name     : constant String := (if Tree (Decl_Node).Token_Index > 0 then Raw_Lexeme (Tree (Decl_Node).Token_Index) else "U64");
      Ret_Upper    : constant String := To_Upper (Ret_Name);
      Native_Ret_C : constant String := (if Tree (Decl_Node).Kind = AST_Procedure_Decl then "void" else C_FFI_Type (Ret_Name));
      Is_Direct_Library : constant Boolean :=
        Tree (Import_Node).Kind in AST_Import_DLL | AST_Import_SO | AST_Import_Dylib;
      Is_Header    : constant Boolean :=
        (if Is_Direct_Library then False else Looks_Like_Header (Lib_Text));
      Sig          : Foreign_Signature := (Name_Hash => 0, Arity => 0, Ref_Mask => 0);

      procedure Fail_Current (Code : Oracle_Code) is
         Clip_Len : Natural := Raw_Name'Length;
      begin
         Diag.Success := False;
         Diag.Code := Code;
         Diag.Error_Line := Tokens (Tree (Import_Node).Token_Index).Line;
         Diag.Error_Col := Tokens (Tree (Import_Node).Token_Index).Column;
         if Clip_Len > Diag.Culprit'Length then Clip_Len := Diag.Culprit'Length; end if;
         Diag.Culprit_Len := Clip_Len;
         Diag.Culprit (1 .. Clip_Len) := Raw_Name (Raw_Name'First .. Raw_Name'First + Clip_Len - 1);
         Success := False;
      end Fail_Current;

      function Map_FASM_Library (Lib : String) return String is
         U : constant String := To_Upper (Lib);
      begin
         if not Looks_Like_Header (Lib) then
            return Lib;
         elsif U = "SDL.H" then
            return "SDL3.dll";
         elsif U'Length >= 8 and then U (U'First .. U'First + 7) = "SDL3/SDL" then
            return "SDL3.dll";
         elsif U'Length >= 8 and then U (U'First .. U'First + 7) = "SDL3\SDL" then
            return "SDL3.dll";
         elsif U = "STDIO.H" or else U = "STDLIB.H" or else
               U = "STRING.H" or else U = "MATH.H" or else
               U = "TIME.H" or else U = "CTYPE.H" then
            return "msvcrt.dll";

         else
            return "";
         end if;
      end Map_FASM_Library;

      function Resolve_FASM_Direct_Library (Lib : String) return String is
         Simple : constant String := Ada.Directories.Simple_Name (Lib);
         Stage_Path : constant String :=
           (if Final_Dir_Len > 0
            then Ada.Directories.Compose (Final_Dir (1 .. Final_Dir_Len), Simple)
            else "");
         function Normalize_FASM_Path (Path : String) return String is
            Result : String (1 .. Path'Length) := (others => ' ');
         begin
            for I in Path'Range loop
               Result (I - Path'First + 1) :=
                 (if Path (I) = '\' then '/' else Path (I));
            end loop;
            return Result;
         end Normalize_FASM_Path;

         function Absolute_Path (Path : String) return String is
            CWD : constant String := Ada.Directories.Current_Directory;
         begin
            if Path'Length = 0 or else Is_Absolute_Path (Path) then
               return Path;
            elsif CWD'Length = 0 then
               return Path;
            elsif CWD (CWD'Last) = '\' or else CWD (CWD'Last) = '/' then
               return CWD & Path;
            else
               return CWD & "\" & Path;
            end if;
         exception
            when others =>
               return Path;
         end Absolute_Path;
      begin
         if Lib'Length = 0 then
            return Lib;
         end if;

         if Is_Absolute_Path (Lib) then
            return Normalize_FASM_Path (Lib);
         end if;

         if Stage_Path'Length > 0 and then Ada.Directories.Exists (Stage_Path) then
            return Simple;
         end if;

         if Ada.Directories.Exists (Lib) then
            return Normalize_FASM_Path (Absolute_Path (Lib));
         end if;

         return Lib;
      exception
         when others =>
            return Lib;
      end Resolve_FASM_Direct_Library;

      procedure Emit_Param_List (With_Names : Boolean) is
         Param_Node : Node_Index := 0;
      begin
         if Tree (Name_Node).Right_Child /= 0 and then Tree (Tree (Name_Node).Right_Child).Kind = AST_Arg_List then
            Param_Node := Tree (Tree (Name_Node).Right_Child).Left_Child;
         end if;

         if Param_Node = 0 then
            Transpiler_Native_HAL.Emit_Raw ("void", Success);
            return;
         end if;

         while Param_Node /= 0 loop
            declare
               Type_Name : constant String :=
                 (if Tree (Param_Node).Right_Child /= 0 then
                     Raw_Lexeme (Tree (Tree (Param_Node).Right_Child).Token_Index)
                  else "U64");
               Is_Ref    : constant Boolean := Tree (Param_Node).Token_Index > 0 and then Tokens (Tree (Param_Node).Token_Index).Kind = Tok_Ref;
            begin
               if (not Is_Scalar_FFI_Type (Type_Name)) and then (not Is_Ref) then
                  Fail_Current (Err_Type_Conflict);
                  return;
               end if;

               Transpiler_Native_HAL.Emit_Raw ("uint64_t", Success);

               if With_Names then
                  declare
                     PName : constant String := Raw_Lexeme (Tree (Tree (Param_Node).Left_Child).Token_Index);
                  begin
                     Transpiler_Native_HAL.Emit_Raw (" " & PName, Success);
                  end;
               end if;
            end;

            Param_Node := Tree (Param_Node).Next_Sibling;
            if Param_Node /= 0 then
               Transpiler_Native_HAL.Emit_Raw (", ", Success);
            end if;
         end loop;
      end Emit_Param_List;

      procedure Emit_Call_Arg_List is
         Param_Node : Node_Index := 0;
      begin
         if Tree (Name_Node).Right_Child /= 0 and then Tree (Tree (Name_Node).Right_Child).Kind = AST_Arg_List then
            Param_Node := Tree (Tree (Name_Node).Right_Child).Left_Child;
         end if;

         while Param_Node /= 0 loop
            declare
               PName      : constant String := Raw_Lexeme (Tree (Tree (Param_Node).Left_Child).Token_Index);
               Type_Name  : constant String :=
                 (if Tree (Param_Node).Right_Child /= 0 then
                     Raw_Lexeme (Tree (Tree (Param_Node).Right_Child).Token_Index)
                  else "U64");
               Type_C     : constant String := C_FFI_Type (Type_Name);
               Upper_Name : constant String := To_Upper (Type_Name);
               Is_Ref     : constant Boolean := Tree (Param_Node).Token_Index > 0 and then Tokens (Tree (Param_Node).Token_Index).Kind = Tok_Ref;
            begin
               if Is_Ref then
                  Transpiler_Native_HAL.Emit_Raw ("(" & Type_C & "*)(uintptr_t)" & PName, Success);
               elsif Upper_Name = "STRING" then
                  Transpiler_Native_HAL.Emit_Raw ("(char*)(uintptr_t)" & PName, Success);
               else
                  Transpiler_Native_HAL.Emit_Raw ("(" & Type_C & ")" & PName, Success);
               end if;
            end;

            Param_Node := Tree (Param_Node).Next_Sibling;
            if Param_Node /= 0 then
               Transpiler_Native_HAL.Emit_Raw (", ", Success);
            end if;
         end loop;
      end Emit_Call_Arg_List;

   begin
      if not Find_Foreign_Signature (Target_Name, Sig) then
         Fail_Current (Err_Type_Conflict);
         return;
      end if;

      if Tree (Decl_Node).Kind = AST_Function_Decl then
         if (not Is_Scalar_FFI_Type (Ret_Name)) and then Ret_Upper /= "STRING" then
            Fail_Current (Err_Type_Conflict);
            return;
         end if;
      end if;

      if Target = Backend_FASM then
         declare
            Mapped_Lib : constant String :=
              (if Is_Direct_Library
               then Resolve_Vendor_Dll (Resolve_FASM_Direct_Library (Lib_Text))
               elsif not Looks_Like_Header (Lib_Text)
               then Resolve_Vendor_Dll (Lib_Text)
               else Map_FASM_Library (Lib_Text));
         begin
            if Mapped_Lib'Length = 0 then
               Fail_Current (Err_Type_Conflict);
               return;
            end if;

            if Sig.Arity > 20 then
               Fail_Current (Err_Type_Conflict);
               return;
            end if;

            Transpiler_Native_HAL.Set_Global_Buffer_Mode (True);

            Transpiler_Native_HAL.Emit_Indent (Success);
            Transpiler_Native_HAL.Emit_Raw ("ALB_FFI_" & Target_Name & " dq 0", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);

            Transpiler_Native_HAL.Emit_Indent (Success);
            Transpiler_Native_HAL.Emit_Raw ("ALB_FFI_LIB_" & Target_Name & " db """ & Mapped_Lib & """, 0", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);

            Transpiler_Native_HAL.Emit_Indent (Success);
            Transpiler_Native_HAL.Emit_Raw ("ALB_FFI_SYM_" & Target_Name & " db """ & Raw_Name & """, 0", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);

            Transpiler_Native_HAL.Emit_Newline (Success);
            Transpiler_Native_HAL.Set_Global_Buffer_Mode (False);

            Transpiler_Native_HAL.Emit_Raw ("  jmp skip_proc_" & Target_Name, Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            Transpiler_Native_HAL.Emit_Raw (Target_Name & ":", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);

            Transpiler_Native_HAL.Emit_Raw ("  sub rsp, 264", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);

            Transpiler_Native_HAL.Emit_Raw ("  mov qword [rsp + 160], rcx", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            Transpiler_Native_HAL.Emit_Raw ("  mov qword [rsp + 168], rdx", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            Transpiler_Native_HAL.Emit_Raw ("  mov qword [rsp + 176], r8", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            Transpiler_Native_HAL.Emit_Raw ("  mov qword [rsp + 184], r9", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);

            Transpiler_Native_HAL.Emit_Raw ("  mov rax, qword [ALB_FFI_" & Target_Name & "]", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            Transpiler_Native_HAL.Emit_Raw ("  test rax, rax", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            Transpiler_Native_HAL.Emit_Raw ("  jnz .alb_ffi_ready_" & Target_Name, Success);
            Transpiler_Native_HAL.Emit_Newline (Success);

            Transpiler_Native_HAL.Emit_Raw ("  lea rcx, [ALB_FFI_LIB_" & Target_Name & "]", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            Transpiler_Native_HAL.Emit_Raw ("  lea rdx, [ALB_FFI_SYM_" & Target_Name & "]", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            Transpiler_Native_HAL.Emit_Raw ("  call ALB_Load_Foreign_Symbol", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            Transpiler_Native_HAL.Emit_Raw ("  mov qword [ALB_FFI_" & Target_Name & "], rax", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            Transpiler_Native_HAL.Emit_Raw ("  test rax, rax", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            Transpiler_Native_HAL.Emit_Raw ("  jnz .alb_ffi_ready_" & Target_Name, Success);
            Transpiler_Native_HAL.Emit_Newline (Success);

            Transpiler_Native_HAL.Emit_Raw ("  xor rax, rax", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            Transpiler_Native_HAL.Emit_Raw ("  jmp .alb_ffi_exit_" & Target_Name, Success);
            Transpiler_Native_HAL.Emit_Newline (Success);

            Transpiler_Native_HAL.Emit_Raw (".alb_ffi_ready_" & Target_Name & ":", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);

            Transpiler_Native_HAL.Emit_Raw ("  mov rcx, qword [rsp + 160]", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            Transpiler_Native_HAL.Emit_Raw ("  mov rdx, qword [rsp + 168]", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            Transpiler_Native_HAL.Emit_Raw ("  mov r8, qword [rsp + 176]", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            Transpiler_Native_HAL.Emit_Raw ("  mov r9, qword [rsp + 184]", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);

            -- Win64 float ABI: only REAL/F64/F32 params go through XMM / movss.
            -- Integer and pointer stack args (e.g. gfx_buffer_update data_ptr)
            -- must stay as full qwords — a blanket movss was truncating them.
            declare
               Param_Node : Node_Index := 0;
               Param_Idx  : Natural := 0;
            begin
               if Tree (Name_Node).Right_Child /= 0
                 and then Tree (Tree (Name_Node).Right_Child).Kind = AST_Arg_List
               then
                  Param_Node := Tree (Tree (Name_Node).Right_Child).Left_Child;
               end if;

               while Param_Node /= 0 loop
                  Param_Idx := Param_Idx + 1;
                  declare
                     Type_Name  : constant String :=
                       (if Tree (Param_Node).Right_Child /= 0 then
                           Raw_Lexeme
                             (Tree (Tree (Param_Node).Right_Child).Token_Index)
                        else "U64");
                     Upper_Name : constant String := To_Upper (Type_Name);
                     Is_Float   : constant Boolean :=
                       Upper_Name = "F64" or else Upper_Name = "REAL"
                       or else Upper_Name = "F32" or else Upper_Name = "FLOAT"
                       or else Upper_Name = "SINGLE"
                       or else Upper_Name = "DOUBLE";
                  begin
                     if Is_Float and then Param_Idx = 1 then
                        Transpiler_Native_HAL.Emit_Raw
                          ("  movq xmm0, rcx", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw
                          ("  cvtsd2ss xmm0, xmm0", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                     elsif Is_Float and then Param_Idx = 2 then
                        Transpiler_Native_HAL.Emit_Raw
                          ("  movq xmm1, rdx", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw
                          ("  cvtsd2ss xmm1, xmm1", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                     elsif Is_Float and then Param_Idx = 3 then
                        Transpiler_Native_HAL.Emit_Raw
                          ("  movq xmm2, r8", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw
                          ("  cvtsd2ss xmm2, xmm2", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                     elsif Is_Float and then Param_Idx = 4 then
                        Transpiler_Native_HAL.Emit_Raw
                          ("  movq xmm3, r9", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw
                          ("  cvtsd2ss xmm3, xmm3", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                     elsif Param_Idx >= 5 then
                        declare
                           In_Off  : constant Natural :=
                             304 + ((Param_Idx - 5) * 8);
                           Out_Off : constant Natural :=
                             32 + ((Param_Idx - 5) * 8);
                           In_Img  : constant String := Natural'Image (In_Off);
                           Out_Img : constant String := Natural'Image (Out_Off);
                        begin
                           Transpiler_Native_HAL.Emit_Raw
                             ("  mov r10, qword [rsp + " &
                              In_Img (In_Img'First + 1 .. In_Img'Last) & "]",
                              Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           if Is_Float then
                              Transpiler_Native_HAL.Emit_Raw
                                ("  movq xmm4, r10", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw
                                ("  cvtsd2ss xmm4, xmm4", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw
                                ("  movss dword [rsp + " &
                                 Out_Img (Out_Img'First + 1 .. Out_Img'Last) &
                                 "], xmm4",
                                 Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                           else
                              Transpiler_Native_HAL.Emit_Raw
                                ("  mov qword [rsp + " &
                                 Out_Img (Out_Img'First + 1 .. Out_Img'Last) &
                                 "], r10",
                                 Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                           end if;
                        end;
                     end if;
                  end;
                  Param_Node := Tree (Param_Node).Next_Sibling;
               end loop;
            end;

            Transpiler_Native_HAL.Emit_Raw ("  call rax", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);

            -- Win64: floating returns live in XMM0; ALB F64 vars are held in RAX.
            if Ret_Upper = "F32" or else Ret_Upper = "FLOAT" then
               Transpiler_Native_HAL.Emit_Raw ("  cvtss2sd xmm0, xmm0", Success);
               Transpiler_Native_HAL.Emit_Newline (Success);
               Transpiler_Native_HAL.Emit_Raw ("  movq rax, xmm0", Success);
               Transpiler_Native_HAL.Emit_Newline (Success);
            elsif Ret_Upper = "F64" or else Ret_Upper = "DOUBLE" or else
                  Ret_Upper = "REAL" or else Ret_Upper = "NUMBER"
            then
               Transpiler_Native_HAL.Emit_Raw ("  movq rax, xmm0", Success);
               Transpiler_Native_HAL.Emit_Newline (Success);
            end if;

            Transpiler_Native_HAL.Emit_Raw (".alb_ffi_exit_" & Target_Name & ":", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            Transpiler_Native_HAL.Emit_Raw ("  add rsp, 264", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            Transpiler_Native_HAL.Emit_Raw ("  ret", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            Transpiler_Native_HAL.Emit_Raw ("skip_proc_" & Target_Name & ":", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
         end;

         return;
      end if;

      if Target /= Backend_C then
         Fail_Current (Err_Type_Conflict);
         return;
      end if;

      if Is_Header then
         Transpiler_Native_HAL.Emit_FFI_Header_Include (Lib_Text, Success);
      else
         Transpiler_Native_HAL.Emit_FFI_Loader_Prelude (Success);
      end if;
      if not Success then return; end if;

      Transpiler_Native_HAL.Emit_Function_Decl_Start (Target_Name, Type_U64, Success);
      Transpiler_Native_HAL.Emit_Raw ("(", Success);
      Emit_Param_List (True);
      if not Success or else not Diag.Success then return; end if;
      Transpiler_Native_HAL.Emit_Raw (") {", Success);
      Transpiler_Native_HAL.Emit_Newline (Success);
      Transpiler_Native_HAL.Increase_Indent;

      if not Is_Header then
         Transpiler_Native_HAL.Emit_Indent (Success);
         Transpiler_Native_HAL.Emit_Raw ("typedef " & Native_Ret_C & " (*ALB_FFI_" & Target_Name & "_T)(", Success);
         Emit_Param_List (False);
         if not Success or else not Diag.Success then return; end if;
         Transpiler_Native_HAL.Emit_Raw (");", Success);
         Transpiler_Native_HAL.Emit_Newline (Success);

         Transpiler_Native_HAL.Emit_Indent (Success);
         Transpiler_Native_HAL.Emit_Raw ("static ALB_FFI_" & Target_Name & "_T ALB_FFI_" & Target_Name & " = NULL;", Success);
         Transpiler_Native_HAL.Emit_Newline (Success);

         Transpiler_Native_HAL.Emit_Indent (Success);
         Transpiler_Native_HAL.Emit_Raw ("if (!ALB_FFI_" & Target_Name & ") {", Success);
         Transpiler_Native_HAL.Emit_Newline (Success);
         Transpiler_Native_HAL.Increase_Indent;

         Transpiler_Native_HAL.Emit_Indent (Success);
         Transpiler_Native_HAL.Emit_Raw ("ALB_FFI_" & Target_Name & " = (ALB_FFI_" & Target_Name & "_T)ALB_Load_Foreign_Symbol(""" & Resolve_Vendor_Dll (Lib_Text) & """, """ & Raw_Name & """);", Success);
         Transpiler_Native_HAL.Emit_Newline (Success);

         Transpiler_Native_HAL.Emit_Indent (Success);
         if Target = Backend_C then
            Transpiler_Native_HAL.Emit_Raw ("if (!ALB_FFI_" & Target_Name & ") return ALB_U64_ZERO;", Success);
         else
            Transpiler_Native_HAL.Emit_Raw ("if (!ALB_FFI_" & Target_Name & ") return 0ULL;", Success);
         end if;
         Transpiler_Native_HAL.Emit_Newline (Success);

         Transpiler_Native_HAL.Decrease_Indent;
         Transpiler_Native_HAL.Emit_Indent (Success);
         Transpiler_Native_HAL.Emit_Raw ("}", Success);
         Transpiler_Native_HAL.Emit_Newline (Success);
      end if;

      Transpiler_Native_HAL.Emit_Indent (Success);
      if Tree (Decl_Node).Kind = AST_Procedure_Decl then
         if Is_Header then
            Transpiler_Native_HAL.Emit_Raw (Raw_Name & "(", Success);
         else
            Transpiler_Native_HAL.Emit_Raw ("ALB_FFI_" & Target_Name & "(", Success);
         end if;
         Emit_Call_Arg_List;
         if not Success or else not Diag.Success then return; end if;
         Transpiler_Native_HAL.Emit_Raw (");", Success);
         Transpiler_Native_HAL.Emit_Newline (Success);
      else
         if Ret_Upper = "STRING" then
            Transpiler_Native_HAL.Emit_Raw ("return (uint64_t)(uintptr_t)", Success);
         else
            Transpiler_Native_HAL.Emit_Raw ("return (uint64_t)", Success);
         end if;

         if Is_Header then
            Transpiler_Native_HAL.Emit_Raw (Raw_Name & "(", Success);
         else
            Transpiler_Native_HAL.Emit_Raw ("ALB_FFI_" & Target_Name & "(", Success);
         end if;

         Emit_Call_Arg_List;
         if not Success or else not Diag.Success then return; end if;
         Transpiler_Native_HAL.Emit_Raw (");", Success);
         Transpiler_Native_HAL.Emit_Newline (Success);
      end if;

      Transpiler_Native_HAL.Emit_Procedure_End (Target_Name, Success);
   end Emit_Foreign_Import;

   

   -- =========================================================================
   -- DA NATIVE KNOWLEDGE VAULT (PROLOG FACTS)
   -- =========================================================================
   type Fact_Record is record
      Pred_Hash : U32 := 0;
      Arg_Hash  : U32 := 0;
      Arg_Str   : String (1 .. 64) := (others => ' ');
      Arg_Len   : Natural := 0;
   end record;
   Fact_Map   : array (1 .. 128) of Fact_Record :=
     (others => (Pred_Hash => 0, Arg_Hash => 0, Arg_Str => (others => ' '), Arg_Len => 0));
   Fact_Count : Natural := 0;

   function Hash_String (S : String) return U32 is
      H : U32 := 5381;
   begin
      for I in S'Range loop
         H := (H * 33) + U32 (Character'Pos (S (I)));
      end loop;
      return H;
   end Hash_String;

   procedure Seed_Win32_Memory_Consts is
      procedure Put_Const (Name : String; Val : U64) is
         H : constant U32 := Hash_String (Name);
         Replaced : Boolean := False;
      begin
         for I in 1 .. Const_Count loop
            if Const_Vault (I).Hash = H then
               Const_Vault (I).Val := Val;
               Replaced := True;
               exit;
            end if;
         end loop;
         if not Replaced and then Const_Count < Max_Consts then
            Const_Count := Const_Count + 1;
            Const_Vault (Const_Count) := (H, Val);
         end if;
      end Put_Const;
   begin
      Put_Const ("PAGE_NOACCESS", 16#01#);
      Put_Const ("PAGE_READONLY", 16#02#);
      Put_Const ("PAGE_READWRITE", 16#04#);
      Put_Const ("PAGE_WRITECOPY", 16#08#);
      Put_Const ("PAGE_EXECUTE", 16#10#);
      Put_Const ("PAGE_EXECUTE_READ", 16#20#);
      Put_Const ("PAGE_EXECUTE_READWRITE", 16#40#);
      Put_Const ("PAGE_EXECUTE_WRITECOPY", 16#80#);
      Put_Const ("MEM_COMMIT", 16#1000#);
      Put_Const ("MEM_RESERVE", 16#2000#);
      Put_Const ("MEM_COMMIT_RESERVE", 16#3000#);
      Put_Const ("MEM_RELEASE", 16#8000#);
   end Seed_Win32_Memory_Consts;

   function Find_Prune_Proc (Name : String) return Natural is
      H : constant U32 := Hash_String (Name);
   begin
      for I in 1 .. Prune_Proc_Count loop
         if Prune_Procs (I).Name_Hash = H
           and then Prune_Procs (I).Name_Len = Name'Length
           and then Prune_Procs (I).Name (1 .. Name'Length) = Name
         then
            return I;
         end if;
      end loop;
      return 0;
   end Find_Prune_Proc;

   function Is_Prune_Reachable (Name : String) return Boolean is
      Idx : constant Natural := Find_Prune_Proc (Name);
   begin
      if not Prune_Dead_Mode or else Prune_Proc_Count = 0 then
         return True;
      end if;
      if Idx = 0 then
         return True;
      end if;
      return Prune_Procs (Idx).Reachable;
   end Is_Prune_Reachable;

   procedure Compute_Prune_Reachability (Root_Node : Node_Index) is
      Changed : Boolean := True;

      procedure Register_Decl (Node : Node_Index) is
         Name_Node : Node_Index;
      begin
         if Node = 0 then
            return;
         end if;

         if Tree (Node).Kind = AST_Module then
            declare
               M_Name_Node : constant Node_Index := Tree (Node).Left_Child;
               Old_Len     : constant Natural := Active_Module_Len;
               Old_Name    : constant String (1 .. 64) := Active_Module_Name;
            begin
               if M_Name_Node > 0 and then Tree (M_Name_Node).Token_Index > 0 then
                  declare
                     M_Lex : constant String :=
                       Raw_Lexeme (Tree (M_Name_Node).Token_Index);
                  begin
                     if M_Lex'Length <= 64 then
                        Active_Module_Len := M_Lex'Length;
                        Active_Module_Name (1 .. Active_Module_Len) := M_Lex;
                     end if;
                  end;
               end if;
               if Tree (Node).Right_Child > 0 then
                  Register_Decl (Tree (Tree (Node).Right_Child).Left_Child);
               end if;
               Active_Module_Len := Old_Len;
               Active_Module_Name := Old_Name;
               if Tree (Node).Next_Sibling > 0 then
                  Register_Decl (Tree (Node).Next_Sibling);
               end if;
               return;
            end;
         end if;

         if Tree (Node).Kind = AST_Procedure_Decl
           or else Tree (Node).Kind = AST_Function_Decl
         then
            Name_Node := Tree (Node).Left_Child;
            if Name_Node > 0 and then Tree (Name_Node).Token_Index > 0 then
               declare
                  Raw  : constant String := Raw_Lexeme (Tree (Name_Node).Token_Index);
                  Name : constant String := Scoped_Lexeme (Raw);
               begin
                  if Name'Length > 0
                    and then Name'Length <= 128
                    and then Prune_Proc_Count < Max_Prune_Procs
                    and then Find_Prune_Proc (Name) = 0
                  then
                     Prune_Proc_Count := Prune_Proc_Count + 1;
                     Prune_Procs (Prune_Proc_Count).Name_Hash := Hash_String (Name);
                     Prune_Procs (Prune_Proc_Count).Name (1 .. Name'Length) := Name;
                     Prune_Procs (Prune_Proc_Count).Name_Len := Name'Length;
                     Prune_Procs (Prune_Proc_Count).Decl_Node := Node;
                     Prune_Procs (Prune_Proc_Count).Body_Node := Tree (Node).Right_Child;
                     Prune_Procs (Prune_Proc_Count).Reachable := False;
                  end if;
               end;
            end if;
            if Tree (Node).Right_Child > 0 then
               Register_Decl (Tree (Node).Right_Child);
            end if;
            if Tree (Node).Next_Sibling > 0 then
               Register_Decl (Tree (Node).Next_Sibling);
            end if;
            return;
         end if;

         if Tree (Node).Left_Child > 0 then
            Register_Decl (Tree (Node).Left_Child);
         end if;
         if Tree (Node).Right_Child > 0 then
            Register_Decl (Tree (Node).Right_Child);
         end if;
         if Tree (Node).Next_Sibling > 0 then
            Register_Decl (Tree (Node).Next_Sibling);
         end if;
      end Register_Decl;

      procedure Mark_Calls_In (Node : Node_Index) is
         procedure Mark_Name (Name : String) is
            Idx : Natural;
         begin
            if Name'Length = 0 then
               return;
            end if;
            Idx := Find_Prune_Proc (Name);
            if Idx = 0 then
               declare
                  Scoped : constant String := Scoped_Lexeme (Name);
               begin
                  Idx := Find_Prune_Proc (Scoped);
               end;
            end if;
            if Idx > 0 and then not Prune_Procs (Idx).Reachable then
               Prune_Procs (Idx).Reachable := True;
               Changed := True;
            end if;
         end Mark_Name;
      begin
         if Node = 0 then
            return;
         end if;

         case Tree (Node).Kind is
            when AST_Func_Call | AST_Call_Stmt | AST_Constructor =>
               declare
                  Target : Node_Index := Tree (Node).Left_Child;
               begin
                  if Tree (Node).Kind = AST_Call_Stmt
                    and then Target > 0
                    and then Tree (Target).Kind = AST_Func_Call
                  then
                     Target := Tree (Target).Left_Child;
                  end if;
                  if Target > 0 and then Tree (Target).Token_Index > 0 then
                     Mark_Name (To_Upper (Raw_Lexeme (Tree (Target).Token_Index)));
                     Mark_Name (Scoped_Lexeme (Raw_Lexeme (Tree (Target).Token_Index)));
                     Mark_Name (Raw_Lexeme (Tree (Target).Token_Index));
                  end if;
               end;
            when others =>
               null;
         end case;

         if Tree (Node).Left_Child > 0 then
            Mark_Calls_In (Tree (Node).Left_Child);
         end if;
         if Tree (Node).Right_Child > 0 then
            Mark_Calls_In (Tree (Node).Right_Child);
         end if;
         if Tree (Node).Next_Sibling > 0 then
            Mark_Calls_In (Tree (Node).Next_Sibling);
         end if;
      end Mark_Calls_In;

      procedure Mark_Roots_From_Top (Node : Node_Index) is
      begin
         if Node = 0 then
            return;
         end if;

         if Tree (Node).Kind = AST_Procedure_Decl
           or else Tree (Node).Kind = AST_Function_Decl
         then
            null; -- not a root by itself
         elsif Tree (Node).Kind = AST_On_Block
           or else Tree (Node).Kind = AST_Module
           or else Tree (Node).Kind = AST_Block_Stmt
         then
            if Tree (Node).Left_Child > 0 then
               Mark_Calls_In (Tree (Node).Left_Child);
            end if;
            if Tree (Node).Right_Child > 0 then
               Mark_Calls_In (Tree (Node).Right_Child);
            end if;
         else
            Mark_Calls_In (Node);
         end if;

         if Tree (Node).Next_Sibling > 0 then
            Mark_Roots_From_Top (Tree (Node).Next_Sibling);
         end if;
      end Mark_Roots_From_Top;
   begin
      Prune_Proc_Count := 0;
      if not Prune_Dead_Mode or else Root_Node = 0 then
         return;
      end if;

      Register_Decl (Root_Node);
      Mark_Roots_From_Top (Root_Node);

      while Changed loop
         Changed := False;
         for I in 1 .. Prune_Proc_Count loop
            if Prune_Procs (I).Reachable
              and then Prune_Procs (I).Body_Node > 0
            then
               Mark_Calls_In (Prune_Procs (I).Body_Node);
            end if;
         end loop;
      end loop;

      if Prune_Dead_Verbose then
         for I in 1 .. Prune_Proc_Count loop
            if Prune_Procs (I).Reachable then
               Log ("prune-dead: keep "
                    & Prune_Procs (I).Name (1 .. Prune_Procs (I).Name_Len));
            else
               Log ("prune-dead: drop "
                    & Prune_Procs (I).Name (1 .. Prune_Procs (I).Name_Len));
            end if;
         end loop;
      end if;
   end Compute_Prune_Reachability;
   
   -- DA SMART FORGE: Ensures signatures match between Pass 1 and Pass 2
   function Forge_Backend_Name (Module : String; Lexeme : String; Is_Func : Boolean) return String is
      Base_Name : constant String :=
        (if Module'Length > 0
         then Module & "_" & Lexeme & (if Is_Func then "_func" else "")
         else Lexeme & (if Is_Func then "_func" else ""));
   begin
      return FASM_Safe_Symbol (Base_Name);
   end Forge_Backend_Name;

   procedure Register_Fact (Pred_Name : String; Arg_Name : String) is
      P_Hash : U32 := Hash_String (Pred_Name);
      A_Hash : U32 := Hash_String (Arg_Name);
   begin
      if Fact_Count < 128 then
         Fact_Count := Fact_Count + 1;
         Fact_Map (Fact_Count).Pred_Hash := P_Hash;
         Fact_Map (Fact_Count).Arg_Hash := A_Hash;
         Fact_Map (Fact_Count).Arg_Len := Arg_Name'Length;
         for I in 1 .. Arg_Name'Length loop
            Fact_Map (Fact_Count).Arg_Str (I) := Arg_Name (Arg_Name'First + I - 1);
         end loop;
         Log ("Mapped Prolog Fact: " & Pred_Name & "(" & Arg_Name & ")");
      end if;
   end Register_Fact;

   function Resolve_Fact (Pred_Name : String; Arg_Name : String) return Boolean is
      P_Hash : U32 := Hash_String (Pred_Name);
      A_Hash : U32 := Hash_String (Arg_Name);
   begin
      for I in 1 .. Fact_Count loop
         if Fact_Map (I).Pred_Hash = P_Hash and Fact_Map (I).Arg_Hash = A_Hash then
            return True;
         end if;
      end loop;
      return False;
   end Resolve_Fact;

   procedure Resolve_Fact_Bind
     (Pred_Name : String; Found : out Boolean; Bound_Str : out String; Bound_Len : out Natural)
   is
      P_Hash : U32 := Hash_String (Pred_Name);
   begin
      Found := False; Bound_Len := 0; Bound_Str := (others => ' ');
      for I in 1 .. Fact_Count loop
         if Fact_Map (I).Pred_Hash = P_Hash then
            Found := True;
            Bound_Len := Fact_Map (I).Arg_Len;
            Bound_Str := Fact_Map (I).Arg_Str;
            return; 
         end if;
      end loop;
   end Resolve_Fact_Bind;

   function Is_Real_Number_Text (Str : String) return Boolean is
   begin
      for Ch of Str loop
         if Ch = '.' or else Ch = 'e' or else Ch = 'E' then
            return True;
         end if;
      end loop;
      return False;
   end Is_Real_Number_Text;

   function Strip_Numeric_Separators (Str : String) return String is
      Result : String (1 .. Str'Length);
      Len    : Natural := 0;
   begin
      for Ch of Str loop
         if Ch /= '_'
           and then Ch /= ' '
           and then Ch /= ASCII.HT
           and then Ch /= ASCII.LF
           and then Ch /= ASCII.CR
         then
            Len := Len + 1;
            Result (Len) := Ch;
         end if;
      end loop;

      if Len = 0 then
         return "";
      end if;
      return Result (1 .. Len);
   end Strip_Numeric_Separators;

   function F64_To_U64_Bits is new Ada.Unchecked_Conversion (F64, U64);

   function Parse_Real_Literal_Bits
     (Str : String;
      Val : out U64) return Boolean
   is
      Clean : constant String := Strip_Numeric_Separators (Str);
   begin
      Val := 0;
      if Clean'Length = 0 then
         return False;
      end if;

      Val := F64_To_U64_Bits (F64'Value (Clean));
      return True;
   exception
      when others =>
         Val := 0;
         return False;
   end Parse_Real_Literal_Bits;

   function Static_Int_Pow_U64
     (Base     : U64;
      Exponent : U64) return U64
   is
      Result : U64 := 1;
      Factor : U64 := Base;
      Power  : U64 := Exponent;
   begin
      while Power > 0 loop
         if (Power mod 2) /= 0 then
            Result := Result * Factor;
         end if;
         Power := Power / 2;
         if Power > 0 then
            Factor := Factor * Factor;
         end if;
      end loop;
      return Result;
   end Static_Int_Pow_U64;

