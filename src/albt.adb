                  Transpiler_Native_HAL.Emit_File_Len_Start (Success);
                  Walk_AST (Tree (Node).Left_Child, Depth + 1, Left_Tag, Success, Diag);
                  Transpiler_Native_HAL.Emit_Expression_Close (Success);
                  Transpiler_Native_HAL.Emit_Expression_Close (Success);
               end if;
               if Target = Backend_FASM16 then
