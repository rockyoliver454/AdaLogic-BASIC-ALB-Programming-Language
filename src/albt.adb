   function Default_Out_Dir (Input : String) return String is
   begin
      case Target is
         when Backend_FASM =>
            return "fasm_" & Base_Name (Input);
         when Backend_FASM16 =>
            return "fasm16_" & Base_Name (Input);
         when Backend_C =>
            return "c_" & Base_Name (Input);
         when others =>
            return "native_" & Base_Name (Input);
      end case;
   end Default_Out_Dir;

   function Build_Mode_Supported_Target return Boolean is
   begin
      return Target = Backend_C
        or else Target = Backend_FASM
        or else Target = Backend_FASM16;
   end Build_Mode_Supported_Target;

   function Has_Shared_Library_Exports
     (Node : Node_Index) return Boolean
   is
   begin
      if Node = 0 then
         return False;
      end if;

      if Tree (Node).Kind in AST_Export_DLL | AST_Export_SO | AST_Export_Dylib then
         return True;
      end if;

      return
        Has_Shared_Library_Exports (Tree (Node).Left_Child)
        or else Has_Shared_Library_Exports (Tree (Node).Right_Child)
        or else Has_Shared_Library_Exports (Tree (Node).Next_Sibling);
   end Has_Shared_Library_Exports;

   function Has_Safe_Process_Features
     (Node : Node_Index) return Boolean
   is
   begin
      if Node = 0 then
         return False;
      end if;

      if Tree (Node).Kind in
        AST_Process_Handle_Decl
        | AST_Read_Process_Memory_Expr
        | AST_Read_Process_Memory_Stmt
        | AST_Write_Process_Memory_Stmt
        | AST_Monitor_Process_Memory_Stmt
        | AST_Inject_Code_Memory_Stmt
        | AST_Hijack_Process_Memory_Stmt
        | AST_Dump_Process_Memory_Stmt
        | AST_Terminate_Process_Stmt
        | AST_Create_Process_Stmt
        | AST_Elevate_Privileges_Stmt
        | AST_Hack_Memory_Stmt
        | AST_Inject_Code_Stmt
        | AST_Sniff_Network_Stmt
        | AST_Encrypt_File_Stmt
        | AST_Decrypt_File_Stmt
      then
         return True;
      end if;

      return
        Has_Safe_Process_Features (Tree (Node).Left_Child)
        or else Has_Safe_Process_Features (Tree (Node).Right_Child)
        or else Has_Safe_Process_Features (Tree (Node).Next_Sibling);
   end Has_Safe_Process_Features;

   function Has_Create_Window_Feature
     (Node : Node_Index) return Boolean
   is
   begin
      if Node = 0 then
         return False;
      end if;

      if Tree (Node).Kind = AST_Create_Window then
         return True;
      end if;

      return
        Has_Create_Window_Feature (Tree (Node).Left_Child)
        or else Has_Create_Window_Feature (Tree (Node).Right_Child)
        or else Has_Create_Window_Feature (Tree (Node).Next_Sibling);
   end Has_Create_Window_Feature;

   procedure Store_Path
     (Text   : String;
      Buffer : out String;
      Length : out Natural;
      Label  : String)
   is
   begin
      Buffer := (others => ' ');
      if Text'Length > Buffer'Length then
         Log ("FATAL: " & Label & " path is too long: " & Text);
         Length := 0;
      else
         Length := Text'Length;
         Buffer (Buffer'First .. Buffer'First + Length - 1) := Text;
      end if;
   end Store_Path;

   procedure Resolve_Output_Paths is
      Derived_Name : constant String := Default_Output_Name (Input_File (1 .. Input_Flen));
      Legacy_Name  : constant String := Legacy_Default_Output_Name;
   begin
      if Build_Mode and then Out_Dir_Len = 0 and then Output_Flen = 0 then
         declare
            D : constant String := Default_Out_Dir (Input_File (1 .. Input_Flen));
         begin
            Store_Path (D, Out_Dir, Out_Dir_Len, "output directory");
         end;
      end if;

      if Output_Flen > 0 and then Parent_Directory (Output_File (1 .. Output_Flen)) /= "" then
         declare
            Dir : constant String := Parent_Directory (Output_File (1 .. Output_Flen));
         begin
            Store_Path (Dir, Final_Dir, Final_Dir_Len, "output directory");
         end;
         return;
      end if;

      if Build_Mode then
         if Out_Dir_Len = 0 then
            declare
               D : constant String := Default_Out_Dir (Input_File (1 .. Input_Flen));
            begin
               Store_Path (D, Out_Dir, Out_Dir_Len, "output directory");
            end;
         end if;

         if Out_Dir_Len > 0 then
            Store_Path (Out_Dir (1 .. Out_Dir_Len), Final_Dir, Final_Dir_Len, "output directory");
         end if;

         if Output_Flen = 0 then
            declare
               N : constant String :=
                 Ada.Directories.Compose (Final_Dir (1 .. Final_Dir_Len), Derived_Name);
            begin
               Store_Path (N, Output_File, Output_Flen, "output");
            end;
         else
            declare
               N : constant String :=
                 Ada.Directories.Compose
                   (Final_Dir (1 .. Final_Dir_Len),
                    Output_File (1 .. Output_Flen));
            begin
               Store_Path (N, Output_File, Output_Flen, "output");
            end;
         end if;
      else
         if Output_Flen = 0 then
            if Out_Dir_Len > 0 then
               declare
                  N : constant String :=
                    Ada.Directories.Compose
                      (Out_Dir (1 .. Out_Dir_Len),
                       Derived_Name);
               begin
                  Store_Path (N, Output_File, Output_Flen, "output");
                  Store_Path (Out_Dir (1 .. Out_Dir_Len), Final_Dir, Final_Dir_Len, "output directory");
               end;
            else
               Store_Path (Legacy_Name, Output_File, Output_Flen, "output");
            end if;
         elsif Out_Dir_Len > 0 and then not Is_Absolute_Path (Output_File (1 .. Output_Flen)) then
            declare
               N : constant String :=
                 Ada.Directories.Compose
                   (Out_Dir (1 .. Out_Dir_Len),
                    Output_File (1 .. Output_Flen));
            begin
               Store_Path (N, Output_File, Output_Flen, "output");
               Store_Path (Out_Dir (1 .. Out_Dir_Len), Final_Dir, Final_Dir_Len, "output directory");
            end;
         end if;
      end if;

      if Final_Dir_Len = 0 and then Output_Flen > 0 then
         declare
            Dir : constant String := Parent_Directory (Output_File (1 .. Output_Flen));
         begin
            if Dir'Length > 0 then
               Store_Path (Dir, Final_Dir, Final_Dir_Len, "output directory");
            end if;
         end;
      end if;
   end Resolve_Output_Paths;

   procedure Free_Argument_List
     (Args : in out GNAT.OS_Lib.Argument_List) is
   begin
      for I in Args'Range loop
         GNAT.OS_Lib.Free (Args (I));
      end loop;
   end Free_Argument_List;

   function Spawn_And_Check
     (Working_Directory : String;
      Program_Name      : String;
      Args              : GNAT.OS_Lib.Argument_List) return Boolean
   is
      Original_Directory : constant String := Ada.Directories.Current_Directory;
      Exit_Code          : Integer := -1;
   begin
      Ada.Directories.Set_Directory (Working_Directory);
      Exit_Code := GNAT.OS_Lib.Spawn (Program_Name, Args);
      Ada.Directories.Set_Directory (Original_Directory);
      return Exit_Code = 0;
   exception
      when others =>
         begin
            Ada.Directories.Set_Directory (Original_Directory);
         exception
            when others =>
               null;
         end;
         return False;
   end Spawn_And_Check;

   procedure Copy_File_Bytes
     (Source_Path : String;
      Dest_Path   : String;
      Success     : in out Boolean)
   is
      Source_File  : Ada.Streams.Stream_IO.File_Type;
      Dest_File    : Ada.Streams.Stream_IO.File_Type;
      Buffer       : Ada.Streams.Stream_Element_Array (1 .. 8192);
      Last         : Ada.Streams.Stream_Element_Offset;
      Source_Open  : Boolean := False;
      Dest_Open    : Boolean := False;
      Dest_Parent  : constant String := Parent_Directory (Dest_Path);
   begin
      if not Success then
         return;
      end if;

      if Dest_Parent'Length > 0 then
         Ada.Directories.Create_Path (Dest_Parent);
      end if;

      Ada.Streams.Stream_IO.Open
        (Source_File,
         Ada.Streams.Stream_IO.In_File,
         Source_Path);
      Source_Open := True;

      Ada.Streams.Stream_IO.Create
        (Dest_File,
         Ada.Streams.Stream_IO.Out_File,
         Dest_Path);
      Dest_Open := True;

      while not Ada.Streams.Stream_IO.End_Of_File (Source_File) loop
         Ada.Streams.Stream_IO.Read (Source_File, Buffer, Last);
         if Last >= Buffer'First then
            Ada.Streams.Stream_IO.Write (Dest_File, Buffer (Buffer'First .. Last));
         end if;
      end loop;

      Ada.Streams.Stream_IO.Close (Source_File);
      Ada.Streams.Stream_IO.Close (Dest_File);
   exception
      when others =>
         if Source_Open then
            begin
               Ada.Streams.Stream_IO.Close (Source_File);
            exception
               when others =>
                  null;
            end;
         end if;

         if Dest_Open then
            begin
               Ada.Streams.Stream_IO.Close (Dest_File);
            exception
               when others =>
                  null;
            end;
         end if;

         Success := False;
   end Copy_File_Bytes;

   procedure Copy_Directory_Tree
     (Source_Dir : String;
      Dest_Dir   : String;
      Success    : in out Boolean)
   is
      Search    : Ada.Directories.Search_Type;
      Dir_Entry : Ada.Directories.Directory_Entry_Type;
   begin
      if not Success then
         return;
      end if;

      Ada.Directories.Create_Path (Dest_Dir);
      Ada.Directories.Start_Search (Search, Source_Dir, "*");

      while Ada.Directories.More_Entries (Search) loop
         Ada.Directories.Get_Next_Entry (Search, Dir_Entry);

         declare
            Name : constant String := Ada.Directories.Simple_Name (Dir_Entry);
            Src  : constant String := Ada.Directories.Full_Name (Dir_Entry);
            Dst  : constant String := Ada.Directories.Compose (Dest_Dir, Name);
         begin
            if Name /= "." and then Name /= ".." then
               case Ada.Directories.Kind (Dir_Entry) is
                  when Ada.Directories.Directory =>
                     Copy_Directory_Tree (Src, Dst, Success);
                  when Ada.Directories.Ordinary_File =>
                     Copy_File_Bytes (Src, Dst, Success);
                  when others =>
                     null;
               end case;
            end if;
         end;

         exit when not Success;
      end loop;

      Ada.Directories.End_Search (Search);
   exception
      when others =>
         begin
            Ada.Directories.End_Search (Search);
         exception
            when others =>
               null;
         end;
         Success := False;
   end Copy_Directory_Tree;

   procedure Copy_Required_File
     (Source_Path : String;
      Dest_Path   : String;
      Label       : String;
      Success     : in out Boolean) is
   begin
      if not Success then
         return;
      end if;

      if not Ada.Directories.Exists (Source_Path) then
         Log ("FATAL: Missing required " & Label & " file: " & Source_Path);
         Success := False;
         return;
      end if;

      Copy_File_Bytes (Source_Path, Dest_Path, Success);
      if not Success then
         Log ("FATAL: Failed copying " & Label & " to " & Dest_Path);
      end if;
   end Copy_Required_File;

   procedure Copy_Required_Directory
     (Source_Dir : String;
      Dest_Dir   : String;
      Label      : String;
      Success    : in out Boolean) is
   begin
      if not Success then
         return;
      end if;

      if not Ada.Directories.Exists (Source_Dir) then
         Log ("FATAL: Missing required " & Label & " directory: " & Source_Dir);
         Success := False;
         return;
      end if;

      Copy_Directory_Tree (Source_Dir, Dest_Dir, Success);
      if not Success then
         Log ("FATAL: Failed copying " & Label & " to " & Dest_Dir);
      end if;
   end Copy_Required_Directory;

   function Support_Root return String is
      -- Canonical kit layout: <sdk>/support (WIN64A.INC, SDL3, FASM include trees).
      -- Optional override: ALB_SUPPORT. Never require a ColonySim folder name.
      Env_Support : constant String :=
        (if Ada.Environment_Variables.Exists ("ALB_SUPPORT")
         then Ada.Environment_Variables.Value ("ALB_SUPPORT")
         else "");
      Command_Dir : constant String :=
        Parent_Directory (Ada.Command_Line.Command_Name);
      Kit_Root : constant String :=
        (if Command_Dir'Length > 0
         then Parent_Directory (Command_Dir)
         else "");
      CWD_Support : constant String :=
        Ada.Directories.Compose (Ada.Directories.Current_Directory, "support");
      Kit_Support : constant String :=
        (if Kit_Root'Length > 0
         then Ada.Directories.Compose (Kit_Root, "support")
         else "");
      Sdk_Env : constant String :=
        (if Ada.Environment_Variables.Exists ("ALB_SDK_ROOT")
         then Ada.Environment_Variables.Value ("ALB_SDK_ROOT")
         else "");
      Sdk_Support : constant String :=
        (if Sdk_Env'Length > 0
         then Ada.Directories.Compose (Sdk_Env, "support")
         else "");
   begin
      if Env_Support'Length > 0 and then Ada.Directories.Exists (Env_Support) then
         return Env_Support;
      elsif Sdk_Support'Length > 0 and then Ada.Directories.Exists (Sdk_Support) then
         return Sdk_Support;
      elsif Kit_Support'Length > 0 and then Ada.Directories.Exists (Kit_Support) then
         return Kit_Support;
      elsif Ada.Directories.Exists (CWD_Support) then
         return CWD_Support;
      else
         -- Prefer reporting the kit-relative path in errors when possible.
         if Kit_Support'Length > 0 then
            return Kit_Support;
         end if;
         return CWD_Support;
      end if;
   end Support_Root;

   procedure Stage_FASM_Dependencies
     (Stage_Dir : String;
      Success   : in out Boolean)
   is
      Root : constant String := Support_Root;
   begin
      Copy_Required_File
        (Ada.Directories.Compose (Root, "WIN64A.INC"),
         Ada.Directories.Compose (Stage_Dir, "win64a.inc"),
         "FASM header",
         Success);
      Copy_Required_Directory
        (Ada.Directories.Compose (Root, "MACRO"),
         Ada.Directories.Compose (Stage_Dir, "macro"),
         "FASM macro include tree",
         Success);
      Copy_Required_Directory
        (Ada.Directories.Compose (Root, "EQUATES"),
         Ada.Directories.Compose (Stage_Dir, "equates"),
         "FASM equates include tree",
         Success);
      Copy_Required_Directory
        (Ada.Directories.Compose (Root, "API"),
         Ada.Directories.Compose (Stage_Dir, "api"),
         "FASM API include tree",
         Success);
      Copy_Required_Directory
        (Ada.Directories.Compose (Root, "ENCODING"),
         Ada.Directories.Compose (Stage_Dir, "encoding"),
         "FASM encoding include tree",
         Success);
      Copy_Required_Directory
        (Ada.Directories.Compose (Root, "PCOUNT"),
         Ada.Directories.Compose (Stage_Dir, "pcount"),
         "FASM pcount include tree",
         Success);
      Copy_Required_Directory
        (Ada.Directories.Compose (Root, "SDL3"),
         Ada.Directories.Compose (Stage_Dir, "SDL3"),
         "SDL3 headers",
         Success);
      Copy_Required_File
        (Ada.Directories.Compose (Root, "SDL3.dll"),
         Ada.Directories.Compose (Stage_Dir, "SDL3.dll"),
         "SDL3 runtime",
         Success);
   end Stage_FASM_Dependencies;

   procedure Stage_C_Dependencies
     (Stage_Dir : String;
      Success   : in out Boolean)
   is
      Root      : constant String := Support_Root;
      Repo_Root : constant String := Parent_Directory (Root);

      procedure Copy_Optional_File
        (Source_Path : String;
         Dest_Path   : String;
         Label       : String) is
      begin
         if Ada.Directories.Exists (Source_Path) then
            Copy_File_Bytes (Source_Path, Dest_Path, Success);
            if not Success then
               Log ("FATAL: Failed copying optional " & Label & " to " & Dest_Path);
            end if;
         end if;
      end Copy_Optional_File;
   begin
      Copy_Required_Directory
        (Ada.Directories.Compose (Root, "SDL3"),
         Ada.Directories.Compose (Stage_Dir, "SDL3"),
         "SDL3 headers",
         Success);
      Copy_Required_File
        (Ada.Directories.Compose (Root, "SDL3.dll"),
         Ada.Directories.Compose (Stage_Dir, "SDL3.dll"),
         "SDL3 runtime",
         Success);

      Copy_Optional_File
        (Ada.Directories.Compose (Root, "libSDL3.a"),
         Ada.Directories.Compose (Stage_Dir, "libSDL3.a"),
         "SDL3 import library");
      Copy_Optional_File
        (Ada.Directories.Compose (Root, "SDL3.def"),
         Ada.Directories.Compose (Stage_Dir, "SDL3.def"),
         "SDL3 definition file");

      if Success and then Repo_Root'Length > 0 then
         if not Ada.Directories.Exists (Ada.Directories.Compose (Stage_Dir, "libSDL3.a")) then
            Copy_Optional_File
              (Ada.Directories.Compose
                 (Ada.Directories.Compose
                    (Ada.Directories.Compose (Repo_Root, "_c_extended_smoke_builds"),
                     "squad_cube_network_game"),
                  "libSDL3.a"),
               Ada.Directories.Compose (Stage_Dir, "libSDL3.a"),
               "SDL3 import library");
         end if;

         if not Ada.Directories.Exists (Ada.Directories.Compose (Stage_Dir, "SDL3.def")) then
            Copy_Optional_File
              (Ada.Directories.Compose
                 (Ada.Directories.Compose
                    (Ada.Directories.Compose (Repo_Root, "_c_extended_smoke_builds"),
                     "squad_cube_network_game"),
                  "SDL3.def"),
               Ada.Directories.Compose (Stage_Dir, "SDL3.def"),
               "SDL3 definition file");
         end if;
      end if;
   end Stage_C_Dependencies;

   procedure Stage_C_Build_Scripts
     (Stage_Dir   : String;
      Source_Path : String;
      Success     : in out Boolean)
   is
      Stem       : constant String := Base_Name (Source_Path);
      Source_C   : constant String := File_Name_With_Extension (Source_Path);
      EXE_Name   : constant String := Stem & ".exe";
      DLL_Name   : constant String := Stem & ".dll";
      SO_Name    : constant String := "lib" & Stem & ".so";
      DYLIB_Name : constant String := "lib" & Stem & ".dylib";
      File       : Ada.Text_IO.File_Type;
   begin
      begin
         Ada.Text_IO.Create
           (File,
            Ada.Text_IO.Out_File,
            Ada.Directories.Compose (Stage_Dir, "build_windows_gcc.bat"));
         Ada.Text_IO.Put_Line (File, "@echo off");
         Ada.Text_IO.Put_Line
           (File,
            "gcc -std=c89 -O2 -I. " &
            Source_C &
            " -L. -lSDL3 -lws2_32 -lwinmm -lole32 -loleaut32 -limm32 -lsetupapi -lversion -lshell32 -luser32 -lgdi32 -lm -o " &
            EXE_Name);
         Ada.Text_IO.Close (File);

         Ada.Text_IO.Create
           (File,
            Ada.Text_IO.Out_File,
            Ada.Directories.Compose (Stage_Dir, "build_windows_cl.bat"));
         Ada.Text_IO.Put_Line (File, "@echo off");
         Ada.Text_IO.Put_Line (File, "REM Requires SDL3 import libs for MSVC.");
         Ada.Text_IO.Put_Line
           (File,
            "cl /nologo /I. " &
            Source_C &
            " /link SDL3.lib ws2_32.lib winmm.lib ole32.lib oleaut32.lib imm32.lib setupapi.lib version.lib shell32.lib user32.lib gdi32.lib /out:" &
            EXE_Name);
         Ada.Text_IO.Close (File);

         Ada.Text_IO.Create
           (File,
            Ada.Text_IO.Out_File,
            Ada.Directories.Compose (Stage_Dir, "build_shared_windows.bat"));
         Ada.Text_IO.Put_Line (File, "@echo off");
         Ada.Text_IO.Put_Line (File, "REM Shared library (EXPORT_DLL). Prefer gcc; fallback cl.");
         Ada.Text_IO.Put_Line (File, "where gcc >nul 2>nul");
         Ada.Text_IO.Put_Line (File, "if %ERRORLEVEL%==0 (");
         Ada.Text_IO.Put_Line
           (File,
            "  gcc -std=c89 -O2 -shared -I. " &
            Source_C &
            " -L. -lSDL3 -lws2_32 -lwinmm -lole32 -loleaut32 -limm32 -lsetupapi -lversion -lshell32 -luser32 -lgdi32 -lm -o " &
            DLL_Name);
         Ada.Text_IO.Put_Line (File, "  exit /b %ERRORLEVEL%");
         Ada.Text_IO.Put_Line (File, ")");
         Ada.Text_IO.Put_Line (File, "cl /nologo /LD /I. " & Source_C & " /link ws2_32.lib SDL3.lib /out:" & DLL_Name);
         Ada.Text_IO.Close (File);

         Ada.Text_IO.Create
           (File,
            Ada.Text_IO.Out_File,
            Ada.Directories.Compose (Stage_Dir, "build_shared_posix.sh"));
         Ada.Text_IO.Put_Line (File, "#!/bin/sh");
         Ada.Text_IO.Put_Line (File, "# Requires SDL3 development libraries for full link.");
         Ada.Text_IO.Put_Line (File, "cc -shared -fPIC -I. " & Source_C & " -o " & SO_Name & " -ldl -lpthread -lm");
         Ada.Text_IO.Close (File);

         Ada.Text_IO.Create
           (File,
            Ada.Text_IO.Out_File,
            Ada.Directories.Compose (Stage_Dir, "build_shared_macos.sh"));
         Ada.Text_IO.Put_Line (File, "#!/bin/sh");
         Ada.Text_IO.Put_Line (File, "# Requires SDL3 development libraries for full link.");
         Ada.Text_IO.Put_Line (File, "cc -dynamiclib -fPIC -I. " & Source_C & " -o " & DYLIB_Name & " -lm");
         Ada.Text_IO.Close (File);
      exception
         when others =>
            Success := False;
      end;
   end Stage_C_Build_Scripts;

   function Run_FASM_Pass
     (Stage_Dir : String;
      ASM_Path  : String) return Boolean
   is
      ASM_File_Name : constant String := File_Name_With_Extension (ASM_Path);
   begin
      declare
         Args : GNAT.OS_Lib.Argument_List (1 .. 1) :=
           (1 => new String'(ASM_File_Name));
         OK : constant Boolean := Spawn_And_Check (Stage_Dir, "fasm", Args);
      begin
         Free_Argument_List (Args);
         if OK then
            return True;
         end if;
      end;

      declare
         Args : GNAT.OS_Lib.Argument_List (1 .. 1) :=
           (1 => new String'(ASM_File_Name));
         OK : constant Boolean := Spawn_And_Check (Stage_Dir, "fasm.exe", Args);
      begin
         Free_Argument_List (Args);
         return OK;
      end;
   end Run_FASM_Pass;

   -- =========================================================================
   -- DA INCLUDE HISTORY VAULT
   -- =========================================================================
   Max_Includes : constant := 16384;

   subtype Include_Path is String (1 .. Max_Path_Len);
   Include_Vault : array (1 .. Max_Includes) of Include_Path :=
     (others => (others => ' '));
   Include_Lens  : array (1 .. Max_Includes) of Natural := (others => 0);
   Include_Count : Natural := 0;

   function Is_Already_Included (File_Name : String) return Boolean is
      Check_Len : Natural := File_Name'Length;
   begin
      for I in 1 .. Max_Includes loop
         if I <= Include_Count then
            if Include_Lens (I) = Check_Len then
               if Include_Vault (I) (1 .. Check_Len) = File_Name then
                  return True;
               end if;
            end if;
         end if;
      end loop;
      return False;
   end Is_Already_Included;

   --  procedure Register_Include (File_Name : String; Success : in out Boolean) is
   --  begin
   --     if Include_Count < Max_Includes then
   --        Include_Count := Include_Count + 1;
   --        Include_Lens (Include_Count) := File_Name'Length;
   --        Include_Vault (Include_Count) (1 .. File_Name'Length) := File_Name;
   --     else
   --        Log ("FATAL: Maximum include limit reached! Architecture breach.");
   --        Success := False;
   --     end if;
   --  end Register_Include;
   procedure Register_Include (File_Name : String; Success : in out Boolean; ID : out Natural) is
   begin
      if Include_Count < Max_Includes then
         Include_Count := Include_Count + 1;
         Include_Lens (Include_Count) := File_Name'Length;
         Include_Vault (Include_Count) (1 .. File_Name'Length) := File_Name;
         ID := Include_Count;
      else
         Log ("FATAL: Maximum include limit reached!");
         Success := False;
         ID := 0;
      end if;
   end Register_Include;

   -- =========================================================================
   -- DA SOURCE MAP VAULT (For pinpoint error tracking across includes)
   -- =========================================================================
   Max_Absolute_Lines : constant := 131072;
   type Source_Map_Record is record
      File_ID  : Natural := 1;
      Rel_Line : Positive := 1;
   end record;
   Source_Map : array (1 .. Max_Absolute_Lines) of Source_Map_Record := 
     (others => (File_ID => 1, Rel_Line => 1));
   Abs_Line_Count : Natural := 1;
   
   type File_Buffer_Ptr is access String;
   procedure Free_File_Buffer is new Ada.Unchecked_Deallocation (String, File_Buffer_Ptr);

   -- =========================================================================
   -- DA NATIVE SYMBOL VAULT
   -- =========================================================================
   Current_Scope : Natural := 0;
   Local_Offset  : Integer := 0;
   Next_Var_Addr : U64 := 16#140015000#;
   FASM16_Long_Trap_Counter : Natural := 0;
   
   -- DA STRUCT NAME VAULT
   Max_Struct_Names : constant := 64;
   Struct_Name_Vault : array (1 .. Max_Struct_Names) of String (1 .. 64) := 
     (others => (others => ' '));
   Struct_Name_Lens  : array (1 .. Max_Struct_Names) of Natural := (others => 0);
   Struct_Name_Count : Natural := 0;
   
   Struct_Size_Vault : array (1 .. Max_Struct_Names) of Natural := (others => 0);

   function ALB_Size_Bytes (Tag : ALB_Type_Tag) return Natural is
   begin
      case Tag is
         when Type_U8 | Type_S8 | Type_HW8 | Type_Boolean | Type_Char =>
            return 1;

         when Type_U16 | Type_S16 | Type_HW16 =>
            return 2;

         when Type_U32 | Type_S32 | Type_HW32 | Type_F32 =>
            return 4;

         when Type_U64 | Type_S64 | Type_HW64 | Type_F64 | Type_F32x2 =>
            return 8;

         when Type_Pure | Type_U128 | Type_S128 | Type_F128
            | Type_F32x4 | Type_Mat2x2 =>
            return 16;

         when Type_Mat3x3 =>
            return 48;

         when Type_Mat4x4 =>
            return 64;

         when others =>
            return 8;
      end case;
   end ALB_Size_Bytes;

   function Get_Struct_Size_Bytes (SID : Natural) return Natural is
   begin
      if SID in 1 .. Max_Struct_Names
        and then Struct_Size_Vault (SID) > 0
      then
         return Struct_Size_Vault (SID);
      end if;

      return 8;
   end Get_Struct_Size_Bytes;

   -- DA COMPILE-TIME CONSTANT VAULT
   Max_Consts : constant := 2048;
   type Const_Record is record
      Hash : U32;
      Val  : U64;
   end record;
   Const_Vault : array (1 .. Max_Consts) of Const_Record := (others => (0, 0));
   Const_Count : Natural := 0;

   -- --prune-dead reachability vault (procedure / function decls)
   Max_Prune_Procs : constant := 4096;
   type Prune_Proc_Record is record
      Name_Hash  : U32 := 0;
      Name       : String (1 .. 128) := (others => ' ');
      Name_Len   : Natural := 0;
      Decl_Node  : Node_Index := 0;
      Body_Node  : Node_Index := 0;
      Reachable  : Boolean := False;
   end record;
   Prune_Procs      : array (1 .. Max_Prune_Procs) of Prune_Proc_Record;
   Prune_Proc_Count : Natural := 0;

   procedure Seed_Win32_Memory_Consts;
   function Find_Prune_Proc (Name : String) return Natural;
   function Is_Prune_Reachable (Name : String) return Boolean;
   procedure Compute_Prune_Reachability (Root_Node : Node_Index);
   
   procedure Register_Struct_Name (SID : Natural; Name : String) is
   begin
      if SID in 1 .. Max_Struct_Names then
         Struct_Name_Lens (SID) := Name'Length;
         Struct_Name_Vault (SID) (1 .. Name'Length) := Name;
         if SID > Struct_Name_Count then
            Struct_Name_Count := SID;
         end if;
      end if;
   end Register_Struct_Name;

   function Get_Struct_Name (Struct_ID : Natural) return String is
   begin
      if Struct_ID in 1 .. Max_Struct_Names 
        and then Struct_Name_Lens (Struct_ID) > 0 
      then
         return Struct_Name_Vault (Struct_ID) (1 .. Struct_Name_Lens (Struct_ID));
      end if;
      return "UNKNOWN_STRUCT";
   end Get_Struct_Name;
   
   function Upper_ASCII (S : String) return String is
      R : String (1 .. S'Length);
      C : Character;
   begin
      for I in S'Range loop
         C := S (I);

         if C >= 'a' and then C <= 'z' then
            R (I - S'First + 1) :=
              Character'Val (Character'Pos (C) - 32);
         else
            R (I - S'First + 1) := C;
         end if;
      end loop;

      return R;
   end Upper_ASCII;

