                        end if;
                        Transpiler_Native_HAL.Emit_Raw
                          ("), ""wb""); if (_alb_fp_" & Label_Suffix & ") { const char* _alb_text_" & Label_Suffix & " = (const char*)(uintptr_t)(",
                           Success);
                        Walk_AST (Var_Node, Depth + 1, Right_Tag, Success, Diag);
                        if not Success then
                           return;
                        end if;
                        Transpiler_Native_HAL.Emit_Raw
                          ("); if (_alb_text_" & Label_Suffix & ") { fwrite(_alb_text_" & Label_Suffix & ", 1, strlen(_alb_text_" & Label_Suffix & "), _alb_fp_" & Label_Suffix & "); } fclose(_alb_fp_" & Label_Suffix & "); } }",
                           Success);
                     else
                        Transpiler_Native_HAL.Emit_Raw ("{ ", Success);
                        Transpiler_Native_HAL.Emit_Raw
                          ("FILE* _alb_fp_" & Label_Suffix & " = fopen((const char*)(uintptr_t)(",
                           Success);
                        Walk_AST (File_Node, Depth + 1, Right_Tag, Success, Diag);
