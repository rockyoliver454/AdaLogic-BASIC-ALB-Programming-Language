      function Firewall_Allows
        (Firewall_Index : Natural;
         Target_Name    : String;
         Want_Read      : Boolean;
         Want_Write     : Boolean) return Boolean
      is
         Matched      : Boolean := False;
         Allowed_Read : Boolean := False;
         Allowed_Write : Boolean := False;
      begin
         if Firewall_Index = 0 then
            return True;
         end if;

         for I in Firewalls (Firewall_Index).Rule_First ..
                  Firewalls (Firewall_Index).Rule_First + Firewalls (Firewall_Index).Rule_Count - 1
         loop
            if Firewall_Rules (I).Active
              and then Firewall_Rules (I).Target_Len = Target_Name'Length
              and then Firewall_Rules (I).Target_Name (1 .. Target_Name'Length) = Target_Name
            then
               Matched := True;
               Allowed_Read := Allowed_Read or Firewall_Rules (I).Allow_Read;
               Allowed_Write := Allowed_Write or Firewall_Rules (I).Allow_Write;
            end if;
         end loop;

         if Matched then
            return (not Want_Read or else Allowed_Read)
              and then (not Want_Write or else Allowed_Write);
         end if;

         return not Firewalls (Firewall_Index).Deny_All;
      end Firewall_Allows;

      procedure Ensure_Firewall_Access
        (Expr_Node   : Node_Index;
         Need_Read   : Boolean;
         Need_Write  : Boolean;
         Origin_Node : Node_Index;
         Success     : in out Boolean;
         Diag        : in out Compiler_Diagnostic)
      is
         Base_Name : constant String := Access_Base_Scoped_Name (Expr_Node);
      begin
         if Current_Firewall = 0 or else Base_Name'Length = 0 then
            return;
         end if;

         if not Firewall_Allows (Current_Firewall, Base_Name, Need_Read, Need_Write) then
            Fail_Node (Origin_Node, Err_Sandbox_Violation, Base_Name, Success, Diag);
         end if;
      end Ensure_Firewall_Access;

      procedure Emit_Global_String_Label
        (Label_Name : String;
         Text       : String)
      is
      begin
         Transpiler_Native_HAL.Set_Global_Buffer_Mode (True);
         Transpiler_Native_HAL.Emit_Raw ("  " & Label_Name & " db """, Emit_Success);
         for I in Text'Range loop
            if Text (I) = '"' then
               Transpiler_Native_HAL.Emit_Raw ("""""", Emit_Success);
            else
               Transpiler_Native_HAL.Emit_Raw (Text (I .. I), Emit_Success);
            end if;
         end loop;
         Transpiler_Native_HAL.Emit_Raw (""",0", Emit_Success);
         Transpiler_Native_HAL.Emit_Newline (Emit_Success);
         Transpiler_Native_HAL.Set_Global_Buffer_Mode (False);
      end Emit_Global_String_Label;

