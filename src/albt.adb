   function Hash_Name (Name : String) return U32 is
      H : U32 := 5381;
   begin
      for I in Name'Range loop
         H := (H * 33) + U32 (Character'Pos (Name (I)));
      end loop;
      return H;
   end Hash_Name;

   function Is_Tracked_Out_Param (Name_Hash : U32) return Boolean is
   begin
      for I in 1 .. Out_Param_Count loop
         if Out_Param_Name_Hashes (I) = Name_Hash then
            return True;
         end if;
      end loop;
      return False;
   end Is_Tracked_Out_Param;

   function FASM_Target_Is_Out (Name : String) return Boolean is
   begin
      return Is_Tracked_Out_Param (Hash_Name (Name));
   end FASM_Target_Is_Out;
