                              return;
                           end if;

                           Transpiler_Native_HAL.Emit_Raw ("  push ax", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);

                           Walk_AST (File_Node, Depth + 1, Right_Tag, Success, Diag);
                           if not Success then
                              return;
                           end if;

                           Transpiler_Native_HAL.Emit_Raw ("  pop si", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Transpiler_Native_HAL.Emit_Raw ("  mov cx, ", Success);
                           Transpiler_Native_HAL.Emit_Literal_U64 (U64 (Byte_Count), Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Transpiler_Native_HAL.Emit_Raw ("  call ALB16_File_Flush", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
