                              Transpiler_Native_HAL.Emit_Raw ("  mov " & Save_Reg & ", rax", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);

                              Walk_AST (Tree (Node).Right_Child, Depth + 1, Right_Tag, Success, Diag);
                              -- Walk leaves F32/F64 as F64 IEEE bits in rax.
                              -- Integers must use cvtsi2sd (NOT movq) — movq
                              -- reinterprets the integer bit-pattern as a
                              -- double and silently breaks mixes like
                              -- frames * 0.012 (camera orbits, timers, etc.).
                              if Right_Tag in Type_F32 | Type_F64
                                or else Right_Expr_Tag in Type_F32 | Type_F64
