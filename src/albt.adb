                            Transpiler_Native_HAL.Emit_Raw ("  mov rax, rdx", Success);
                           
                        -- DA NEW FIX: Bitwise & Shift Operators!
                        elsif Mapped_Op = OP_AND or else Mapped_Op = OP_LOGICAL_AND then Transpiler_Native_HAL.Emit_Raw ("  and rax, rbx", Success);
                        elsif Mapped_Op = OP_OR or else Mapped_Op = OP_LOGICAL_OR then Transpiler_Native_HAL.Emit_Raw ("  or rax, rbx", Success);
                        elsif Mapped_Op = OP_XOR then Transpiler_Native_HAL.Emit_Raw ("  xor rax, rbx", Success);
