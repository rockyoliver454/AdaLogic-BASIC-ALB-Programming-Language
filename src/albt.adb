         Emit_Global_Line ("");
      end Ensure_Process_Runtime_C;

      -- Track 8 (C): append a line of FASM source to the sidecar buffer.
      procedure ASM_Sidecar_Append (Line : String) is
      begin
         if ASM_Side_Len_C + Line'Length + 1 > ASM_Side_Buffer_C'Length then
            return;
         end if;
         if Line'Length > 0 then
            ASM_Side_Buffer_C
              (ASM_Side_Len_C + 1 .. ASM_Side_Len_C + Line'Length) := Line;
            ASM_Side_Len_C := ASM_Side_Len_C + Line'Length;
         end if;
         ASM_Side_Len_C := ASM_Side_Len_C + 1;
         ASM_Side_Buffer_C (ASM_Side_Len_C) := ASCII.LF;
      end ASM_Sidecar_Append;

      procedure ASM_Sidecar_Bootstrap is
      begin
         if ASM_Side_Used_C then
            return;
         end if;
         ASM_Side_Used_C := True;
         ASM_Sidecar_Append (";; ALB Track 8: FASM sidecar (auto-generated)");
         ASM_Sidecar_Append (";; Each ASM block / INLINE ASM is wrapped as a public");
         ASM_Sidecar_Append (";; callable symbol that the C output references.");
         ASM_Sidecar_Append ("format MS64 COFF");
         ASM_Sidecar_Append ("");
         ASM_Sidecar_Append ("section '.text' code readable executable");
         ASM_Sidecar_Append ("");
      end ASM_Sidecar_Bootstrap;

      function Img_Nat (N : Natural) return String is
         Raw : constant String := Natural'Image (N);
      begin
         if Raw'Length > 1 and then Raw (Raw'First) = ' ' then
            return Raw (Raw'First + 1 .. Raw'Last);
         else
            return Raw;
         end if;
      end Img_Nat;

      function ASM_Is_End_Marker (Line : String) return Boolean is
         A, Z : Integer;
      begin
         A := Line'First;
         Z := Line'Last;
         while A <= Z
           and then (Line (A) = ' '
                     or else Line (A) = ASCII.HT
                     or else Line (A) = ASCII.CR)
         loop
            A := A + 1;
         end loop;
         while Z >= A
           and then (Line (Z) = ' '
                     or else Line (Z) = ASCII.HT
                     or else Line (Z) = ASCII.CR)
         loop
            Z := Z - 1;
         end loop;
         if Z - A + 1 /= 7 then
            return False;
         end if;
         return To_Upper (Line (A .. Z)) = "END ASM";
      end ASM_Is_End_Marker;

      procedure ASM_Sidecar_Append_Body (Block_Text : String) is
         I          : Positive := Block_Text'First;
         Line_S     : Positive;
         First_Line : Boolean := True;
      begin
         while I <= Block_Text'Last loop
            Line_S := I;
            while I <= Block_Text'Last
              and then Block_Text (I) /= ASCII.LF
            loop
               I := I + 1;
            end loop;
            declare
               Raw    : constant String := Block_Text (Line_S .. I - 1);
               Trim_E : Integer := Raw'Last;
            begin
               while Trim_E >= Raw'First
                 and then (Raw (Trim_E) = ASCII.CR
                           or else Raw (Trim_E) = ' '
                           or else Raw (Trim_E) = ASCII.HT)
               loop
                  Trim_E := Trim_E - 1;
               end loop;
               if First_Line then
                  --  Skip the leading "ASM" / "INLINE ASM" marker.
                  First_Line := False;
               elsif Trim_E >= Raw'First then
                  exit when ASM_Is_End_Marker (Raw (Raw'First .. Trim_E));
                  ASM_Sidecar_Append ("    " & Raw (Raw'First .. Trim_E));
               else
                  ASM_Sidecar_Append ("");
               end if;
            end;
            if I <= Block_Text'Last and then Block_Text (I) = ASCII.LF then
               I := I + 1;
            end if;
         end loop;
      end ASM_Sidecar_Append_Body;

      procedure ASM_Sidecar_Emit_Block_C (Block_Text : String; OK : in out Boolean) is
      begin
         ASM_Sidecar_Bootstrap;
         ASM_Block_Counter_C := ASM_Block_Counter_C + 1;
         declare
            Sym_Name : constant String :=
              "alb_asm_blk_" & Img_Nat (ASM_Block_Counter_C);
         begin
            ASM_Sidecar_Append ("public " & Sym_Name);
            ASM_Sidecar_Append (Sym_Name & ":");
            ASM_Sidecar_Append ("    push rbp");
            ASM_Sidecar_Append ("    mov  rbp, rsp");
            ASM_Sidecar_Append ("    sub  rsp, 32");
            ASM_Sidecar_Append_Body (Block_Text);
            ASM_Sidecar_Append ("    add  rsp, 32");
            ASM_Sidecar_Append ("    pop  rbp");
            ASM_Sidecar_Append ("    ret");
            ASM_Sidecar_Append ("");

            --  Extern declaration in global section + call site inline.
            Emit_Global_Line ("extern void " & Sym_Name & "(void);");

            Transpiler_Native_HAL.Emit_Raw
              ("  " & Sym_Name & "();", OK);
            Transpiler_Native_HAL.Emit_Newline (OK);
         end;
      end ASM_Sidecar_Emit_Block_C;

      procedure ASM_Sidecar_Emit_Expr_C (Block_Text : String; OK : in out Boolean) is
      begin
         ASM_Sidecar_Bootstrap;
         ASM_Block_Counter_C := ASM_Block_Counter_C + 1;
         declare
            Sym_Name : constant String :=
              "alb_asm_exp_" & Img_Nat (ASM_Block_Counter_C);
         begin
            ASM_Sidecar_Append ("public " & Sym_Name);
            ASM_Sidecar_Append (Sym_Name & ":");
            ASM_Sidecar_Append ("    push rbp");
            ASM_Sidecar_Append ("    mov  rbp, rsp");
            ASM_Sidecar_Append ("    sub  rsp, 32");
            ASM_Sidecar_Append ("    xor  rax, rax");
            ASM_Sidecar_Append_Body (Block_Text);
            ASM_Sidecar_Append ("    add  rsp, 32");
            ASM_Sidecar_Append ("    pop  rbp");
            ASM_Sidecar_Append ("    ret");
            ASM_Sidecar_Append ("");

            Emit_Global_Line ("extern uint64_t " & Sym_Name & "(void);");

            Transpiler_Native_HAL.Emit_Raw
              ("((uint64_t)" & Sym_Name & "())", OK);
         end;
      end ASM_Sidecar_Emit_Expr_C;

      procedure Emit_Global_U64_Table_Label
        (Label_Name : String;
         Values     : Static_Palette_Array)
      is
      begin
         if Target = Backend_C then
            Transpiler_Native_HAL.Set_Global_Buffer_Mode (True);
            Transpiler_Native_HAL.Emit_Raw
              ("static const uint64_t " &
               Label_Name &
               "[" &
               Nat_Img (Values'Length) &
               "] = {",
               Emit_Success);
            Transpiler_Native_HAL.Emit_Newline (Emit_Success);

            for I in Values'Range loop
               if ((I - Values'First) mod 8) = 0 then
                  Transpiler_Native_HAL.Emit_Raw ("    ", Emit_Success);
               end if;

               Transpiler_Native_HAL.Emit_Raw (U64_Img (Values (I)), Emit_Success);

               if I < Values'Last then
                  Transpiler_Native_HAL.Emit_Raw (", ", Emit_Success);
               end if;

               if ((I - Values'First + 1) mod 8) = 0 or else I = Values'Last then
                  Transpiler_Native_HAL.Emit_Newline (Emit_Success);
               end if;
            end loop;

            Transpiler_Native_HAL.Emit_Raw ("};", Emit_Success);
            Transpiler_Native_HAL.Emit_Newline (Emit_Success);
            Transpiler_Native_HAL.Set_Global_Buffer_Mode (False);
         else
            Transpiler_Native_HAL.Set_Global_Buffer_Mode (True);
            for I in Values'Range loop
               if I = Values'First then
                  Transpiler_Native_HAL.Emit_Raw ("  " & Label_Name & " dq ", Emit_Success);
               elsif (I - Values'First) mod 4 = 0 then
                  Transpiler_Native_HAL.Emit_Newline (Emit_Success);
                  Transpiler_Native_HAL.Emit_Raw ("  dq ", Emit_Success);
               else
                  Transpiler_Native_HAL.Emit_Raw (", ", Emit_Success);
               end if;

               Transpiler_Native_HAL.Emit_Raw (U64_Img (Values (I)), Emit_Success);
            end loop;
            Transpiler_Native_HAL.Emit_Newline (Emit_Success);
            Transpiler_Native_HAL.Set_Global_Buffer_Mode (False);
         end if;
      end Emit_Global_U64_Table_Label;

      procedure Emit_Global_Byte_Table_Label
        (Label_Name : String;
         Values     : Static_Pixel_Buffer;
         Count      : Natural)
      is
      begin
         if Target = Backend_C then
            if Count = 0 then
               Emit_Global_Line ("static const uint8_t " & Label_Name & "[1] = {0};");
               return;
            end if;

            Transpiler_Native_HAL.Set_Global_Buffer_Mode (True);
            Transpiler_Native_HAL.Emit_Raw
              ("static const uint8_t " &
               Label_Name &
               "[" &
               Nat_Img (Count) &
               "] = {",
               Emit_Success);
            Transpiler_Native_HAL.Emit_Newline (Emit_Success);

            for I in 1 .. Count loop
               if ((I - 1) mod 16) = 0 then
                  Transpiler_Native_HAL.Emit_Raw ("    ", Emit_Success);
               end if;

               Transpiler_Native_HAL.Emit_Raw (Nat_Img (Values (I)), Emit_Success);

               if I < Count then
                  Transpiler_Native_HAL.Emit_Raw (", ", Emit_Success);
               end if;

               if (I mod 16) = 0 or else I = Count then
                  Transpiler_Native_HAL.Emit_Newline (Emit_Success);
               end if;
            end loop;

            Transpiler_Native_HAL.Emit_Raw ("};", Emit_Success);
            Transpiler_Native_HAL.Emit_Newline (Emit_Success);
            Transpiler_Native_HAL.Set_Global_Buffer_Mode (False);
         else
            if Count = 0 then
               Emit_Global_Line ("  " & Label_Name & " db 0");
               return;
            end if;

            Transpiler_Native_HAL.Set_Global_Buffer_Mode (True);
            for I in 1 .. Count loop
               if I = 1 then
                  Transpiler_Native_HAL.Emit_Raw ("  " & Label_Name & " db ", Emit_Success);
               elsif (I - 1) mod 16 = 0 then
                  Transpiler_Native_HAL.Emit_Newline (Emit_Success);
                  Transpiler_Native_HAL.Emit_Raw ("  db ", Emit_Success);
               else
                  Transpiler_Native_HAL.Emit_Raw (", ", Emit_Success);
               end if;

               Transpiler_Native_HAL.Emit_Raw (Nat_Img (Values (I)), Emit_Success);
            end loop;
            Transpiler_Native_HAL.Emit_Newline (Emit_Success);
            Transpiler_Native_HAL.Set_Global_Buffer_Mode (False);
         end if;
      end Emit_Global_Byte_Table_Label;

      procedure Emit_Global_Font_Glyph_Table_Label
        (Label_Name : String;
         Glyphs     : Font_Glyph_Array)
      is
         function Glyph_Present_Int (Glyph : Font_Glyph_Record) return Integer is
         begin
            return (if Glyph.Present then 1 else 0);
         end Glyph_Present_Int;
      begin
         if Target = Backend_C then
            Transpiler_Native_HAL.Set_Global_Buffer_Mode (True);
            Transpiler_Native_HAL.Emit_Raw
              ("static const int64_t " &
               Label_Name &
               "[" &
               Nat_Img (Glyphs'Length) &
               "][8] = {",
               Emit_Success);
            Transpiler_Native_HAL.Emit_Newline (Emit_Success);

            for I in Glyphs'Range loop
               Transpiler_Native_HAL.Emit_Raw
                 ("    {" &
                  Int_Img (Glyphs (I).X_Pos) & ", " &
                  Int_Img (Glyphs (I).Y_Pos) & ", " &
                  Int_Img (Glyphs (I).Width) & ", " &
                  Int_Img (Glyphs (I).Height) & ", " &
                  Int_Img (Glyphs (I).Offset_X) & ", " &
                  Int_Img (Glyphs (I).Offset_Y) & ", " &
                  Int_Img (Glyphs (I).Advance) & ", " &
                  Int_Img (Glyph_Present_Int (Glyphs (I))) & "}",
                  Emit_Success);
               if I < Glyphs'Last then
                  Transpiler_Native_HAL.Emit_Raw (",", Emit_Success);
               end if;
               Transpiler_Native_HAL.Emit_Newline (Emit_Success);
            end loop;

            Transpiler_Native_HAL.Emit_Raw ("};", Emit_Success);
            Transpiler_Native_HAL.Emit_Newline (Emit_Success);
            Transpiler_Native_HAL.Set_Global_Buffer_Mode (False);
         else
            Transpiler_Native_HAL.Set_Global_Buffer_Mode (True);
            for I in Glyphs'Range loop
               if I = Glyphs'First then
                  Transpiler_Native_HAL.Emit_Raw ("  " & Label_Name & " dq ", Emit_Success);
               else
                  Transpiler_Native_HAL.Emit_Newline (Emit_Success);
                  Transpiler_Native_HAL.Emit_Raw ("  dq ", Emit_Success);
               end if;

               Transpiler_Native_HAL.Emit_Raw
                 (Int_Img (Glyphs (I).X_Pos) & ", " &
                  Int_Img (Glyphs (I).Y_Pos) & ", " &
                  Int_Img (Glyphs (I).Width) & ", " &
                  Int_Img (Glyphs (I).Height) & ", " &
                  Int_Img (Glyphs (I).Offset_X) & ", " &
                  Int_Img (Glyphs (I).Offset_Y) & ", " &
                  Int_Img (Glyphs (I).Advance) & ", " &
                  Int_Img (Glyph_Present_Int (Glyphs (I))),
                  Emit_Success);
            end loop;
            Transpiler_Native_HAL.Emit_Newline (Emit_Success);
            Transpiler_Native_HAL.Set_Global_Buffer_Mode (False);
         end if;
      end Emit_Global_Font_Glyph_Table_Label;

      procedure Register_Set_Shoebox_Stmt
        (Node    : in Node_Index;
         Success : in out Boolean;
         Diag    : in out Compiler_Diagnostic)
      is
         use type Ada.Directories.File_Kind;

         Expr_Node : constant Node_Index := Tree (Node).Left_Child;
      begin
         if Expr_Node = 0 or else Tree (Expr_Node).Kind /= AST_String_Expr then
            Fail_Node (Node, Err_Type_Conflict, "SETSHOEBOX", Success, Diag);
            return;
         end if;

         declare
            Raw_Path : constant String := Strip_String_Node (Expr_Node);
            Resolved : constant String := Resolve_Static_Asset_Path (Raw_Path, Node);
         begin
            if Raw_Path'Length = 0 or else Resolved'Length = 0 then
               Fail_Node (Node, Err_Type_Conflict, "SETSHOEBOX", Success, Diag);
               return;
            end if;

            if not Path_Exists (Resolved) then
               Fail_Node (Node, Err_Runtime_IO_Failure, Resolved, Success, Diag);
               return;
            end if;

            begin
               if Ada.Directories.Kind (Resolved) /= Ada.Directories.Directory then
                  Fail_Node (Node, Err_Type_Conflict, Resolved, Success, Diag);
                  return;
               end if;
            exception
               when others =>
                  Fail_Node (Node, Err_Type_Conflict, Resolved, Success, Diag);
                  return;
            end;

            if Resolved'Length > Shoebox_Path'Length then
               Fail_Node (Node, Err_Mem_Out_Of_Bounds, Resolved, Success, Diag);
               return;
            end if;

            Shoebox_Path := (others => ' ');
            Shoebox_Path (1 .. Resolved'Length) := Resolved;
            Shoebox_Path_Len := Resolved'Length;
            Shoebox_Active := True;
         end;
      end Register_Set_Shoebox_Stmt;

      procedure Register_Static_Surface_Decl
        (Node    : in Node_Index;
         Success : in out Boolean;
         Diag    : in out Compiler_Diagnostic)
      is
         Raw_Name    : constant String := Raw_Lexeme (Tree (Tree (Node).Left_Child).Token_Index);
         Name        : constant String := Scoped_Lexeme (Raw_Name);
         Setting     : Node_Index := Tree (Node).Right_Child;
         Width_Val   : Natural := 0;
         Height_Val  : Natural := 0;
         Format_Kind : Static_Format_Kind := Static_Format_Unknown;
         Have_Width  : Boolean := False;
         Have_Height : Boolean := False;
         Have_Format : Boolean := False;
         Eval_U64    : U64 := 0;
         Total_Bytes : U64 := 0;
         Pitch_Bytes : Natural := 0;
         Pixel_Count : Natural := 0;
         Dummy_Tag   : ALB_Type_Tag := Type_None;
         Dummy_Sym   : Symbol_Record;
         Idx         : Natural := 0;
      begin
         pragma Unreferenced (Dummy_Sym);

         if Find_Static_Surface (Name) /= 0 then
            Fail_Node (Node, Err_Type_Conflict, Name, Success, Diag);
            return;
         end if;

         while Setting /= 0 loop
            case Tree (Setting).Kind is
               when AST_Static_Width =>
                  Comptime_Eval_Expr (Tree (Setting).Left_Child, Eval_U64, Success, Diag);
                  if not Success or else Eval_U64 = 0 or else Eval_U64 > U64 (Natural'Last) then
                     Fail_Node (Setting, Err_Mem_Out_Of_Bounds, Name, Success, Diag);
                     return;
                  end if;
                  Width_Val := Natural (Eval_U64);
                  Have_Width := True;

               when AST_Static_Height =>
                  Comptime_Eval_Expr (Tree (Setting).Left_Child, Eval_U64, Success, Diag);
                  if not Success or else Eval_U64 = 0 or else Eval_U64 > U64 (Natural'Last) then
                     Fail_Node (Setting, Err_Mem_Out_Of_Bounds, Name, Success, Diag);
                     return;
                  end if;
                  Height_Val := Natural (Eval_U64);
                  Have_Height := True;

               when AST_Static_Format =>
                  declare
                     Fmt_Text : constant String := Raw_Feature_Atom (Tree (Setting).Left_Child);
                  begin
                     Format_Kind := Static_Format_From_Lexeme (Fmt_Text);
                     Have_Format := Format_Kind /= Static_Format_Unknown;
                  end;
                  if not Have_Format then
                     Fail_Node (Setting, Err_Type_Conflict, Name, Success, Diag);
                     return;
                  end if;

               when others =>
                  null;
            end case;

            Setting := Tree (Setting).Next_Sibling;
         end loop;

         if not Have_Width or else not Have_Height or else not Have_Format then
            Fail_Node (Node, Err_Type_Conflict, Name, Success, Diag);
            return;
         end if;

         if Format_Kind /= Static_Format_Rgb565 then
            Fail_Node (Node, Err_Type_Conflict, Name, Success, Diag);
            return;
         end if;

         Total_Bytes := U64 (Width_Val) * U64 (Height_Val) * 2;
         if Total_Bytes = 0 or else Total_Bytes > U64 (Max_Static_Surface_Bytes) then
            Fail_Node (Node, Err_Mem_Out_Of_Bounds, Name, Success, Diag);
            return;
         end if;

         if Static_Surface_Count >= Max_Static_Surfaces then
            Fail_Node (Node, Err_Mem_Out_Of_Bounds, Name, Success, Diag);
            return;
         end if;

         Dummy_Sym := Resolve_Symbol (Raw_Name, Type_U64, 0, False, Dummy_Tag);
         Pitch_Bytes := Width_Val * 2;
         Pixel_Count := Width_Val * Height_Val;

         Static_Surface_Count := Static_Surface_Count + 1;
         Idx := Static_Surface_Count;
         Static_Surfaces (Idx).Name_Hash := Hash_String (Name);
         Store_Name (Static_Surfaces (Idx).Name, Static_Surfaces (Idx).Name_Len, Name);
         Static_Surfaces (Idx).Width := Width_Val;
         Static_Surfaces (Idx).Height := Height_Val;
         Static_Surfaces (Idx).Format := Format_Kind;
         Static_Surfaces (Idx).Active := True;

         if Target = Backend_C then
            Emit_Global_Line
              ("static uint16_t " &
               Surface_Pixels_Label (Name) &
               "[" &
               Nat_Img (Pixel_Count) &
               "] = {0};");
            Emit_Global_Line
              ("static uint64_t " & Surface_Meta_Label (Name) & "[5] = {");
            Emit_Global_Line
              ("    (uint64_t)(uintptr_t)" & Surface_Pixels_Label (Name) & ",");
            Emit_Global_Line ("    " & Nat_Img (Width_Val) & ",");
            Emit_Global_Line ("    " & Nat_Img (Height_Val) & ",");
            Emit_Global_Line ("    " & Nat_Img (Pitch_Bytes) & ",");
            Emit_Global_Line ("    " & Nat_Img (Static_Format_Code (Format_Kind)));
            Emit_Global_Line ("};");
            Emit_Global_Line ("");
         else
            Emit_Global_Line
              ("  " & Surface_Pixels_Label (Name) & " rb " & U64_Img (Total_Bytes));
            Emit_Global_Line
              ("  " & Surface_Meta_Label (Name) & " dq " & Surface_Pixels_Label (Name));
            Emit_Global_Line ("  dq " & Nat_Img (Width_Val));
            Emit_Global_Line ("  dq " & Nat_Img (Height_Val));
            Emit_Global_Line ("  dq " & Nat_Img (Pitch_Bytes));
            Emit_Global_Line ("  dq " & Nat_Img (Static_Format_Code (Format_Kind)));
            Emit_Global_Line ("");
         end if;
      end Register_Static_Surface_Decl;

      procedure Register_Color_Lut_Decl
        (Node    : in Node_Index;
         Success : in out Boolean;
         Diag    : in out Compiler_Diagnostic)
      is
         Raw_Name  : constant String := Raw_Lexeme (Tree (Tree (Node).Left_Child).Token_Index);
         Name      : constant String := Scoped_Lexeme (Raw_Name);
         Lut_Entry : Node_Index := Tree (Node).Right_Child;
         Palette   : Static_Palette_Array := (others => 0);
         Seen      : array (Natural range 0 .. 255) of Boolean := (others => False);
         Index_Val : U64 := 0;
         Color_Val : U64 := 0;
         Idx       : Natural := 0;
         Dummy_Tag : ALB_Type_Tag := Type_None;
         Dummy_Sym : Symbol_Record;
      begin
         pragma Unreferenced (Dummy_Sym);

         if Find_Color_Lut (Name) /= 0 then
            Fail_Node (Node, Err_Type_Conflict, Name, Success, Diag);
            return;
         end if;

         while Lut_Entry /= 0 loop
            if Tree (Lut_Entry).Kind /= AST_Color_Lut_Entry then
               Fail_Node (Lut_Entry, Err_Type_Conflict, Name, Success, Diag);
               return;
            end if;

            Comptime_Eval_Expr (Tree (Lut_Entry).Left_Child, Index_Val, Success, Diag);
            if not Success or else Index_Val > 255 then
               Fail_Node (Lut_Entry, Err_Mem_Out_Of_Bounds, Name, Success, Diag);
               return;
            end if;

            Comptime_Eval_Expr (Tree (Lut_Entry).Right_Child, Color_Val, Success, Diag);
            if not Success or else Color_Val > 16#00FF_FFFF# then
               Fail_Node (Lut_Entry, Err_Type_Conflict, Name, Success, Diag);
               return;
            end if;

            if Seen (Natural (Index_Val)) then
               Fail_Node (Lut_Entry, Err_Type_Conflict, Name, Success, Diag);
               return;
            end if;

            Seen (Natural (Index_Val)) := True;
            Palette (Natural (Index_Val)) := Color_Val;
            Lut_Entry := Tree (Lut_Entry).Next_Sibling;
         end loop;

         if Color_Lut_Count >= Max_Static_Color_Luts then
            Fail_Node (Node, Err_Mem_Out_Of_Bounds, Name, Success, Diag);
            return;
         end if;

         Dummy_Sym := Resolve_Symbol (Raw_Name, Type_U64, 0, False, Dummy_Tag);

         Color_Lut_Count := Color_Lut_Count + 1;
         Idx := Color_Lut_Count;
         Color_Luts (Idx).Name_Hash := Hash_String (Name);
         Store_Name (Color_Luts (Idx).Name, Color_Luts (Idx).Name_Len, Name);
         Color_Luts (Idx).Active := True;

         Emit_Global_U64_Table_Label (LUT_Label (Name), Palette);
         Emit_Global_Line ("");
      end Register_Color_Lut_Decl;

      procedure Register_Visual_Rule_Decl
        (Node    : in Node_Index;
         Success : in out Boolean;
         Diag    : in out Compiler_Diagnostic)
      is
         Raw_Name      : constant String := Raw_Lexeme (Tree (Tree (Node).Left_Child).Token_Index);
         Name          : constant String := Scoped_Lexeme (Raw_Name);
         Param_List    : constant Node_Index := Tree (Tree (Node).Left_Child).Right_Child;
         Arg_Node      : Node_Index := 0;
         Clause        : Node_Index := Tree (Node).Right_Child;
         Default_Count : Natural := 0;
         Param_Text    : String (1 .. 128) := (others => ' ');
         Param_Len     : Natural := 0;
         Dummy_Tag     : ALB_Type_Tag := Type_None;
         Dummy_Sym     : Symbol_Record;
         Idx           : Natural := 0;
      begin
         pragma Unreferenced (Dummy_Sym);

         if Find_Visual_Rule (Name) /= 0 then
            Fail_Node (Node, Err_Type_Conflict, Name, Success, Diag);
            return;
         end if;

         if Param_List > 0 then
            Arg_Node := Tree (Param_List).Left_Child;
            if Arg_Node /= 0 then
               declare
                  Raw_Param : constant String := Raw_Feature_Atom (Arg_Node);
               begin
                  Param_Len := Raw_Param'Length;
                  if Param_Len = 0
                    or else Param_Len > Param_Text'Length
                    or else Tree (Arg_Node).Next_Sibling /= 0
                  then
                     Fail_Node (Node, Err_Type_Conflict, Name, Success, Diag);
                     return;
                  end if;

                  Param_Text (1 .. Param_Len) := Raw_Param;
               end;

               if Param_Len = 0 then
                  Fail_Node (Node, Err_Type_Conflict, Name, Success, Diag);
                  return;
               end if;

               Dummy_Sym :=
                 Resolve_Symbol
                   (Param_Text (1 .. Param_Len),
                    Type_U64,
                    0,
                    False,
                    Dummy_Tag);
            end if;
         end if;

         while Clause /= 0 loop
            case Tree (Clause).Kind is
               when AST_Visual_When_Clause =>
                  if Tree (Clause).Left_Child = 0
                    or else Tree (Clause).Right_Child = 0
                    or else Tree (Tree (Clause).Right_Child).Next_Sibling = 0
                  then
                     Fail_Node (Clause, Err_Compiler_AST_Mismatch, Name, Success, Diag);
                     return;
                  end if;

               when AST_Visual_Default_Clause =>
                  Default_Count := Default_Count + 1;
                  if Tree (Clause).Left_Child = 0 or else Tree (Clause).Right_Child = 0 then
                     Fail_Node (Clause, Err_Compiler_AST_Mismatch, Name, Success, Diag);
                     return;
                  end if;

               when others =>
                  Fail_Node (Clause, Err_Type_Conflict, Name, Success, Diag);
                  return;
            end case;

            Clause := Tree (Clause).Next_Sibling;
         end loop;

         if Default_Count /= 1 then
            Fail_Node (Node, Err_Type_Conflict, Name, Success, Diag);
            return;
         end if;

         if Visual_Rule_Count >= Max_Static_Visual_Rules then
            Fail_Node (Node, Err_Mem_Out_Of_Bounds, Name, Success, Diag);
            return;
         end if;

         Dummy_Sym := Resolve_Symbol (Raw_Name, Type_U64, 0, False, Dummy_Tag);

         Visual_Rule_Count := Visual_Rule_Count + 1;
         Idx := Visual_Rule_Count;
         Visual_Rules (Idx).Name_Hash := Hash_String (Name);
         Store_Name (Visual_Rules (Idx).Name, Visual_Rules (Idx).Name_Len, Name);
         if Param_Len > 0 then
            Store_Name
              (Visual_Rules (Idx).Param_Name,
               Visual_Rules (Idx).Param_Len,
               Scoped_Lexeme (Param_Text (1 .. Param_Len)));
         end if;
         Visual_Rules (Idx).Decl_Node := Node;
         Visual_Rules (Idx).Active := True;

         if Target = Backend_C then
            Emit_Global_Line
              ("static const uint64_t " & Visual_Rule_Label (Name) & "[2] = {");
            Emit_Global_Line ("    " & U64_Img (U64 (Node)) & ",");
            Emit_Global_Line ("    " & Nat_Img (Visual_Rules (Idx).Param_Len));
            Emit_Global_Line ("};");
            Emit_Global_Line ("");
         else
            Emit_Global_Line
              ("  " & Visual_Rule_Label (Name) & " dq " & U64_Img (U64 (Node)));
            Emit_Global_Line
              ("  dq " & Nat_Img (Visual_Rules (Idx).Param_Len));
            Emit_Global_Line ("");
         end if;
      end Register_Visual_Rule_Decl;

      procedure Register_Render_Viewport_Decl
        (Node    : in Node_Index;
         Success : in out Boolean;
         Diag    : in out Compiler_Diagnostic)
      is
         Raw_Name   : constant String := Raw_Lexeme (Tree (Tree (Node).Left_Child).Token_Index);
         Name       : constant String := Scoped_Lexeme (Raw_Name);
         Setting    : Node_Index := Tree (Node).Right_Child;
         Eval_U64   : U64 := 0;
         X_Pos      : Integer := 0;
         Y_Pos      : Integer := 0;
         Width_Val  : Natural := 0;
         Height_Val : Natural := 0;
         Have_Bounds : Boolean := False;
         Dummy_Tag  : ALB_Type_Tag := Type_None;
         Dummy_Sym  : Symbol_Record;
         Idx        : Natural := 0;
      begin
         pragma Unreferenced (Dummy_Sym);

         if Find_Render_Viewport (Name) /= 0 then
            Fail_Node (Node, Err_Type_Conflict, Name, Success, Diag);
            return;
         end if;

         while Setting /= 0 loop
            if Tree (Setting).Kind /= AST_Viewport_Bounds then
               Fail_Node (Setting, Err_Type_Conflict, Name, Success, Diag);
               return;
            end if;

            declare
               X_Node : constant Node_Index := Tree (Setting).Left_Child;
               Y_Node : constant Node_Index := Tree (Setting).Right_Child;
               W_Node : constant Node_Index := (if Y_Node > 0 then Tree (Y_Node).Next_Sibling else 0);
               H_Node : constant Node_Index := (if W_Node > 0 then Tree (W_Node).Next_Sibling else 0);
            begin
               if X_Node = 0 or else Y_Node = 0 or else W_Node = 0 or else H_Node = 0 then
                  Fail_Node (Setting, Err_Compiler_AST_Mismatch, Name, Success, Diag);
                  return;
               end if;

               Comptime_Eval_Expr (X_Node, Eval_U64, Success, Diag);
               if not Success or else Eval_U64 > U64 (Integer'Last) then
                  Fail_Node (X_Node, Err_Mem_Out_Of_Bounds, Name, Success, Diag);
                  return;
               end if;
               X_Pos := Integer (Eval_U64);

               Comptime_Eval_Expr (Y_Node, Eval_U64, Success, Diag);
               if not Success or else Eval_U64 > U64 (Integer'Last) then
                  Fail_Node (Y_Node, Err_Mem_Out_Of_Bounds, Name, Success, Diag);
                  return;
               end if;
               Y_Pos := Integer (Eval_U64);

               Comptime_Eval_Expr (W_Node, Eval_U64, Success, Diag);
               if not Success or else Eval_U64 = 0 or else Eval_U64 > U64 (Natural'Last) then
                  Fail_Node (W_Node, Err_Mem_Out_Of_Bounds, Name, Success, Diag);
                  return;
               end if;
               Width_Val := Natural (Eval_U64);

               Comptime_Eval_Expr (H_Node, Eval_U64, Success, Diag);
               if not Success or else Eval_U64 = 0 or else Eval_U64 > U64 (Natural'Last) then
                  Fail_Node (H_Node, Err_Mem_Out_Of_Bounds, Name, Success, Diag);
                  return;
               end if;
               Height_Val := Natural (Eval_U64);
            end;

            Have_Bounds := True;
            Setting := Tree (Setting).Next_Sibling;
         end loop;

         if not Have_Bounds then
            Fail_Node (Node, Err_Type_Conflict, Name, Success, Diag);
            return;
         end if;

         if Render_Viewport_Count >= Max_Static_Render_Views then
            Fail_Node (Node, Err_Mem_Out_Of_Bounds, Name, Success, Diag);
            return;
         end if;

         Dummy_Sym := Resolve_Symbol (Raw_Name, Type_U64, 0, False, Dummy_Tag);

         Render_Viewport_Count := Render_Viewport_Count + 1;
         Idx := Render_Viewport_Count;
         Render_Viewports (Idx).Name_Hash := Hash_String (Name);
         Store_Name (Render_Viewports (Idx).Name, Render_Viewports (Idx).Name_Len, Name);
         Render_Viewports (Idx).X_Pos := X_Pos;
         Render_Viewports (Idx).Y_Pos := Y_Pos;
         Render_Viewports (Idx).Width := Width_Val;
         Render_Viewports (Idx).Height := Height_Val;
         Render_Viewports (Idx).Active := True;

         if Target = Backend_C then
            Emit_Global_Line
              ("static const int64_t " & Viewport_Label (Name) & "[4] = {");
            Emit_Global_Line ("    " & Int_Img (X_Pos) & ",");
            Emit_Global_Line ("    " & Int_Img (Y_Pos) & ",");
            Emit_Global_Line ("    " & Nat_Img (Width_Val) & ",");
            Emit_Global_Line ("    " & Nat_Img (Height_Val));
            Emit_Global_Line ("};");
            Emit_Global_Line ("");
         else
            Emit_Global_Line
              ("  " & Viewport_Label (Name) & " dq " & Int_Img (X_Pos));
            Emit_Global_Line ("  dq " & Int_Img (Y_Pos));
            Emit_Global_Line ("  dq " & Nat_Img (Width_Val));
            Emit_Global_Line ("  dq " & Nat_Img (Height_Val));
            Emit_Global_Line ("");
         end if;
      end Register_Render_Viewport_Decl;

      procedure Register_Static_Sprite_Decl
        (Node    : in Node_Index;
         Success : in out Boolean;
         Diag    : in out Compiler_Diagnostic)
      is
         use type Ada.Streams.Stream_IO.Count;

         Raw_Name     : constant String := Raw_Lexeme (Tree (Tree (Node).Left_Child).Token_Index);
         Name         : constant String := Scoped_Lexeme (Raw_Name);
         Setting      : Node_Index := Tree (Node).Right_Child;
         Source_Text  : String (1 .. Max_Path_Len) := (others => ' ');
         Source_Len   : Natural := 0;
         Format_Kind  : Static_Format_Kind := Static_Format_Unknown;
         Frame_Width  : Natural := 0;
         Frame_Height : Natural := 0;
         Frame_Count  : Natural := 0;
         Have_Source  : Boolean := False;
         Have_Format  : Boolean := False;
         Have_Width   : Boolean := False;
         Have_Height  : Boolean := False;
         Have_Frames  : Boolean := False;
         Eval_U64     : U64 := 0;
         Dummy_Tag    : ALB_Type_Tag := Type_None;
         Dummy_Sym    : Symbol_Record;
         Idx          : Natural := 0;

         procedure Load_Prepared_Sprite (Source_Path : String) is
            File_Handle : Ada.Streams.Stream_IO.File_Type;
         begin
            Ada.Streams.Stream_IO.Open
              (File_Handle,
               Ada.Streams.Stream_IO.In_File,
               Source_Path);

            declare
               File_Size_Count : constant Ada.Streams.Stream_IO.Count :=
                 Ada.Streams.Stream_IO.Size (File_Handle);
            begin
               if File_Size_Count = 0
                 or else File_Size_Count > Ada.Streams.Stream_IO.Count (Max_Static_Sprite_Bytes + 8192)
               then
                  Ada.Streams.Stream_IO.Close (File_Handle);
                  Fail_Node (Node, Err_Mem_Out_Of_Bounds, Source_Path, Success, Diag);
                  return;
               end if;

               declare
                  File_Size : constant Natural := Natural (File_Size_Count);
                  Buffer    : Ada.Streams.Stream_Element_Array
                    (1 .. Ada.Streams.Stream_Element_Offset (File_Size));
                  Last      : Ada.Streams.Stream_Element_Offset := 0;
                  Palette   : Static_Palette_Array := (others => 0);
                  Pixels    : Static_Pixel_Buffer := (others => 0);

                  function Has_Bytes
                    (Offset : Natural;
                     Count  : Natural) return Boolean
                  is
                  begin
                     return Offset + Count <= File_Size;
                  end Has_Bytes;

                  function B (Offset : Natural) return Natural is
                  begin
                     return Natural
                       (Buffer (Ada.Streams.Stream_Element_Offset (Offset + 1)));
                  end B;

                  function U16_LE (Offset : Natural) return Natural is
                  begin
                     return B (Offset) + (B (Offset + 1) * 256);
                  end U16_LE;

                  function U32_LE (Offset : Natural) return U64 is
                  begin
                     return U64 (B (Offset))
                       + (U64 (B (Offset + 1)) * 16#100#)
                       + (U64 (B (Offset + 2)) * 16#1_0000#)
                       + (U64 (B (Offset + 3)) * 16#100_0000#);
                  end U32_LE;

                  function S32_LE (Offset : Natural) return Integer is
                     Raw : constant U64 := U32_LE (Offset);
                  begin
                     if Raw >= 16#8000_0000# then
                        return -Integer (16#1_0000_0000# - Raw);
                     else
                        return Integer (Raw);
                     end if;
                  end S32_LE;
               begin
                  Ada.Streams.Stream_IO.Read (File_Handle, Buffer, Last);
                  Ada.Streams.Stream_IO.Close (File_Handle);

                  if Natural (Last) /= File_Size then
                     Fail_Node (Node, Err_Runtime_IO_Failure, Source_Path, Success, Diag);
                     return;
                  end if;

                  if not Has_Bytes (0, 54)
                    or else B (0) /= Character'Pos ('B')
                    or else B (1) /= Character'Pos ('M')
                  then
                     Fail_Node (Node, Err_Type_Conflict, Source_Path, Success, Diag);
                     return;
                  end if;

                  declare
                     Pixel_Offset    : constant Natural := Natural (U32_LE (10));
                     DIB_Size        : constant Natural := Natural (U32_LE (14));
                     Sheet_Width     : constant Natural := Natural (U32_LE (18));
                     Height_Signed   : constant Integer := S32_LE (22);
                     Sheet_Height    : constant Natural := Natural (abs Height_Signed);
                     Planes          : constant Natural := U16_LE (26);
                     Bits_Per_Pixel  : constant Natural := U16_LE (28);
                     Compression     : constant U64 := U32_LE (30);
                     Colors_Used_Raw : constant U64 := U32_LE (46);
                     Palette_Count   : constant Natural :=
                       (if Colors_Used_Raw = 0 or else Colors_Used_Raw > 256
                        then 256
                        else Natural (Colors_Used_Raw));
                     Bytes_Per_Pixel : constant Natural :=
                       (if Bits_Per_Pixel = 8 then 1
                        elsif Bits_Per_Pixel = 24 then 3
                        elsif Bits_Per_Pixel = 32 then 4
                        else 0);
                     Row_Stride      : constant Natural :=
                       (if Bytes_Per_Pixel = 0
                        then 0
                        else (((Sheet_Width * Bytes_Per_Pixel) + 3) / 4) * 4);
                     Pixel_Count     : constant Natural := Sheet_Width * Sheet_Height;
                     Palette_Live    : Natural := 0;

                     function Find_Or_Add_Palette_Color
                       (Color_Value : U64) return Natural
                     is
                     begin
                        if Palette_Live > 0 then
                           for I in 0 .. Palette_Live - 1 loop
                              if Palette (I) = Color_Value then
                                 return I;
                              end if;
                           end loop;
                        end if;

                        if Palette_Live >= 256 then
                           return 256;
                        end if;

                        Palette (Palette_Live) := Color_Value;
                        Palette_Live := Palette_Live + 1;
                        return Palette_Live - 1;
                     end Find_Or_Add_Palette_Color;
                  begin
                     if DIB_Size < 40
                       or else Height_Signed = 0
                       or else Planes /= 1
                       or else Bytes_Per_Pixel = 0
                       or else (Bits_Per_Pixel = 8 and then Compression /= 0)
                       or else (Bits_Per_Pixel = 24 and then Compression /= 0)
                       or else (Bits_Per_Pixel = 32 and then Compression /= 0 and then Compression /= 3)
                     then
                        Fail_Node (Node, Err_Type_Conflict, Source_Path, Success, Diag);
                        return;
                     end if;

                     if Sheet_Width /= Frame_Width * Frame_Count
                       or else Sheet_Height /= Frame_Height
                       or else Pixel_Count = 0
                       or else Pixel_Count > Max_Static_Sprite_Bytes
                     then
                        Fail_Node (Node, Err_Mem_Out_Of_Bounds, Source_Path, Success, Diag);
                        return;
                     end if;

                     if Bits_Per_Pixel = 8 then
                        if not Has_Bytes (14 + DIB_Size, Palette_Count * 4)
                          or else not Has_Bytes (Pixel_Offset, Row_Stride * Sheet_Height)
                        then
                           Fail_Node (Node, Err_Runtime_IO_Failure, Source_Path, Success, Diag);
                           return;
                        end if;

                        for I in 0 .. Palette_Count - 1 loop
                           declare
                              Entry_Off : constant Natural := 14 + DIB_Size + (I * 4);
                              Blue      : constant U64 := U64 (B (Entry_Off));
                              Green     : constant U64 := U64 (B (Entry_Off + 1));
                              Red       : constant U64 := U64 (B (Entry_Off + 2));
                           begin
                              Palette (I) :=
                                (Red * 16#1_0000#)
                                + (Green * 16#100#)
                                + Blue;
                           end;
                        end loop;

                        for Y in 0 .. Sheet_Height - 1 loop
                           declare
                              Source_Row : constant Natural :=
                                (if Height_Signed > 0 then Sheet_Height - 1 - Y else Y);
                              Row_Start  : constant Natural := Pixel_Offset + (Source_Row * Row_Stride);
                           begin
                              for X in 0 .. Sheet_Width - 1 loop
                                 Pixels ((Y * Sheet_Width) + X + 1) := B (Row_Start + X);
                              end loop;
                           end;
                        end loop;
                     else
                        if not Has_Bytes (Pixel_Offset, Row_Stride * Sheet_Height) then
                           Fail_Node (Node, Err_Runtime_IO_Failure, Source_Path, Success, Diag);
                           return;
                        end if;

                        for Y in 0 .. Sheet_Height - 1 loop
                           declare
                              Source_Row : constant Natural :=
                                (if Height_Signed > 0 then Sheet_Height - 1 - Y else Y);
                              Row_Start  : constant Natural := Pixel_Offset + (Source_Row * Row_Stride);
                           begin
                              for X in 0 .. Sheet_Width - 1 loop
                                 declare
                                    Pixel_Index : constant Positive := (Y * Sheet_Width) + X + 1;
                                    Blue        : Natural := 0;
                                    Green       : Natural := 0;
                                    Red         : Natural := 0;
                                    Color_Value : U64 := 0;
                                    Color_Index : Natural := 0;
                                 begin
                                    if Bits_Per_Pixel = 24 then
                                       Blue := B (Row_Start + (X * 3) + 0);
                                       Green := B (Row_Start + (X * 3) + 1);
                                       Red := B (Row_Start + (X * 3) + 2);
                                    else
                                       Blue := B (Row_Start + (X * 4) + 0);
                                       Green := B (Row_Start + (X * 4) + 1);
                                       Red := B (Row_Start + (X * 4) + 2);
                                    end if;

                                    Color_Value :=
                                      (U64 (Red) * 16#1_0000#)
                                      + (U64 (Green) * 16#100#)
                                      + U64 (Blue);
                                    Color_Index := Find_Or_Add_Palette_Color (Color_Value);
                                    if Color_Index > 255 then
                                       Fail_Node (Node, Err_Mem_Out_Of_Bounds, Source_Path, Success, Diag);
                                       return;
                                    end if;

                                    Pixels (Pixel_Index) := Color_Index;
                                 end;
                              end loop;
                           end;
                        end loop;
                     end if;

                     if Static_Sprite_Count >= Max_Static_Sprites then
                        Fail_Node (Node, Err_Mem_Out_Of_Bounds, Name, Success, Diag);
                        return;
                     end if;

                     Dummy_Sym := Resolve_Symbol (Raw_Name, Type_U64, 0, False, Dummy_Tag);

                     Static_Sprite_Count := Static_Sprite_Count + 1;
                     Idx := Static_Sprite_Count;
                     Static_Sprites (Idx).Name_Hash := Hash_String (Name);
                     Store_Name (Static_Sprites (Idx).Name, Static_Sprites (Idx).Name_Len, Name);
                     Static_Sprites (Idx).Frame_Width := Frame_Width;
                     Static_Sprites (Idx).Frame_Height := Frame_Height;
                     Static_Sprites (Idx).Frame_Count := Frame_Count;
                     Static_Sprites (Idx).Sheet_Width := Sheet_Width;
                     Static_Sprites (Idx).Sheet_Height := Sheet_Height;
                     Static_Sprites (Idx).Format := Format_Kind;
                     Static_Sprites (Idx).Active := True;

                     if Target = Backend_C then
                        Emit_Global_U64_Table_Label (Sprite_Palette_Label (Name), Palette);
                        Emit_Global_Byte_Table_Label (Sprite_Pixels_Label (Name), Pixels, Pixel_Count);
                        Emit_Global_Line
                          ("static const uint64_t " & Sprite_Meta_Label (Name) & "[8] = {");
                        Emit_Global_Line
                          ("    (uint64_t)(uintptr_t)" & Sprite_Pixels_Label (Name) & ",");
                        Emit_Global_Line
                          ("    (uint64_t)(uintptr_t)" & Sprite_Palette_Label (Name) & ",");
                        Emit_Global_Line ("    " & Nat_Img (Frame_Width) & ",");
                        Emit_Global_Line ("    " & Nat_Img (Frame_Height) & ",");
                        Emit_Global_Line ("    " & Nat_Img (Frame_Count) & ",");
                        Emit_Global_Line ("    " & Nat_Img (Sheet_Width) & ",");
                        Emit_Global_Line ("    " & Nat_Img (Sheet_Height) & ",");
                        Emit_Global_Line ("    " & Nat_Img (Static_Format_Code (Format_Kind)));
                        Emit_Global_Line ("};");
                        Emit_Global_Line ("");
                     else
                        Emit_Global_Line
                          ("  " & Sprite_Meta_Label (Name) & " dq " & Sprite_Pixels_Label (Name));
                        Emit_Global_Line ("  dq " & Sprite_Palette_Label (Name));
                        Emit_Global_Line ("  dq " & Nat_Img (Frame_Width));
                        Emit_Global_Line ("  dq " & Nat_Img (Frame_Height));
                        Emit_Global_Line ("  dq " & Nat_Img (Frame_Count));
                        Emit_Global_Line ("  dq " & Nat_Img (Sheet_Width));
                        Emit_Global_Line ("  dq " & Nat_Img (Sheet_Height));
                        Emit_Global_Line ("  dq " & Nat_Img (Static_Format_Code (Format_Kind)));
                        Emit_Global_U64_Table_Label (Sprite_Palette_Label (Name), Palette);
                        Emit_Global_Byte_Table_Label (Sprite_Pixels_Label (Name), Pixels, Pixel_Count);
                        Emit_Global_Line ("");
                     end if;
                  end;
               end;
            end;
         exception
            when others =>
               if Ada.Streams.Stream_IO.Is_Open (File_Handle) then
                  Ada.Streams.Stream_IO.Close (File_Handle);
               end if;
               Fail_Node (Node, Err_Runtime_IO_Failure, Source_Path, Success, Diag);
         end Load_Prepared_Sprite;
      begin
         pragma Unreferenced (Dummy_Sym);

         if Find_Static_Sprite (Name) /= 0 then
            Fail_Node (Node, Err_Type_Conflict, Name, Success, Diag);
            return;
         end if;

         while Setting /= 0 loop
            case Tree (Setting).Kind is
               when AST_Static_Source =>
                  if Tree (Setting).Left_Child = 0
                    or else Tree (Tree (Setting).Left_Child).Kind /= AST_String_Expr
                  then
                     Fail_Node (Setting, Err_Type_Conflict, Name, Success, Diag);
                     return;
                  end if;
                  declare
                     Raw_Source : constant String := Strip_String_Node (Tree (Setting).Left_Child);
                  begin
                     if Raw_Source'Length = 0 or else Raw_Source'Length > Source_Text'Length then
                        Fail_Node (Setting, Err_Mem_Out_Of_Bounds, Name, Success, Diag);
                        return;
                     end if;
                     Source_Len := Raw_Source'Length;
                     Source_Text (1 .. Source_Len) := Raw_Source;
                     Have_Source := True;
                  end;

               when AST_Static_Format =>
                  Format_Kind := Static_Format_From_Lexeme (Raw_Feature_Atom (Tree (Setting).Left_Child));
                  Have_Format := Format_Kind /= Static_Format_Unknown;
                  if not Have_Format then
                     Fail_Node (Setting, Err_Type_Conflict, Name, Success, Diag);
                     return;
                  end if;

               when AST_Static_Width =>
                  Comptime_Eval_Expr (Tree (Setting).Left_Child, Eval_U64, Success, Diag);
                  if not Success or else Eval_U64 = 0 or else Eval_U64 > U64 (Natural'Last) then
                     Fail_Node (Setting, Err_Mem_Out_Of_Bounds, Name, Success, Diag);
                     return;
                  end if;
                  Frame_Width := Natural (Eval_U64);
                  Have_Width := True;

               when AST_Static_Height =>
                  Comptime_Eval_Expr (Tree (Setting).Left_Child, Eval_U64, Success, Diag);
                  if not Success or else Eval_U64 = 0 or else Eval_U64 > U64 (Natural'Last) then
                     Fail_Node (Setting, Err_Mem_Out_Of_Bounds, Name, Success, Diag);
                     return;
                  end if;
                  Frame_Height := Natural (Eval_U64);
                  Have_Height := True;

               when AST_Static_Frames =>
                  Comptime_Eval_Expr (Tree (Setting).Left_Child, Eval_U64, Success, Diag);
                  if not Success or else Eval_U64 = 0 or else Eval_U64 > U64 (Natural'Last) then
                     Fail_Node (Setting, Err_Mem_Out_Of_Bounds, Name, Success, Diag);
                     return;
                  end if;
                  Frame_Count := Natural (Eval_U64);
                  Have_Frames := True;

               when others =>
                  null;
            end case;

            Setting := Tree (Setting).Next_Sibling;
         end loop;

         if not Have_Source
           or else not Have_Format
           or else not Have_Width
           or else not Have_Height
           or else not Have_Frames
         then
            Fail_Node (Node, Err_Type_Conflict, Name, Success, Diag);
            return;
         end if;

         if Format_Kind /= Static_Format_Indexed8Bit then
            Fail_Node (Node, Err_Type_Conflict, Name, Success, Diag);
            return;
         end if;

         declare
            Resolved_Source_Path : constant String :=
              Resolve_Static_Asset_Path (Source_Text (1 .. Source_Len), Node);
            Prepared_Source_Path : String (1 .. Max_Path_Len) := (others => ' ');
            Prepared_Source_Len  : Natural := 0;
            Needs_Cleanup        : Boolean := False;
         begin
            if not Path_Exists (Resolved_Source_Path) then
               Fail_Node (Node, Err_Runtime_IO_Failure, Resolved_Source_Path, Success, Diag);
               return;
            end if;

            Prepare_Image_Asset_For_Baking
              (Resolved_Source_Path,
               Node,
               Prepared_Source_Path,
               Prepared_Source_Len,
               Needs_Cleanup,
               Success,
               Diag);
            if not Success then
               Cleanup_Prepared_Image_Asset
                 (Prepared_Source_Path, Prepared_Source_Len, Needs_Cleanup);
               return;
            end if;

            Load_Prepared_Sprite (Prepared_Source_Path (1 .. Prepared_Source_Len));
            Cleanup_Prepared_Image_Asset
              (Prepared_Source_Path, Prepared_Source_Len, Needs_Cleanup);
            if not Success then
               return;
            end if;
         exception
            when others =>
               Cleanup_Prepared_Image_Asset
                 (Prepared_Source_Path, Prepared_Source_Len, Needs_Cleanup);
               Fail_Node (Node, Err_Runtime_IO_Failure, Resolved_Source_Path, Success, Diag);
               return;
         end;
      end Register_Static_Sprite_Decl;

      procedure Register_Bitmap_Font_Decl
        (Node    : in Node_Index;
         Success : in out Boolean;
         Diag    : in out Compiler_Diagnostic)
      is
         use type Ada.Streams.Stream_IO.Count;

         Raw_Name      : constant String := Raw_Lexeme (Tree (Tree (Node).Left_Child).Token_Index);
         Name          : constant String := Scoped_Lexeme (Raw_Name);
         Setting       : Node_Index := Tree (Node).Right_Child;
         Source_Text   : String (1 .. Max_Path_Len) := (others => ' ');
         Source_Len    : Natural := 0;
         Descriptor_Text : String (1 .. Max_Path_Len) := (others => ' ');
         Descriptor_Len  : Natural := 0;
         Format_Kind   : Static_Format_Kind := Static_Format_Unknown;
         Glyph_Width   : Natural := 0;
         Glyph_Height  : Natural := 0;
         First_Char    : Natural := 32;
         Spacing       : Natural := 0;
         Have_Source   : Boolean := False;
         Have_Format   : Boolean := False;
         Have_Descriptor : Boolean := False;
         Have_Width    : Boolean := False;
         Have_Height   : Boolean := False;
         Eval_U64      : U64 := 0;
         Dummy_Tag     : ALB_Type_Tag := Type_None;
         Dummy_Sym     : Symbol_Record;
         Idx           : Natural := 0;

         function Read_Text_File_Bounded
           (Path : String;
            Ok   : out Boolean) return String
         is
            use type Ada.Streams.Stream_IO.Count;
            use type Ada.Streams.Stream_Element_Offset;

            F         : Ada.Streams.Stream_IO.File_Type;
            File_Size : Ada.Streams.Stream_IO.Count := 0;
         begin
            Ada.Streams.Stream_IO.Open
              (F,
               Ada.Streams.Stream_IO.In_File,
               Path);
            File_Size := Ada.Streams.Stream_IO.Size (F);

            declare
               Len : constant Natural :=
                 (if File_Size > Ada.Streams.Stream_IO.Count (Max_Font_Descriptor_Bytes)
                  then Max_Font_Descriptor_Bytes
                  else Natural (File_Size));
            begin
               if Len = 0 then
                  Ada.Streams.Stream_IO.Close (F);
                  Ok := True;
                  return "";
               end if;

               declare
                  Buffer : Ada.Streams.Stream_Element_Array
                    (1 .. Ada.Streams.Stream_Element_Offset (Len));
                  Last   : Ada.Streams.Stream_Element_Offset := 0;
               begin
                  Ada.Streams.Stream_IO.Read (F, Buffer, Last);
                  Ada.Streams.Stream_IO.Close (F);

                  declare
                     Count_Read : constant Natural := Natural (Last);
                     Text       : String (1 .. Count_Read);
                  begin
                     for I in 1 .. Count_Read loop
                        Text (I) :=
                          Character'Val
                            (Integer
                               (Buffer (Ada.Streams.Stream_Element_Offset (I))));
                     end loop;
                     Ok := True;
                     return Text;
                  end;
               end;
            end;
         exception
            when others =>
               if Ada.Streams.Stream_IO.Is_Open (F) then
                  Ada.Streams.Stream_IO.Close (F);
               end if;
               Ok := False;
               return "";
         end Read_Text_File_Bounded;

         function LTrim (Text : String) return String is
            First_Pos : Integer := Text'First;
         begin
            while First_Pos <= Text'Last
              and then (Text (First_Pos) = ' ' or else Text (First_Pos) = ASCII.HT)
            loop
               First_Pos := First_Pos + 1;
            end loop;

            if First_Pos > Text'Last then
               return "";
            end if;

            return Text (First_Pos .. Text'Last);
         end LTrim;

         function Find_Field_Start
           (Line : String;
            Key  : String) return Integer
         is
            ULine : constant String := To_Upper (Line);
            UKey  : constant String := To_Upper (Key) & "=";
         begin
            if ULine'Length < UKey'Length then
               return 0;
            end if;

            for I in ULine'First .. ULine'Last - UKey'Length + 1 loop
               if ULine (I .. I + UKey'Length - 1) = UKey then
                  return I + UKey'Length;
               end if;
            end loop;

            return 0;
         end Find_Field_Start;

         function Read_Int_Field
           (Line  : String;
            Key   : String;
            Value : out Integer) return Boolean
         is
            Pos  : Integer := Find_Field_Start (Line, Key);
            Sign : Integer := 1;
            Acc  : Integer := 0;
         begin
            Value := 0;
            if Pos = 0 or else Pos > Line'Last then
               return False;
            end if;

            if Line (Pos) = '-' then
               Sign := -1;
               Pos := Pos + 1;
            elsif Line (Pos) = '+' then
               Pos := Pos + 1;
            end if;

            if Pos > Line'Last or else Line (Pos) not in '0' .. '9' then
               return False;
            end if;

            while Pos <= Line'Last and then Line (Pos) in '0' .. '9' loop
               Acc := (Acc * 10) + Integer (Character'Pos (Line (Pos)) - Character'Pos ('0'));
               Pos := Pos + 1;
            end loop;

            Value := Sign * Acc;
            return True;
         end Read_Int_Field;

         procedure Parse_BMFont_Descriptor
           (Descriptor_Path : String;
            Glyphs          : in out Font_Glyph_Array;
            Line_Height     : out Natural;
            Glyph_Count     : out Natural;
            Default_Advance : out Natural)
         is
            Loaded_OK   : Boolean := False;
            Text        : constant String := Read_Text_File_Bounded (Descriptor_Path, Loaded_OK);
            Cursor      : Integer := (if Text'Length > 0 then Text'First else 1);
            Pages_Count : Integer := 1;
         begin
            Line_Height := 0;
            Glyph_Count := 0;
            Default_Advance := 0;
            Glyphs := (others =>
              (X_Pos => 0,
               Y_Pos => 0,
               Width => 0,
               Height => 0,
               Offset_X => 0,
               Offset_Y => 0,
               Advance => 0,
               Present => False));

            if not Loaded_OK then
               Fail_Node (Node, Err_Runtime_IO_Failure, Descriptor_Path, Success, Diag);
               return;
            end if;

            while Text'Length > 0 and then Cursor <= Text'Last loop
               declare
                  Start_Pos : constant Integer := Cursor;
               begin
                  while Cursor <= Text'Last
                    and then Text (Cursor) /= ASCII.CR
                    and then Text (Cursor) /= ASCII.LF
                  loop
                     Cursor := Cursor + 1;
                  end loop;

                  declare
                     Raw_Line : constant String :=
                       (if Cursor > Start_Pos then Text (Start_Pos .. Cursor - 1) else "");
                     Line     : constant String := LTrim (Raw_Line);
                     ULine    : constant String := To_Upper (Line);
                     Tmp_Int  : Integer := 0;
                  begin
                     if ULine'Length >= 6
                       and then ULine (ULine'First .. ULine'First + 5) = "COMMON"
                     then
                        if Read_Int_Field (Line, "lineHeight", Tmp_Int)
                          and then Tmp_Int > 0
                        then
                           Line_Height := Natural (Tmp_Int);
                        end if;

                        if Read_Int_Field (Line, "pages", Tmp_Int)
                          and then Tmp_Int > 0
                        then
                           Pages_Count := Tmp_Int;
                        end if;
                     elsif ULine'Length >= 5
                       and then ULine (ULine'First .. ULine'First + 4) = "CHAR "
                     then
                        declare
                           Char_Id   : Integer := 0;
                           Glyph_Page : Integer := 0;
                           GX        : Integer := 0;
                           GY        : Integer := 0;
                           GW        : Integer := 0;
                           GH        : Integer := 0;
                           GOff_X    : Integer := 0;
                           GOff_Y    : Integer := 0;
                           GAdv      : Integer := 0;
                        begin
                           if Read_Int_Field (Line, "id", Char_Id)
                             and then Char_Id >= 0
                             and then Char_Id <= Max_Font_Glyph_Code
                           then
                              if Read_Int_Field (Line, "page", Glyph_Page)
                                and then Glyph_Page /= 0
                              then
                                 Fail_Node (Node, Err_Type_Conflict, Descriptor_Path, Success, Diag);
                                 return;
                              end if;

                              if Read_Int_Field (Line, "x", GX) then null; end if;
                              if Read_Int_Field (Line, "y", GY) then null; end if;
                              if Read_Int_Field (Line, "width", GW) then null; end if;
                              if Read_Int_Field (Line, "height", GH) then null; end if;
                              if Read_Int_Field (Line, "xoffset", GOff_X) then null; end if;
                              if Read_Int_Field (Line, "yoffset", GOff_Y) then null; end if;
                              if Read_Int_Field (Line, "xadvance", GAdv) then null; end if;

                              if GAdv = 0 and then GW > 0 then
                                 GAdv := GW;
                              end if;

                              Glyphs (Natural (Char_Id)) :=
                                (X_Pos => GX,
                                 Y_Pos => GY,
                                 Width => GW,
                                 Height => GH,
                                 Offset_X => GOff_X,
                                 Offset_Y => GOff_Y,
                                 Advance => GAdv,
                                 Present => True);
                           end if;
                        end;
                     end if;
                  end;

                  while Cursor <= Text'Last
                    and then (Text (Cursor) = ASCII.CR or else Text (Cursor) = ASCII.LF)
                  loop
                     Cursor := Cursor + 1;
                  end loop;
               end;
            end loop;

            if Pages_Count > 1 then
               Fail_Node (Node, Err_Type_Conflict, Descriptor_Path, Success, Diag);
               return;
            end if;

            for I in Glyphs'Range loop
               if Glyphs (I).Present then
                  Glyph_Count := Glyph_Count + 1;
                  if Default_Advance = 0 and then Glyphs (I).Advance > 0 then
                     Default_Advance := Natural (Glyphs (I).Advance);
                  end if;
                  if Line_Height = 0 and then Glyphs (I).Height > 0 then
                     Line_Height := Natural (Glyphs (I).Height);
                  end if;
               end if;
            end loop;

            if Glyphs (32).Present and then Glyphs (32).Advance > 0 then
               Default_Advance := Natural (Glyphs (32).Advance);
            end if;

            if Line_Height = 0 then
               Line_Height := 16;
            end if;

            if Default_Advance = 0 then
               Default_Advance := Natural'Max (1, Line_Height / 2);
            end if;
         end Parse_BMFont_Descriptor;

         procedure Load_Font_Pixels_From_Bmp
           (Source_Path   : String;
            Pixels        : out Static_Pixel_Buffer;
            Sheet_Width   : out Natural;
            Sheet_Height  : out Natural;
            Pixel_Count   : out Natural)
         is
            File_Handle : Ada.Streams.Stream_IO.File_Type;
         begin
            Pixels := (others => 0);
            Sheet_Width := 0;
            Sheet_Height := 0;
            Pixel_Count := 0;

            Ada.Streams.Stream_IO.Open
              (File_Handle,
               Ada.Streams.Stream_IO.In_File,
               Source_Path);

            declare
               File_Size_Count : constant Ada.Streams.Stream_IO.Count :=
                 Ada.Streams.Stream_IO.Size (File_Handle);
            begin
               if File_Size_Count = 0
                 or else File_Size_Count > Ada.Streams.Stream_IO.Count (Max_Static_Sprite_Bytes + 8192)
               then
                  Ada.Streams.Stream_IO.Close (File_Handle);
                  Fail_Node (Node, Err_Mem_Out_Of_Bounds, Source_Path, Success, Diag);
                  return;
               end if;

               declare
                  File_Size : constant Natural := Natural (File_Size_Count);
                  Buffer    : Ada.Streams.Stream_Element_Array
                    (1 .. Ada.Streams.Stream_Element_Offset (File_Size));
                  Last      : Ada.Streams.Stream_Element_Offset := 0;

                  function Has_Bytes
                    (Offset : Natural;
                     Count  : Natural) return Boolean
                  is
                  begin
                     return Offset + Count <= File_Size;
                  end Has_Bytes;

                  function B (Offset : Natural) return Natural is
                  begin
                     return Natural
                       (Buffer (Ada.Streams.Stream_Element_Offset (Offset + 1)));
                  end B;

                  function U16_LE (Offset : Natural) return Natural is
                  begin
                     return B (Offset) + (B (Offset + 1) * 256);
                  end U16_LE;

                  function U32_LE (Offset : Natural) return U64 is
                  begin
                     return U64 (B (Offset))
                       + (U64 (B (Offset + 1)) * 16#100#)
                       + (U64 (B (Offset + 2)) * 16#1_0000#)
                       + (U64 (B (Offset + 3)) * 16#100_0000#);
                  end U32_LE;

                  function S32_LE (Offset : Natural) return Integer is
                     Raw : constant U64 := U32_LE (Offset);
                  begin
                     if Raw >= 16#8000_0000# then
                        return -Integer (16#1_0000_0000# - Raw);
                     else
                        return Integer (Raw);
                     end if;
                  end S32_LE;
               begin
                  Ada.Streams.Stream_IO.Read (File_Handle, Buffer, Last);
                  Ada.Streams.Stream_IO.Close (File_Handle);

                  if Natural (Last) /= File_Size then
                     Fail_Node (Node, Err_Runtime_IO_Failure, Source_Path, Success, Diag);
                     return;
                  end if;

                  if not Has_Bytes (0, 54)
                    or else B (0) /= Character'Pos ('B')
                    or else B (1) /= Character'Pos ('M')
                  then
                     Fail_Node (Node, Err_Type_Conflict, Source_Path, Success, Diag);
                     return;
                  end if;

                  declare
                     Pixel_Offset    : constant Natural := Natural (U32_LE (10));
                     DIB_Size        : constant Natural := Natural (U32_LE (14));
                     Local_Width     : constant Natural := Natural (U32_LE (18));
                     Height_Signed   : constant Integer := S32_LE (22);
                     Local_Height    : constant Natural := Natural (abs Height_Signed);
                     Planes          : constant Natural := U16_LE (26);
                     Bits_Per_Pixel  : constant Natural := U16_LE (28);
                     Compression     : constant U64 := U32_LE (30);
                     Bytes_Per_Pixel : constant Natural :=
                       (if Bits_Per_Pixel = 8 then 1
                        elsif Bits_Per_Pixel = 24 then 3
                        elsif Bits_Per_Pixel = 32 then 4
                        else 0);
                     Row_Stride      : constant Natural :=
                       (if Bytes_Per_Pixel = 0
                        then 0
                        else (((Local_Width * Bytes_Per_Pixel) + 3) / 4) * 4);
                  begin
                     if DIB_Size < 40
                       or else Height_Signed = 0
                       or else Planes /= 1
                       or else Bytes_Per_Pixel = 0
                       or else (Bits_Per_Pixel = 8 and then Compression /= 0)
                       or else (Bits_Per_Pixel = 24 and then Compression /= 0)
                       or else (Bits_Per_Pixel = 32 and then Compression /= 0 and then Compression /= 3)
                     then
                        Fail_Node (Node, Err_Type_Conflict, Source_Path, Success, Diag);
                        return;
                     end if;

                     Sheet_Width := Local_Width;
                     Sheet_Height := Local_Height;
                     Pixel_Count := Sheet_Width * Sheet_Height;

                     if Pixel_Count = 0 or else Pixel_Count > Max_Static_Sprite_Bytes then
                        Fail_Node (Node, Err_Mem_Out_Of_Bounds, Source_Path, Success, Diag);
                        return;
                     end if;

                     if not Has_Bytes (Pixel_Offset, Row_Stride * Sheet_Height) then
                        Fail_Node (Node, Err_Runtime_IO_Failure, Source_Path, Success, Diag);
                        return;
                     end if;

                     for Y in 0 .. Sheet_Height - 1 loop
                        declare
                           Source_Row : constant Natural :=
                             (if Height_Signed > 0 then Sheet_Height - 1 - Y else Y);
                           Row_Start  : constant Natural := Pixel_Offset + (Source_Row * Row_Stride);
                        begin
                           for X in 0 .. Sheet_Width - 1 loop
                              declare
                                 Pixel_Index : constant Positive := (Y * Sheet_Width) + X + 1;
                                 Pixel_Byte  : Natural := 0;
                              begin
                                 if Bits_Per_Pixel = 8 then
                                    Pixel_Byte := B (Row_Start + X);
                                 elsif Bits_Per_Pixel = 24 then
                                    declare
                                       Blue  : constant Natural := B (Row_Start + (X * 3) + 0);
                                       Green : constant Natural := B (Row_Start + (X * 3) + 1);
                                       Red   : constant Natural := B (Row_Start + (X * 3) + 2);
                                    begin
                                       Pixel_Byte := Natural'Max (Red, Natural'Max (Green, Blue));
                                    end;
                                 else
                                    declare
                                       Blue  : constant Natural := B (Row_Start + (X * 4) + 0);
                                       Green : constant Natural := B (Row_Start + (X * 4) + 1);
                                       Red   : constant Natural := B (Row_Start + (X * 4) + 2);
                                    begin
                                       Pixel_Byte := Natural'Max (Red, Natural'Max (Green, Blue));
                                    end;
                                 end if;

                                 Pixels (Pixel_Index) := Pixel_Byte;
                              end;
                           end loop;
                        end;
                     end loop;
                  end;
               end;
            end;
         exception
            when others =>
               if Ada.Streams.Stream_IO.Is_Open (File_Handle) then
                  Ada.Streams.Stream_IO.Close (File_Handle);
               end if;
               Fail_Node (Node, Err_Runtime_IO_Failure, Source_Path, Success, Diag);
         end Load_Font_Pixels_From_Bmp;
      begin
         pragma Unreferenced (Dummy_Sym);

         if Find_Bitmap_Font (Name) /= 0 or else Find_System_Font (Name) /= 0 then
            Fail_Node (Node, Err_Type_Conflict, Name, Success, Diag);
            return;
         end if;

         while Setting /= 0 loop
            case Tree (Setting).Kind is
               when AST_Static_Source =>
                  if Tree (Setting).Left_Child = 0
                    or else Tree (Tree (Setting).Left_Child).Kind /= AST_String_Expr
                  then
                     Fail_Node (Setting, Err_Type_Conflict, Name, Success, Diag);
                     return;
                  end if;
                  declare
                     Raw_Source : constant String := Strip_String_Node (Tree (Setting).Left_Child);
                  begin
                     if Raw_Source'Length = 0 or else Raw_Source'Length > Source_Text'Length then
                        Fail_Node (Setting, Err_Mem_Out_Of_Bounds, Name, Success, Diag);
                        return;
                     end if;
                     Source_Len := Raw_Source'Length;
                     Source_Text (1 .. Source_Len) := Raw_Source;
                     Have_Source := True;
                  end;

               when AST_Static_Format =>
                  Format_Kind := Static_Format_From_Lexeme (Raw_Feature_Atom (Tree (Setting).Left_Child));
                  Have_Format := Format_Kind /= Static_Format_Unknown;
                  if not Have_Format then
                     Fail_Node (Setting, Err_Type_Conflict, Name, Success, Diag);
                     return;
                  end if;

               when AST_Font_Glyph_Width =>
                  Comptime_Eval_Expr (Tree (Setting).Left_Child, Eval_U64, Success, Diag);
                  if not Success or else Eval_U64 = 0 or else Eval_U64 > U64 (Natural'Last) then
                     Fail_Node (Setting, Err_Mem_Out_Of_Bounds, Name, Success, Diag);
                     return;
                  end if;
                  Glyph_Width := Natural (Eval_U64);
                  Have_Width := True;

               when AST_Font_Glyph_Height =>
                  Comptime_Eval_Expr (Tree (Setting).Left_Child, Eval_U64, Success, Diag);
                  if not Success or else Eval_U64 = 0 or else Eval_U64 > U64 (Natural'Last) then
                     Fail_Node (Setting, Err_Mem_Out_Of_Bounds, Name, Success, Diag);
                     return;
                  end if;
                  Glyph_Height := Natural (Eval_U64);
                  Have_Height := True;

               when AST_Font_First_Char =>
                  Comptime_Eval_Expr (Tree (Setting).Left_Child, Eval_U64, Success, Diag);
                  if not Success or else Eval_U64 > U64 (Natural'Last) then
                     Fail_Node (Setting, Err_Mem_Out_Of_Bounds, Name, Success, Diag);
                     return;
                  end if;
                  First_Char := Natural (Eval_U64);

               when AST_Font_Spacing =>
                  Comptime_Eval_Expr (Tree (Setting).Left_Child, Eval_U64, Success, Diag);
                  if not Success or else Eval_U64 > U64 (Natural'Last) then
                     Fail_Node (Setting, Err_Mem_Out_Of_Bounds, Name, Success, Diag);
                     return;
                  end if;
                  Spacing := Natural (Eval_U64);

               when others =>
                  null;
            end case;

            Setting := Tree (Setting).Next_Sibling;
         end loop;

         if not Have_Source
           or else (not Have_Descriptor and then (not Have_Width or else not Have_Height))
         then
            Fail_Node (Node, Err_Type_Conflict, Name, Success, Diag);
            return;
         end if;

         if Have_Format and then Format_Kind /= Static_Format_Indexed8Bit then
            Fail_Node (Node, Err_Type_Conflict, Name, Success, Diag);
            return;
         end if;

         if not Have_Format then
            Format_Kind := Static_Format_Indexed8Bit;
         end if;

         declare
            Glyphs : Font_Glyph_Array := (others =>
              (X_Pos => 0,
               Y_Pos => 0,
               Width => 0,
               Height => 0,
               Offset_X => 0,
               Offset_Y => 0,
               Advance => 0,
               Present => False));
            Pixels : Static_Pixel_Buffer := (others => 0);
            Sheet_Width_Val      : Natural := 0;
            Sheet_Height_Val     : Natural := 0;
            Pixel_Count_Val      : Natural := 0;
            Line_Height_Val      : Natural := 0;
            Glyph_Count_Val      : Natural := 0;
            Default_Advance_Val  : Natural := 0;
            Descriptor_Path      : constant String :=
              (if Have_Descriptor
               then Resolve_Static_Asset_Path (Descriptor_Text (1 .. Descriptor_Len), Node)
               else "");
            Resolved_Source_Path : constant String :=
              Resolve_Static_Asset_Path (Source_Text (1 .. Source_Len), Node);
            Prepared_Source_Path : String (1 .. Max_Path_Len) := (others => ' ');
            Prepared_Source_Len  : Natural := 0;
            Needs_Cleanup        : Boolean := False;
            Max_Glyph_Width      : Natural := 0;
            Max_Glyph_Height     : Natural := 0;
         begin
            if Have_Descriptor then
               if not Path_Exists (Descriptor_Path) then
                  Fail_Node (Node, Err_Runtime_IO_Failure, Descriptor_Path, Success, Diag);
                  return;
               end if;

               Parse_BMFont_Descriptor
                 (Descriptor_Path,
                  Glyphs,
                  Line_Height_Val,
                  Glyph_Count_Val,
                  Default_Advance_Val);
               if not Success then
                  return;
               end if;
            end if;

            if not Path_Exists (Resolved_Source_Path) then
               Fail_Node (Node, Err_Runtime_IO_Failure, Resolved_Source_Path, Success, Diag);
               return;
            end if;

            Prepare_Image_Asset_For_Baking
              (Resolved_Source_Path,
               Node,
               Prepared_Source_Path,
               Prepared_Source_Len,
               Needs_Cleanup,
               Success,
               Diag);
            if not Success then
               Cleanup_Prepared_Image_Asset
                 (Prepared_Source_Path, Prepared_Source_Len, Needs_Cleanup);
               return;
            end if;

            Load_Font_Pixels_From_Bmp
              (Prepared_Source_Path (1 .. Prepared_Source_Len),
               Pixels,
               Sheet_Width_Val,
               Sheet_Height_Val,
               Pixel_Count_Val);
            Cleanup_Prepared_Image_Asset
              (Prepared_Source_Path, Prepared_Source_Len, Needs_Cleanup);
            if not Success then
               return;
            end if;

            if Have_Descriptor then
               if Spacing > 0 then
                  for I in Glyphs'Range loop
                     if Glyphs (I).Present and then Glyphs (I).Advance > 0 then
                        Glyphs (I).Advance := Glyphs (I).Advance + Integer (Spacing);
                     end if;
                  end loop;
                  Default_Advance_Val := Default_Advance_Val + Spacing;
               end if;
            else
               declare
                  Width_Aligned  : constant Boolean :=
                    Glyph_Width /= 0 and then (Sheet_Width_Val mod Glyph_Width) = 0;
                  Height_Aligned : constant Boolean :=
                    Glyph_Height /= 0 and then (Sheet_Height_Val mod Glyph_Height) = 0;
                  Glyph_Columns  : constant Natural :=
                    (if Width_Aligned then Sheet_Width_Val / Glyph_Width else 0);
                  Glyph_Rows     : constant Natural :=
                    (if Height_Aligned then Sheet_Height_Val / Glyph_Height else 0);
               begin
                  Glyph_Count_Val := Glyph_Columns * Glyph_Rows;
                  if not Width_Aligned
                    or else not Height_Aligned
                    or else Glyph_Columns = 0
                    or else Glyph_Rows = 0
                    or else Glyph_Count_Val = 0
                    or else First_Char + Glyph_Count_Val - 1 > Max_Font_Glyph_Code
                  then
                     Fail_Node (Node, Err_Mem_Out_Of_Bounds, Resolved_Source_Path, Success, Diag);
                     return;
                  end if;

                  for G in 0 .. Glyph_Count_Val - 1 loop
                     declare
                        Char_Code : constant Natural := First_Char + G;
                        Col       : constant Natural := G mod Glyph_Columns;
                        Row       : constant Natural := G / Glyph_Columns;
                     begin
                        Glyphs (Char_Code) :=
                          (X_Pos => Integer (Col * Glyph_Width),
                           Y_Pos => Integer (Row * Glyph_Height),
                           Width => Integer (Glyph_Width),
                           Height => Integer (Glyph_Height),
                           Offset_X => 0,
                           Offset_Y => 0,
                           Advance => Integer (Glyph_Width + Spacing),
                           Present => True);
                     end;
                  end loop;

                  Line_Height_Val := Glyph_Height;
                  Default_Advance_Val := Glyph_Width + Spacing;
               end;
            end if;

            for I in Glyphs'Range loop
               if Glyphs (I).Present then
                  if Glyphs (I).X_Pos < 0
                    or else Glyphs (I).Y_Pos < 0
                    or else Glyphs (I).Width < 0
                    or else Glyphs (I).Height < 0
                    or else Glyphs (I).X_Pos + Glyphs (I).Width > Integer (Sheet_Width_Val)
                    or else Glyphs (I).Y_Pos + Glyphs (I).Height > Integer (Sheet_Height_Val)
                  then
                     Fail_Node (Node, Err_Mem_Out_Of_Bounds, Resolved_Source_Path, Success, Diag);
                     return;
                  end if;

                  if Natural'Max (0, Glyphs (I).Width) > Max_Glyph_Width then
                     Max_Glyph_Width := Natural'Max (0, Glyphs (I).Width);
                  end if;
                  if Natural'Max (0, Glyphs (I).Height) > Max_Glyph_Height then
                     Max_Glyph_Height := Natural'Max (0, Glyphs (I).Height);
                  end if;
               end if;
            end loop;

            if Glyph_Count_Val = 0 then
               Fail_Node (Node, Err_Type_Conflict, Name, Success, Diag);
               return;
            end if;

            if Glyph_Width = 0 then
               Glyph_Width := Max_Glyph_Width;
            end if;
            if Glyph_Height = 0 then
               Glyph_Height := Max_Glyph_Height;
            end if;
            if Line_Height_Val = 0 then
               Line_Height_Val := Natural'Max (1, Glyph_Height);
            end if;
            if Default_Advance_Val = 0 then
               Default_Advance_Val := Natural'Max (1, Glyph_Width);
            end if;

            if Bitmap_Font_Count >= Max_Bitmap_Fonts then
               Fail_Node (Node, Err_Mem_Out_Of_Bounds, Name, Success, Diag);
               return;
            end if;

            Dummy_Sym := Resolve_Symbol (Raw_Name, Type_U64, 0, False, Dummy_Tag);

            Bitmap_Font_Count := Bitmap_Font_Count + 1;
            Idx := Bitmap_Font_Count;
            Bitmap_Fonts (Idx).Name_Hash := Hash_String (Name);
            Store_Name (Bitmap_Fonts (Idx).Name, Bitmap_Fonts (Idx).Name_Len, Name);
            Bitmap_Fonts (Idx).Glyph_Width := Glyph_Width;
            Bitmap_Fonts (Idx).Glyph_Height := Glyph_Height;
            Bitmap_Fonts (Idx).First_Char := First_Char;
            Bitmap_Fonts (Idx).Spacing := Spacing;
            Bitmap_Fonts (Idx).Sheet_Width := Sheet_Width_Val;
            Bitmap_Fonts (Idx).Sheet_Height := Sheet_Height_Val;
            Bitmap_Fonts (Idx).Line_Height := Line_Height_Val;
            Bitmap_Fonts (Idx).Default_Advance := Default_Advance_Val;
            Bitmap_Fonts (Idx).Glyph_Count := Glyph_Count_Val;
            Bitmap_Fonts (Idx).Format := Format_Kind;
            Bitmap_Fonts (Idx).Active := True;

            if Target = Backend_C then
               Emit_Global_Byte_Table_Label
                 (Bitmap_Font_Pixels_Label (Name), Pixels, Pixel_Count_Val);
               Emit_Global_Font_Glyph_Table_Label
                 (Bitmap_Font_Glyphs_Label (Name), Glyphs);
               Emit_Global_Line
                 ("static const uint64_t " & Font_Meta_Label (Name) & "[8] = {");
               Emit_Global_Line
                 ("    " & Nat_Img (Font_Kind_Code (Font_Kind_Bitmap)) & ",");
               Emit_Global_Line
                 ("    (uint64_t)(uintptr_t)" & Bitmap_Font_Pixels_Label (Name) & ",");
               Emit_Global_Line ("    " & Nat_Img (Sheet_Width_Val) & ",");
               Emit_Global_Line ("    " & Nat_Img (Sheet_Height_Val) & ",");
               Emit_Global_Line ("    " & Nat_Img (Line_Height_Val) & ",");
               Emit_Global_Line
                 ("    (uint64_t)(uintptr_t)" & Bitmap_Font_Glyphs_Label (Name) & ",");
               Emit_Global_Line ("    " & Nat_Img (Default_Advance_Val) & ",");
               Emit_Global_Line ("    " & Nat_Img (Glyph_Count_Val));
               Emit_Global_Line ("};");
               Emit_Global_Line ("");
            else
               Emit_Global_Line
                 ("  " & Font_Meta_Label (Name) & " dq " &
                  Nat_Img (Font_Kind_Code (Font_Kind_Bitmap)));
               Emit_Global_Line ("  dq " & Bitmap_Font_Pixels_Label (Name));
               Emit_Global_Line ("  dq " & Nat_Img (Sheet_Width_Val));
               Emit_Global_Line ("  dq " & Nat_Img (Sheet_Height_Val));
               Emit_Global_Line ("  dq " & Nat_Img (Line_Height_Val));
               Emit_Global_Line ("  dq " & Bitmap_Font_Glyphs_Label (Name));
               Emit_Global_Line ("  dq " & Nat_Img (Default_Advance_Val));
               Emit_Global_Line ("  dq " & Nat_Img (Glyph_Count_Val));
               Emit_Global_Font_Glyph_Table_Label
                 (Bitmap_Font_Glyphs_Label (Name), Glyphs);
               Emit_Global_Byte_Table_Label
                 (Bitmap_Font_Pixels_Label (Name), Pixels, Pixel_Count_Val);
               Emit_Global_Line ("");
            end if;
         exception
            when others =>
               Cleanup_Prepared_Image_Asset
                 (Prepared_Source_Path, Prepared_Source_Len, Needs_Cleanup);
               Fail_Node (Node, Err_Runtime_IO_Failure, Resolved_Source_Path, Success, Diag);
               return;
         end;
      end Register_Bitmap_Font_Decl;

      procedure Register_System_Font_Decl
        (Node    : in Node_Index;
         Success : in out Boolean;
         Diag    : in out Compiler_Diagnostic)
      is
         Raw_Name      : constant String := Raw_Lexeme (Tree (Tree (Node).Left_Child).Token_Index);
         Name          : constant String := Scoped_Lexeme (Raw_Name);
         Setting       : Node_Index := Tree (Node).Right_Child;
         Source_Text   : String (1 .. Max_Path_Len) := (others => ' ');
         Source_Len    : Natural := 0;
         Size_Px       : Natural := 12;
         Weight_Code   : Natural := 400;
         Anti_Alias    : Boolean := True;
         Charset_First : Natural := 32;
         Charset_Last  : Natural := 126;
         Eval_U64      : U64 := 0;
         Dummy_Tag     : ALB_Type_Tag := Type_None;
         Dummy_Sym     : Symbol_Record;
         Idx           : Natural := 0;
         Weight_Eval_Ok : Boolean := False;
      begin
         pragma Unreferenced (Dummy_Sym);

         if Find_Bitmap_Font (Name) /= 0 or else Find_System_Font (Name) /= 0 then
            Fail_Node (Node, Err_Type_Conflict, Name, Success, Diag);
            return;
         end if;

         while Setting /= 0 loop
            case Tree (Setting).Kind is
               when AST_Static_Source =>
                  if Tree (Setting).Left_Child = 0
                    or else Tree (Tree (Setting).Left_Child).Kind /= AST_String_Expr
                  then
                     Fail_Node (Setting, Err_Type_Conflict, Name, Success, Diag);
                     return;
                  end if;
                  declare
                     Raw_Source : constant String := Strip_String_Node (Tree (Setting).Left_Child);
                  begin
                     if Raw_Source'Length > Source_Text'Length then
                        Fail_Node (Setting, Err_Mem_Out_Of_Bounds, Name, Success, Diag);
                        return;
                     end if;
                     Source_Len := Raw_Source'Length;
                     if Source_Len > 0 then
                        Source_Text (1 .. Source_Len) := Raw_Source;
                     end if;
                  end;

               when AST_Font_Size =>
                  Comptime_Eval_Expr (Tree (Setting).Left_Child, Eval_U64, Success, Diag);
                  if not Success or else Eval_U64 = 0 or else Eval_U64 > U64 (Natural'Last) then
                     Fail_Node (Setting, Err_Mem_Out_Of_Bounds, Name, Success, Diag);
                     return;
                  end if;
                  Size_Px := Natural (Eval_U64);

               when AST_Font_Weight =>
                  declare
                     Weight_Text : constant String := Raw_Feature_Atom (Tree (Setting).Left_Child);
                  begin
                     Weight_Code := Font_Weight_Code_From_Lexeme (Weight_Text);
                     if Weight_Code = 0 then
                        Comptime_Eval_Expr (Tree (Setting).Left_Child, Eval_U64, Weight_Eval_Ok, Diag);
                        if not Weight_Eval_Ok or else Eval_U64 > U64 (Natural'Last) then
                           Fail_Node (Setting, Err_Type_Conflict, Name, Success, Diag);
                           return;
                        end if;
                        Weight_Code := Natural (Eval_U64);
                     end if;
                  end;

               when AST_Font_Anti_Alias =>
                  declare
                     AA_Text : constant String := To_Upper (Raw_Feature_Atom (Tree (Setting).Left_Child));
                  begin
                     if AA_Text = "TRUE" then
                        Anti_Alias := True;
                     elsif AA_Text = "FALSE" then
                        Anti_Alias := False;
                     else
                        Comptime_Eval_Expr (Tree (Setting).Left_Child, Eval_U64, Success, Diag);
                        if not Success then
                           Fail_Node (Setting, Err_Type_Conflict, Name, Success, Diag);
                           return;
                        end if;
                        Anti_Alias := Eval_U64 /= 0;
                     end if;
                  end;

               when AST_Font_Character_Set =>
                  Comptime_Eval_Expr (Tree (Setting).Left_Child, Eval_U64, Success, Diag);
                  if not Success or else Eval_U64 > U64 (Natural'Last) then
                     Fail_Node (Setting, Err_Mem_Out_Of_Bounds, Name, Success, Diag);
                     return;
                  end if;
                  Charset_First := Natural (Eval_U64);

                  Comptime_Eval_Expr (Tree (Setting).Right_Child, Eval_U64, Success, Diag);
                  if not Success or else Eval_U64 > U64 (Natural'Last) then
                     Fail_Node (Setting, Err_Mem_Out_Of_Bounds, Name, Success, Diag);
                     return;
                  end if;
                  Charset_Last := Natural (Eval_U64);

               when others =>
                  null;
            end case;

            Setting := Tree (Setting).Next_Sibling;
         end loop;

         if Charset_Last < Charset_First then
            Fail_Node (Node, Err_Type_Conflict, Name, Success, Diag);
            return;
         end if;

         if System_Font_Count >= Max_System_Fonts then
            Fail_Node (Node, Err_Mem_Out_Of_Bounds, Name, Success, Diag);
            return;
         end if;

         Dummy_Sym := Resolve_Symbol (Raw_Name, Type_U64, 0, False, Dummy_Tag);

         System_Font_Count := System_Font_Count + 1;
         Idx := System_Font_Count;
         System_Fonts (Idx).Name_Hash := Hash_String (Name);
         Store_Name (System_Fonts (Idx).Name, System_Fonts (Idx).Name_Len, Name);
         System_Fonts (Idx).Size_Px := Size_Px;
         System_Fonts (Idx).Weight_Code := Weight_Code;
         System_Fonts (Idx).Anti_Alias := Anti_Alias;
         System_Fonts (Idx).Charset_First := Charset_First;
         System_Fonts (Idx).Charset_Last := Charset_Last;
         System_Fonts (Idx).Source_Len := Source_Len;
         if Source_Len > 0 then
            System_Fonts (Idx).Source_Text (1 .. Source_Len) :=
              Source_Text (1 .. Source_Len);
         end if;
         System_Fonts (Idx).Active := True;

         if Target = Backend_C then
            declare
               Escaped_Source : constant String :=
                 (if Source_Len > 0 then Source_Text (1 .. Source_Len) else "");
            begin
               Emit_Global_Line
                 ("static const char " & System_Font_Source_Label (Name) &
                  "[] = """ & Escaped_Source & """;");
               Emit_Global_Line
                 ("static const uint64_t " & Font_Meta_Label (Name) & "[9] = {");
               Emit_Global_Line
                 ("    " & Nat_Img (Font_Kind_Code (Font_Kind_System)) & ",");
               Emit_Global_Line
                 ("    (uint64_t)(uintptr_t)" & System_Font_Source_Label (Name) & ",");
               Emit_Global_Line ("    " & Nat_Img (Size_Px) & ",");
               Emit_Global_Line ("    " & Nat_Img (Weight_Code) & ",");
               Emit_Global_Line ("    " & Nat_Img (Boolean'Pos (Anti_Alias)) & ",");
               Emit_Global_Line ("    " & Nat_Img (Charset_First) & ",");
               Emit_Global_Line ("    " & Nat_Img (Charset_Last) & ",");
               Emit_Global_Line ("    0,");
               Emit_Global_Line ("    0");
               Emit_Global_Line ("};");
               Emit_Global_Line ("");
            end;
         else
            if Source_Len > 0 then
               Emit_Global_String_Label
                 (System_Font_Source_Label (Name), Source_Text (1 .. Source_Len));
            else
               Emit_Global_String_Label (System_Font_Source_Label (Name), "");
            end if;
            Emit_Global_Line
              ("  " & Font_Meta_Label (Name) & " dq " &
               Nat_Img (Font_Kind_Code (Font_Kind_System)));
            Emit_Global_Line ("  dq " & System_Font_Source_Label (Name));
            Emit_Global_Line ("  dq " & Nat_Img (Size_Px));
            Emit_Global_Line ("  dq " & Nat_Img (Weight_Code));
            Emit_Global_Line ("  dq " & Nat_Img (Boolean'Pos (Anti_Alias)));
            Emit_Global_Line ("  dq " & Nat_Img (Charset_First));
            Emit_Global_Line ("  dq " & Nat_Img (Charset_Last));
            Emit_Global_Line ("  dq 0");
            Emit_Global_Line ("  dq 0");
            Emit_Global_Line ("");
         end if;
      end Register_System_Font_Decl;

      function Find_Process_Handle (Name : String) return Natural is
      begin
         for I in 1 .. Process_Handle_Count loop
            if Process_Handles (I).Active
              and then Process_Handles (I).Name_Len = Name'Length
              and then Process_Handles (I).Name (1 .. Name'Length) = Name
            then
               return I;
            end if;
         end loop;

         return 0;
      end Find_Process_Handle;

      function Process_Right_Mask_From_Lexeme
        (Lexeme : String) return U64
      is
         U : constant String := Upper_ASCII (Lexeme);
      begin
         if U = "READ" then
            return Proc_Right_Read;
         elsif U = "WRITE" then
            return Proc_Right_Write;
         elsif U = "QUERY" then
            return Proc_Right_Query;
         elsif U = "EXECUTE" then
            return Proc_Right_Execute;
         elsif U = "ALLOCATE" then
            return Proc_Right_Allocate;
         elsif U = "THREAD" then
            return Proc_Right_Thread;
         else
            return 0;
         end if;
      end Process_Right_Mask_From_Lexeme;

      function Process_Mode_Code
        (Source_Kind : Process_Source_Kind) return Natural
      is
      begin
         case Source_Kind is
            when Process_Source_Pid =>
               return Proc_Mode_Self_PID;
            when Process_Source_Image =>
               return Proc_Mode_Self_Image;
            when others =>
               return Proc_Mode_Raw_Child;
         end case;
      end Process_Mode_Code;

      function Process_Scalar_Code
        (Tag : ALB_Type_Tag) return Natural
      is
      begin
         case Tag is
            when Type_U8 | Type_Boolean =>
               return Proc_Scalar_U8;
            when Type_U16 =>
               return Proc_Scalar_U16;
            when Type_U32 =>
               return Proc_Scalar_U32;
            when Type_S32 | Type_HW32 =>
               return Proc_Scalar_S32;
            when Type_S64 =>
               return Proc_Scalar_S64;
            when others =>
               return Proc_Scalar_U64;
         end case;
      end Process_Scalar_Code;

      function Process_Scalar_Tag_From_Node
        (Type_Node : Node_Index) return ALB_Type_Tag
      is
      begin
         if Type_Node = 0 or else Tree (Type_Node).Token_Index = 0 then
            return Type_None;
         end if;

         declare
            Tag : constant ALB_Type_Tag :=
              Type_From_Lexeme (Raw_Lexeme (Tree (Type_Node).Token_Index));
         begin
            if Tag in Type_U8 | Type_U16 | Type_U32 | Type_U64 | Type_S32 | Type_S64 | Type_Boolean then
               return Tag;
            end if;
         end;

         return Type_None;
      end Process_Scalar_Tag_From_Node;

      procedure Require_Process_Right
        (Handle_Name : String;
         Need_Mask   : U64;
         Origin      : Node_Index;
         Success     : in out Boolean;
         Diag        : in out Compiler_Diagnostic)
      is
         Idx : constant Natural := Find_Process_Handle (Handle_Name);
      begin
         if Idx = 0 or else Need_Mask = 0 then
            return;
         end if;

         if (Process_Handles (Idx).Rights_Mask and Need_Mask) /= Need_Mask then
            Fail_Node (Origin, Err_Type_Conflict, Handle_Name, Success, Diag);
         end if;
      end Require_Process_Right;

      procedure Emit_FASM_Process_Config_Load
        (Handle_Node : Node_Index;
         Need_Mask   : U64;
         Origin      : Node_Index;
         Success     : in out Boolean;
         Diag        : in out Compiler_Diagnostic)
      is
         Handle_Name : constant String := Process_Handle_Name (Handle_Node);
         Idx         : constant Natural := Find_Process_Handle (Handle_Name);
      begin
         if Handle_Name'Length = 0 then
            Fail_Node (Origin, Err_Type_Conflict, "PROCESS_HANDLE", Success, Diag);
            return;
         end if;

         Require_Process_Right (Handle_Name, Need_Mask, Origin, Success, Diag);
         if not Success then
            return;
         end if;

         if Idx = 0 then
            Transpiler_Native_HAL.Emit_Raw ("  lea rcx, [" & Handle_Name & "]", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            Transpiler_Native_HAL.Emit_Raw ("  xor rdx, rdx", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            Transpiler_Native_HAL.Emit_Raw ("  xor r8, r8", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            Transpiler_Native_HAL.Emit_Raw ("  xor r9, r9", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            return;
         end if;

         Transpiler_Native_HAL.Emit_Raw ("  lea rcx, [" & Handle_Name & "]", Success);
         Transpiler_Native_HAL.Emit_Newline (Success);
         Transpiler_Native_HAL.Emit_Raw
           ("  mov rdx, " & Nat_Img (Process_Mode_Code (Process_Handles (Idx).Source_Kind)),
            Success);
         Transpiler_Native_HAL.Emit_Newline (Success);

         if Process_Handles (Idx).Source_Kind = Process_Source_Pid then
            Transpiler_Native_HAL.Emit_Raw
              ("  mov r8, qword [ALB_PROCCFG_" & Handle_Name & "_PID]",
               Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            Transpiler_Native_HAL.Emit_Raw ("  xor r9, r9", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
         else
            Transpiler_Native_HAL.Emit_Raw ("  xor r8, r8", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            Transpiler_Native_HAL.Emit_Raw
              ("  lea r9, [ALB_PROCCFG_" & Handle_Name & "_IMAGE]",
               Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
         end if;
      end Emit_FASM_Process_Config_Load;

      procedure Register_Process_Handle_Decl
        (Node    : in Node_Index;
         Success : in out Boolean;
         Diag    : in out Compiler_Diagnostic)
      is
         Raw_Name    : constant String := Raw_Lexeme (Tree (Tree (Node).Left_Child).Token_Index);
         Name        : constant String := Scoped_Lexeme (Raw_Name);
         Setting     : Node_Index := Tree (Node).Right_Child;
         Source_Kind : Process_Source_Kind := Process_Source_None;
         Pid_Val     : U64 := 0;
         Image_Text  : String (1 .. 260) := (others => ' ');
         Image_Len   : Natural := 0;
         Rights_Mask : U64 := 0;
         Right_Node  : Node_Index := 0;
         Right_Bit   : U64 := 0;
         Idx         : Natural := 0;
         Dummy_Tag   : ALB_Type_Tag := Type_None;
         Dummy_Sym   : Symbol_Record;
      begin
         if Current_Scope /= 0 then
            Fail_Node (Node, Err_Type_Conflict, Name, Success, Diag);
            return;
         end if;

         if Find_Process_Handle (Name) /= 0 then
            Fail_Node (Node, Err_Type_Conflict, Name, Success, Diag);
            return;
         end if;

         while Setting /= 0 loop
            case Tree (Setting).Kind is
               when AST_Process_Pid =>
                  if Source_Kind /= Process_Source_None then
                     Fail_Node (Setting, Err_Type_Conflict, Name, Success, Diag);
                     return;
                  end if;

                  Comptime_Eval_Expr (Tree (Setting).Left_Child, Pid_Val, Success, Diag);
                  if not Success then
                     return;
                  end if;
                  Source_Kind := Process_Source_Pid;

               when AST_Process_Image =>
                  if Source_Kind /= Process_Source_None then
                     Fail_Node (Setting, Err_Type_Conflict, Name, Success, Diag);
                     return;
                  end if;

                  if Tree (Setting).Left_Child = 0
                    or else Tree (Tree (Setting).Left_Child).Kind /= AST_String_Expr
                  then
                     Fail_Node (Setting, Err_Type_Conflict, Name, Success, Diag);
                     return;
                  end if;

                  declare
                     Raw_Image : constant String := Strip_String_Node (Tree (Setting).Left_Child);
                  begin
                     if Raw_Image'Length = 0 or else Raw_Image'Length > Image_Text'Length then
                        Fail_Node (Setting, Err_Mem_Out_Of_Bounds, Name, Success, Diag);
                        return;
                     end if;

                     Image_Len := Raw_Image'Length;
                     Image_Text (1 .. Image_Len) := Raw_Image;
                  end;
                  Source_Kind := Process_Source_Image;

               when AST_Process_Rights =>
                  Right_Node := Tree (Setting).Left_Child;
                  while Right_Node /= 0 loop
                     Right_Bit :=
                       Process_Right_Mask_From_Lexeme
                         (Raw_Lexeme (Tree (Right_Node).Token_Index));
                     if Right_Bit = 0 then
                        Fail_Node (Right_Node, Err_Type_Conflict, Name, Success, Diag);
                        return;
                     end if;
                     Rights_Mask := Rights_Mask or Right_Bit;
                     Right_Node := Tree (Right_Node).Next_Sibling;
                  end loop;

               when others =>
                  null;
            end case;

            Setting := Tree (Setting).Next_Sibling;
         end loop;

         if Source_Kind = Process_Source_None or else Rights_Mask = 0 then
            Fail_Node (Node, Err_Type_Conflict, Name, Success, Diag);
            return;
         end if;

         if Process_Handle_Count >= Max_Process_Handles then
            Fail_Node (Node, Err_Mem_Out_Of_Bounds, Name, Success, Diag);
            return;
         end if;

         Process_Handle_Count := Process_Handle_Count + 1;
         Idx := Process_Handle_Count;
         Process_Handles (Idx).Name_Hash := Hash_String (Name);
         Store_Name (Process_Handles (Idx).Name, Process_Handles (Idx).Name_Len, Name);
         Process_Handles (Idx).Source_Kind := Source_Kind;
         Process_Handles (Idx).Pid := Pid_Val;
         Process_Handles (Idx).Image_Len := Image_Len;
         if Image_Len > 0 then
            Process_Handles (Idx).Image (1 .. Image_Len) := Image_Text (1 .. Image_Len);
         end if;
         Process_Handles (Idx).Rights_Mask := Rights_Mask;
         Process_Handles (Idx).Active := True;

         Dummy_Sym := Resolve_Symbol (Raw_Name, Type_U64, 0, False, Dummy_Tag);
         pragma Unreferenced (Dummy_Sym);

         if Target = Backend_FASM then
            Transpiler_Native_HAL.Emit_Global_Var_Decl (Name, Type_U64, Emit_Success);
            if Source_Kind = Process_Source_Pid then
               Emit_Global_Line
                 ("  ALB_PROCCFG_" & Name & "_PID dq " & U64_Img (Pid_Val));
               Emit_Global_String_Label ("ALB_PROCCFG_" & Name & "_IMAGE", "");
            else
               Emit_Global_Line ("  ALB_PROCCFG_" & Name & "_PID dq 0");
               Emit_Global_String_Label
                 ("ALB_PROCCFG_" & Name & "_IMAGE",
                  Image_Text (1 .. Image_Len));
            end if;
         elsif Target = Backend_C then
            -- Track 7 (C): the handle slot itself is already created by the
            -- standard Resolve_Symbol(Type_U64) call above.  We only need the
            -- per-handle config triplet here.
            if Source_Kind = Process_Source_Pid then
               Emit_Global_Line
                 ("static uint64_t ALB_PROCCFG_" & Name & "_PID = " &
                  U64_Img (Pid_Val) & "ULL;");
               Emit_Global_Line
                 ("static const char ALB_PROCCFG_" & Name & "_IMAGE_C[] = """";");
            else
               Emit_Global_Line
                 ("static uint64_t ALB_PROCCFG_" & Name & "_PID = 0;");
               Emit_Global_Line
                 ("static const char ALB_PROCCFG_" & Name & "_IMAGE_C[] = """ &
                  Image_Text (1 .. Image_Len) & """;");
            end if;
            Emit_Global_Line
              ("static uint64_t ALB_PROCCFG_" & Name & "_Rights = " &
               U64_Img (Rights_Mask) & "ULL;");
         end if;
      end Register_Process_Handle_Decl;

      procedure Register_Firewall_Decl
        (Node    : in Node_Index;
         Success : in out Boolean;
         Diag    : in out Compiler_Diagnostic)
      is
         Raw_Name : constant String := Raw_Lexeme (Tree (Tree (Node).Left_Child).Token_Index);
         Name     : constant String := Scoped_Lexeme (Raw_Name);
         Idx      : Natural := 0;
         Rule     : Node_Index := Tree (Node).Right_Child;
      begin
         if Current_Scope /= 0 then
            Fail_Node (Node, Err_Type_Conflict, Name, Success, Diag);
            return;
         end if;

         if Find_Firewall (Name) /= 0 then
            Fail_Node (Node, Err_Type_Conflict, Name, Success, Diag);
            return;
         end if;

         if Firewall_Count >= Max_Firewalls then
            Fail_Node (Node, Err_Mem_Out_Of_Bounds, Name, Success, Diag);
            return;
         end if;

         Firewall_Count := Firewall_Count + 1;
         Idx := Firewall_Count;
         Firewalls (Idx).Name_Hash := Hash_String (Name);
         Store_Name (Firewalls (Idx).Name, Firewalls (Idx).Name_Len, Name);
         Firewalls (Idx).Rule_First := Firewall_Rule_Count + 1;
         Firewalls (Idx).Rule_Count := 0;
         Firewalls (Idx).Deny_All := False;
         Firewalls (Idx).Active := True;

         while Rule /= 0 loop
            case Tree (Rule).Kind is
               when AST_Firewall_Permit_Read | AST_Firewall_Permit_Write =>
                  declare
                     Target_Name : constant String := Access_Base_Scoped_Name (Tree (Rule).Left_Child);
                  begin
                     if Target_Name'Length = 0 then
                        Fail_Node (Rule, Err_Type_Conflict, "FIREWALL_RULE", Success, Diag);
                        return;
                     end if;

                     if Firewall_Rule_Count >= Max_Firewall_Rules then
                        Fail_Node (Rule, Err_Mem_Out_Of_Bounds, Target_Name, Success, Diag);
                        return;
                     end if;

                     Firewall_Rule_Count := Firewall_Rule_Count + 1;
                     Firewall_Rules (Firewall_Rule_Count).Target_Hash := Hash_String (Target_Name);
                     Store_Name
                       (Firewall_Rules (Firewall_Rule_Count).Target_Name,
                        Firewall_Rules (Firewall_Rule_Count).Target_Len,
                        Target_Name);
                     Firewall_Rules (Firewall_Rule_Count).Allow_Read :=
                       Tree (Rule).Kind = AST_Firewall_Permit_Read;
                     Firewall_Rules (Firewall_Rule_Count).Allow_Write :=
                       Tree (Rule).Kind = AST_Firewall_Permit_Write;
                     Firewall_Rules (Firewall_Rule_Count).Active := True;
                     Firewalls (Idx).Rule_Count := Firewalls (Idx).Rule_Count + 1;
                  end;

               when AST_Firewall_Deny_All =>
                  Firewalls (Idx).Deny_All := True;

               when others =>
                  null;
            end case;

            Rule := Tree (Rule).Next_Sibling;
         end loop;
      end Register_Firewall_Decl;

      function Find_Network_Socket (Name : String) return Natural is
      begin
         for I in 1 .. Network_Socket_Count loop
            if Network_Sockets (I).Active
              and then Network_Sockets (I).Name_Len = Name'Length
              and then Network_Sockets (I).Name (1 .. Name'Length) = Name
            then
               return I;
            end if;
         end loop;

          return 0;
       end Find_Network_Socket;

       function Find_Network_Sniffer (Name : String) return Natural is
       begin
          for I in 1 .. Network_Sniffer_Count loop
             if Network_Sniffers (I).Active
               and then Network_Sniffers (I).Name_Len = Name'Length
               and then Network_Sniffers (I).Name (1 .. Name'Length) = Name
             then
                return I;
             end if;
          end loop;
          return 0;
       end Find_Network_Sniffer;

       function Find_Network_Alias (Name : String) return Natural is
      begin
         for I in 1 .. Network_Alias_Count loop
            if Network_Aliases (I).Active
              and then Network_Aliases (I).Name_Len = Name'Length
              and then Network_Aliases (I).Name (1 .. Name'Length) = Name
            then
               return I;
            end if;
         end loop;

         return 0;
      end Find_Network_Alias;

      function Find_Network_By_Handle_Name (Name : String) return Natural is
         Alias_Idx : constant Natural := Find_Network_Alias (Name);
      begin
         if Alias_Idx > 0 then
            return Network_Aliases (Alias_Idx).Socket_Index;
         else
            return Find_Network_Socket (Name);
         end if;
      end Find_Network_By_Handle_Name;

      procedure Register_Network_Alias
        (Alias_Name    : String;
         Socket_Index  : Natural;
         Origin        : Node_Index;
         Success       : in out Boolean;
         Diag          : in out Compiler_Diagnostic)
      is
         Idx : Natural := Find_Network_Alias (Alias_Name);
      begin
         if Socket_Index = 0 then
            Fail_Node (Origin, Err_Type_Conflict, Alias_Name, Success, Diag);
            return;
         end if;

         if Idx = 0 then
            if Network_Alias_Count >= Max_Network_Aliases then
               Fail_Node (Origin, Err_Mem_Out_Of_Bounds, Alias_Name, Success, Diag);
               return;
            end if;

            Network_Alias_Count := Network_Alias_Count + 1;
            Idx := Network_Alias_Count;
         end if;

         Network_Aliases (Idx).Name_Hash := Hash_String (Alias_Name);
         Store_Name (Network_Aliases (Idx).Name, Network_Aliases (Idx).Name_Len, Alias_Name);
         Network_Aliases (Idx).Socket_Index := Socket_Index;
         Network_Aliases (Idx).Active := True;
      end Register_Network_Alias;

      function Network_Protocol_Code (Proto : Network_Protocol_Kind) return Natural is
      begin
         case Proto is
            when Network_Proto_TCP =>
               return 1;
            when Network_Proto_UDP =>
               return 2;
         end case;
      end Network_Protocol_Code;

      procedure Register_Network_Socket_Decl
        (Node    : in Node_Index;
         Success : in out Boolean;
         Diag    : in out Compiler_Diagnostic)
      is
         Raw_Name    : constant String := Raw_Lexeme (Tree (Tree (Node).Left_Child).Token_Index);
         Name        : constant String := Scoped_Lexeme (Raw_Name);
         Setting     : Node_Index := Tree (Node).Right_Child;
         Protocol    : Network_Protocol_Kind := Network_Proto_TCP;
         Port_Val    : U64 := 0;
         Buffer_Val  : U64 := 0;
         Dummy_Tag   : ALB_Type_Tag := Type_None;
         Dummy_Sym   : Symbol_Record;
      begin
         if Current_Scope /= 0 then
            Fail_Node (Node, Err_Type_Conflict, Name, Success, Diag);
            return;
         end if;

         if Find_Network_Socket (Name) /= 0 then
            Fail_Node (Node, Err_Type_Conflict, Name, Success, Diag);
            return;
         end if;

         while Setting /= 0 loop
            case Tree (Setting).Kind is
               when AST_Network_Protocol =>
                  declare
                     Proto_Lex : constant String := To_Upper (Raw_Lexeme (Tree (Tree (Setting).Left_Child).Token_Index));
                  begin
                     if Proto_Lex = "UDP" then
                        Protocol := Network_Proto_UDP;
                     else
                        Protocol := Network_Proto_TCP;
                     end if;
                  end;

               when AST_Network_Port =>
                  Comptime_Eval_Expr (Tree (Setting).Left_Child, Port_Val, Success, Diag);
                  if not Success then
                     return;
                  end if;

               when AST_Network_Buffer_Size =>
                  Comptime_Eval_Expr (Tree (Setting).Left_Child, Buffer_Val, Success, Diag);
                  if not Success then
                     return;
                  end if;

               when others =>
                  null;
            end case;

            Setting := Tree (Setting).Next_Sibling;
         end loop;

         if Port_Val = 0 or else Port_Val > U64 (65535) or else Buffer_Val = 0 then
            Fail_Node (Node, Err_Type_Conflict, Name, Success, Diag);
            return;
         end if;

         if Network_Socket_Count >= Max_Network_Sockets then
            Fail_Node (Node, Err_Mem_Out_Of_Bounds, Name, Success, Diag);
            return;
         end if;

         Network_Socket_Count := Network_Socket_Count + 1;
         Network_Sockets (Network_Socket_Count).Name_Hash := Hash_String (Name);
         Store_Name (Network_Sockets (Network_Socket_Count).Name, Network_Sockets (Network_Socket_Count).Name_Len, Name);
         Network_Sockets (Network_Socket_Count).Protocol := Protocol;
         Network_Sockets (Network_Socket_Count).Port := Natural (Port_Val);
         Network_Sockets (Network_Socket_Count).Buffer_Size := Natural (Buffer_Val);
         Network_Sockets (Network_Socket_Count).Active := True;
         Network_Runtime_Used := True;

         Dummy_Sym := Resolve_Symbol (Raw_Name, Type_U64, 0, False, Dummy_Tag);
         pragma Unreferenced (Dummy_Sym);
         if Target = Backend_C then
            Emit_Global_Line
              ("static uint64_t ALB_NETCFG_" &
               Name &
               "_Protocol = " &
               Nat_Img (Network_Protocol_Code (Protocol)) &
               ";");
            Emit_Global_Line
              ("static uint64_t ALB_NETCFG_" &
               Name &
               "_Port = " &
               U64_Img (Port_Val) &
               ";");
            Emit_Global_Line
              ("static uint64_t ALB_NETCFG_" &
               Name &
               "_Buffer_Size = " &
               U64_Img (Buffer_Val) &
               ";");
            Emit_Global_Line
              ("static uint8_t ALB_NETCFG_" &
               Name &
               "_Scratch[" &
               Nat_Img (Natural (Buffer_Val)) &
               "] = {0};");
            Emit_Global_Line
              ("static struct sockaddr_in ALB_NETCFG_" &
               Name &
               "_Peer;");
            Emit_Global_Line
              ("static int ALB_NETCFG_" &
               Name &
               "_Peer_Len = sizeof(struct sockaddr_in);");
         else
            Emit_Global_Line ("  ALB_NETCFG_" & Name & "_Protocol dq " & Nat_Img (Network_Protocol_Code (Protocol)));
            Emit_Global_Line ("  ALB_NETCFG_" & Name & "_Port dq " & U64_Img (Port_Val));
            Emit_Global_Line ("  ALB_NETCFG_" & Name & "_Buffer_Size dq " & U64_Img (Buffer_Val));
            Emit_Global_Line ("  ALB_NETCFG_" & Name & "_Peer_Len dq 16");
            Emit_Global_Line ("  ALB_NETCFG_" & Name & "_Peer rb 16");
         end if;
       end Register_Network_Socket_Decl;

       procedure Register_Network_Sniffer_Decl
         (Node    : in Node_Index;
          Success : in out Boolean;
          Diag    : in out Compiler_Diagnostic)
       is
          Raw_Name       : constant String := Raw_Lexeme (Tree (Tree (Node).Left_Child).Token_Index);
          Name           : constant String := Scoped_Lexeme (Raw_Name);
          Setting        : Node_Index := Tree (Node).Right_Child;
          Interface_Name : String (1 .. 128) := (others => ' ');
          Interface_Len  : Natural := 0;
          Protocol       : Network_Protocol_Kind := Network_Proto_TCP;
          Port_Val       : U64 := 0;
          Buffer_Val     : U64 := 0;
          Dummy_Tag      : ALB_Type_Tag := Type_None;
          Dummy_Sym      : Symbol_Record;
       begin
          if Current_Scope /= 0 then
             Fail_Node (Node, Err_Type_Conflict, Name, Success, Diag);
             return;
          end if;

          if Find_Network_Sniffer (Name) /= 0 then
             Fail_Node (Node, Err_Type_Conflict, Name, Success, Diag);
             return;
          end if;

          while Setting /= 0 loop
             case Tree (Setting).Kind is
                when AST_Sniffer_Interface =>
                   declare
                      Iface_Lex  : constant String :=
                        Raw_Lexeme (Tree (Tree (Setting).Left_Child).Token_Index);
                   begin
                      Store_Name (Interface_Name, Interface_Len, Iface_Lex);
                   end;

                when AST_Sniffer_Protocol =>
                   declare
                      Proto_Lex : constant String :=
                        To_Upper (Raw_Lexeme (Tree (Tree (Setting).Left_Child).Token_Index));
                   begin
                      if Proto_Lex = "UDP" then
                         Protocol := Network_Proto_UDP;
                      elsif Proto_Lex = "ALL" then
                         Protocol := Network_Proto_TCP;
                      else
                         Protocol := Network_Proto_TCP;
                      end if;
                   end;

                when AST_Sniffer_Port =>
                   Comptime_Eval_Expr (Tree (Setting).Left_Child, Port_Val, Success, Diag);
                   if not Success then
                      return;
                   end if;

                when AST_Sniffer_Buffer_Size =>
                   Comptime_Eval_Expr (Tree (Setting).Left_Child, Buffer_Val, Success, Diag);
                   if not Success then
                      return;
                   end if;

                when others =>
                   null;
             end case;

             Setting := Tree (Setting).Next_Sibling;
          end loop;

          if Buffer_Val = 0 then
             Fail_Node (Node, Err_Type_Conflict, Name, Success, Diag);
             return;
          end if;

          if Network_Sniffer_Count >= Max_Network_Sniffers then
             Fail_Node (Node, Err_Mem_Out_Of_Bounds, Name, Success, Diag);
             return;
          end if;

          Network_Sniffer_Count := Network_Sniffer_Count + 1;
          Network_Sniffers (Network_Sniffer_Count).Name_Hash := Hash_String (Name);
          Store_Name (Network_Sniffers (Network_Sniffer_Count).Name,
                      Network_Sniffers (Network_Sniffer_Count).Name_Len, Name);
          Network_Sniffers (Network_Sniffer_Count).Interface_Name := Interface_Name;
          Network_Sniffers (Network_Sniffer_Count).Interface_Len := Interface_Len;
          Network_Sniffers (Network_Sniffer_Count).Protocol := Protocol;
          Network_Sniffers (Network_Sniffer_Count).Port := Natural (Port_Val);
          Network_Sniffers (Network_Sniffer_Count).Buffer_Size := Natural (Buffer_Val);
          Network_Sniffers (Network_Sniffer_Count).Active := True;
          Sniffer_Runtime_Used := True;
          Network_Runtime_Used := True;

         Dummy_Sym := Resolve_Symbol (Raw_Name, Type_U64, 0, False, Dummy_Tag);
         Dummy_Sym := Resolve_Symbol (Raw_Name & "_ERROR", Type_U64, 0, False, Dummy_Tag);

         if Target = Backend_C then
             Emit_Global_Line
               ("static uint64_t ALB_SNIFFCFG_" &
                Name &
                "_Protocol = " &
                Nat_Img (Network_Protocol_Code (Protocol)) &
                ";");
             Emit_Global_Line
               ("static uint64_t ALB_SNIFFCFG_" &
                Name &
                "_Port = " &
                U64_Img (Port_Val) &
                ";");
             Emit_Global_Line
               ("static uint64_t ALB_SNIFFCFG_" &
                Name &
                "_Buffer_Size = " &
                U64_Img (Buffer_Val) &
                ";");
             Emit_Global_Line
               ("static uint8_t ALB_SNIFFCFG_" &
                Name &
                "_Scratch[" &
               Nat_Img (Natural (Buffer_Val)) &
                "] = {0};");
             -- Track 5 (C): emit an in-source C string for the
             -- interface name so the sniffer runtime can dispatch on it.
             declare
                Raw_Iface : constant String :=
                  (if Interface_Len > 0
                   then Interface_Name (1 .. Interface_Len)
                   else "any");
                Iface_Lo  : Natural := Raw_Iface'First;
                Iface_Hi  : Natural := Raw_Iface'Last;
             begin
                if Iface_Hi >= Iface_Lo
                  and then Raw_Iface (Iface_Lo) = '"'
                then
                   Iface_Lo := Iface_Lo + 1;
                end if;
                if Iface_Hi >= Iface_Lo
                  and then Raw_Iface (Iface_Hi) = '"'
                then
                   Iface_Hi := Iface_Hi - 1;
                end if;
                Emit_Global_Line
                  ("static const char ALB_SNIFFCFG_" &
                   Name &
                   "_Interface_C[] = """ &
                   Raw_Iface (Iface_Lo .. Iface_Hi) &
                   """;");
             end;
          else
             Emit_Global_String_Label
               ("ALB_SNIFFCFG_" & Name & "_Interface",
                (if Interface_Len > 0
                 then Interface_Name (1 .. Interface_Len)
                 else "any"));
             Emit_Global_Line ("  ALB_SNIFFCFG_" & Name & "_Protocol dq " & Nat_Img (Network_Protocol_Code (Protocol)));
             Emit_Global_Line ("  ALB_SNIFFCFG_" & Name & "_Port dq " & U64_Img (Port_Val));
             Emit_Global_Line ("  ALB_SNIFFCFG_" & Name & "_Buffer_Size dq " & U64_Img (Buffer_Val));
          end if;
       end Register_Network_Sniffer_Decl;

       procedure Parse_Scaled_Decimal
        (Lexeme  : in String;
         Scale   : in Natural;
         Value   : out Integer;
         Success : out Boolean)
      is
         Whole       : Integer := 0;
         Fraction    : Integer := 0;
         Fraction_M  : Integer := Integer (Scale / 10);
         Negative    : Boolean := False;
         Seen_Digit  : Boolean := False;
         In_Fraction : Boolean := False;
      begin
         Success := True;
         Value := 0;

         for I in Lexeme'Range loop
            if Lexeme (I) = ' ' or else Lexeme (I) = ASCII.LF then
               null;
            elsif Lexeme (I) = '-' and then not Seen_Digit and then Whole = 0 and then not In_Fraction then
               Negative := True;
            elsif Lexeme (I) = '.' and then not In_Fraction then
               In_Fraction := True;
            elsif Lexeme (I) in '0' .. '9' then
               Seen_Digit := True;
               if not In_Fraction then
                  Whole := Whole * 10 + (Character'Pos (Lexeme (I)) - Character'Pos ('0'));
               elsif Fraction_M > 0 then
                  Fraction := Fraction +
                    (Character'Pos (Lexeme (I)) - Character'Pos ('0')) * Fraction_M;
                  Fraction_M := Fraction_M / 10;
               end if;
            else
               Success := False;
               return;
            end if;
         end loop;

         if not Seen_Digit then
            Success := False;
            return;
         end if;

         Value := Whole * Integer (Scale) + Fraction;
         if Negative then
            Value := -Value;
         end if;
      end Parse_Scaled_Decimal;

      procedure Eval_Markov_Weight
        (Expr_Node : in Node_Index;
         Value     : out Integer;
         Success   : in out Boolean;
         Diag      : in out Compiler_Diagnostic)
      is
         Raw_Val : U64 := 0;
         Local_OK : Boolean := False;
      begin
         Value := 0;

         if Expr_Node = 0 then
            Fail_Node (Expr_Node, Err_Compiler_AST_Mismatch, "MARKOV_WEIGHT", Success, Diag);
            return;
         end if;

         if Tree (Expr_Node).Kind = AST_Number_Expr then
            Parse_Scaled_Decimal (Raw_Lexeme (Tree (Expr_Node).Token_Index), 1000, Value, Local_OK);
            if Local_OK then
               return;
            end if;
         end if;

         Comptime_Eval_Expr (Expr_Node, Raw_Val, Success, Diag);
         if not Success then
            return;
         end if;

         if Raw_Val > U64 (Integer'Last / 1000) then
            Fail_Node (Expr_Node, Err_Mem_Out_Of_Bounds, "MARKOV_WEIGHT", Success, Diag);
            return;
         end if;

         Value := Integer (Raw_Val) * 1000;
      end Eval_Markov_Weight;

      function Find_Markov_Model (Name : String) return Natural is
      begin
         for I in 1 .. Markov_Model_Count loop
            if Markov_Models (I).Active
              and then Markov_Models (I).Name_Len = Name'Length
              and then Markov_Models (I).Name (1 .. Name'Length) = Name
            then
               return I;
            end if;
         end loop;

         return 0;
      end Find_Markov_Model;

      procedure Register_Markov_Model_Decl
        (Node    : in Node_Index;
         Success : in out Boolean;
         Diag    : in out Compiler_Diagnostic)
      is
         Raw_Name    : constant String := Raw_Lexeme (Tree (Tree (Node).Left_Child).Token_Index);
         Name        : constant String := Scoped_Lexeme (Raw_Name);
         Setting     : Node_Index := Tree (Node).Right_Child;
         States_Val  : U64 := 0;
         Matrix_Node : Node_Index := 0;
         Row_Node    : Node_Index := 0;
         Elem_Node   : Node_Index := 0;
         First_Value : Natural := Markov_Value_Count + 1;
         Row_Count   : Natural := 0;
         Col_Count   : Natural := 0;
         Weight      : Integer := 0;
      begin
         if Current_Scope /= 0 then
            Fail_Node (Node, Err_Type_Conflict, Name, Success, Diag);
            return;
         end if;

         if Find_Markov_Model (Name) /= 0 then
            Fail_Node (Node, Err_Type_Conflict, Name, Success, Diag);
            return;
         end if;

         while Setting /= 0 loop
            case Tree (Setting).Kind is
               when AST_Markov_States =>
                  Comptime_Eval_Expr (Tree (Setting).Left_Child, States_Val, Success, Diag);
                  if not Success then
                     return;
                  end if;

               when AST_Markov_Transition_Matrix =>
                  Matrix_Node := Setting;

               when others =>
                  null;
            end case;

            Setting := Tree (Setting).Next_Sibling;
         end loop;

         if States_Val = 0 or else Matrix_Node = 0 then
            Fail_Node (Node, Err_Type_Conflict, Name, Success, Diag);
            return;
         end if;

         Row_Node := Tree (Matrix_Node).Left_Child;
         while Row_Node /= 0 loop
            Row_Count := Row_Count + 1;
            Col_Count := 0;
            Elem_Node := Tree (Row_Node).Left_Child;

            while Elem_Node /= 0 loop
               Col_Count := Col_Count + 1;
               if Markov_Value_Count >= Max_Markov_Values then
                  Fail_Node (Elem_Node, Err_Mem_Out_Of_Bounds, Name, Success, Diag);
                  return;
               end if;

               Eval_Markov_Weight (Elem_Node, Weight, Success, Diag);
               if not Success then
                  return;
               end if;

               Markov_Value_Count := Markov_Value_Count + 1;
               Markov_Values (Markov_Value_Count) := Weight;
               Elem_Node := Tree (Elem_Node).Next_Sibling;
            end loop;

            if Col_Count /= Natural (States_Val) then
               Fail_Node (Row_Node, Err_Type_Conflict, Name, Success, Diag);
               return;
            end if;

            Row_Node := Tree (Row_Node).Next_Sibling;
         end loop;

         if Row_Count /= Natural (States_Val) then
            Fail_Node (Node, Err_Type_Conflict, Name, Success, Diag);
            return;
         end if;

         if Markov_Model_Count >= Max_Markov_Models then
            Fail_Node (Node, Err_Mem_Out_Of_Bounds, Name, Success, Diag);
            return;
         end if;

         Markov_Model_Count := Markov_Model_Count + 1;
         Markov_Models (Markov_Model_Count).Name_Hash := Hash_String (Name);
         Store_Name (Markov_Models (Markov_Model_Count).Name, Markov_Models (Markov_Model_Count).Name_Len, Name);
         Markov_Models (Markov_Model_Count).States := Natural (States_Val);
         Markov_Models (Markov_Model_Count).Matrix_First := First_Value;
         Markov_Models (Markov_Model_Count).Matrix_Count := Row_Count * Col_Count;
         Markov_Models (Markov_Model_Count).Active := True;
         Markov_Runtime_Used := True;

         if Target = Backend_C then
            Emit_Global_Line
              ("static uint64_t ALB_MARKOV_STATES_" &
               Name &
               " = " &
               U64_Img (States_Val) &
               ";");

            Transpiler_Native_HAL.Set_Global_Buffer_Mode (True);
            Transpiler_Native_HAL.Emit_Raw
              ("static int64_t ALB_MARKOV_MATRIX_" & Name & "[] = {",
               Emit_Success);
            for I in First_Value .. Markov_Value_Count loop
               Transpiler_Native_HAL.Emit_Raw (Int_Img (Markov_Values (I)), Emit_Success);
               if I < Markov_Value_Count then
                  Transpiler_Native_HAL.Emit_Raw (", ", Emit_Success);
               end if;
            end loop;
            Transpiler_Native_HAL.Emit_Raw ("};", Emit_Success);
            Transpiler_Native_HAL.Emit_Newline (Emit_Success);
            Transpiler_Native_HAL.Set_Global_Buffer_Mode (False);
         else
            Emit_Global_Line ("  ALB_MARKOV_STATES_" & Name & " dq " & U64_Img (States_Val));

            Transpiler_Native_HAL.Set_Global_Buffer_Mode (True);
            Transpiler_Native_HAL.Emit_Raw ("  ALB_MARKOV_MATRIX_" & Name & " dq ", Emit_Success);
            for I in First_Value .. Markov_Value_Count loop
               Transpiler_Native_HAL.Emit_Raw (Int_Img (Markov_Values (I)), Emit_Success);
               if I < Markov_Value_Count then
                  Transpiler_Native_HAL.Emit_Raw (", ", Emit_Success);
               end if;
            end loop;
            Transpiler_Native_HAL.Emit_Newline (Emit_Success);
            Transpiler_Native_HAL.Set_Global_Buffer_Mode (False);
         end if;
      end Register_Markov_Model_Decl;

      function Find_Emotion (Name : String) return Natural is
      begin
         for I in 1 .. Emotion_Count loop
            if Emotions (I).Active
              and then Emotions (I).Name_Len = Name'Length
              and then Emotions (I).Name (1 .. Name'Length) = Name
            then
               return I;
            end if;
         end loop;
         return 0;
      end Find_Emotion;

      function Find_Emotion_Axis
        (E_Idx : Natural; Axis_Name : String) return Natural
      is
         Upper : constant String := To_Upper (Axis_Name);
      begin
         if E_Idx = 0 then
            return 0;
         end if;
         for I in 1 .. Emotions (E_Idx).Axis_Count loop
            if Emotions (E_Idx).Axes (I).Len = Upper'Length
              and then To_Upper
                (Emotions (E_Idx).Axes (I).Text
                   (1 .. Emotions (E_Idx).Axes (I).Len)) = Upper
            then
               return I;
            end if;
         end loop;
         return 0;
      end Find_Emotion_Axis;

      procedure Register_Emotion_Decl
        (Node    : in Node_Index;
         Success : in out Boolean;
         Diag    : in out Compiler_Diagnostic)
      is
         Raw_Name  : constant String :=
           Raw_Lexeme (Tree (Tree (Node).Left_Child).Token_Index);
         Name      : constant String := Scoped_Lexeme (Raw_Name);
         Axes_Node : constant Node_Index := Tree (Node).Right_Child;
         Axis_Node : Node_Index := 0;
         Count     : Natural := 0;
      begin
         if Target /= Backend_FASM then
            Fail_Node
              (Node,
               Err_Type_Conflict,
               "EMOTION requires -t fasm (not available on FASM16/other backends)",
               Success,
               Diag);
            return;
         end if;

         if Current_Scope /= 0 then
            Fail_Node (Node, Err_Type_Conflict, Name, Success, Diag);
            return;
         end if;

         if Find_Emotion (Name) /= 0 then
            Fail_Node (Node, Err_Type_Conflict, Name, Success, Diag);
            return;
         end if;

         if Axes_Node = 0 or else Tree (Axes_Node).Kind /= AST_Emotion_Axes then
            Fail_Node (Node, Err_Type_Conflict, Name, Success, Diag);
            return;
         end if;

         if Emotion_Count >= Max_Emotions then
            Fail_Node (Node, Err_Mem_Out_Of_Bounds, Name, Success, Diag);
            return;
         end if;

         Emotion_Count := Emotion_Count + 1;
         Emotions (Emotion_Count).Name_Hash := Hash_String (Name);
         Store_Name
           (Emotions (Emotion_Count).Name,
            Emotions (Emotion_Count).Name_Len,
            Name);

         Axis_Node := Tree (Axes_Node).Left_Child;
         while Axis_Node /= 0 loop
            declare
               Axis_Raw : constant String :=
                 Raw_Lexeme (Tree (Axis_Node).Token_Index);
               Axis_Up  : constant String := To_Upper (Axis_Raw);
            begin
               Count := Count + 1;
               if Count > Max_Emotion_Axes then
                  Fail_Node
                    (Axis_Node,
                     Err_Type_Conflict,
                     "EMOTION max 8 axes",
                     Success,
                     Diag);
                  return;
               end if;
               if Axis_Up'Length = 0 or else Axis_Up'Length > 64 then
                  Fail_Node (Axis_Node, Err_Type_Conflict, Axis_Raw, Success, Diag);
                  return;
               end if;
               for J in 1 .. Count - 1 loop
                  if Emotions (Emotion_Count).Axes (J).Len = Axis_Up'Length
                    and then Emotions (Emotion_Count).Axes (J).Text
                      (1 .. Axis_Up'Length) = Axis_Up
                  then
                     Fail_Node
                       (Axis_Node, Err_Type_Conflict, Axis_Raw, Success, Diag);
                     return;
                  end if;
               end loop;
               Emotions (Emotion_Count).Axes (Count).Text (1 .. Axis_Up'Length) :=
                 Axis_Up;
               Emotions (Emotion_Count).Axes (Count).Len := Axis_Up'Length;
            end;
            Axis_Node := Tree (Axis_Node).Next_Sibling;
         end loop;

         if Count = 0 then
            Fail_Node (Node, Err_Type_Conflict, Name, Success, Diag);
            return;
         end if;

         Emotions (Emotion_Count).Axis_Count := Count;
         Emotions (Emotion_Count).Active := True;
         Emotion_Runtime_Used := True;

         -- U8 vector: pad to 8 bytes for aligned loads.
         Emit_Global_Line
           ("  ALB_EMOTION_" & Name & " db 0,0,0,0,0,0,0,0");
         declare
            Img : constant String := Natural'Image (Count);
            Dig : constant String := Img (Img'First + 1 .. Img'Last);
         begin
            Emit_Global_Line
              ("  ALB_EMOTION_" & Name & "_COUNT dq " & Dig);
         end;
      end Register_Emotion_Decl;

      function Activation_From_Lexeme
        (Lexeme : String) return Neural_Activation_Kind
      is
         Upper : constant String := To_Upper (Lexeme);
      begin
         if Upper = "INPUT" then
            return Neural_Act_Input;
         elsif Upper = "RELU" then
            return Neural_Act_ReLU;
         elsif Upper = "SIGMOID" then
            return Neural_Act_Sigmoid;
         elsif Upper = "TANH" then
            return Neural_Act_Tanh;
         else
            return Neural_Act_Linear;
         end if;
      end Activation_From_Lexeme;

      function Activation_Code
        (Act : Neural_Activation_Kind) return Natural is
      begin
         case Act is
            when Neural_Act_Input | Neural_Act_Linear =>
               return 0;
            when Neural_Act_ReLU =>
               return 1;
            when Neural_Act_Sigmoid =>
               return 2;
            when Neural_Act_Tanh =>
               return 3;
         end case;
      end Activation_Code;

      function Find_Neural_Topology (Name : String) return Natural is
      begin
         for I in 1 .. Neural_Topology_Count loop
            if Neural_Topologies (I).Active
              and then Neural_Topologies (I).Name_Len = Name'Length
              and then Neural_Topologies (I).Name (1 .. Name'Length) = Name
            then
               return I;
            end if;
         end loop;

         return 0;
      end Find_Neural_Topology;

      procedure Register_Neural_Topology_Decl
        (Node    : in Node_Index;
         Success : in out Boolean;
         Diag    : in out Compiler_Diagnostic)
      is
         Raw_Name      : constant String := Raw_Lexeme (Tree (Tree (Node).Left_Child).Token_Index);
         Name          : constant String := Scoped_Lexeme (Raw_Name);
         Layer_Node    : Node_Index := Tree (Node).Right_Child;
         First_Layer   : Natural := Neural_Layer_Count + 1;
         Layer_Count   : Natural := 0;
         Total_Neurons : Natural := 0;
         Total_Weights : Natural := 0;
         Total_Biases  : Natural := 0;
         Prev_Size     : Natural := 0;
      begin
         if Current_Scope /= 0 then
            Fail_Node (Node, Err_Type_Conflict, Name, Success, Diag);
            return;
         end if;

         if Find_Neural_Topology (Name) /= 0 then
            Fail_Node (Node, Err_Type_Conflict, Name, Success, Diag);
            return;
         end if;

         while Layer_Node /= 0 loop
            declare
               Size_Val : U64 := 0;
               Act      : Neural_Activation_Kind := Neural_Act_Linear;
            begin
               Comptime_Eval_Expr (Tree (Layer_Node).Left_Child, Size_Val, Success, Diag);
               if not Success or else Size_Val = 0 then
                  Fail_Node (Layer_Node, Err_Type_Conflict, Name, Success, Diag);
                  return;
               end if;

               if Tree (Layer_Node).Right_Child > 0 then
                  Act := Activation_From_Lexeme (Raw_Lexeme (Tree (Tree (Layer_Node).Right_Child).Token_Index));
               elsif Layer_Count = 0 then
                  Act := Neural_Act_Input;
               end if;

               if Neural_Layer_Count >= Max_Neural_Layers then
                  Fail_Node (Layer_Node, Err_Mem_Out_Of_Bounds, Name, Success, Diag);
                  return;
               end if;

               Neural_Layer_Count := Neural_Layer_Count + 1;
               Neural_Layers (Neural_Layer_Count).Size := Natural (Size_Val);
               Neural_Layers (Neural_Layer_Count).Activation :=
                 (if Layer_Count = 0 then Neural_Act_Input else Act);
               Neural_Layers (Neural_Layer_Count).Active := True;

               Layer_Count := Layer_Count + 1;
               Total_Neurons := Total_Neurons + Natural (Size_Val);
               if Prev_Size > 0 then
                  Total_Weights := Total_Weights + Prev_Size * Natural (Size_Val);
                  Total_Biases := Total_Biases + Natural (Size_Val);
               end if;
               Prev_Size := Natural (Size_Val);
            end;

            Layer_Node := Tree (Layer_Node).Next_Sibling;
         end loop;

         if Layer_Count < 2 then
            Fail_Node (Node, Err_Type_Conflict, Name, Success, Diag);
            return;
         end if;

         if Neural_Topology_Count >= Max_Neural_Topologies then
            Fail_Node (Node, Err_Mem_Out_Of_Bounds, Name, Success, Diag);
            return;
         end if;

         Neural_Topology_Count := Neural_Topology_Count + 1;
         Neural_Topologies (Neural_Topology_Count).Name_Hash := Hash_String (Name);
         Store_Name (Neural_Topologies (Neural_Topology_Count).Name, Neural_Topologies (Neural_Topology_Count).Name_Len, Name);
         Neural_Topologies (Neural_Topology_Count).Layer_First := First_Layer;
         Neural_Topologies (Neural_Topology_Count).Layer_Count := Layer_Count;
         Neural_Topologies (Neural_Topology_Count).Total_Neurons := Total_Neurons;
         Neural_Topologies (Neural_Topology_Count).Total_Weights := Total_Weights;
         Neural_Topologies (Neural_Topology_Count).Total_Biases := Total_Biases;
         Neural_Topologies (Neural_Topology_Count).Active := True;
         Neural_Runtime_Used := True;

         if Target = Backend_C then
            Emit_Global_Line ("static uint64_t ALB_NN_LAYER_COUNT_" & Name & " = " & Nat_Img (Layer_Count) & ";");
            Emit_Global_Line ("static uint64_t ALB_NN_TOTAL_NEURONS_" & Name & " = " & Nat_Img (Total_Neurons) & ";");
            Emit_Global_Line ("static uint64_t ALB_NN_TOTAL_WEIGHTS_" & Name & " = " & Nat_Img (Total_Weights) & ";");
            Emit_Global_Line ("static uint64_t ALB_NN_TOTAL_BIASES_" & Name & " = " & Nat_Img (Total_Biases) & ";");
         else
            Emit_Global_Line ("  ALB_NN_LAYER_COUNT_" & Name & " dq " & Nat_Img (Layer_Count));
            Emit_Global_Line ("  ALB_NN_TOTAL_NEURONS_" & Name & " dq " & Nat_Img (Total_Neurons));
            Emit_Global_Line ("  ALB_NN_TOTAL_WEIGHTS_" & Name & " dq " & Nat_Img (Total_Weights));
            Emit_Global_Line ("  ALB_NN_TOTAL_BIASES_" & Name & " dq " & Nat_Img (Total_Biases));
         end if;

         Transpiler_Native_HAL.Set_Global_Buffer_Mode (True);

         if Target = Backend_C then
            Transpiler_Native_HAL.Emit_Raw ("static uint64_t ALB_NN_SIZES_" & Name & "[] = {", Emit_Success);
         else
            Transpiler_Native_HAL.Emit_Raw ("  ALB_NN_SIZES_" & Name & " dq ", Emit_Success);
         end if;
         for I in First_Layer .. First_Layer + Layer_Count - 1 loop
            Transpiler_Native_HAL.Emit_Raw (Nat_Img (Neural_Layers (I).Size), Emit_Success);
            if I < First_Layer + Layer_Count - 1 then
               Transpiler_Native_HAL.Emit_Raw (", ", Emit_Success);
            end if;
         end loop;
         if Target = Backend_C then
            Transpiler_Native_HAL.Emit_Raw ("};", Emit_Success);
         end if;
         Transpiler_Native_HAL.Emit_Newline (Emit_Success);

         if Target = Backend_C then
            Transpiler_Native_HAL.Emit_Raw ("static uint64_t ALB_NN_ACT_CODES_" & Name & "[] = {", Emit_Success);
         else
            Transpiler_Native_HAL.Emit_Raw ("  ALB_NN_ACT_CODES_" & Name & " dq ", Emit_Success);
         end if;
         for I in First_Layer .. First_Layer + Layer_Count - 1 loop
            Transpiler_Native_HAL.Emit_Raw
              (Nat_Img (Activation_Code (Neural_Layers (I).Activation)),
               Emit_Success);
            if I < First_Layer + Layer_Count - 1 then
               Transpiler_Native_HAL.Emit_Raw (", ", Emit_Success);
            end if;
         end loop;
         if Target = Backend_C then
            Transpiler_Native_HAL.Emit_Raw ("};", Emit_Success);
         end if;
         Transpiler_Native_HAL.Emit_Newline (Emit_Success);

         declare
            Neuron_Offset : Natural := 0;
            Weight_Offset : Natural := 0;
            Bias_Offset   : Natural := 0;
         begin
            if Target = Backend_C then
               Transpiler_Native_HAL.Emit_Raw ("static uint64_t ALB_NN_NEURON_OFFS_" & Name & "[] = {", Emit_Success);
            else
               Transpiler_Native_HAL.Emit_Raw ("  ALB_NN_NEURON_OFFS_" & Name & " dq ", Emit_Success);
            end if;
            for I in First_Layer .. First_Layer + Layer_Count - 1 loop
               Transpiler_Native_HAL.Emit_Raw (Nat_Img (Neuron_Offset), Emit_Success);
               if I < First_Layer + Layer_Count - 1 then
                  Transpiler_Native_HAL.Emit_Raw (", ", Emit_Success);
               end if;
               Neuron_Offset := Neuron_Offset + Neural_Layers (I).Size;
            end loop;
            if Target = Backend_C then
               Transpiler_Native_HAL.Emit_Raw ("};", Emit_Success);
            end if;
            Transpiler_Native_HAL.Emit_Newline (Emit_Success);

            if Target = Backend_C then
               Transpiler_Native_HAL.Emit_Raw ("static uint64_t ALB_NN_WEIGHT_OFFS_" & Name & "[] = {", Emit_Success);
            else
               Transpiler_Native_HAL.Emit_Raw ("  ALB_NN_WEIGHT_OFFS_" & Name & " dq ", Emit_Success);
            end if;
            for I in First_Layer .. First_Layer + Layer_Count - 1 loop
               Transpiler_Native_HAL.Emit_Raw (Nat_Img (Weight_Offset), Emit_Success);
               if I < First_Layer + Layer_Count - 1 then
                  Transpiler_Native_HAL.Emit_Raw (", ", Emit_Success);
               end if;
               if I > First_Layer then
                  Weight_Offset :=
                    Weight_Offset + Neural_Layers (I - 1).Size * Neural_Layers (I).Size;
               end if;
            end loop;
            if Target = Backend_C then
               Transpiler_Native_HAL.Emit_Raw ("};", Emit_Success);
            end if;
            Transpiler_Native_HAL.Emit_Newline (Emit_Success);

            if Target = Backend_C then
               Transpiler_Native_HAL.Emit_Raw ("static uint64_t ALB_NN_BIAS_OFFS_" & Name & "[] = {", Emit_Success);
            else
               Transpiler_Native_HAL.Emit_Raw ("  ALB_NN_BIAS_OFFS_" & Name & " dq ", Emit_Success);
            end if;
            for I in First_Layer .. First_Layer + Layer_Count - 1 loop
               Transpiler_Native_HAL.Emit_Raw (Nat_Img (Bias_Offset), Emit_Success);
               if I < First_Layer + Layer_Count - 1 then
                  Transpiler_Native_HAL.Emit_Raw (", ", Emit_Success);
               end if;
               if I > First_Layer then
                  Bias_Offset := Bias_Offset + Neural_Layers (I).Size;
               end if;
            end loop;
            if Target = Backend_C then
               Transpiler_Native_HAL.Emit_Raw ("};", Emit_Success);
            end if;
            Transpiler_Native_HAL.Emit_Newline (Emit_Success);
         end;

         if Total_Weights > 0 then
            declare
               function Seed_Neural_Weight
                 (Prev_Size    : Natural;
                  Curr_Size    : Natural;
                  Neuron_Index : Natural;
                  Input_Index  : Natural) return Integer
               is
                  Input_Span  : constant Natural :=
                    (if Curr_Size = 0 then 1 else Natural'Max (1, Prev_Size / Curr_Size));
                  Base_Input  : constant Natural := Neuron_Index * Input_Span;
                  Positive_In : constant Natural :=
                    (if Prev_Size = 0 then 0 else Natural'Min (Prev_Size - 1, Base_Input));
                  Negative_In : constant Natural :=
                    (if Prev_Size = 0 then 0 else Natural'Min (Prev_Size - 1, Base_Input + 1));
               begin
                  if Prev_Size = 0 or else Curr_Size = 0 then
                     return 0;
                  end if;

                  if Curr_Size = Prev_Size then
                     return (if Input_Index = Neuron_Index then 256 else 0);
                  end if;

                  if Prev_Size = Curr_Size * 2 then
                     if Input_Index = Neuron_Index * 2 then
                        return 256;
                     elsif Input_Index = (Neuron_Index * 2) + 1 then
                        return -256;
                     else
                        return 0;
                     end if;
                  end if;

                  if Curr_Size > Prev_Size then
                     return (if Input_Index = (Neuron_Index mod Prev_Size) then 256 else 0);
                  end if;

                  if Input_Span >= 2 then
                     if Input_Index = Positive_In then
                        return 256;
                     elsif Input_Index = Negative_In then
                        return -128;
                     else
                        return 0;
                     end if;
                  end if;

                  return (if Input_Index = Positive_In then 256 else 0);
               end Seed_Neural_Weight;

               Weight_Index : Natural := 0;
            begin
               if Target = Backend_C then
                  Transpiler_Native_HAL.Emit_Raw ("static int64_t ALB_NN_WEIGHTS_" & Name & "[] = {", Emit_Success);
               else
                  Transpiler_Native_HAL.Emit_Raw ("  ALB_NN_WEIGHTS_" & Name & " dq ", Emit_Success);
               end if;

               for Layer_I in First_Layer + 1 .. First_Layer + Layer_Count - 1 loop
                  declare
                     Prev_Size : constant Natural := Neural_Layers (Layer_I - 1).Size;
                     Curr_Size : constant Natural := Neural_Layers (Layer_I).Size;
                  begin
                     for Neuron_I in 0 .. Curr_Size - 1 loop
                        for Input_I in 0 .. Prev_Size - 1 loop
                           declare
                              Seed : constant Integer :=
                                Seed_Neural_Weight (Prev_Size, Curr_Size, Neuron_I, Input_I);
                           begin
                              Transpiler_Native_HAL.Emit_Raw (Int_Img (Seed), Emit_Success);
                           end;

                           if Weight_Index < Total_Weights - 1 then
                              Transpiler_Native_HAL.Emit_Raw (", ", Emit_Success);
                           end if;
                           Weight_Index := Weight_Index + 1;
                        end loop;
                     end loop;
                  end;
               end loop;

               if Target = Backend_C then
                  Transpiler_Native_HAL.Emit_Raw ("};", Emit_Success);
               end if;
               Transpiler_Native_HAL.Emit_Newline (Emit_Success);
            end;
         else
            if Target = Backend_C then
               Transpiler_Native_HAL.Emit_Raw ("static int64_t ALB_NN_WEIGHTS_" & Name & "[1] = {0};", Emit_Success);
            else
               Transpiler_Native_HAL.Emit_Raw ("  ALB_NN_WEIGHTS_" & Name & " dq 0", Emit_Success);
            end if;
            Transpiler_Native_HAL.Emit_Newline (Emit_Success);
         end if;

         if Total_Biases > 0 then
            if Target = Backend_C then
               Transpiler_Native_HAL.Emit_Raw
                 ("static int64_t ALB_NN_BIASES_" & Name & "[" & Nat_Img (Total_Biases) & "] = {0};",
                  Emit_Success);
            else
               Transpiler_Native_HAL.Emit_Raw
                 ("  ALB_NN_BIASES_" & Name & " dq " & Nat_Img (Total_Biases) & " dup (0)",
                  Emit_Success);
            end if;
            Transpiler_Native_HAL.Emit_Newline (Emit_Success);
         else
            if Target = Backend_C then
               Transpiler_Native_HAL.Emit_Raw ("static int64_t ALB_NN_BIASES_" & Name & "[1] = {0};", Emit_Success);
            else
               Transpiler_Native_HAL.Emit_Raw ("  ALB_NN_BIASES_" & Name & " dq 0", Emit_Success);
            end if;
            Transpiler_Native_HAL.Emit_Newline (Emit_Success);
         end if;

         if Target = Backend_C then
            Transpiler_Native_HAL.Emit_Raw
              ("static int64_t ALB_NN_STATE_" & Name & "[" & Nat_Img (Total_Neurons) & "] = {0};",
               Emit_Success);
         else
            Transpiler_Native_HAL.Emit_Raw
              ("  ALB_NN_STATE_" & Name & " dq " & Nat_Img (Total_Neurons) & " dup (0)",
               Emit_Success);
         end if;
         Transpiler_Native_HAL.Emit_Newline (Emit_Success);

         if Target = Backend_C then
            Transpiler_Native_HAL.Emit_Raw
              ("static int64_t ALB_NN_DELTA_" & Name & "[" & Nat_Img (Total_Neurons) & "] = {0};",
               Emit_Success);
         else
            Transpiler_Native_HAL.Emit_Raw
              ("  ALB_NN_DELTA_" & Name & " dq " & Nat_Img (Total_Neurons) & " dup (0)",
               Emit_Success);
         end if;
         Transpiler_Native_HAL.Emit_Newline (Emit_Success);

         if Target = Backend_C then
            Transpiler_Native_HAL.Emit_Raw
              ("static uint64_t ALB_NN_META_" & Name & "[] = {" &
               Nat_Img (Layer_Count) & ", " &
               Nat_Img (Total_Neurons) & ", " &
               Nat_Img (Total_Weights) & ", " &
               Nat_Img (Total_Biases) & ", " &
               "(uint64_t)(uintptr_t)ALB_NN_SIZES_" & Name & ", " &
               "(uint64_t)(uintptr_t)ALB_NN_ACT_CODES_" & Name & ", " &
               "(uint64_t)(uintptr_t)ALB_NN_NEURON_OFFS_" & Name & ", " &
               "(uint64_t)(uintptr_t)ALB_NN_WEIGHT_OFFS_" & Name & ", " &
               "(uint64_t)(uintptr_t)ALB_NN_BIAS_OFFS_" & Name & ", " &
               "(uint64_t)(uintptr_t)ALB_NN_WEIGHTS_" & Name & ", " &
               "(uint64_t)(uintptr_t)ALB_NN_BIASES_" & Name & ", " &
               "(uint64_t)(uintptr_t)ALB_NN_STATE_" & Name & ", " &
               "(uint64_t)(uintptr_t)ALB_NN_DELTA_" & Name &
               "};",
               Emit_Success);
         else
            Transpiler_Native_HAL.Emit_Raw
              ("  ALB_NN_META_" & Name & " dq " &
               Nat_Img (Layer_Count) & ", " &
               Nat_Img (Total_Neurons) & ", " &
               Nat_Img (Total_Weights) & ", " &
               Nat_Img (Total_Biases) & ", " &
               "ALB_NN_SIZES_" & Name & ", " &
               "ALB_NN_ACT_CODES_" & Name & ", " &
               "ALB_NN_NEURON_OFFS_" & Name & ", " &
               "ALB_NN_WEIGHT_OFFS_" & Name & ", " &
               "ALB_NN_BIAS_OFFS_" & Name & ", " &
               "ALB_NN_WEIGHTS_" & Name & ", " &
               "ALB_NN_BIASES_" & Name & ", " &
               "ALB_NN_STATE_" & Name & ", " &
               "ALB_NN_DELTA_" & Name,
               Emit_Success);
         end if;
         Transpiler_Native_HAL.Emit_Newline (Emit_Success);

         Transpiler_Native_HAL.Set_Global_Buffer_Mode (False);
      end Register_Neural_Topology_Decl;

      function Find_Foreign_Export (Name : String) return Natural is
      begin
         for I in 1 .. Foreign_Export_Count loop
            if Foreign_Exports (I).Active
              and then Foreign_Exports (I).Name_Len = Name'Length
              and then Foreign_Exports (I).Name (1 .. Name'Length) = Name
            then
               return I;
            end if;
         end loop;

         return 0;
      end Find_Foreign_Export;

      procedure Register_Foreign_Export_Decl
        (Node    : in Node_Index;
         Flavor  : in Foreign_Export_Flavor;
         Success : in out Boolean;
         Diag    : in out Compiler_Diagnostic)
      is
         Decl_Node   : constant Node_Index := Tree (Node).Left_Child;
         Name_Node   : constant Node_Index := Tree (Decl_Node).Left_Child;
         Raw_Name    : constant String := Raw_Lexeme (Tree (Name_Node).Token_Index);
         Mod_Name    : constant String :=
           (if Active_Module_Len > 0 then Active_Module_Name (1 .. Active_Module_Len) else "");
         Target_Name : constant String := Forge_Backend_Name (Mod_Name, Raw_Name, False);
      begin
         if Find_Foreign_Export (Target_Name) /= 0 then
            return;
         end if;

         if Foreign_Export_Count >= Max_Foreign_Exports then
            Fail_Node (Node, Err_Mem_Out_Of_Bounds, Target_Name, Success, Diag);
            return;
         end if;

         Foreign_Export_Count := Foreign_Export_Count + 1;
         Foreign_Exports (Foreign_Export_Count).Name_Hash := Hash_String (Target_Name);
         Store_Name
           (Foreign_Exports (Foreign_Export_Count).Name,
            Foreign_Exports (Foreign_Export_Count).Name_Len,
            Target_Name);
         Foreign_Exports (Foreign_Export_Count).Flavor := Flavor;
         Foreign_Exports (Foreign_Export_Count).Node_Ref := Node;
         Foreign_Exports (Foreign_Export_Count).Active := True;
         FASM_Exports_Used := True;
      end Register_Foreign_Export_Decl;

      function Strict_Array_Total_Elements (Index : Natural) return Natural is
         Total : Natural := 1;
      begin
         if Index = 0 then
            return 0;
         end if;

         for I in 1 .. Strict_Arrays (Index).Dim_Count loop
            Total := Total * Strict_Arrays (Index).Dims (I);
         end loop;

         return Total;
      end Strict_Array_Total_Elements;

      function Array_Byte_Size
        (Name : String;
         Tag  : ALB_Type_Tag) return Natural
      is
         Strict_Idx : constant Natural := Find_Strict_Array (Name);
         Slide_Idx  : constant Natural := Find_Slide_Array (Name);
         Decl_Tag   : constant ALB_Type_Tag := Array_Declared_Tag (Name, Tag);
         Elem_Bytes : Natural := 8;
      begin
         case Decl_Tag is
            when Type_U8 | Type_S8 | Type_HW8 | Type_Boolean | Type_Char =>
               Elem_Bytes := 1;
            when Type_U16 | Type_S16 | Type_HW16 | Type_Binary | Type_Reference =>
               Elem_Bytes := 2;
            when Type_U32 | Type_S32 | Type_HW32 | Type_F32 =>
               Elem_Bytes := 4;
            when Type_F32x2 | Type_HW64 =>
               Elem_Bytes := 8;
            when Type_U128 | Type_S128 | Type_F128 | Type_Pure
               | Type_F32x4 | Type_Mat2x2 =>
               Elem_Bytes := 16;
            when Type_Mat3x3 =>
               Elem_Bytes := 48;
            when Type_Mat4x4 =>
               Elem_Bytes := 64;
            when others =>
               Elem_Bytes := 8;
         end case;

         if Strict_Idx > 0 then
            return Strict_Array_Total_Elements (Strict_Idx) * Elem_Bytes;
         elsif Slide_Idx > 0 then
            return Slide_Arrays (Slide_Idx).Active * Elem_Bytes;
         else
            return 0;
         end if;
      end Array_Byte_Size;

      function Array_Element_Bytes
        (Tag : ALB_Type_Tag) return Natural
      is
      begin
         case Tag is
            when Type_U8 | Type_S8 | Type_HW8 | Type_Boolean | Type_Char =>
               return 1;
            when Type_U16 | Type_S16 | Type_HW16 | Type_Binary | Type_Reference =>
               return 2;
            when Type_U32 | Type_S32 | Type_HW32 | Type_F32 =>
               return 4;
            when Type_F64 | Type_F32x2 | Type_HW64 =>
               return 8;
            when Type_U128 | Type_S128 | Type_F128 | Type_Pure
               | Type_F32x4 | Type_Mat2x2 =>
               return 16;
            when Type_Mat3x3 =>
               return 48;
            when Type_Mat4x4 =>
               return 64;
            when others =>
               return 8;
         end case;
      end Array_Element_Bytes;

      function Array_Data_Offset
        (Name : String;
         Tag  : ALB_Type_Tag) return Natural
      is
      begin
         if Find_Strict_Array (Name) > 0 or else Find_Slide_Array (Name) > 0 then
            return Array_Element_Bytes (Array_Declared_Tag (Name, Tag));
         end if;

         return 0;
      end Array_Data_Offset;

      function C_Array_Data_Expr
        (Name : String) return String
      is
      begin
         if Find_Strict_Array (Name) > 0 or else Find_Slide_Array (Name) > 0 then
            return "(" & Name & " + 1)";
         end if;

         return Name;
      end C_Array_Data_Expr;

      procedure Emit_FASM_Array_Data_Address
        (Name          : in String;
         Tag           : in ALB_Type_Tag;
         Register_Name : in String;
         Success       : in out Boolean)
      is
         Offset : constant Natural := Array_Data_Offset (Name, Tag);
      begin
         Transpiler_Native_HAL.Emit_Raw ("  lea " & Register_Name & ", [" & Name, Success);
         if not Success then
            return;
         end if;

         if Offset > 0 then
            Transpiler_Native_HAL.Emit_Raw (" + " & Nat_Img (Offset), Success);
            if not Success then
               return;
            end if;
         end if;

         Transpiler_Native_HAL.Emit_Raw ("]", Success);
         Transpiler_Native_HAL.Emit_Newline (Success);
      end Emit_FASM_Array_Data_Address;

      function Array_Element_Count (Name : String) return Natural is
         Strict_Idx : constant Natural := Find_Strict_Array (Name);
         Slide_Idx  : constant Natural := Find_Slide_Array (Name);
      begin
         if Strict_Idx > 0 then
            return Strict_Array_Total_Elements (Strict_Idx);
         elsif Slide_Idx > 0 then
            return Slide_Arrays (Slide_Idx).Active;
         else
            return 0;
         end if;
      end Array_Element_Count;

      function C_Export_Macro
        (Flavor : Foreign_Export_Flavor) return String
      is
      begin
         case Flavor is
            when Export_Flavor_DLL =>
               return "ALB_EXPORT_DLL";
            when Export_Flavor_SO =>
               return "ALB_EXPORT_SO";
            when Export_Flavor_Dylib =>
               return "ALB_EXPORT_DYLIB";
         end case;
      end C_Export_Macro;

      function FASM_Export_Image_Name return String is
         ASM_Name : constant String := File_Name_With_Extension (Output_File (1 .. Output_Flen));
      begin
         if ASM_Name'Length >= 4
           and then To_Upper (ASM_Name (ASM_Name'Last - 3 .. ASM_Name'Last)) = ".ASM"
         then
            if FASM_DLL_Mode_Active then
               return ASM_Name (ASM_Name'First .. ASM_Name'Last - 4) & ".dll";
            else
               return ASM_Name (ASM_Name'First .. ASM_Name'Last - 4) & ".exe";
            end if;
         else
            if FASM_DLL_Mode_Active then
               return ASM_Name & ".dll";
            else
               return ASM_Name & ".exe";
            end if;
         end if;
      end FASM_Export_Image_Name;

