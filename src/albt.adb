                         Emit_Global_Line ("    ALB_INI_BufLen = n;");
                         Emit_Global_Line ("    fclose(fp);");
                         Emit_Global_Line ("    fprintf(stderr, ""[INI] OK bytes=%llu\n"", (unsigned long long)n);");
                         Emit_Global_Line ("    return (uint64_t)n;");
                         Emit_Global_Line ("}");
                         Emit_Global_Line ("static int ALB_INI_AlphaLower(int c) {");
                         Emit_Global_Line ("    if (c >= 'A' && c <= 'Z') return c + 32;");
                         Emit_Global_Line ("    return c;");
                         Emit_Global_Line ("}");
                         Emit_Global_Line ("static uint64_t ALB_INI_Parse(const ALB_INI_Field* table) {");
                         Emit_Global_Line ("    uint64_t matched = 0;");
                         Emit_Global_Line ("    const char* p = ALB_INI_Buffer;");
                         Emit_Global_Line ("    while (*p) {");
                         Emit_Global_Line ("        while (*p == ' ' || *p == '\t') p++;");
                         Emit_Global_Line ("        if (*p == '\n' || *p == '\r') { p++; continue; }");
                         Emit_Global_Line ("        if (*p == '\0') break;");
                         Emit_Global_Line ("        if (*p == '#' || *p == ';' || *p == '[') {");
                         Emit_Global_Line ("            while (*p && *p != '\n') p++;");
                         Emit_Global_Line ("            continue;");
                         Emit_Global_Line ("        }");
                         Emit_Global_Line ("        const ALB_INI_Field* row = table;");
                         Emit_Global_Line ("        const char* key_start = p;");
                         Emit_Global_Line ("        while (row->key) {");
                         Emit_Global_Line ("            const char* lp = key_start;");
                         Emit_Global_Line ("            const char* kp = row->key;");
                         Emit_Global_Line ("            while (*kp && ALB_INI_AlphaLower((unsigned char)*lp) == (unsigned char)*kp) { lp++; kp++; }");
                         Emit_Global_Line ("            if (*kp == 0) {");
                         Emit_Global_Line ("                while (*lp == ' ' || *lp == '\t') lp++;");
                         Emit_Global_Line ("                if (*lp == '=') {");
                         Emit_Global_Line ("                    lp++;");
                         Emit_Global_Line ("                    while (*lp == ' ' || *lp == '\t') lp++;");
                         Emit_Global_Line ("                    int64_t sign = 1;");
                         Emit_Global_Line ("                    if (*lp == '-') { sign = -1; lp++; }");
                         Emit_Global_Line ("                    int64_t val = 0;");
                         Emit_Global_Line ("                    while (*lp >= '0' && *lp <= '9') {");
                         Emit_Global_Line ("                        val = val * 10 + (*lp - '0');");
                         Emit_Global_Line ("                        lp++;");
                         Emit_Global_Line ("                    }");
                         Emit_Global_Line ("                    val *= sign;");
                         Emit_Global_Line ("                    if (row->dest) {");
                         Emit_Global_Line ("                        *row->dest = val;");
                         Emit_Global_Line ("                        fprintf(stderr, ""[INI] key=%s value=%lld\n"", row->key, (long long)val);");
                         Emit_Global_Line ("                        matched++;");
                         Emit_Global_Line ("                    }");
                         Emit_Global_Line ("                    p = lp;");
                         Emit_Global_Line ("                    break;");
                         Emit_Global_Line ("                }");
