   procedure Register_Range_Var (Name : String; Range_ID : Natural) is
      H : constant U32 := Hash_String(Name);
   begin
      if Range_ID = 0 then
         return;
      end if;

      for I in 1 .. Range_Var_Count loop
         if Range_Vars(I).Active
           and then Range_Vars(I).Name_Hash = H
           and then Range_Vars(I).Name_Len = Name'Length
           and then Range_Vars(I).Name(1 .. Name'Length) = Name
         then
            Range_Vars(I).Range_ID := Range_ID;
            return;
         end if;
      end loop;

      if Range_Var_Count < Max_Range_Vars then
         Range_Var_Count := Range_Var_Count + 1;
         Range_Vars(Range_Var_Count).Name_Hash := H;
         Range_Vars(Range_Var_Count).Name_Len := Name'Length;
         Range_Vars(Range_Var_Count).Name := (others => ' ');
         Range_Vars(Range_Var_Count).Name(1 .. Name'Length) := Name;
         Range_Vars(Range_Var_Count).Range_ID := Range_ID;
         Range_Vars(Range_Var_Count).Active := True;
      end if;
   end Register_Range_Var;
   
