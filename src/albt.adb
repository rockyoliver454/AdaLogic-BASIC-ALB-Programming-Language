                    (if Addr_Node > 0 then Tree (Addr_Node).Next_Sibling else 0);
                  Handle_Name  : constant String := Process_Handle_Name (Handle_Node);
                  Value_Name   : constant String := Simple_Var_Name (Value_Node);
