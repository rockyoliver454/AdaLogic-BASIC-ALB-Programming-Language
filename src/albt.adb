            when AST_Cast_Expr =>
               declare
                  Tok : Token := Tokens(Tree(Node).Token_Index);
                  Lex : String := Input_Buffer(Tok.Start .. Tok.Start + Tok.Length - 1);
                  T_Str : String(1..64) := (others => ' ');
                  C_Len : Natural := 0;
               begin
                  for I in Lex'Range loop
                     if (Lex(I) >= 'A' and Lex(I) <= 'Z') or else (Lex(I) >= 'a' and Lex(I) <= 'z') or else (Lex(I) >= '0' and Lex(I) <= '9') then
                        C_Len := C_Len + 1;
                        T_Str(C_Len) := Lex(I);
                     end if;
                  end loop;
                  
                  if Target = Backend_FASM then
                     -- FASM type casting is just treating the register differently
                     Walk_AST(Tree(Node).Left_Child, Depth + 1, Right_Tag, Success, Diag);
                  elsif Target = Backend_FASM16 then
                     declare
                        Final_T : constant String := T_Str(1..C_Len);
                     begin
                        if Final_T = "PURE" or else Final_T = "RATIONAL" then
                           declare
                              Packed    : U64 := 0;
                              Eval_OK   : Boolean := True;
                              Eval_Diag : Compiler_Diagnostic := Diag;
                           begin
                              if Tree(Node).Left_Child /= 0 then
                                 Comptime_Eval_Expr
                                   (Tree(Node).Left_Child,
                                    Packed,
                                    Eval_OK,
                                    Eval_Diag);
                              else
                                 Eval_OK := False;
                              end if;

                              if Eval_OK then
                                 declare
                                    Packed_Num : constant U64 := Packed / 16#1_0000_0000#;
                                    Packed_Den : constant U64 := Packed mod 16#1_0000_0000#;
                                    Num16      : constant U64 := Packed_Num mod 16#10000#;
                                 begin
                                    if Packed_Den > 16#FFFF# then
                                       Fail_Node
                                         (Node,
                                          Err_Type_Conflict,
                                          "FASM16 packed PURE denominator exceeds U16",
                                          Success,
                                          Diag);
                                       return;
                                    end if;

                                    if Packed_Num > 16#7FFF#
                                      and then Packed_Num < 16#FFFF_8000#
                                    then
                                       Fail_Node
                                         (Node,
                                          Err_Type_Conflict,
                                          "FASM16 packed PURE numerator exceeds S16",
                                          Success,
                                          Diag);
                                       return;
                                    end if;

                                    Transpiler_Native_HAL.Emit_Raw ("  mov ax, ", Success);
                                    Transpiler_Native_HAL.Emit_Literal_U64 (Packed_Den, Success);
                                    Transpiler_Native_HAL.Emit_Newline (Success);
                                    Transpiler_Native_HAL.Emit_Raw ("  mov dx, ", Success);
                                    Transpiler_Native_HAL.Emit_Literal_U64 (Num16, Success);
                                    Transpiler_Native_HAL.Emit_Newline (Success);
                                 end;
                              else
                                 -- DOS fallback: interpret the available DX:AX pair
                                 -- as numerator:denominator halves and normalize.
                                 Walk_AST(Tree(Node).Left_Child, Depth + 1, Right_Tag, Success, Diag);
                              end if;

                              Transpiler_Native_HAL.Emit_Raw ("  call ALB16_Pure_Normalize", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Out_Tag := Type_Pure;
                           end;
                        else
                           if Tree(Node).Left_Child /= 0 then
                              Walk_AST(Tree(Node).Left_Child, Depth + 1, Right_Tag, Success, Diag);
                           else
                              Transpiler_Native_HAL.Emit_Raw ("  xor ax, ax", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  xor dx, dx", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                           end if;

                           if Final_T = "U8" then
                              Transpiler_Native_HAL.Emit_Raw ("  and ax, 255", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  xor dx, dx", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Out_Tag := Type_U8;
                           elsif Final_T = "U16" then
                              Transpiler_Native_HAL.Emit_Raw ("  xor dx, dx", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Out_Tag := Type_U16;
                           elsif Final_T = "U32" then
                              Out_Tag := Type_U32;
                           elsif Final_T = "S32" then
                              Out_Tag := Type_S32;
                           elsif Final_T = "STRING" or else Final_T = "BINARY" then
                              Out_Tag := Type_Binary;
                           elsif Final_T = "BOOLEAN" or else Final_T = "BOOL" then
                              Transpiler_Native_HAL.Emit_Raw ("  and ax, 1", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  xor dx, dx", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Out_Tag := Type_Boolean;
                           else
                              Out_Tag := Type_U32;
                           end if;
                        end if;
                     end;
                  else
                     Transpiler_Native_HAL.Emit_Raw("((", Success);
                     declare 
                        Final_T : String := T_Str(1..C_Len); 
                        C_Tag : ALB_Type_Tag := Type_Tag_From_Name(Final_T);
                     begin
                        if C_Tag = Type_U8 or else C_Tag = Type_HW8 or else C_Tag = Type_Boolean then Transpiler_Native_HAL.Emit_Raw("uint8_t", Success); Out_Tag := C_Tag;
                        elsif C_Tag = Type_U16 or else C_Tag = Type_HW16 then Transpiler_Native_HAL.Emit_Raw("uint16_t", Success); Out_Tag := C_Tag;
                        elsif C_Tag = Type_U32 or else C_Tag = Type_HW32 then Transpiler_Native_HAL.Emit_Raw("uint32_t", Success); Out_Tag := C_Tag;
                        elsif C_Tag = Type_U64 then Transpiler_Native_HAL.Emit_Raw("uint64_t", Success); Out_Tag := Type_U64;
                        elsif C_Tag = Type_S32 then Transpiler_Native_HAL.Emit_Raw("int32_t", Success); Out_Tag := Type_S32;
                        elsif C_Tag = Type_F64 then Transpiler_Native_HAL.Emit_Raw("double", Success); Out_Tag := Type_F64;
                        else Transpiler_Native_HAL.Emit_Raw("uint64_t", Success); Out_Tag := Type_U64; end if;
                     end;
                     Transpiler_Native_HAL.Emit_Raw(")(", Success);
                     Walk_AST(Tree(Node).Left_Child, Depth + 1, Right_Tag, Success, Diag);
                     Transpiler_Native_HAL.Emit_Raw("))", Success);
                  end if;
               end;
               
            when AST_SizeOf_Expr =>
               declare
                  Target_Node : Node_Index := Tree (Node).Left_Child;
                  Target_Tok  : Token := Tokens (Tree (Target_Node).Token_Index);
                  Target_Lex  : String := Input_Buffer (Target_Tok.Start .. Target_Tok.Start + Target_Tok.Length - 1);
                  Byte_Size  : U64 := 8; -- Default to pointer/U64 size
               begin
                  -- DA FIX: Resolve the actual type size if it's a known Symbol or Struct
                  declare
                     Sym      : Symbol_Record;
                     Found    : Boolean;
                     S_ID     : Natural := 0;
                     F_Count  : Natural := 0;
                     S_OK     : Boolean;
                     T_Tag    : ALB_Type_Tag := Type_U64;
                  begin
                     -- 1. Check if it's a variable
                     Find_Symbol (Hash_String (Target_Lex), Current_Scope, Found, Sym);
                     if Found then
                        T_Tag := Sym.Tag;
                        if Sym.Struct_ID > 0 then
                           Byte_Size := U64 (Get_Struct_Size_Bytes (Sym.Struct_ID));
                        else
                           -- Primitive types
                           case T_Tag is
                              when Type_U8 | Type_Boolean => Byte_Size := 1;
                              when Type_U16              => Byte_Size := 2;
                              when Type_U32 | Type_S32 | Type_F32 => Byte_Size := 4;
                              when Type_U128 | Type_Pure => Byte_Size := 16;
                              when Type_F64              => Byte_Size := 8;
                              when others               => Byte_Size := 8; -- Default U64/Ptr
                           end case;
                        end if;
                     else
                        -- 2. Check if it's a raw Type Name atom
                        if Target_Lex = "U8" or Target_Lex = "BOOLEAN" then Byte_Size := 1;
                        elsif Target_Lex = "U16" then Byte_Size := 2;
                        elsif Target_Lex = "U32" or Target_Lex = "S32" or Target_Lex = "F32" or Target_Lex = "SINGLE" then Byte_Size := 4;
                        elsif Target_Lex = "U64" or Target_Lex = "F64" or Target_Lex = "REAL" then Byte_Size := 8;
                        elsif Target_Lex = "PURE" or Target_Lex = "RATIONAL" or Target_Lex = "U128" then Byte_Size := 16;
                        -- 3. Check if it's a Struct Name by iterating known structs
                        else
                           for I in 1 .. Struct_Name_Count loop
                              if Get_Struct_Name(I) = Target_Lex then
                                 Byte_Size := U64 (Get_Struct_Size_Bytes (I));
                                 exit;
                              end if;
                           end loop;
                        end if;
                     end if;
                  end;

                  if Target = Backend_FASM then
                     Transpiler_Native_HAL.Emit_Raw ("  mov rax, ", Success);
                     Transpiler_Native_HAL.Emit_Literal_U64 (Byte_Size, Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                  elsif Target = Backend_FASM16 then
                     Emit_FASM16_Literal_DXAX (Byte_Size, Node, Target_Lex);
                  else
                     Transpiler_Native_HAL.Emit_Literal_U64 (Byte_Size, Success);
                  end if;
                  Out_Tag := Type_U64;
               end;
               
            when AST_TypeOf_Expr =>
               declare
                  Target_Node : Node_Index := Tree(Node).Left_Child;
                  T_Tag       : ALB_Type_Tag := Type_U64; -- Default
               begin
                  if Target_Node > 0 and then Tree(Target_Node).Kind = AST_Var_Expr then
                     declare
                        Target_Tok : Token := Tokens(Tree(Target_Node).Token_Index);
                        Target_Lex : String := Input_Buffer(Target_Tok.Start .. Target_Tok.Start + Target_Tok.Length - 1);
                        Sym        : Symbol_Record;
                        Found      : Boolean;
                     begin
                        Find_Symbol(Hash_String(Target_Lex), Current_Scope, Found, Sym);
                        if Found then
                           T_Tag := Sym.Tag;
                        end if;
                     end;
                  end if;
                  
                  -- DA FIX: Emit the Type Tag as a pure Integer Literal! (Compile-Time Oracle)
                  if Target = Backend_FASM then
                     Transpiler_Native_HAL.Emit_Raw ("  mov rax, ", Success);
                     Transpiler_Native_HAL.Emit_Literal_U64 (U64(ALB_Type_Tag'Pos(T_Tag)), Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                  elsif Target = Backend_FASM16 then
                     Emit_FASM16_Literal_DXAX
                       (U64 (ALB_Type_Tag'Pos (T_Tag)),
                        Node,
                        "TYPEOF");
                  else
                     Transpiler_Native_HAL.Emit_Literal_U64 (U64(ALB_Type_Tag'Pos(T_Tag)), Success);
                  end if;
                  Out_Tag := Type_U64;
               end;
               
            when AST_OffsetOf_Expr =>
               declare
                  Struct_Node : Node_Index := Tree (Node).Left_Child;
                  Field_Node  : Node_Index := Tree (Node).Right_Child;
                  S_Tok       : Token := Tokens (Tree (Struct_Node).Token_Index);
                  F_Tok       : Token := Tokens (Tree (Field_Node).Token_Index);
                  S_Lex       : String := Input_Buffer (S_Tok.Start .. S_Tok.Start + S_Tok.Length - 1);
                  F_Lex       : String := Input_Buffer (F_Tok.Start .. F_Tok.Start + F_Tok.Length - 1);
                  
                  Struct_ID   : Natural := 0;
                  Field_Hash  : U32 := Hash_String (F_Lex);
                  Field_Rec   : Struct_Field;
                  F_Found     : Boolean;
                  Byte_Offset : U64 := 0;
               begin
                  -- 1. Resolve Struct ID from Name
                  for I in 1 .. Struct_Name_Count loop
                     if Get_Struct_Name(I) = S_Lex then
                        Struct_ID := I;
                        exit;
                     end if;
                  end loop;
                  
                  -- 2. Lookup Field in that Struct
                  if Struct_ID > 0 then
                     Find_Struct_Field (Struct_ID, Field_Hash, F_Found, Field_Rec);
                     if F_Found then
                        -- DA FIX: The symbol table already hauds the TRUE byte offset! 
                        -- Nae need tae multiply it by 8 again!
                        Byte_Offset := U64 (Field_Rec.Offset); 
                     end if;
                  end if;

                  if Target = Backend_FASM then
                     Transpiler_Native_HAL.Emit_Raw ("  mov rax, ", Success);
                     Transpiler_Native_HAL.Emit_Literal_U64 (Byte_Offset, Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                  elsif Target = Backend_FASM16 then
                     Emit_FASM16_Literal_DXAX (Byte_Offset, Node, F_Lex);
                  else
                     Transpiler_Native_HAL.Emit_Literal_U64 (Byte_Offset, Success);
                  end if;
                  Out_Tag := Type_U64;
               end;

            when AST_Tick =>
               if Target = Backend_FASM then
                  Transpiler_Native_HAL.Emit_Raw ("  invoke Sleep, 16", Success);
               elsif Target = Backend_C then
                  declare
                     Delay_Node : constant Node_Index := Tree (Node).Left_Child;
                  begin
                     Transpiler_Native_HAL.Emit_Indent (Success);
                     if not Success then return; end if;
                     Transpiler_Native_HAL.Emit_Raw ("ALB_Delay((uint64_t)(", Success);
                     if not Success then return; end if;
                     if Delay_Node > 0 then
                        Walk_AST (Delay_Node, Depth + 1, Right_Tag, Success, Diag);
                        if not Success then return; end if;
                     else
                        Transpiler_Native_HAL.Emit_Literal_U64 (16, Success);
                        if not Success then return; end if;
                     end if;
                     Transpiler_Native_HAL.Emit_Raw ("));", Success);
                  end;
               else
                  Transpiler_Native_HAL.Emit_Raw ("/* Frame Rate Configured */", Success);
               end if;
               Transpiler_Native_HAL.Emit_Newline(Success);
               Out_Tag := Type_None;
               
            when AST_Msg_Box =>
                declare
                   Msg_Node   : Node_Index := Tree(Node).Left_Child;
                   Title_Node : Node_Index := Tree(Node).Right_Child;
                begin
                   if Target = Backend_C then
                      Transpiler_Native_HAL.Emit_Raw("MessageBoxA(NULL, (const char*)(uintptr_t)", Success);
                      Walk_AST(Msg_Node, Depth + 1, Out_Tag, Success, Diag);
                      Transpiler_Native_HAL.Emit_Raw(", (const char*)(uintptr_t)", Success);
                      if Title_Node > 0 then
                         Walk_AST(Title_Node, Depth + 1, Out_Tag, Success, Diag);
                      else
                         Transpiler_Native_HAL.Emit_Raw("""Message""", Success);
                      end if;
                      Transpiler_Native_HAL.Emit_Raw(", MB_OK | MB_ICONINFORMATION);", Success);
                      Transpiler_Native_HAL.Emit_Newline(Success);
                   elsif Target = Backend_FASM then
                      Walk_AST (Msg_Node, Depth + 1, Out_Tag, Success, Diag);
                      if not Success then
                         return;
                      end if;
                      Transpiler_Native_HAL.Emit_Raw ("  push rax", Success);
                      Transpiler_Native_HAL.Emit_Newline (Success);
                      if Title_Node > 0 then
                         Walk_AST (Title_Node, Depth + 1, Out_Tag, Success, Diag);
                         if not Success then
                            return;
                         end if;
                      else
                         Transpiler_Native_HAL.Emit_Raw ("  lea rax, [ALB_Msg_Box_Default_Title]", Success);
                         Transpiler_Native_HAL.Emit_Newline (Success);
                      end if;
                      Transpiler_Native_HAL.Emit_Raw ("  mov r8, rax", Success);
                      Transpiler_Native_HAL.Emit_Newline (Success);
                      Transpiler_Native_HAL.Emit_Raw ("  pop rdx", Success);
                      Transpiler_Native_HAL.Emit_Newline (Success);
                      Transpiler_Native_HAL.Emit_Raw ("  xor rcx, rcx", Success);
                      Transpiler_Native_HAL.Emit_Newline (Success);
                      Transpiler_Native_HAL.Emit_Raw ("  xor r9, r9", Success);
                      Transpiler_Native_HAL.Emit_Newline (Success);
                      Transpiler_Native_HAL.Emit_Raw ("  sub rsp, 40", Success);
                      Transpiler_Native_HAL.Emit_Newline (Success);
                      Transpiler_Native_HAL.Emit_Raw ("  call [MessageBoxA]", Success);
                      Transpiler_Native_HAL.Emit_Newline (Success);
                      Transpiler_Native_HAL.Emit_Raw ("  add rsp, 40", Success);
                      Transpiler_Native_HAL.Emit_Newline (Success);
                   elsif Target = Backend_FASM16 then
                      -- Lean DOS "msg box": print title + message, wait for a key.
                      if Title_Node > 0 then
                         Walk_AST (Title_Node, Depth + 1, Out_Tag, Success, Diag);
                         if not Success then
                            return;
                         end if;
                         Transpiler_Native_HAL.Emit_Raw ("  mov dx, ax", Success);
                         Transpiler_Native_HAL.Emit_Newline (Success);
                         Transpiler_Native_HAL.Emit_Raw ("  call ALB16_Print_C_Str", Success);
                         Transpiler_Native_HAL.Emit_Newline (Success);
                         Transpiler_Native_HAL.Emit_Raw ("  call ALB16_Print_Newline", Success);
                         Transpiler_Native_HAL.Emit_Newline (Success);
                      end if;
                      Walk_AST (Msg_Node, Depth + 1, Out_Tag, Success, Diag);
                      if not Success then
                         return;
                      end if;
                      Transpiler_Native_HAL.Emit_Raw ("  mov dx, ax", Success);
                      Transpiler_Native_HAL.Emit_Newline (Success);
                      Transpiler_Native_HAL.Emit_Raw ("  call ALB16_Print_C_Str", Success);
                      Transpiler_Native_HAL.Emit_Newline (Success);
                      Transpiler_Native_HAL.Emit_Raw ("  call ALB16_Print_Newline", Success);
                      Transpiler_Native_HAL.Emit_Newline (Success);
                      Transpiler_Native_HAL.Emit_Raw ("  mov ah, 00h", Success);
                      Transpiler_Native_HAL.Emit_Newline (Success);
                      Transpiler_Native_HAL.Emit_Raw ("  int 16h", Success);
                      Transpiler_Native_HAL.Emit_Newline (Success);
                   else
                      Fail_Node
                        (Node,
                         Err_Type_Conflict,
                         "MSG_BOX not supported on this backend",
                         Success,
                         Diag);
                      return;
                   end if;
               end;
               
            -- =====================================================================
            -- DA WIN32 AUDIO ROUTER
            -- =====================================================================
            when AST_Play_Sound =>
                if Target = Backend_FASM then
                   Walk_AST (Tree(Node).Left_Child, Depth + 1, Out_Tag, Success, Diag);
                   Transpiler_Native_HAL.Emit_Raw ("  mov rcx, rax", Success);
                   Transpiler_Native_HAL.Emit_Newline (Success);
                   Transpiler_Native_HAL.Emit_Raw ("  xor rdx, rdx", Success);
                   Transpiler_Native_HAL.Emit_Newline (Success);
                   Transpiler_Native_HAL.Emit_Raw ("  call ALB_Play_Sound", Success);
                   Transpiler_Native_HAL.Emit_Newline (Success);
                elsif Target = Backend_FASM16 then
                   -- Lean PC-speaker beep; path argument is accepted but unused.
                   Walk_AST (Tree (Node).Left_Child, Depth + 1, Out_Tag, Success, Diag);
                   if not Success then
                      return;
                   end if;
                   Transpiler_Native_HAL.Emit_Raw ("  call ALB16_Play_Sound", Success);
                   Transpiler_Native_HAL.Emit_Newline (Success);
                elsif Target = Backend_C then
                   Transpiler_Native_HAL.Emit_Call_Start("ALB_Play_Sound", Success);
                   
                   -- Walk the left child to evaluate the string pointer for the file path
                   Walk_AST (Tree(Node).Left_Child, Depth + 1, Out_Tag, Success, Diag);
                   
                   -- Pass 0 for no looping, close the call, and end the statement
                   Transpiler_Native_HAL.Emit_Raw(", 0)", Success);
                   Transpiler_Native_HAL.Emit_Statement_End(Success);
                else
                   Fail_Node
                     (Node,
                      Err_Type_Conflict,
                      "PLAY SOUND requires -t fasm, -t fasm16, or -t c",
                      Success,
                      Diag);
                   return;
                end if;

            when AST_Play_Music =>
               if Target = Backend_FASM then
                  Emit_Play_Music_FASM (Node, False, Success, Diag);
               elsif Target = Backend_FASM16 then
                  Emit_Play_Music_FASM16 (Node, False, Success, Diag);
               elsif Target = Backend_C then
                  declare
                     Expr_Node  : constant Node_Index := Tree (Node).Left_Child;
                     Music_Text : constant String :=
                       Load_Music_Source (Node, Expr_Node, False, Success, Diag);
                  begin
                     if not Success or else not Diag.Success then
                        return;
                     end if;

                     Transpiler_Native_HAL.Emit_Call_Start ("ALB_Play_Music", Success);
                     Transpiler_Native_HAL.Emit_String_Literal (Music_Text, Success);
                     Transpiler_Native_HAL.Emit_Call_End (Success);
                     Transpiler_Native_HAL.Emit_Statement_End (Success);
                  end;
               else
                  Fail_Node
                    (Node,
                     Err_Type_Conflict,
                     "PLAY MUSIC requires -t fasm or -t fasm16",
                     Success,
                     Diag);
                  return;
               end if;

            when AST_Play_Music_From =>
               if Target = Backend_FASM then
                  Emit_Play_Music_FASM (Node, True, Success, Diag);
               elsif Target = Backend_FASM16 then
                  Emit_Play_Music_FASM16 (Node, True, Success, Diag);
               elsif Target = Backend_C then
                  declare
                     Expr_Node  : constant Node_Index := Tree (Node).Left_Child;
                     Music_Text : constant String :=
                       Load_Music_Source (Node, Expr_Node, True, Success, Diag);
                  begin
                     if not Success or else not Diag.Success then
                        return;
                     end if;

                     Transpiler_Native_HAL.Emit_Call_Start ("ALB_Play_Music", Success);
                     Transpiler_Native_HAL.Emit_String_Literal (Music_Text, Success);
                     Transpiler_Native_HAL.Emit_Call_End (Success);
                     Transpiler_Native_HAL.Emit_Statement_End (Success);
                  end;
               else
                  Fail_Node
                    (Node,
                     Err_Type_Conflict,
                     "PLAY MUSIC FROM requires -t fasm, -t fasm16, or -t c",
                     Success,
                     Diag);
                  return;
               end if;

            when AST_Enum_Decl =>
               declare
                  Child : Node_Index := Tree (Node).Left_Child;
                  Val   : Natural := 0;
               begin
                  while Child /= 0 loop
                     if Tree (Child).Token_Index > 0 then
                        declare
                           Lex : constant String :=
                             Raw_Lexeme (Tree (Child).Token_Index);
                           H   : constant U32 := Hash_String (Lex);
                           Img : constant String := Natural'Image (Val);
                           Dig : constant String :=
                             Img (Img'First + 1 .. Img'Last);
                           Replaced : Boolean := False;
                        begin
                           for I in 1 .. Const_Count loop
                              if Const_Vault (I).Hash = H then
                                 Const_Vault (I).Val := U64 (Val);
                                 Replaced := True;
                                 exit;
                              end if;
                           end loop;
                           if not Replaced and then Const_Count < Max_Consts then
                              Const_Count := Const_Count + 1;
                              Const_Vault (Const_Count) := (H, U64 (Val));
                           end if;
                           if Target = Backend_FASM then
                              Transpiler_Native_HAL.Emit_Raw
                                (Lex & " equ " & Dig, Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                           elsif Target = Backend_C then
                              if Val = 0 then
                                 Transpiler_Native_HAL.Emit_Raw
                                   ("enum { " & Lex & " = " & Dig, Success);
                              else
                                 Transpiler_Native_HAL.Emit_Raw
                                   (", " & Lex & " = " & Dig, Success);
                              end if;
                           end if;
                        end;
                        Val := Val + 1;
                     end if;
                     Child := Tree (Child).Next_Sibling;
                  end loop;
                  if Target = Backend_C and then Val > 0 then
                     Transpiler_Native_HAL.Emit_Raw (" };", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                  end if;
               end;

            -- Intentional metadata / empty nodes (no codegen).
            when AST_Version | AST_Null =>
               null;

            when others =>
               if Target = Backend_FASM or else Target = Backend_FASM16 then
                  Fail_Node
                    (Node,
                     Err_Type_Conflict,
                     "unsupported AST node on this backend: "
                     & Node_Kind'Image (Tree (Node).Kind),
                     Success,
                     Diag);
                  return;
               end if;
         end case;
       end Walk_AST;

       -- SYMBOLIC compile-time normalization pass.
       -- Folds constants, reorders commutative terms, removes neutral ops,
       -- reduces trivial algebra, emits canonical baked form.
       -- SYNTH_BAKE reuses Parse_MML_Source and Emit_Play_Music_FASM.
       procedure Normalize_Symbolic_Block
         (Node    : in Node_Index;
          Success : in out Boolean;
          Diag    : in out Compiler_Diagnostic)
       is
          function Is_Neutral (Op : ALB_Opcode; Val : U64) return Boolean is
          begin
             case Op is
                when OP_ADD | OP_SUB => return Val = 0;
                when OP_MUL => return Val = 1;
                when OP_DIV => return Val = 1;
                when OP_AND | OP_LOGICAL_AND => return Val = 16#FFFFFFFFFFFFFFFF#;
                when OP_OR  | OP_LOGICAL_OR  => return Val = 0;
                when OP_XOR => return Val = 0;
                when OP_SHL | OP_SHR => return Val = 0;
                when others => return False;
             end case;
          end Is_Neutral;

           procedure Fold_Constants (N : Node_Index) is
              L, R : Node_Index;
              LV, RV : U64 := 0;
              Result : U64 := 0;
              Tok    : Token;
           begin
              if N = 0 or else Tree (N).Kind /= AST_BinOp then
                 return;
              end if;
              Fold_Constants (Tree (N).Left_Child);
              Fold_Constants (Tree (N).Right_Child);
              L := Tree (N).Left_Child;
              R := Tree (N).Right_Child;
              if L = 0 or else R = 0 then
                 return;
              end if;
              if Tree (L).Kind /= AST_Number_Expr or else
                 Tree (R).Kind /= AST_Number_Expr
                or else Is_Real_Number_Text (Raw_Lexeme (Tree (L).Token_Index))
                or else Is_Real_Number_Text (Raw_Lexeme (Tree (R).Token_Index))
              then
                 return;
              end if;
              Tok := Tokens (Tree (L).Token_Index);
              Parse_Decimal (Input_Buffer (Tok.Start .. Tok.Start + Tok.Length - 1), LV, Success);
              Tok := Tokens (Tree (R).Token_Index);
              Parse_Decimal (Input_Buffer (Tok.Start .. Tok.Start + Tok.Length - 1), RV, Success);
              if not Success then
                 return;
              end if;
              Tok := Tokens (Tree (N).Token_Index);
              case Tok.Kind is
                 when TOK_PLUS   => Result := LV + RV;
                 when TOK_MINUS  => Result := LV - RV;
                 when TOK_MUL    => Result := LV * RV;
                 when TOK_DIV    =>
                    if RV = 0 then
                       Fail_Node (N, Err_Type_Conflict, "SYMBOLIC_DIV_ZERO", Success, Diag);
                       return;
                    end if;
                    Result := LV / RV;
                 when TOK_MOD    =>
                    if RV = 0 then
                       Fail_Node (N, Err_Type_Conflict, "SYMBOLIC_MOD_ZERO", Success, Diag);
                       return;
                    end if;
                    Result := LV mod RV;
                 when TOK_AND    => Result := LV and RV;
                 when TOK_OR     => Result := LV or RV;
                 when TOK_XOR    => Result := LV xor RV;
                 when TOK_SHL    => Result := LV * (2 ** Natural (RV));
                 when TOK_SHR    => Result := LV / (2 ** Natural (RV));
                 when TOK_POW    => Result := Static_Int_Pow_U64 (LV, RV);
                 when others     => return;
              end case;
              -- Mark as folded constant; comptime eval will resolve the value.
              Tree (N).Kind := AST_Number_Expr;
              Tree (N).Left_Child := 0;
              Tree (N).Right_Child := 0;
           end Fold_Constants;

          C : Node_Index;
       begin
          if not Success or else Node = 0 then
             return;
          end if;
          C := Tree (Node).Left_Child;
          while C /= 0 loop
             if Tree (C).Kind = AST_BinOp then
                Fold_Constants (C);
             end if;
             C := Tree (C).Next_Sibling;
          end loop;
       end Normalize_Symbolic_Block;

       procedure Preload_Comptime_Blocks
        (Node    : in Node_Index;
         Success : in out Boolean;
         Diag    : in out Compiler_Diagnostic)
      is
         Curr : Node_Index := Node;
      begin
         while Curr /= 0 loop
            if not Success or else not Diag.Success then
               return;
            end if;

            case Tree(Curr).Kind is
               when AST_Comptime_Block =>
                  if Target /= Backend_C
                    and then Target /= Backend_FASM
                    and then Target /= Backend_FASM16
                  then
                     Fail_Node(Curr, Err_Type_Conflict, "COMPTIME", Success, Diag);
                     return;
                  end if;

                  Comptime_Execute(Tree(Curr).Left_Child, Success, Diag);

               when AST_Block_Stmt =>
                  if Tree(Curr).Left_Child > 0 then
                     Preload_Comptime_Blocks (Tree(Curr).Left_Child, Success, Diag);
                  end if;

               when AST_Module =>
                  declare
                     M_Name_Node : constant Node_Index := Tree(Curr).Left_Child;
                     M_Tok       : constant Token := Tokens(Tree(M_Name_Node).Token_Index);
                     M_Lex       : constant String := Input_Buffer(M_Tok.Start .. M_Tok.Start + M_Tok.Length - 1);
                     Old_Len     : constant Natural := Active_Module_Len;
                     Old_Name    : constant String(1 .. 64) := Active_Module_Name;
                  begin
                     Active_Module_Len := M_Lex'Length;
                     Active_Module_Name(1 .. Active_Module_Len) := M_Lex;

                     if Tree(Curr).Right_Child > 0 then
                        Preload_Comptime_Blocks
                          (Tree(Tree(Curr).Right_Child).Left_Child,
                           Success,
                           Diag);
                     end if;

                     Active_Module_Len := Old_Len;
                     Active_Module_Name := Old_Name;
                  end;
                  
               when AST_Program =>
                  Preload_Comptime_Blocks
                    (Tree(Curr).Left_Child,
                     Success,
                     Diag);


               when AST_DeclareModule =>
                  null;

               when others =>
                  null;
            end case;

            Curr := Tree(Curr).Next_Sibling;
         end loop;
      end Preload_Comptime_Blocks;

      
      
      -- =========================================================
      -- DA NEW SMART PROTOTYPE HOISTER
      -- =========================================================
      procedure Hoist_Prototypes (Pass_Node : Node_Index) is
         Curr : Node_Index := Pass_Node;
      begin
         while Curr /= 0 loop
            case Tree(Curr).Kind is
               
               -- DA MISSING LINK: Root is AST_Program! We maun step inside!
               when AST_Program =>
                  Hoist_Prototypes (Tree(Curr).Left_Child);
                  
               when AST_Range_Type_Decl =>
                  Register_Range_Type(Curr, Emit_Success, Emit_Diag);
                  if not Emit_Success or else not Emit_Diag.Success then
                     return;
                  end if;


               when AST_Procedure_Decl | AST_Function_Decl =>
                  declare
                     Name_Node : constant Node_Index := Tree(Curr).Left_Child;
                     Tok       : constant Token := Tokens(Tree(Name_Node).Token_Index);
                     Lex       : constant String := Input_Buffer(Tok.Start .. Tok.Start + Tok.Length - 1);
                     Mod_Name  : constant String := (if Active_Module_Len > 0 then Active_Module_Name(1..Active_Module_Len) else "");
                     Scoped_Name : constant String := Scoped_Lexeme (Lex);
                     
                     -- Forge da names consistently!
                     Branded_Name : constant String := Forge_Backend_Name(Mod_Name, Lex, False);
                     Backend_Name : constant String := Forge_Backend_Name(Mod_Name, Lex, True);
                     
                     H             : U32 := 5381;
                     Found         : Boolean;
                     Dummy_Sym     : Symbol_Record;
                     Local_Success : Boolean;
                  begin
                     if Prune_Dead_Mode
                       and then not Is_Prune_Reachable (Scoped_Name)
                     then
                        null; -- drop unreferenced proc/func before emit
                     else
                     Register_ALB_Decl(Curr);
                     
                     -- 1. Check da Symbol Table usin' da Branded Name (Module_Procedure)
                     for I in Branded_Name'Range loop
                        H := (H * 33) + U32(Character'Pos(Branded_Name(I)));
                     end loop;
                     
                     Find_Symbol(H, 0, Found, Dummy_Sym);
                     
                     if not Found then
                        -- 2. Register it sae we dinna double-hoist
                        Add_Global_Symbol(H, Type_U64, (Target_None, 0), 0, 0, Local_Success);
                        
                        -- 3. Hoist the TRUE C prototype into the declaration vault.
                        if Target = Backend_C then
                           declare
                              Arg_List    : constant Node_Index := Tree(Name_Node).Right_Child;
                              Arg_Curr    : Node_Index := 0;
                              Param_Count : Natural := 0;
                              Return_Tag  : ALB_Type_Tag := Type_U64;
                           begin
                              if Tree(Curr).Kind = AST_Function_Decl
                                and then Tree(Curr).Token_Index > 0
                              then
                                 Return_Tag := Type_Tag_From_Name (Raw_Lexeme (Tree(Curr).Token_Index));
                              end if;

                              if Arg_List /= 0 and then Tree(Arg_List).Kind = AST_Arg_List then
                                 Arg_Curr := Tree(Arg_List).Left_Child;
                                 while Arg_Curr /= 0 loop
                                    Param_Count := Param_Count + 1;
                                    Arg_Curr := Tree(Arg_Curr).Next_Sibling;
                                 end loop;
                              end if;

                              Transpiler_Native_HAL.Emit_Forward_Declaration
                                (Branded_Name,
                                 Return_Tag,
                                 Param_Count,
                                 Emit_Success);
                           end;
                        end if;
                     end if;
                     end if; -- prune-dead keep
                  end;
                  
               when AST_Import_C =>
                  if Tree(Curr).Left_Child /= 0 then
                     Register_Foreign_Decl (Tree(Curr).Left_Child);
                  end if;


               when AST_DeclareModule =>
                  -- DA FIX: Skip interfaces completely! This guarantees we only hoist
                  -- the real MODULE bodies where the arguments are 100% defined.
                  null;

               when AST_Block_Stmt =>
                  if Tree(Curr).Left_Child > 0 then
                     Hoist_Prototypes (Tree(Curr).Left_Child);
                  end if;

               when AST_Module =>
                  declare
                     M_Name_Node : constant Node_Index := Tree(Curr).Left_Child;
                     M_Tok       : constant Token := Tokens(Tree(M_Name_Node).Token_Index);
                     M_Lex       : constant String := Input_Buffer(M_Tok.Start .. M_Tok.Start + M_Tok.Length - 1);
                     Old_Len     : constant Natural := Active_Module_Len;
                     Old_Name    : constant String(1..64) := Active_Module_Name;
                  begin
                     -- Push Module Scope
                     Active_Module_Len := M_Lex'Length;
                     Active_Module_Name(1..Active_Module_Len) := M_Lex;
                     
                     if Tree(Curr).Right_Child > 0 then
                        Hoist_Prototypes (Tree(Tree(Curr).Right_Child).Left_Child);
                     end if;
                     
                     -- Pop Module Scope
                     Active_Module_Len := Old_Len;
                     Active_Module_Name := Old_Name;
                  end;

               when others => null;
            end case;
            Curr := Tree(Curr).Next_Sibling;
         end loop;
      end Hoist_Prototypes;

      procedure Register_Extended_Features (Pass_Node : Node_Index) is
         Curr : Node_Index := Pass_Node;
      begin
         while Curr /= 0 loop
            case Tree (Curr).Kind is
               when AST_Program =>
                  Register_Extended_Features (Tree (Curr).Left_Child);

               when AST_Module =>
                  declare
                     M_Name_Node : constant Node_Index := Tree (Curr).Left_Child;
                     M_Lex       : constant String := Raw_Lexeme (Tree (M_Name_Node).Token_Index);
                     Old_Len     : constant Natural := Active_Module_Len;
                     Old_Name    : constant String (1 .. 64) := Active_Module_Name;
                  begin
                     Active_Module_Len := M_Lex'Length;
                     Active_Module_Name (1 .. Active_Module_Len) := M_Lex;

                     if Tree (Curr).Right_Child > 0 then
                        Register_Extended_Features
                          (Tree (Tree (Curr).Right_Child).Left_Child);
                     end if;

                     Active_Module_Len := Old_Len;
                     Active_Module_Name := Old_Name;
                  end;

               when AST_Block_Stmt =>
                  if Tree (Curr).Left_Child > 0 then
                     Register_Extended_Features (Tree (Curr).Left_Child);
                  end if;

               when AST_Set_Shoebox_Stmt =>
                  Register_Set_Shoebox_Stmt (Curr, Emit_Success, Emit_Diag);
                  if not Emit_Success or else not Emit_Diag.Success then
                     return;
                  end if;

               when AST_Static_Sprite_Decl =>
                  Register_Static_Sprite_Decl (Curr, Emit_Success, Emit_Diag);
                  if not Emit_Success or else not Emit_Diag.Success then
                     return;
                  end if;

               when AST_Bitmap_Font_Decl =>
                  Register_Bitmap_Font_Decl (Curr, Emit_Success, Emit_Diag);
                  if not Emit_Success or else not Emit_Diag.Success then
                     return;
                  end if;

               when AST_System_Font_Decl =>
                  Register_System_Font_Decl (Curr, Emit_Success, Emit_Diag);
                  if not Emit_Success or else not Emit_Diag.Success then
                     return;
                  end if;

               when AST_Static_Surface_Decl =>
                  Register_Static_Surface_Decl (Curr, Emit_Success, Emit_Diag);
                  if not Emit_Success or else not Emit_Diag.Success then
                     return;
                  end if;

               when AST_Color_Lut_Decl =>
                  Register_Color_Lut_Decl (Curr, Emit_Success, Emit_Diag);
                  if not Emit_Success or else not Emit_Diag.Success then
                     return;
                  end if;

               when AST_Visual_Rule_Decl =>
                  Register_Visual_Rule_Decl (Curr, Emit_Success, Emit_Diag);
                  if not Emit_Success or else not Emit_Diag.Success then
                     return;
                  end if;

               when AST_Render_Viewport_Decl =>
                  Register_Render_Viewport_Decl (Curr, Emit_Success, Emit_Diag);
                  if not Emit_Success or else not Emit_Diag.Success then
                     return;
                  end if;

               when AST_Memory_Firewall_Decl =>
                  Register_Firewall_Decl (Curr, Emit_Success, Emit_Diag);
                  if not Emit_Success or else not Emit_Diag.Success then
                     return;
                  end if;

               when AST_Process_Handle_Decl =>
                  Register_Process_Handle_Decl (Curr, Emit_Success, Emit_Diag);
                  if not Emit_Success or else not Emit_Diag.Success then
                     return;
                  end if;

                when AST_Network_Socket_Decl =>
                   Register_Network_Socket_Decl (Curr, Emit_Success, Emit_Diag);
                   if not Emit_Success or else not Emit_Diag.Success then
                      return;
                   end if;

                when AST_Network_Sniffer_Decl =>
                   Register_Network_Sniffer_Decl (Curr, Emit_Success, Emit_Diag);
                   if not Emit_Success or else not Emit_Diag.Success then
                      return;
                   end if;

                when AST_Markov_Model_Decl =>
                  Register_Markov_Model_Decl (Curr, Emit_Success, Emit_Diag);
                  if not Emit_Success or else not Emit_Diag.Success then
                     return;
                  end if;

               when AST_Neural_Topology_Decl =>
                  Register_Neural_Topology_Decl (Curr, Emit_Success, Emit_Diag);
                  if not Emit_Success or else not Emit_Diag.Success then
                     return;
                  end if;

               when AST_Emotion_Decl =>
                  Register_Emotion_Decl (Curr, Emit_Success, Emit_Diag);
                  if not Emit_Success or else not Emit_Diag.Success then
                     return;
                  end if;

               when AST_Import_DLL | AST_Import_SO | AST_Import_Dylib =>
                  if Tree (Curr).Left_Child > 0 then
                     Register_Foreign_Decl (Tree (Curr).Left_Child);
                  end if;

               when AST_Export_DLL =>
                  Register_Foreign_Export_Decl
                    (Curr, Export_Flavor_DLL, Emit_Success, Emit_Diag);
                  if not Emit_Success or else not Emit_Diag.Success then
                     return;
                  end if;

               when AST_Export_SO =>
                  Register_Foreign_Export_Decl
                    (Curr, Export_Flavor_SO, Emit_Success, Emit_Diag);
                  if not Emit_Success or else not Emit_Diag.Success then
                     return;
                  end if;

               when AST_Export_Dylib =>
                  Register_Foreign_Export_Decl
                    (Curr, Export_Flavor_Dylib, Emit_Success, Emit_Diag);
                  if not Emit_Success or else not Emit_Diag.Success then
                     return;
                  end if;

               when others =>
                  null;
            end case;

            Curr := Tree (Curr).Next_Sibling;
         end loop;

         if Static_Sprite_Count > 0
           or else Static_Surface_Count > 0
           or else Color_Lut_Count > 0
           or else Visual_Rule_Count > 0
           or else Render_Viewport_Count > 0
         then
            Ensure_Static_Graphics_Runtime;
         end if;
      end Register_Extended_Features;

      Top_Curr : Node_Index := Root;
      Top_Tag  : ALB_Type_Tag;
   begin
      Has_On_Tick := False;
      Has_On_Paint := False;
      Has_On_Event := False;
      Has_Create_Window := False;
      Has_Listen := False;
      Native_Uses_Graphics := False;
      First_Graphics_Node := 0;
      FASM16_Uses_Graphics := False;
      FASM16_Uses_Mouse := False;
      Native_ASM_State := ASM_Mode_Off;

      --  Track 8 (C): reset FASM sidecar accumulator state.
      ASM_Side_Used_C := False;
      ASM_Side_Len_C  := 0;
      ASM_Block_Counter_C := 0;

      
      Log ("Running Pass 0.5: SYMBOLIC Normalization...");
      Normalize_Symbolic_Block (Root, Emit_Success, Emit_Diag);

      if not Emit_Success or not Emit_Diag.Success then
         if not Emit_Success and then Emit_Diag.Code = Err_None then
            Emit_Diag.Success := False;
            Emit_Diag.Code := Err_Compiler_AST_Mismatch;
            Emit_Diag.Culprit := (others => ' ');
             Emit_Diag.Culprit_Len := 18;
             Emit_Diag.Culprit (1 .. 18) := "SYMBOLIC_NORMALIZE";
         end if;

         declare
            M_Rec : constant Source_Map_Record := Source_Map (Emit_Diag.Error_Line);
            FName : constant String := Include_Vault (M_Rec.File_ID) (1 .. Include_Lens (M_Rec.File_ID));
         begin
            ALB_Oracle.Render_Consultation
              (Input_Buffer (1 .. Input_Len),
               Emit_Diag.Error_Line,
               M_Rec.Rel_Line,
               Emit_Diag.Error_Col,
               FName,
               Emit_Diag.Code,
               Emit_Diag.Culprit (1 .. Emit_Diag.Culprit_Len));
         end;
         return;
      end if;

      Log ("Running Pass 0.75: COMPTIME Preload...");
      Preload_Comptime_Blocks (Root, Emit_Success, Emit_Diag);

      if not Emit_Success or not Emit_Diag.Success then
         if not Emit_Success and then Emit_Diag.Code = Err_None then
            Emit_Diag.Success := False;
            Emit_Diag.Code := Err_Compiler_AST_Mismatch;
            Emit_Diag.Culprit := (others => ' ');
            Emit_Diag.Culprit_Len := 16;
            Emit_Diag.Culprit (1 .. 16) := "COMPTIME_PRELOAD";
         end if;

         declare
            M_Rec : constant Source_Map_Record := Source_Map(Emit_Diag.Error_Line);
            FName : constant String := Include_Vault(M_Rec.File_ID)(1 .. Include_Lens(M_Rec.File_ID));
         begin
            ALB_Oracle.Render_Consultation
              (Input_Buffer (1 .. Input_Len),
               Emit_Diag.Error_Line,
               M_Rec.Rel_Line,
               Emit_Diag.Error_Col,
               FName,
               Emit_Diag.Code,
               Emit_Diag.Culprit (1 .. Emit_Diag.Culprit_Len));
         end;
         return;
      end if;

      Comptime_Preload_Done := True;

      if Prune_Dead_Mode then
         Log ("Running Pass 0.9: prune-dead reachability...");
         Compute_Prune_Reachability (Root);
      end if;

      -- PASS 1: HOIST PROTOTYPES (Tell C whit's comin' so it disna boke)
      Log ("Running Pass 1: Prototype Hoisting...");
      Hoist_Prototypes (Root);
      Transpiler_Native_HAL.Emit_Newline (Emit_Success);

      Log ("Running Pass 1.25: Backend Feature Registration...");
      Register_Extended_Features (Root);
      if not Emit_Success or else not Emit_Diag.Success then
         if not Emit_Success and then Emit_Diag.Code = Err_None then
            Emit_Diag.Success := False;
            Emit_Diag.Code := Err_Compiler_AST_Mismatch;
            Emit_Diag.Culprit := (others => ' ');
            Emit_Diag.Culprit_Len := 16;
            Emit_Diag.Culprit (1 .. 16) := "BACKEND_FEATURES";
         end if;

         declare
            M_Rec : constant Source_Map_Record := Source_Map (Emit_Diag.Error_Line);
            FName : constant String := Include_Vault (M_Rec.File_ID) (1 .. Include_Lens (M_Rec.File_ID));
         begin
            ALB_Oracle.Render_Consultation
              (Input_Buffer (1 .. Input_Len),
               Emit_Diag.Error_Line,
               M_Rec.Rel_Line,
               Emit_Diag.Error_Col,
               FName,
               Emit_Diag.Code,
               Emit_Diag.Culprit (1 .. Emit_Diag.Culprit_Len));
         end;
         return;
      end if;

      if Target = Backend_C then
         Log ("Running Pass 1.5: Forging C Extended Runtime...");
         Emit_C_Extended_Runtime (Emit_Success, Emit_Diag);
         if not Emit_Success or not Emit_Diag.Success then
            if not Emit_Success and then Emit_Diag.Code = Err_None then
               Emit_Diag.Success := False;
               Emit_Diag.Code := Err_Compiler_AST_Mismatch;
               Emit_Diag.Culprit := (others => ' ');
               Emit_Diag.Culprit_Len := 18;
               Emit_Diag.Culprit (1 .. 18) := "C_EXTENDED_RUNTIME";
            end if;

            declare
               M_Rec : constant Source_Map_Record := Source_Map (Emit_Diag.Error_Line);
               FName : constant String := Include_Vault (M_Rec.File_ID) (1 .. Include_Lens (M_Rec.File_ID));
            begin
               ALB_Oracle.Render_Consultation
                 (Input_Buffer (1 .. Input_Len),
                  Emit_Diag.Error_Line,
                  M_Rec.Rel_Line,
                  Emit_Diag.Error_Col,
                  FName,
                  Emit_Diag.Code,
                  Emit_Diag.Culprit (1 .. Emit_Diag.Culprit_Len));
            end;
            return;
         end if;
      end if;

      -- PASS 2: GENERATE LOGIC BODIES (Build da actual code)
      Log ("Running Pass 2: Logic Generation...");
      while Top_Curr /= 0 loop
         Walk_AST (Top_Curr, 1, Top_Tag, Emit_Success, Emit_Diag);
         if not Emit_Success or not Emit_Diag.Success then
            if not Emit_Success and then Emit_Diag.Code = Err_None then
               Emit_Diag.Success := False;
               Emit_Diag.Code := Err_Compiler_AST_Mismatch;
               Emit_Diag.Culprit := (others => ' ');
               Emit_Diag.Culprit_Len := 14;
               Emit_Diag.Culprit (1 .. 14) := "LOGIC_EMISSION";
            end if;

            declare
               M_Rec : constant Source_Map_Record := Source_Map(Emit_Diag.Error_Line);
               FName : constant String := Include_Vault(M_Rec.File_ID)(1 .. Include_Lens(M_Rec.File_ID));
            begin
               ALB_Oracle.Render_Consultation
                 (Input_Buffer (1 .. Input_Len), Emit_Diag.Error_Line, M_Rec.Rel_Line, Emit_Diag.Error_Col, FName, Emit_Diag.Code, Emit_Diag.Culprit (1 .. Emit_Diag.Culprit_Len));
            end;
            return;
         end if;

         Top_Curr := Tree (Top_Curr).Next_Sibling;
      end loop;

      Log ("Running Phase 3: Emitting COMPTIME Bakes...");
      Emit_Comptime_Bakes (Emit_Success, Emit_Diag);
      if not Emit_Success or not Emit_Diag.Success then
         if not Emit_Success and then Emit_Diag.Code = Err_None then
            Emit_Diag.Success := False;
            Emit_Diag.Code := Err_Compiler_AST_Mismatch;
            Emit_Diag.Culprit := (others => ' ');
            Emit_Diag.Culprit_Len := 13;
            Emit_Diag.Culprit (1 .. 13) := "COMPTIME_BAKE";
         end if;

         declare
            M_Rec : constant Source_Map_Record := Source_Map(Emit_Diag.Error_Line);
            FName : constant String := Include_Vault(M_Rec.File_ID)(1 .. Include_Lens(M_Rec.File_ID));
         begin
            ALB_Oracle.Render_Consultation
              (Input_Buffer (1 .. Input_Len), Emit_Diag.Error_Line, M_Rec.Rel_Line, Emit_Diag.Error_Col, FName, Emit_Diag.Code, Emit_Diag.Culprit (1 .. Emit_Diag.Culprit_Len));
         end;
         return;
      end if;

      Log ("Running Phase 4: Forging Chrono Vault...");
      Emit_Chrono_Runtime (Emit_Success, Emit_Diag);
      if not Emit_Success or not Emit_Diag.Success then
         if not Emit_Success and then Emit_Diag.Code = Err_None then
            Emit_Diag.Success := False;
            Emit_Diag.Code := Err_Compiler_AST_Mismatch;
            Emit_Diag.Culprit := (others => ' ');
            Emit_Diag.Culprit_Len := 12;
            Emit_Diag.Culprit (1 .. 12) := "CHRONO_VAULT";
         end if;

         declare
            M_Rec : constant Source_Map_Record := Source_Map(Emit_Diag.Error_Line);
            FName : constant String := Include_Vault(M_Rec.File_ID)(1 .. Include_Lens(M_Rec.File_ID));
         begin
            ALB_Oracle.Render_Consultation
              (Input_Buffer (1 .. Input_Len), Emit_Diag.Error_Line, M_Rec.Rel_Line, Emit_Diag.Error_Col, FName, Emit_Diag.Code, Emit_Diag.Culprit (1 .. Emit_Diag.Culprit_Len));
         end;
         return;
      end if;

      Log ("Running Phase 4.5: Forging FASM Extended Runtime...");
      Emit_FASM_Extended_Runtime (Emit_Success, Emit_Diag);
      if not Emit_Success or not Emit_Diag.Success then
         if not Emit_Success and then Emit_Diag.Code = Err_None then
            Emit_Diag.Success := False;
            Emit_Diag.Code := Err_Compiler_AST_Mismatch;
            Emit_Diag.Culprit := (others => ' ');
            Emit_Diag.Culprit_Len := 21;
            Emit_Diag.Culprit (1 .. 21) := "FASM_EXTENDED_RUNTIME";
         end if;

         declare
            M_Rec : constant Source_Map_Record := Source_Map(Emit_Diag.Error_Line);
            FName : constant String := Include_Vault(M_Rec.File_ID)(1 .. Include_Lens(M_Rec.File_ID));
         begin
            ALB_Oracle.Render_Consultation
              (Input_Buffer (1 .. Input_Len), Emit_Diag.Error_Line, M_Rec.Rel_Line, Emit_Diag.Error_Col, FName, Emit_Diag.Code, Emit_Diag.Culprit (1 .. Emit_Diag.Culprit_Len));
         end;
         return;
      end if;

      -- DA NEW FIX: Inject empty callbacks if the user didn't provide them natively!
      if not Has_On_Tick then
         Transpiler_Native_HAL.Emit_Procedure_Decl_Start ("ALB_ON_TICK", Emit_Success);
         Transpiler_Native_HAL.Emit_Procedure_End ("ALB_ON_TICK", Emit_Success);
      end if;
      
      if not Has_On_Paint then
         Transpiler_Native_HAL.Emit_Procedure_Decl_Start ("ALB_ON_PAINT", Emit_Success);
         Transpiler_Native_HAL.Emit_Procedure_End ("ALB_ON_PAINT", Emit_Success);
      end if;

      if (Target = Backend_FASM or else Target = Backend_FASM16) and then not Has_On_Event then
         Transpiler_Native_HAL.Emit_Procedure_Decl_Start ("ALB_ON_EVENT", Emit_Success);
         Transpiler_Native_HAL.Emit_Procedure_End ("ALB_ON_EVENT", Emit_Success);
      end if;

      -- Terminal lean event loop for FASM16. LISTEN jumps here; ON TICK/PAINT
      -- without LISTEN falls through into the same loop at program end.
      if Target = Backend_FASM16 and then (Has_Listen or else Has_On_Tick or else Has_On_Paint) then
         Transpiler_Native_HAL.Emit_Raw ("ALB16_EVENT_LOOP:", Emit_Success);
         Transpiler_Native_HAL.Emit_Newline (Emit_Success);
         if FASM16_Uses_Graphics then
            Transpiler_Native_HAL.Emit_Raw ("  call ALB16_Input_Update", Emit_Success);
            Transpiler_Native_HAL.Emit_Newline (Emit_Success);
         end if;
         Transpiler_Native_HAL.Emit_Raw ("  call ALB_ON_EVENT", Emit_Success);
         Transpiler_Native_HAL.Emit_Newline (Emit_Success);
         Transpiler_Native_HAL.Emit_Raw ("  call ALB_ON_TICK", Emit_Success);
         Transpiler_Native_HAL.Emit_Newline (Emit_Success);
         if FASM16_Uses_Graphics then
            Transpiler_Native_HAL.Emit_Raw ("  call ALB16_GFX_Frame_Begin", Emit_Success);
            Transpiler_Native_HAL.Emit_Newline (Emit_Success);
         end if;
         Transpiler_Native_HAL.Emit_Raw ("  call ALB_ON_PAINT", Emit_Success);
         Transpiler_Native_HAL.Emit_Newline (Emit_Success);
         if FASM16_Uses_Graphics then
            if FASM16_Uses_Mouse then
               Transpiler_Native_HAL.Emit_Raw ("  call ALB16_Mouse_Draw_Cursor", Emit_Success);
               Transpiler_Native_HAL.Emit_Newline (Emit_Success);
            end if;
            Transpiler_Native_HAL.Emit_Raw ("  call ALB16_GFX_Present", Emit_Success);
            Transpiler_Native_HAL.Emit_Newline (Emit_Success);
         end if;
         Transpiler_Native_HAL.Emit_Raw ("  mov ax, 16", Emit_Success);
         Transpiler_Native_HAL.Emit_Newline (Emit_Success);
         Transpiler_Native_HAL.Emit_Raw ("  xor dx, dx", Emit_Success);
         Transpiler_Native_HAL.Emit_Newline (Emit_Success);
         Transpiler_Native_HAL.Emit_Raw ("  call ALB16_Delay", Emit_Success);
         Transpiler_Native_HAL.Emit_Newline (Emit_Success);
         if FASM16_Uses_Graphics then
            Transpiler_Native_HAL.Emit_Raw ("  mov ax, 41", Emit_Success);
            Transpiler_Native_HAL.Emit_Newline (Emit_Success);
            Transpiler_Native_HAL.Emit_Raw ("  call ALB_Key_State", Emit_Success);
            Transpiler_Native_HAL.Emit_Newline (Emit_Success);
            Transpiler_Native_HAL.Emit_Raw ("  or ax, ax", Emit_Success);
            Transpiler_Native_HAL.Emit_Newline (Emit_Success);
            Transpiler_Native_HAL.Emit_Raw ("  jnz ALB16_EVENT_EXIT", Emit_Success);
            Transpiler_Native_HAL.Emit_Newline (Emit_Success);
         else
            Transpiler_Native_HAL.Emit_Raw ("  mov ah, 01h", Emit_Success);
            Transpiler_Native_HAL.Emit_Newline (Emit_Success);
            Transpiler_Native_HAL.Emit_Raw ("  int 16h", Emit_Success);
            Transpiler_Native_HAL.Emit_Newline (Emit_Success);
            Transpiler_Native_HAL.Emit_Raw ("  jz ALB16_EVENT_LOOP", Emit_Success);
            Transpiler_Native_HAL.Emit_Newline (Emit_Success);
            Transpiler_Native_HAL.Emit_Raw ("  cmp al, 27", Emit_Success);
            Transpiler_Native_HAL.Emit_Newline (Emit_Success);
            Transpiler_Native_HAL.Emit_Raw ("  je ALB16_EVENT_EXIT", Emit_Success);
            Transpiler_Native_HAL.Emit_Newline (Emit_Success);
            Transpiler_Native_HAL.Emit_Raw ("  mov ah, 00h", Emit_Success);
            Transpiler_Native_HAL.Emit_Newline (Emit_Success);
            Transpiler_Native_HAL.Emit_Raw ("  int 16h", Emit_Success);
            Transpiler_Native_HAL.Emit_Newline (Emit_Success);
         end if;
         Transpiler_Native_HAL.Emit_Raw ("  jmp ALB16_EVENT_LOOP", Emit_Success);
         Transpiler_Native_HAL.Emit_Newline (Emit_Success);
         Transpiler_Native_HAL.Emit_Raw ("ALB16_EVENT_EXIT:", Emit_Success);
         Transpiler_Native_HAL.Emit_Newline (Emit_Success);
         if FASM16_Uses_Graphics then
            Transpiler_Native_HAL.Emit_Raw ("  call ALB16_GFX_Shutdown", Emit_Success);
            Transpiler_Native_HAL.Emit_Newline (Emit_Success);
         end if;
      end if;

      Log ("Step 4: Finalizing Code Generation...");
      Transpiler_Native_HAL.Emit_Program_End (Emit_Success);
      
      Log ("Step 5: Writing Output File and Flushing...");
      Transpiler_Native_HAL.Flush_To_File (Output_File (1 .. Output_Flen), Emit_Success);

      --  Track 8 (C): write FASM sidecar next to the .c output (if used).
      if Emit_Success
        and then Target = Backend_C
        and then ASM_Side_Used_C
        and then ASM_Side_Len_C > 0
      then
         declare
            Base_Path : String renames Output_File (1 .. Output_Flen);
            Dot_Pos   : Integer := Base_Path'Last + 1;
            Side_File : Ada.Text_IO.File_Type;
         begin
            for I in reverse Base_Path'Range loop
               if Base_Path (I) = '.' then
                  Dot_Pos := I;
                  exit;
               end if;
               exit when Base_Path (I) = '/' or else Base_Path (I) = '\';
            end loop;

            declare
               Stem : constant String :=
                 (if Dot_Pos > Base_Path'First
                  then Base_Path (Base_Path'First .. Dot_Pos - 1)
                  else Base_Path);
               Side_Path : constant String := Stem & "_asm.asm";
            begin
               begin
                  Ada.Text_IO.Create
                    (Side_File, Ada.Text_IO.Out_File, Side_Path);
                  Ada.Text_IO.Put
                    (Side_File,
                     ASM_Side_Buffer_C (1 .. ASM_Side_Len_C));
                  Ada.Text_IO.Close (Side_File);
                  Log ("Track 8: wrote FASM sidecar " & Side_Path);
               exception
                  when others =>
                     Log ("Track 8: WARNING - failed to write FASM sidecar " &
                          Side_Path);
               end;
            end;
         end;
      end if;

      if Emit_Success then
         Log ("SUCCESS: " & Output_File (1 .. Output_Flen) & " transpiled and flushed!");
         Compilation_Succeeded := True;

         if Build_Mode and then Final_Dir_Len > 0 then
            declare
               Stage_OK : Boolean := True;
            begin
               case Target is
                  when Backend_FASM =>
                     Log ("Step 6: Staging FASM runtime dependencies...");
                     Stage_FASM_Dependencies (Final_Dir (1 .. Final_Dir_Len), Stage_OK);

                     if Stage_OK then
                        Log ("Step 7: Running fasm...");
                        Stage_OK :=
                          Run_FASM_Pass
                            (Final_Dir (1 .. Final_Dir_Len),
                             Output_File (1 .. Output_Flen));
                     end if;

                     if Stage_OK then
                        Log ("SUCCESS: FASM build folder is staged and compiled.");
                     else
                        Compilation_Succeeded := False;
                        Log ("FATAL: FASM build pass failed.");
                     end if;

                  when Backend_FASM16 =>
                     Log ("Step 6: Running fasm...");
                     Stage_OK :=
                       Run_FASM_Pass
                         (Final_Dir (1 .. Final_Dir_Len),
                          Output_File (1 .. Output_Flen));

                     if Stage_OK then
                        Log ("SUCCESS: FASM16 build folder is staged and compiled.");
                     else
                        Compilation_Succeeded := False;
                        Log ("FATAL: FASM16 build pass failed.");
                     end if;

                  when Backend_C =>
                     Log ("Step 6: Staging C runtime dependencies...");
                     Stage_C_Dependencies (Final_Dir (1 .. Final_Dir_Len), Stage_OK);
                     if Stage_OK then
                        Stage_C_Build_Scripts
                          (Final_Dir (1 .. Final_Dir_Len),
                           Output_File (1 .. Output_Flen),
                           Stage_OK);
                     end if;

                     if Stage_OK then
                        if C_Shared_Library_Mode_Active then
                           Log ("SUCCESS: C build folder staged with source, dependencies, and shared-library build scripts.");
                        else
                           Log ("SUCCESS: C build folder staged with source and dependencies.");
                        end if;
                     else
                        Compilation_Succeeded := False;
                        Log ("FATAL: C dependency staging failed.");
                     end if;

                  when others =>
                     null;
               end case;
            end;
         end if;
      else
         Log ("FATAL: Disk Write Failure.");
      end if;
   end;

   Log ("=== Compilation Complete ===");
   Close_Log;

   if Metrics_Requested then
      Code_Information.Reset_Metrics;
      for I in 1 .. Include_Count loop
         Code_Information.Scan_Target(Include_Vault(I)(1 .. Include_Lens(I)));
      end loop;
      Code_Information.Print_Metrics;
   end if;

   if Compilation_Succeeded then
      Ada.Command_Line.Set_Exit_Status (Ada.Command_Line.Success);
   else
      Ada.Command_Line.Set_Exit_Status (Ada.Command_Line.Failure);
   end if;

end ALBT;
