                     elsif Upper_Name = "F64" or else Upper_Name = "REAL" then
                        Transpiler_Native_HAL.Emit_Raw ("ALB_Double_As_U64(" & PName & ")", Success);
                     else
                        Transpiler_Native_HAL.Emit_Raw ("(uint64_t)" & PName, Success);
