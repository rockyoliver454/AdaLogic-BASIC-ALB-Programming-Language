   function FASM_Safe_Symbol (Name : String) return String is
   begin
      if (Target = Backend_FASM or else Target = Backend_FASM16)
        and then FASM_Needs_Symbol_Prefix (Name)
      then
         return "ALB_USER_" & Name;
      else
         return Name;
      end if;
   end FASM_Safe_Symbol;


   
   function Scoped_Lexeme (Lexeme : String) return String is
   begin
      if Active_Module_Len > 0 then
         return FASM_Safe_Symbol
           (Active_Module_Name (1 .. Active_Module_Len) & "_" & Lexeme);
      else
         return FASM_Safe_Symbol (Lexeme);
      end if;
   end Scoped_Lexeme;

   

   
   function Resolve_Symbol
     (Lexeme         : String;
      Enforce_Tag    : ALB_Type_Tag;
      Enforce_Struct : Natural;
      Is_Array       : Boolean;
      Registered_Tag : out ALB_Type_Tag) return Symbol_Record
   is
      H             : U32 := 5381;
      Sym           : Symbol_Record;
      Found         : Boolean;
      Local_Success : Boolean;
      Final_Tag     : ALB_Type_Tag;
      
      -- DA MODULE PREFIXER ARMOR
      Target_Lex    : String (1 .. 128) := (others => ' ');
      Target_Len    : Natural := 0;
   begin
      -- Automatically brand variables wi' their Module Name!
      -- Route every symbol through the one true naming gate.
      declare
         Safe_Name : constant String := Scoped_Lexeme (Lexeme);
      begin
         if Safe_Name'Length > Target_Lex'Length then
            Emit_Success := False;
            Registered_Tag := Type_None;
            return Sym;
         end if;

         Target_Lex (1 .. Safe_Name'Length) := Safe_Name;
         Target_Len := Safe_Name'Length;
      end;
      

      for I in 1 .. Target_Len loop
         H := (H * 33) + U32 (Character'Pos (Target_Lex (I)));
      end loop;

      Find_Symbol (H, Current_Scope, Found, Sym);
      if Found then
         Registered_Tag := Sym.Tag;
         return Sym;
      end if;

      if Enforce_Tag = Type_None then
         Final_Tag := Type_U64;
      else
         Final_Tag := Enforce_Tag;
      end if;

      if Current_Scope = 0 then
         Add_Global_Symbol(H, Final_Tag, (Target_None, 0), Next_Var_Addr, Enforce_Struct, Local_Success);
         Sym := (H, Final_Tag, (Target_None, 0), Class_Global, Next_Var_Addr, 0, Enforce_Struct, 0, True);

         -- Universal HAL memory declaration using DA TARGET LEX!
         if Is_Array then
            -- DA FIX: STRICT AST handles its ain multidimensional bounds! Do naething!
            null;
         else
            -- DA NEW STRUCT FIX FOR C!
            if Enforce_Struct > 0 and Target = Backend_C then
               Transpiler_Native_HAL.Emit_Raw (Get_Struct_Name(Enforce_Struct) & " " & Target_Lex (1 .. Target_Len) & " = {0};", Emit_Success);
               Transpiler_Native_HAL.Emit_Newline (Emit_Success);
            else
               if Target = Backend_FASM then Transpiler_Native_HAL.Set_Global_Buffer_Mode(True); end if;
               Transpiler_Native_HAL.Emit_Global_Var_Decl (Target_Lex (1 .. Target_Len), Final_Tag, Emit_Success);
               if Target = Backend_FASM then Transpiler_Native_HAL.Set_Global_Buffer_Mode(False); end if;
            end if;
         end if;
         
         declare
            Struct_Fields : Natural := 0;
            Struct_OK     : Boolean := False;
         begin
            if Enforce_Struct > 0 then
               Get_Struct_Field_Count(Enforce_Struct, Struct_Fields, Struct_OK);
               if not Struct_OK or else Struct_Fields < 4 then
                  Struct_Fields := 4;
                  Struct_OK := True;
               end if;
            end if;
            
            if Struct_OK and then Struct_Fields > 1 then
               Next_Var_Addr := Next_Var_Addr + U64(Struct_Fields * 8);
            elsif Final_Tag = Type_Pure or else Final_Tag = Type_U128 then
               Next_Var_Addr := Next_Var_Addr + 16;
            else
               Next_Var_Addr := Next_Var_Addr + 8;
            end if;
         end;
      else
         declare
            Struct_Fields      : Natural := 0;
            Struct_OK          : Boolean := False;
            FASM16_Local_Bytes : Natural := 0;
         begin
            if Target = Backend_FASM16 and then not Is_Array then
               if Enforce_Struct > 0 then
                  FASM16_Local_Bytes := Get_Struct_Size_Bytes (Enforce_Struct);
               else
                  case Final_Tag is
                     when Type_U8 | Type_S8 | Type_HW8 | Type_Boolean | Type_Char =>
                        FASM16_Local_Bytes := 1;
                     when Type_U16 | Type_S16 | Type_HW16 | Type_Binary | Type_Reference =>
                        FASM16_Local_Bytes := 2;
                     when Type_U32 | Type_S32 | Type_HW32 | Type_Pure =>
                        FASM16_Local_Bytes := 4;
                     when others =>
                        FASM16_Local_Bytes := 2;
                  end case;
               end if;

               Local_Offset := Local_Offset + Integer (FASM16_Local_Bytes);
            else
               if Enforce_Struct > 0 then
                  Get_Struct_Field_Count(Enforce_Struct, Struct_Fields, Struct_OK);
                  if not Struct_OK or else Struct_Fields < 4 then
                     Struct_Fields := 4;
                     Struct_OK := True;
                  end if;
               end if;
               if Struct_OK and then Struct_Fields > 1 then
                  Local_Offset := Local_Offset + (Struct_Fields * 8);
               else
                  Local_Offset := Local_Offset + 8;
               end if;
            end if;

            Add_Local_Symbol (H, Final_Tag, (Target_None, 0), -Local_Offset, Enforce_Struct, Current_Scope, Local_Success);
            Sym := (H, Final_Tag, (Target_None, 0), Class_Local, 0, -Local_Offset, Enforce_Struct, Current_Scope, True);

            -- Emit local variables using DA TARGET LEX!
            if Target = Backend_FASM16 and then not Is_Array then
               null;
            elsif Enforce_Struct > 0 and Target = Backend_C then
               Transpiler_Native_HAL.Emit_Raw (Get_Struct_Name(Enforce_Struct) & " " & Target_Lex (1 .. Target_Len) & " = {0};", Emit_Success);
               Transpiler_Native_HAL.Emit_Newline (Emit_Success);
            elsif not Is_Array then -- DA FIX: Only emit if it's NAE an array!
               Transpiler_Native_HAL.Emit_Var_Decl (Target_Lex (1 .. Target_Len), Final_Tag, Emit_Success);
            end if;
         end;
      end if;

      Registered_Tag := Final_Tag;
      return Sym;
   end Resolve_Symbol;

