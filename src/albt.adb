                                 Transpiler_Native_HAL.Emit_Raw ("  setnp dl", Success);
                                 Transpiler_Native_HAL.Emit_Newline (Success);
                                 Transpiler_Native_HAL.Emit_Raw ("  sete al", Success);
                                 Transpiler_Native_HAL.Emit_Newline (Success);
                                 Transpiler_Native_HAL.Emit_Raw ("  and al, dl", Success);
                                 Transpiler_Native_HAL.Emit_Newline (Success);
