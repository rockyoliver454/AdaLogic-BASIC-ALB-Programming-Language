                     Fail_Node (Node, Err_Type_Conflict, "WRITE_PROCESS_MEMORY", Success, Diag);
                     return;
                  end if;

                  if Target = Backend_C then
                     -- Track 7 (C): scalar/buffer write via WriteProcessMemory.
                     Ensure_Process_Runtime_C;

