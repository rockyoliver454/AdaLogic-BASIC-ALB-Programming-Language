            when AST_Choose =>
               declare
                  Dummy_Node : Node_Index := Tree(Node).Right_Child;
               begin
                  if Target = Backend_FASM then
                     -- 1. Evaluate Condition -> rax, then push it
                     Walk_AST(Tree(Node).Left_Child, Depth + 1, Right_Tag, Success, Diag);
                     Transpiler_Native_HAL.Emit_Raw("  push rax", Success); Transpiler_Native_HAL.Emit_Newline(Success);
                     
                     -- 2. Evaluate True Value -> rax, then push it
                     Walk_AST(Tree(Dummy_Node).Left_Child, Depth + 1, Right_Tag, Success, Diag);
                     Transpiler_Native_HAL.Emit_Raw("  push rax", Success); Transpiler_Native_HAL.Emit_Newline(Success);
                     
                     -- 3. Evaluate False Value -> rax, move to rcx
                     Walk_AST(Tree(Dummy_Node).Right_Child, Depth + 1, Right_Tag, Success, Diag);
                     Transpiler_Native_HAL.Emit_Raw("  mov rcx, rax", Success); Transpiler_Native_HAL.Emit_Newline(Success);
                     
                     -- 4. Pop the True Value and Condition back oot
                     Transpiler_Native_HAL.Emit_Raw("  pop rbx", Success); Transpiler_Native_HAL.Emit_Newline(Success);
                     Transpiler_Native_HAL.Emit_Raw("  pop rax", Success); Transpiler_Native_HAL.Emit_Newline(Success);
                     
                     -- 5. Invoke the Mask Macro cleanly wi' pure registers! (Result gangs in rax)
                     Transpiler_Native_HAL.Emit_Raw("  ALB_MASK_OP rax, rax, rbx, rcx", Success); Transpiler_Native_HAL.Emit_Newline(Success);
                  elsif Target = Backend_FASM16 then
                     declare
                        NImg        : constant String := Node_Index'Image (Node);
                        NID         : constant String := NImg (NImg'First + 1 .. NImg'Last);
                        True_Label  : constant String := "ALB16_CHOOSE_TRUE_" & NID;
                        End_Label   : constant String := "ALB16_CHOOSE_END_" & NID;
                     begin
                        -- DOS path: lower CHOOSE to an explicit branch so the selected
                        -- expression leaves its value naturally in DX:AX.
                        Walk_AST (Tree (Node).Left_Child, Depth + 1, Right_Tag, Success, Diag);
                        if not Success then
                           return;
                        end if;

                        Transpiler_Native_HAL.Emit_Raw ("  or ax, dx", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  jnz " & True_Label, Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);

                        Walk_AST (Tree (Dummy_Node).Right_Child, Depth + 1, Right_Tag, Success, Diag);
                        if not Success then
                           return;
                        end if;

                        Transpiler_Native_HAL.Emit_Raw ("  jmp " & End_Label, Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw (True_Label & ":", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);

                        Walk_AST (Tree (Dummy_Node).Left_Child, Depth + 1, Right_Tag, Success, Diag);
                        if not Success then
                           return;
                        end if;

                        Transpiler_Native_HAL.Emit_Raw (End_Label & ":", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                     end;
                  else
                     Transpiler_Native_HAL.Emit_Branchless_Condition_Start(Success);
                     Walk_AST(Tree(Node).Left_Child, Depth + 1, Right_Tag, Success, Diag);
                     Transpiler_Native_HAL.Emit_Branchless_Mask_Op(Success);
                     Walk_AST(Tree(Dummy_Node).Left_Child, Depth + 1, Right_Tag, Success, Diag);
                     Transpiler_Native_HAL.Emit_Comma(Success);
                     Walk_AST(Tree(Dummy_Node).Right_Child, Depth + 1, Right_Tag, Success, Diag);
                     Transpiler_Native_HAL.Emit_Expression_Close(Success);
                  end if;
                  Out_Tag := Infer_Type_Tag (Node);
