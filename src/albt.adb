            when AST_Struct_Decl =>
               declare
                  Name_Tok     : Token := Tokens (Tree (Tree (Node).Left_Child).Token_Index);
                  Name         : String := Input_Buffer (Name_Tok.Start .. Name_Tok.Start + Name_Tok.Length - 1);
                  H            : U32 := 5381;
                  SID          : Natural := 0;
                  Field_Node   : Node_Index := 0;
                  Struct_Bytes : Natural := 0;
               begin
                  for I in Name'Range loop
                     H := (H * 33) + U32 (Character'Pos (Name (I)));
                  end loop;

                  Register_Struct (H, SID, Success);
                  if not Success then
                     return;
                  end if;

                  Register_Struct_Name (SID, Name);

                  Transpiler_Native_HAL.Emit_Struct_Start (Name, Success);
                  if not Success then
                     return;
                  end if;

                  Field_Node := Tree (Tree (Node).Right_Child).Left_Child;

                  while Field_Node > 0 loop
                     declare
                        FTok     : Token := Tokens (Tree (Tree (Field_Node).Left_Child).Token_Index);
                        FLex     : String := Input_Buffer (FTok.Start .. FTok.Start + FTok.Length - 1);
                        FH       : U32 := 5381;
                        Type_Idx : Natural := Tree (Field_Node).Token_Index;
                        F_Tag    : ALB_Type_Tag := Type_U64;
                        F_Size   : Natural := 8;
                     begin
                        for I in FLex'Range loop
                           FH := (FH * 33) + U32 (Character'Pos (FLex (I)));
                        end loop;

                        if Type_Idx /= 0 then
                           declare
                              T_Tok : Token := Tokens (Type_Idx);
                              T_Raw : String := Input_Buffer (T_Tok.Start .. T_Tok.Start + T_Tok.Length - 1);
                              C_Len : Natural := 0;
                              C_Str : String (1 .. 64) := (others => ' ');
                           begin
                              for I in T_Raw'Range loop
                                 if (T_Raw (I) >= 'A' and then T_Raw (I) <= 'Z')
                                   or else (T_Raw (I) >= 'a' and then T_Raw (I) <= 'z')
                                   or else (T_Raw (I) >= '0' and then T_Raw (I) <= '9')
                                   or else T_Raw (I) = '_'
                                 then
                                    C_Len := C_Len + 1;
                                    C_Str (C_Len) := T_Raw (I);
                                 end if;
                              end loop;

                              if C_Len > 0 then
                                 declare
                                    T_Str : String := C_Str (1 .. C_Len);
                                 begin
                                    if T_Str = "PURE" or else T_Str = "RATIONAL" then F_Tag := Type_Pure;
                                    elsif T_Str = "BINARY" then F_Tag := Type_Binary;
                                    elsif T_Str = "STRING" then F_Tag := Type_Binary;
                                    elsif T_Str = "BOOLEAN" or else T_Str = "BOOL" then F_Tag := Type_Boolean;
                                    elsif T_Str = "U8" then F_Tag := Type_U8;
                                    elsif T_Str = "HW8" then F_Tag := Type_HW8;
                                    elsif T_Str = "HW16" then F_Tag := Type_HW16;
                                    elsif T_Str = "HW32" then F_Tag := Type_HW32;
                                    elsif T_Str = "U16" then F_Tag := Type_U16;
                                    elsif T_Str = "U32" then F_Tag := Type_U32;
                                    elsif T_Str = "U64" then F_Tag := Type_U64;
                                    elsif T_Str = "U128" then F_Tag := Type_U128;
                                    elsif T_Str = "S32" then F_Tag := Type_S32;
                                    elsif T_Str = "F32" or else T_Str = "SINGLE" then F_Tag := Type_F32;
                                    elsif T_Str = "F64" or else T_Str = "REAL" then F_Tag := Type_F64;
                                    end if;
                                 end;
                              end if;
                           end;
                        end if;

                        --  if Target = Backend_FASM16 then
                        --     F_Size := FASM16_Storage_Bytes (F_Tag);
                        --  else
                        --     F_Size := ALB_Size_Bytes (F_Tag);
                        --  end if;
                        if Target = Backend_FASM16 then
                            F_Size := FASM16_Storage_Bytes (F_Tag);
                         elsif Target = Backend_FASM and then F_Tag = Type_Pure then
                            F_Size := 8;
                         else
                            F_Size := ALB_Size_Bytes (F_Tag);
                         end if;
                        
                         if Target = Backend_FASM16
                           and then not FASM16_Scalar_Supported (F_Tag)
                         then
                            Fail_Node
                              (Node,
                               Err_Type_Conflict,
                               "FASM16 struct fields could not infer a usable type.",
                               Success,
                               Diag);
                            return;
                         end if;

                        Add_Struct_Field (SID, FH, F_Tag, F_Size, Success);
                        if not Success then
                           return;
                        end if;

                        Struct_Bytes := Struct_Bytes + F_Size;

                        Transpiler_Native_HAL.Emit_Struct_Field (FLex, F_Tag, Success);
                        if not Success then
                           return;
                        end if;
                     end;

                     Field_Node := Tree (Field_Node).Next_Sibling;
                  end loop;

                  Struct_Size_Vault (SID) := Struct_Bytes;

                  Transpiler_Native_HAL.Emit_Struct_End (Name, Success);
                  if not Success then
                     return;
                  end if;

                  Log ("   -> FORGE: Struct '" & Name & "' registered wi' ID " & SID'Image);
               end;
            
            when AST_Simd_Intrinsic =>
               declare
                  Tok      : Token := Tokens (Tree (Node).Token_Index);
                  Arg_List : Node_Index := Tree (Node).Left_Child;
                  Arg_Node : Node_Index := 0;
               begin
                  if Arg_List > 0 then 
                     Arg_Node := Tree(Arg_List).Left_Child; 
                  end if;
                  
                  if Target = Backend_FASM or else Target = Backend_FASM16 then
                     Fail_Node
                       (Node,
                        Err_Type_Conflict,
                        "SIMD intrinsics require -t c (not implemented on FASM/FASM16)",
                        Success,
                        Diag);
                     return;
                  else
                     -- Map straight tae dy Core_Simd C-macros!
                     if Tok.Kind = Tok_Splat then Transpiler_Native_HAL.Emit_Raw ("ALB_Splat(", Success);
                     elsif Tok.Kind = Tok_FMA then Transpiler_Native_HAL.Emit_Raw ("ALB_FMA(", Success);
                     elsif Tok.Kind = Tok_Lerp then Transpiler_Native_HAL.Emit_Raw ("ALB_Lerp(", Success);
                     elsif Tok.Kind = Tok_Clamp then Transpiler_Native_HAL.Emit_Raw ("ALB_Clamp(", Success);
                     elsif Tok.Kind = Tok_Dot_Prod then Transpiler_Native_HAL.Emit_Raw ("ALB_Dot(", Success);
                     elsif Tok.Kind = Tok_Cross then Transpiler_Native_HAL.Emit_Raw ("ALB_Cross(", Success);
                     elsif Tok.Kind = Tok_Normalize then Transpiler_Native_HAL.Emit_Raw ("ALB_Normalize(", Success);
                     elsif Tok.Kind = Tok_Blend then Transpiler_Native_HAL.Emit_Raw ("ALB_Blend(", Success);
                     else Transpiler_Native_HAL.Emit_Raw ("ALB_Simd_Unknown(", Success); end if;
                     
                     while Arg_Node > 0 loop
                        Walk_AST(Arg_Node, Depth + 1, Right_Tag, Success, Diag);
                        Arg_Node := Tree(Arg_Node).Next_Sibling;
                        if Arg_Node > 0 then 
                           Transpiler_Native_HAL.Emit_Comma(Success); 
                        end if;
                     end loop;
                     
                     Transpiler_Native_HAL.Emit_Raw (")", Success);
                  end if;
                  
                  Out_Tag := Infer_Type_Tag(Node);
               end;
               

