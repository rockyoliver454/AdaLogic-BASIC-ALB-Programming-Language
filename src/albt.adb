                     if not Success then return; end if;
                  end;
                  Transpiler_Native_HAL.Emit_Call_End (Success);
                  if not Success then return; end if;
                  Transpiler_Native_HAL.Emit_Statement_End (Success);
               end if;
               Out_Tag := Type_None;


            when AST_Locate_Stmt =>
               if Target = Backend_FASM then
                  -- Evaluate X -> rax, stash in r10.
                  Walk_AST (Tree (Node).Left_Child, Depth + 1, Right_Tag, Success, Diag);
                  Transpiler_Native_HAL.Emit_Raw ("  mov r10, rax", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);

                  -- Evaluate Y -> rax, stash in r11.
                  Walk_AST (Tree (Node).Right_Child, Depth + 1, Right_Tag, Success, Diag);
                  Transpiler_Native_HAL.Emit_Raw ("  mov r11, rax", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);

                  -- ANSI cursor format is row;column, so pass Y then X.
                  -- Use r11/r10 as invoke operands to avoid rdx/r8 register crossover.
                  Transpiler_Native_HAL.Emit_Raw ("  invoke printf, ALB_Fmt_Locate, r11, r10", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);
               elsif Target = Backend_FASM16 then
                  Walk_AST (Tree (Node).Left_Child, Depth + 1, Right_Tag, Success, Diag);
                  if not Success then return; end if;
                  Transpiler_Native_HAL.Emit_Raw ("  mov bx, ax", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);
                  Walk_AST (Tree (Node).Right_Child, Depth + 1, Right_Tag, Success, Diag);
                  if not Success then return; end if;
                  Transpiler_Native_HAL.Emit_Raw ("  push ax", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);
                  Transpiler_Native_HAL.Emit_Raw ("  mov ax, bx", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);
                  Transpiler_Native_HAL.Emit_Raw ("  push ax", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);
                  Transpiler_Native_HAL.Emit_Raw ("  call ALB_Locate", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);
               else
                  Transpiler_Native_HAL.Emit_Call_Start ("ALB_Locate", Success);
                  if not Success then return; end if;
                  Walk_AST (Tree (Node).Left_Child, Depth + 1, Right_Tag, Success, Diag);
                  if not Success then return; end if;
                  Transpiler_Native_HAL.Emit_Comma (Success);
                  Walk_AST (Tree (Node).Right_Child, Depth + 1, Right_Tag, Success, Diag);
                  if not Success then return; end if;
                  Transpiler_Native_HAL.Emit_Call_End (Success);
                  if not Success then return; end if;
                  Transpiler_Native_HAL.Emit_Statement_End (Success);
               end if;


            --  when AST_Member_Expr =>
            --     declare
            --        Var_Node  : Node_Index := Tree(Node).Left_Child;
            --        Field_Node: Node_Index := Tree(Node).Right_Child;
            --        Var_Tok   : Token := Tokens(Tree(Var_Node).Token_Index);
            --        Field_Tok : Token := Tokens(Tree(Field_Node).Token_Index);
            --        V_Lex     : String := Input_Buffer(Var_Tok.Start .. Var_Tok.Start + Var_Tok.Length - 1);
            --        F_Lex     : String := Input_Buffer(Field_Tok.Start .. Field_Tok.Start + Field_Tok.Length - 1);
            --  
            --        Sym   : Symbol_Record;
            --        Found : Boolean;
            --     begin
            --        -- DA FIX: Check the Symbol Table directly! Is it a known struct variable?
            --        Find_Symbol(Hash_String(V_Lex), Current_Scope, Found, Sym);
            --        if Found and then Sym.Struct_ID > 0 then
            --           -- It's a normal Struct Access!
            --           if Target = Backend_FASM then
            --              declare
            --                 S_Name : String := Get_Struct_Name(Sym.Struct_ID);
            --              begin
            --                 -- Calculate the address natively using FASM Struct offsets!
            --                 Transpiler_Native_HAL.Emit_Raw ("  mov rax, qword [", Success);
            --                 Transpiler_Native_HAL.Emit_Raw (V_Lex, Success);
            --                 Transpiler_Native_HAL.Emit_Raw (" + ", Success);
            --                 Transpiler_Native_HAL.Emit_Raw (S_Name, Success);
            --                 Transpiler_Native_HAL.Emit_Raw (".", Success);
            --                 Transpiler_Native_HAL.Emit_Raw (F_Lex, Success);
            --                 Transpiler_Native_HAL.Emit_Raw ("]", Success);
            --                 Transpiler_Native_HAL.Emit_Newline (Success);
            --              end;
            --           else
            --              Walk_AST(Var_Node, Depth + 1, Out_Tag, Success, Diag);
            --              Transpiler_Native_HAL.Emit_Variable_Ref("." & F_Lex, Success);
            --           end if;
            --           Out_Tag := Type_U64;
            --        else
            --           -- It's a Module Access!
            --           if Target = Backend_FASM then
            --              Transpiler_Native_HAL.Emit_Raw ("  mov rax, qword [", Success);
            --              Transpiler_Native_HAL.Emit_Raw (V_Lex & "_" & F_Lex, Success);
            --              Transpiler_Native_HAL.Emit_Raw ("]", Success);
            --              Transpiler_Native_HAL.Emit_Newline (Success);
            --           else
            --              Transpiler_Native_HAL.Emit_Variable_Ref(V_Lex & "_" & F_Lex, Success);
            --           end if;
            --           Out_Tag := Type_U64;
            --        end if;
            --     end;
            
            when AST_Member_Expr =>
               declare
                  Var_Node    : Node_Index := Tree (Node).Left_Child;
                  Field_Node  : Node_Index := Tree (Node).Right_Child;
                  Var_Tok     : Token := Tokens (Tree (Var_Node).Token_Index);
                  Field_Tok   : Token := Tokens (Tree (Field_Node).Token_Index);
                  V_Lex       : String := Input_Buffer (Var_Tok.Start .. Var_Tok.Start + Var_Tok.Length - 1);
                  F_Lex       : String := Input_Buffer (Field_Tok.Start .. Field_Tok.Start + Field_Tok.Length - 1);
                  V_Target    : constant String := Scoped_Lexeme (V_Lex);
                  Backing_Target : constant String := V_Target & "_" & F_Lex;
                  Backing_Lex    : constant String := V_Lex & "_" & F_Lex;
                  Sym         : Symbol_Record;
                  Found       : Boolean := False;
                  Backing_Sym : Symbol_Record;
                  Backing_Found : Boolean := False;
                  Target_Backing_Found : Boolean := False;
                  Plain_Backing_Found  : Boolean := False;
                  Field       : Struct_Field;
                  Field_Found : Boolean := False;
               begin
                  Find_Symbol (Hash_String (V_Target), Current_Scope, Found, Sym);

                  if not Found then
                     Find_Symbol (Hash_String (V_Lex), Current_Scope, Found, Sym);
                  end if;

                  Find_Symbol (Hash_String (Backing_Target), Current_Scope, Target_Backing_Found, Backing_Sym);
                  if not Target_Backing_Found then
                     Find_Symbol (Hash_String (Backing_Lex), Current_Scope, Plain_Backing_Found, Backing_Sym);
                  end if;
                  Backing_Found := Target_Backing_Found or else Plain_Backing_Found;

                  if Found and then Sym.Struct_ID > 0 then
                     Find_Struct_Field
                       (Sym.Struct_ID,
                        Hash_String (F_Lex),
                        Field_Found,
                        Field);

                     if not Field_Found then
                        Fail_Node (Node, Err_Type_Conflict, F_Lex, Success, Diag);
                        return;
                     end if;
                     
                     --  if Field.Tag /= Type_U8
                     --    and then Field.Tag /= Type_U16
                     --    and then Field.Tag /= Type_Boolean
                     --  then
                     --     Fail_Node
                     --       (Node,
                     --        Err_Type_Conflict,
                     --        "FASM16 member stores support U8, U16, or Boolean",
                     --        Success,
                     --        Diag);
                     --     return;
                     --  end if;
                     --  
                     --  Emit_FASM16_Type_Store_Check_AX (Field.Tag);
                     --  if not Success then
                     --     return;
                     --  end if;

                     if Target = Backend_FASM then
                        declare
                           S_Name : String := Get_Struct_Name (Sym.Struct_ID);
                        begin
                           if Field.Tag = Type_U8 or else Field.Tag = Type_Boolean then
                              Transpiler_Native_HAL.Emit_Raw ("  xor rax, rax", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);

                              Transpiler_Native_HAL.Emit_Raw ("  mov al, byte [", Success);
                              Transpiler_Native_HAL.Emit_Raw (V_Target, Success);
                              Transpiler_Native_HAL.Emit_Raw (" + ", Success);
                              Transpiler_Native_HAL.Emit_Raw (S_Name, Success);
                              Transpiler_Native_HAL.Emit_Raw (".", Success);
                              Transpiler_Native_HAL.Emit_Raw (F_Lex, Success);
                              Transpiler_Native_HAL.Emit_Raw ("]", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);

                           elsif Field.Tag = Type_U16 then
                              Transpiler_Native_HAL.Emit_Raw ("  xor rax, rax", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);

                              Transpiler_Native_HAL.Emit_Raw ("  mov ax, word [", Success);
                              Transpiler_Native_HAL.Emit_Raw (V_Target, Success);
                              Transpiler_Native_HAL.Emit_Raw (" + ", Success);
                              Transpiler_Native_HAL.Emit_Raw (S_Name, Success);
                              Transpiler_Native_HAL.Emit_Raw (".", Success);
                              Transpiler_Native_HAL.Emit_Raw (F_Lex, Success);
                              Transpiler_Native_HAL.Emit_Raw ("]", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);

                           elsif Field.Tag = Type_U32 then
                              Transpiler_Native_HAL.Emit_Raw ("  xor rax, rax", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);

                              Transpiler_Native_HAL.Emit_Raw ("  mov eax, dword [", Success);
                              Transpiler_Native_HAL.Emit_Raw (V_Target, Success);
                              Transpiler_Native_HAL.Emit_Raw (" + ", Success);
                              Transpiler_Native_HAL.Emit_Raw (S_Name, Success);
                              Transpiler_Native_HAL.Emit_Raw (".", Success);
                              Transpiler_Native_HAL.Emit_Raw (F_Lex, Success);
                              Transpiler_Native_HAL.Emit_Raw ("]", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);

                           elsif Field.Tag = Type_S32 or else Field.Tag = Type_HW32 then
                              Transpiler_Native_HAL.Emit_Raw ("  movsxd rax, dword [", Success);
                              Transpiler_Native_HAL.Emit_Raw (V_Target, Success);
                              Transpiler_Native_HAL.Emit_Raw (" + ", Success);
                              Transpiler_Native_HAL.Emit_Raw (S_Name, Success);
                              Transpiler_Native_HAL.Emit_Raw (".", Success);
                              Transpiler_Native_HAL.Emit_Raw (F_Lex, Success);
                              Transpiler_Native_HAL.Emit_Raw ("]", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);

                           else
                              Transpiler_Native_HAL.Emit_Raw ("  mov rax, qword [", Success);
                              Transpiler_Native_HAL.Emit_Raw (V_Target, Success);
                              Transpiler_Native_HAL.Emit_Raw (" + ", Success);
                              Transpiler_Native_HAL.Emit_Raw (S_Name, Success);
                              Transpiler_Native_HAL.Emit_Raw (".", Success);
                              Transpiler_Native_HAL.Emit_Raw (F_Lex, Success);
                              Transpiler_Native_HAL.Emit_Raw ("]", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                           end if;
                        end;

                     elsif Target = Backend_FASM16 then
                        declare
                           FImg : constant String := Natural'Image (Field.Offset);
                           FOff : constant String := FImg (FImg'First + 1 .. FImg'Last);
                        begin
                           if not FASM16_Scalar_Supported (Field.Tag) then
                              Fail_Node
                                (Node,
                                 Err_Type_Conflict,
                                 "FASM16 member reads could not infer a usable type.",
                                 Success,
                                 Diag);
                              return;
                           end if;

                            if Sym.Class = Class_Local and then Sym.Offset < 0 then
                               declare
                                  BImg : constant String := Integer'Image (-Sym.Offset);
                                  BOff : constant String := BImg (BImg'First + 1 .. BImg'Last);
                               begin
                                  if Field.Tag = Type_U8 or else Field.Tag = Type_HW8 or else Field.Tag = Type_Boolean then
                                     Transpiler_Native_HAL.Emit_Raw ("  xor ax, ax", Success);
                                     Transpiler_Native_HAL.Emit_Newline (Success);
                                     Transpiler_Native_HAL.Emit_Raw ("  xor dx, dx", Success);
                                     Transpiler_Native_HAL.Emit_Newline (Success);
                                     Transpiler_Native_HAL.Emit_Raw
                                       ("  mov al, byte [bp-" & BOff & "+" & FOff & "]",
                                        Success);

                                 elsif Field.Tag = Type_U32
                                   or else Field.Tag = Type_HW32
                                   or else Field.Tag = Type_S32
                                   or else Field.Tag = Type_Pure
                                 then
                                    Transpiler_Native_HAL.Emit_Raw
                                      ("  mov ax, word [bp-" & BOff & "+" & FOff & "]",
                                        Success);
                                     Transpiler_Native_HAL.Emit_Newline (Success);
                                     Transpiler_Native_HAL.Emit_Raw
                                       ("  mov dx, word [bp-" & BOff & "+" & FOff & "+2]",
                                        Success);

                                  else
                                     Transpiler_Native_HAL.Emit_Raw
                                       ("  mov ax, word [bp-" & BOff & "+" & FOff & "]",
                                        Success);
                                     Transpiler_Native_HAL.Emit_Newline (Success);
                                     Transpiler_Native_HAL.Emit_Raw ("  xor dx, dx", Success);
                                  end if;
                               end;

                            elsif Sym.Class = Class_Local and then Sym.Offset > 0 then
                               declare
                                  BImg : constant String := Integer'Image (Sym.Offset);
                                  BOff : constant String := BImg (BImg'First + 1 .. BImg'Last);
                               begin
                                  if Field.Tag = Type_U8 or else Field.Tag = Type_Boolean then
                                     Transpiler_Native_HAL.Emit_Raw ("  xor ax, ax", Success);
                                     Transpiler_Native_HAL.Emit_Newline (Success);
                                     Transpiler_Native_HAL.Emit_Raw ("  xor dx, dx", Success);
                                     Transpiler_Native_HAL.Emit_Newline (Success);
                                     Transpiler_Native_HAL.Emit_Raw
                                       ("  mov al, byte [bp+" & BOff & "+" & FOff & "]",
                                        Success);

                                  elsif Field.Tag = Type_U32
                                    or else Field.Tag = Type_HW32
                                    or else Field.Tag = Type_S32
                                    or else Field.Tag = Type_Pure
                                  then
                                     Transpiler_Native_HAL.Emit_Raw
                                       ("  mov ax, word [bp+" & BOff & "+" & FOff & "]",
                                        Success);
                                     Transpiler_Native_HAL.Emit_Newline (Success);
                                     Transpiler_Native_HAL.Emit_Raw
                                       ("  mov dx, word [bp+" & BOff & "+" & FOff & "+2]",
                                        Success);

                                  else
                                     Transpiler_Native_HAL.Emit_Raw
                                       ("  mov ax, word [bp+" & BOff & "+" & FOff & "]",
                                        Success);
                                     Transpiler_Native_HAL.Emit_Newline (Success);
                                     Transpiler_Native_HAL.Emit_Raw ("  xor dx, dx", Success);
                                  end if;
                               end;

                            else
                               if Field.Tag = Type_U8 or else Field.Tag = Type_HW8 or else Field.Tag = Type_Boolean then
                                  Transpiler_Native_HAL.Emit_Raw ("  xor ax, ax", Success);
                                  Transpiler_Native_HAL.Emit_Newline (Success);
                                  Transpiler_Native_HAL.Emit_Raw ("  xor dx, dx", Success);
                                  Transpiler_Native_HAL.Emit_Newline (Success);
                                  Transpiler_Native_HAL.Emit_Raw
                                    ("  mov al, byte [" & V_Target & "+" & FOff & "]",
                                     Success);

                               elsif Field.Tag = Type_U32
                                 or else Field.Tag = Type_HW32
                                 or else Field.Tag = Type_S32
                                 or else Field.Tag = Type_Pure
                               then
                                  Transpiler_Native_HAL.Emit_Raw
                                    ("  mov ax, word [" & V_Target & "+" & FOff & "]",
                                     Success);
                                  Transpiler_Native_HAL.Emit_Newline (Success);
                                  Transpiler_Native_HAL.Emit_Raw
                                    ("  mov dx, word [" & V_Target & "+" & FOff & "+2]",
                                     Success);

                               else
                                  Transpiler_Native_HAL.Emit_Raw
                                    ("  mov ax, word [" & V_Target & "+" & FOff & "]",
                                     Success);
                                  Transpiler_Native_HAL.Emit_Newline (Success);
                                  Transpiler_Native_HAL.Emit_Raw ("  xor dx, dx", Success);
                               end if;
                            end if;

                            Transpiler_Native_HAL.Emit_Newline (Success);
                         end;

                     else
                        Walk_AST (Var_Node, Depth + 1, Out_Tag, Success, Diag);
                        Transpiler_Native_HAL.Emit_Variable_Ref ("." & F_Lex, Success);
                     end if;

                     Out_Tag := Field.Tag;

                  else
                     if Target = Backend_FASM then
                        declare
                           Index_Node        : constant Node_Index := Tree (Var_Node).Left_Child;
                           Target_Arr_Found  : constant Boolean :=
                             Find_Strict_Array (Backing_Target) > 0
                               or else Find_Slide_Array (Backing_Target) > 0;
                           Plain_Arr_Found   : constant Boolean :=
                             Find_Strict_Array (Backing_Lex) > 0
                               or else Find_Slide_Array (Backing_Lex) > 0;
                           Use_Target_Name   : constant Boolean := Target_Arr_Found;
                           Field_Tag         : constant ALB_Type_Tag :=
                             (if Backing_Found then Backing_Sym.Tag else Type_U64);
                        begin
                           if Index_Node > 0 and then (Target_Arr_Found or else Plain_Arr_Found) then
                              if Use_Target_Name then
                                 Validate_Strict_Array_Literal_Indexes
                                   (Backing_Target,
                                    Index_Node,
                                    Node,
                                    Success,
                                    Diag);
                                 if not Success then return; end if;

                                 Validate_Slide_Array_Literal_Indexes
                                   (Backing_Target,
                                    Index_Node,
                                    Node,
                                    Success,
                                    Diag);
                                 if not Success then return; end if;

                                 Emit_FASM_Array_Index_Offset_To_RAX
                                   (Backing_Target,
                                    Index_Node);
                                 if not Success then return; end if;

                                 Transpiler_Native_HAL.Emit_Raw ("  lea rbx, [", Success);
                                 Transpiler_Native_HAL.Emit_Raw (Backing_Target, Success);
                                 Transpiler_Native_HAL.Emit_Raw ("]", Success);
                                 Transpiler_Native_HAL.Emit_Newline (Success);
                              else
                                 Validate_Strict_Array_Literal_Indexes
                                   (Backing_Lex,
                                    Index_Node,
                                    Node,
                                    Success,
                                    Diag);
                                 if not Success then return; end if;

                                 Validate_Slide_Array_Literal_Indexes
                                   (Backing_Lex,
                                    Index_Node,
                                    Node,
                                    Success,
                                    Diag);
                                 if not Success then return; end if;

                                 Emit_FASM_Array_Index_Offset_To_RAX
                                   (Backing_Lex,
                                    Index_Node);
                                 if not Success then return; end if;

                                 Transpiler_Native_HAL.Emit_Raw ("  lea rbx, [", Success);
                                 Transpiler_Native_HAL.Emit_Raw (Backing_Lex, Success);
                                 Transpiler_Native_HAL.Emit_Raw ("]", Success);
                                 Transpiler_Native_HAL.Emit_Newline (Success);
                              end if;

                              Transpiler_Native_HAL.Emit_Raw ("  add rbx, rax", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);

                              Emit_FASM_Load_Scalar_To_RAX ("rbx", Field_Tag, Success);

                              Out_Tag := Field_Tag;
                           else
                              if Backing_Found then
                                 if Target_Backing_Found then
                                    Emit_FASM_Load_Scalar_To_RAX (Backing_Target, Backing_Sym.Tag, Success);
                                 else
                                    Emit_FASM_Load_Scalar_To_RAX (Backing_Lex, Backing_Sym.Tag, Success);
                                 end if;
                                 Out_Tag := Backing_Sym.Tag;
                              else
                                 Transpiler_Native_HAL.Emit_Raw ("  mov rax, qword [", Success);
                                 if Target_Backing_Found then
                                    Transpiler_Native_HAL.Emit_Raw (Backing_Target, Success);
                                 else
                                    Transpiler_Native_HAL.Emit_Raw (Backing_Lex, Success);
                                 end if;
                                 Transpiler_Native_HAL.Emit_Raw ("]", Success);
                                 Transpiler_Native_HAL.Emit_Newline (Success);
                                 Out_Tag := Type_U64;
                              end if;
                           end if;
                        end;

                     elsif Target = Backend_FASM16 then
                        declare
                           Index_Node        : constant Node_Index := Tree (Var_Node).Left_Child;
                           Target_Arr_Found  : constant Boolean :=
                             Find_Strict_Array (Backing_Target) > 0
                               or else Find_Slide_Array (Backing_Target) > 0;
                           Plain_Arr_Found   : constant Boolean :=
                             Find_Strict_Array (Backing_Lex) > 0
                               or else Find_Slide_Array (Backing_Lex) > 0;
                           Use_Target_Name   : constant Boolean := Target_Arr_Found;
                           Field_Tag         : constant ALB_Type_Tag :=
                             (if Backing_Found then Backing_Sym.Tag else Type_U16);
                        begin
                           if Index_Node > 0 and then (Target_Arr_Found or else Plain_Arr_Found) then
                              if not FASM16_Scalar_Supported (Field_Tag) then
                                 Fail_Node
                                   (Node,
                                    Err_Type_Conflict,
                                    "FASM16 PARALLEL field reads support U8, U16, U32, U64, S32, S64, HW8, HW16, HW32, PURE, or Boolean",
                                    Success,
                                    Diag);
                                 return;
                              end if;

                              if Use_Target_Name then
                                 Validate_Strict_Array_Literal_Indexes
                                   (Backing_Target,
                                    Index_Node,
                                    Node,
                                    Success,
                                    Diag);
                                 if not Success then return; end if;

                                 Validate_Slide_Array_Literal_Indexes
                                   (Backing_Target,
                                    Index_Node,
                                    Node,
                                    Success,
                                    Diag);
                                 if not Success then return; end if;

                                 Emit_FASM16_Array_Index_Offset_To_BX
                                   (Backing_Target,
                                    Index_Node,
                                    FASM16_Storage_Bytes (Field_Tag));
                                 if not Success then return; end if;
                              else
                                 Validate_Strict_Array_Literal_Indexes
                                   (Backing_Lex,
                                    Index_Node,
                                    Node,
                                    Success,
                                    Diag);
                                 if not Success then return; end if;

                                 Validate_Slide_Array_Literal_Indexes
                                   (Backing_Lex,
                                    Index_Node,
                                    Node,
                                    Success,
                                    Diag);
                                 if not Success then return; end if;

                                 Emit_FASM16_Array_Index_Offset_To_BX
                                   (Backing_Lex,
                                    Index_Node,
                                    FASM16_Storage_Bytes (Field_Tag));
                                 if not Success then return; end if;
                              end if;

                              if Backing_Found and then Backing_Sym.Class = Class_Local and then Backing_Sym.Offset < 0 then
                                 declare
                                    Img : constant String := Integer'Image (-Backing_Sym.Offset);
                                    Off : constant String := Img (Img'First + 1 .. Img'Last);
                                 begin
                                    Transpiler_Native_HAL.Emit_Raw ("  mov si, bx", Success);
                                    Transpiler_Native_HAL.Emit_Newline (Success);
                                    Emit_FASM16_Load_Cell_To_DXAX ("bp+si-" & Off, Field_Tag);
                                 end;
                              else
                                 Emit_FASM16_Load_Cell_To_DXAX
                                   ((if Use_Target_Name then Backing_Target else Backing_Lex) & " + bx",
                                    Field_Tag);
                              end if;

                              Out_Tag := Field_Tag;
                           elsif Backing_Found then
                              Emit_FASM16_Load_Cell_To_DXAX
                                (FASM16_Cell_Name
                                   (Backing_Sym,
                                    (if Target_Backing_Found then Backing_Target else Backing_Lex)),
                                 Backing_Sym.Tag);
                              Out_Tag := Backing_Sym.Tag;
                           else
                              Emit_FASM16_Load_Cell_To_DXAX (Backing_Lex, Type_U16);
                              Out_Tag := Type_U16;
                           end if;
                        end;

                     else
                        declare
                           Index_Node       : constant Node_Index := Tree (Var_Node).Left_Child;
                           Target_Arr_Found : constant Boolean :=
                             Find_Strict_Array (Backing_Target) > 0
                               or else Find_Slide_Array (Backing_Target) > 0;
                           Plain_Arr_Found  : constant Boolean :=
                             Find_Strict_Array (Backing_Lex) > 0
                               or else Find_Slide_Array (Backing_Lex) > 0;
                           Use_Target_Name  : constant Boolean := Target_Arr_Found;
                        begin
                           if Index_Node > 0 and then (Target_Arr_Found or else Plain_Arr_Found) then
                              if Use_Target_Name then
                                 Transpiler_Native_HAL.Emit_Variable_Ref (Backing_Target, Success);
                              else
                                 Transpiler_Native_HAL.Emit_Variable_Ref (Backing_Lex, Success);
                              end if;
                              if not Success then return; end if;

                              Transpiler_Native_HAL.Emit_Raw ("[", Success);
                              if not Success then return; end if;
                              Walk_AST (Index_Node, Depth + 1, Out_Tag, Success, Diag);
                              if not Success then return; end if;
                              Transpiler_Native_HAL.Emit_Raw ("]", Success);
                           elsif Target_Backing_Found then
                              Transpiler_Native_HAL.Emit_Variable_Ref (Backing_Target, Success);
                           else
                              Transpiler_Native_HAL.Emit_Variable_Ref (Backing_Lex, Success);
                           end if;
                        end;
                     end if;

                     if Target = Backend_FASM16 then
                        null;
                     elsif Target /= Backend_FASM then
                        Out_Tag := (if Backing_Found then Backing_Sym.Tag else Type_U64);
                     end if;
                  end if;
               end;

               
            when AST_DeclareModule | AST_Module =>
               declare
                  Name_Node : Node_Index := Tree(Node).Left_Child;
                  Body_Node : Node_Index := Tree(Node).Right_Child;
                  Tok       : Token := Tokens(Tree(Name_Node).Token_Index);
                  Lex       : String := Input_Buffer(Tok.Start .. Tok.Start + Tok.Length - 1);
                  M_Success : Boolean;
               begin
                  if Tree(Node).Kind = AST_DeclareModule then
                     Module_Vault.Register_Module(Lex, "INLINE", M_Success);
                     Log("   -> FORGE: Registered Interface for Module '" & Lex & "'");
                     
                     -- DA FIX: Only process Structs inside DeclareModule! No duplicate functions!
                     Active_Module_Len := Lex'Length;
                     Active_Module_Name(1 .. Active_Module_Len) := Lex;
                     
                     declare
                        Curr : Node_Index := Tree(Body_Node).Left_Child;
                        Dummy_Tag : ALB_Type_Tag;
                     begin
                        while Curr /= 0 loop
                           if Tree(Curr).Kind = AST_Struct_Decl then
                              Walk_AST(Curr, Depth + 1, Dummy_Tag, Success, Diag);
                           end if;
                           Curr := Tree(Curr).Next_Sibling;
                        end loop;
                     end;
                     
                     Active_Module_Len := 0;
                     Out_Tag := Type_None;
                  else
                     -- DA NORMAL MODULE
                     Active_Module_Len := Lex'Length;
                     Active_Module_Name(1 .. Active_Module_Len) := Lex;
                     
                     Walk_AST(Body_Node, Depth + 1, Out_Tag, Success, Diag);
                     
                     Active_Module_Len := 0;
                     Out_Tag := Type_None;
                  end if;
               end;

            when AST_Import =>
               declare
                  Name_Node : Node_Index := Tree(Node).Left_Child;
                  Tok       : Token := Tokens(Tree(Name_Node).Token_Index);
                  Lex       : String := Input_Buffer(Tok.Start .. Tok.Start + Tok.Length - 1);
               begin
                  Log("   -> IMPORT: Linked Dependency '" & Lex & "'");
                  -- In a purely static pipeline, we just acknowledge the link here.
                  -- The physical code was woven during Step 0.5 (The Include Weaver)!
               end;
               
            when AST_Range_Type_Decl =>
               Register_Range_Type(Node, Success, Diag);
               Out_Tag := Type_None;

               
            when AST_Parallel_Decl =>
               declare
                  Group_Node        : Node_Index := Tree (Node).Left_Child;
                  Size_Node         : Node_Index := Tree (Group_Node).Left_Child;
                  Field_Curr        : Node_Index := Tree (Node).Right_Child;
                  Group_Tok         : Token := Tokens (Tree (Group_Node).Token_Index);
                  Group_Lexeme      : String := Input_Buffer (Group_Tok.Start .. Group_Tok.Start + Group_Tok.Length - 1);
                  Group_Target      : constant String := Scoped_Lexeme (Group_Lexeme);
                  Curr_Bnd          : Node_Index := Size_Node;
                  Total_Elements    : U64 := 1;
                  Allocated_Elements : U64 := 0;
                  Group_Idx         : Natural := 0;
               begin
                  if Target /= Backend_FASM
                    and then Target /= Backend_FASM16
                    and then Target /= Backend_C
                  then
                     Fail_Node (Node, Err_Type_Conflict, "PARALLEL is currently native-only (fasm/fasm16/c)", Success, Diag);
                     return;
                  end if;

                  if Size_Node = 0 then
                     Fail_Node (Node, Err_Compiler_AST_Mismatch, Group_Lexeme, Success, Diag);
                     return;
                  end if;

                  if Field_Curr = 0 then
                     Fail_Node (Node, Err_Parse_Expected_Var, Group_Lexeme, Success, Diag);
                     return;
                  end if;

                  while Curr_Bnd > 0 loop
                     declare
                        Parsed_Size : U64 := 0;
                     begin
                        Comptime_Eval_Expr (Curr_Bnd, Parsed_Size, Success, Diag);
                        if not Success then
                           Log ("FATAL: PARALLEL array bounds must be static compile-time expressions.");
                           return;
                        end if;

                        if Parsed_Size = 0 then
                           Fail_Node (Node, Err_Compiler_AST_Mismatch, Group_Lexeme, Success, Diag);
                           return;
                        end if;

                        Total_Elements := Total_Elements * Parsed_Size;
                     end;

                     Curr_Bnd := Tree (Curr_Bnd).Next_Sibling;
                  end loop;

                  if Total_Elements = U64'Last then
                     Log ("FATAL: PARALLEL Array Allocation overflow.");
                     Success := False;
                     return;
                  end if;

                  Allocated_Elements := Total_Elements + 1;
                  if Allocated_Elements > U64 (Natural'Last) then
                     Fail_Node (Node, Err_Mem_Out_Of_Bounds, Group_Lexeme, Success, Diag);
                     return;
                  end if;

                  Register_Parallel_Group
                    (Group_Target,
                     Natural (Total_Elements),
                     Node,
                     Group_Idx,
                     Success,
                     Diag);
                  if not Success then
                     return;
                  end if;

                  while Field_Curr > 0 loop
                     if Tree (Field_Curr).Kind /= AST_Parallel_Field then
                        Fail_Node (Field_Curr, Err_Compiler_AST_Mismatch, Group_Lexeme, Success, Diag);
                        return;
                     end if;

                     declare
                        Field_Name_Node : Node_Index := Tree (Field_Curr).Left_Child;
                        Type_Node       : Node_Index := Tree (Field_Name_Node).Right_Child;
                        Field_Tok       : Token := Tokens (Tree (Field_Name_Node).Token_Index);
                        Field_Lex       : String := Input_Buffer (Field_Tok.Start .. Field_Tok.Start + Field_Tok.Length - 1);
                        Backing_Lex     : constant String := Group_Lexeme & "_" & Field_Lex;
                        Backing_Target  : constant String := Scoped_Lexeme (Backing_Lex);
                        Element_Range   : Natural := 0;
                        Element_Tag     : ALB_Type_Tag :=
                          (if Target = Backend_FASM16 then Type_U16 else Type_U64);
                        Element_Bytes   : Natural :=
                          (if Target = Backend_FASM16
                           then FASM16_Storage_Bytes (Type_U16)
                           else 8);
                        Req_Bytes       : Natural := 0;
                        Block_Bounds    : RS_Interval;
                     begin
                        if Type_Node > 0 then
                           declare
                              Type_Lex : constant String := Raw_Lexeme (Tree (Type_Node).Token_Index);
                           begin
                              Element_Range := Find_Range_Type (Type_Lex);

                              if Element_Range > 0 then
                                 Element_Tag := Range_Types (Element_Range).Base_Tag;
                              else
                                 Element_Tag := Resolve_Type_Name (Type_Lex);
                                 if Element_Tag = Type_None then
                                    declare
                                       R : constant Natural := Find_Range_Type (Type_Lex);
                                    begin
                                       if R > 0 then
                                          Element_Tag := Range_Types (R).Base_Tag;
                                       end if;
                                    end;
                                 end if;

                                 if Element_Tag = Type_None then
                                    Fail_Node
                                      (Type_Node, Err_Type_Conflict, Type_Lex, Success, Diag);
                                    return;
                                 end if;

                                 if Target = Backend_FASM16
                                   and then not Allowed_As_Array_Element
                                        (Element_Tag, Class_Retro_8_16)
                                 then
                                    Fail_Node
                                      (Type_Node,
                                       Err_Type_Conflict,
                                       "FASM16 PARALLEL array fields must be U8, U16, U32, U64, S32, S64, HW8, HW16, HW32, PURE, or Boolean",
                                       Success,
                                       Diag);
                                    return;

                                 elsif Target = Backend_FASM
                                   and then not Allowed_As_Array_Element
                                        (Element_Tag, Class_Modern_Native)
                                 then
                                    Fail_Node
                                      (Type_Node,
                                       Err_Type_Conflict,
                                       "FASM PARALLEL arrays support scalar numeric/HW/BOOL/CHAR/F32/F64/PURE/U128",
                                       Success,
                                       Diag);
                                    return;
                                 end if;
                              end if;

                              if Target = Backend_FASM16 then
                                 Element_Bytes := FASM16_Storage_Bytes (Element_Tag);
                              elsif Target = Backend_FASM then
                                 Element_Bytes := Array_Element_Bytes (Element_Tag);
                              end if;
                           end;
                        end if;

                        if Target = Backend_FASM16 then
                           if Allocated_Elements > U64 (Natural'Last / Element_Bytes) then
                              Log ("FATAL: PARALLEL Array Allocation byte overflow.");
                              Success := False;
                              return;
                           end if;

                           Req_Bytes := Natural (Allocated_Elements * U64 (Element_Bytes));
                        elsif Target = Backend_C then
                           if Allocated_Elements > U64 (Natural'Last / 8) then
                              Log ("FATAL: PARALLEL Array Allocation byte overflow.");
                              Success := False;
                              return;
                           end if;

                           Req_Bytes := Natural (Allocated_Elements * 8);
                        else
                           if Allocated_Elements > U64 (Natural'Last / Element_Bytes) then
                              Log ("FATAL: PARALLEL Array Allocation byte overflow.");
                              Success := False;
                              return;
                           end if;

                           Req_Bytes := Natural (Allocated_Elements * U64 (Element_Bytes));
                        end if;

                        declare
                           Dummy_Tag : ALB_Type_Tag;
                           Dummy_Sym : Symbol_Record;
                        begin
                           Dummy_Sym := Resolve_Symbol (Backing_Lex, Element_Tag, 0, True, Dummy_Tag);
                        end;

                        Register_Strict_Array
                          (Backing_Target,
                           Size_Node,
                           Node,
                           Success,
                           Diag);

                        if not Success then
                           return;
                        end if;

                        Remember_Array_Element_Tag (Backing_Target, Element_Tag);

                        if Element_Range > 0 then
                           Register_Range_Array (Backing_Target, Element_Range);
                        end if;

                        memory_allocator.Claim_Strict_Block (Pool_Index (Req_Bytes), Block_Bounds, Success);
                        if not Success then
                           Log ("FATAL: PARALLEL Array Allocation failed! Static Pool exhausted!");
                           return;
                        end if;

                        Transpiler_Native_HAL.Set_Global_Buffer_Mode (True);
                        if Target = Backend_FASM then
                           declare
                              Directive : constant String :=
                                (if Element_Bytes = 1 then "rb"
                                 elsif Element_Bytes = 2 then "rw"
                                 elsif Element_Bytes = 4 then "rd"
                                 else "rq");
                           begin
                              Transpiler_Native_HAL.Emit_Raw
                                ("  " & Backing_Target & " " & Directive & " ",
                                 Success);
                           end;
                           Transpiler_Native_HAL.Emit_Literal_U64 (Allocated_Elements, Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);

                           Transpiler_Native_HAL.Emit_Raw ("  sizeof." & Backing_Target & " = ", Success);
                           Transpiler_Native_HAL.Emit_Literal_U64
                             (Allocated_Elements * U64 (Element_Bytes),
                              Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                        elsif Target = Backend_C then
                           Transpiler_Native_HAL.Emit_Strict_Array_Decl
                             (Backing_Target,
                              Natural (Allocated_Elements * 8),
                              Success);
                        else
                           declare
                              Directive : constant String :=
                                (if Element_Tag = Type_U8
                                   or else Element_Tag = Type_HW8
                                   or else Element_Tag = Type_Boolean
                                 then "db"
                                 elsif Element_Tag = Type_U32
                                   or else Element_Tag = Type_S32
                                   or else Element_Tag = Type_HW32
                                   or else Element_Tag = Type_Pure
                                 then "dd"
                                 else "dw");
                           begin
                              Transpiler_Native_HAL.Emit_Raw ("  " & Backing_Target & " " & Directive & " ", Success);
                              Transpiler_Native_HAL.Emit_Literal_U64 (Allocated_Elements, Success);
                              Transpiler_Native_HAL.Emit_Raw (" dup (0)", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);

                              Transpiler_Native_HAL.Emit_Raw ("  sizeof." & Backing_Target & " = ", Success);
                              Transpiler_Native_HAL.Emit_Literal_U64
                                (Allocated_Elements * U64 (Element_Bytes),
                                 Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                           end;
                        end if;
                        Transpiler_Native_HAL.Set_Global_Buffer_Mode (False);

                        if Current_Scope = 0 then
                           Register_Chrono_Global (Backing_Target, False, Node, Success, Diag);
                           if not Success then return; end if;
                        end if;

                        Register_Parallel_Field
                          (Group_Idx,
                           Backing_Target,
                           Field_Curr,
                           Success,
                           Diag);
                        if not Success then
                           return;
                        end if;
                     end;

                     Field_Curr := Tree (Field_Curr).Next_Sibling;
                  end loop;

                  Out_Tag := Type_None;
               end;

            when AST_SwapPop_Stmt =>
               declare
                  Target_Node         : constant Node_Index := Tree (Node).Left_Child;
                  Count_Node          : constant Node_Index := Tree (Node).Right_Child;
                  Index_Node          : Node_Index := 0;
                  Group_Idx           : Natural := 0;
                  Count_Target_Found  : Boolean := False;
                  Count_Plain_Found   : Boolean := False;
                  Count_Sym           : Symbol_Record;
                  Count_Range         : Natural := 0;
                  NImg                : constant String := Node_Index'Image (Node);
                  NID                 : constant String := NImg (NImg'First + 1 .. NImg'Last);
                  Copy_Skip_Label     : constant String := ".ALB_SWAPPOP_SKIP_" & NID;

                  function Is_Integer_Scalar (Tag : ALB_Type_Tag) return Boolean is
                  begin
                     return Tag = Type_U8
                       or else Tag = Type_U16
                       or else Tag = Type_U32
                       or else Tag = Type_U64
                       or else Tag = Type_S32
                       or else Tag = Type_HW8
                       or else Tag = Type_HW16
                       or else Tag = Type_HW32;
                  end Is_Integer_Scalar;
               begin
                  if Target /= Backend_FASM
                    and then Target /= Backend_FASM16
                    and then Target /= Backend_C
                  then
                     Fail_Node (Node, Err_Type_Conflict, "SWAPPOP is currently native-only (fasm/fasm16/c)", Success, Diag);
                     return;
                  end if;

                  if Target_Node = 0 or else Count_Node = 0 then
                     Fail_Node (Node, Err_Compiler_AST_Mismatch, "SWAPPOP", Success, Diag);
                     return;
                  end if;

                  if Tree (Target_Node).Kind /= AST_Var_Expr then
                     Fail_Node (Target_Node, Err_Type_Conflict, "SWAPPOP expects group[index]", Success, Diag);
                     return;
                  end if;

                  Index_Node := Tree (Target_Node).Left_Child;
                  if Index_Node = 0 or else Tree (Index_Node).Next_Sibling > 0 then
                     Fail_Node (Target_Node, Err_Type_Conflict, "SWAPPOP expects a 1D group[index]", Success, Diag);
                     return;
                  end if;

                  if Tree (Count_Node).Kind /= AST_Var_Expr
                    or else Tree (Count_Node).Left_Child > 0
                  then
                     Fail_Node (Count_Node, Err_Type_Conflict, "SWAPPOP count must be a scalar variable", Success, Diag);
                     return;
                  end if;

                  declare
                     Group_Tok    : constant Token := Tokens (Tree (Target_Node).Token_Index);
                     Count_Tok    : constant Token := Tokens (Tree (Count_Node).Token_Index);
                     Group_Lexeme : constant String :=
                       Input_Buffer (Group_Tok.Start .. Group_Tok.Start + Group_Tok.Length - 1);
                     Group_Target : constant String := Scoped_Lexeme (Group_Lexeme);
                     Count_Lexeme : constant String :=
                       Input_Buffer (Count_Tok.Start .. Count_Tok.Start + Count_Tok.Length - 1);
                     Count_Target : constant String := Scoped_Lexeme (Count_Lexeme);
                  begin
                     Group_Idx := Find_Parallel_Group (Group_Target);
                     if Group_Idx = 0 then
                        Group_Idx := Find_Parallel_Group (Group_Lexeme);
                     end if;

                     if Group_Idx = 0 or else not Parallel_Groups (Group_Idx).Active then
                        Fail_Node (Target_Node, Err_Type_Conflict, Group_Lexeme, Success, Diag);
                        return;
                     end if;

                     if Parallel_Groups (Group_Idx).Field_Count = 0 then
                        Fail_Node (Target_Node, Err_Compiler_AST_Mismatch, Group_Lexeme, Success, Diag);
                        return;
                     end if;

                     Find_Symbol (Hash_String (Count_Target), Current_Scope, Count_Target_Found, Count_Sym);
                     if not Count_Target_Found then
                        Find_Symbol (Hash_String (Count_Lexeme), Current_Scope, Count_Plain_Found, Count_Sym);
                     end if;

                     if not Count_Target_Found and then not Count_Plain_Found then
                        Fail_Node (Count_Node, Err_Type_Conflict, Count_Lexeme, Success, Diag);
                        return;
                     end if;

                     if not Is_Integer_Scalar (Count_Sym.Tag) then
                        Fail_Node (Count_Node, Err_Type_Conflict, Count_Lexeme, Success, Diag);
                        return;
                     end if;

                     if Count_Target_Found then
                        Count_Range := Find_Range_Var (Count_Target);
                     else
                        Count_Range := Find_Range_Var (Count_Lexeme);
                     end if;

                     if Target = Backend_FASM16 then
                        declare
                           Count_Cell : constant String :=
                             FASM16_Cell_Name
                               (Count_Sym,
                                (if Count_Target_Found then Count_Target else Count_Lexeme));
                        begin
                           Walk_AST (Count_Node, Depth + 1, Right_Tag, Success, Diag);
                           if not Success then return; end if;

                           Emit_FASM16_Index_Bounds_Check (Parallel_Groups (Group_Idx).Capacity);
                           if not Success then return; end if;

                           Transpiler_Native_HAL.Emit_Raw ("  mov cx, ax", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);

                           Walk_AST (Index_Node, Depth + 1, Right_Tag, Success, Diag);
                           if not Success then return; end if;

                           Transpiler_Native_HAL.Emit_Raw ("  cmp dx, 0", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Emit_FASM16_Long_Trap_Jcc ("jne", "ALB16_Runtime_Bounds");
                           Transpiler_Native_HAL.Emit_Raw ("  cmp ax, 0", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Emit_FASM16_Long_Trap_Jcc ("jz", "ALB16_Runtime_Bounds");
                           Transpiler_Native_HAL.Emit_Raw ("  cmp ax, cx", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Emit_FASM16_Long_Trap_Jcc ("ja", "ALB16_Runtime_Bounds");
                           Transpiler_Native_HAL.Emit_Raw ("  je " & Copy_Skip_Label, Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Transpiler_Native_HAL.Emit_Raw ("  push ax", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);

                           declare
                              Field_First : constant Natural := Parallel_Groups (Group_Idx).Field_First;
                              Field_Last  : constant Natural := Field_First + Parallel_Groups (Group_Idx).Field_Count - 1;
                           begin
                              for I in Field_First .. Field_Last loop
                                 if Parallel_Fields (I).Active then
                                    declare
                                       Backing_Name  : constant String :=
                                         Parallel_Fields (I).Backing_Name
                                           (1 .. Parallel_Fields (I).Backing_Len);
                                       Backing_Sym16 : Symbol_Record;
                                       Backing_Found : Boolean := False;
                                       Field_Tag     : ALB_Type_Tag := Type_U16;
                                       Element_Bytes : Natural := 2;
                                    begin
                                       Find_Symbol
                                         (Hash_String (Backing_Name),
                                          Current_Scope,
                                          Backing_Found,
                                          Backing_Sym16);

                                       if Backing_Found then
                                          Field_Tag := FASM16_Normalize_Memory_Tag (Backing_Sym16.Tag);
                                       end if;

                                       if not FASM16_Scalar_Supported (Field_Tag) then
                                          Fail_Node
                                            (Node,
                                             Err_Type_Conflict,
                                             "FASM16 SWAPPOP supports U8, U16, U32, U64, S32, S64, HW8, HW16, HW32, PURE, or Boolean parallel fields",
                                             Success,
                                             Diag);
                                          return;
                                       end if;

                                       Element_Bytes := FASM16_Storage_Bytes (Field_Tag);

                                       Transpiler_Native_HAL.Emit_Raw ("  lea bx, [", Success);
                                       Transpiler_Native_HAL.Emit_Raw (Backing_Name, Success);
                                       Transpiler_Native_HAL.Emit_Raw ("]", Success);
                                       Transpiler_Native_HAL.Emit_Newline (Success);
                                       Transpiler_Native_HAL.Emit_Raw ("  mov si, cx", Success);
                                       Transpiler_Native_HAL.Emit_Newline (Success);
                                       Transpiler_Native_HAL.Emit_Raw ("  pop di", Success);
                                       Transpiler_Native_HAL.Emit_Newline (Success);
                                       Transpiler_Native_HAL.Emit_Raw ("  push di", Success);
                                       Transpiler_Native_HAL.Emit_Newline (Success);

                                       if Element_Bytes = 2 then
                                          Transpiler_Native_HAL.Emit_Raw ("  shl si, 1", Success);
                                          Transpiler_Native_HAL.Emit_Newline (Success);
                                          Transpiler_Native_HAL.Emit_Raw ("  shl di, 1", Success);
                                          Transpiler_Native_HAL.Emit_Newline (Success);
                                       elsif Element_Bytes = 4 then
                                          Transpiler_Native_HAL.Emit_Raw ("  shl si, 1", Success);
                                          Transpiler_Native_HAL.Emit_Newline (Success);
                                          Transpiler_Native_HAL.Emit_Raw ("  shl si, 1", Success);
                                          Transpiler_Native_HAL.Emit_Newline (Success);
                                          Transpiler_Native_HAL.Emit_Raw ("  shl di, 1", Success);
                                          Transpiler_Native_HAL.Emit_Newline (Success);
                                          Transpiler_Native_HAL.Emit_Raw ("  shl di, 1", Success);
                                          Transpiler_Native_HAL.Emit_Newline (Success);
                                       elsif Element_Bytes /= 1 then
                                          Fail_Node (Node, Err_Type_Conflict, Backing_Name, Success, Diag);
                                          return;
                                       end if;

                                       if Element_Bytes = 1 then
                                          Transpiler_Native_HAL.Emit_Raw ("  mov al, byte [bx+si]", Success);
                                          Transpiler_Native_HAL.Emit_Newline (Success);
                                          Transpiler_Native_HAL.Emit_Raw ("  mov byte [bx+di], al", Success);
                                          Transpiler_Native_HAL.Emit_Newline (Success);
                                       elsif Element_Bytes = 2 then
                                          Transpiler_Native_HAL.Emit_Raw ("  mov ax, word [bx+si]", Success);
                                          Transpiler_Native_HAL.Emit_Newline (Success);
                                          Transpiler_Native_HAL.Emit_Raw ("  mov word [bx+di], ax", Success);
                                          Transpiler_Native_HAL.Emit_Newline (Success);
                                       else
                                          Transpiler_Native_HAL.Emit_Raw ("  mov ax, word [bx+si]", Success);
                                          Transpiler_Native_HAL.Emit_Newline (Success);
                                          Transpiler_Native_HAL.Emit_Raw ("  mov dx, word [bx+si+2]", Success);
                                          Transpiler_Native_HAL.Emit_Newline (Success);
                                          Transpiler_Native_HAL.Emit_Raw ("  mov word [bx+di], ax", Success);
                                          Transpiler_Native_HAL.Emit_Newline (Success);
                                          Transpiler_Native_HAL.Emit_Raw ("  mov word [bx+di+2], dx", Success);
                                          Transpiler_Native_HAL.Emit_Newline (Success);
                                       end if;
                                    end;
                                 end if;
                              end loop;
                           end;

                           Transpiler_Native_HAL.Emit_Raw ("  pop ax", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Transpiler_Native_HAL.Emit_Raw (Copy_Skip_Label & ":", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Transpiler_Native_HAL.Emit_Raw ("  dec cx", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Transpiler_Native_HAL.Emit_Raw ("  mov ax, cx", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Transpiler_Native_HAL.Emit_Raw ("  xor dx, dx", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);

                           if Count_Range > 0 then
                              Emit_FASM16_Range_Check_AX (Count_Range);
                              if not Success then return; end if;
                           end if;

                           Emit_FASM16_Type_Store_Check_AX (Count_Sym.Tag);
                           if not Success then return; end if;

                           Emit_FASM16_Store_DXAX_To_Cell (Count_Cell, Count_Sym.Tag);
                        end;
                     elsif Target = Backend_C then
                        declare
                           Count_Name  : constant String :=
                             (if Count_Target_Found then Count_Target else Count_Lexeme);
                           Count_Temp  : constant String := "ALB_SWAPPOP_COUNT_" & NID;
                           Index_Temp  : constant String := "ALB_SWAPPOP_INDEX_" & NID;
                           Cap_Text    : constant String :=
                             Trim_Image (Integer (Parallel_Groups (Group_Idx).Capacity));
                           Field_First : constant Natural := Parallel_Groups (Group_Idx).Field_First;
                           Field_Last  : constant Natural :=
                             Field_First + Parallel_Groups (Group_Idx).Field_Count - 1;
                        begin
                           Transpiler_Native_HAL.Emit_Indent (Success);
                           if not Success then return; end if;
                           Transpiler_Native_HAL.Emit_Raw ("{", Success);
                           if not Success then return; end if;
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           if not Success then return; end if;
                           Transpiler_Native_HAL.Increase_Indent;

                           Transpiler_Native_HAL.Emit_Indent (Success);
                           if not Success then return; end if;
                           Transpiler_Native_HAL.Emit_Raw
                             ("uint64_t " & Count_Temp & " = (uint64_t)(" & Count_Name & ");",
                              Success);
                           if not Success then return; end if;
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           if not Success then return; end if;

                           Transpiler_Native_HAL.Emit_Indent (Success);
                           if not Success then return; end if;
                           Transpiler_Native_HAL.Emit_Raw
                             ("uint64_t " & Index_Temp & " = (uint64_t)(",
                              Success);
                           if not Success then return; end if;
                           Walk_AST (Index_Node, Depth + 1, Right_Tag, Success, Diag);
                           if not Success then return; end if;
                           Transpiler_Native_HAL.Emit_Raw (");", Success);
                           if not Success then return; end if;
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           if not Success then return; end if;

                           Transpiler_Native_HAL.Emit_Indent (Success);
                           if not Success then return; end if;
                           Transpiler_Native_HAL.Emit_Raw
                             ("if (" & Count_Temp & " == 0 || " & Count_Temp & " > " &
                              Cap_Text &
                              ") { printf(""ALB Runtime Trap: SWAPPOP count out of bounds\n""); exit(1); }",
                              Success);
                           if not Success then return; end if;
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           if not Success then return; end if;

                           Transpiler_Native_HAL.Emit_Indent (Success);
                           if not Success then return; end if;
                           Transpiler_Native_HAL.Emit_Raw
                             ("if (" & Index_Temp & " == 0 || " & Index_Temp & " > " &
                              Count_Temp &
                              ") { printf(""ALB Runtime Trap: SWAPPOP index out of bounds\n""); exit(1); }",
                              Success);
                           if not Success then return; end if;
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           if not Success then return; end if;

                           Transpiler_Native_HAL.Emit_Indent (Success);
                           if not Success then return; end if;
                           Transpiler_Native_HAL.Emit_Raw
                             ("if (" & Index_Temp & " != " & Count_Temp & ") {",
                              Success);
                           if not Success then return; end if;
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           if not Success then return; end if;
                           Transpiler_Native_HAL.Increase_Indent;

                           for I in Field_First .. Field_Last loop
                              if Parallel_Fields (I).Active then
                                 declare
                                    Backing_Name : constant String :=
                                      Parallel_Fields (I).Backing_Name
                                        (1 .. Parallel_Fields (I).Backing_Len);
                                 begin
                                    Transpiler_Native_HAL.Emit_Indent (Success);
                                    if not Success then return; end if;
                                    Transpiler_Native_HAL.Emit_Raw
                                      (Backing_Name & "[" & Index_Temp & "] = " &
                                       Backing_Name & "[" & Count_Temp & "];",
                                       Success);
                                    if not Success then return; end if;
                                    Transpiler_Native_HAL.Emit_Newline (Success);
                                    if not Success then return; end if;
                                 end;
                              end if;
                           end loop;

                           Transpiler_Native_HAL.Decrease_Indent;
                           Transpiler_Native_HAL.Emit_Indent (Success);
                           if not Success then return; end if;
                           Transpiler_Native_HAL.Emit_Raw ("}", Success);
                           if not Success then return; end if;
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           if not Success then return; end if;

                           Transpiler_Native_HAL.Emit_Indent (Success);
                           if not Success then return; end if;
                           Transpiler_Native_HAL.Emit_Raw
                             (Count_Name & " = " & Count_Name & " - 1;",
                              Success);
                           if not Success then return; end if;
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           if not Success then return; end if;

                           Transpiler_Native_HAL.Decrease_Indent;
                           Transpiler_Native_HAL.Emit_Indent (Success);
                           if not Success then return; end if;
                           Transpiler_Native_HAL.Emit_Raw ("}", Success);
                           if not Success then return; end if;
                           Transpiler_Native_HAL.Emit_Newline (Success);
                        end;
                     else
                        Walk_AST (Count_Node, Depth + 1, Right_Tag, Success, Diag);
                        if not Success then return; end if;

                        Transpiler_Native_HAL.Emit_Raw ("  test rax, rax", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  jz ALB_Runtime_Trap_Bounds", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  cmp rax, ", Success);
                        Transpiler_Native_HAL.Emit_Literal_U64 (U64 (Parallel_Groups (Group_Idx).Capacity), Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  ja ALB_Runtime_Trap_Bounds", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  push rax", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);

                        Walk_AST (Index_Node, Depth + 1, Right_Tag, Success, Diag);
                        if not Success then return; end if;

                        Transpiler_Native_HAL.Emit_Raw ("  test rax, rax", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  jz ALB_Runtime_Trap_Bounds", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  mov r10, rax", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  mov r11, qword [rsp]", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  cmp r10, r11", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  ja ALB_Runtime_Trap_Bounds", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  je " & Copy_Skip_Label, Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);

                        declare
                           Field_First : constant Natural := Parallel_Groups (Group_Idx).Field_First;
                           Field_Last  : constant Natural := Field_First + Parallel_Groups (Group_Idx).Field_Count - 1;
                        begin
                           for I in Field_First .. Field_Last loop
                              if Parallel_Fields (I).Active then
                                 declare
                                    Backing_Name  : constant String :=
                                      Parallel_Fields (I).Backing_Name
                                        (1 .. Parallel_Fields (I).Backing_Len);
                                    Backing_Sym   : Symbol_Record;
                                    Backing_Found : Boolean := False;
                                    Field_Tag     : ALB_Type_Tag := Type_U64;
                                    Element_Bytes : Natural := 8;
                                 begin
                                    Find_Symbol
                                      (Hash_String (Backing_Name),
                                       Current_Scope,
                                       Backing_Found,
                                       Backing_Sym);

                                    if Backing_Found then
                                       Field_Tag := Backing_Sym.Tag;
                                    end if;

                                    if Field_Tag = Type_U8 or else Field_Tag = Type_HW8 or else Field_Tag = Type_Boolean then
                                       Element_Bytes := 1;
                                    elsif Field_Tag = Type_U16 or else Field_Tag = Type_HW16 then
                                       Element_Bytes := 2;
                                    elsif Field_Tag = Type_U32 or else Field_Tag = Type_S32 or else Field_Tag = Type_HW32 or else Field_Tag = Type_Pure then
                                       Element_Bytes := 4;
                                    else
                                       Element_Bytes := 8;
                                    end if;

                                    Transpiler_Native_HAL.Emit_Raw ("  lea rbx, [", Success);
                                    Transpiler_Native_HAL.Emit_Raw (Backing_Name, Success);
                                    Transpiler_Native_HAL.Emit_Raw ("]", Success);
                                    Transpiler_Native_HAL.Emit_Newline (Success);
                                    Transpiler_Native_HAL.Emit_Raw ("  mov rcx, r11", Success);
                                    Transpiler_Native_HAL.Emit_Newline (Success);
                                    Transpiler_Native_HAL.Emit_Raw ("  mov rdx, r10", Success);
                                    Transpiler_Native_HAL.Emit_Newline (Success);

                                    Transpiler_Native_HAL.Emit_Raw ("  shl rcx, 3", Success);
                                    Transpiler_Native_HAL.Emit_Newline (Success);
                                    Transpiler_Native_HAL.Emit_Raw ("  shl rdx, 3", Success);
                                    Transpiler_Native_HAL.Emit_Newline (Success);

                                    if Element_Bytes = 1 then
                                       Transpiler_Native_HAL.Emit_Raw ("  mov al, byte [rbx + rcx]", Success);
                                       Transpiler_Native_HAL.Emit_Newline (Success);
                                       Transpiler_Native_HAL.Emit_Raw ("  mov byte [rbx + rdx], al", Success);
                                       Transpiler_Native_HAL.Emit_Newline (Success);
                                    elsif Element_Bytes = 2 then
                                       Transpiler_Native_HAL.Emit_Raw ("  mov ax, word [rbx + rcx]", Success);
                                       Transpiler_Native_HAL.Emit_Newline (Success);
                                       Transpiler_Native_HAL.Emit_Raw ("  mov word [rbx + rdx], ax", Success);
                                       Transpiler_Native_HAL.Emit_Newline (Success);
                                    elsif Element_Bytes = 4 then
                                       Transpiler_Native_HAL.Emit_Raw ("  mov eax, dword [rbx + rcx]", Success);
                                       Transpiler_Native_HAL.Emit_Newline (Success);
                                       Transpiler_Native_HAL.Emit_Raw ("  mov dword [rbx + rdx], eax", Success);
                                       Transpiler_Native_HAL.Emit_Newline (Success);
                                    else
                                       Transpiler_Native_HAL.Emit_Raw ("  mov rax, qword [rbx + rcx]", Success);
                                       Transpiler_Native_HAL.Emit_Newline (Success);
                                       Transpiler_Native_HAL.Emit_Raw ("  mov qword [rbx + rdx], rax", Success);
                                       Transpiler_Native_HAL.Emit_Newline (Success);
                                    end if;
                                 end;
                              end if;
                           end loop;
                        end;

                        Transpiler_Native_HAL.Emit_Raw (Copy_Skip_Label & ":", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  mov rax, qword [rsp]", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  add rsp, 8", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  dec rax", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);

                        if Count_Range > 0 then
                           Emit_FASM_Range_Check_RAX (Count_Range);
                           if not Success then return; end if;
                        end if;

                        if Count_Target_Found then
                           Emit_FASM_Store_RAX_To_Scalar (Count_Target, Count_Sym.Tag, Success);
                        else
                           Emit_FASM_Store_RAX_To_Scalar (Count_Lexeme, Count_Sym.Tag, Success);
                        end if;
                        if not Success then return; end if;
                     end if;
                  end;

                  Out_Tag := Type_None;
               end;

            when AST_Strict_Stmt =>
               declare
                  Name_Node    : Node_Index := Tree (Node).Left_Child;
                  Size_Node    : Node_Index := Tree (Node).Right_Child;
                  Type_Node    : Node_Index := Tree (Name_Node).Right_Child;
                  Element_Range : Natural := 0;
                  Element_Tag   : ALB_Type_Tag := Type_U64;
                  Element_Bytes : Natural := 8;
                  Tok          : Token := Tokens (Tree (Name_Node).Token_Index);
                  Lexeme       : String := Input_Buffer (Tok.Start .. Tok.Start + Tok.Length - 1);
                  Target_Name  : constant String := Scoped_Lexeme (Lexeme);
                  Req_Bytes    : Natural := 0;
                  Block_Bounds : RS_Interval;
                  
                  Total_Elements : U64 := 1;
                  Allocated_Elements : U64 := 0;
                  Curr_Bnd       : Node_Index := Size_Node;
               begin
                  Log ("   -> EMIT: STRICT Array Declaration for '" & Lexeme & "'");
                  
                  --  if Type_Node > 0 then
                  --     Element_Range := Find_Range_Type(Raw_Lexeme(Tree(Type_Node).Token_Index));
                  --  
                  --     if Element_Range = 0 then
                  --        Fail_Node(Type_Node, Err_Type_Conflict, Raw_Lexeme(Tree(Type_Node).Token_Index), Success, Diag);
                  --        return;
                  --     end if;
                  --  end if;
                  if Target = Backend_FASM16 then
                     Element_Tag := Type_U16;
                     Element_Bytes := FASM16_Storage_Bytes (Element_Tag);
                  end if;

                  if Type_Node > 0 then
                     declare
                        Type_Lex : constant String := Raw_Lexeme (Tree (Type_Node).Token_Index);
                     begin
                        Element_Range := Find_Range_Type (Type_Lex);

                        if Element_Range > 0 then
                           Element_Tag := Range_Types (Element_Range).Base_Tag;

                        --  elsif Target = Backend_FASM16 then
                        --     Element_Tag := Type_Tag_From_Name (Type_Lex);
                        --  
                        --     if Element_Tag /= Type_U8
                        --       and then Element_Tag /= Type_HW8
                        --       and then Element_Tag /= Type_HW16
                        --       and then Element_Tag /= Type_HW32
                        --       and then Element_Tag /= Type_U16
                        --       and then Element_Tag /= Type_U32
                        --       and then Element_Tag /= Type_S32
                        --       and then Element_Tag /= Type_Pure
                        --       and then Element_Tag /= Type_Boolean
                        --     then
                        --        Fail_Node
                        --          (Type_Node,
                        --           Err_Type_Conflict,
                        --           "FASM16 STRICT arrays support U8, U16, U32, S32 or Boolean",
                        --           Success,
                        --           Diag);
                        --        return;
                        --     end if;

                        --  else
                        --     Fail_Node (Type_Node, Err_Type_Conflict, Type_Lex, Success, Diag);
                        --     return;
                        --  end if;
                        elsif Target = Backend_FASM
                          or else Target = Backend_FASM16
                          or else Target = Backend_C
                        then
                           Element_Tag := Resolve_Type_Name (Type_Lex);
                           if Element_Tag = Type_None then
                              declare
                                 R : constant Natural := Find_Range_Type (Type_Lex);
                              begin
                                 if R > 0 then
                                    Element_Tag := Range_Types (R).Base_Tag;
                                 end if;
                              end;
                           end if;

                           if Element_Tag = Type_None then
                              Fail_Node (Type_Node, Err_Type_Conflict, Type_Lex, Success, Diag);
                              return;
                           end if;

                           if Target = Backend_FASM16
                             and then not Allowed_As_Array_Element
                                  (Element_Tag, Class_Retro_8_16)
                           then
                              Fail_Node
                                (Type_Node,
                                 Err_Type_Conflict,
                                 "FASM16 STRICT arrays support U8, U16, U32, U64, S32, S64, HW8, HW16, HW32, PURE, or Boolean",
                                 Success,
                                 Diag);
                              return;
                           elsif (Target = Backend_FASM or else Target = Backend_C)
                             and then not Allowed_As_Array_Element
                                  (Element_Tag, Class_Modern_Native)
                           then
                              Fail_Node
                                (Type_Node,
                                 Err_Type_Conflict,
                                 "STRICT arrays support scalar numeric/HW/BOOL/CHAR/F32/F64/PURE/U128 (not MAT*)",
                                 Success,
                                 Diag);
                              return;
                           end if;

                        else
                           Fail_Node (Type_Node, Err_Type_Conflict, Type_Lex, Success, Diag);
                           return;
                        end if;

                        if Target = Backend_FASM16 then
                           Element_Bytes := FASM16_Storage_Bytes (Element_Tag);
                        elsif Target = Backend_FASM then
                           Element_Bytes := Array_Element_Bytes (Element_Tag);
                        end if;
                     end;
                  end if;

                  declare
                     Dummy_Tag : ALB_Type_Tag;
                     Dummy_Sym : Symbol_Record;
                  begin
                     -- Local FASM16 STRICT arrays need full byte-sized stack reservation,
                     -- so they are registered manually after total size is known.
                     if not (Target = Backend_FASM16 and then Current_Scope /= 0) then
                        Dummy_Sym :=
                          Resolve_Symbol
                            (Lexeme,
                             Element_Tag,
                             0,
                             True,
                             Dummy_Tag);
                     end if;
                  end;
                  
                  -- 1. DA MULTIDIMENSIONAL SIZE CALCULATION FORGE
                  while Curr_Bnd > 0 loop
                     declare
                        Parsed_Size : U64 := 0;
                     begin
                        Comptime_Eval_Expr (Curr_Bnd, Parsed_Size, Success, Diag);
                        if not Success or else not Diag.Success then
                           Log ("FATAL: STRICT array bounds must be static compile-time expressions.");
                           return;
                        end if;

                        if Parsed_Size = 0 then
                           Fail_Node (Node, Err_Mem_Out_Of_Bounds, Lexeme, Success, Diag);
                           return;
                        end if;

                        Total_Elements := Total_Elements * Parsed_Size;
                     end;
                     Curr_Bnd := Tree (Curr_Bnd).Next_Sibling;
                  end loop;
                  
                  Register_Strict_Array
                    (Target_Name,
                     Size_Node,
                     Node,
                     Success,
                     Diag);

                  if not Success then
                     return;
                  end if;

                  Remember_Array_Element_Tag (Target_Name, Element_Tag);
                  
                  if Element_Range > 0 then
                     Register_Range_Array(Target_Name, Element_Range);
                  end if;


                  -- ALB source arrays are 1-based. Slot 0 is reserved as a sentinel,
                  -- so STRICT Arr[N] must physically reserve N + 1 qwords.
                  if Total_Elements = U64'Last then
                     Log ("FATAL: STRICT Array Allocation overflow.");
                     Success := False;
                     return;
                  end if;

                  Allocated_Elements := Total_Elements + 1;
                  if Target = Backend_FASM16 then
                     if Allocated_Elements > U64 (Natural'Last / Element_Bytes) then
                        Log ("FATAL: STRICT Array Allocation byte overflow.");
                        Success := False;
                        return;
                     end if;
                     Req_Bytes := Natural (Allocated_Elements * U64 (Element_Bytes));
                  elsif Target = Backend_FASM then
                     if Allocated_Elements > U64 (Natural'Last / Element_Bytes) then
                        Log ("FATAL: STRICT Array Allocation byte overflow.");
                        Success := False;
                        return;
                     end if;
                     Req_Bytes := Natural (Allocated_Elements * U64 (Element_Bytes));
                  else
                     Req_Bytes := Natural (Allocated_Elements);
                  end if;
                  
                  if Target = Backend_FASM16 and then Current_Scope /= 0 then
                     declare
                        Local_OK    : Boolean := False;
                        Found_Local : Boolean := False;
                        Dummy_Sym   : Symbol_Record;
                     begin
                        if Req_Bytes = 0 or else Req_Bytes > 16#FFFF# then
                           Fail_Node (Node, Err_Mem_Out_Of_Bounds, Lexeme, Success, Diag);
                           return;
                        end if;

                        Find_Symbol
                          (Hash_String (Target_Name),
                           Current_Scope,
                           Found_Local,
                           Dummy_Sym);

                        if Found_Local then
                           Fail_Node (Node, Err_Type_Conflict, Lexeme, Success, Diag);
                           return;
                        end if;

                        Local_Offset := Local_Offset + Integer (Req_Bytes);

                        Symbol_Table.Add_Local_Symbol
                          (Token_Idx => Hash_String (Target_Name),
                           Tag       => Element_Tag,
                           Ref       => (Target_None, 0),
                           Offset    => -Local_Offset,
                           Struct_ID => 0,
                           Scope     => Current_Scope,
                           Success   => Local_OK);

                        if not Local_OK then
                           Fail_Node (Node, Err_Mem_Out_Of_Bounds, Lexeme, Success, Diag);
                           return;
                        end if;

                        Out_Tag := Type_None;
                        return;
                     end;
                  end if;

                  memory_allocator.Claim_Strict_Block (Pool_Index (Req_Bytes), Block_Bounds, Success);

                  if not Success then
                     Log ("FATAL: STRICT Array Allocation failed! Static Pool exhausted!");
                     return;
                  end if;

                  declare
                     Base_Virtual_Addr : U64 := 16#140020000# + U64 (Long_Integer (Block_Bounds.Lower));
                  begin
                     Log ("   -> MAPPED: STRICT Array '" & Lexeme & "' to Virtual Address: 0x" & Base_Virtual_Addr'Image);
                  end;

                  -- 2. DA NATIVE EMISSION MULTIDIMENSIONAL LOOP (BYPASSING ALB_V)
                  if Target = Backend_FASM then
                     -- Force FASM arrays intae the Global Vault sae they dinna block execution!
                     Transpiler_Native_HAL.Set_Global_Buffer_Mode (True);

                     declare
                        Directive : constant String :=
                          (if Element_Bytes = 1 then "rb"
                           elsif Element_Bytes = 2 then "rw"
                           elsif Element_Bytes = 4 then "rd"
                           else "rq");
                     begin
                        Transpiler_Native_HAL.Emit_Raw
                          ("  " & Target_Name & " " & Directive & " ",
                           Success);
                     end;
                     Transpiler_Native_HAL.Emit_Literal_U64 (Allocated_Elements, Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);

                     Transpiler_Native_HAL.Emit_Raw ("  sizeof." & Target_Name & " = ", Success);
                     Transpiler_Native_HAL.Emit_Literal_U64
                       (Allocated_Elements * U64 (Element_Bytes),
                        Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);

                     Transpiler_Native_HAL.Set_Global_Buffer_Mode (False);
                     
                  elsif Target = Backend_FASM16 then
                     declare
                        Directive : constant String :=
                           (if Element_Tag = Type_U8
                              or else Element_Tag = Type_HW8
                              or else Element_Tag = Type_Boolean
                            then "db"
                            elsif Element_Tag = Type_U32
                              or else Element_Tag = Type_S32
                              or else Element_Tag = Type_HW32
                              or else Element_Tag = Type_Pure
                            then "dd"
                            else "dw");
                     begin
                        Transpiler_Native_HAL.Set_Global_Buffer_Mode (True);

                        Transpiler_Native_HAL.Emit_Raw ("  " & Target_Name & " " & Directive & " ", Success);
                        Transpiler_Native_HAL.Emit_Literal_U64 (Allocated_Elements, Success);
                        Transpiler_Native_HAL.Emit_Raw (" dup (0)", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);

                        Transpiler_Native_HAL.Emit_Raw ("  sizeof." & Target_Name & " = ", Success);
                        Transpiler_Native_HAL.Emit_Literal_U64
                          (Allocated_Elements * U64 (Element_Bytes),
                           Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);

                        Transpiler_Native_HAL.Set_Global_Buffer_Mode (False);
                     end;
                     
                  elsif Target = Backend_C then
                     if Current_Scope = 0 then
                        Transpiler_Native_HAL.Set_Global_Buffer_Mode (True);
                     end if;
                     
                     Transpiler_Native_HAL.Emit_Indent (Success);
                     Transpiler_Native_HAL.Emit_Type_Definition (Element_Tag, Success);
                     Transpiler_Native_HAL.Emit_Raw (" " & Target_Name, Success);
                     Curr_Bnd := Size_Node;
                     while Curr_Bnd > 0 loop
                        declare
                           Parsed_Size : U64 := 0;
                        begin
                           Comptime_Eval_Expr (Curr_Bnd, Parsed_Size, Success, Diag);
                           if not Success or else not Diag.Success then
                              Log ("FATAL: STRICT array bounds must be static compile-time expressions.");
                              return;
                           end if;
                           if Parsed_Size = U64'Last then
                              Log ("FATAL: STRICT Array Allocation overflow.");
                              Success := False;
                              return;
                           end if;
                           Transpiler_Native_HAL.Emit_Raw ("[", Success);
                           Transpiler_Native_HAL.Emit_Literal_U64 (Parsed_Size + 1, Success);
                        end;
                        Transpiler_Native_HAL.Emit_Raw ("]", Success);
                        Curr_Bnd := Tree (Curr_Bnd).Next_Sibling;
                     end loop;
                     
                     Transpiler_Native_HAL.Emit_Raw (" = {0};", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     if Current_Scope = 0 then
                        Transpiler_Native_HAL.Set_Global_Buffer_Mode (False);
                     end if;
                  end if;
                  
                  if Current_Scope = 0 then
                     Register_Chrono_Global(Target_Name, False, Node, Success, Diag);
                     if not Success then return; end if;
                  end if;

                  
                  Out_Tag := Type_None;
               end;
               
            
            when AST_Comptime_Block =>
               if Target /= Backend_C
                 and then Target /= Backend_FASM
                 and then Target /= Backend_FASM16
               then
                  Fail_Node(Node, Err_Type_Conflict, "COMPTIME", Success, Diag);
                  return;
               end if;

               if Current_Scope /= 0 then
                  Fail_Node(Node, Err_Compiler_AST_Mismatch, "COMPTIME", Success, Diag);
                  return;
               end if;

               if not Comptime_Preload_Done then
                  Comptime_Execute(Tree(Node).Left_Child, Success, Diag);
               end if;

               Out_Tag := Type_None;


               
            when AST_Slide_Stmt =>
               declare
                  Name_Node    : Node_Index := Tree (Node).Left_Child;
                  Max_Node     : Node_Index := Tree (Node).Right_Child;
                  Act_Node     : Node_Index := Tree (Max_Node).Next_Sibling;
                  Type_Node    : Node_Index := Tree (Name_Node).Right_Child;
                  Element_Range : Natural := 0;
                  Element_Tag  : ALB_Type_Tag := Type_U64;
                  Element_Bytes : Natural := 8;
                  Tok          : Token := Tokens (Tree (Name_Node).Token_Index);
                  Lexeme       : String := Input_Buffer (Tok.Start .. Tok.Start + Tok.Length - 1);
                  Target_Name  : constant String := Scoped_Lexeme (Lexeme);
                  Max_Bytes, Act_Bytes : Natural := 0;
                  Max_Claim_Bytes, Act_Claim_Bytes : Natural := 0;
                  Block_Bounds : RS_Interval;
               begin
                  Log ("   -> EMIT: SLIDE Array Declaration for '" & Lexeme & "'");
                  
                  if Target = Backend_FASM16 then
                     Element_Tag := Type_U16;
                     Element_Bytes := FASM16_Storage_Bytes (Element_Tag);
                  end if;

                  if Type_Node > 0 then
                     declare
                        Type_Lex : constant String := Raw_Lexeme (Tree (Type_Node).Token_Index);
                     begin
                        Element_Range := Find_Range_Type (Type_Lex);

                        if Element_Range > 0 then
                           Element_Tag := Range_Types (Element_Range).Base_Tag;

                        --  elsif Target = Backend_FASM16 then
                        --     Element_Tag := Type_Tag_From_Name (Type_Lex);
                        --  
                        --     if Element_Tag /= Type_U8
                        --       and then Element_Tag /= Type_HW8
                        --       and then Element_Tag /= Type_HW16
                        --       and then Element_Tag /= Type_HW32
                        --       and then Element_Tag /= Type_U16
                        --       and then Element_Tag /= Type_U32
                        --       and then Element_Tag /= Type_S32
                        --       and then Element_Tag /= Type_Pure
                        --       and then Element_Tag /= Type_Boolean
                        --     then
                        --        Fail_Node
                        --          (Type_Node,
                        --           Err_Type_Conflict,
                        --           "FASM16 SLIDE arrays support U8, U16, U32, S32, or Boolean",
                        --           Success,
                        --           Diag);
                        --        return;
                        --     end if;
                        --  
                        --  else
                        --     Fail_Node (Type_Node, Err_Type_Conflict, Type_Lex, Success, Diag);
                        --     return;
                        --  end if;
                        elsif Target = Backend_FASM
                          or else Target = Backend_FASM16
                          or else Target = Backend_C
                        then
                           Element_Tag := Resolve_Type_Name (Type_Lex);
                           if Element_Tag = Type_None then
                              declare
                                 R : constant Natural := Find_Range_Type (Type_Lex);
                              begin
                                 if R > 0 then
                                    Element_Tag := Range_Types (R).Base_Tag;
                                 end if;
                              end;
                           end if;

                           if Element_Tag = Type_None then
                              Fail_Node (Type_Node, Err_Type_Conflict, Type_Lex, Success, Diag);
                              return;
                           end if;

                           if Target = Backend_FASM16
                             and then not Allowed_As_Array_Element
                                  (Element_Tag, Class_Retro_8_16)
                           then
                              Fail_Node
                                (Type_Node,
                                 Err_Type_Conflict,
                                 "FASM16 SLIDE arrays support U8, U16, U32, U64, S32, S64, HW8, HW16, HW32, PURE, or Boolean",
                                 Success,
                                 Diag);
                              return;
                           elsif (Target = Backend_FASM or else Target = Backend_C)
                             and then not Allowed_As_Array_Element
                                  (Element_Tag, Class_Modern_Native)
                           then
                              Fail_Node
                                (Type_Node,
                                 Err_Type_Conflict,
                                 "SLIDE arrays support scalar numeric/HW/BOOL/CHAR/F32/F64/PURE/U128 (not MAT*)",
                                 Success,
                                 Diag);
                              return;
                           end if;

                        else
                           Fail_Node (Type_Node, Err_Type_Conflict, Type_Lex, Success, Diag);
                           return;
                        end if;

                        if Target = Backend_FASM16 then
                           Element_Bytes := FASM16_Storage_Bytes (Element_Tag);
                        elsif Target = Backend_FASM then
                           Element_Bytes := Array_Element_Bytes (Element_Tag);
                        end if;
                     end;
                  end if;
                  
                  declare
                     Dummy_Tag : ALB_Type_Tag;
                     Dummy_Sym : Symbol_Record;
                  begin
                     -- Local FASM16 SLIDE arrays need full byte-sized stack reservation,
                     -- so they are registered manually after max/active sizes are known.
                     if not (Target = Backend_FASM16 and then Current_Scope /= 0) then
                        Dummy_Sym :=
                          Resolve_Symbol
                            (Lexeme,
                             Element_Tag,
                             0,
                             True,
                             Dummy_Tag);
                     end if;
                  end;
                  
                  if Tree (Max_Node).Kind = AST_Number_Expr then
                     declare
                        Size_Tok    : Token := Tokens (Tree (Max_Node).Token_Index);
                        Size_Lex    : String := Input_Buffer (Size_Tok.Start .. Size_Tok.Start + Size_Tok.Length - 1);
                        Parsed_Size : U64 := 0;
                        Parse_OK    : Boolean := False;
                     begin
                        if Tree (Max_Node).Kind = AST_Number_Expr then
                           Parse_Decimal (Size_Lex, Parsed_Size, Parse_OK);
                        elsif Tree (Max_Node).Kind = AST_Hex_Expr then
                           Parse_Hex (Size_Lex, Parsed_Size, Parse_OK);
                        elsif Tree (Max_Node).Kind = AST_Octal_Expr then
                           Parse_Octal (Size_Lex, Parsed_Size, Parse_OK);
                        else
                           Fail_Node (Node, Err_Compiler_AST_Mismatch, Lexeme, Success, Diag);
                           return;
                        end if;

                        if not Parse_OK
                          or else Parsed_Size = 0
                          or else Parsed_Size > U64 (Natural'Last)
                        then
                           Fail_Node (Node, Err_Mem_Out_Of_Bounds, Lexeme, Success, Diag);
                           return;
                        end if;

                        Max_Bytes := Natural (Parsed_Size);
                     end;
                  end if;

                  if Tree (Act_Node).Kind = AST_Number_Expr then
                     declare
                        Size_Tok    : Token := Tokens (Tree (Act_Node).Token_Index);
                        Size_Lex    : String := Input_Buffer (Size_Tok.Start .. Size_Tok.Start + Size_Tok.Length - 1);
                        Parsed_Size : U64 := 0;
                        Parse_OK    : Boolean := False;
                     begin
                        if Tree (Act_Node).Kind = AST_Number_Expr then
                           Parse_Decimal (Size_Lex, Parsed_Size, Parse_OK);
                        elsif Tree (Act_Node).Kind = AST_Hex_Expr then
                           Parse_Hex (Size_Lex, Parsed_Size, Parse_OK);
                        elsif Tree (Act_Node).Kind = AST_Octal_Expr then
                           Parse_Octal (Size_Lex, Parsed_Size, Parse_OK);
                        else
                           Fail_Node (Node, Err_Compiler_AST_Mismatch, Lexeme, Success, Diag);
                           return;
                        end if;

                        if not Parse_OK
                          or else Parsed_Size = 0
                          or else Parsed_Size > U64 (Natural'Last)
                        then
                           Fail_Node (Node, Err_Mem_Out_Of_Bounds, Lexeme, Success, Diag);
                           return;
                        end if;

                        Act_Bytes := Natural (Parsed_Size);
                     end;
                  end if;
                  
                  
                  Register_Slide_Array
                    (Target_Name,
                     Max_Bytes,
                     Act_Bytes,
                     Node,
                     Success,
                     Diag);

                  if not Success then
                     return;
                  end if;

                  -- SLIDE is source-visible only through its active window.
                  -- Reuse the proven array bounds table so B[0], B[Active+1],
                  -- and wrong arity are caught exactly like STRICT.
                  Register_Strict_Array
                    (Target_Name,
                     Act_Node,
                     Node,
                     Success,
                     Diag);

                  if not Success then
                     return;
                  end if;

                  Remember_Array_Element_Tag (Target_Name, Element_Tag);

                  if Element_Range > 0 then
                     Register_Range_Array(Target_Name, Element_Range);
                  end if;
                  
                  if Target = Backend_FASM16 and then Current_Scope /= 0 then
                     declare
                        Allocated_Bytes  : U64 := 0;
                        Local_OK         : Boolean := False;
                        Found_Local      : Boolean := False;
                        Dummy_Sym        : Symbol_Record;
                     begin
                        if U64 (Max_Bytes + 1) > U64 (Natural'Last / Element_Bytes) then
                           Fail_Node (Node, Err_Mem_Out_Of_Bounds, Lexeme, Success, Diag);
                           return;
                        end if;

                        Allocated_Bytes := U64 (Max_Bytes + 1) * U64 (Element_Bytes);

                        if Allocated_Bytes = 0 or else Allocated_Bytes > U64 (16#FFFF#) then
                           Fail_Node (Node, Err_Mem_Out_Of_Bounds, Lexeme, Success, Diag);
                           return;
                        end if;

                        Find_Symbol
                          (Hash_String (Target_Name),
                           Current_Scope,
                           Found_Local,
                           Dummy_Sym);

                        if Found_Local then
                           Fail_Node (Node, Err_Type_Conflict, Lexeme, Success, Diag);
                           return;
                        end if;

                        Local_Offset := Local_Offset + Integer (Allocated_Bytes);

                        Symbol_Table.Add_Local_Symbol
                          (Token_Idx => Hash_String (Target_Name),
                           Tag       => Element_Tag,
                           Ref       => (Target_None, 0),
                           Offset    => -Local_Offset,
                           Struct_ID => 0,
                           Scope     => Current_Scope,
                           Success   => Local_OK);

                        if not Local_OK then
                           Fail_Node (Node, Err_Mem_Out_Of_Bounds, Lexeme, Success, Diag);
                           return;
                        end if;

                        Out_Tag := Type_None;
                        return;
                     end;
                  end if;

                  --memory_allocator.Claim_Sliding_Block (Pool_Index (Max_Bytes), Pool_Index (Act_Bytes), Block_Bounds, Success);
                  if Target = Backend_FASM16 then
                     if U64 (Max_Bytes + 1) > U64 (Natural'Last / Element_Bytes)
                       or else U64 (Act_Bytes + 1) > U64 (Natural'Last / Element_Bytes)
                     then
                        Log ("FATAL: SLIDE Array Allocation byte overflow.");
                        Success := False;
                        return;
                     end if;

                     Max_Claim_Bytes := Natural (U64 (Max_Bytes + 1) * U64 (Element_Bytes));
                     Act_Claim_Bytes := Natural (U64 (Act_Bytes + 1) * U64 (Element_Bytes));
                  elsif Target = Backend_FASM then
                     if U64 (Max_Bytes + 1) > U64 (Natural'Last / Element_Bytes)
                       or else U64 (Act_Bytes + 1) > U64 (Natural'Last / Element_Bytes)
                     then
                        Log ("FATAL: SLIDE Array Allocation byte overflow.");
                        Success := False;
                        return;
                     end if;

                     Max_Claim_Bytes := Natural (U64 (Max_Bytes + 1) * U64 (Element_Bytes));
                     Act_Claim_Bytes := Natural (U64 (Act_Bytes + 1) * U64 (Element_Bytes));
                  else
                     Max_Claim_Bytes := Max_Bytes;
                     Act_Claim_Bytes := Act_Bytes;
                  end if;

                  memory_allocator.Claim_Sliding_Block
                    (Pool_Index (Max_Claim_Bytes),
                     Pool_Index (Act_Claim_Bytes),
                     Block_Bounds,
                     Success);
                  if not Success then
                     Log ("FATAL: SLIDE Array Allocation failed!");
                     return;
                  end if;

                  declare
                     Base_Virtual_Addr : U64 := 16#140020000# + U64 (Long_Integer (Block_Bounds.Lower));
                  begin
                     Log ("   -> MAPPED: SLIDE '" & Lexeme & "' to Virtual Address: 0x" & Base_Virtual_Addr'Image);
                  end;

                  -- 3. DA NATIVE EMISSION: Bypassing Emit_Slide_Array_Decl for pure literal injection
                  if Target = Backend_FASM then
                     -- Force FASM arrays intae the Global Vault!
                     Transpiler_Native_HAL.Set_Global_Buffer_Mode (True);

                     declare
                        Directive : constant String :=
                          (if Element_Bytes = 1 then "rb"
                           elsif Element_Bytes = 2 then "rw"
                           elsif Element_Bytes = 4 then "rd"
                           else "rq");
                     begin
                        Transpiler_Native_HAL.Emit_Raw
                          ("  " & Target_Name & " " & Directive & " ",
                           Success);
                     end;
                     Transpiler_Native_HAL.Emit_Literal_U64 (U64 (Max_Bytes + 1), Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);

                     Transpiler_Native_HAL.Emit_Raw ("  sizeof." & Target_Name & " = ", Success);
                     Transpiler_Native_HAL.Emit_Literal_U64
                       (U64 (Max_Bytes + 1) * U64 (Element_Bytes),
                        Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);

                     Transpiler_Native_HAL.Set_Global_Buffer_Mode (False);
                     
                  elsif Target = Backend_FASM16 then
                     declare
                         Directive : constant String :=
                           (if Element_Tag = Type_U8
                              or else Element_Tag = Type_HW8
                              or else Element_Tag = Type_Boolean
                            then "db"
                            elsif Element_Tag = Type_U32
                              or else Element_Tag = Type_S32
                              or else Element_Tag = Type_HW32
                              or else Element_Tag = Type_Pure
                            then "dd"
                            else "dw");
                     begin
                        Transpiler_Native_HAL.Set_Global_Buffer_Mode (True);

                        Transpiler_Native_HAL.Emit_Raw ("  " & Target_Name & " " & Directive & " ", Success);
                        Transpiler_Native_HAL.Emit_Literal_U64 (U64 (Max_Bytes + 1), Success);
                        Transpiler_Native_HAL.Emit_Raw (" dup (0)", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);

                        Transpiler_Native_HAL.Emit_Raw ("  sizeof." & Target_Name & " = ", Success);
                        Transpiler_Native_HAL.Emit_Literal_U64
                          (U64 (Max_Bytes + 1) * U64 (Element_Bytes),
                           Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);

                        Transpiler_Native_HAL.Set_Global_Buffer_Mode (False);
                     end;

                  elsif Target = Backend_C then
                     if Current_Scope = 0 then Transpiler_Native_HAL.Set_Global_Buffer_Mode (True); end if;
                     Transpiler_Native_HAL.Emit_Indent (Success);
                     Transpiler_Native_HAL.Emit_Type_Definition (Element_Tag, Success);
                     Transpiler_Native_HAL.Emit_Raw (" " & Target_Name & "[", Success);
                     Transpiler_Native_HAL.Emit_Literal_U64 (U64 (Max_Bytes + 1), Success);
                     
                     Transpiler_Native_HAL.Emit_Raw ("] = {0};", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     
                     if Current_Scope = 0 then Transpiler_Native_HAL.Set_Global_Buffer_Mode (False); end if;
                  end if;
                  
                  if Current_Scope = 0 then
                     Register_Chrono_Global(Target_Name, False, Node, Success, Diag);
                     if not Success then return; end if;
                  end if;
                  

                  Out_Tag := Type_None;
               end;
            
            when AST_Claim_Stmt =>
               declare
                  Var_Node : Node_Index := Tree(Node).Left_Child;
                  Tok      : Token := Tokens(Tree(Var_Node).Token_Index);
                  Lexeme   : String := Input_Buffer(Tok.Start .. Tok.Start + Tok.Length - 1);
               begin
                  if Target = Backend_FASM then
                     declare
                        Target_Lex : constant String := Scoped_Lexeme (Lexeme);
                     begin
                        Transpiler_Native_HAL.Emit_Raw ("  lea rcx, [" & Target_Lex & "]", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  call ALB_GC_Claim", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                     end;

                  elsif Target = Backend_FASM16 then
                     declare
                        Target_Lex : constant String := Scoped_Lexeme (Lexeme);
                        Found      : Boolean := False;
                        Sym        : Symbol_Record;
                     begin
                        Find_Symbol (Hash_String (Target_Lex), Current_Scope, Found, Sym);
                        if not Found then
                           Find_Symbol (Hash_String (Lexeme), Current_Scope, Found, Sym);
                        end if;

                        if not Found then
                           Fail_Node (Node, Err_Type_Conflict, Lexeme, Success, Diag);
                           return;
                        end if;

                        if Sym.Tag = Type_U8 or else Sym.Tag = Type_Boolean then
                           Fail_Node (Node, Err_Type_Conflict, Lexeme, Success, Diag);
                           return;
                        end if;

                        Transpiler_Native_HAL.Emit_Raw ("  call ALB16_GC_Claim", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        
                        
                        if Sym.Class = Class_Local and then Sym.Offset < 0 then
                           declare
                              Img : constant String := Integer'Image (-Sym.Offset);
                              Off : constant String := Img (Img'First + 1 .. Img'Last);
                           begin
                              Transpiler_Native_HAL.Emit_Raw ("  mov word [bp-" & Off & "], ax", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                           end;
                        elsif Sym.Class = Class_Local and then Sym.Offset > 0 then
                           declare
                              Img : constant String := Integer'Image (Sym.Offset);
                              Off : constant String := Img (Img'First + 1 .. Img'Last);
                           begin
                              Transpiler_Native_HAL.Emit_Raw ("  mov word [bp+" & Off & "], ax", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                           end;
                        else
                           Transpiler_Native_HAL.Emit_Raw ("  mov word [" & Target_Lex & "], ax", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                        end if;
                     end;

                  else
                     Transpiler_Native_HAL.Emit_Claim(Lexeme, Success);
                  end if;
               end;
               
           when AST_Drop_Stmt =>
               declare
                  Var_Node : Node_Index := Tree(Node).Left_Child;
                  Tok      : Token := Tokens(Tree(Var_Node).Token_Index);
                  Lexeme   : String := Input_Buffer(Tok.Start .. Tok.Start + Tok.Length - 1);
               begin
                  if Target = Backend_FASM then
                     Walk_AST (Var_Node, Depth + 1, Right_Tag, Success, Diag);
                     Transpiler_Native_HAL.Emit_Raw ("  mov rcx, rax", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Emit_Raw ("  call ALB_GC_Drop", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);

                  elsif Target = Backend_FASM16 then
                     Walk_AST (Var_Node, Depth + 1, Right_Tag, Success, Diag);
                     if not Success then
                        return;
                     end if;

                     Transpiler_Native_HAL.Emit_Raw ("  call ALB16_GC_Drop", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);

                  else
                     Transpiler_Native_HAL.Emit_Drop(Lexeme, Success);
                  end if;
               end;
               
            when AST_Sweep_Stmt =>
               declare
                  Chunk_Node : Node_Index := Tree(Node).Left_Child;
               begin
                  if Target = Backend_FASM then
                     Walk_AST (Chunk_Node, Depth + 1, Right_Tag, Success, Diag);
                     Transpiler_Native_HAL.Emit_Raw ("  mov rcx, rax", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Emit_Raw ("  call ALB_GC_Sweep", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);

                  elsif Target = Backend_FASM16 then
                     Walk_AST (Chunk_Node, Depth + 1, Right_Tag, Success, Diag);
                     if not Success then
                        return;
                     end if;

                     Transpiler_Native_HAL.Emit_Raw ("  call ALB16_GC_Sweep", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);

                  else
                     Transpiler_Native_HAL.Emit_Indent(Success);
                     Transpiler_Native_HAL.Emit_Raw("ALB_GC_Sweep(", Success);
                     Walk_AST(Chunk_Node, Depth + 1, Right_Tag, Success, Diag);
                     Transpiler_Native_HAL.Emit_Raw(");", Success);
                     Transpiler_Native_HAL.Emit_Newline(Success);
                  end if;
               end;
               
               
           when AST_Bind_Stmt =>
               declare
                  Parent_Node : Node_Index := Tree(Node).Left_Child;
                  Tok         : Token := Tokens(Tree(Parent_Node).Token_Index);
                  Parent_Lex  : String := Input_Buffer(Tok.Start .. Tok.Start + Tok.Length - 1);

                  Arg_List : Node_Index := Tree(Node).Right_Child;
                  Child1   : Node_Index := 0;
                  Child2   : Node_Index := 0;
               begin
                  if Target = Backend_FASM then
                     if Arg_List > 0 then
                        Child1 := Tree(Arg_List).Left_Child;
                        if Child1 > 0 then
                           Child2 := Tree(Child1).Next_Sibling;
                        end if;
                     end if;

                     Walk_AST (Parent_Node, Depth + 1, Right_Tag, Success, Diag);
                     Transpiler_Native_HAL.Emit_Raw ("  push rax", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);

                     if Child1 > 0 then
                        Walk_AST (Child1, Depth + 1, Right_Tag, Success, Diag);
                     else
                        Transpiler_Native_HAL.Emit_Raw ("  xor rax, rax", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                     end if;
                     Transpiler_Native_HAL.Emit_Raw ("  push rax", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);

                     if Child2 > 0 then
                        Walk_AST (Child2, Depth + 1, Right_Tag, Success, Diag);
                     else
                        Transpiler_Native_HAL.Emit_Raw ("  xor rax, rax", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                     end if;

                     Transpiler_Native_HAL.Emit_Raw ("  mov r8, rax", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Emit_Raw ("  pop rdx", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Emit_Raw ("  pop rcx", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Emit_Raw ("  call ALB_GC_Bind", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);

                  elsif Target = Backend_FASM16 then
                     if Arg_List > 0 then
                        Child1 := Tree(Arg_List).Left_Child;
                        if Child1 > 0 then
                           Child2 := Tree(Child1).Next_Sibling;
                        end if;
                     end if;

                     Walk_AST (Parent_Node, Depth + 1, Right_Tag, Success, Diag);
                     if not Success then
                        return;
                     end if;
                     Transpiler_Native_HAL.Emit_Raw ("  push ax", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);

                     if Child1 > 0 then
                        Walk_AST (Child1, Depth + 1, Right_Tag, Success, Diag);
                        if not Success then
                           return;
                        end if;
                     else
                        Transpiler_Native_HAL.Emit_Raw ("  xor ax, ax", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                     end if;
                     Transpiler_Native_HAL.Emit_Raw ("  mov bx, ax", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);

                     if Child2 > 0 then
                        Walk_AST (Child2, Depth + 1, Right_Tag, Success, Diag);
                        if not Success then
                           return;
                        end if;
                     else
                        Transpiler_Native_HAL.Emit_Raw ("  xor ax, ax", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                     end if;
                     Transpiler_Native_HAL.Emit_Raw ("  mov dx, ax", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);

                     Transpiler_Native_HAL.Emit_Raw ("  pop ax", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Emit_Raw ("  call ALB16_GC_Bind", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);

                  else
                     if Arg_List > 0 then
                        Child1 := Tree(Arg_List).Left_Child;
                        if Child1 > 0 then
                           Child2 := Tree(Child1).Next_Sibling;
                        end if;
                     end if;

                     Transpiler_Native_HAL.Emit_Indent(Success);
                     Transpiler_Native_HAL.Emit_Raw("ALB_GC_Bind(" & Parent_Lex & ", ", Success);

                     if Child1 > 0 then Walk_AST(Child1, Depth+1, Right_Tag, Success, Diag); else Transpiler_Native_HAL.Emit_Raw("0", Success); end if;
                     Transpiler_Native_HAL.Emit_Raw(", ", Success);
                     if Child2 > 0 then Walk_AST(Child2, Depth+1, Right_Tag, Success, Diag); else Transpiler_Native_HAL.Emit_Raw("0", Success); end if;

                     Transpiler_Native_HAL.Emit_Raw(");", Success);
                     Transpiler_Native_HAL.Emit_Newline(Success);
                  end if;
               end;

          
            when AST_Read_Process_Memory_Expr =>
               declare
                  Handle_Node : constant Node_Index := Tree (Node).Left_Child;
                  Addr_Node   : constant Node_Index := Tree (Node).Right_Child;
                  Type_Node   : constant Node_Index :=
                    (if Addr_Node > 0 then Tree (Addr_Node).Next_Sibling else 0);
                  Handle_Name : constant String := Process_Handle_Name (Handle_Node);
                  Scalar_Tag  : constant ALB_Type_Tag := Process_Scalar_Tag_From_Node (Type_Node);
               begin
                  if Target /= Backend_FASM and then Target /= Backend_C then
                     Fail_Node (Node, Err_Type_Conflict, "READ_PROCESS_MEMORY", Success, Diag);
                     return;
                  end if;

                  if Handle_Name'Length = 0 or else Addr_Node = 0 or else Scalar_Tag = Type_None then
                     Fail_Node (Node, Err_Type_Conflict, "READ_PROCESS_MEMORY", Success, Diag);
                     return;
                  end if;

                  if Target = Backend_C then
                     -- Track 7 (C): scalar-expression read produces a uint64_t.
                     -- We use a comma expression to lazily open the process
                     -- handle if it has not been opened yet.
                     Ensure_Process_Runtime_C;
                     Transpiler_Native_HAL.Emit_Raw
                       ("(ALB_PROC_Ensure(&" & Handle_Name &
                        ", ALB_PROCCFG_" & Handle_Name &
                        "_PID, ALB_PROCCFG_" & Handle_Name &
                        "_IMAGE_C, ALB_PROCCFG_" & Handle_Name &
                        "_Rights), ALB_PROC_Read_Scalar(" & Handle_Name & ", (uint64_t)(",
                        Success);
                     Walk_AST (Addr_Node, Depth + 1, Right_Tag, Success, Diag);
                     if not Success then return; end if;
                     Transpiler_Native_HAL.Emit_Raw ("), 8))", Success);
                     Out_Tag := Scalar_Tag;
                     return;
                  end if;

                  Walk_AST (Addr_Node, Depth + 1, Right_Tag, Success, Diag);
                  if not Success then
                     return;
                  end if;

                  Transpiler_Native_HAL.Emit_Raw ("  mov r10, rax", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);

                  Emit_FASM_Process_Config_Load
                    (Handle_Node,
                     Proc_Right_Read or Proc_Right_Query,
                     Node,
                     Success,
                     Diag);
                  if not Success then
                     return;
                  end if;

                  Transpiler_Native_HAL.Emit_Raw ("  sub rsp, 64", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);
                  Transpiler_Native_HAL.Emit_Raw ("  mov qword [rsp + 32], r10", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);
                  Transpiler_Native_HAL.Emit_Raw
                    ("  mov qword [rsp + 40], " &
                     Nat_Img (Process_Scalar_Code (Scalar_Tag)),
                     Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);
                  Transpiler_Native_HAL.Emit_Raw ("  call ALB_PROC_Read_Scalar", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);
                  Transpiler_Native_HAL.Emit_Raw ("  add rsp, 64", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);

                  Out_Tag := Scalar_Tag;
               end;

            when AST_AddressOf | AST_Ref_Expr =>
               declare
                  Target_Node : Node_Index := Tree (Node).Left_Child;
               begin
                  if Target = Backend_FASM then
                     -- DA FIX: We maun pass the ADDRESS of the variable in FASM!
                     if Tree (Target_Node).Kind = AST_Var_Expr then
                        declare
                           Tok        : Token := Tokens (Tree (Target_Node).Token_Index);
                           Lex        : String := Input_Buffer (Tok.Start .. Tok.Start + Tok.Length - 1);
                           Target_Lex : constant String := Scoped_Lexeme (Lex);
                        begin
                           Transpiler_Native_HAL.Emit_Raw ("  lea rax, [", Success);
                           Transpiler_Native_HAL.Emit_Raw (Target_Lex, Success);
                           Transpiler_Native_HAL.Emit_Raw ("]", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                        end;
                     else
                        Walk_AST (Target_Node, Depth + 1, Out_Tag, Success, Diag);
                     end if;
                  elsif Target = Backend_FASM16 then
                     Emit_FASM16_Address_Of_Node (Target_Node);
                  else
                     Transpiler_Native_HAL.Emit_AddressOf (Success);
                     Walk_AST (Target_Node, Depth + 1, Out_Tag, Success, Diag);
                  end if;

                  if Target = Backend_FASM16 then
                     Out_Tag := Type_U16;
                  else
                     Out_Tag := Type_U64;
                  end if;
               end;

               
            when AST_Peek_Expr | AST_Deref_Expr =>
               if Target = Backend_FASM then
                  -- Evaluate Address -> rax, then read the memory it points tae!
                  Walk_AST (Tree (Node).Left_Child, Depth + 1, Left_Tag, Success, Diag);
                  Transpiler_Native_HAL.Emit_Raw ("  mov rax, qword [rax]", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);
                  Out_Tag := Type_U64;
               elsif Target = Backend_FASM16 then
                  declare
                     Load_Tag : constant ALB_Type_Tag :=
                       FASM16_Addressed_Tag
                         (Tree (Node).Left_Child,
                          0);
                  begin
                     Walk_AST (Tree (Node).Left_Child, Depth + 1, Left_Tag, Success, Diag);
                     if not Success then
                        return;
                     end if;

                     Transpiler_Native_HAL.Emit_Raw ("  mov bx, ax", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Emit_FASM16_Load_Ptr_To_DXAX (Load_Tag);
                     Out_Tag := FASM16_Normalize_Memory_Tag (Load_Tag);
                  end;
               else
                  if Tree (Node).Kind = AST_Peek_Expr then
                     Transpiler_Native_HAL.Emit_Peek_Start (Success); -- (*(uint64_t*)(uintptr_t)(
                  else
                     Transpiler_Native_HAL.Emit_Deref_Start (Success);
                  end if;
                  Walk_AST (Tree (Node).Left_Child, Depth + 1, Left_Tag, Success, Diag);
                  Transpiler_Native_HAL.Emit_Expression_Close (Success); -- )
                  Transpiler_Native_HAL.Emit_Expression_Close (Success); -- )
                  Out_Tag := Type_U64;
               end if;
               
            when AST_Unary_Minus =>
               declare
                  Child_Tag : constant ALB_Type_Tag := Infer_Type_Tag (Tree (Node).Left_Child);
               begin
               if Target = Backend_FASM16 then
                  Walk_AST (Tree (Node).Left_Child, Depth + 1, Out_Tag, Success, Diag);
                  Transpiler_Native_HAL.Emit_Raw ("  neg ax", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);
                  Transpiler_Native_HAL.Emit_Raw ("  adc dx, 0", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);
                  Transpiler_Native_HAL.Emit_Raw ("  neg dx", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);
               elsif Target = Backend_FASM then
                  Walk_AST (Tree (Node).Left_Child, Depth + 1, Out_Tag, Success, Diag);
                  if Child_Tag = Type_F64 then
                     Transpiler_Native_HAL.Emit_Raw ("  btc rax, 63", Success);
                  else
                     Transpiler_Native_HAL.Emit_Raw ("  neg rax", Success);
                  end if;
                  Transpiler_Native_HAL.Emit_Newline (Success);
               else
                  Transpiler_Native_HAL.Emit_Raw ("-(", Success);
                  Walk_AST (Tree (Node).Left_Child, Depth + 1, Out_Tag, Success, Diag);
                  Transpiler_Native_HAL.Emit_Raw (")", Success);
               end if;
               if Child_Tag = Type_F64 then
                  Out_Tag := Type_F64;
               else
                  Out_Tag := Type_S32;
               end if;
               end;
               
            when AST_Not =>
               if Target = Backend_FASM16 then
                  Walk_AST (Tree (Node).Left_Child, Depth + 1, Out_Tag, Success, Diag);
                  Transpiler_Native_HAL.Emit_Raw ("  call ALB16_Bool_Not", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);
               elsif Target = Backend_FASM then
                  Walk_AST (Tree (Node).Left_Child, Depth + 1, Out_Tag, Success, Diag);
                  -- Assembly NOT: Compare wi' 0, set true if it WAS 0
                  Transpiler_Native_HAL.Emit_Raw ("  cmp rax, 0", Success); Transpiler_Native_HAL.Emit_Newline (Success);
                  Transpiler_Native_HAL.Emit_Raw ("  sete al", Success); Transpiler_Native_HAL.Emit_Newline (Success);
                  Transpiler_Native_HAL.Emit_Raw ("  movzx rax, al", Success); Transpiler_Native_HAL.Emit_Newline (Success);
               else
                  Transpiler_Native_HAL.Emit_Raw ("(!(", Success);
                  Walk_AST (Tree (Node).Left_Child, Depth + 1, Out_Tag, Success, Diag);
                  Transpiler_Native_HAL.Emit_Raw ("))", Success);
               end if;
               Out_Tag := Type_U64;
               
            when AST_Spawn_Stmt =>
               declare
                  Expr_Node   : Node_Index := Tree (Node).Left_Child;
                  Call_Target : Node_Index := Tree (Node).Left_Child;
                  Arg_Node    : Node_Index := Tree (Node).Right_Child;
               begin
                  if Expr_Node > 0 and then Tree(Expr_Node).Kind = AST_Func_Call then
                     Call_Target := Tree (Expr_Node).Left_Child;
                     if Arg_Node = 0 then
                        Arg_Node := Tree (Expr_Node).Right_Child;
                     end if;
                  end if;

                  if Call_Target > 0 and then Tree(Call_Target).Kind in AST_Var_Expr | AST_Member_Expr then
                     declare
                        Target_Lex : String (1 .. 128) := (others => ' ');
                        Target_Len : Natural := 0;
                        Arg_Count  : Natural := 0;
                     begin
                        Resolve_ALB_Call_Name (Call_Target, Target_Lex, Target_Len);

                        if Target_Len = 0 then
                           Success := False;
                           return;
                        end if;

                        if Target = Backend_FASM then
                           -- FASM currently runs spawned work synchronously.
                           -- This preserves game semantics and avoids the HAL stub poisoning Success.
                           Emit_FASM_Call_With_Args (Target_Lex (1 .. Target_Len), Arg_Node);
                        elsif Target = Backend_FASM16 then
                           -- FASM16 follows the same practical rule for now: spawn lowers
                           -- to an immediate call so DOS builds keep deterministic semantics.
                           Emit_FASM16_Call_With_Args
                             (FASM16_Asm_Name (Target_Lex (1 .. Target_Len)),
                              Arg_Node,
                              Target_Lex (1 .. Target_Len));
                        else
                           Transpiler_Native_HAL.Emit_Spawn_Start(Target_Lex(1 .. Target_Len), Success);
                           
                           if Arg_Node > 0 then
                              if Tree(Arg_Node).Kind = AST_Arg_List then 
                                 Arg_Node := Tree(Arg_Node).Left_Child; 
                              end if;
                              
                              while Arg_Node > 0 loop
                                 Transpiler_Native_HAL.Emit_Comma(Success);
                                 Walk_AST(Arg_Node, Depth + 1, Right_Tag, Success, Diag);
                                 Arg_Count := Arg_Count + 1;
                                 Arg_Node := Tree(Arg_Node).Next_Sibling;
                              end loop;
                           end if;
                           
                           -- DA FIX: Pad the remaining slots wi' 0ULL tae safely fulfill the 8-arg signature!
                           while Arg_Count < 8 loop
                              if Target = Backend_C then
                                 Transpiler_Native_HAL.Emit_Raw(", ALB_U64_ZERO", Success);
                              else
                                 Transpiler_Native_HAL.Emit_Raw(", 0ULL", Success);
                              end if;
                              Arg_Count := Arg_Count + 1;
                           end loop;
                           
                           Transpiler_Native_HAL.Emit_Spawn_End(Success);
                        end if;
                     end;
                  else
                     Success := False;
                  end if;
                  Out_Tag := Type_None;
               end;
               
            when AST_Sync_Stmt =>
               Transpiler_Native_HAL.Emit_Sync(Success);
               Out_Tag := Type_None;
               
            when AST_Atomic_Block =>
               Transpiler_Native_HAL.Emit_Atomic_Start(Success);
               declare
                  Block_Node : Node_Index := Tree(Node).Left_Child;
               begin
                  if Block_Node > 0 then
                     Walk_AST(Block_Node, Depth + 1, Right_Tag, Success, Diag);
                  end if;
               end;
               Transpiler_Native_HAL.Emit_Atomic_End(Success);
               Out_Tag := Type_None;
               
            -- =========================================================================
            -- DA NATIVE ASM GATE
            -- =========================================================================
            when AST_Enable_Asm =>
               declare
                  Gate_Lexeme : constant String := Raw_Lexeme (Tree (Node).Token_Index);
                  Family      : constant Native_ASM_Family :=
                    Native_ASM_Family_From_Lexeme (Gate_Lexeme);
               begin
                  if Native_ASM_Family_Is_Active (Family) then
                     Native_ASM_State := ASM_Mode_Active;
                     if Target = Backend_C then
                        Transpiler_Native_HAL.Emit_Raw
                          ("/* ALB native ASM enabled (C-via-FASM): " &
                           To_Upper (Gate_Lexeme) & " */", Success);
                     else
                        Transpiler_Native_HAL.Emit_Raw
                          ("  ; ALB native ASM enabled: " & To_Upper (Gate_Lexeme),
                           Success);
                     end if;
                     Transpiler_Native_HAL.Emit_Newline (Success);
                  else
                     Native_ASM_State := ASM_Mode_Ignored;
                  end if;
               end;

               Out_Tag := Type_None;


            when AST_Disable_Asm =>
               if Native_ASM_State = ASM_Mode_Active then
                  if Target = Backend_C then
                     Transpiler_Native_HAL.Emit_Raw
                       ("/* ALB native ASM disabled */", Success);
                  else
                     Transpiler_Native_HAL.Emit_Raw
                       ("  ; ALB native ASM disabled", Success);
                  end if;
                  Transpiler_Native_HAL.Emit_Newline (Success);
               end if;

               Native_ASM_State := ASM_Mode_Off;

               Out_Tag := Type_None;


            when AST_Asm_Block =>
               if Native_ASM_State = ASM_Mode_Off then
                  Fail_Node
                    (Node,
                     Err_Type_Conflict,
                     "ASM block requires an active ENABLEASM family block",
                     Success,
                     Diag);
                  return;
               elsif Native_ASM_State = ASM_Mode_Active then
                  declare
                     Block_Text : constant String := Raw_Lexeme (Tree (Node).Token_Index);
                  begin
                     if Target = Backend_C then
                        ASM_Sidecar_Emit_Block_C (Block_Text, Success);
                     else
                        Transpiler_Native_HAL.Emit_Native_ASM_Block (Block_Text, Success);
                     end if;
                     if not Success then
                        return;
                     end if;
                  end;
               end if;

               Out_Tag := Type_None;


            when AST_Inline_Asm_Expr =>
               if Native_ASM_State = ASM_Mode_Off then
                  Fail_Node
                    (Node,
                     Err_Type_Conflict,
                     "INLINE ASM requires an active ENABLEASM family block",
                     Success,
                     Diag);
                  return;
               elsif Native_ASM_State = ASM_Mode_Active then
                  declare
                     Block_Text : constant String := Raw_Lexeme (Tree (Node).Token_Index);
                  begin
                     if Target = Backend_C then
                        ASM_Sidecar_Emit_Expr_C (Block_Text, Success);
                     else
                        Transpiler_Native_HAL.Emit_Native_ASM_Expression (Block_Text, Success);
                     end if;
                     if not Success then
                        return;
                     end if;
                  end;
               end if;

               if Target = Backend_FASM16 then
                  Out_Tag := Type_U32;
               else
                  Out_Tag := Type_U64;
               end if;

            when AST_Enable_C_Block =>
               if Target = Backend_C then
                  declare
                     Block_Text : constant String := Raw_Lexeme (Tree (Node).Token_Index);
                  begin
                     Transpiler_Native_HAL.Emit_Native_C_Block (Block_Text, Success);
                     if not Success then
                        return;
                     end if;
                  end;
               end if;

               Out_Tag := Type_None;

            when AST_Inline_C_Expr =>
               if Target /= Backend_C then
                  Fail_Node
                    (Node,
                     Err_Type_Conflict,
                     "INLINEC requires -t c",
                     Success,
                     Diag);
                  return;
               end if;

               declare
                  Block_Text : constant String := Raw_Lexeme (Tree (Node).Token_Index);
               begin
                  Transpiler_Native_HAL.Emit_Native_C_Expression (Block_Text, Success);
                  if not Success then
                     return;
                  end if;
               end;

               Out_Tag := Type_U64;
               
            -- =========================================================================
            -- BIJECTIVE ENGINE / REVERSIBLE STATE FORGE
            -- =========================================================================
            when AST_Reversible_Block =>
               if Target /= Backend_FASM
                 and then Target /= Backend_FASM16
                 and then Target /= Backend_C
               then
                  Fail_Node
                    (Node,
                     Err_Type_Conflict,
                     "REVERSIBLE requires -t fasm, -t fasm16, or -t c",
                     Success,
                     Diag);
                  return;
               end if;

               Transpiler_Native_HAL.Emit_Reversible_Block_Start (Success);
               if not Success then return; end if;

               Reversible_Depth := Reversible_Depth + 1;

               declare
                  Body_Node : constant Node_Index := Tree (Node).Left_Child;
                  Child     : Node_Index := 0;
               begin
                  if Body_Node > 0 then
                     Child := Tree (Body_Node).Left_Child;
                  end if;

                  while Child /= 0 loop
                     if not Is_Reversible_Statement (Tree (Child).Kind) then
                        Reversible_Depth := Reversible_Depth - 1;
                        Fail_Node
                          (Child,
                           Err_Type_Conflict,
                           "non-reversible statement inside REVERSIBLE",
                           Success,
                           Diag);
                        return;
                     end if;

                     Walk_AST (Child, Depth + 1, Right_Tag, Success, Diag);
                     if not Success then
                        Reversible_Depth := Reversible_Depth - 1;
                        return;
                     end if;

                     Child := Tree (Child).Next_Sibling;
                  end loop;
               end;

               Reversible_Depth := Reversible_Depth - 1;

               Transpiler_Native_HAL.Emit_Reversible_Block_End (Success);
               if not Success then return; end if;

               Out_Tag := Type_None;


            when AST_Rev_Add_Stmt
               | AST_Rev_Sub_Stmt
               | AST_Rev_Xor_Stmt
               | AST_Rev_Rol_Stmt
               | AST_Rev_Ror_Stmt =>
               Ensure_Reversible_Context (Node, Success, Diag);
               if not Success then return; end if;

               declare
                  Target_Node : constant Node_Index := Tree (Node).Left_Child;
                  Value_Node  : constant Node_Index := Tree (Node).Right_Child;
                  Target_Name : String (1 .. 128) := (others => ' ');
                  Target_Len  : Natural := 0;
                  Target_OK   : Boolean := False;
                  Target_Tag  : ALB_Type_Tag := Type_None;
               begin
                  Extract_Reversible_Target
                    (Target_Node, Target_Name, Target_Len, Target_OK);

                  if not Target_OK then
                     Fail_Node
                       (Node,
                        Err_Type_Conflict,
                        "REV target must be declared scalar variable",
                        Success,
                        Diag);
                     return;
                  end if;

                  Target_Tag := Infer_Type_Tag (Target_Node);
                  if Target = Backend_FASM16
                    and then not FASM16_Scalar_Supported (Target_Tag)
                  then
                     Fail_Node
                       (Node,
                        Err_Type_Conflict,
                        "REV target must be FASM16-safe scalar",
                        Success,
                        Diag);
                     return;
                  end if;

                  if Target = Backend_C then
                     Transpiler_Native_HAL.Emit_Indent (Success);
                     if not Success then return; end if;
                     Transpiler_Native_HAL.Emit_Raw ("ALB_REV_Tmp = (uint64_t)(", Success);
                     if not Success then return; end if;
                     Walk_AST (Value_Node, Depth + 1, Right_Tag, Success, Diag);
                     if not Success then return; end if;
                     Transpiler_Native_HAL.Emit_Raw (");", Success);
                     if not Success then return; end if;
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     if not Success then return; end if;
                  else
                     -- RHS/count expression lands in the backend-native result
                     -- register convention (RAX for FASM, DX:AX for FASM16).
                     Walk_AST (Value_Node, Depth + 1, Right_Tag, Success, Diag);
                     if not Success then return; end if;
                  end if;

                  case Tree (Node).Kind is
                     when AST_Rev_Add_Stmt =>
                        Transpiler_Native_HAL.Emit_Rev_Add
                          (Target_Name (1 .. Target_Len), Target_Tag, Success);

                     when AST_Rev_Sub_Stmt =>
                        Transpiler_Native_HAL.Emit_Rev_Sub
                          (Target_Name (1 .. Target_Len), Target_Tag, Success);

                     when AST_Rev_Xor_Stmt =>
                        Transpiler_Native_HAL.Emit_Rev_Xor
                          (Target_Name (1 .. Target_Len), Target_Tag, Success);

                     when AST_Rev_Rol_Stmt =>
                        Transpiler_Native_HAL.Emit_Rev_Rol
                          (Target_Name (1 .. Target_Len), Target_Tag, Success);

                     when AST_Rev_Ror_Stmt =>
                        Transpiler_Native_HAL.Emit_Rev_Ror
                          (Target_Name (1 .. Target_Len), Target_Tag, Success);

                     when others =>
                        Success := False;
                  end case;
               end;

               if not Success then return; end if;
               Out_Tag := Type_None;


            when AST_Rev_Swap_Stmt =>
               Ensure_Reversible_Context (Node, Success, Diag);
               if not Success then return; end if;

               declare
                  Left_Node  : constant Node_Index := Tree (Node).Left_Child;
                  Right_Node : constant Node_Index := Tree (Node).Right_Child;

                  Left_Name  : String (1 .. 128) := (others => ' ');
                  Right_Name : String (1 .. 128) := (others => ' ');
                  Left_Len   : Natural := 0;
                  Right_Len  : Natural := 0;
                  Left_OK    : Boolean := False;
                  Right_OK   : Boolean := False;
                  Left_Tag   : ALB_Type_Tag := Type_None;
                  Right_Tag2 : ALB_Type_Tag := Type_None;
               begin
                  Extract_Reversible_Target
                    (Left_Node, Left_Name, Left_Len, Left_OK);

                  Extract_Reversible_Target
                    (Right_Node, Right_Name, Right_Len, Right_OK);

                  if not Left_OK or else not Right_OK then
                     Fail_Node
                       (Node,
                        Err_Type_Conflict,
                        "REVSWAP targets must be declared scalar variables",
                        Success,
                        Diag);
                     return;
                  end if;

                  Left_Tag := Infer_Type_Tag (Left_Node);
                  Right_Tag2 := Infer_Type_Tag (Right_Node);

                  if Target = Backend_FASM16 then
                     if not FASM16_Scalar_Supported (Left_Tag)
                       or else not FASM16_Scalar_Supported (Right_Tag2)
                     then
                        Fail_Node
                          (Node,
                           Err_Type_Conflict,
                           "REVSWAP targets must be FASM16-safe scalars",
                           Success,
                           Diag);
                        return;
                     end if;

                     if FASM16_Storage_Bytes (Left_Tag) /= FASM16_Storage_Bytes (Right_Tag2) then
                        Fail_Node
                          (Node,
                           Err_Type_Conflict,
                           "REVSWAP targets must match storage width",
                           Success,
                           Diag);
                        return;
                     end if;
                  end if;

                  Transpiler_Native_HAL.Emit_Rev_Swap
                    (Left_Name (1 .. Left_Len),
                     Left_Tag,
                     Right_Name (1 .. Right_Len),
                     Right_Tag2,
                     Success);
               end;

               if not Success then return; end if;
               Out_Tag := Type_None;


            when AST_Rev_Not_Stmt | AST_Rev_Neg_Stmt =>
               Ensure_Reversible_Context (Node, Success, Diag);
               if not Success then return; end if;

               declare
                  Target_Node : constant Node_Index := Tree (Node).Left_Child;
                  Target_Name : String (1 .. 128) := (others => ' ');
                  Target_Len  : Natural := 0;
                  Target_OK   : Boolean := False;
                  Target_Tag  : ALB_Type_Tag := Type_None;
               begin
                  Extract_Reversible_Target
                    (Target_Node, Target_Name, Target_Len, Target_OK);

                  if not Target_OK then
                     Fail_Node
                       (Node,
                        Err_Type_Conflict,
                        "REV target must be declared scalar variable",
                        Success,
                        Diag);
                     return;
                  end if;

                  Target_Tag := Infer_Type_Tag (Target_Node);
                  if Target = Backend_FASM16
                    and then not FASM16_Scalar_Supported (Target_Tag)
                  then
                     Fail_Node
                       (Node,
                        Err_Type_Conflict,
                        "REV target must be FASM16-safe scalar",
                        Success,
                        Diag);
                     return;
                  end if;

                  if Tree (Node).Kind = AST_Rev_Not_Stmt then
                     Transpiler_Native_HAL.Emit_Rev_Not
                       (Target_Name (1 .. Target_Len), Target_Tag, Success);
                  else
                     Transpiler_Native_HAL.Emit_Rev_Neg
                       (Target_Name (1 .. Target_Len), Target_Tag, Success);
                  end if;
               end;

               if not Success then return; end if;
               Out_Tag := Type_None;
            
               
            --  when AST_Call_Stmt =>
            --     declare
            --        Expr_Node : Node_Index := Tree (Node).Left_Child;
            --        Arg_Node  : Node_Index := Tree (Node).Right_Child;
            --     begin
            --        if Expr_Node > 0 then
            --           if Tree(Expr_Node).Kind = AST_Func_Call then
            --              declare
            --                 Call_Target : constant Node_Index := Tree(Expr_Node).Left_Child;
            --                 Call_Args   : Node_Index := Tree(Expr_Node).Right_Child;
            --                 TName       : String (1 .. 128) := (others => ' ');
            --                 TLen        : Natural := 0;
            --              begin
            --                 Resolve_ALB_Call_Name(Call_Target, TName, TLen);
            --  
            --                 if TLen = 0 then
            --                    Fail_Call_Diagnostic("CALL", Tree(Node).Token_Index, Err_Proc_Not_Found, Success, Diag);
            --                    return;
            --                 end if;
            --  
            --                 -- DA FIX: Shield Built-ins frae the strict user registry!
            --                 if not Is_ALB_Builtin_Call_Name(TName(1 .. TLen)) then
            --                    Validate_Foreign_Call(TName(1 .. TLen), Call_Args, Tree(Node).Token_Index, Success, Diag);
            --                    if not Success or else not Diag.Success then
            --                       return;
            --                    end if;
            --  
            --                    Validate_ALB_Call
            --                      (TName(1 .. TLen),
            --                       Call_Args,
            --                       Tree(Node).Token_Index,
            --                       False,
            --                       Success,
            --                       Diag);
            --  
            --                    if not Success or else not Diag.Success then
            --                       return;
            --                    end if;
            --                 end if;
            --  
            --                 --  if Target = Backend_FASM then
            --                 --     Emit_FASM_Call_With_Args (TName (1 .. TLen), Arg_Node);
            --                 --
            --                 --  elsif Target = Backend_FASM16 then
            --                 --     if Arg_Node > 0
            --                 --       and then Tree (Arg_Node).Kind = AST_Arg_List
            --                 --       and then Tree (Arg_Node).Left_Child > 0
            --                 --     then
            --                 --        Fail_Node
            --                 --          (Node,
            --                 --           Err_Type_Conflict,
            --                 --           "FASM16 call arguments are the next phase",
            --                 --           Success,
            --                 --           Diag);
            --                 --        return;
            --                 --     end if;
