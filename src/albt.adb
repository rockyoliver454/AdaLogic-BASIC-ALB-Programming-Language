            when AST_Load_Stmt =>
               declare
                  File_Node : Node_Index := Tree (Node).Left_Child;
                  Var_Node  : Node_Index := Tree (Node).Right_Child;
                  Tok       : Token := Tokens (Tree (Var_Node).Token_Index);
                  Lexeme    : String := Input_Buffer (Tok.Start .. Tok.Start + Tok.Length - 1);
                  Target_Lex : constant String := Scoped_Lexeme (Lexeme);
                  Target_Found : Boolean := False;
                  Target_Sym   : Symbol_Record;
                  Buffer_Tag   : ALB_Type_Tag := Type_U64;
                  Buffer_Bytes : Natural := 0;
                  Label_Suffix : constant String := Nat_Img (Natural (Node));
               begin
                  Log ("   -> EMIT: OS File Vault LOAD into '" & Target_Lex & "'");

                  Find_Symbol_Visible (Target_Lex, Target_Found, Target_Sym);
                  if Target_Found then
                     Buffer_Tag := Array_Declared_Tag (Target_Lex, Target_Sym.Tag);
                  else
                     Buffer_Tag := Array_Declared_Tag (Target_Lex, Type_U64);
                  end if;

                  Buffer_Bytes := Array_Byte_Size (Target_Lex, Buffer_Tag);
                  if Buffer_Bytes = 0 then
                     if Target_Found and then Target_Sym.Struct_ID > 0 then
                        Buffer_Bytes := Get_Struct_Size_Bytes (Target_Sym.Struct_ID);
                     else
                        Buffer_Bytes := Scalar_Byte_Size (Buffer_Tag);
                     end if;
                  end if;

                  if Target = Backend_FASM16 then
                     declare
                        Byte_Count : constant Natural := FASM16_Object_Bytes (Var_Node);
                     begin
                        Walk_AST (File_Node, Depth + 1, Left_Tag, Success, Diag);
                        if not Success then
                           return;
                        end if;

                        Transpiler_Native_HAL.Emit_Raw ("  push dx", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);

                        Emit_FASM16_Address_Of_Node (Var_Node);
                        if not Success then
                           return;
                        end if;

                        Transpiler_Native_HAL.Emit_Raw ("  mov di, ax", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  pop dx", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  mov cx, ", Success);
                        Transpiler_Native_HAL.Emit_Literal_U64 (U64 (Byte_Count), Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  call ALB16_File_Load", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                     end;
                  elsif Target = Backend_FASM then
                     Walk_AST (File_Node, Depth + 1, Left_Tag, Success, Diag);
                     if not Success then
                        return;
                     end if;

                     Transpiler_Native_HAL.Emit_Raw ("  mov rcx, rax", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Emit_Raw
                       ("  invoke CreateFileA, rcx, GENERIC_READ, 0, 0, OPEN_EXISTING, 0, 0",
                        Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Emit_Raw ("  cmp rax, -1", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Emit_Raw
                       ("  je .alb_load_skip_" & Label_Suffix,
                        Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Emit_Raw ("  mov rbx, rax", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);

                     if Array_Byte_Size (Target_Lex, Buffer_Tag) > 0 then
                        Emit_FASM_Array_Data_Address
                          (Target_Lex, Buffer_Tag, "rdx", Success);
                     else
                        Transpiler_Native_HAL.Emit_Raw
                          ("  lea rdx, [" & Target_Lex & "]",
                           Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                     end if;
                     if not Success then
                        return;
                     end if;

                     Transpiler_Native_HAL.Emit_Raw
                       ("  invoke ReadFile, rbx, rdx, " &
                        Nat_Img (Buffer_Bytes) &
                        ", 0, 0",
                        Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Emit_Raw
                       ("  invoke CloseHandle, rbx",
                        Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Emit_Raw
                       (".alb_load_skip_" & Label_Suffix & ":",
                        Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                  elsif Target = Backend_C then
                     Transpiler_Native_HAL.Emit_Indent (Success);
                     Transpiler_Native_HAL.Emit_Raw ("{ ", Success);
                     Transpiler_Native_HAL.Emit_Raw
                       ("FILE* _alb_fp_" & Label_Suffix & " = fopen((const char*)(uintptr_t)(",
                        Success);
                     Walk_AST (File_Node, Depth + 1, Left_Tag, Success, Diag);
                     if not Success then
                        return;
                     end if;
                     Transpiler_Native_HAL.Emit_Raw
                       ("), ""rb""); if (_alb_fp_" & Label_Suffix & ") { fread(",
                        Success);
                     if Array_Byte_Size (Target_Lex, Buffer_Tag) > 0 then
                        Transpiler_Native_HAL.Emit_Raw
                          (C_Array_Data_Expr (Target_Lex),
                           Success);
                     else
                        Transpiler_Native_HAL.Emit_Raw ("&" & Target_Lex, Success);
                     end if;
                     Transpiler_Native_HAL.Emit_Raw
                       (", 1, " & Nat_Img (Buffer_Bytes) & ", _alb_fp_" & Label_Suffix & "); fclose(_alb_fp_" & Label_Suffix & "); } }",
                        Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                  else
                     Transpiler_Native_HAL.Emit_OS_Load ("TARGET_FILE_DYNAMIC", Target_Lex, Success);
                  end if;
               end;

            when AST_Flush_Stmt =>
               declare
                  Var_Node  : Node_Index := Tree (Node).Left_Child;
                  Size_Node : Node_Index := Tree (Var_Node).Next_Sibling;
                  File_Node : Node_Index := Tree (Node).Right_Child;
                  Tok       : Token := Tokens (Tree (Var_Node).Token_Index);
                  Lexeme    : String := Input_Buffer (Tok.Start .. Tok.Start + Tok.Length - 1);
                  Target_Lex : constant String := Scoped_Lexeme (Lexeme);
                  Target_Found : Boolean := False;
                  Target_Sym   : Symbol_Record;
                  Buffer_Tag   : ALB_Type_Tag := Type_U64;
                  Buffer_Bytes : Natural := 0;
                  Is_Text_Flush : Boolean := False;
                  Label_Suffix : constant String := Nat_Img (Natural (Node));
               begin
                  Log ("   -> EMIT: OS File Vault FLUSH from '" & Target_Lex & "'");

                  Find_Symbol_Visible (Target_Lex, Target_Found, Target_Sym);
                  if Target_Found then
                     Buffer_Tag := Array_Declared_Tag (Target_Lex, Target_Sym.Tag);
                  else
                     Buffer_Tag := Array_Declared_Tag (Target_Lex, Type_U64);
                  end if;

                  Buffer_Bytes := Array_Byte_Size (Target_Lex, Buffer_Tag);
                  if Buffer_Bytes = 0 then
                     if Target_Found and then Target_Sym.Struct_ID > 0 then
                        Buffer_Bytes := Get_Struct_Size_Bytes (Target_Sym.Struct_ID);
                     else
                        Buffer_Bytes := Scalar_Byte_Size (Buffer_Tag);
                     end if;
                  end if;

                  Is_Text_Flush :=
                    Target_Found
                      and then Target_Sym.Tag = Type_Binary
                      and then Array_Byte_Size (Target_Lex, Buffer_Tag) = 0;

                  if Target = Backend_FASM16 then
                     if Is_Text_Flush then
                        Walk_AST (Var_Node, Depth + 1, Right_Tag, Success, Diag);
                        if not Success then
                           return;
                        end if;

                        Transpiler_Native_HAL.Emit_Raw ("  push ax", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);

                        Walk_AST (File_Node, Depth + 1, Right_Tag, Success, Diag);
                        if not Success then
                           return;
                        end if;

                        Transpiler_Native_HAL.Emit_Raw ("  pop si", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  xor cx, cx", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  mov bx, si", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  test bx, bx", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw
                          ("  je .alb16_flush_strlen_done_" & Label_Suffix,
                           Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw
                          (".alb16_flush_strlen_loop_" & Label_Suffix & ":",
                           Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  cmp byte [bx], 0", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw
                          ("  je .alb16_flush_strlen_done_" & Label_Suffix,
                           Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  inc bx", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  inc cx", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw
                          ("  jmp .alb16_flush_strlen_loop_" & Label_Suffix,
                           Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw
                          (".alb16_flush_strlen_done_" & Label_Suffix & ":",
                           Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  call ALB16_File_Flush", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                     else
                        declare
                           Byte_Count : constant Natural := FASM16_Object_Bytes (Var_Node);
