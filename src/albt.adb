                        Transpiler_Native_HAL.Emit_Indent (Success);
                        Transpiler_Native_HAL.Emit_Raw
                          ("ALB_PROC_Ensure(&" & Handle_Name & ", ALB_PROCCFG_" &
                           Handle_Name & "_PID, ALB_PROCCFG_" & Handle_Name &
                           "_IMAGE_C, ALB_PROCCFG_" & Handle_Name & "_Rights);",
                           Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);

                        if Buf_Cells > 0 then
                           Transpiler_Native_HAL.Emit_Indent (Success);
                           Transpiler_Native_HAL.Emit_Raw
                             ("ALB_PROC_Write_Buffer(" & Handle_Name & ", (uint64_t)(",
                              Success);
                           Walk_AST (Addr_Node, Depth + 1, Right_Tag, Success, Diag);
                           if not Success then return; end if;
                           Transpiler_Native_HAL.Emit_Raw
                             ("), &" & Value_Name & "[1], " &
                              Nat_Img (Buf_Cells) & ");",
                              Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                        else
                           Transpiler_Native_HAL.Emit_Indent (Success);
                           Transpiler_Native_HAL.Emit_Raw
                             ("ALB_PROC_Write_Scalar(" & Handle_Name & ", (uint64_t)(",
                              Success);
                           Walk_AST (Addr_Node, Depth + 1, Right_Tag, Success, Diag);
                           if not Success then return; end if;
                           Transpiler_Native_HAL.Emit_Raw ("), (uint64_t)(", Success);
                           Walk_AST (Value_Node, Depth + 1, Right_Tag, Success, Diag);
                           if not Success then return; end if;
                           Transpiler_Native_HAL.Emit_Raw ("), 8);", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                        end if;
                     end;

                     Out_Tag := Type_None;
                     return;
                  end if;

                  if Handle_Name'Length = 0 or else Addr_Node = 0 or else Value_Node = 0 then
                     Fail_Node (Node, Err_Type_Conflict, "WRITE_PROCESS_MEMORY", Success, Diag);
                     return;
                  end if;

                  Ensure_Firewall_Access (Value_Node, True, False, Node, Success, Diag);
                  if not Success then
                     return;
                  end if;

                  if Value_Name'Length > 0 then
                     Find_Symbol_Visible (Value_Name, Value_Found, Value_Sym);
                     if Value_Found then
                        Buffer_Tag := Array_Declared_Tag (Value_Name, Value_Sym.Tag);
                        Buffer_Bytes := Array_Byte_Size (Value_Name, Buffer_Tag);
                     end if;
