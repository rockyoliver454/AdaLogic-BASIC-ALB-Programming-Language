                                 Transpiler_Native_HAL.Emit_Raw ("  or al, dl", Success);
                                 Transpiler_Native_HAL.Emit_Newline (Success);
                                 Transpiler_Native_HAL.Emit_Raw ("  movzx rax, al", Success);
                              elsif Mapped_Op = OP_CMP_LT then
