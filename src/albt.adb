            Transpiler_Native_HAL.Emit_Raw ("  inc word [ALB16_TEMP_Future_Depth]", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);

            Emit_FASM16_Future_Save_World_State (Success);
            if not Success then return; end if;

            Transpiler_Native_HAL.Emit_Raw ("  mov byte [ALB16_TEMP_Future_Suppress_IO], 1", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);

            for I in 1 .. Temporal_Count loop
               if Temporal_Entries (I).Active then
                  declare
                     N : constant String :=
                       Temporal_Entries (I).Name (1 .. Temporal_Entries (I).Name_Len);
                  begin
                     Transpiler_Native_HAL.Emit_Temporal_Load_Now
                       (N, Temporal_Entries (I).Tag, Success);
                     if not Success then return; end if;

                     Emit_FASM16_Store_DXAX_To_Cell
                       ("ALB_FUT_" & N & "_value",
                        Temporal_Entries (I).Tag);
                     if not Success then return; end if;

                     Transpiler_Native_HAL.Emit_Raw
                       ("  mov ax, word [ALB_TEMP_" & N & "_head]", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Emit_Raw
                       ("  mov word [ALB_FUT_" & N & "_head], ax", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);

                     Emit_FASM16_Copy_Bytes
                       ("ALB_TEMP_" & N & "_history",
                        "ALB_FUT_" & N & "_history",
                        "sizeof.ALB_TEMP_" & N & "_history",
                        Success);
                     if not Success then return; end if;
                  end;
               end if;
            end loop;

            Transpiler_Native_HAL.Emit_Raw ("  call ALB_ON_TICK", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);

            Transpiler_Native_HAL.Emit_Raw ("  mov byte [ALB16_TEMP_Future_Suppress_IO], 0", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);

            Transpiler_Native_HAL.Emit_Temporal_Load_Now
              (Target_Name, Target_Tag, Success);
            if not Success then return; end if;

            Transpiler_Native_HAL.Emit_Raw ("  mov word [ALB16_TEMP_Future_Result], ax", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            Transpiler_Native_HAL.Emit_Raw ("  mov word [ALB16_TEMP_Future_Result+2], dx", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);

            for I in 1 .. Temporal_Count loop
               if Temporal_Entries (I).Active then
                  declare
                     N : constant String :=
                       Temporal_Entries (I).Name (1 .. Temporal_Entries (I).Name_Len);
                  begin
                     Emit_FASM16_Load_Cell_To_DXAX
                       ("ALB_FUT_" & N & "_value",
                        Temporal_Entries (I).Tag);
                     if not Success then return; end if;

                     Emit_FASM16_Store_DXAX_To_Cell
                       (N,
                        Temporal_Entries (I).Tag);
                     if not Success then return; end if;

                     Transpiler_Native_HAL.Emit_Raw
                       ("  mov ax, word [ALB_FUT_" & N & "_head]", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Emit_Raw
                       ("  mov word [ALB_TEMP_" & N & "_head], ax", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);

                     Emit_FASM16_Copy_Bytes
                       ("ALB_FUT_" & N & "_history",
                        "ALB_TEMP_" & N & "_history",
                        "sizeof.ALB_FUT_" & N & "_history",
                        Success);
                     if not Success then return; end if;
                  end;
               end if;
            end loop;

            Emit_FASM16_Future_Restore_World_State (Success);
            if not Success then return; end if;

            Transpiler_Native_HAL.Emit_Raw ("  dec word [ALB16_TEMP_Future_Depth]", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            Transpiler_Native_HAL.Emit_Raw ("  mov ax, word [ALB16_TEMP_Future_Result]", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            Transpiler_Native_HAL.Emit_Raw ("  mov dx, word [ALB16_TEMP_Future_Result+2]", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            Transpiler_Native_HAL.Emit_Raw ("  jmp .alb16_future_done_" & NID, Success);
            Transpiler_Native_HAL.Emit_Newline (Success);

            Transpiler_Native_HAL.Emit_Raw (".alb16_future_nested_" & NID & ":", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            Transpiler_Native_HAL.Emit_Raw ("  ; nested @future aliases @now to prevent recursive prediction", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            Transpiler_Native_HAL.Emit_Temporal_Load_Now
              (Target_Name, Target_Tag, Success);

            Transpiler_Native_HAL.Emit_Raw (".alb16_future_done_" & NID & ":", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
         end Emit_FASM16_Temporal_Future_To_DXAX;


         procedure Emit_FASM_Pop_To (Reg : String) is
         begin
            Transpiler_Native_HAL.Emit_Raw ("  pop " & Reg, Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
         end Emit_FASM_Pop_To;

         
         function FASM_Native_Call_Name (Name : String) return String is
         begin
            if Name = "ALB_CON_SetColor" then
               return "ALB_TUI_SetColor";
            elsif Name = "ALB_CON_KeyPress" then
               return "ALB_TUI_KeyPress";
            elsif Name = "ALB_CON_BeginDraw" then
               return "ALB_TUI_BeginDraw";
            elsif Name = "ALB_CON_EndDraw" then
               return "ALB_TUI_EndDraw";
            elsif Name = "ALB_CON_Cls" or else Name = "ALB_CON_ALB_Clear_Console" then
               return "ALB_TUI_Clear";
            elsif Name = "ALB_CON_PrintAtStr" then
               return "ALB_TUI_PrintAtStr";
            elsif Name = "ALB_CON_PrintAt" then
               return "ALB_TUI_PrintAt";
            elsif Name = "ALB_CON_ALB_Console_Width" then
               return "ALB_TUI_Width";
            elsif Name = "ALB_CON_ALB_Console_Height" then
               return "ALB_TUI_Height";
            elsif Name = "LEFT" or else Name = "ALB_CON_LEFT" then
               return "ALB_String_Left";
            elsif Name = "RIGHT" or else Name = "ALB_CON_RIGHT" then
               return "ALB_String_Right";
            elsif Name = "MID" or else Name = "ALB_CON_MID" then
               return "ALB_String_Mid";
            elsif Name = "CHR" or else Name = "ALB_CON_CHR" then
               return "ALB_String_Chr";
            elsif Name = "ASC" or else Name = "ALB_CON_ASC" then
               return "ALB_String_Asc";
            elsif Name = "CONCAT" or else Name = "ALB_CON_CONCAT" then
               return "ALB_String_Concat";
            else
               return FASM_Safe_Symbol (Name);
            end if;
         end FASM_Native_Call_Name;

         procedure Emit_FASM_LValue_Address_To_RAX
           (Node    : Node_Index;
            Success : in out Boolean)
         is
         begin
            if Node > 0
              and then Tree (Node).Kind = AST_Var_Expr
              and then Tree (Node).Left_Child = 0
              and then Tree (Node).Token_Index > 0
            then
               declare
                  Tok        : constant Token :=
                    Tokens (Tree (Node).Token_Index);
                  Lexeme     : constant String :=
                    Input_Buffer (Tok.Start .. Tok.Start + Tok.Length - 1);
                  Target_Lex : constant String := Scoped_Lexeme (Lexeme);
               begin
                  Transpiler_Native_HAL.Emit_Raw
                    ("  lea rax, [" & Target_Lex & "]", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);
               end;
            else
               Emit_FASM_Expr_To_RAX (Node, False);
            end if;
         end Emit_FASM_LValue_Address_To_RAX;
         
         procedure Emit_FASM_Virtual_Memory_Builtin
           (Func_Name : String;
            First_Arg : Node_Index)
         is
            Curr : Node_Index := First_Arg;
            A1, A2, A3 : Node_Index := 0;

            procedure Emit_Line (Line : String) is
            begin
               Transpiler_Native_HAL.Emit_Raw (Line, Success);
               Transpiler_Native_HAL.Emit_Newline (Success);
            end Emit_Line;
         begin
            if Target /= Backend_FASM then
               Fail_Node
                 (Node,
                  Err_Type_Conflict,
                  Func_Name & " requires -t fasm (FASM64 PE)",
                  Success,
                  Diag);
               return;
            end if;

            if Curr > 0 and then Tree (Curr).Kind = AST_Arg_List then
               Curr := Tree (Curr).Left_Child;
            end if;
            A1 := Curr;
            if A1 > 0 then
               A2 := Tree (A1).Next_Sibling;
            end if;
            if A2 > 0 then
               A3 := Tree (A2).Next_Sibling;
            end if;

            if Func_Name = "VIRTUAL_ALLOC" then
               -- VIRTUAL_ALLOC(size, protect [, alloc_type=MEM_COMMIT|MEM_RESERVE])
               if A1 = 0 or else A2 = 0 then
                  Fail_Node
                    (Node,
                     Err_Type_Conflict,
                     "VIRTUAL_ALLOC(size, PAGE_*)",
                     Success,
                     Diag);
                  return;
               end if;
               Emit_FASM_Expr_To_RAX (A1);
               Emit_Line ("  push rax"); -- size
               Emit_FASM_Expr_To_RAX (A2);
               Emit_Line ("  push rax"); -- protect
               if A3 > 0 then
                  Emit_FASM_Expr_To_RAX (A3);
                  Emit_Line ("  push rax"); -- alloc type
               else
                  Emit_Line ("  mov rax, 0x3000"); -- MEM_COMMIT|MEM_RESERVE
                  Emit_Line ("  push rax");
               end if;
               Emit_Line ("  sub rsp, 32");
               Emit_Line ("  xor rcx, rcx"); -- lpAddress = NULL
               Emit_Line ("  mov rdx, qword [rsp + 32 + 16]"); -- size
               Emit_Line ("  mov r8, qword [rsp + 32]"); -- alloc type
               Emit_Line ("  mov r9, qword [rsp + 32 + 8]"); -- protect
               Emit_Line ("  call qword [VirtualAlloc]");
               Emit_Line ("  add rsp, 32");
               Emit_Line ("  add rsp, 24"); -- pop 3 pushes
            elsif Func_Name = "VIRTUAL_FREE" then
               if A1 = 0 then
                  Fail_Node
                    (Node,
                     Err_Type_Conflict,
                     "VIRTUAL_FREE(addr)",
                     Success,
                     Diag);
                  return;
               end if;
               Emit_FASM_Expr_To_RAX (A1);
               Emit_Line ("  mov rcx, rax");
               Emit_Line ("  xor rdx, rdx"); -- dwSize = 0 for MEM_RELEASE
               Emit_Line ("  mov r8, 0x8000"); -- MEM_RELEASE
               Emit_Line ("  sub rsp, 32");
               Emit_Line ("  call qword [VirtualFree]");
               Emit_Line ("  add rsp, 32");
            elsif Func_Name = "VIRTUAL_PROTECT" then
               if A1 = 0 or else A2 = 0 or else A3 = 0 then
                  Fail_Node
                    (Node,
                     Err_Type_Conflict,
                     "VIRTUAL_PROTECT(addr, size, PAGE_*)",
                     Success,
                     Diag);
                  return;
               end if;
               Emit_FASM_Expr_To_RAX (A1);
               Emit_Line ("  push rax"); -- addr
               Emit_FASM_Expr_To_RAX (A2);
               Emit_Line ("  push rax"); -- size
               Emit_FASM_Expr_To_RAX (A3);
               Emit_Line ("  push rax"); -- new protect
               Emit_Line ("  sub rsp, 40"); -- shadow + oldProtect slot
               Emit_Line ("  mov rcx, qword [rsp + 40 + 16]"); -- addr
               Emit_Line ("  mov rdx, qword [rsp + 40 + 8]"); -- size
               Emit_Line ("  mov r8, qword [rsp + 40]"); -- protect
               Emit_Line ("  lea r9, [rsp + 32]"); -- &oldProtect
               Emit_Line ("  call qword [VirtualProtect]");
               Emit_Line ("  add rsp, 40");
               Emit_Line ("  add rsp, 24");
            else
               Fail_Node (Node, Err_Type_Conflict, Func_Name, Success, Diag);
            end if;
         end Emit_FASM_Virtual_Memory_Builtin;

         procedure Emit_FASM_Call_With_Args
           (Func_Name     : String;
            First_Arg     : Node_Index;
            Address_First : Boolean := False;
            Graphics_Arg_Count : Natural := 0)
         is
             Curr        : Node_Index := First_Arg;
             Arg_Count   : Natural := 0;
             Extra_Count : Natural := 0;
             Call_Area   : Natural := 32;
             Sig         : ALB_Signature;
             Has_Sig     : Boolean := Find_ALB_Signature(Func_Name, Sig);

            function Img (N : Natural) return String is
               Raw : constant String := Natural'Image (N);
            begin
               return Raw (Raw'First + 1 .. Raw'Last);
            end Img;

            procedure Emit_Line (Line : String) is
            begin
               Transpiler_Native_HAL.Emit_Raw (Line, Success);
               Transpiler_Native_HAL.Emit_Newline (Success);
            end Emit_Line;

            procedure Move_Pushed_Arg_To_Reg
              (Arg_Index : Natural;
               Reg_Name  : String)
            is
               Src_Off : constant Natural :=
                 Call_Area + ((Arg_Count - Arg_Index) * 8);
            begin
               Emit_Line ("  mov " & Reg_Name & ", qword [rsp + " & Img (Src_Off) & "]");
            end Move_Pushed_Arg_To_Reg;

            procedure Move_Pushed_Arg_To_Stack
              (Arg_Index : Natural)
            is
               Src_Off : constant Natural :=
                 Call_Area + ((Arg_Count - Arg_Index) * 8);

               Dst_Off : constant Natural :=
                 32 + ((Arg_Index - 5) * 8);
            begin
               Emit_Line ("  mov rax, qword [rsp + " & Img (Src_Off) & "]");
               Emit_Line ("  mov qword [rsp + " & Img (Dst_Off) & "], rax");
            end Move_Pushed_Arg_To_Stack;

         begin
            if Curr > 0 and then Tree (Curr).Kind = AST_Arg_List then
               Curr := Tree (Curr).Left_Child;
            end if;

             -- Evaluate arguments left-to-right, preserving every value on the stack.
             while Curr > 0 loop
                declare
                   Arg_Pos : constant Natural := Arg_Count + 1;
                begin
                   if Has_Sig
                     and then Arg_Pos <= Sig.Param_Count
                     and then Sig.Param_Ranges(Arg_Pos) > 0
                   then
                      Validate_Static_Range_Expr
                        (Curr,
                         Sig.Param_Ranges(Arg_Pos),
                         Curr,
                         Success,
                         Diag);

                      if not Success or else not Diag.Success then
                         return;
                      end if;
                   end if;
 
                   if Graphics_Arg_Count > 0 and then Arg_Pos <= Graphics_Arg_Count then
                      Emit_FASM_Graphics_Expr_To_RAX (Curr);
                   elsif Has_Sig
                     and then Arg_Pos <= Sig.Param_Count
                     and then Sig.Param_Is_Out (Arg_Pos)
                   then
                      Emit_FASM_LValue_Address_To_RAX (Curr, Success);
                      if not Success or else not Diag.Success then
                         return;
                      end if;
                   else
                      Emit_FASM_Expr_To_RAX
                        (Curr,
                         Address_First and then Arg_Count = 0);
                   end if;
                end;

                Emit_Line ("  push rax");

                Arg_Count := Arg_Count + 1;
                Curr := Tree (Curr).Next_Sibling;
             end loop;

            -- Win64 call area:
            --   [rsp + 0..31]  = shadow space
            --   [rsp + 32...]  = stack args 5+
            -- The original pushed argument copies remain above this area until cleanup.
            if Arg_Count > 4 then
               Extra_Count := Arg_Count - 4;
               Call_Area := 32 + (Extra_Count * 8);
            else
               Call_Area := 32;

               -- If an odd number of register args are still pushed above us,
               -- add one padding slot so rsp is 16-byte aligned before CALL.
               if (Arg_Count mod 2) = 1 then
                  Call_Area := Call_Area + 8;
               end if;
            end if;

            Emit_Line ("  sub rsp, " & Img (Call_Area));

            -- Copy stack arguments 5..N into the ABI stack argument area.
            if Arg_Count >= 5 then
               for Arg_Index in 5 .. Arg_Count loop
                  Move_Pushed_Arg_To_Stack (Arg_Index);
               end loop;
            end if;

            -- Load register arguments 1..4.
            if Arg_Count >= 1 then
               Move_Pushed_Arg_To_Reg (1, "rcx");
            end if;

            if Arg_Count >= 2 then
               Move_Pushed_Arg_To_Reg (2, "rdx");
            end if;

            if Arg_Count >= 3 then
               Move_Pushed_Arg_To_Reg (3, "r8");
            end if;

            if Arg_Count >= 4 then
               Move_Pushed_Arg_To_Reg (4, "r9");
            end if;

            Emit_Line ("  call " & FASM_Native_Call_Name (Func_Name));

            -- Clean both the ABI call area and the original pushed argument copies.
            Emit_Line ("  add rsp, " & Img (Call_Area + (Arg_Count * 8)));
         end Emit_FASM_Call_With_Args;

         
         function Is_Reversible_Statement (K : Node_Kind) return Boolean is
         begin
            case K is
               when AST_Reversible_Block
                  | AST_Rev_Add_Stmt
                  | AST_Rev_Sub_Stmt
                  | AST_Rev_Xor_Stmt
                  | AST_Rev_Rol_Stmt
                  | AST_Rev_Ror_Stmt
                  | AST_Rev_Swap_Stmt
                  | AST_Rev_Not_Stmt
                  | AST_Rev_Neg_Stmt =>
                  return True;

               when others =>
                  return False;
            end case;
         end Is_Reversible_Statement;


         procedure Extract_Reversible_Target
           (Target_Node : in Node_Index;
            Name        : out String;
            Name_Len    : out Natural;
            OK          : out Boolean)
         is
         begin
            Name := (others => ' ');
            Name_Len := 0;
            OK := False;

            if Target_Node = 0 then
               return;
            end if;

            -- First pass: strict scalar variables only.
            -- Arrays, fields, derefs, and arbitrary addresses can come later.
            if Tree (Target_Node).Kind = AST_Var_Expr and then
               Tree (Target_Node).Left_Child = 0 and then
               Tree (Target_Node).Token_Index > 0
            then
               declare
                  Tok        : constant Token := Tokens (Tree (Target_Node).Token_Index);
                  Lexeme     : constant String := Input_Buffer (Tok.Start .. Tok.Start + Tok.Length - 1);
                  Target_Lex : constant String := Scoped_Lexeme (Lexeme);
                  Found      : Boolean := False;
                  Sym        : Symbol_Record;
               begin
                  if Target_Lex'Length > Name'Length then
                     return;
                  end if;

                  Find_Symbol (Hash_String (Target_Lex), Current_Scope, Found, Sym);
                  if not Found then
                     return;
                  end if;

                  Name (Name'First .. Name'First + Target_Lex'Length - 1) := Target_Lex;
                  Name_Len := Target_Lex'Length;
                  OK := True;
               end;
            end if;
         end Extract_Reversible_Target;


         procedure Ensure_Reversible_Context
           (N       : in Node_Index;
            Success : in out Boolean;
            Diag    : in out Compiler_Diagnostic)
         is
         begin
            if Reversible_Depth = 0 then
               Fail_Node
                 (N,
                  Err_Type_Conflict,
                  "REV operation requires REVERSIBLE block",
                  Success,
                  Diag);
            end if;
         end Ensure_Reversible_Context;

         


      begin

         Out_Tag := Type_None;
         if not Success or Node = 0 then
            return;
         end if;
         if Depth > 256 then
            Success := False;
            Diag.Success := False;
            Diag.Code := Err_Call_Stack_Overflow;
            return;
         end if;

         -- --embed-blackbox: stamp last ALB source line (heap-free VEH dump)
         if Embed_Blackbox_Mode
           and then Target = Backend_FASM
           and then Tree (Node).Token_Index > 0
         then
            case Tree (Node).Kind is
               when AST_Var_Expr | AST_String_Expr
                  | AST_Arg_List | AST_Param_Decl | AST_Program
                  | AST_Block_Stmt | AST_Module =>
                  null;
               when others =>
                  declare
                     Tok_Line : constant Natural :=
                       Natural (Tokens (Tree (Node).Token_Index).Line);
                     M_Rec    : Source_Map_Record;
                  begin
                     if Tok_Line > 0 and then Tok_Line <= Abs_Line_Count then
                        M_Rec := Source_Map (Tok_Line);
                        Transpiler_Native_HAL.Emit_Raw
                          ("  mov qword [ALB_Last_Line], "
                           & Nat_Img (Natural (M_Rec.Rel_Line)),
                           Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw
                          ("  mov qword [ALB_Last_File_Id], "
                           & Nat_Img (M_Rec.File_ID),
                           Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                     else
                        Transpiler_Native_HAL.Emit_Raw
                          ("  mov qword [ALB_Last_Line], " & Nat_Img (Tok_Line),
                           Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                     end if;
                  end;
            end case;
         end if;

         Log ("Walking Node " & AST.Node_Kind'Image (Tree (Node).Kind));
         case Tree (Node).Kind is

            when AST_Program =>
               -- Standard Program processing
               declare
                  Curr      : Node_Index := Tree (Node).Left_Child;
                  Dummy_Tag : ALB_Type_Tag;
               begin
                  while Curr /= 0 loop
                     if not Native_ASM_Should_Skip_Node (Curr) then
                        Walk_AST (Curr, Depth + 1, Dummy_Tag, Success, Diag);
                     end if;
                     Curr := Tree (Curr).Next_Sibling;
                  end loop;
               end;

             -- =============================================================
             -- NEW SCOPED MODE BLOCKS: FALLBACK, EXACT, SYMBOLIC, PREDICATE,
             -- STRIDE, RATIO_SPACE, MORTON_TILE
             -- =============================================================
             when AST_Fallback_Block =>
                declare
                   Body_Node : Node_Index := Tree (Node).Left_Child;
                   FNode     : Node_Index := Tree (Node).Right_Child;
                   NID       : constant String := Node_Index'Image (Node);
                   FID       : constant String := NID (NID'First + 1 .. NID'Last);
                   FDepth    : constant Natural := Fallback_Depth + 1;
                   FLabel    : constant String := ".ALB_FALLBACK_" & FID;
                begin
                   if FDepth > Max_Mode_Nesting then
                      Fail_Node (Node, Err_Type_Conflict, "FALLBACK NESTING EXCEEDED 32", Success, Diag);
                      return;
                   end if;
                   Fallback_Depth := FDepth;
                   Fallback_Label_Len (FDepth) := FLabel'Length;
                   Fallback_Label_Stack (FDepth) (1 .. FLabel'Length) := FLabel;
                   Fallback_Code_Stack (FDepth) := 0;
                   -- Emit body
                   if Target = Backend_FASM then
                      if Body_Node /= 0 then
                         Walk_AST (Body_Node, Depth + 1, Out_Tag, Success, Diag);
                         if not Success then return; end if;
                      end if;
                      -- Emit fallback recovery point
                      Transpiler_Native_HAL.Emit_Raw (FLabel & ":", Success);
                      Transpiler_Native_HAL.Emit_Newline (Success);
                      if FNode /= 0 then
                         Walk_AST (FNode, Depth + 1, Out_Tag, Success, Diag);
                      end if;
                   else
                      if Body_Node /= 0 then
                         Walk_AST (Body_Node, Depth + 1, Out_Tag, Success, Diag);
                         if not Success then return; end if;
                      end if;
                      if FNode /= 0 then
                         Walk_AST (FNode, Depth + 1, Out_Tag, Success, Diag);
                      end if;
                   end if;
                   Fallback_Depth := FDepth - 1;
                   Fallback_Label_Len (FDepth) := 0;
                end;
                Out_Tag := Type_None;

             when AST_Exact_Block =>
                declare
                   Body_Node : Node_Index := Tree (Node).Left_Child;
                begin
                   Exact_Depth := Exact_Depth + 1;
                   if Body_Node /= 0 then
                      Walk_AST (Body_Node, Depth + 1, Out_Tag, Success, Diag);
                   end if;
                   Exact_Depth := Exact_Depth - 1;
                end;
                Out_Tag := Type_None;

             when AST_Symbolic_Block =>
                declare
                   Body_Node : Node_Index := Tree (Node).Left_Child;
                begin
                   Symbolic_Depth := Symbolic_Depth + 1;
                   if Body_Node /= 0 then
                      if Target = Backend_FASM then
                         Transpiler_Native_HAL.Emit_Raw ("  ; SYMBOLIC block: integer-literal BinOps are folded at emit time (see AST_BinOp Symbolic_Depth fold path)", Success);
                         Transpiler_Native_HAL.Emit_Newline (Success);
                      end if;
                      Walk_AST (Body_Node, Depth + 1, Out_Tag, Success, Diag);
                   end if;
                   Symbolic_Depth := Symbolic_Depth - 1;
                end;
                Out_Tag := Type_None;

              when AST_Synth_Bake_Block =>
                 declare
                    Fmt_Node  : Node_Index := Tree (Node).Right_Child;
                    Body_Node : Node_Index := 0;
                    Saved_Left : Node_Index;
                 begin
                    if Fmt_Node /= 0 then
                       Body_Node := Tree (Fmt_Node).Next_Sibling;
                    end if;
                    -- Emit_Play_Music_FASM reads Left_Child for MML source,
                    -- but SYNTH_BAKE stores it in Right_Child (FORMAT field).
                    -- Swap temporarily so the emitter reads the MML string.
                     if Target = Backend_FASM then
                        Saved_Left := Tree (Node).Left_Child;
                        Tree (Node).Left_Child := Tree (Node).Right_Child;
                        Emit_Play_Music_FASM (Node, False, Success, Diag);
                        Tree (Node).Left_Child := Saved_Left;
                        if not Success then return; end if;
                        if Saved_Left /= 0 and then Tree(Saved_Left).Kind = AST_Var_Expr then
                           declare
                              Var_Tok : Token := Tokens(Tree(Saved_Left).Token_Index);
                              Var_Nam : constant String := Input_Buffer(Var_Tok.Start .. Var_Tok.Start + Var_Tok.Length - 1);
                              LB      : constant String := "ALB_Music_" & Trim_Image (Integer (Node));
                           begin
                              Transpiler_Native_HAL.Emit_Raw ("  lea rax, [" & LB & "]", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  mov dword [" & Var_Nam & "], eax", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                           end;
                        end if;
                     end if;
                    if Body_Node /= 0 then
                       Walk_AST (Body_Node, Depth + 1, Out_Tag, Success, Diag);
                    end if;
                    Out_Tag := Type_None;
                 end;

             when AST_Branchless_Predicate_Block =>
                declare
                   Cond_Node : Node_Index := Tree (Node).Left_Child;
                   Body_Node : Node_Index := Tree (Node).Right_Child;
                   Fallback_Node : Node_Index := 0;
                   Cond_Tag  : ALB_Type_Tag;
                   PImg      : constant String := Node_Index'Image (Node);
                   PID       : constant String := PImg (PImg'First + 1 .. PImg'Last);
                begin
                   if Body_Node > 0 then
                      Fallback_Node := Tree (Body_Node).Next_Sibling;
                   end if;
                   if Target = Backend_FASM then
                      Walk_AST (Cond_Node, Depth + 1, Cond_Tag, Success, Diag);
                      if not Success then return; end if;
                      -- Branchless: evaluate condition, produce 0/1 mask
                      Transpiler_Native_HAL.Emit_Raw ("  test rax, rax", Success);
                      Transpiler_Native_HAL.Emit_Newline (Success);
                      Transpiler_Native_HAL.Emit_Raw ("  setnz al", Success);
                      Transpiler_Native_HAL.Emit_Newline (Success);
                      Transpiler_Native_HAL.Emit_Raw ("  movzx rax, al", Success);
                      Transpiler_Native_HAL.Emit_Newline (Success);
                      Transpiler_Native_HAL.Emit_Raw ("  neg rax", Success);
                      Transpiler_Native_HAL.Emit_Newline (Success);
                      if Body_Node /= 0 then
                         declare
                            L_Child : Node_Index := Tree (Body_Node).Left_Child;
                            R_Expr  : Node_Index;
                            Dst     : String (1 .. 256) := (others => ' ');
                            Dst_Len : Natural := 0;
                         begin
                            while L_Child /= 0 loop
                             if Tree (L_Child).Kind = AST_Let_Stmt then
                                   R_Expr := Tree (L_Child).Right_Child;
                                  declare
                                     Tok       : Token := Tokens (Tree (Tree (L_Child).Left_Child).Token_Index);
                                     Dst_Lex   : String := Input_Buffer (Tok.Start .. Tok.Start + Tok.Length - 1);
                                     Scoped    : constant String := Scoped_Lexeme (Dst_Lex);
                                     Dummy_Tag : ALB_Type_Tag;
                                  begin
                                     Walk_AST (R_Expr, Depth + 1, Dummy_Tag, Success, Diag);
                                     if not Success then return; end if;
                                     -- cmovcc: store only if mask non-zero
                                     Transpiler_Native_HAL.Emit_Raw ("  test rax, rax", Success);
                                     Transpiler_Native_HAL.Emit_Newline (Success);
                                     Transpiler_Native_HAL.Emit_Raw ("  cmovnz rcx, rax", Success);
                                     Transpiler_Native_HAL.Emit_Newline (Success);
                                     Transpiler_Native_HAL.Emit_Raw ("  mov qword [" & Scoped & "], rcx", Success);
                                     Transpiler_Native_HAL.Emit_Newline (Success);
                                  end;
                               else
                                  Fail_Node (L_Child, Err_Type_Conflict, "PREDICATE_BLOCK_REQUIRES_PURE_ASSIGNMENTS", Success, Diag);
                                  return;
                               end if;
                               L_Child := Tree (L_Child).Next_Sibling;
                            end loop;
                         end;
                      end if;
                      if Fallback_Node /= 0 then
                         Walk_AST (Fallback_Node, Depth + 1, Out_Tag, Success, Diag);
                      end if;
                   else
                      Transpiler_Native_HAL.Emit_Raw ("if (", Success);
                      Walk_AST (Cond_Node, Depth + 1, Cond_Tag, Success, Diag);
                      if not Success then return; end if;
                      Transpiler_Native_HAL.Emit_Raw (") ", Success);
                      if Body_Node /= 0 then
                         Transpiler_Native_HAL.Emit_Raw ("{ ", Success);
                         Walk_AST (Body_Node, Depth + 1, Out_Tag, Success, Diag);
                         Transpiler_Native_HAL.Emit_Raw (" } ", Success);
                      end if;
                      if Fallback_Node /= 0 then
                         Transpiler_Native_HAL.Emit_Raw ("else { ", Success);
                         Walk_AST (Fallback_Node, Depth + 1, Out_Tag, Success, Diag);
                         Transpiler_Native_HAL.Emit_Raw (" } ", Success);
                      end if;
                      Transpiler_Native_HAL.Emit_Newline (Success);
                   end if;
                   Out_Tag := Type_None;
                end;

             when AST_Stride_Block =>
                declare
                   Width_Node    : Node_Index := Tree (Node).Left_Child;
                   Body_Node     : Node_Index := Tree (Node).Right_Child;
                   Fallback_Node : Node_Index := 0;
                   NID_Img       : constant String := Node_Index'Image (Node);
                   NID           : constant String :=
                     NID_Img (NID_Img'First + 1 .. NID_Img'Last);
                   Width_Label   : constant String :=
                     "ALB_Stride_Width_" & NID;
                   End_Label     : constant String :=
                     ".ALB_STRIDE_END_" & NID;
                begin
                   if Body_Node > 0 then
                      Fallback_Node := Tree (Body_Node).Next_Sibling;
                   end if;

                   if Target = Backend_FASM and then Width_Node /= 0 then
                      -- Task A2: reserve a qword in the global data section
                      -- to hold the runtime stride width for this block.
                      Emit_Global_Line (Width_Label & " dq 0");
                      -- Evaluate the stride width expression into rax,
                      -- then store it into our per-block label.
                      Walk_AST (Width_Node, Depth + 1, Out_Tag, Success, Diag);
                      if not Success then return; end if;
                      Transpiler_Native_HAL.Emit_Raw
                        ("  mov [" & Width_Label & "], rax", Success);
                      Transpiler_Native_HAL.Emit_Newline (Success);
                   elsif Target = Backend_C and then Width_Node /= 0 then
                      -- Task 1B (C): emit a static uint64 global to hold
                      -- the runtime stride width, then evaluate the width
                      -- expression and store it.  Same label form as
                      -- FASM so the FOR loop hook can reuse the stack.
                      Emit_Global_Line
                        ("static uint64_t " & Width_Label & " = 0;");
                      Transpiler_Native_HAL.Emit_Raw
                        (Width_Label & " = (uint64_t)(", Success);
                      Walk_AST (Width_Node, Depth + 1, Out_Tag, Success, Diag);
                      if not Success then return; end if;
                      Transpiler_Native_HAL.Emit_Raw (");", Success);
                      Transpiler_Native_HAL.Emit_Newline (Success);
                   end if;

                   Stride_Depth := Stride_Depth + 1;
                   -- Push the label onto the stack so inner FOR loops can
                   -- consult it. Guard against nesting overflow.
                   if Stride_Depth <= Max_Mode_Nesting then
                      Stride_Width_Label_Len (Stride_Depth) := Width_Label'Length;
                      Stride_Width_Label_Stack (Stride_Depth)
                        (1 .. Width_Label'Length) := Width_Label;
                   end if;

                   if Body_Node /= 0 then
                      Walk_AST (Body_Node, Depth + 1, Out_Tag, Success, Diag);
                   end if;

                   if Stride_Depth <= Max_Mode_Nesting then
                      Stride_Width_Label_Len (Stride_Depth) := 0;
                   end if;
                   Stride_Depth := Stride_Depth - 1;

                   -- STRIDE has no runtime failure path, so the fallback
                   -- is unreachable. Skip over it via jmp-to-end and emit
                   -- it anyway for completeness / future runtime-trip use.
                   if Target = Backend_FASM and then Fallback_Node /= 0 then
                      Transpiler_Native_HAL.Emit_Raw
                        ("  jmp " & End_Label, Success);
                      Transpiler_Native_HAL.Emit_Newline (Success);
                      Walk_AST (Fallback_Node, Depth + 1, Out_Tag, Success, Diag);
                      Transpiler_Native_HAL.Emit_Raw
                        (End_Label & ":", Success);
                      Transpiler_Native_HAL.Emit_Newline (Success);
                   end if;
                   -- Backend_C: STRIDE has no failure path, skip FALLBACK.
                   Out_Tag := Type_None;
                end;

             when AST_Ratio_Space_Block =>
                declare
                   Pin_Chain : Node_Index := Tree (Node).Left_Child;
                   Body_Node : Node_Index := Tree (Node).Right_Child;
                   Fallback_Node : Node_Index := 0;
                   Pin_Cursor : Node_Index := Pin_Chain;
                   Pin_Slot   : Natural := 0;
                   Pin_Tag    : ALB_Type_Tag;
                   NID_Img    : constant String := Node_Index'Image (Node);
                   NID        : constant String :=
                     NID_Img (NID_Img'First + 1 .. NID_Img'Last);
                   End_Label  : constant String :=
                     ".ALB_RATIO_END_" & NID;
                begin
                   if Body_Node > 0 then
                      Fallback_Node := Tree (Body_Node).Next_Sibling;
                   end if;

                   if Ratio_Pin_Depth > 0 then
                      -- v1: nesting unsupported (would require multi-bank
                      -- xmm allocator). Loud error is better than silent
                      -- pin overwrite.
                      Fail_Node
                        (Node,
                         Err_Type_Conflict,
                         "NESTED RATIO_SPACE NOT SUPPORTED (v1, max 4 pins / block)",
                         Success, Diag);
                      return;
                   end if;

                   Ratio_Pin_Depth := Ratio_Pin_Depth + 1;

                   if Target = Backend_FASM then
                      -- Walk the pin chain manually. Each pin's Left_Child
                      -- holds the bracketed expression to bind into a
                      -- distinct xmm register (xmm4..xmm7 reserved for
                      -- ratio pins).
                      while Pin_Cursor /= 0 loop
                         if Tree (Pin_Cursor).Kind /= AST_Ratio_Pin then
                            Fail_Node
                              (Pin_Cursor,
                               Err_Type_Conflict,
                               "RATIO_SPACE pin chain contains non-pin node",
                               Success, Diag);
                            return;
                         end if;

                         Pin_Slot := Pin_Slot + 1;
                         if Pin_Slot > 4 then
                            Fail_Node
                              (Pin_Cursor,
                               Err_Type_Conflict,
                               "RATIO_SPACE supports at most 4 PINS (xmm4..xmm7)",
                               Success, Diag);
                            return;
                         end if;

                         -- Evaluate the pin expression into rax.
                         Walk_AST
                           (Tree (Pin_Cursor).Left_Child, Depth + 1,
                            Pin_Tag, Success, Diag);
                         if not Success then return; end if;

                         -- Bind it to its xmm slot (slot N -> xmm(3+N)).
                         Transpiler_Native_HAL.Emit_Raw
                           ("  ; RATIO_PIN slot " & Nat_Img (Pin_Slot) &
                            " -> xmm" & Nat_Img (3 + Pin_Slot),
                            Success);
                         Transpiler_Native_HAL.Emit_Newline (Success);
                         Transpiler_Native_HAL.Emit_Raw
                           ("  cvtsi2sd xmm" & Nat_Img (3 + Pin_Slot) &
                            ", rax", Success);
                         Transpiler_Native_HAL.Emit_Newline (Success);

                         Pin_Cursor := Tree (Pin_Cursor).Next_Sibling;
                      end loop;
                   elsif Target = Backend_C then
                      -- Task 1C (C): "same semantics, different lowering".
                      -- Each pin becomes a scoped double named to mirror
                      -- the FASM xmm slot it would occupy.  Globals are
                      -- declared exactly once across the whole file so
                      -- multiple RATIO_SPACE blocks can share them.
                      if not Ratio_Globals_Emitted_C then
                         Emit_Global_Line ("static double __RATIO_4__ = 0.0;");
                         Emit_Global_Line ("static double __RATIO_5__ = 0.0;");
                         Emit_Global_Line ("static double __RATIO_6__ = 0.0;");
                         Emit_Global_Line ("static double __RATIO_7__ = 0.0;");
                         Ratio_Globals_Emitted_C := True;
                      end if;

                      while Pin_Cursor /= 0 loop
                         if Tree (Pin_Cursor).Kind /= AST_Ratio_Pin then
                            Fail_Node
                              (Pin_Cursor,
                               Err_Type_Conflict,
                               "RATIO_SPACE pin chain contains non-pin node",
                               Success, Diag);
                            return;
                         end if;

                         Pin_Slot := Pin_Slot + 1;
                         if Pin_Slot > 4 then
                            Fail_Node
                              (Pin_Cursor,
                               Err_Type_Conflict,
                               "RATIO_SPACE supports at most 4 PINS",
                               Success, Diag);
                            return;
                         end if;

                         Transpiler_Native_HAL.Emit_Raw
                           ("__RATIO_" & Nat_Img (3 + Pin_Slot) &
                            "__ = (double)(int64_t)(", Success);
                         Walk_AST
                           (Tree (Pin_Cursor).Left_Child, Depth + 1,
                            Pin_Tag, Success, Diag);
                         if not Success then return; end if;
                         Transpiler_Native_HAL.Emit_Raw (");", Success);
                         Transpiler_Native_HAL.Emit_Newline (Success);

                         Pin_Cursor := Tree (Pin_Cursor).Next_Sibling;
                      end loop;
                   end if;

                   if Body_Node /= 0 then
                      Walk_AST (Body_Node, Depth + 1, Out_Tag, Success, Diag);
                      if not Success then return; end if;
                   end if;

                   if Target = Backend_FASM then
                      -- Scrub the xmm slots we used so ratio values
                      -- cannot leak past END RATIO_SPACE.
                      for K in 1 .. Pin_Slot loop
                         Transpiler_Native_HAL.Emit_Raw
                           ("  xorps xmm" & Nat_Img (3 + K) &
                            ", xmm" & Nat_Img (3 + K), Success);
                         Transpiler_Native_HAL.Emit_Newline (Success);
                      end loop;
                   elsif Target = Backend_C then
                      for K in 1 .. Pin_Slot loop
                         Transpiler_Native_HAL.Emit_Raw
                           ("__RATIO_" & Nat_Img (3 + K) & "__ = 0.0;",
                            Success);
                         Transpiler_Native_HAL.Emit_Newline (Success);
                      end loop;
                   end if;

                   Ratio_Pin_Depth := Ratio_Pin_Depth - 1;

                   -- RATIO_SPACE has no runtime failure path (cvtsi2sd
                   -- from an integer cannot trap), so the fallback is
                   -- unreachable. Skip it with an unconditional jmp.
                   if Target = Backend_FASM and then Fallback_Node /= 0 then
                      Transpiler_Native_HAL.Emit_Raw
                        ("  jmp " & End_Label, Success);
                      Transpiler_Native_HAL.Emit_Newline (Success);
                      Walk_AST (Fallback_Node, Depth + 1, Out_Tag, Success, Diag);
                      Transpiler_Native_HAL.Emit_Raw
                        (End_Label & ":", Success);
                      Transpiler_Native_HAL.Emit_Newline (Success);
                   end if;
                   -- Backend_C: RATIO_SPACE has no failure path, skip
                   -- FALLBACK to prevent it from running unconditionally.

                   Out_Tag := Type_None;
                end;

             when AST_Ratio_Pin =>
                -- Standalone RATIO_PIN is illegal. The RATIO_SPACE arm
                -- walks the pin chain directly and bypasses Walk_AST on
                -- the pin node itself, so reaching this arm means the
                -- pin appeared outside any RATIO_SPACE block.
                Fail_Node
                  (Node,
                   Err_Type_Conflict,
                   "RATIO_PIN only valid inside RATIO_SPACE",
                   Success, Diag);
                Out_Tag := Type_None;
                return;

             when AST_Morton_Tile_Block =>
                declare
                   Surf_Node : Node_Index := Tree (Node).Left_Child;
                   pragma Unreferenced (Surf_Node);
                   Size_Node : Node_Index := Tree (Node).Right_Child;
                   Body_Node : Node_Index := 0;
                   Tile_W    : U64 := 0;
                   Tile_H    : U64 := 0;

                   -- ceil(log2(N)) for N>=1. Used to decide how many
                   -- (X,Y) decode bit pairs to inline below.
                   function Ceil_Log2 (N : U64) return Natural is
                      M : U64 := 1;
                      B : Natural := 0;
                   begin
                      while M < N loop
                         M := M * 2;
                         B := B + 1;
                      end loop;
                      return B;
                   end Ceil_Log2;
                begin
                   if Size_Node /= 0 then
                      Body_Node := Tree (Size_Node).Next_Sibling;
                      if Tree (Size_Node).Kind = AST_Morton_Tile_Size then
                         declare
                            W_Node : Node_Index := Tree (Size_Node).Left_Child;
                            H_Node : Node_Index := Tree (Size_Node).Right_Child;
                         begin
                             if W_Node /= 0 and then Tree (W_Node).Kind = AST_Number_Expr then
                                declare
                                   Tok : Token := Tokens (Tree (W_Node).Token_Index);
                                begin
                                   Parse_Decimal (Input_Buffer (Tok.Start .. Tok.Start + Tok.Length - 1), Tile_W, Success);
                                end;
                             end if;
                             if H_Node /= 0 and then Tree (H_Node).Kind = AST_Number_Expr then
                                declare
                                   Tok : Token := Tokens (Tree (H_Node).Token_Index);
                                begin
                                   Parse_Decimal (Input_Buffer (Tok.Start .. Tok.Start + Tok.Length - 1), Tile_H, Success);
                                end;
                             end if;
                             -- Handle Tok_Tile_Size ("$WxH") case: children are 0,
                             -- dimensions are embedded in Size_Node's own token.
                             if W_Node = 0 and H_Node = 0 then
                                declare
                                   STok   : Token := Tokens (Tree (Size_Node).Token_Index);
                                   Txt    : String renames Input_Buffer (STok.Start .. STok.Start + STok.Length - 1);
                                   X_Pos  : Integer := 0;
                                begin
                                   for I in Txt'Range loop
                                      if Txt (I) = 'x' or else Txt (I) = 'X' then
                                         X_Pos := I;
                                         exit;
                                      end if;
                                   end loop;
                                   if X_Pos > Txt'First + 1 and X_Pos < Txt'Last then
                                      Parse_Decimal (Txt (Txt'First + 1 .. X_Pos - 1), Tile_W, Success);
                                      Parse_Decimal (Txt (X_Pos + 1 .. Txt'Last), Tile_H, Success);
                                   end if;
                                end;
                             end if;
                         end;
                      end if;
                   end if;
                   if Tile_W = 0 or else Tile_H = 0 then
                      Fail_Node (Node, Err_Type_Conflict, "MORTON_TILE REQUIRES COMPILE-TIME DIMS", Success, Diag);
                      return;
                   end if;
                   if Target = Backend_FASM then
                      -- Task A4: emit a Z-order iteration loop. For each
                      -- compile-time-known idx in [0, Tile_W*Tile_H) we
                      -- inline-decode idx into (X, Y), stash them in two
                      -- predeclared U64 globals (MTX, MTY), then walk the
                      -- body. r12 is callee-saved across printf, so the
                      -- body can call any runtime helper without losing
                      -- the loop counter.
                      declare
                         Dummy_Tag : ALB_Type_Tag;
                         Dummy_Sym : Symbol_Record;
                         pragma Unreferenced (Dummy_Sym);
                      begin
                         Dummy_Sym := Resolve_Symbol
                           ("MTX", Type_U64, 0, False, Dummy_Tag);
                         Dummy_Sym := Resolve_Symbol
                           ("MTY", Type_U64, 0, False, Dummy_Tag);
                      end;

                      declare
                         NID_Img : constant String := Node_Index'Image (Node);
                         NID     : constant String :=
                           NID_Img (NID_Img'First + 1 .. NID_Img'Last);
                         Loop_Lbl : constant String :=
                           ".MORTON_LOOP_" & NID;
                         End_Lbl  : constant String :=
                           ".MORTON_END_" & NID;
                         N_Cells  : constant U64 := Tile_W * Tile_H;
                         B_X      : constant Natural := Ceil_Log2 (Tile_W);
                         B_Y      : constant Natural := Ceil_Log2 (Tile_H);
                         N_Bits   : constant Natural := Natural'Max (B_X, B_Y);
                         MTX_Lex  : constant String := Scoped_Lexeme ("MTX");
                         MTY_Lex  : constant String := Scoped_Lexeme ("MTY");
                      begin
                         Transpiler_Native_HAL.Emit_Raw
                           ("  ; MORTON_TILE " &
                            Nat_Img (Natural (Tile_W)) & "x" &
                            Nat_Img (Natural (Tile_H)) &
                            " (" & Nat_Img (Natural (N_Cells)) &
                            " cells, " & Nat_Img (N_Bits) & "-bit decode)",
                            Success);
                         Transpiler_Native_HAL.Emit_Newline (Success);

                         Transpiler_Native_HAL.Emit_Raw
                           ("  push r12", Success);
                         Transpiler_Native_HAL.Emit_Newline (Success);
                         Transpiler_Native_HAL.Emit_Raw
                           ("  xor r12, r12", Success);
                         Transpiler_Native_HAL.Emit_Newline (Success);

                         Transpiler_Native_HAL.Emit_Raw
                           (Loop_Lbl & ":", Success);
                         Transpiler_Native_HAL.Emit_Newline (Success);
                         Transpiler_Native_HAL.Emit_Raw
                           ("  cmp r12, " &
                            Nat_Img (Natural (N_Cells)), Success);
                         Transpiler_Native_HAL.Emit_Newline (Success);
                         Transpiler_Native_HAL.Emit_Raw
                           ("  jae " & End_Lbl, Success);
                         Transpiler_Native_HAL.Emit_Newline (Success);

                         -- Inline Morton decode: 2*N_Bits bits of r12
                         -- (even bits -> X, odd bits -> Y).
                         Transpiler_Native_HAL.Emit_Raw
                           ("  xor rax, rax", Success);
                         Transpiler_Native_HAL.Emit_Newline (Success);
                         Transpiler_Native_HAL.Emit_Raw
                           ("  xor rdx, rdx", Success);
                         Transpiler_Native_HAL.Emit_Newline (Success);
                         for I in 0 .. N_Bits - 1 loop
                            -- X bit I = (r12 >> (2*I)) & 1, then << I
                            Transpiler_Native_HAL.Emit_Raw
                              ("  mov r8, r12", Success);
                            Transpiler_Native_HAL.Emit_Newline (Success);
                            if I > 0 then
                               Transpiler_Native_HAL.Emit_Raw
                                 ("  shr r8, " & Nat_Img (2 * I), Success);
                               Transpiler_Native_HAL.Emit_Newline (Success);
                            end if;
                            Transpiler_Native_HAL.Emit_Raw
                              ("  and r8, 1", Success);
                            Transpiler_Native_HAL.Emit_Newline (Success);
                            if I > 0 then
                               Transpiler_Native_HAL.Emit_Raw
                                 ("  shl r8, " & Nat_Img (I), Success);
                               Transpiler_Native_HAL.Emit_Newline (Success);
                            end if;
                            Transpiler_Native_HAL.Emit_Raw
                              ("  or rax, r8", Success);
                            Transpiler_Native_HAL.Emit_Newline (Success);
                            -- Y bit I = (r12 >> (2*I+1)) & 1, then << I
                            Transpiler_Native_HAL.Emit_Raw
                              ("  mov r8, r12", Success);
                            Transpiler_Native_HAL.Emit_Newline (Success);
                            Transpiler_Native_HAL.Emit_Raw
                              ("  shr r8, " & Nat_Img (2 * I + 1), Success);
                            Transpiler_Native_HAL.Emit_Newline (Success);
                            Transpiler_Native_HAL.Emit_Raw
                              ("  and r8, 1", Success);
                            Transpiler_Native_HAL.Emit_Newline (Success);
                            if I > 0 then
                               Transpiler_Native_HAL.Emit_Raw
                                 ("  shl r8, " & Nat_Img (I), Success);
                               Transpiler_Native_HAL.Emit_Newline (Success);
                            end if;
                            Transpiler_Native_HAL.Emit_Raw
                              ("  or rdx, r8", Success);
                            Transpiler_Native_HAL.Emit_Newline (Success);
                         end loop;
                         Transpiler_Native_HAL.Emit_Raw
                           ("  mov [" & MTX_Lex & "], rax", Success);
                         Transpiler_Native_HAL.Emit_Newline (Success);
                         Transpiler_Native_HAL.Emit_Raw
                           ("  mov [" & MTY_Lex & "], rdx", Success);
                         Transpiler_Native_HAL.Emit_Newline (Success);

                         if Body_Node /= 0 then
                            Walk_AST
                              (Body_Node, Depth + 1, Out_Tag, Success, Diag);
                            if not Success then return; end if;
                         end if;

                         Transpiler_Native_HAL.Emit_Raw
                           ("  inc r12", Success);
                         Transpiler_Native_HAL.Emit_Newline (Success);
                         Transpiler_Native_HAL.Emit_Raw
                           ("  jmp " & Loop_Lbl, Success);
                         Transpiler_Native_HAL.Emit_Newline (Success);
                         Transpiler_Native_HAL.Emit_Raw
                           (End_Lbl & ":", Success);
                         Transpiler_Native_HAL.Emit_Newline (Success);
                         Transpiler_Native_HAL.Emit_Raw
                           ("  pop r12", Success);
                         Transpiler_Native_HAL.Emit_Newline (Success);
                      end;
                   elsif Target = Backend_C then
                      -- Task 1D (C): Z-order iteration loop.  We declare
                      -- MTX / MTY as U64 globals, then for each idx in
                      -- [0, Tile_W*Tile_H) we decode the Morton index
                      -- inline (bit unshuffle) and write the result into
                      -- MTX / MTY.  Body walks per iteration.
                      declare
                         Dummy_Tag : ALB_Type_Tag;
                         Dummy_Sym : Symbol_Record;
                         pragma Unreferenced (Dummy_Sym);
                      begin
                         Dummy_Sym := Resolve_Symbol
                           ("MTX", Type_U64, 0, False, Dummy_Tag);
                         Dummy_Sym := Resolve_Symbol
                           ("MTY", Type_U64, 0, False, Dummy_Tag);
                      end;

                      declare
                         NID_Img : constant String := Node_Index'Image (Node);
                         NID     : constant String :=
                           NID_Img (NID_Img'First + 1 .. NID_Img'Last);
                         N_Cells : constant U64 := Tile_W * Tile_H;
                         B_X     : constant Natural := Ceil_Log2 (Tile_W);
                         B_Y     : constant Natural := Ceil_Log2 (Tile_H);
                         N_Bits  : constant Natural := Natural'Max (B_X, B_Y);
                         Idx_Var : constant String := "ALB_Morton_Idx_" & NID;
                      begin
                         Transpiler_Native_HAL.Emit_Raw
                           ("/* MORTON_TILE " &
                            Nat_Img (Natural (Tile_W)) & "x" &
                            Nat_Img (Natural (Tile_H)) & " (" &
                            Nat_Img (Natural (N_Cells)) & " cells, " &
                            Nat_Img (N_Bits) & "-bit decode) */",
                            Success);
                         Transpiler_Native_HAL.Emit_Newline (Success);

                         Transpiler_Native_HAL.Emit_Raw
                           ("for (uint64_t " & Idx_Var & " = 0; " &
                            Idx_Var & " < " &
                            Nat_Img (Natural (N_Cells)) & "; " &
                            Idx_Var & "++) {", Success);
                         Transpiler_Native_HAL.Emit_Newline (Success);
                         Transpiler_Native_HAL.Increase_Indent;

                         -- Inline Morton decode: even bits -> MTX,
                         -- odd bits -> MTY.  Build the expression as
                         -- two | chains so gcc folds it nicely.
                         Transpiler_Native_HAL.Emit_Raw
                           ("MTX = 0;", Success);
                         Transpiler_Native_HAL.Emit_Newline (Success);
                         Transpiler_Native_HAL.Emit_Raw
                           ("MTY = 0;", Success);
                         Transpiler_Native_HAL.Emit_Newline (Success);
                         for I in 0 .. N_Bits - 1 loop
                            Transpiler_Native_HAL.Emit_Raw
                              ("MTX |= ((" & Idx_Var & " >> " &
                               Nat_Img (2 * I) & ") & 1ULL) << " &
                               Nat_Img (I) & ";", Success);
                            Transpiler_Native_HAL.Emit_Newline (Success);
                            Transpiler_Native_HAL.Emit_Raw
                              ("MTY |= ((" & Idx_Var & " >> " &
                               Nat_Img (2 * I + 1) & ") & 1ULL) << " &
                               Nat_Img (I) & ";", Success);
                            Transpiler_Native_HAL.Emit_Newline (Success);
                         end loop;

                         if Body_Node /= 0 then
                            Walk_AST (Body_Node, Depth + 1, Out_Tag,
                                      Success, Diag);
                            if not Success then return; end if;
                         end if;

                         Transpiler_Native_HAL.Decrease_Indent;
                         Transpiler_Native_HAL.Emit_Raw ("}", Success);
                         Transpiler_Native_HAL.Emit_Newline (Success);
                      end;
                   else
                      if Body_Node /= 0 then
                         Walk_AST (Body_Node, Depth + 1, Out_Tag, Success, Diag);
                      end if;
                   end if;
                   Out_Tag := Type_None;
                end;

             when AST_Block_Stmt =>
                -- Legacy ENUM-as-block path (Tok_Enum marker).
               if Tree(Node).Token_Index > 0 and then Tokens(Tree(Node).Token_Index).Kind = Tok_Enum then
                  declare
                     Child : Node_Index := Tree(Node).Left_Child;
                     Val   : Natural := 0;
                  begin
                     while Child /= 0 loop
                        if Tree (Child).Token_Index > 0 then
                           declare
                              Lex : constant String :=
                                Raw_Lexeme (Tree (Child).Token_Index);
                              H   : constant U32 := Hash_String (Lex);
                              Img : constant String := Natural'Image (Val);
                              Dig : constant String :=
                                Img (Img'First + 1 .. Img'Last);
                              Replaced : Boolean := False;
                           begin
                              for I in 1 .. Const_Count loop
                                 if Const_Vault (I).Hash = H then
                                    Const_Vault (I).Val := U64 (Val);
                                    Replaced := True;
                                    exit;
                                 end if;
                              end loop;
                              if not Replaced and then Const_Count < Max_Consts then
                                 Const_Count := Const_Count + 1;
                                 Const_Vault (Const_Count) := (H, U64 (Val));
                              end if;
                              if Target = Backend_FASM then
                                 Transpiler_Native_HAL.Emit_Raw
                                   (Lex & " equ " & Dig, Success);
                                 Transpiler_Native_HAL.Emit_Newline (Success);
                              elsif Target = Backend_C then
                                 Transpiler_Native_HAL.Emit_Raw
                                   ("#define " & Lex & " " & Dig, Success);
                                 Transpiler_Native_HAL.Emit_Newline (Success);
                              end if;
                           end;
                           Val := Val + 1;
                        end if;
                        Child := Tree (Child).Next_Sibling;
                     end loop;
                  end;
               else
                  -- Standard Block processing for normal code
                  declare
                     Child : Node_Index := Tree(Node).Left_Child;
                  begin
                     while Child /= 0 loop
                        if not Native_ASM_Should_Skip_Node (Child) then
                           Walk_AST(Child, Depth + 1, Out_Tag, Success, Diag);
                        end if;
                        Child := Tree(Child).Next_Sibling;
                     end loop;
                  end;
               end if;
               
            

            when AST_Number_Expr =>
               declare
                  Tok        : Token := Tokens (Tree (Node).Token_Index);
                  Lexeme     : String := Input_Buffer (Tok.Start .. Tok.Start + Tok.Length - 1);
                  Parsed_Val : U64 := 0;
                  Parse_OK   : Boolean := False;
               begin
                  if Is_Real_Number_Text (Lexeme) then
                     Parse_OK := Parse_Real_Literal_Bits (Lexeme, Parsed_Val);
                  else
                     Parse_Decimal (Lexeme, Parsed_Val, Parse_OK);
                  end if;
                  if not Parse_OK then
                     Fail_Node (Node, Err_Compiler_AST_Mismatch, Lexeme, Success, Diag);
                     return;
                  end if;
                  if Target = Backend_FASM then
                     Transpiler_Native_HAL.Emit_Raw ("  mov rax, ", Success);
                     Transpiler_Native_HAL.Emit_Literal_U64 (Parsed_Val, Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                  elsif Target = Backend_FASM16 then
                     Emit_FASM16_Literal_DXAX
                       (Parsed_Val,
                        Node,
                        "FASM16 literal exceeds U32");
                     if not Success then
                        return;
                     end if;
                  else
                     Transpiler_Native_HAL.Emit_Literal_U64 (Parsed_Val, Success);
                  end if;
                  if Is_Real_Number_Text (Lexeme) then
                     Out_Tag := Type_F64;
                  elsif Lexeme'Length > 0 and then Lexeme (Lexeme'First) = '-' then
                     Out_Tag := Type_S32;
                  else
                     Out_Tag := Type_U64;
                  end if;
               end;
               
            when AST_Hex_Expr =>
               declare
                  Tok        : Token := Tokens (Tree (Node).Token_Index);
                  Lexeme     : String := Input_Buffer (Tok.Start .. Tok.Start + Tok.Length - 1);
                  Parsed_Val : U64 := 0;
                  Parse_OK   : Boolean := False;
               begin
                  Parse_Hex (Lexeme, Parsed_Val, Parse_OK);
                  if Target = Backend_FASM then
                     Transpiler_Native_HAL.Emit_Raw ("  mov rax, ", Success);
                     Transpiler_Native_HAL.Emit_Literal_U64 (Parsed_Val, Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                  elsif Target = Backend_FASM16 then
                     Emit_FASM16_Literal_DXAX
                       (Parsed_Val,
                        Node,
                        "FASM16 literal exceeds U32");
                     if not Success then
                        return;
                     end if;
                  else
                     Transpiler_Native_HAL.Emit_Literal_U64 (Parsed_Val, Success);
                  end if;
                  Out_Tag := Type_U64;
               end;

            when AST_Bin_Expr =>
               declare
                  Tok        : Token := Tokens (Tree (Node).Token_Index);
                  Lexeme     : String := Input_Buffer (Tok.Start .. Tok.Start + Tok.Length - 1);
                  Parsed_Val : U64 := 0;
                  Parse_OK   : Boolean := False;
               begin
                  Parse_Binary (Lexeme, Parsed_Val, Parse_OK);
                  if Target = Backend_FASM then
                     Transpiler_Native_HAL.Emit_Raw ("  mov rax, ", Success);
                     Transpiler_Native_HAL.Emit_Literal_U64 (Parsed_Val, Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                  elsif Target = Backend_FASM16 then
                     Emit_FASM16_Literal_DXAX
                       (Parsed_Val,
                        Node,
                        "FASM16 literal exceeds U32");
                     if not Success then
                        return;
                     end if;
                  else
                     Transpiler_Native_HAL.Emit_Literal_U64 (Parsed_Val, Success);
                  end if;
                  Out_Tag := Type_U64;
               end;
               
            when AST_Octal_Expr =>
               declare
                  Tok        : Token := Tokens (Tree (Node).Token_Index);
                  Lexeme     : String := Input_Buffer (Tok.Start .. Tok.Start + Tok.Length - 1);
                  Parsed_Val : U64 := 0;
                  Parse_OK   : Boolean := False;
               begin
                  Parse_Octal (Lexeme, Parsed_Val, Parse_OK);
                  if Target = Backend_FASM then
                     Transpiler_Native_HAL.Emit_Raw ("  mov rax, ", Success);
                     Transpiler_Native_HAL.Emit_Literal_U64 (Parsed_Val, Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                  elsif Target = Backend_FASM16 then
                     Emit_FASM16_Literal_DXAX
                       (Parsed_Val,
                        Node,
                        "FASM16 literal exceeds U32");
                     if not Success then
                        return;
                     end if;
                  else
                     Transpiler_Native_HAL.Emit_Literal_U64 (Parsed_Val, Success);
                  end if;
                  Out_Tag := Type_U64;
               end;
               
            when AST_True =>
               if Target = Backend_FASM then
                  Transpiler_Native_HAL.Emit_Raw ("  mov rax, 1", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);
               elsif Target = Backend_FASM16 then
                  Transpiler_Native_HAL.Emit_Raw ("  mov ax, 1", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);
                  Transpiler_Native_HAL.Emit_Raw ("  xor dx, dx", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);
               else
                  Transpiler_Native_HAL.Emit_Literal_U64 (1, Success);
               end if;
               Out_Tag := Type_Boolean;

            when AST_False =>
               if Target = Backend_FASM then
                  Transpiler_Native_HAL.Emit_Raw ("  xor rax, rax", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);
               elsif Target = Backend_FASM16 then
                  Transpiler_Native_HAL.Emit_Raw ("  xor ax, ax", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);
                  Transpiler_Native_HAL.Emit_Raw ("  xor dx, dx", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);
               else
                  Transpiler_Native_HAL.Emit_Literal_U64 (0, Success);
               end if;
               Out_Tag := Type_Boolean;

            when AST_Require_Clause =>
               Transpiler_Native_HAL.Emit_Require_Start(Success);
               if not Success then
                  return;
               end if;
               Walk_AST(Tree(Node).Left_Child, Depth + 1, Out_Tag, Success, Diag);
               if not Success then
                  return;
               end if;
               Transpiler_Native_HAL.Emit_Contract_End("REQUIRE", Success);
               if not Success then
                  return;
               end if;
               Out_Tag := Type_None;

            when AST_Ensure_Clause =>
               Transpiler_Native_HAL.Emit_Ensure_Start(Success);
               if not Success then
                  return;
               end if;
               Walk_AST(Tree(Node).Left_Child, Depth + 1, Out_Tag, Success, Diag);
               if not Success then
                  return;
               end if;
               Transpiler_Native_HAL.Emit_Contract_End("ENSURE", Success);
               if not Success then
                  return;
               end if;
               Out_Tag := Type_None;
            
            when AST_String_Expr =>
               declare
                  Tok    : Token := Tokens (Tree (Node).Token_Index);
               begin
                  if Tok.Length >= 2 then
                     declare
                        Lexeme : String := (if Tok.Length > 2 
                                            then Input_Buffer (Tok.Start + 1 .. Tok.Start + Tok.Length - 2) 
                                            else "");
                     begin
                        if Target = Backend_FASM then
                           -- DA NEW FIX: True Bare-Metal Inline String Allocation wi' LOCAL LABELS!
                           declare
                              Idx_Str : String := Natural'Image (Tree (Node).Token_Index);
                              Clean_Idx : String (1 .. Idx_Str'Length - 1) := Idx_Str (2 .. Idx_Str'Length);
                           begin
                              -- Jump ower the string data sae the CPU disna execute it!
                              Transpiler_Native_HAL.Emit_Raw ("  jmp .alb_skip_str_" & Clean_Idx, Success); Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  .alb_str_" & Clean_Idx & " db """, Success);
                              
                              -- Safely dump the lexeme, doublin' up any dooble-quotes for FASM
                              for I in Lexeme'Range loop
                                 if Lexeme(I) = '"' then
                                    Transpiler_Native_HAL.Emit_Raw ("""""", Success);
                                 else
                                    Transpiler_Native_HAL.Emit_Raw (Lexeme(I..I), Success);
                                 end if;
                              end loop;
                              
                              -- Null terminate an' anchor the skip label
                              Transpiler_Native_HAL.Emit_Raw (""", 0", Success); Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  .alb_skip_str_" & Clean_Idx & ":", Success); Transpiler_Native_HAL.Emit_Newline (Success);
                              
                              -- Load the true memory pointer intae rax!
                              Transpiler_Native_HAL.Emit_Raw ("  lea rax, [.alb_str_" & Clean_Idx & "]", Success); Transpiler_Native_HAL.Emit_Newline (Success);
                           end;
                        else
                           Transpiler_Native_HAL.Emit_String_Literal (Lexeme, Success);
                        end if;
                     end;
                  end if;
                  Out_Tag := Type_Binary;
               end;
               
            when AST_Const_Decl =>
               declare
                  Ref_Node : Node_Index := Tree(Node).Left_Child;
                  Exp_Node : Node_Index := Tree(Node).Right_Child;
                  Tok      : Token := Tokens (Tree(Ref_Node).Token_Index);
                  Lex      : String := Input_Buffer(Tok.Start .. Tok.Start + Tok.Length - 1);
                  H        : U32 := Hash_String(Lex);
                  Val      : U64 := 0;
               begin
                  -- Statically evaluate full compile-time expressions, not just
                  -- bare literals. Packed PURE constants rely on SHL/OR here.
                  if Exp_Node /= 0 then
                     Comptime_Eval_Expr (Exp_Node, Val, Success, Diag);
                     if not Success or else not Diag.Success then
                        return;
                     end if;
                  end if;
                  
                  if Const_Count < Max_Consts then
                     Const_Count := Const_Count + 1;
                     Const_Vault(Const_Count) := (H, Val);
                  end if;
                  Success := True;
               end;

            when AST_Const_Ref =>
               declare
                  Tok : Token := Tokens (Tree(Node).Token_Index);
                  Lex : String := Input_Buffer(Tok.Start .. Tok.Start + Tok.Length - 1);
                  H   : U32 := Hash_String(Lex);
                  Val : U64 := 0;
               begin
                  for I in 1 .. Const_Count loop
                     if Const_Vault(I).Hash = H then Val := Const_Vault(I).Val; exit; end if;
                  end loop;
                  
                  -- Emit purely as a hardcoded literal! ZERO memory used!
                  if Target = Backend_FASM then
                     Transpiler_Native_HAL.Emit_Raw ("  mov rax, ", Success);
                     Transpiler_Native_HAL.Emit_Literal_U64 (Val, Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                  elsif Target = Backend_FASM16 then
                     Emit_FASM16_Literal_DXAX
                       (Val,
                        Node,
                        "FASM16 CONST exceeds U32");
                     if not Success then
                        return;
                     end if;
                  else
                     Transpiler_Native_HAL.Emit_Literal_U64 (Val, Success);
                  end if;
                  Out_Tag := Type_U64;
               end;
            
            when AST_Var_Expr =>
               declare
                  Tok        : Token := Tokens (Tree (Node).Token_Index);
                  Lexeme     : String := Input_Buffer (Tok.Start .. Tok.Start + Tok.Length - 1);
                  Sym        : Symbol_Record;
                  Sym_Found  : Boolean := False;
                  Bare_Const_Val   : U64 := 0;
                  Bare_Const_Found : Boolean := False;
                  
                  -- DA NEW TARGET LEX ARMOR FOR EMISSION!
                  Target_Lex : String (1 .. 128) := (others => ' ');
                  Target_Len : Natural := 0;
                  Element_Range : Natural := 0;
               begin
                  -- Propagate the active module prefix sae variables match their signatures!
                  -- Use the same symbol spelling as declarations/resolution.
                  declare
                     Safe_Name : constant String := Resolve_Existing_Name (Lexeme);
                  begin
                     if Safe_Name'Length > Target_Lex'Length then
                        Fail_Node (Node, Err_Type_Conflict, Lexeme, Success, Diag);
                        return;
                     end if;

                     Target_Lex (1 .. Safe_Name'Length) := Safe_Name;
                     Target_Len := Safe_Name'Length;
                  end;

                  Ensure_Firewall_Access (Node, True, False, Node, Success, Diag);
                  if not Success then
                     return;
                  end if;

                  if Target_Len > 0 then
                     Find_Symbol
                       (Hash_String (Target_Lex (1 .. Target_Len)),
                        Current_Scope,
                        Sym_Found,
                        Sym);
                  end if;

                  if not Sym_Found and then Current_Scope /= 0 and then Target_Len > 0 then
                     Find_Symbol
                       (Hash_String (Target_Lex (1 .. Target_Len)),
                        0,
                        Sym_Found,
                        Sym);
                  end if;

                  if not Sym_Found
                    and then Tree (Node).Left_Child > 0
                    and then Target_Len > 0
                  then
                     declare
                        Ref_Name : constant String := Target_Lex (1 .. Target_Len);
                     begin
                        if Find_Strict_Array (Ref_Name) > 0
                          or else Find_Slide_Array (Ref_Name) > 0
                        then
                           Sym_Found := True;
                           Sym.Tag := Array_Declared_Tag (Ref_Name, Type_U64);
                           Sym.Class := Class_Global;
                           Out_Tag := Sym.Tag;
                        end if;
                     end;
                  end if;

                  if not Sym_Found and then Tree (Node).Left_Child = 0 then
                     declare
                        Bare_Const_Name : constant String := "#" & Lexeme;
                        Bare_Const_Hash : constant U32 := Hash_String (Bare_Const_Name);
                        Plain_Hash      : constant U32 := Hash_String (Lexeme);
                     begin
                        for I in 1 .. Const_Count loop
                           if Const_Vault (I).Hash = Bare_Const_Hash
                             or else Const_Vault (I).Hash = Plain_Hash
                           then
                              Bare_Const_Val := Const_Vault (I).Val;
                              Bare_Const_Found := True;
                              exit;
                           end if;
                        end loop;
                     end;
                  end if;

                  if Bare_Const_Found then
                     if Target = Backend_FASM then
                        Transpiler_Native_HAL.Emit_Raw ("  mov rax, ", Success);
                        Transpiler_Native_HAL.Emit_Literal_U64 (Bare_Const_Val, Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                     elsif Target = Backend_FASM16 then
                        Emit_FASM16_Literal_DXAX
                          (Bare_Const_Val,
                           Node,
                           "FASM16 CONST exceeds U32");
                        if not Success then
                           return;
                        end if;
                     else
                        Transpiler_Native_HAL.Emit_Literal_U64 (Bare_Const_Val, Success);
                     end if;
                     Out_Tag := Type_U64;
                     return;
                  end if;

                  if not Sym_Found then
                     Sym := Resolve_Symbol (Lexeme, Type_U64, 0, False, Out_Tag);
                  else
                     Out_Tag := Sym.Tag;
                  end if
                  ;
                  
                  
                  if Tree(Node).Left_Child > 0 then
                     Element_Range := Find_Range_Array(Target_Lex(1 .. Target_Len));

                     if Element_Range > 0 then
                        Out_Tag := Range_Types(Element_Range).Base_Tag;
                     end if;
                  end if;


                  --  if Target = Backend_FASM16 then
                  --     -- FASM16 Tiny profile:
                  --     -- Scalar variables are 16-bit cells for now.
                  --     -- Value results are returned in AX.
                  --     if Tree (Node).Left_Child > 0 then
                  --        Fail_Node (Node, Err_Type_Conflict, Lexeme, Success, Diag);
                  --        return;
                  --     end if;
                  --  
                  --     if Sym.Tag = Type_U8 or else Sym.Tag = Type_Boolean then
                  --        Transpiler_Native_HAL.Emit_Raw ("  xor ax, ax", Success);
                  --        Transpiler_Native_HAL.Emit_Newline (Success);
                  --        Transpiler_Native_HAL.Emit_Raw ("  mov al, byte [", Success);
                  --        Transpiler_Native_HAL.Emit_Raw (Target_Lex (1 .. Target_Len), Success);
                  --        Transpiler_Native_HAL.Emit_Raw ("]", Success);
                  --        Transpiler_Native_HAL.Emit_Newline (Success);
                  --     else
                  --        Transpiler_Native_HAL.Emit_Raw ("  mov ax, word [", Success);
                  --        Transpiler_Native_HAL.Emit_Raw (Target_Lex (1 .. Target_Len), Success);
                  --        Transpiler_Native_HAL.Emit_Raw ("]", Success);
                  --        Transpiler_Native_HAL.Emit_Newline (Success);
                  --     end if;
                  if Target = Backend_FASM16 then
                     if Tree (Node).Left_Child > 0 then
                        Validate_Strict_Array_Literal_Indexes
                          (Target_Lex (1 .. Target_Len),
                           Tree (Node).Left_Child,
                           Node,
                           Success,
                           Diag);

                        if not Success then
                           return;
                        end if;

                        Validate_Slide_Array_Literal_Indexes
                          (Target_Lex (1 .. Target_Len),
                           Tree (Node).Left_Child,
                           Node,
                           Success,
                           Diag);

                        if not Success then
                           return;
                        end if;

                        --  if Sym.Tag /= Type_U8
                        --    and then Sym.Tag /= Type_U16
                        --    and then Sym.Tag /= Type_Boolean
                        --  then
                         if not FASM16_Scalar_Supported (Sym.Tag) then
                            Fail_Node (Node, Err_Type_Conflict, Lexeme, Success, Diag);
                            return;
                         end if;

                         declare
                            Elem_Bytes : constant Natural := FASM16_Storage_Bytes (Sym.Tag);
                         begin
                            Emit_FASM16_Array_Index_Offset_To_BX
                              (Target_Lex (1 .. Target_Len),
                               Tree (Node).Left_Child,
                               Elem_Bytes);

                            if not Success then
                               return;
                            end if;

                            if Sym.Class = Class_Local and then Sym.Offset < 0 then
                               declare
                                  Img : constant String := Integer'Image (-Sym.Offset);
                                  Off : constant String := Img (Img'First + 1 .. Img'Last);
                               begin
                                  Transpiler_Native_HAL.Emit_Raw ("  mov si, bx", Success);
                                  Transpiler_Native_HAL.Emit_Newline (Success);
                                  Emit_FASM16_Load_Cell_To_DXAX ("bp+si-" & Off, Sym.Tag);
                               end;
                            else
                               Emit_FASM16_Load_Cell_To_DXAX
                                 (Target_Lex (1 .. Target_Len) & " + bx",
                                  Sym.Tag);
                            end if;
                         end;
                        
                     --  elsif Sym.Class = Class_Local and then Sym.Offset < 0 then
                     --     declare
                     --        Img : constant String := Integer'Image (-Sym.Offset);
                     --        Off : constant String := Img (Img'First + 1 .. Img'Last);
                     --     begin
                     --        if Sym.Tag = Type_U8 or else Sym.Tag = Type_Boolean then
                     --           Transpiler_Native_HAL.Emit_Raw ("  xor ax, ax", Success);
                     --           Transpiler_Native_HAL.Emit_Newline (Success);
                     --           Transpiler_Native_HAL.Emit_Raw ("  xor dx, dx", Success);
                     --           Transpiler_Native_HAL.Emit_Newline (Success);
                     --           Transpiler_Native_HAL.Emit_Raw ("  mov al, byte [bp-" & Off & "]", Success);
                     --        elsif Sym.Tag = Type_U32 or else Sym.Tag = Type_S32 then
                     --           Transpiler_Native_HAL.Emit_Raw ("  mov ax, word [bp-" & Off & "]", Success);
                     --           Transpiler_Native_HAL.Emit_Newline (Success);
                     --           Transpiler_Native_HAL.Emit_Raw ("  mov dx, word [bp-" & Off & "+2]", Success);
                     --        else
                     --           Transpiler_Native_HAL.Emit_Raw ("  mov ax, word [bp-" & Off & "]", Success);
                     --           Transpiler_Native_HAL.Emit_Newline (Success);
                     --           Transpiler_Native_HAL.Emit_Raw ("  xor dx, dx", Success);
                     --        end if;
                     --        Transpiler_Native_HAL.Emit_Newline (Success);
                     --     end;
                     --  
                     --  elsif Sym.Class = Class_Local and then Sym.Offset > 0 then
                     --     declare
                     --        Img : constant String := Integer'Image (Sym.Offset);
                     --        Off : constant String := Img (Img'First + 1 .. Img'Last);
                     --     begin
                     --        if Sym.Tag = Type_U8 or else Sym.Tag = Type_Boolean then
                     --           Transpiler_Native_HAL.Emit_Raw ("  xor ax, ax", Success);
                     --           Transpiler_Native_HAL.Emit_Newline (Success);
                     --           Transpiler_Native_HAL.Emit_Raw ("  xor dx, dx", Success);
                     --           Transpiler_Native_HAL.Emit_Newline (Success);
                     --           Transpiler_Native_HAL.Emit_Raw ("  mov al, byte [bp+" & Off & "]", Success);
                     --        elsif Sym.Tag = Type_U32 or else Sym.Tag = Type_S32 then
                     --           Transpiler_Native_HAL.Emit_Raw ("  mov ax, word [bp+" & Off & "]", Success);
                     --           Transpiler_Native_HAL.Emit_Newline (Success);
                     --           Transpiler_Native_HAL.Emit_Raw ("  mov dx, word [bp+" & Off & "+2]", Success);
                     --        else
                     --           Transpiler_Native_HAL.Emit_Raw ("  mov ax, word [bp+" & Off & "]", Success);
                     --           Transpiler_Native_HAL.Emit_Newline (Success);
                     --           Transpiler_Native_HAL.Emit_Raw ("  xor dx, dx", Success);
                     --        end if;
                     --        Transpiler_Native_HAL.Emit_Newline (Success);
                     --     end;
                     --  
                     --  else
                     --      if Sym.Tag = Type_U8 or else Sym.Tag = Type_Boolean then
                     --         Transpiler_Native_HAL.Emit_Raw ("  xor ax, ax", Success);
                     --         Transpiler_Native_HAL.Emit_Newline (Success);
                     --         Transpiler_Native_HAL.Emit_Raw ("  xor dx, dx", Success);
                     --         Transpiler_Native_HAL.Emit_Newline (Success);
                     --         Transpiler_Native_HAL.Emit_Raw ("  mov al, byte [", Success);
                     --         Transpiler_Native_HAL.Emit_Raw (Target_Lex (1 .. Target_Len), Success);
                     --         Transpiler_Native_HAL.Emit_Raw ("]", Success);
                     --         Transpiler_Native_HAL.Emit_Newline (Success);
                     --      elsif Sym.Tag = Type_U32 or else Sym.Tag = Type_S32 then
                     --         Transpiler_Native_HAL.Emit_Raw ("  mov ax, word [", Success);
                     --         Transpiler_Native_HAL.Emit_Raw (Target_Lex (1 .. Target_Len), Success);
                     --         Transpiler_Native_HAL.Emit_Raw ("]", Success);
                     --         Transpiler_Native_HAL.Emit_Newline (Success);
                     --         Transpiler_Native_HAL.Emit_Raw ("  mov dx, word [", Success);
                     --         Transpiler_Native_HAL.Emit_Raw (Target_Lex (1 .. Target_Len), Success);
                     --         Transpiler_Native_HAL.Emit_Raw ("+2]", Success);
                     --         Transpiler_Native_HAL.Emit_Newline (Success);
                     --      else
                     --         Transpiler_Native_HAL.Emit_Raw ("  mov ax, word [", Success);
                     --         Transpiler_Native_HAL.Emit_Raw (Target_Lex (1 .. Target_Len), Success);
                     --         Transpiler_Native_HAL.Emit_Raw ("]", Success);
                     --         Transpiler_Native_HAL.Emit_Newline (Success);
                     --         Transpiler_Native_HAL.Emit_Raw ("  xor dx, dx", Success);
                     --         Transpiler_Native_HAL.Emit_Newline (Success);
                     --      end if;
                     --  end if;
                     elsif Sym.Class = Class_Local and then Sym.Offset < 0 then
                        declare
                           Img : constant String := Integer'Image (-Sym.Offset);
                           Off : constant String := Img (Img'First + 1 .. Img'Last);
                        begin
                           Emit_FASM16_Load_Cell_To_DXAX ("bp-" & Off, Sym.Tag);
                        end;

                     elsif Sym.Class = Class_Local and then Sym.Offset > 0 then
                        declare
                           Img : constant String := Integer'Image (Sym.Offset);
                           Off : constant String := Img (Img'First + 1 .. Img'Last);
                        begin
                           Emit_FASM16_Load_Cell_To_DXAX ("bp+" & Off, Sym.Tag);
                        end;

                     else
                        Emit_FASM16_Load_Cell_To_DXAX
                          (Target_Lex (1 .. Target_Len),
                           Sym.Tag);
                     end if;

                  elsif Target = Backend_FASM then
                     if Tree (Node).Left_Child > 0 then
                        
                        Validate_Strict_Array_Literal_Indexes
                          (Target_Lex(1 .. Target_Len),
                           Tree(Node).Left_Child,
                           Node,
                           Success,
                           Diag);

                        if not Success then
                           return;
                        end if;
                        
                        Validate_Slide_Array_Literal_Indexes
                          (Target_Lex(1 .. Target_Len),
                           Tree(Node).Left_Child,
                           Node,
                           Success,
                           Diag);

                        if not Success then
                           return;
                        end if;

                        
                        Emit_FASM_Array_Index_Offset_To_RAX
                          (Target_Lex(1 .. Target_Len),
                           Tree (Node).Left_Child);

                        if not Success then
                           return;
                        end if;

                        Transpiler_Native_HAL.Emit_Raw ("  lea rbx, [", Success);
                        Transpiler_Native_HAL.Emit_Raw (Target_Lex(1 .. Target_Len), Success);
                        Transpiler_Native_HAL.Emit_Raw ("]", Success); Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  add rbx, rax", Success); Transpiler_Native_HAL.Emit_Newline (Success);

                        
                        Emit_FASM_Load_Scalar_To_RAX ("rbx", Sym.Tag, Success);
                        
                        if Element_Range > 0 then
                           Emit_FASM_Range_Check_RAX(Element_Range);
                           if not Success then return; end if;
                        end if;
                        
                     else
                        Emit_FASM_Load_Scalar_To_RAX (Target_Lex (1 .. Target_Len), Sym.Tag, Success);
                     end if;
                  else
                     Transpiler_Native_HAL.Emit_Variable_Ref (Target_Lex(1 .. Target_Len), Success);
                     -- Array/Bounds Indexing (Multidimensional Support!)
                     if Tree (Node).Left_Child > 0 then
                        declare
                           Curr_Bound : Node_Index := Tree(Node).Left_Child;
                        begin
                           while Curr_Bound > 0 loop
                              Transpiler_Native_HAL.Emit_Raw ("[", Success);
                              Walk_AST (Curr_Bound, Depth + 1, Right_Tag, Success, Diag);
                              Transpiler_Native_HAL.Emit_Raw ("]", Success);
                              
                              Curr_Bound := Tree(Curr_Bound).Next_Sibling;
                           end loop;
                        end;
                     end if;
                  end if;
               end;
               
            when AST_Poke_Stmt =>
               if Target = Backend_FASM then
                  -- 1. Evaluate Address -> rax
                  Walk_AST (Tree (Node).Left_Child, Depth + 1, Left_Tag, Success, Diag);
                  Transpiler_Native_HAL.Emit_Raw ("  push rax", Success); Transpiler_Native_HAL.Emit_Newline (Success);
                  -- 2. Evaluate Value -> rax
                  Walk_AST (Tree (Node).Right_Child, Depth + 1, Right_Tag, Success, Diag);
                  -- 3. Pop Address -> rbx, then POKE!
                  Transpiler_Native_HAL.Emit_Raw ("  pop rbx", Success); Transpiler_Native_HAL.Emit_Newline (Success);
                  Transpiler_Native_HAL.Emit_Raw ("  mov qword [rbx], rax", Success); Transpiler_Native_HAL.Emit_Newline (Success);
               elsif Target = Backend_FASM16 then
                  declare
                     Store_Tag : constant ALB_Type_Tag :=
                       FASM16_Addressed_Tag
                         (Tree (Node).Left_Child,
                          Tree (Node).Right_Child);
                     Value_Tag : ALB_Type_Tag := Type_None;
                  begin
                     -- Address expressions return a near offset in AX.
                     Walk_AST (Tree (Node).Left_Child, Depth + 1, Left_Tag, Success, Diag);
                     if not Success then
                        return;
                     end if;

                     Transpiler_Native_HAL.Emit_Raw ("  push ax", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);

                     Walk_AST (Tree (Node).Right_Child, Depth + 1, Value_Tag, Success, Diag);
                     if not Success then
                        return;
                     end if;

                     Transpiler_Native_HAL.Emit_Raw ("  pop bx", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Emit_FASM16_Store_DXAX_To_Ptr (Store_Tag);
                  end;
               else
                  Transpiler_Native_HAL.Emit_Indent (Success);
                  Transpiler_Native_HAL.Emit_Poke_Start (Success); -- *(uint64_t*)(uintptr_t)(
                  Walk_AST (Tree (Node).Left_Child, Depth + 1, Left_Tag, Success, Diag);
                  Transpiler_Native_HAL.Emit_Poke_Mid (Success);   -- ) = 
                  Walk_AST (Tree (Node).Right_Child, Depth + 1, Right_Tag, Success, Diag);
                  Transpiler_Native_HAL.Emit_Statement_End (Success); -- ;
               end if;
               
            
            when AST_Let_Stmt =>
               declare
                  Target_Node : Node_Index := Tree(Node).Left_Child;
                  RHS_Node    : Node_Index := Tree(Node).Right_Child;
                  Tok         : Token := Tokens(Tree(Target_Node).Token_Index);
                  Var_Name    : String := Input_Buffer(Tok.Start .. Tok.Start + Tok.Length - 1);
                  Target_Name : constant String := Resolve_Existing_Name (Var_Name);

                  -- DA NEW TARGET WIDTH ARMOR
                  Explicit_Tag : ALB_Type_Tag := Type_None;
                  Inferred_Tag : ALB_Type_Tag := Type_None;
                  Final_Tag    : ALB_Type_Tag := Type_None;
                  Store_Tag    : ALB_Type_Tag := Type_None;
                  Explicit_Range : Natural := 0;
                  Target_Range   : Natural := 0;
                  
                  SID          : Natural := 0; 
                  Sym          : Symbol_Record;
                  Found        : Boolean;
                  Left_Tag     : ALB_Type_Tag := Type_None; -- For Walk_AST
                  Baked_Scalar : Natural := 0;
                  -- Task B3: tracks whether this arm pushed Numeric_Assign_Depth.
                  B3_Numeric_LHS : Boolean := False;
               begin
                  Ensure_Firewall_Access (Target_Node, False, True, Node, Success, Diag);
                  if not Success then
                     return;
                  end if;

                  -- 1. Explicit Type & Struct Resolution
                  if Tree(Node).Token_Index > 0 then
                     declare
                        Type_Tok : Token := Tokens(Tree(Node).Token_Index);
                        Type_Lex : String := Input_Buffer(Type_Tok.Start .. Type_Tok.Start + Type_Tok.Length - 1);
                     begin
                        Explicit_Range := Find_Range_Type(Type_Lex);

                        if Explicit_Range > 0 then
                           Explicit_Tag := Range_Types(Explicit_Range).Base_Tag;
                        else
                           Explicit_Tag := Resolve_Type_Name (Type_Lex);
                           if Explicit_Tag = Type_None then
                              for I in 1 .. 64 loop
                                 if Get_Struct_Name(I) = Type_Lex then
                                    SID := I;
                                    Explicit_Tag := Type_U64;
                                    exit;
                                 end if;
                              end loop;

                              -- AS Name was written but is neither a builtin type,
                              -- a RANGE alias, nor a STRUCT — fail loudly (T1).
                              if SID = 0 then
                                 if Is_Void_Type_Name (Type_Lex) then
                                    Fail_Node
                                      (Node,
                                       Err_Type_Conflict,
                                       "U0/NONE/VOID cannot be used as a value type after AS",
                                       Success,
                                       Diag);
                                 else
                                    Fail_Node
                                      (Node,
                                       Err_Type_Conflict,
                                       "unknown type after AS: " & Type_Lex,
                                       Success,
                                       Diag);
                                 end if;
                                 return;
                              end if;
                           elsif Target = Backend_FASM16
                             and then Belongs_On
                                  (Explicit_Tag, Class_Retro_8_16) = Belong_Out
                           then
                              Fail_Node
                                (Node,
                                 Err_Type_Conflict,
                                 Canonical_Type_Name (Explicit_Tag)
                                   & " is not supported on FASM16/DOS (use 8/16-bit types; wide floats/SIMD/U128 are OUT)",
                                 Success,
                                 Diag);
                              return;
                           end if;
                        end if;
                     end;
                  end if;
                  
                  -- 2. Oracle Inference
                  if RHS_Node > 0 then
                     Inferred_Tag := Infer_Type_Tag(RHS_Node);
                  end if;
                  
                  --  -- 3. Resolve Final Tag
                  --  if Explicit_Tag /= Type_None then Final_Tag := Explicit_Tag;
                  --  elsif Inferred_Tag /= Type_None then Final_Tag := Inferred_Tag;
                  --  else
                  --     Final_Tag := Type_U64; -- Universal safety fallback
                  --  end if;
                  --  
                  --  Store_Tag := Final_Tag;
                  -- 3. Resolve Final Tag
                  if Explicit_Tag /= Type_None then
                     Final_Tag := Explicit_Tag;
                  elsif Inferred_Tag /= Type_None then
                     Final_Tag := Inferred_Tag;
                  else
                     Final_Tag := Type_U64; -- Universal safety fallback
                  end if;

                  Store_Tag := Final_Tag;

                  -- FASM16 DOS personality:
                  -- If this is assignment to an existing scalar/array cell,
                  -- the target's declared storage type wins over RHS inference.
                  if Target = Backend_FASM16
                    and then Explicit_Tag = Type_None
                    and then Tree (Target_Node).Kind = AST_Var_Expr
                  then
                     Find_Symbol (Hash_String (Target_Name), Current_Scope, Found, Sym);

                     if Found then
                        Final_Tag := Sym.Tag;
                        Store_Tag := Sym.Tag;
                     end if;
                  end if;
                  
                  if Explicit_Range > 0 then
                     Target_Range := Explicit_Range;
                  end if;

                  -- ===================================================
                  -- Task B3: PIPE-AS-CONCAT trigger context.
                  -- If the resolved LHS storage type is a numeric integer
                  -- scalar, bump Numeric_Assign_Depth so the BinOp arm
                  -- can detect the "X = A | B with A,B,X all numeric"
                  -- pattern (almost certainly a bitwise-OR mix-up).
                  -- We bump unconditionally here and pop at end of arm
                  -- via the local B3_Numeric_LHS flag; if compilation
                  -- aborts the linger is harmless.
                  -- ===================================================
                  if Final_Tag in
                       Type_U8 | Type_U16 | Type_U32 | Type_U64 |
                       Type_S32 | Type_HW8 | Type_HW16 | Type_HW32 |
                       Type_Boolean
                  then
                     Numeric_Assign_Depth := Numeric_Assign_Depth + 1;
                     B3_Numeric_LHS := True;
                  end if;

                  Baked_Scalar := Find_Comptime_Scalar(Var_Name);
                  if Find_Comptime_Array(Var_Name) > 0
                    or else (Baked_Scalar > 0 and then Comptime_Scalars(Baked_Scalar).Exported)
                  then
                     Fail_Node(Node, Err_Type_Conflict, Var_Name, Success, Diag);
                     return;
                  end if;
                  
                  if Target = Backend_FASM16
                    and then RHS_Node = 0
                    and then Tree (Target_Node).Kind = AST_Var_Expr
                    and then Tree (Target_Node).Left_Child > 0
                  then
                     declare
                        Size_Node           : Node_Index := Tree (Target_Node).Left_Child;
                        Curr_Bnd            : Node_Index := Size_Node;
                        Parsed_Size         : U64 := 0;
                        Total_Elements      : U64 := 1;
                        Allocated_Elements  : U64 := 0;
                     begin
                        if Final_Tag /= Type_U8
                          and then Final_Tag /= Type_HW8
                          and then Final_Tag /= Type_HW16
                          and then Final_Tag /= Type_HW32
                          and then Final_Tag /= Type_U16
                          and then Final_Tag /= Type_U32
                          and then Final_Tag /= Type_S32
                          and then Final_Tag /= Type_Boolean
                        then
                           Fail_Node (Node, Err_Type_Conflict, Var_Name, Success, Diag);
                           return;
                        end if;

                        while Curr_Bnd > 0 loop
                           Parsed_Size := 0;
                           Comptime_Eval_Expr (Curr_Bnd, Parsed_Size, Success, Diag);
                           if not Success or else not Diag.Success or else Parsed_Size = 0 then
                              Fail_Node (Curr_Bnd, Err_Type_Conflict, Var_Name, Success, Diag);
                              return;
                           end if;

                           Total_Elements := Total_Elements * Parsed_Size;
                           Curr_Bnd := Tree (Curr_Bnd).Next_Sibling;
                        end loop;

                        Allocated_Elements := Total_Elements + 1;

                        Register_Strict_Array
                          (Target_Name,
                           Tree (Target_Node).Left_Child,
                           Node,
                           Success,
                           Diag);

                        if not Success then
                           return;
                        end if;

                        Remember_Array_Element_Tag (Target_Name, Final_Tag);

                        if Explicit_Range > 0 then
                           Register_Range_Array (Target_Name, Explicit_Range);
                        end if;
                        
                        if Current_Scope /= 0 then
                           declare
                              Elem_Bytes : constant U64 :=
                                U64 (FASM16_Storage_Bytes (Final_Tag));
                              Allocated_Bytes : constant U64 := Allocated_Elements * Elem_Bytes;
                              Local_OK : Boolean := False;
                           begin
                              if Allocated_Bytes = 0
                                or else Allocated_Bytes > U64 (16#FFFF#)
                              then
                                 Fail_Node (Node, Err_Mem_Out_Of_Bounds, Var_Name, Success, Diag);
                                 return;
                              end if;

                              Find_Symbol (Hash_String (Target_Name), Current_Scope, Found, Sym);
                              if Found then
                                 Fail_Node (Node, Err_Type_Conflict, Var_Name, Success, Diag);
                                 return;
                              end if;

                              Local_Offset := Local_Offset + Integer (Allocated_Bytes);

                              Symbol_Table.Add_Local_Symbol
                                (Token_Idx => Hash_String (Target_Name),
                                 Tag       => Final_Tag,
                                 Ref       => (Target_None, 0),
                                 Offset    => -Local_Offset,
                                 Struct_ID => 0,
                                 Scope     => Current_Scope,
                                 Success   => Local_OK);

                              if not Local_OK then
                                 Fail_Node (Node, Err_Mem_Out_Of_Bounds, Var_Name, Success, Diag);
                                 return;
                              end if;

                              Out_Tag := Type_None;
                              return;
                           end;
                        end if;

                        --  Find_Symbol (Hash_String (Target_Name), Current_Scope, Found, Sym);
                        --  if Found then
                        --     Fail_Node (Node, Err_Type_Conflict, Var_Name, Success, Diag);
                        --     return;
                        --  end if;
                        --  
                        --  Add_Global_Symbol
                        --    (Hash_String (Target_Name),
                        --     Final_Tag,
                        --     (Target => Target_Variable, Index => 0),
                        --     0,
                        --     0,
                        --     Success);
                        --  
                        --  if not Success then
                        --     return;
                        --  end if;
                        declare
                           Dummy_Tag : ALB_Type_Tag := Type_None;
                           Dummy_Sym : Symbol_Record;
                        begin
                           Dummy_Sym := Resolve_Symbol (Var_Name, Final_Tag, 0, True, Dummy_Tag);
                        end;

                        Transpiler_Native_HAL.Set_Global_Buffer_Mode (True);

                         if Final_Tag = Type_U8 or else Final_Tag = Type_Boolean then
                            Transpiler_Native_HAL.Emit_Raw ("  " & Target_Name & " db ", Success);
                         elsif Final_Tag = Type_U32 then
                            Transpiler_Native_HAL.Emit_Raw ("  " & Target_Name & " dd ", Success);
                         else
                            Transpiler_Native_HAL.Emit_Raw ("  " & Target_Name & " dw ", Success);
                         end if;

                         Transpiler_Native_HAL.Emit_Literal_U64 (Allocated_Elements, Success);
                         Transpiler_Native_HAL.Emit_Raw (" dup (0)", Success);
                         Transpiler_Native_HAL.Emit_Newline (Success);

                        Transpiler_Native_HAL.Set_Global_Buffer_Mode (False);

                        Register_Chrono_Global (Target_Name, False, Node, Success, Diag);
                        if not Success then
                           return;
                        end if;

                        Out_Tag := Type_None;
                        return;
                     end;
                  end if;

                  -- 4. Registration (Only if Target is a raw variable, NOT a struct field or array index!)
                  if Tree(Target_Node).Kind = AST_Var_Expr then
                     Find_Symbol(Hash_String(Target_Name), Current_Scope, Found, Sym);

                     if not Found and then Current_Scope /= 0 then
                        Find_Symbol (Hash_String (Target_Name), 0, Found, Sym);
                     end if;

                     if not Found and then Tree (Target_Node).Left_Child > 0 then
                        if Find_Strict_Array (Target_Name) > 0
                          or else Find_Slide_Array (Target_Name) > 0
                        then
                           Found := True;
                           Sym.Tag := Array_Declared_Tag (Target_Name, Final_Tag);
                           Sym.Class := Class_Global;
                        end if;
                     end if;
                     
                     if Found then
                        Target_Range := Find_Range_Var(Target_Name);
                     end if;

                     
                     if not Found then
                        -- DA FIX: Are we at the top level? Route tae the Global Vault!
                        if Current_Scope = 0 then
                           Add_Global_Symbol(Hash_String(Target_Name), Final_Tag, (Target => Target_Variable, Index => 0), 0, SID, Success);
                           if SID > 0 then
                              if Target = Backend_C then
                                 Transpiler_Native_HAL.Set_Global_Buffer_Mode(True);
                              end if;
                              Transpiler_Native_HAL.Emit_Struct_Var_Decl(Get_Struct_Name(SID), Target_Name, Success);
                              if Target = Backend_C then
                                 Transpiler_Native_HAL.Set_Global_Buffer_Mode(False);
                              end if;
                           else
                              if Target = Backend_FASM then Transpiler_Native_HAL.Set_Global_Buffer_Mode(True); end if;
                              Transpiler_Native_HAL.Emit_Global_Var_Decl(Target_Name, Final_Tag, Success);
                              if Target = Backend_FASM then Transpiler_Native_HAL.Set_Global_Buffer_Mode(False); end if;
                           end if;

                           Register_Chrono_Global(Target_Name, True, Node, Success, Diag);
                           if not Success then return; end if;
                           
                           if Explicit_Range > 0 and then Tree(Target_Node).Left_Child = 0 then
                              Register_Range_Var(Target_Name, Explicit_Range);
                              Target_Range := Explicit_Range;
                           end if;


                        --  else
                        --     -- We are inside a Procedure/Begin block. Route tae Local Memory!
                        --     Add_Local_Symbol(Hash_String(Target_Name), Final_Tag, (Target => Target_Variable, Index => 0), 0, SID, Current_Scope, Success);
                        --     if SID > 0 then
                        --        Transpiler_Native_HAL.Emit_Struct_Var_Decl(Get_Struct_Name(SID), Target_Name, Success);
                        --     else
                        --        Transpiler_Native_HAL.Emit_Var_Decl (Target_Name, Final_Tag, Success);
                        --     end if;
                        --  
                        --      if Explicit_Range > 0 and then Tree(Target_Node).Left_Child = 0 then
                        --         Register_Range_Var(Target_Name, Explicit_Range);
                        --         Target_Range := Explicit_Range;
                        --      end if;
                        --  
                        --  end if;
                        else
                           -- We are inside a Procedure/Begin block. Route tae Local Memory!
                            if Target = Backend_FASM16
                              and then SID > 0
                              and then Tree(Target_Node).Left_Child = 0
                            then
                               declare
                                  Struct_Bytes : constant Natural := Get_Struct_Size_Bytes (SID);
                                  Local_OK     : Boolean := False;
                               begin
                                  Local_Offset := Local_Offset + Integer (Struct_Bytes);

                                  Symbol_Table.Add_Local_Symbol
                                    (Token_Idx => Hash_String (Target_Name),
                                     Tag       => Final_Tag,
                                     Ref       => (Target => Target_Variable, Index => 0),
                                     Offset    => -Local_Offset,
                                     Struct_ID => SID,
                                     Scope     => Current_Scope,
                                     Success   => Local_OK);

                                  if not Local_OK then
                                     Fail_Node (Node, Err_Mem_Out_Of_Bounds, Var_Name, Success, Diag);
                                     return;
                                  end if;

                                  Find_Symbol (Hash_String (Target_Name), Current_Scope, Found, Sym);
                                  if not Found then
                                     Fail_Node (Node, Err_Type_Conflict, Var_Name, Success, Diag);
                                     return;
                                  end if;

                               end;

                            elsif Target = Backend_FASM16
                              and then SID = 0
                              and then Tree(Target_Node).Left_Child = 0
                            then
                              declare
                                 Local_Bytes : constant U64 :=
                                   U64 (FASM16_Storage_Bytes (Final_Tag));
                                   Local_OK : Boolean := False;
                              begin
                                 Local_Offset := Local_Offset + Integer (Local_Bytes);

                                 Symbol_Table.Add_Local_Symbol
                                   (Token_Idx => Hash_String (Target_Name),
                                    Tag       => Final_Tag,
                                    Ref       => (Target => Target_Variable, Index => 0),
                                    Offset    => -Local_Offset,
                                    Struct_ID => 0,
                                    Scope     => Current_Scope,
                                    Success   => Local_OK);

                                 if not Local_OK then
                                    Fail_Node (Node, Err_Mem_Out_Of_Bounds, Var_Name, Success, Diag);
                                    return;
                                 end if;

                                 Find_Symbol (Hash_String (Target_Name), Current_Scope, Found, Sym);
                                 if not Found then
                                    Fail_Node (Node, Err_Type_Conflict, Var_Name, Success, Diag);
                                    return;
                                 end if;

                              end;
                           else
                              Add_Local_Symbol(Hash_String(Target_Name), Final_Tag, (Target => Target_Variable, Index => 0), 0, SID, Current_Scope, Success);
                              if SID > 0 then
                                 Transpiler_Native_HAL.Emit_Struct_Var_Decl(Get_Struct_Name(SID), Target_Name, Success);
                              else
                                 Transpiler_Native_HAL.Emit_Var_Decl (Target_Name, Final_Tag, Success);
                              end if;
                           end if;

                           if Explicit_Range > 0 and then Tree(Target_Node).Left_Child = 0 then
                              Register_Range_Var(Target_Name, Explicit_Range);
                              Target_Range := Explicit_Range;
                           end if;
                        end if;

                     else
                        if Explicit_Tag /= Type_None
                          and then not Tags_Compatible (Sym.Tag, Final_Tag)
                          and then Sym.Tag /= Final_Tag
                          and then Final_Tag /= Type_U64
                          and then Sym.Tag /= Type_U64
                        then
                           declare
                              Detail : constant String :=
                                Var_Name &
                                " (new " & Type_Tag_Name (Final_Tag) &
                                ", existing " & Type_Tag_Name (Sym.Tag) & ")";
                           begin
                              Fail_Node (Node, Err_Symbol_Redeclared, Detail, Success, Diag);
                              return;
                           end;
                        end if;
                        
                        if Explicit_Range > 0 then
                           if Target_Range > 0 and then Target_Range /= Explicit_Range then
                              Fail_Node (Node, Err_Type_Conflict, Var_Name, Success, Diag);
                              return;
                           end if;

                           Register_Range_Var(Target_Name, Explicit_Range);
                           Target_Range := Explicit_Range;
                        end if;

                        -- Existing variables must store using their declared width.
                        Final_Tag := Sym.Tag;
                        Store_Tag := Sym.Tag;
                     end if;
                  end if;
                  
                  if Tree(Target_Node).Kind = AST_Var_Expr
                    and then Tree(Target_Node).Left_Child > 0
                  then
                     Target_Range := Find_Range_Array(Target_Name);
                  end if;

                  if Target = Backend_FASM16
                    and then RHS_Node > 0
                    and then Tree (Target_Node).Kind = AST_Var_Expr
                    and then Tree (Target_Node).Left_Child = 0
                  then
                     if Tree (RHS_Node).Kind in AST_AddressOf | AST_Ref_Expr then
                        Register_FASM16_Pointer_Meta
                          (Target_Name,
                           Current_Scope,
                           FASM16_LValue_Tag (Tree (RHS_Node).Left_Child));
                     elsif Tree (RHS_Node).Kind = AST_Temporal_Ref
                       and then Tree (RHS_Node).Left_Child > 0
                       and then Tree (RHS_Node).Token_Index > 0
                       and then Tokens (Tree (RHS_Node).Token_Index).Kind = Tok_Timeline
                     then
                        Register_FASM16_Pointer_Meta
                          (Target_Name,
                           Current_Scope,
                           FASM16_Normalize_Memory_Tag
                             (Infer_Type_Tag (Tree (RHS_Node).Left_Child)));
                     else
                        Register_FASM16_Pointer_Meta
                          (Target_Name,
                           Current_Scope,
                           Type_None);
                     end if;
                  end if;

                  -- 5. Code Emission
                  if RHS_Node > 0 and SID = 0 then
                     --  if Target = Backend_FASM16 then
                     --     -- FASM16 Tiny profile:
                     --     -- RHS leaves the value in AX. Store scalar cells only.
                     --     -- Arrays, structs, and wider native storage come later.
                     --     if Tree (Target_Node).Kind /= AST_Var_Expr
                     --       or else Tree (Target_Node).Left_Child > 0
                     --     then
                     --        Fail_Node (Node, Err_Type_Conflict, Var_Name, Success, Diag);
                     --        return;
                     --     end if;
                     --  
                     --     Walk_AST (RHS_Node, Depth + 1, Right_Tag, Success, Diag);
                     --     if not Success then
                     --        return;
                     --     end if;
                     --  
                     --     if Store_Tag = Type_U8 or else Store_Tag = Type_Boolean then
                     --        Transpiler_Native_HAL.Emit_Raw ("  mov byte [", Success);
                     --        Transpiler_Native_HAL.Emit_Raw (Target_Name, Success);
                     --        Transpiler_Native_HAL.Emit_Raw ("], al", Success);
                     --        Transpiler_Native_HAL.Emit_Newline (Success);
                     --     else
                     --        Transpiler_Native_HAL.Emit_Raw ("  mov word [", Success);
                     --        Transpiler_Native_HAL.Emit_Raw (Target_Name, Success);
                     --        Transpiler_Native_HAL.Emit_Raw ("], ax", Success);
                     --        Transpiler_Native_HAL.Emit_Newline (Success);
                     --     end if;
                     if Target = Backend_FASM16 then
                        if Tree (Target_Node).Kind /= AST_Var_Expr
                           and then Tree (Target_Node).Kind /= AST_Member_Expr
                         then
                           Fail_Node (Node, Err_Type_Conflict, Var_Name, Success, Diag);
                           return;
                        end if;

                        Walk_AST (RHS_Node, Depth + 1, Right_Tag, Success, Diag);
                        if not Success then
                           return;
                        end if;

                        if Right_Tag /= Store_Tag then
                           Emit_FASM16_Cast_DXAX (Right_Tag, Store_Tag);
                        end if;

                        -- [ START OF INSERTED PATCH ] --
                        if Tree (Target_Node).Kind = AST_Member_Expr then
                           declare
                              Var_Node     : Node_Index := Tree (Target_Node).Left_Child;
                              Field_Node   : Node_Index := Tree (Target_Node).Right_Child;
                              V_Tok        : Token := Tokens (Tree (Var_Node).Token_Index);
                              F_Tok        : Token := Tokens (Tree (Field_Node).Token_Index);
                              V_Lex        : String := Input_Buffer (V_Tok.Start .. V_Tok.Start + V_Tok.Length - 1);
                              F_Lex        : String := Input_Buffer (F_Tok.Start .. F_Tok.Start + F_Tok.Length - 1);
                              V_Target     : constant String := Scoped_Lexeme (V_Lex);
                              Backing_Target : constant String := V_Target & "_" & F_Lex;
                              Backing_Lex    : constant String := V_Lex & "_" & F_Lex;
                              Struct_Sym   : Symbol_Record;
                              Struct_Found : Boolean := False;
                              Backing_Sym  : Symbol_Record;
                              Target_Backing_Found : Boolean := False;
                              Plain_Backing_Found  : Boolean := False;
                              Backing_Found        : Boolean := False;
                              Field        : Struct_Field;
                              Field_Found  : Boolean := False;
                           begin
                              Find_Symbol (Hash_String (V_Target), Current_Scope, Struct_Found, Struct_Sym);

                              if not Struct_Found then
                                 Find_Symbol (Hash_String (V_Lex), Current_Scope, Struct_Found, Struct_Sym);
                              end if;

                              if Struct_Found and then Struct_Sym.Struct_ID > 0 then
                                 Find_Struct_Field
                                   (Struct_Sym.Struct_ID,
                                    Hash_String (F_Lex),
                                    Field_Found,
                                    Field);

                                 if not Field_Found then
                                    Fail_Node (Node, Err_Type_Conflict, F_Lex, Success, Diag);
                                    return;
                                 end if;

                                 if not FASM16_Scalar_Supported (Field.Tag) then
                                     Fail_Node (Node, Err_Type_Conflict, F_Lex, Success, Diag);
                                     return;
                                  end if;

                                  Emit_FASM16_Type_Store_Check_AX (Field.Tag);
                                  if not Success then
                                     return;
                                  end if;

                                  declare
                                      FImg : constant String := Natural'Image (Field.Offset);
                                      FOff : constant String := FImg (FImg'First + 1 .. FImg'Last);
                                   begin
                                      if Struct_Sym.Class = Class_Local and then Struct_Sym.Offset < 0 then
                                         declare
                                            BImg : constant String := Integer'Image (-Struct_Sym.Offset);
                                            BOff : constant String := BImg (BImg'First + 1 .. BImg'Last);
                                         begin
                                            Emit_FASM16_Store_DXAX_To_Cell
                                              ("bp-" & BOff & "+" & FOff,
                                               Field.Tag);
                                         end;

                                      elsif Struct_Sym.Class = Class_Local and then Struct_Sym.Offset > 0 then
                                         declare
                                            BImg : constant String := Integer'Image (Struct_Sym.Offset);
                                            BOff : constant String := BImg (BImg'First + 1 .. BImg'Last);
                                         begin
                                            Emit_FASM16_Store_DXAX_To_Cell
                                              ("bp+" & BOff & "+" & FOff,
                                               Field.Tag);
                                         end;

                                      else
                                         Emit_FASM16_Store_DXAX_To_Cell
                                           (V_Target & "+" & FOff,
                                            Field.Tag);
                                      end if;
                                   end;

                                 Out_Tag := Type_None;
                                 return;
                              end if;

                              Find_Symbol (Hash_String (Backing_Target), Current_Scope, Target_Backing_Found, Backing_Sym);
                              if not Target_Backing_Found then
                                 Find_Symbol (Hash_String (Backing_Lex), Current_Scope, Plain_Backing_Found, Backing_Sym);
                              end if;
                              Backing_Found := Target_Backing_Found or else Plain_Backing_Found;

                              declare
                                 Index_Node       : constant Node_Index := Tree (Var_Node).Left_Child;
                                 Target_Arr_Found : constant Boolean :=
                                   Find_Strict_Array (Backing_Target) > 0
                                     or else Find_Slide_Array (Backing_Target) > 0;
                                 Plain_Arr_Found  : constant Boolean :=
                                   Find_Strict_Array (Backing_Lex) > 0
                                     or else Find_Slide_Array (Backing_Lex) > 0;
                                 Use_Target_Name  : constant Boolean := Target_Arr_Found;
                                 Field_Tag        : constant ALB_Type_Tag :=
                                   (if Backing_Found then Backing_Sym.Tag else Type_U16);
                              begin
                                 if not Backing_Found and then not Target_Arr_Found and then not Plain_Arr_Found then
                                    Fail_Node (Node, Err_Type_Conflict, Backing_Lex, Success, Diag);
                                    return;
                                 end if;

                                 if not FASM16_Scalar_Supported (Field_Tag) then
                                    Fail_Node
                                      (Node,
                                       Err_Type_Conflict,
                                       "FASM16 PARALLEL field stores support U8, U16, U32, U64, S32, S64, HW8, HW16, HW32, PURE, or Boolean",
                                       Success,
                                       Diag);
                                    return;
                                 end if;

                                 if Index_Node > 0 and then (Target_Arr_Found or else Plain_Arr_Found) then
                                    if Field_Tag = Type_U32
                                      or else Field_Tag = Type_S32
                                      or else Field_Tag = Type_HW32
                                      or else Field_Tag = Type_Pure
                                    then
                                       Transpiler_Native_HAL.Emit_Raw ("  push dx", Success);
                                       Transpiler_Native_HAL.Emit_Newline (Success);
                                       Transpiler_Native_HAL.Emit_Raw ("  push ax", Success);
                                       Transpiler_Native_HAL.Emit_Newline (Success);
                                    else
                                       Transpiler_Native_HAL.Emit_Raw ("  push ax", Success);
                                       Transpiler_Native_HAL.Emit_Newline (Success);
                                    end if;

                                    if Use_Target_Name then
                                       Validate_Strict_Array_Literal_Indexes
                                         (Backing_Target,
                                          Index_Node,
                                          Target_Node,
                                          Success,
                                          Diag);
                                       if not Success then return; end if;

                                       Validate_Slide_Array_Literal_Indexes
                                         (Backing_Target,
                                          Index_Node,
                                          Target_Node,
                                          Success,
                                          Diag);
                                       if not Success then return; end if;

                                       Emit_FASM16_Array_Index_Offset_To_BX
                                         (Backing_Target,
                                          Index_Node,
                                          FASM16_Storage_Bytes (Field_Tag));
                                       if not Success then return; end if;
                                    else
                                       Validate_Strict_Array_Literal_Indexes
                                         (Backing_Lex,
                                          Index_Node,
                                          Target_Node,
                                          Success,
                                          Diag);
                                       if not Success then return; end if;

                                       Validate_Slide_Array_Literal_Indexes
                                         (Backing_Lex,
                                          Index_Node,
                                          Target_Node,
                                          Success,
                                          Diag);
                                       if not Success then return; end if;

                                       Emit_FASM16_Array_Index_Offset_To_BX
                                         (Backing_Lex,
                                          Index_Node,
                                          FASM16_Storage_Bytes (Field_Tag));
                                       if not Success then return; end if;
                                    end if;

                                    if Field_Tag = Type_U32
                                      or else Field_Tag = Type_S32
                                      or else Field_Tag = Type_HW32
                                      or else Field_Tag = Type_Pure
                                    then
                                       Transpiler_Native_HAL.Emit_Raw ("  pop ax", Success);
                                       Transpiler_Native_HAL.Emit_Newline (Success);
                                       Transpiler_Native_HAL.Emit_Raw ("  pop dx", Success);
                                       Transpiler_Native_HAL.Emit_Newline (Success);
                                    else
                                       Transpiler_Native_HAL.Emit_Raw ("  pop ax", Success);
                                       Transpiler_Native_HAL.Emit_Newline (Success);
                                    end if;

                                    if Backing_Found and then Backing_Sym.Class = Class_Local and then Backing_Sym.Offset < 0 then
                                       declare
                                          Img : constant String := Integer'Image (-Backing_Sym.Offset);
                                          Off : constant String := Img (Img'First + 1 .. Img'Last);
                                       begin
                                          Transpiler_Native_HAL.Emit_Raw ("  mov si, bx", Success);
                                          Transpiler_Native_HAL.Emit_Newline (Success);
                                          Emit_FASM16_Store_DXAX_To_Cell ("bp+si-" & Off, Field_Tag);
                                       end;
                                    else
                                       Emit_FASM16_Store_DXAX_To_Cell
                                         ((if Use_Target_Name then Backing_Target else Backing_Lex) & " + bx",
                                          Field_Tag);
                                    end if;
                                 else
                                    if Backing_Found then
                                       Emit_FASM16_Store_DXAX_To_Cell
                                         (FASM16_Cell_Name
                                            (Backing_Sym,
                                             (if Target_Backing_Found then Backing_Target else Backing_Lex)),
                                          Backing_Sym.Tag);
                                    else
                                       Emit_FASM16_Store_DXAX_To_Cell (Backing_Lex, Type_U16);
                                    end if;
                                 end if;
                              end;

                              Out_Tag := Type_None;
                              return;
                           end;
                        end if;
                        -- [ END OF INSERTED PATCH ] --
                        
                        Emit_FASM16_Type_Store_Check_AX (Store_Tag);
                        if not Success then
                           return;
                        end if;

                        if Tree (Target_Node).Left_Child > 0 then
                           Validate_Strict_Array_Literal_Indexes
                             (Target_Name,
                              Tree (Target_Node).Left_Child,
                              Target_Node,
                              Success,
                              Diag);

                           if not Success then
                              return;
                           end if;
                           
                           Validate_Slide_Array_Literal_Indexes
                             (Target_Name,
                              Tree (Target_Node).Left_Child,
                              Target_Node,
                              Success,
                              Diag);

                           if not Success then
                              return;
                           end if;

                           --  if Store_Tag /= Type_U8
                           --    and then Store_Tag /= Type_U16
                           --    and then Store_Tag /= Type_Boolean
                           --  then
                            if not FASM16_Scalar_Supported (Store_Tag) then
                               Fail_Node (Node, Err_Type_Conflict, Var_Name, Success, Diag);
                               return;
                            end if;

                            if Store_Tag = Type_U32
                              or else Store_Tag = Type_S32
                              or else Store_Tag = Type_HW32
                              or else Store_Tag = Type_Pure
                            then
                               Transpiler_Native_HAL.Emit_Raw ("  push dx", Success);
                               Transpiler_Native_HAL.Emit_Newline (Success);
                               Transpiler_Native_HAL.Emit_Raw ("  push ax", Success);
                               Transpiler_Native_HAL.Emit_Newline (Success);
                            else
                               Transpiler_Native_HAL.Emit_Raw ("  push ax", Success);
                               Transpiler_Native_HAL.Emit_Newline (Success);
                            end if;

                            declare
                               Elem_Bytes : constant Natural := FASM16_Storage_Bytes (Store_Tag);
                            begin
                               Emit_FASM16_Array_Index_Offset_To_BX
                                 (Target_Name,
                                  Tree (Target_Node).Left_Child,
                                  Elem_Bytes);

                               if not Success then
                                  return;
                               end if;
                            end;

                            if Store_Tag = Type_U32
                              or else Store_Tag = Type_S32
                              or else Store_Tag = Type_HW32
                              or else Store_Tag = Type_Pure
                            then
                               Transpiler_Native_HAL.Emit_Raw ("  pop ax", Success);
                               Transpiler_Native_HAL.Emit_Newline (Success);
                               Transpiler_Native_HAL.Emit_Raw ("  pop dx", Success);
                               Transpiler_Native_HAL.Emit_Newline (Success);
                            else
                               Transpiler_Native_HAL.Emit_Raw ("  pop ax", Success);
                               Transpiler_Native_HAL.Emit_Newline (Success);
                            end if;

                            if Sym.Class = Class_Local and then Sym.Offset < 0 then
                               declare
                                  Img : constant String := Integer'Image (-Sym.Offset);
                                  Off : constant String := Img (Img'First + 1 .. Img'Last);
                               begin
                                  Transpiler_Native_HAL.Emit_Raw ("  mov si, bx", Success);
                                  Transpiler_Native_HAL.Emit_Newline (Success);
                                  Emit_FASM16_Store_DXAX_To_Cell
                                    ("bp+si-" & Off,
                                     Store_Tag);
                               end;
                            else
                               Emit_FASM16_Store_DXAX_To_Cell
                                 (Target_Name & " + bx",
                                  Store_Tag);
                            end if;
                           
                           
                        elsif Sym.Class = Class_Local and then Sym.Offset < 0 then
                           declare
                              Img : constant String := Integer'Image (-Sym.Offset);
                              Off : constant String := Img (Img'First + 1 .. Img'Last);
                           begin
                              Emit_FASM16_Store_DXAX_To_Cell ("bp-" & Off, Store_Tag);
                           end;

                        elsif Sym.Class = Class_Local and then Sym.Offset > 0 then
                           declare
                              Img : constant String := Integer'Image (Sym.Offset);
                              Off : constant String := Img (Img'First + 1 .. Img'Last);
                           begin
                              Emit_FASM16_Store_DXAX_To_Cell ("bp+" & Off, Store_Tag);
                           end;

                        else
                           Emit_FASM16_Store_DXAX_To_Cell (Target_Name, Store_Tag);
                        end if;


                     elsif Target = Backend_FASM then
                        if Target_Range > 0
                          and then Tree(Target_Node).Kind = AST_Var_Expr
                        then
                            Validate_Static_Range_Expr(RHS_Node, Target_Range, Node, Success, Diag);
                            if not Success or else not Diag.Success then return; end if;
                        end if;

                         -- 1. Walk RHS so the final result ends up in RAX
                         Walk_AST (RHS_Node, Depth + 1, Right_Tag, Success, Diag);
                        if not Success then return; end if;
                        
                         if Target_Range > 0
                           and then Tree(Target_Node).Kind = AST_Var_Expr
                         then
                            Emit_FASM_Range_Check_RAX(Target_Range);
                            if not Success then return; end if;
                        end if;
                        
                        
                         if Tree (Target_Node).Kind = AST_Member_Expr then
                            declare
                               Var_Node     : Node_Index := Tree (Target_Node).Left_Child;
                               Field_Node   : Node_Index := Tree (Target_Node).Right_Child;
                               V_Tok        : Token := Tokens (Tree (Var_Node).Token_Index);
                               F_Tok        : Token := Tokens (Tree (Field_Node).Token_Index);
                               V_Lex        : String := Input_Buffer (V_Tok.Start .. V_Tok.Start + V_Tok.Length - 1);
                               F_Lex        : String := Input_Buffer (F_Tok.Start .. F_Tok.Start + F_Tok.Length - 1);
                               V_Target     : constant String := Scoped_Lexeme (V_Lex);
                               Backing_Target : constant String := V_Target & "_" & F_Lex;
                               Backing_Lex    : constant String := V_Lex & "_" & F_Lex;
                               Struct_Sym   : Symbol_Record;
                               Struct_Found : Boolean := False;
                               Backing_Sym  : Symbol_Record;
                               Target_Backing_Found : Boolean := False;
                               Plain_Backing_Found  : Boolean := False;
                               Backing_Found        : Boolean := False;
                               Field        : Struct_Field;
                               Field_Found  : Boolean := False;
                            begin
                               Find_Symbol (Hash_String (V_Target), Current_Scope, Struct_Found, Struct_Sym);

                               if not Struct_Found then
                                  Find_Symbol (Hash_String (V_Lex), Current_Scope, Struct_Found, Struct_Sym);
                               end if;

                               if Struct_Found and then Struct_Sym.Struct_ID > 0 then
                                  Find_Struct_Field
                                    (Struct_Sym.Struct_ID,
                                     Hash_String (F_Lex),
                                     Field_Found,
                                     Field);

                                  if not Field_Found then
                                     Fail_Node (Node, Err_Type_Conflict, F_Lex, Success, Diag);
                                     return;
                                  end if;

                                  declare
                                       FImg : constant String := Natural'Image (Field.Offset);
                                       FOff : constant String := FImg (FImg'First + 1 .. FImg'Last);
                                    begin
                                       if Struct_Sym.Class = Class_Local and then Struct_Sym.Offset < 0 then
                                          declare
                                             BImg : constant String := Integer'Image (-Struct_Sym.Offset);
                                             BOff : constant String := BImg (BImg'First + 1 .. BImg'Last);
                                          begin
                                             Emit_FASM_Store_RAX_To_Scalar
                                               ("rbp-" & BOff & "+" & FOff,
                                                Field.Tag,
                                                Success);
                                          end;

                                       elsif Struct_Sym.Class = Class_Local and then Struct_Sym.Offset > 0 then
                                          declare
                                             BImg : constant String := Integer'Image (Struct_Sym.Offset);
                                             BOff : constant String := BImg (BImg'First + 1 .. BImg'Last);
                                          begin
                                             Emit_FASM_Store_RAX_To_Scalar
                                               ("rbp+" & BOff & "+" & FOff,
                                                Field.Tag,
                                                Success);
                                          end;

                                       else
                                          Emit_FASM_Store_RAX_To_Scalar
                                            (V_Target & "+" & FOff,
                                             Field.Tag,
                                             Success);
                                       end if;
                                    end;

                                  Out_Tag := Type_None;
                                  return;
                               end if;

                               if Target /= Backend_FASM
                                 and then Target /= Backend_FASM16
                               then
                                  Fail_Node (Node, Err_Type_Conflict, V_Lex, Success, Diag);
                                  return;
                               end if;

                               Find_Symbol (Hash_String (Backing_Target), Current_Scope, Target_Backing_Found, Backing_Sym);
                               if not Target_Backing_Found then
                                  Find_Symbol (Hash_String (Backing_Lex), Current_Scope, Plain_Backing_Found, Backing_Sym);
                               end if;
                               Backing_Found := Target_Backing_Found or else Plain_Backing_Found;

                               declare
                                  Index_Node       : constant Node_Index := Tree (Var_Node).Left_Child;
                                  Target_Arr_Found : constant Boolean :=
                                    Find_Strict_Array (Backing_Target) > 0
                                      or else Find_Slide_Array (Backing_Target) > 0;
                                  Plain_Arr_Found  : constant Boolean :=
                                    Find_Strict_Array (Backing_Lex) > 0
                                      or else Find_Slide_Array (Backing_Lex) > 0;
                                  Use_Target_Name  : constant Boolean := Target_Arr_Found;
                                  Field_Tag        : constant ALB_Type_Tag :=
                                    (if Backing_Found
                                     then Backing_Sym.Tag
                                     elsif Target = Backend_FASM16
                                     then Type_U16
                                     else Type_U64);
                               begin
                                  if not Backing_Found and then not Target_Arr_Found and then not Plain_Arr_Found then
                                     Fail_Node (Node, Err_Type_Conflict, Backing_Lex, Success, Diag);
                                     return;
                                  end if;

                                  if Target = Backend_FASM then
                                     if Index_Node > 0 and then (Target_Arr_Found or else Plain_Arr_Found) then
                                        -- Parallel arrays lower to regular STRICT/SLIDE backing arrays.
                                        -- Reuse the ordinary FASM array path with the synthesized field name.
                                        Transpiler_Native_HAL.Emit_Raw ("  push rax", Success);
                                        Transpiler_Native_HAL.Emit_Newline (Success);
                                        Transpiler_Native_HAL.Emit_Raw ("  sub rsp, 8", Success);
                                        Transpiler_Native_HAL.Emit_Newline (Success);

                                        if Use_Target_Name then
                                           Validate_Strict_Array_Literal_Indexes
                                             (Backing_Target,
                                              Index_Node,
                                              Target_Node,
                                              Success,
                                              Diag);
                                           if not Success then return; end if;

                                           Validate_Slide_Array_Literal_Indexes
                                             (Backing_Target,
                                              Index_Node,
                                              Target_Node,
                                              Success,
                                              Diag);
                                           if not Success then return; end if;

                                           Emit_FASM_Array_Index_Offset_To_RAX
                                             (Backing_Target,
                                              Index_Node);
                                           if not Success then return; end if;

                                           Transpiler_Native_HAL.Emit_Raw ("  lea rbx, [", Success);
                                           Transpiler_Native_HAL.Emit_Raw (Backing_Target, Success);
                                           Transpiler_Native_HAL.Emit_Raw ("]", Success);
                                           Transpiler_Native_HAL.Emit_Newline (Success);
                                        else
                                           Validate_Strict_Array_Literal_Indexes
                                             (Backing_Lex,
                                              Index_Node,
                                              Target_Node,
                                              Success,
                                              Diag);
                                           if not Success then return; end if;

                                           Validate_Slide_Array_Literal_Indexes
                                             (Backing_Lex,
                                              Index_Node,
                                              Target_Node,
                                              Success,
                                              Diag);
                                           if not Success then return; end if;

                                           Emit_FASM_Array_Index_Offset_To_RAX
                                             (Backing_Lex,
                                              Index_Node);
                                           if not Success then return; end if;

                                           Transpiler_Native_HAL.Emit_Raw ("  lea rbx, [", Success);
                                           Transpiler_Native_HAL.Emit_Raw (Backing_Lex, Success);
                                           Transpiler_Native_HAL.Emit_Raw ("]", Success);
                                           Transpiler_Native_HAL.Emit_Newline (Success);
                                        end if;

                                        Transpiler_Native_HAL.Emit_Raw ("  add rbx, rax", Success);
                                        Transpiler_Native_HAL.Emit_Newline (Success);
                                        Transpiler_Native_HAL.Emit_Raw ("  add rsp, 8", Success);
                                        Transpiler_Native_HAL.Emit_Newline (Success);
                                        Transpiler_Native_HAL.Emit_Raw ("  pop rax", Success);
                                        Transpiler_Native_HAL.Emit_Newline (Success);
                                        Emit_FASM_Store_RAX_To_Scalar
                                          ("rbx",
                                           (if Backing_Found then Backing_Sym.Tag else Type_U64),
                                           Success);
                                     else
                                        if Backing_Found then
                                           if Use_Target_Name then
                                              Emit_FASM_Store_RAX_To_Scalar
                                                (Backing_Target,
                                                 Backing_Sym.Tag,
                                                 Success);
                                           else
                                              Emit_FASM_Store_RAX_To_Scalar
                                                (Backing_Lex,
                                                 Backing_Sym.Tag,
                                                 Success);
                                           end if;
                                        else
                                           Emit_FASM_Store_RAX_To_Scalar
                                             (Backing_Lex,
                                              Type_U64,
                                              Success);
                                        end if;
                                     end if;
                                  else
                                     if not FASM16_Scalar_Supported (Field_Tag) then
                                        Fail_Node
                                          (Node,
                                           Err_Type_Conflict,
                                           "FASM16 PARALLEL field stores support U8, U16, U32, U64, S32, S64, HW8, HW16, HW32, PURE, or Boolean",
                                           Success,
                                           Diag);
                                        return;
                                     end if;

                                     if Index_Node > 0 and then (Target_Arr_Found or else Plain_Arr_Found) then
                                        if Field_Tag = Type_U32
                                          or else Field_Tag = Type_S32
                                          or else Field_Tag = Type_HW32
                                          or else Field_Tag = Type_Pure
                                        then
                                           Transpiler_Native_HAL.Emit_Raw ("  push dx", Success);
                                           Transpiler_Native_HAL.Emit_Newline (Success);
                                           Transpiler_Native_HAL.Emit_Raw ("  push ax", Success);
                                           Transpiler_Native_HAL.Emit_Newline (Success);
                                        else
                                           Transpiler_Native_HAL.Emit_Raw ("  push ax", Success);
                                           Transpiler_Native_HAL.Emit_Newline (Success);
                                        end if;

                                        if Use_Target_Name then
                                           Validate_Strict_Array_Literal_Indexes
                                             (Backing_Target,
                                              Index_Node,
                                              Target_Node,
                                              Success,
                                              Diag);
                                           if not Success then return; end if;

                                           Validate_Slide_Array_Literal_Indexes
                                             (Backing_Target,
                                              Index_Node,
                                              Target_Node,
                                              Success,
                                              Diag);
                                           if not Success then return; end if;

                                           Emit_FASM16_Array_Index_Offset_To_BX
                                             (Backing_Target,
                                              Index_Node,
                                              FASM16_Storage_Bytes (Field_Tag));
                                           if not Success then return; end if;
                                        else
                                           Validate_Strict_Array_Literal_Indexes
                                             (Backing_Lex,
                                              Index_Node,
                                              Target_Node,
                                              Success,
                                              Diag);
                                           if not Success then return; end if;

                                           Validate_Slide_Array_Literal_Indexes
                                             (Backing_Lex,
                                              Index_Node,
                                              Target_Node,
                                              Success,
                                              Diag);
                                           if not Success then return; end if;

                                           Emit_FASM16_Array_Index_Offset_To_BX
                                             (Backing_Lex,
                                              Index_Node,
                                              FASM16_Storage_Bytes (Field_Tag));
                                           if not Success then return; end if;
                                        end if;

                                        if Field_Tag = Type_U32
                                          or else Field_Tag = Type_S32
                                          or else Field_Tag = Type_HW32
                                          or else Field_Tag = Type_Pure
                                        then
                                           Transpiler_Native_HAL.Emit_Raw ("  pop ax", Success);
                                           Transpiler_Native_HAL.Emit_Newline (Success);
                                           Transpiler_Native_HAL.Emit_Raw ("  pop dx", Success);
                                           Transpiler_Native_HAL.Emit_Newline (Success);
                                        else
                                           Transpiler_Native_HAL.Emit_Raw ("  pop ax", Success);
                                           Transpiler_Native_HAL.Emit_Newline (Success);
                                        end if;

                                        if Backing_Found and then Backing_Sym.Class = Class_Local and then Backing_Sym.Offset < 0 then
                                           declare
                                              Img : constant String := Integer'Image (-Backing_Sym.Offset);
                                              Off : constant String := Img (Img'First + 1 .. Img'Last);
                                           begin
                                              Transpiler_Native_HAL.Emit_Raw ("  mov si, bx", Success);
                                              Transpiler_Native_HAL.Emit_Newline (Success);
                                              Emit_FASM16_Store_DXAX_To_Cell ("bp+si-" & Off, Field_Tag);
                                           end;
                                        else
                                           Emit_FASM16_Store_DXAX_To_Cell
                                             ((if Use_Target_Name then Backing_Target else Backing_Lex) & " + bx",
                                              Field_Tag);
                                        end if;
                                     else
                                        if Backing_Found then
                                           Emit_FASM16_Store_DXAX_To_Cell
                                             (FASM16_Cell_Name
                                                (Backing_Sym,
                                                 (if Target_Backing_Found then Backing_Target else Backing_Lex)),
                                              Backing_Sym.Tag);
                                        else
                                           Emit_FASM16_Store_DXAX_To_Cell (Backing_Lex, Type_U16);
                                        end if;
                                     end if;
                                  end if;
                               end;

                               Out_Tag := Type_None;
                               return;
                            end;
                         end if;
                        
                        
                        -- 2. Store RAX directly intae the variable using correct width!
                        if Tree(Target_Node).Kind = AST_Var_Expr then
                           if Tree(Target_Node).Left_Child > 0 then
                              -- DA FASM ARRAY ASSIGNMENT FORGE!
                              -- Push RAX and an extra 8 bytes to maintain strict 16-byte Win64 ABI alignment!
                              Transpiler_Native_HAL.Emit_Raw ("  push rax", Success); Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  sub rsp, 8", Success); Transpiler_Native_HAL.Emit_Newline (Success);
                              
                              
                              Validate_Strict_Array_Literal_Indexes
                                (Target_Name,
                                 Tree(Target_Node).Left_Child,
                                 Target_Node,
                                 Success,
                                 Diag);

                              if not Success then
                                 return;
                              end if;
                              
                              
                              Validate_Slide_Array_Literal_Indexes
                                (Target_Name,
                                 Tree(Target_Node).Left_Child,
                                 Target_Node,
                                 Success,
                                 Diag);

                              if not Success then
                                 return;
                              end if;
                              
                              
                              -- Walk all array indexes and flatten them to a byte offset in RAX.
                              Emit_FASM_Array_Index_Offset_To_RAX
                                (Target_Name,
                                 Tree (Target_Node).Left_Child);

                              if not Success then
                                 return;
                              end if;

                              Transpiler_Native_HAL.Emit_Raw ("  lea rbx, [", Success);
                              Transpiler_Native_HAL.Emit_Raw (Target_Name, Success);
                              Transpiler_Native_HAL.Emit_Raw ("]", Success); Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  add rbx, rax", Success); Transpiler_Native_HAL.Emit_Newline (Success);

                              
                              -- Clean up the 8-byte pad, then pop the original value!
                              Transpiler_Native_HAL.Emit_Raw ("  add rsp, 8", Success); Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  pop rax", Success); Transpiler_Native_HAL.Emit_Newline (Success);
                              Emit_FASM_Store_RAX_To_Scalar ("rbx", Store_Tag, Success);
                           else
                              -- Standard Variable Assignment using correct Width!
                              Emit_FASM_Store_RAX_To_Scalar (Target_Name, Store_Tag, Success);
                              if not Success then return; end if;
                           end if;
                        else
                            -- DA FIX: COMPLEX STRUCT ASSIGNMENT FORGE!
                            if Tree(Target_Node).Kind = AST_Member_Expr then
                               declare
                                  Var_Node   : Node_Index := Tree(Target_Node).Left_Child;
                                  Field_Node : Node_Index := Tree(Target_Node).Right_Child;
                                  V_Tok      : Token := Tokens(Tree(Var_Node).Token_Index);
                                  V_Lex      : String := Input_Buffer(V_Tok.Start .. V_Tok.Start + V_Tok.Length - 1);
                                  V_Target   : constant String := Scoped_Lexeme (V_Lex);
                                  F_Tok      : Token := Tokens(Tree(Field_Node).Token_Index);
                                  F_Lex      : String := Input_Buffer(F_Tok.Start .. F_Tok.Start + F_Tok.Length - 1);
                                  Sym_Search : Symbol_Record;
                                  Was_Found  : Boolean;
                               begin
                                  Find_Symbol(Hash_String(V_Target), Current_Scope, Was_Found, Sym_Search);
                                  if Was_Found and then Sym_Search.Struct_ID > 0 then
                                     declare
                                        S_Name : String := Get_Struct_Name(Sym_Search.Struct_ID);
                                        Field_Rec : Struct_Field;
                                        F_Found : Boolean;
                                     begin
                                        Find_Struct_Field(Sym_Search.Struct_ID, Hash_String(F_Lex), F_Found, Field_Rec);
                                        if F_Found then
                                           Emit_FASM_Store_RAX_To_Scalar (V_Target & " + " & S_Name & "." & F_Lex, Field_Rec.Tag, Success);
                                        else
                                           Transpiler_Native_HAL.Emit_Raw ("  ; COMPLEX ASSIGN FAIL: FIELD UNKNOWN", Success);
                                           Transpiler_Native_HAL.Emit_Newline (Success);
                                        end if;
                                     end;
                                  else
                                     Transpiler_Native_HAL.Emit_Raw ("  ; COMPLEX ASSIGN FAIL: STRUCT UNKNOWN", Success);
                                     Transpiler_Native_HAL.Emit_Newline (Success);
                                  end if;
                               end;
                            else
                               Transpiler_Native_HAL.Emit_Raw ("  ; FASM COMPLEX ASSIGN NOT FULLY IMPL", Success);
                               Transpiler_Native_HAL.Emit_Newline (Success);
                            end if;
                         end if;
                     else
                        Transpiler_Native_HAL.Emit_Assign_Prefix (Success);
                        Walk_AST (Target_Node, Depth + 1, Left_Tag, Success, Diag);
                        Transpiler_Native_HAL.Emit_Let_Assign_Start ("", Success);
                        Walk_AST (RHS_Node, Depth + 1, Final_Tag, Success, Diag);
                        Transpiler_Native_HAL.Emit_Statement_End (Success);
                     end if;
                  end if;

                  -- Task B3: pop the numeric-LHS context bumped above.
                  if B3_Numeric_LHS and then Numeric_Assign_Depth > 0 then
                     Numeric_Assign_Depth := Numeric_Assign_Depth - 1;
                  end if;
               end;
           
            
               
            when AST_Input_Stmt =>
               declare
                  Prompt_Node   : Node_Index := Tree (Node).Left_Child;
                  Var_Node      : Node_Index := Tree (Node).Right_Child;
                  V_Tag         : ALB_Type_Tag := Type_U64;

                  Target_Lex    : String (1 .. 128) := (others => ' ');
                  Target_Len    : Natural := 0;
                  Target_Range  : Natural := 0;
                  Target_Sym    : Symbol_Record;
                  Target_Found  : Boolean := False;
               begin
                  declare
                     Tok   : Token := Tokens (Tree (Var_Node).Token_Index);
                     Lex   : String := Input_Buffer (Tok.Start .. Tok.Start + Tok.Length - 1);
                     Sym   : Symbol_Record;
                     H     : U32 := 5381;
                     Found : Boolean := False;
                  begin
                     if Active_Module_Len > 0 then
                        Target_Lex (1 .. Active_Module_Len) := Active_Module_Name (1 .. Active_Module_Len);
                        Target_Lex (Active_Module_Len + 1) := '_';
                        Target_Lex (Active_Module_Len + 2 .. Active_Module_Len + 1 + Lex'Length) := Lex;
                        Target_Len := Active_Module_Len + 1 + Lex'Length;
                     else
                        Target_Lex (1 .. Lex'Length) := Lex;
                        Target_Len := Lex'Length;
                     end if;

                     for I in 1 .. Target_Len loop
                        H := (H * 33) + U32 (Character'Pos (Target_Lex (I)));
                     end loop;

                     Find_Symbol (H, Current_Scope, Found, Sym);
                      Target_Found := Found;
                      if Found then
                         Target_Sym := Sym;
                         V_Tag := Sym.Tag;
                      end if;

                     Target_Range := Find_Range_Var(Target_Lex(1 .. Target_Len));
                  end;

                  if Prompt_Node > 0 then
                     if Target = Backend_FASM then
                        Walk_AST (Prompt_Node, Depth + 1, Left_Tag, Success, Diag);
                        Transpiler_Native_HAL.Emit_Raw ("  mov rbx, rax", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                     elsif Target = Backend_FASM16 then
                         Walk_AST (Prompt_Node, Depth + 1, Left_Tag, Success, Diag);
                         Transpiler_Native_HAL.Emit_Raw ("  call ALB16_Print_C_Str", Success);
                         Transpiler_Native_HAL.Emit_Newline (Success);
                     else
                        Transpiler_Native_HAL.Emit_Input_Prompt_Start (Success);
                        Walk_AST (Prompt_Node, Depth + 1, Left_Tag, Success, Diag);
                        Transpiler_Native_HAL.Emit_Input_Prompt_End (Success);
                     end if;
                  elsif Target = Backend_FASM then
                     Transpiler_Native_HAL.Emit_Raw ("  xor rbx, rbx", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                  end if;

                  if Target = Backend_FASM then
                     if V_Tag = Type_Binary then
                        declare
                           Idx_Str   : String := Natural'Image (Node);
                           Clean_Idx : String (1 .. Idx_Str'Length - 1) :=
                             Idx_Str (2 .. Idx_Str'Length);
                           Skip_Lbl  : constant String :=
                             ".alb_input_skip_prompt_" & Clean_Idx;
                        begin
                           Transpiler_Native_HAL.Emit_Raw ("  test rbx, rbx", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Transpiler_Native_HAL.Emit_Raw ("  jz " & Skip_Lbl, Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Transpiler_Native_HAL.Emit_Raw ("  sub rsp, 40", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Transpiler_Native_HAL.Emit_Raw ("  mov rdx, rbx", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Transpiler_Native_HAL.Emit_Raw
                             ("  invoke printf, ALB_Prompt_Str, rdx", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Transpiler_Native_HAL.Emit_Raw ("  add rsp, 40", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Transpiler_Native_HAL.Emit_Raw (Skip_Lbl & ":", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Transpiler_Native_HAL.Emit_Raw
                             ("  call ALB_Input_Read_Line", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Transpiler_Native_HAL.Emit_Raw
                             ("  lea rax, [ALB_Input_Buffer]", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                        end;

                        if Target_Range > 0 then
                           Emit_FASM_Range_Check_RAX(Target_Range);
                           if not Success then return; end if;
                        end if;

                        Transpiler_Native_HAL.Emit_Raw ("  mov qword [", Success);
                        Transpiler_Native_HAL.Emit_Raw (Target_Lex (1 .. Target_Len), Success);
                        Transpiler_Native_HAL.Emit_Raw ("], rax", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                     else
                        if Target_Range > 0 then
                           Transpiler_Native_HAL.Emit_Raw ("  mov rcx, rbx", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Transpiler_Native_HAL.Emit_Raw ("  mov rdx, ", Success);
                           Transpiler_Native_HAL.Emit_Literal_U64
                             (Range_Types (Target_Range).Low_Value, Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Transpiler_Native_HAL.Emit_Raw ("  mov r8, ", Success);
                           Transpiler_Native_HAL.Emit_Literal_U64
                             (Range_Types (Target_Range).High_Value, Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Transpiler_Native_HAL.Emit_Raw ("  mov r9, ", Success);
                           Transpiler_Native_HAL.Emit_Literal_U64
                             (Range_Types (Target_Range).Low_Value, Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Transpiler_Native_HAL.Emit_Raw
                             ("  call ALB_Input_Read_Integer_In_Range", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                        else
                           Transpiler_Native_HAL.Emit_Raw ("  mov rcx, rbx", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Transpiler_Native_HAL.Emit_Raw ("  xor rdx, rdx", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Transpiler_Native_HAL.Emit_Raw
                             ("  call ALB_Input_Read_Integer", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                        end if;

                        case V_Tag is
                           when Type_U8 | Type_Boolean =>
                              Transpiler_Native_HAL.Emit_Raw ("  mov byte [", Success);
                              Transpiler_Native_HAL.Emit_Raw (Target_Lex (1 .. Target_Len), Success);
                              Transpiler_Native_HAL.Emit_Raw ("], al", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);

                           when Type_U16 =>
                              Transpiler_Native_HAL.Emit_Raw ("  mov word [", Success);
                              Transpiler_Native_HAL.Emit_Raw (Target_Lex (1 .. Target_Len), Success);
                              Transpiler_Native_HAL.Emit_Raw ("], ax", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);

                           when Type_U32 | Type_S32 =>
                              Transpiler_Native_HAL.Emit_Raw ("  mov dword [", Success);
                              Transpiler_Native_HAL.Emit_Raw (Target_Lex (1 .. Target_Len), Success);
                              Transpiler_Native_HAL.Emit_Raw ("], eax", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);

                           when others =>
                              Transpiler_Native_HAL.Emit_Raw ("  mov qword [", Success);
                              Transpiler_Native_HAL.Emit_Raw (Target_Lex (1 .. Target_Len), Success);
                              Transpiler_Native_HAL.Emit_Raw ("], rax", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                        end case;
                     end if;
                     
                  elsif Target = Backend_FASM16 then
                      if not Target_Found then
                         Fail_Node
                           (Node,
                            Err_Type_Conflict,
                            "FASM16 INPUT target must be declared",
                            Success,
                            Diag);
                         return;
                      end if;

                      declare
                         Cell : constant String :=
                           FASM16_Cell_Name
                             (Target_Sym, Target_Lex (1 .. Target_Len));
                      begin
                         case V_Tag is
                            when Type_U8 | Type_HW8 | Type_Boolean
                               | Type_U16 | Type_HW16
                               | Type_U32 | Type_HW32 =>
                               Transpiler_Native_HAL.Emit_Raw
                                 ("  call ALB16_Input_Read_U32", Success);

                            when Type_S32 =>
                               Transpiler_Native_HAL.Emit_Raw
                                 ("  call ALB16_Input_Read_S32", Success);

                            when Type_Binary =>
                               Transpiler_Native_HAL.Emit_Raw
                                 ("  call ALB16_Readline_Read", Success);

                            when others =>
                               Fail_Node
                                 (Node,
                                  Err_Type_Conflict,
                                  "FASM16 INPUT supports integer and STRING/BINARY scalar targets only",
                                  Success,
                                  Diag);
                               return;
                         end case;

                         Transpiler_Native_HAL.Emit_Newline (Success);

                         if Target_Range > 0 then
                            Emit_FASM16_Range_Check_AX (Target_Range);
                            if not Success then
                               return;
                            end if;
                         end if;

                         Emit_FASM16_Type_Store_Check_AX (V_Tag);
                         Emit_FASM16_Store_DXAX_To_Cell (Cell, V_Tag);
                      end;
                  else
                     Transpiler_Native_HAL.Emit_Input_Read_Start (V_Tag, Success);
                     Walk_AST (Var_Node, Depth + 1, Right_Tag, Success, Diag);
                     Transpiler_Native_HAL.Emit_Input_Read_End (V_Tag, Success);
                  end if;

                  Out_Tag := Type_None;
               end;
            
            when AST_Procedure_Decl | AST_Function_Decl =>
               declare
                  Var_Node : Node_Index := Tree (Node).Left_Child;
               begin
                  if Var_Node /= 0 then
                     declare
                        Tok          : Token := Tokens (Tree (Var_Node).Token_Index);
                        Lexeme       : String := Input_Buffer (Tok.Start .. Tok.Start + Tok.Length - 1);
                        Target_Lex   : String (1 .. 128) := (others => ' ');
                        Target_Len   : Natural := 0;
                        C_Node       : Node_Index := 0;
                        Dummy_Tag          : ALB_Type_Tag;
                        Saved_Return_Range            : Natural := Current_Function_Return_Range;
                        Saved_FASM_Select_Stack_Bytes : Natural := Current_FASM_Select_Stack_Bytes;
                        Saved_Local_Offset            : Integer := Local_Offset;
                        Saved_Firewall                : Natural := Current_Firewall;
                     begin
                        declare
                           Safe_Target : constant String := Scoped_Lexeme (Lexeme);
                        begin
                           Target_Lex (1 .. Safe_Target'Length) := Safe_Target;
                           Target_Len := Safe_Target'Length;
                        end;

                        if Prune_Dead_Mode
                          and then Target_Len > 0
                          and then not Is_Prune_Reachable (Target_Lex (1 .. Target_Len))
                        then
                           Out_Tag := Type_None;
                           return;
                        end if;

                        Current_Scope := Current_Scope + 1;
                        Current_Function_Return_Range := 0;
                        Current_FASM_Select_Stack_Bytes := 0;
                        Local_Offset := 0;
                        Current_Firewall := 0;

                        if Tree(Node).Kind = AST_Function_Decl
                          and then Tree(Node).Token_Index > 0
                        then
                           Current_Function_Return_Range :=
                             Find_Range_Type(Raw_Lexeme(Tree(Node).Token_Index));
                        end if;

                        if Tree (Var_Node).Right_Child /= 0 then
                           C_Node := Tree (Tree (Var_Node).Right_Child).Next_Sibling;
                        end if;

                        while C_Node /= 0 loop
                           if Tree (C_Node).Kind = AST_Bound_To_Clause
                             and then Tree (C_Node).Left_Child > 0
                           then
                              declare
                                 Bound_Name : constant String :=
                                   Scoped_Lexeme
                                     (Raw_Lexeme (Tree (Tree (C_Node).Left_Child).Token_Index));
                              begin
                                 Current_Firewall := Find_Firewall (Bound_Name);
                                 if Current_Firewall = 0 then
                                    Fail_Node (C_Node, Err_Type_Conflict, Bound_Name, Success, Diag);
                                    return;
                                 end if;
                              end;
                           end if;
                           C_Node := Tree (C_Node).Next_Sibling;
                        end loop;

                        if Target = Backend_FASM then
                           Transpiler_Native_HAL.Emit_Procedure_Decl_Start (Target_Lex(1 .. Target_Len), Success);
                           -- FASM Args
                           declare
                              Arg_List : Node_Index := Tree(Var_Node).Right_Child;
                              Curr     : Node_Index;
                              Arg_Idx  : Natural := 0;
                           begin
                              if Arg_List /= 0 and then Tree(Arg_List).Kind = AST_Arg_List then
                                 Curr := Tree(Arg_List).Left_Child;
                                 while Curr /= 0 and then Tree(Curr).Kind = AST_Param_Decl loop
                                    declare
                                       PName_Node : Node_Index := Tree(Curr).Left_Child;
                                       ATok : Token := Tokens(Tree(PName_Node).Token_Index);
                                       Raw_AName : String := Input_Buffer(ATok.Start .. ATok.Start + ATok.Length - 1);
                                       AName : String(1 .. 128) := (others => ' ');
                                       ALen : Natural := 0;
                                       Dummy_Ref   : ALB_Reference;
                                       Dummy_Bool  : Boolean;
                                       P_Hash      : U32 := 5381;
                                       Param_Tag   : ALB_Type_Tag := Type_U64;
                                       Param_Range : Natural := 0;
                                       Is_Out_Param : Boolean := False;
                                       Decl_Tag    : ALB_Type_Tag := Type_U64;
                                    begin
                                       declare
                                          Safe_AName : constant String := Scoped_Lexeme (Raw_AName);
                                       begin
                                          AName (1 .. Safe_AName'Length) := Safe_AName;
                                          ALen := Safe_AName'Length;
                                       end;
                                       
                                       if Tree(Curr).Right_Child /= 0 then
                                          declare
                                             Type_Node : constant Node_Index := Tree (Curr).Right_Child;
                                             Type_Tok  : Token := Tokens (Tree (Type_Node).Token_Index);
                                             Type_Lex  : String := To_Upper
                                               (Input_Buffer
                                                  (Type_Tok.Start ..
                                                   Type_Tok.Start + Type_Tok.Length - 1));
                                          begin
                                             Param_Range := Find_Range_Type (Type_Lex);

                                             if Param_Range > 0 then
                                                Param_Tag := Range_Types (Param_Range).Base_Tag;
                                             else
                                                Param_Tag := Type_Tag_From_Type_Node (Type_Node);
                                                if Param_Tag = Type_None then
                                                   Param_Tag := Type_U64;
                                                end if;
                                             end if;
                                          end;
                                       end if;


                                       for I in 1 .. ALen loop P_Hash := (P_Hash * 33) + U32(Character'Pos(AName(I))); end loop;

                                       Is_Out_Param :=
                                         Tree (Curr).Token_Index > 0
                                         and then Tokens (Tree (Curr).Token_Index).Kind = Tok_Out;
                                       if Is_Out_Param then
                                          Decl_Tag := Type_U64;
                                       else
                                          Decl_Tag := Param_Tag;
                                       end if;

                                       Symbol_Table.Add_Local_Symbol(Token_Idx => P_Hash, Tag => Param_Tag, Ref => Dummy_Ref, Offset => 0, Struct_ID => 0, Scope => Current_Scope, Success => Dummy_Bool);
                                       Transpiler_Native_HAL.Emit_Var_Decl (AName(1 .. ALen), Decl_Tag, Dummy_Bool);

                                       if Arg_Idx = 0 then
                                          Transpiler_Native_HAL.Emit_Raw
                                            ("  mov rax, rcx",
                                             Success);
                                          Transpiler_Native_HAL.Emit_Newline (Success);
                                       elsif Arg_Idx = 1 then
                                          Transpiler_Native_HAL.Emit_Raw
                                            ("  mov rax, rdx",
                                             Success);
                                          Transpiler_Native_HAL.Emit_Newline (Success);
                                       elsif Arg_Idx = 2 then
                                          Transpiler_Native_HAL.Emit_Raw
                                            ("  mov rax, r8",
                                             Success);
                                          Transpiler_Native_HAL.Emit_Newline (Success);
                                       elsif Arg_Idx = 3 then
                                          Transpiler_Native_HAL.Emit_Raw
                                            ("  mov rax, r9",
                                             Success);
                                          Transpiler_Native_HAL.Emit_Newline (Success);
                                       else
                                          declare
                                             Stack_Off : constant Natural := 80 + ((Arg_Idx - 4) * 8);
                                             Off_Img   : constant String := Natural'Image (Stack_Off);
                                          begin
                                             Transpiler_Native_HAL.Emit_Raw
                                               ("  mov rax, qword [rsp + " &
                                                Off_Img (Off_Img'First + 1 .. Off_Img'Last) & "]",
                                                Success);
                                             Transpiler_Native_HAL.Emit_Newline (Success);
                                          end;
                                       end if;

                                       if Is_Out_Param then
                                          Transpiler_Native_HAL.Emit_Raw
                                            ("  mov qword [" & AName (1 .. ALen) & "], rax",
                                             Success);
                                          Transpiler_Native_HAL.Emit_Newline (Success);
                                          Track_Out_Param (P_Hash);
                                       else
                                          Emit_FASM_Store_RAX_To_Scalar
                                            (AName (1 .. ALen),
                                             Param_Tag,
                                             Success);
                                       end if;

                                        if Param_Range > 0
                                          and then not Is_Out_Param
                                        then
                                           Register_Range_Var(AName(1 .. ALen), Param_Range);

                                           Emit_FASM_Load_Scalar_To_RAX
                                             (AName (1 .. ALen),
                                              Param_Tag,
                                              Success);

                                           Emit_FASM_Range_Check_RAX(Param_Range);
                                           if not Success then return; end if;
                                        end if;

                                       Arg_Idx := Arg_Idx + 1;
                                       Curr := Tree(Curr).Next_Sibling;
                                    end;
                                 end loop;
                              end if;
                           end;
                        --  elsif Target = Backend_FASM16 then
                        --     declare
                        --        Arg_List : Node_Index := Tree (Var_Node).Right_Child;
                        --     begin
                        --        if Arg_List /= 0
                        --          and then Tree (Arg_List).Kind = AST_Arg_List
                        --          and then Tree (Arg_List).Left_Child /= 0
                        --        then
                        --           Fail_Node
                        --             (Node,
                        --              Err_Type_Conflict,
                        --              "FASM16 parameters are the next phase",
                        --              Success,
                        --              Diag);
                        --           return;
                        --        end if;
                        --     end;
                        elsif Target = Backend_FASM16 then
                           declare
                               Asm_Name  : constant String := FASM16_Asm_Name (Target_Lex (1 .. Target_Len));
                               Arg_List  : Node_Index := Tree (Var_Node).Right_Child;
                               Curr      : Node_Index;
                               Param_Bytes : Natural := 0;
                               Ret_Label : constant String := "ALB16_RET_" & Asm_Name;
                               Local_Size_Sym : constant String := "ALB16_LOCALS_" & Asm_Name;
                           begin
                              pragma Assert (Target_Len > 0, "FASM16: Target length must be positive");

                              if Tree (Node).Kind = AST_Procedure_Decl then
                                 Transpiler_Native_HAL.Emit_Procedure_Decl_Start (Asm_Name, Success);
                              else
                                 Transpiler_Native_HAL.Emit_Function_Decl_Start (Asm_Name, Type_U16, Success);
                              end if;
                              
                              -- DA FIX: Set up the BP Stack Frame!
                               Transpiler_Native_HAL.Emit_Raw ("  push bp", Success);
                               Transpiler_Native_HAL.Emit_Newline (Success);
                               Transpiler_Native_HAL.Emit_Raw ("  mov bp, sp", Success);
                               Transpiler_Native_HAL.Emit_Newline (Success);
                               Transpiler_Native_HAL.Emit_Raw ("  sub sp, " & Local_Size_Sym, Success);
                               Transpiler_Native_HAL.Emit_Newline (Success);

                               if Arg_List /= 0 and then Tree (Arg_List).Kind = AST_Arg_List then
                                  Curr := Tree (Arg_List).Left_Child;
                                  while Curr /= 0 loop
                                     declare
                                        PName_Node  : Node_Index := Tree (Curr).Left_Child;
                                        ATok        : Token := Tokens (Tree (PName_Node).Token_Index);
                                        Raw_AName   : String := Input_Buffer (ATok.Start .. ATok.Start + ATok.Length - 1);
                                        AName       : String (1 .. 128) := (others => ' ');
                                        ALen        : Natural := 0;
                                        Dummy_Ref   : ALB_Reference;
                                        Dummy_Bool  : Boolean;
                                        P_Hash      : U32 := 5381;
                                        Param_Tag   : ALB_Type_Tag := Type_U16;
                                        Param_Range : Natural := 0;
                                     begin
                                        if Active_Module_Len > 0 then
                                           AName (1 .. Active_Module_Len) := Active_Module_Name (1 .. Active_Module_Len);
                                           AName (Active_Module_Len + 1) := '_';
                                           AName (Active_Module_Len + 2 .. Active_Module_Len + 1 + Raw_AName'Length) := Raw_AName;
                                           ALen := Active_Module_Len + 1 + Raw_AName'Length;
                                        else
                                           AName (1 .. Raw_AName'Length) := Raw_AName;
                                           ALen := Raw_AName'Length;
                                        end if;

                                        if Tree (Curr).Right_Child /= 0 then
                                           declare
                                              Type_Tok : Token := Tokens (Tree (Tree (Curr).Right_Child).Token_Index);
                                              Type_Lex : String := To_Upper (Input_Buffer (Type_Tok.Start .. Type_Tok.Start + Type_Tok.Length - 1));
                                           begin
                                              Param_Range := Find_Range_Type (Type_Lex);

                                              if Param_Range > 0 then
                                                 Param_Tag := Range_Types (Param_Range).Base_Tag;
                                              else
                                                 Param_Tag := Type_Tag_From_Name (Type_Lex);
                                              end if;

                                              if not FASM16_Scalar_Supported (Param_Tag) then
                                                 Fail_Node
                                                   (Node,
                                                    Err_Type_Conflict,
                                                    "FASM16 params must be U8, U16, U32, U64, S32, S64, HW8, HW16, HW32, PURE, or Boolean",
                                                    Success,
                                                    Diag);
                                                 return;
                                              end if;
                                           end;
                                        end if;

                                        if not FASM16_Scalar_Supported (Param_Tag) then
                                            Fail_Node
                                              (Node,
                                               Err_Type_Conflict,
                                               "FASM16 params must be U8, U16, U32, U64, S32, S64, HW8, HW16, HW32, PURE, or Boolean",
                                               Success,
                                               Diag);
                                            return;
                                         end if;

                                        for I in 1 .. ALen loop
                                           P_Hash := (P_Hash * 33) + U32 (Character'Pos (AName (I)));
                                        end loop;

                                        if Param_Range > 0 then
                                           Register_Range_Var (AName (1 .. ALen), Param_Range);
                                        end if;

                                        Symbol_Table.Add_Local_Symbol (
                                           Token_Idx => P_Hash,
                                           Tag       => Param_Tag,
                                           Ref       => Dummy_Ref,
                                           Offset    => 4 + Param_Bytes,
                                           Struct_ID => 0,
                                           Scope     => Current_Scope,
                                           Success   => Dummy_Bool
                                        );

                                        Param_Bytes := Param_Bytes + FASM16_Param_Slot_Bytes (Param_Tag);
                                        Curr := Tree (Curr).Next_Sibling;
                                     end;
                                  end loop;
                               end if;

                               Current_FASM16_Param_Bytes := Param_Bytes;
                               Current_FASM16_Return_Label := (others => ' ');
                               Current_FASM16_Return_Label (1 .. Ret_Label'Length) := Ret_Label;
                               Current_FASM16_Return_Label_Len := Ret_Label'Length;

                               pragma Assert (Current_FASM16_Return_Label_Len > 0, "FASM16: Return label generation failed");
                            end;
                        else
                           declare
                              Sig             : ALB_Signature;
                              Body_Return_Tag : ALB_Type_Tag := Type_U64;
                           begin
                              if Find_ALB_Signature (Target_Lex (1 .. Target_Len), Sig)
                                and then Sig.Return_Tag /= Type_None
                              then
                                 Body_Return_Tag := Sig.Return_Tag;
                              end if;

                              Transpiler_Native_HAL.Emit_Function_Decl_Start
                                (Target_Lex (1 .. Target_Len),
                                 Body_Return_Tag,
                                 Success);
                           end;
                           Transpiler_Native_HAL.Emit_Raw ("(", Success);
                           -- C Args
                           declare
                              Arg_List : Node_Index := Tree(Var_Node).Right_Child;
                              Curr     : Node_Index;
                           begin
                              if Arg_List /= 0 and then Tree(Arg_List).Kind = AST_Arg_List then
                                 Curr := Tree(Arg_List).Left_Child;
                                 if Curr = 0 then Transpiler_Native_HAL.Emit_Raw ("void", Success);
                                 else
                                    while Curr /= 0 loop
                                       declare
                                          PName_Node : Node_Index := Tree(Curr).Left_Child; 
                                          ATok : Token := Tokens(Tree(PName_Node).Token_Index);
                                          Raw_AName : String := Input_Buffer(ATok.Start .. ATok.Start + ATok.Length - 1);
                                          AName : String(1 .. 128) := (others => ' ');
                                          ALen : Natural := 0;
                                          Dummy_Ref   : ALB_Reference;
                                          Dummy_Bool  : Boolean;
                                          P_Hash      : U32 := 5381;
                                          Param_Tag   : ALB_Type_Tag := Type_U64;
                                          Param_Range : Natural := 0;
                                       begin
                                          if Active_Module_Len > 0 then
                                             AName (1 .. Active_Module_Len) := Active_Module_Name (1 .. Active_Module_Len);
                                             AName (Active_Module_Len + 1) := '_';
                                             AName (Active_Module_Len + 2 .. Active_Module_Len + 1 + Raw_AName'Length) := Raw_AName;
                                             ALen := Active_Module_Len + 1 + Raw_AName'Length;
                                          else
                                             AName (1 .. Raw_AName'Length) := Raw_AName;
                                             ALen := Raw_AName'Length;
                                          end if;
                                          
                                          if Tree(Curr).Right_Child /= 0 then
                                             declare
                                                Type_Node : constant Node_Index := Tree (Curr).Right_Child;
                                                Type_Tok  : Token := Tokens (Tree (Type_Node).Token_Index);
                                                Type_Lex  : String := To_Upper
                                                  (Input_Buffer
                                                     (Type_Tok.Start ..
                                                      Type_Tok.Start + Type_Tok.Length - 1));
                                             begin
                                                Param_Range := Find_Range_Type (Type_Lex);

                                                if Param_Range > 0 then
                                                   Param_Tag := Range_Types (Param_Range).Base_Tag;
                                                else
                                                   Param_Tag := Type_Tag_From_Type_Node (Type_Node);
                                                   if Param_Tag = Type_None then
                                                      Param_Tag := Type_U64;
                                                   end if;
                                                end if;
                                             end;
                                          end if;


                                          for I in 1 .. ALen loop P_Hash := (P_Hash * 33) + U32(Character'Pos(AName(I))); end loop;
                                          
                                           if Param_Range > 0 then
                                              Register_Range_Var(AName(1 .. ALen), Param_Range);
                                           end if;

                                          Symbol_Table.Add_Local_Symbol(Token_Idx => P_Hash, Tag => Param_Tag, Ref => Dummy_Ref, Offset => 0, Struct_ID => 0, Scope => Current_Scope, Success => Dummy_Bool);
                                          Transpiler_Native_HAL.Emit_Raw ("uint64_t " & AName(1 .. ALen), Success);
                                          
                                          Curr := Tree(Curr).Next_Sibling;
                                          if Curr /= 0 then Transpiler_Native_HAL.Emit_Raw (", ", Success); end if;
                                       end;
                                    end loop;
                                 end if;
                              else
                                 Transpiler_Native_HAL.Emit_Raw ("void", Success);
                              end if;
                           end;
                           Transpiler_Native_HAL.Emit_Raw (") {", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                        end if;
                        
                         Validate_Return_Shape
                           (Node,
                            Target_Lex(1 .. Target_Len),
                            Tree(Node).Right_Child,
                            Success,
                            Diag);

                         if not Success or else not Diag.Success then
                            return;
                         end if;



                        -- 1. Pre-Conditions
                        if Tree(Var_Node).Right_Child /= 0 then
                           declare
                              Arg_List : constant Node_Index := Tree(Var_Node).Right_Child;
                           begin
                              if Tree(Arg_List).Kind = AST_Arg_List then
                                 C_Node := Tree(Arg_List).Left_Child;
                              else
                                 C_Node := Arg_List;
                              end if;
                              while C_Node /= 0 loop
                                 if Tree(C_Node).Kind = AST_Require_Clause then
                                    Walk_AST(C_Node, Depth + 1, Dummy_Tag, Success, Diag);
                                 end if;
                                 C_Node := Tree(C_Node).Next_Sibling;
                              end loop;
                              if Tree(Arg_List).Kind = AST_Arg_List then
                                 C_Node := Tree(Arg_List).Next_Sibling;
                                 while C_Node /= 0 loop
                                    if Tree(C_Node).Kind = AST_Require_Clause then
                                       Walk_AST(C_Node, Depth + 1, Dummy_Tag, Success, Diag);
                                    end if;
                                    C_Node := Tree(C_Node).Next_Sibling;
                                 end loop;
                              end if;
                           end;
                        end if;

                        -- 2. Walk Body EXACTLY ONCE!
                        Walk_AST (Tree (Node).Right_Child, Depth + 1, Right_Tag, Success, Diag);

                        if not Success or else not Diag.Success then
                           return;
                        end if;

                        -- 2b. Validate return expression types after local LET symbols exist.
                        Validate_Return_Types
                          (Node,
                           Tree(Node).Right_Child,
                           Success,
                           Diag);

                        if not Success or else not Diag.Success then
                           return;
                        end if;


                        --  -- 3. Post-Conditions
                        --  C_Node := 0;
                        --  if Tree(Var_Node).Right_Child /= 0 then C_Node := Tree(Tree(Var_Node).Right_Child).Next_Sibling; end if;
                        --  while C_Node /= 0 loop
                        --     if Tree(C_Node).Kind = AST_Ensure_Clause then Walk_AST(C_Node, Depth + 1, Dummy_Tag, Success, Diag); end if;
                        --     C_Node := Tree(C_Node).Next_Sibling;
                        --  end loop;
                        --  
                        --  Transpiler_Native_HAL.Emit_Procedure_End (Target_Lex(1 .. Target_Len), Success);
                        --  Current_Function_Return_Range := Saved_Return_Range;
                        --  Symbol_Table.Drop_Scope (Current_Scope, Success);
                        --  Current_Scope := Current_Scope - 1;
                        -- 3. Post-Conditions
                        C_Node := 0;
                        if Tree(Var_Node).Right_Child /= 0 then
                           declare
                              Arg_List : constant Node_Index := Tree(Var_Node).Right_Child;
                           begin
                              if Tree(Arg_List).Kind = AST_Arg_List then
                                 C_Node := Tree(Arg_List).Left_Child;
                              else
                                 C_Node := Arg_List;
                              end if;
                              while C_Node /= 0 loop
                                 if Tree(C_Node).Kind = AST_Ensure_Clause then
                                    Walk_AST(C_Node, Depth + 1, Dummy_Tag, Success, Diag);
                                 end if;
                                 C_Node := Tree(C_Node).Next_Sibling;
                              end loop;
                              if Tree(Arg_List).Kind = AST_Arg_List then
                                 C_Node := Tree(Arg_List).Next_Sibling;
                                 while C_Node /= 0 loop
                                    if Tree(C_Node).Kind = AST_Ensure_Clause then
                                       Walk_AST(C_Node, Depth + 1, Dummy_Tag, Success, Diag);
                                    end if;
                                    C_Node := Tree(C_Node).Next_Sibling;
                                 end loop;
                              end if;
                           end;
                        end if;
                        
                        if Target = Backend_FASM16 then
                           declare
                              Asm_Name       : constant String := FASM16_Asm_Name (Target_Lex (1 .. Target_Len));
                              Local_Size_Sym : constant String := "ALB16_LOCALS_" & Asm_Name;
                              Local_Size_Img : constant String := Integer'Image (Local_Offset);
                           begin
                              Transpiler_Native_HAL.Emit_Raw
                                (Local_Size_Sym & " = " &
                                 Local_Size_Img (Local_Size_Img'First + 1 .. Local_Size_Img'Last),
                                 Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                           end;

                           Transpiler_Native_HAL.Emit_Raw
                             (Current_FASM16_Return_Label (1 .. Current_FASM16_Return_Label_Len) & ":",
                              Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Transpiler_Native_HAL.Emit_Raw ("  mov sp, bp", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Transpiler_Native_HAL.Emit_Raw ("  pop bp", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);

                           if Current_FASM16_Param_Bytes = 0 then
                              Transpiler_Native_HAL.Emit_Raw ("  ret", Success);
                           else
                              declare
                                 Img : constant String := Natural'Image (Current_FASM16_Param_Bytes);
                              begin
                                 Transpiler_Native_HAL.Emit_Raw ("  ret " & Img (Img'First + 1 .. Img'Last), Success);
                              end;
                           end if;
                           Transpiler_Native_HAL.Emit_Newline (Success);

                           declare
                              Asm_Name : constant String := FASM16_Asm_Name (Target_Lex (1 .. Target_Len));
                           begin
                              Transpiler_Native_HAL.Emit_Raw ("ALB16_skip_proc_" & Asm_Name & ":", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                           end;
                        else
                           Transpiler_Native_HAL.Emit_Procedure_End (Target_Lex(1 .. Target_Len), Success);
                        end if;

                        Current_Function_Return_Range := Saved_Return_Range;
                        Current_FASM_Select_Stack_Bytes := Saved_FASM_Select_Stack_Bytes;
                        Local_Offset := Saved_Local_Offset;
                        Current_Firewall := Saved_Firewall;
                        Symbol_Table.Drop_Scope (Current_Scope, Success);
                        Clear_Out_Params;
                        Drop_FASM16_Pointer_Meta (Current_Scope);
                        Current_Scope := Current_Scope - 1;
                     end;
                  end if;
               end;
               Out_Tag := Type_None;
               
            when AST_Temporal_Decl =>
               declare
                  Target_Node  : Node_Index := Tree(Node).Left_Child;
                  History_Node : Node_Index := Tree(Node).Right_Child;
                  Init_Node    : Node_Index := 0;
                  Hist_Val     : U64 := 0;
                  Hist_Depth   : Natural := 0;
                  Final_Tag    : ALB_Type_Tag := (if Target = Backend_FASM16 then Type_U16 else Type_U64);
                  Dummy_Tag    : ALB_Type_Tag := Type_None;
               begin
                   if Target /= Backend_FASM
                     and then Target /= Backend_FASM16
                     and then Target /= Backend_C
                   then
                      Fail_Node (Node, Err_Type_Conflict, "TEMPORAL", Success, Diag);
                      return;
                   end if;

                  if Current_Scope /= 0 then
                     Fail_Node (Node, Err_Type_Conflict, "TEMPORAL global only", Success, Diag);
                     return;
                  end if;

                  if Target_Node = 0
                    or else History_Node = 0
                    or else Tree(Target_Node).Kind /= AST_Var_Expr
                    or else Tree(Target_Node).Left_Child /= 0
                  then
                     Fail_Node (Node, Err_Type_Conflict, "TEMPORAL LET", Success, Diag);
                     return;
                  end if;

                  Init_Node := Tree(History_Node).Next_Sibling;
                  if Init_Node = 0 then
                     Fail_Node (Node, Err_Parse_Expected_Value, "TEMPORAL INIT", Success, Diag);
                     return;
                  end if;

                  Comptime_Eval_Expr (History_Node, Hist_Val, Success, Diag);
                  if not Success then return; end if;

                  if Hist_Val = 0 or else Hist_Val > U64(Max_Temporal_History) then
                     Fail_Node (Node, Err_Mem_Out_Of_Bounds, "HISTORY", Success, Diag);
                     return;
                  end if;

                  Hist_Depth := Natural (Hist_Val);

                  if Tree(Node).Token_Index > 0 then
                     Final_Tag := Type_From_Lexeme (Raw_Lexeme (Tree(Node).Token_Index));

                     if Final_Tag = Type_None then
                        Fail_Node (Node, Err_Type_Conflict, Raw_Lexeme (Tree(Node).Token_Index), Success, Diag);
                        return;
                     end if;
                  else
                     Final_Tag := Infer_Type_Tag (Init_Node);

                     if Final_Tag = Type_None then
                        Final_Tag := (if Target = Backend_FASM16 then Type_U16 else Type_U64);
                     end if;
                  end if;


                  if Final_Tag = Type_None then
                     Final_Tag := (if Target = Backend_FASM16 then Type_U16 else Type_U64);
                  end if;

                  if Target = Backend_FASM16
                    and then not FASM16_Scalar_Supported (Final_Tag)
                  then
                     Fail_Node (Node, Err_Type_Conflict, "TEMPORAL FASM16 scalar", Success, Diag);
                     return;
                  end if;

                  declare
                     Tok         : Token := Tokens (Tree(Target_Node).Token_Index);
                     Raw_Name    : String := Input_Buffer (Tok.Start .. Tok.Start + Tok.Length - 1);
                     Target_Name : constant String := Scoped_Lexeme (Raw_Name);
                  begin
                     Register_Temporal_Global
                       (Target_Name, Final_Tag, Hist_Depth, Node, Success, Diag);
                     if not Success then return; end if;

                     Transpiler_Native_HAL.Set_Global_Buffer_Mode (True);
                     Transpiler_Native_HAL.Emit_Temporal_Var_Decl
                       (Target_Name, Final_Tag, Hist_Depth, Success);
                     
                     if not Success then return; end if;

                      if Target = Backend_FASM16 then
                         Emit_FASM16_Temporal_Future_Shadow_Decl
                           (Target_Name, Final_Tag, Hist_Depth, Success);
                      elsif Target = Backend_FASM then
                         Emit_FASM_Temporal_Future_Shadow_Decl
                           (Target_Name, Hist_Depth, Success);
                      else
                         Emit_C_Temporal_Future_Helper
                           (Target_Name, Final_Tag, Success);
                      end if;

                     
                     Transpiler_Native_HAL.Set_Global_Buffer_Mode (False);
                     if not Success then return; end if;

                      if Target = Backend_C then
                         Transpiler_Native_HAL.Emit_Indent (Success);
                         Transpiler_Native_HAL.Emit_Raw (Target_Name & " = ", Success);
                         Walk_AST (Init_Node, Depth + 1, Dummy_Tag, Success, Diag);
                         if not Success then return; end if;
                         Transpiler_Native_HAL.Emit_Raw (";", Success);
                         Transpiler_Native_HAL.Emit_Newline (Success);
                      else
                         Walk_AST (Init_Node, Depth + 1, Dummy_Tag, Success, Diag);
                         if not Success then return; end if;
                      end if;

                      if Target = Backend_FASM16 then
                         Emit_FASM16_Store_DXAX_To_Cell
                           (Target_Name, Final_Tag);
                      elsif Target = Backend_FASM then
                         Emit_FASM_Store_RAX_To_Scalar
                           (Target_Name, Final_Tag, Success);
                      end if;
                     if not Success then return; end if;

                     Transpiler_Native_HAL.Emit_Temporal_Record_Current
                       (Target_Name, Final_Tag, Hist_Depth, Success);
                  end;

                  Out_Tag := Type_None;
               end;

            when AST_Advance_Stmt =>
               declare
                  Count_Node      : Node_Index := Tree(Node).Left_Child;
                  Count_Val       : U64 := 1;
                  Advance_Tok_Idx : constant Natural := Tree (Node).Token_Index;
                  Is_Postfix_Op   : constant Boolean :=
                    Advance_Tok_Idx > 0
                      and then Tokens (Advance_Tok_Idx).Kind in Tok_Plus | Tok_Minus;
               begin
                  if Is_Postfix_Op then
                     if Count_Node = 0 or else Tree (Count_Node).Kind /= AST_Var_Expr then
                        Fail_Node (Node, Err_Compiler_AST_Mismatch, "ADVANCE target", Success, Diag);
                        return;
                     end if;

                     declare
                        Tok        : Token := Tokens (Tree (Count_Node).Token_Index);
                        Lexeme     : String := Input_Buffer (Tok.Start .. Tok.Start + Tok.Length - 1);
                        Target_Lex : constant String := Scoped_Lexeme (Lexeme);
                        Found      : Boolean := False;
                        Sym        : Symbol_Record;
                     begin
                        Find_Symbol (Hash_String (Target_Lex), Current_Scope, Found, Sym);
                        if not Found then
                           Fail_Node (Count_Node, Err_Type_Conflict, Target_Lex, Success, Diag);
                           return;
                        end if;

                        if Target = Backend_FASM16 then
                           declare
                              Cell : constant String := FASM16_Cell_Name (Sym, Target_Lex);
                           begin
                              Emit_FASM16_Load_Cell_To_DXAX (Cell, Sym.Tag);

                              if Tokens (Advance_Tok_Idx).Kind = Tok_Plus then
                                 Transpiler_Native_HAL.Emit_Raw ("  add ax, 1", Success);
                                 Transpiler_Native_HAL.Emit_Newline (Success);
                                 if FASM16_Storage_Bytes (Sym.Tag) >= 4 then
                                    Transpiler_Native_HAL.Emit_Raw ("  adc dx, 0", Success);
                                    Transpiler_Native_HAL.Emit_Newline (Success);
                                 end if;
                              else
                                 Transpiler_Native_HAL.Emit_Raw ("  sub ax, 1", Success);
                                 Transpiler_Native_HAL.Emit_Newline (Success);
                                 if FASM16_Storage_Bytes (Sym.Tag) >= 4 then
                                    Transpiler_Native_HAL.Emit_Raw ("  sbb dx, 0", Success);
                                    Transpiler_Native_HAL.Emit_Newline (Success);
                                 end if;
                              end if;

                              Emit_FASM16_Type_Store_Check_AX (Sym.Tag);
                              if not Success then
                                 return;
                              end if;

                              Emit_FASM16_Store_DXAX_To_Cell (Cell, Sym.Tag);
                           end;

                        elsif Target = Backend_FASM then
                           Emit_FASM_Load_Scalar_To_RAX (Target_Lex, Sym.Tag, Success);
                           if not Success then
                              return;
                           end if;

                           if Tokens (Advance_Tok_Idx).Kind = Tok_Plus then
                              Transpiler_Native_HAL.Emit_Raw ("  add rax, 1", Success);
                           else
                              Transpiler_Native_HAL.Emit_Raw ("  sub rax, 1", Success);
                           end if;
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Emit_FASM_Store_RAX_To_Scalar (Target_Lex, Sym.Tag, Success);

                         elsif Target = Backend_C then
                            Transpiler_Native_HAL.Emit_Indent (Success);
                            Transpiler_Native_HAL.Emit_Raw (Target_Lex & " = " & Target_Lex, Success);
                            if Tokens (Advance_Tok_Idx).Kind = Tok_Plus then
                               Transpiler_Native_HAL.Emit_Raw (" + 1;", Success);
                            else
                               Transpiler_Native_HAL.Emit_Raw (" - 1;", Success);
                            end if;
                            Transpiler_Native_HAL.Emit_Newline (Success);

                         else
                            Fail_Node (Node, Err_Type_Conflict, "ADVANCE", Success, Diag);
                            return;
                         end if;

                        Out_Tag := Type_None;
                        return;
                     end;
                  end if;

                   if Target /= Backend_FASM
                     and then Target /= Backend_FASM16
                     and then Target /= Backend_C
                   then
                      Fail_Node (Node, Err_Type_Conflict, "ADVANCE", Success, Diag);
                      return;
                   end if;

                  if Count_Node /= 0 then
                     Comptime_Eval_Expr (Count_Node, Count_Val, Success, Diag);
                     if not Success then return; end if;
                  end if;

                  if Count_Val > U64(Max_Temporal_Advance) then
                     Fail_Node (Node, Err_Mem_Out_Of_Bounds, "ADVANCE", Success, Diag);
                     return;
                  end if;

                  for I in 1 .. Natural (Count_Val) loop
                     Emit_Temporal_Record_All (Success, Diag);
                     if not Success then return; end if;
                  end loop;

                  Out_Tag := Type_None;
               end;

            when AST_Temporal_Block =>
                if Target = Backend_FASM or else Target = Backend_FASM16 then
                   Transpiler_Native_HAL.Emit_Raw ("  ; TEMPORAL BLOCK BEGIN", Success);
                   Transpiler_Native_HAL.Emit_Newline (Success);
                   Walk_AST (Tree(Node).Left_Child, Depth + 1, Out_Tag, Success, Diag);
                   Transpiler_Native_HAL.Emit_Raw ("  ; TEMPORAL BLOCK END", Success);
                   Transpiler_Native_HAL.Emit_Newline (Success);
                elsif Target = Backend_C then
                   Transpiler_Native_HAL.Emit_Indent (Success);
                   Transpiler_Native_HAL.Emit_Raw ("/* TEMPORAL BLOCK BEGIN */", Success);
                   Transpiler_Native_HAL.Emit_Newline (Success);
                   Walk_AST (Tree(Node).Left_Child, Depth + 1, Out_Tag, Success, Diag);
                   Transpiler_Native_HAL.Emit_Indent (Success);
                   Transpiler_Native_HAL.Emit_Raw ("/* TEMPORAL BLOCK END */", Success);
                   Transpiler_Native_HAL.Emit_Newline (Success);
                else
                   Fail_Node (Node, Err_Type_Conflict, "TEMPORAL", Success, Diag);
                   return;
                end if;

               Out_Tag := Type_None;
               
            when AST_Temporal_Ref =>
               declare
                  Base_Node : Node_Index := Tree(Node).Left_Child;
                  Sel_Tok   : Token := Tokens (Tree(Node).Token_Index);
                  Idx       : Natural := 0;
               begin
                   if Target /= Backend_FASM
                     and then Target /= Backend_FASM16
                     and then Target /= Backend_C
                   then
                      Fail_Node (Node, Err_Type_Conflict, "TEMPORAL REF", Success, Diag);
                      return;
                   end if;

                  if Base_Node = 0
                    or else Tree(Base_Node).Kind /= AST_Var_Expr
                    or else Tree(Base_Node).Left_Child /= 0
                  then
                     Fail_Node (Node, Err_Type_Conflict, "TEMPORAL REF", Success, Diag);
                     return;
                  end if;

                  declare
                     Tok         : Token := Tokens (Tree(Base_Node).Token_Index);
                     Raw_Name    : String := Input_Buffer (Tok.Start .. Tok.Start + Tok.Length - 1);
                     Target_Name : constant String := Scoped_Lexeme (Raw_Name);
                  begin
                     Idx := Find_Temporal (Target_Name);

                     if Idx = 0 then
                        Fail_Node (Node, Err_Type_Conflict, Target_Name, Success, Diag);
                        return;
                     end if;

                     case Sel_Tok.Kind is
                        when Tok_Now =>
                           Transpiler_Native_HAL.Emit_Temporal_Load_Now
                             (Target_Name, Temporal_Entries(Idx).Tag, Success);
                           Out_Tag := Temporal_Entries(Idx).Tag;

                        when Tok_Past =>
                           Transpiler_Native_HAL.Emit_Temporal_Load_Past
                             (Target_Name,
                              Temporal_Entries(Idx).Tag,
                              Temporal_Entries(Idx).History_Depth,
                              Success);
                           Out_Tag := Temporal_Entries(Idx).Tag;

                        when Tok_Timeline =>
                           Transpiler_Native_HAL.Emit_Temporal_Load_Timeline
                             (Target_Name, Success);
                           if Target = Backend_FASM16 then
                              Out_Tag := Type_U16;
                           else
                              Out_Tag := Type_U64;
                           end if;

                        when Tok_Future =>
                           if Target = Backend_C then
                              Transpiler_Native_HAL.Emit_Raw
                                ("ALB_TEMP_FUTURE_" & Target_Name & "()", Success);
                           else
                              Transpiler_Native_HAL.Emit_Raw
                                ("  ; @future sandbox: save temporal state, tick once, restore present", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                           end if;

                           if Target = Backend_FASM16 then
                              Emit_FASM16_Temporal_Future_To_DXAX
                                (Target_Name,
                                 Temporal_Entries(Idx).Tag,
                                 Node,
                                 Success,
                                  Diag);
                           elsif Target = Backend_FASM then
                              Emit_FASM_Temporal_Future_To_RAX
                                (Target_Name,
                                 Temporal_Entries(Idx).Tag,
                                 Node,
                                 Success,
                                 Diag);
                           end if;

                           Out_Tag := Temporal_Entries(Idx).Tag;


                        when others =>
                           Fail_Node (Node, Err_Type_Conflict, "TEMPORAL REF", Success, Diag);
                           return;
                     end case;
                  end;
               end;

            when AST_Memory_Firewall_Decl
               | AST_Firewall_Permit_Read
               | AST_Firewall_Permit_Write
               | AST_Firewall_Deny_All
               | AST_Bound_To_Clause
               | AST_Process_Handle_Decl
               | AST_Process_Pid
               | AST_Process_Image
               | AST_Process_Rights
                | AST_Network_Socket_Decl
                | AST_Network_Protocol
                | AST_Network_Port
