      Max_Loop_Control_Depth : constant := 256;

      type Loop_Label_Record is record
         Break_Label    : String (1 .. 96) := (others => ' ');
         Break_Len      : Natural := 0;
         Continue_Label : String (1 .. 96) := (others => ' ');
         Continue_Len   : Natural := 0;
         FASM16_Guard_Active : Boolean := False;
         FASM16_Guard_Hash     : U32 := 0;
         FASM16_Guard_Start    : U64 := 0;
         FASM16_Guard_End      : U64 := 0;
      end record;

      Loop_Label_Stack : array (1 .. Max_Loop_Control_Depth) of Loop_Label_Record :=
        (others =>
           (Break_Label    => (others => ' '),
            Break_Len      => 0,
            Continue_Label => (others => ' '),
            Continue_Len   => 0,
            FASM16_Guard_Active => False,
            FASM16_Guard_Hash     => 0,
            FASM16_Guard_Start    => 0,
            FASM16_Guard_End      => 0));

      Loop_Label_Depth : Natural := 0;

      procedure Push_FASM_Loop_Labels
        (Break_Label    : in String;
         Continue_Label : in String;
         Origin         : in Node_Index;
         Success        : in out Boolean;
         Diag           : in out Compiler_Diagnostic) is
      begin
         if Loop_Label_Depth >= Max_Loop_Control_Depth then
            Fail_Node (Origin, Err_Call_Stack_Overflow, "LOOP", Success, Diag);
            return;
         end if;

         Loop_Label_Depth := Loop_Label_Depth + 1;

         Loop_Label_Stack (Loop_Label_Depth).FASM16_Guard_Active := False;

         Store_Name
           (Loop_Label_Stack (Loop_Label_Depth).Break_Label,
            Loop_Label_Stack (Loop_Label_Depth).Break_Len,
            Break_Label);

         Store_Name
           (Loop_Label_Stack (Loop_Label_Depth).Continue_Label,
            Loop_Label_Stack (Loop_Label_Depth).Continue_Len,
            Continue_Label);
      end Push_FASM_Loop_Labels;

      procedure Pop_FASM_Loop_Labels is
      begin
         if Loop_Label_Depth > 0 then
            Loop_Label_Stack (Loop_Label_Depth).FASM16_Guard_Active := False;
            Loop_Label_Depth := Loop_Label_Depth - 1;
         end if;
      end Pop_FASM_Loop_Labels;

      function FASM16_Index_Is_Loop_Guarded
        (Index_Node : in Node_Index;
         Bound      : in Natural) return Boolean
      is
      begin
         if Loop_Label_Depth = 0
           or else not Loop_Label_Stack (Loop_Label_Depth).FASM16_Guard_Active
           or else Bound = 0
         then
            return False;
         end if;

         if Index_Node = 0 or else Tree (Index_Node).Kind /= AST_Var_Expr then
            return False;
         end if;

         declare
            Tok    : constant Token := Tokens (Tree (Index_Node).Token_Index);
            Lexeme : constant String :=
              Input_Buffer (Tok.Start .. Tok.Start + Tok.Length - 1);
            Target : constant String := Scoped_Lexeme (Lexeme);
         begin
            if Hash_String (Target) /= Loop_Label_Stack (Loop_Label_Depth).FASM16_Guard_Hash then
               return False;
            end if;
         end;

         return
           Loop_Label_Stack (Loop_Label_Depth).FASM16_Guard_Start >= 1
             and then
           Loop_Label_Stack (Loop_Label_Depth).FASM16_Guard_End <= U64 (Bound);
      end FASM16_Index_Is_Loop_Guarded;

      procedure Emit_FASM_Loop_Jump
        (Use_Continue : in Boolean;
         Origin       : in Node_Index;
         Keyword      : in String;
         Success      : in out Boolean;
         Diag         : in out Compiler_Diagnostic) is
      begin
         if Loop_Label_Depth = 0 then
            Fail_Node (Origin, Err_Compiler_AST_Mismatch, Keyword, Success, Diag);
            return;
         end if;

         -- MATCH/SELECT stash the selector on the stack for the whole block.
         -- BREAK/CONTINUE jump past .END_SELECT_*'s add rsp/sp cleanup, so
         -- pop every open select frame here before leaving the loop body.
         if Current_FASM_Select_Stack_Bytes > 0 then
            declare
               Cleanup_Img : constant String :=
                 Natural'Image (Current_FASM_Select_Stack_Bytes);
               Cleanup_Str : constant String :=
                 Cleanup_Img (Cleanup_Img'First + 1 .. Cleanup_Img'Last);
            begin
               if Target = Backend_FASM16 then
                  Transpiler_Native_HAL.Emit_Raw
                    ("  add sp, " & Cleanup_Str, Success);
               else
                  Transpiler_Native_HAL.Emit_Raw
                    ("  add rsp, " & Cleanup_Str, Success);
               end if;
               Transpiler_Native_HAL.Emit_Newline (Success);
            end;
         end if;

         Transpiler_Native_HAL.Emit_Raw ("  jmp ", Success);

         if Use_Continue then
            Transpiler_Native_HAL.Emit_Raw
              (Loop_Label_Stack (Loop_Label_Depth).Continue_Label
                 (1 .. Loop_Label_Stack (Loop_Label_Depth).Continue_Len),
               Success);
         else
            Transpiler_Native_HAL.Emit_Raw
              (Loop_Label_Stack (Loop_Label_Depth).Break_Label
                 (1 .. Loop_Label_Stack (Loop_Label_Depth).Break_Len),
               Success);
         end if;

         Transpiler_Native_HAL.Emit_Newline (Success);
      end Emit_FASM_Loop_Jump;

      procedure Mark_Native_Graphics_Use
        (Origin : in Node_Index)
      is
      begin
         if Target = Backend_FASM or else Target = Backend_FASM16 then
            Native_Uses_Graphics := True;
            if First_Graphics_Node = 0 then
               First_Graphics_Node := Origin;
            end if;
         end if;
      end Mark_Native_Graphics_Use;

      ALB_SIM_Inject_Code_Used   : Boolean := False;
      ALB_SIM_Hijack_Memory_Used : Boolean := False;
      ALB_SIM_Hack_Memory_Used   : Boolean := False;
      ALB_SIM_Sniff_Network_Used : Boolean := False;



      procedure Walk_AST
        (Node    : in Node_Index;
         Depth   : in Natural;
         Out_Tag : out ALB_Type_Tag;
         Success : in out Boolean;
         Diag    : in out Compiler_Diagnostic)
      --  is
      --     Left_Tag, Right_Tag : ALB_Type_Tag := Type_None;
        --  begin
          is
           Left_Tag, Right_Tag : ALB_Type_Tag := Type_None;

          -- FALLBACK trap helper: emit conditional jcc to fallback if armed, else hard trap.
          procedure Emit_Fallback_Or_Trap (Cond : in String; Trap_Label : in String) is
             Idx : constant Natural := Fallback_Depth;
          begin
             if Idx > 0 and then Fallback_Label_Len (Idx) > 0 then
                Transpiler_Native_HAL.Emit_Raw ("  " & Cond & " ", Success);
                Transpiler_Native_HAL.Emit_Raw (Fallback_Label_Stack (Idx) (1 .. Fallback_Label_Len (Idx)), Success);
                Transpiler_Native_HAL.Emit_Newline (Success);
             else
                Transpiler_Native_HAL.Emit_Raw ("  " & Cond & " ", Success);
                Transpiler_Native_HAL.Emit_Raw (Trap_Label, Success);
                Transpiler_Native_HAL.Emit_Newline (Success);
             end if;
          end Emit_Fallback_Or_Trap;

          procedure Emit_FASM_Expr_To_RAX
           (Expr_Node     : in Node_Index;
            Force_Address : in Boolean := False)
         is
            Dummy_Tag : ALB_Type_Tag := Type_None;
         begin
            if Expr_Node = 0 then
               Transpiler_Native_HAL.Emit_Raw ("  xor rax, rax", Success);
               Transpiler_Native_HAL.Emit_Newline (Success);

            elsif Force_Address
              and then Tree (Expr_Node).Kind = AST_Var_Expr
              and then Tree (Expr_Node).Left_Child = 0
            then
               declare
                  Tok        : Token := Tokens (Tree (Expr_Node).Token_Index);
                  Lexeme     : String := Input_Buffer (Tok.Start .. Tok.Start + Tok.Length - 1);
                  Target_Lex : constant String := Scoped_Lexeme (Lexeme);
               begin
                  Transpiler_Native_HAL.Emit_Raw ("  lea rax, [", Success);
                  Transpiler_Native_HAL.Emit_Raw (Target_Lex, Success);
                  Transpiler_Native_HAL.Emit_Raw ("]", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);
               end;

            else
               Walk_AST (Expr_Node, Depth + 1, Dummy_Tag, Success, Diag);
            end if;
         end Emit_FASM_Expr_To_RAX;

         function FASM_Pure_Num_Arg
           (Expr_Node : Node_Index) return Node_Index
         is
            Target_Node : Node_Index := 0;
            Arg_Node    : Node_Index := 0;
         begin
            if Expr_Node = 0 or else Tree (Expr_Node).Kind /= AST_Func_Call then
               return 0;
            end if;

            Target_Node := Tree (Expr_Node).Left_Child;
            Arg_Node := Tree (Expr_Node).Right_Child;

            if Target_Node = 0 or else Tree (Target_Node).Kind /= AST_Var_Expr then
               return 0;
            end if;

            declare
               Tok : constant Token := Tokens (Tree (Target_Node).Token_Index);
               Lex : constant String := Input_Buffer (Tok.Start .. Tok.Start + Tok.Length - 1);
            begin
               if Lex /= "PURE_NUM" then
                  return 0;
               end if;
            end;

            if Arg_Node > 0 and then Tree (Arg_Node).Kind = AST_Arg_List then
               Arg_Node := Tree (Arg_Node).Left_Child;
            end if;

            return Arg_Node;
         end FASM_Pure_Num_Arg;

         procedure Emit_FASM_Pure_Value_From_RAX is
         begin
            -- Graphics coordinates need the integer value of a PURE,
            -- not the raw numerator field from the packed fraction.
            Transpiler_Native_HAL.Emit_Raw ("  mov r10, rax", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            Transpiler_Native_HAL.Emit_Raw ("  sar r10, 32", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            Transpiler_Native_HAL.Emit_Raw ("  mov ecx, eax", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
             Transpiler_Native_HAL.Emit_Raw ("  test rcx, rcx", Success);
             Transpiler_Native_HAL.Emit_Newline (Success);
             Emit_Fallback_Or_Trap ("jz", "ALB_Runtime_Trap_DivZero");
             Transpiler_Native_HAL.Emit_Raw ("  mov rax, r10", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            Transpiler_Native_HAL.Emit_Raw ("  cqo", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            Transpiler_Native_HAL.Emit_Raw ("  idiv rcx", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
         end Emit_FASM_Pure_Value_From_RAX;

         procedure Emit_FASM_Graphics_Expr_To_RAX
           (Expr_Node : in Node_Index)
         is
            Pure_Node : Node_Index := 0;
         begin
            if Expr_Node > 0 and then Infer_Type_Tag (Expr_Node) = Type_Pure then
               Pure_Node := Expr_Node;
            else
               Pure_Node := FASM_Pure_Num_Arg (Expr_Node);
               if Pure_Node > 0 and then Infer_Type_Tag (Pure_Node) /= Type_Pure then
                  Pure_Node := 0;
               end if;
            end if;

            if Pure_Node > 0 then
               Emit_FASM_Expr_To_RAX (Pure_Node);
               if not Success then
                  return;
               end if;
               Emit_FASM_Pure_Value_From_RAX;
            else
               Emit_FASM_Expr_To_RAX (Expr_Node);
            end if;
         end Emit_FASM_Graphics_Expr_To_RAX;

         procedure Emit_FASM16_Pure_Value_From_DXAX is
         begin
            -- Graphics coordinates need the integer value of a PURE,
            -- not the raw numerator half returned by PURE_NUM.
            Transpiler_Native_HAL.Emit_Raw ("  mov bx, ax", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            Transpiler_Native_HAL.Emit_Raw ("  or bx, bx", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            Transpiler_Native_HAL.Emit_Raw ("  jz ALB16_Runtime_DivZero", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            Transpiler_Native_HAL.Emit_Raw ("  mov ax, dx", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            Transpiler_Native_HAL.Emit_Raw ("  cwd", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            Transpiler_Native_HAL.Emit_Raw ("  idiv bx", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            Transpiler_Native_HAL.Emit_Raw ("  cwd", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
         end Emit_FASM16_Pure_Value_From_DXAX;

         procedure Emit_FASM16_Graphics_Expr_To_DXAX
           (Expr_Node : in Node_Index)
         is
            Pure_Node : Node_Index := 0;
         begin
            if Expr_Node > 0 and then Infer_Type_Tag (Expr_Node) = Type_Pure then
               Pure_Node := Expr_Node;
            else
               Pure_Node := FASM_Pure_Num_Arg (Expr_Node);
               if Pure_Node > 0 and then Infer_Type_Tag (Pure_Node) /= Type_Pure then
                  Pure_Node := 0;
               end if;
            end if;

            if Pure_Node > 0 then
               Walk_AST (Pure_Node, Depth + 1, Right_Tag, Success, Diag);
               if not Success or else not Diag.Success then
                  return;
               end if;
               Emit_FASM16_Pure_Value_From_DXAX;
            else
               Walk_AST (Expr_Node, Depth + 1, Right_Tag, Success, Diag);
            end if;
         end Emit_FASM16_Graphics_Expr_To_DXAX;

         procedure Emit_FASM16_Long_Trap_Jcc
           (Cond : in String;
            Trap : in String);
         
         procedure Emit_FASM_Index_Bounds_Check
           (Dim_Bound : in Natural)
         is
         begin
            if Dim_Bound = 0 then
               return;
            end if;

            -- RAX contains a source-level 1-based index.
            Transpiler_Native_HAL.Emit_Raw ("  test rax, rax", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            Emit_Fallback_Or_Trap ("jz", "ALB_Runtime_Trap_Bounds");

             Transpiler_Native_HAL.Emit_Raw ("  cmp rax, ", Success);
             Transpiler_Native_HAL.Emit_Literal_U64 (U64 (Dim_Bound), Success);
             Transpiler_Native_HAL.Emit_Newline (Success);
             Emit_Fallback_Or_Trap ("ja", "ALB_Runtime_Trap_Bounds");
            Transpiler_Native_HAL.Emit_Newline (Success);
         end Emit_FASM_Index_Bounds_Check;
         
         procedure Emit_FASM16_Range_Check_AX
           (Range_ID : in Natural)
         is
         begin
            if Range_ID = 0 or else Range_ID > Range_Type_Count then
               return;
            end if;

            if Range_Types (Range_ID).Is_String_Length then
               return;
            end if;

            Transpiler_Native_HAL.Emit_Raw ("  cmp ax, ", Success);
            Transpiler_Native_HAL.Emit_Literal_U64 (Range_Types (Range_ID).Low_Value, Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            Emit_FASM16_Long_Trap_Jcc ("jb", "ALB16_Runtime_Range");

            Transpiler_Native_HAL.Emit_Raw ("  cmp ax, ", Success);
            Transpiler_Native_HAL.Emit_Literal_U64 (Range_Types (Range_ID).High_Value, Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            Emit_FASM16_Long_Trap_Jcc ("ja", "ALB16_Runtime_Range");
         end Emit_FASM16_Range_Check_AX;
         
         
