                         Emit_Global_Line ("static uint64_t ALB_INI_Load(uint64_t path_u64) {");
                         Emit_Global_Line ("    const char* path = (const char*)(uintptr_t)path_u64;");
                         Emit_Global_Line ("    FILE* fp = fopen(path, ""rb"");");
                         Emit_Global_Line ("    if (!fp) { fprintf(stderr, ""[INI] FAIL stage=1\n""); return 0; }");
                         Emit_Global_Line ("    size_t n = fread(ALB_INI_Buffer, 1, sizeof(ALB_INI_Buffer)-1, fp);");
