procedure ALBT is
   -- DA UNIVERSAL TARGET STATE
   Target : Target_Backend := Backend_C;
   Max_Path_Len : constant := 512;

   type Native_ASM_Family is
     (ASM_Family_Generic,
      ASM_Family_X64,
      ASM_Family_8086,
      ASM_Family_6502,
      ASM_Family_Unknown);

   type Native_ASM_Mode is
     (ASM_Mode_Off,
      ASM_Mode_Active,
      ASM_Mode_Ignored);

   --Input_Buffer : String (1 .. 4194304) := (others => ' '); -- changed frae 65536 tae 4194304
   Input_Len    : Natural := 0;

   Mem_Success  : Boolean := False;
   Emit_Success : Boolean := False;

   --Tokens      : Token_Array;
   Token_Count : Natural := 0;
   Lex_Diag    : Lexer_Diagnostic;
   
   Has_On_Tick  : Boolean := False;
   Has_On_Paint : Boolean := False;
   Has_On_Event : Boolean := False;
   Has_Create_Window    : Boolean := False;
   Has_Listen           : Boolean := False;
   Native_Uses_Graphics : Boolean := False;
   First_Graphics_Node  : Node_Index := 0;
   FASM16_Uses_Graphics : Boolean := False;
   FASM16_Uses_Mouse    : Boolean := False;
   
   Native_ASM_State : Native_ASM_Mode := ASM_Mode_Off;
   Reversible_Depth : Natural := 0;

   -- SHARED CONTROL LAYER: Fallback / Mode Stack (max nesting 32, no heap)
   Max_Mode_Nesting : constant := 32;

   Fallback_Depth       : Natural := 0;
   Fallback_Label_Stack : array (1 .. Max_Mode_Nesting) of String (1 .. 64) := (others => (others => ' '));
   Fallback_Label_Len   : array (1 .. Max_Mode_Nesting) of Natural := (others => 0);
   Fallback_Code_Stack  : array (1 .. Max_Mode_Nesting) of Natural := (others => 0);

   Exact_Depth     : Natural := 0;
   Symbolic_Depth  : Natural := 0;
   Stride_Depth    : Natural := 0;
   Ratio_Pin_Depth : Natural := 0;

   -- Task 1C (C): emit the __RATIO_4__..__RATIO_7__ globals exactly
   -- once across the whole compilation, even when multiple RATIO_SPACE
   -- blocks share the file.  C would reject a duplicate
   -- `static double __RATIO_4__ = 0.0;` at file scope.
   Ratio_Globals_Emitted_C : Boolean := False;

   -- Task 1E (C): emit the C INI runtime (ALB_INI_Load, ALB_INI_Parse,
   -- ALB_INI_Buffer, ALB_INI_Field struct, ...) exactly once at the top
   -- of the generated .c on the first INI_BIND encountered.
   Ini_Runtime_Emitted_C : Boolean := False;

   -- Track 2 (C): emit ALB_FITS_Load_Cube exactly once at the top of
   -- the generated .c on the first FITS_CUBE encountered.
   Fits_Runtime_Emitted_C : Boolean := False;

   -- Track 5 (C): emit the raw-socket sniffer runtime (ALB_NET_Sniff_Run,
   -- ALB_SNIFF_Result_C, ALB_SNIFF_Last_Error_C, per-sniffer interface
   -- buffers) exactly once on first NETWORK_SNIFFER / NETWORK_SNIFF.
   Sniffer_Runtime_Emitted_C : Boolean := False;

   -- Track 5 (C): emit `ALB_SNIFFCFG_<name>_Interface_C` exactly once per
   -- distinct sniffer name. List of names already emitted.
   Sniffer_Cfg_Emitted_Count : Natural := 0;
   type Sniffer_Cfg_Name_Slot is record
      Used : Boolean := False;
      Name : String (1 .. 128) := (others => ' ');
      Len  : Natural := 0;
   end record;
   Sniffer_Cfg_Names : array (1 .. 64) of Sniffer_Cfg_Name_Slot :=
     (others => (Used => False, Name => (others => ' '), Len => 0));

   -- Track 6 (C): emit firewall enforcement runtime once on first MEMORY_FIREWALL.
   Firewall_Runtime_Emitted_C : Boolean := False;

   -- Track 7 (C): emit INJECT / safe-process runtime once on first
   -- INJECT or OPEN_PROCESS encountered.
   Process_Runtime_Emitted_C : Boolean := False;

   -- Track 8 (C): accumulate FASM-formatted inline ASM payloads in a
   -- side buffer.  After C output is flushed, we drop these into
   -- "<basename>_asm.asm" so the build script can assemble + link.
   ASM_Side_Used_C   : Boolean := False;
   ASM_Side_Buffer_C : String (1 .. 2 ** 19) := (others => ' ');
   ASM_Side_Len_C    : Natural := 0;
   ASM_Block_Counter_C : Natural := 0;

   -- Task B3: PIPE-AS-CONCAT diagnostic.
   -- Set > 0 while walking the RHS of a LET / assignment whose declared LHS
   -- type is an integer scalar.  AST_BinOp uses this together with the
   -- inferred operand types and the operator glyph to decide whether to
   -- emit a "PIPE-AS-CONCAT WARNING" (likely bitwise-OR confusion).
   Numeric_Assign_Depth : Natural := 0;
   Pipe_Warn_Count      : Natural := 0;

   -- Task A2: STRIDE width binding. Each entry holds the FASM data label
   -- (e.g. "ALB_Stride_Width_18236") that stores the active stride width
   -- for the FOR loops nested inside its block. Pushed by AST_Stride_Block,
   -- read by AST_For_Stmt when no explicit STEP clause is present, popped
   -- on block exit.
   Stride_Width_Label_Stack :
     array (1 .. Max_Mode_Nesting) of String (1 .. 64) :=
       (others => (others => ' '));
   Stride_Width_Label_Len :
     array (1 .. Max_Mode_Nesting) of Natural := (others => 0);

   --Tree          : Node_Array;
   Root          : Node_Index := 0;
   Parse_Success : Boolean := False;
   Parse_Diag    : Parser_Diagnostic;

   -- DA COMMAND LINE PARSING VAULT
   Input_File        : String (1 .. Max_Path_Len) := (others => ' ');
   Input_Flen        : Natural := 0;
   Output_File       : String (1 .. Max_Path_Len) := (others => ' ');
   Output_Flen       : Natural := 0;
   Out_Dir           : String (1 .. Max_Path_Len) := (others => ' ');
   Out_Dir_Len       : Natural := 0;
   Final_Dir         : String (1 .. Max_Path_Len) := (others => ' ');
   Final_Dir_Len     : Natural := 0;
   Skip_Next         : Boolean := False;
   Metrics_Requested : Boolean := False;
   Build_Mode        : Boolean := False;
   Compilation_Succeeded : Boolean := False;
   Prune_Dead_Mode       : Boolean := False;
   Prune_Dead_Verbose    : Boolean := False;
   Embed_Assets_Mode     : Boolean := False;
   Embed_Blackbox_Mode   : Boolean := False;
   FASM_DLL_Mode_Requested : Boolean := False;
   FASM_DLL_Mode_Active    : Boolean := False;
   C_Shared_Library_Mode_Active : Boolean := False;
   Safe_Process_Runtime_Used : Boolean := False;
   Static_Graphics_Runtime_Used : Boolean := False;
   Archive_Runtime_Used     : Boolean := False;
   INI_Runtime_Used         : Boolean := False;
   FITS_Runtime_Used        : Boolean := False;
   -- Compile-time RHI backend: remaps IMPORT_DLL "alb_gfx.dll" -> alb_gfx_<backend>.dll
   Gfx_Backend_Name         : String (1 .. 32) := (others => ' ');
   Gfx_Backend_Len          : Natural := 0;
   Gfx_Runtime_Used         : Boolean := False;

   Stream_Bypass_Runtime_Used : Boolean := False;
   Shoebox_Path        : String (1 .. Max_Path_Len) := (others => ' ');
   Shoebox_Path_Len    : Natural := 0;
   Shoebox_Active      : Boolean := False;
   FASM16_Format     : Emit_Native_FASM16.FASM16_Output_Format :=
     Emit_Native_FASM16.Format_MZ_EXE;
   FASM16_Format_Set : Boolean := False;
   
   -- DA MODULE SCOPE VAULT
   Active_Module_Name : String (1 .. 64) := (others => ' ');
   Active_Module_Len  : Natural := 0;

   -- =========================================================================
   -- BUILD LOG SYSTEM
   -- =========================================================================
   Log_File     : Ada.Text_IO.File_Type;
   Log_Opened   : Boolean := False;
   Quiet_Mode   : Boolean := False;

   procedure Log (Msg : String) is
   begin
      if Log_Opened then
         Ada.Text_IO.Put_Line (Log_File, Msg);
      end if;
      if not Quiet_Mode then
         Ada.Text_IO.Put_Line (Msg);
      end if;
   end Log;

   procedure Open_Log (Dir : String) is
      Log_Path : constant String :=
        (if Dir'Length = 0
         then "build_albt.log"
         else Ada.Directories.Compose (Dir, "build_albt.log"));
   begin
      Ada.Text_IO.Create (Log_File, Ada.Text_IO.Out_File, Log_Path);
      Log_Opened := True;
   exception
      when others =>
         Log_Opened := False;
   end Open_Log;

   procedure Close_Log is
   begin
      if Log_Opened then
         Ada.Text_IO.Close (Log_File);
         Log_Opened := False;
      end if;
   end Close_Log;

   function Parent_Directory (Path : String) return String is
   begin
      for I in reverse Path'Range loop
         if Path (I) = '\' or else Path (I) = '/' then
            return Path (Path'First .. I - 1);
         end if;
      end loop;
      return "";
   end Parent_Directory;

   function File_Name_With_Extension (Path : String) return String is
   begin
      for I in reverse Path'Range loop
         if Path (I) = '\' or else Path (I) = '/' then
            if I < Path'Last then
               return Path (I + 1 .. Path'Last);
            else
               return "output.txt";
            end if;
         end if;
      end loop;
      return Path;
   end File_Name_With_Extension;

   function Base_Name (Path : String) return String is
   begin
      if Path'Length = 0 then
         return "payload";
      end if;

      declare
         Raw : constant String := Ada.Directories.Base_Name (Path);
         Dot : Natural := 0;
      begin
         for I in reverse Raw'Range loop
            if Raw (I) = '.' then
               Dot := I;
               exit;
            end if;
         end loop;

         if Dot > Raw'First then
            return Raw (Raw'First .. Dot - 1);
         end if;

         return Raw;
      end;
   exception
      when others =>
         return "payload";
   end Base_Name;

   function Is_Absolute_Path (Path : String) return Boolean is
   begin
      if Path'Length = 0 then
         return False;
      end if;

      if Path (Path'First) = '\' or else Path (Path'First) = '/' then
         return True;
      end if;

      return Path'Length >= 2 and then Path (Path'First + 1) = ':';
   end Is_Absolute_Path;

   function Fold_Lower (S : String) return String is
      R : String (S'Range);
   begin
      for I in S'Range loop
         if S (I) in 'A' .. 'Z' then
            R (I) := Character'Val (Character'Pos (S (I)) + 32);
         else
            R (I) := S (I);
         end if;
      end loop;
      return R;
   end Fold_Lower;

   function ALB_SDK_Root return String is
      Env_Root : constant String :=
        (if Ada.Environment_Variables.Exists ("ALB_SDK_ROOT")
         then Ada.Environment_Variables.Value ("ALB_SDK_ROOT")
         else "");
      Cmd_Dir  : constant String := Parent_Directory (Ada.Command_Line.Command_Name);
      Raw_Root : constant String :=
        (if Cmd_Dir'Length > 0 then Parent_Directory (Cmd_Dir) else "");
      Release_Root : constant String :=
        (if Raw_Root'Length > 0
         then Ada.Directories.Compose (Raw_Root, "release")
         else "");
   begin
      if Env_Root'Length > 0 and then Ada.Directories.Exists (Env_Root) then
         return Env_Root;
      end if;
      if Raw_Root'Length > 0
        and then Ada.Directories.Exists
          (Ada.Directories.Compose (Raw_Root, "deps"))
      then
         return Raw_Root;
      end if;
      if Release_Root'Length > 0
        and then Ada.Directories.Exists
          (Ada.Directories.Compose (Release_Root, "deps"))
      then
         return Release_Root;
      end if;
      if Raw_Root'Length > 0 then
         return Raw_Root;
      end if;
      return Ada.Directories.Current_Directory;
   exception
      when others =>
         return Ada.Directories.Current_Directory;
   end ALB_SDK_Root;

   function Vendor_Root return String is
      Root : constant String := ALB_SDK_Root;
      V1   : constant String :=
        Ada.Directories.Compose
          (Ada.Directories.Compose (Root, "stdlib"), "vendor");
      V2   : constant String :=
        Ada.Directories.Compose
          (Ada.Directories.Compose
             (Ada.Directories.Compose (Root, "src"), "stdlib"),
           "vendor");
      V3   : constant String :=
        Ada.Directories.Compose
          (Ada.Directories.Compose
             (Ada.Directories.Compose (Root, "release"), "stdlib"),
           "vendor");
   begin
      if Ada.Directories.Exists (V1) then
         return V1;
      elsif Ada.Directories.Exists (V2) then
         return V2;
      elsif Ada.Directories.Exists (V3) then
         return V3;
      else
         return V1;
      end if;
   end Vendor_Root;

   function Leaf_Stem (Leaf : String) return String is
   begin
      for I in reverse Leaf'Range loop
         if Leaf (I) = '.' then
            if I > Leaf'First then
               return Leaf (Leaf'First .. I - 1);
            end if;
            exit;
         elsif Leaf (I) = '\' or else Leaf (I) = '/' then
            exit;
         end if;
      end loop;
      return Leaf;
   end Leaf_Stem;

   function Resolve_System_Include (Leaf : String) return String is
      Vendor : constant String := Vendor_Root;
      Direct : constant String := Ada.Directories.Compose (Vendor, Leaf);
      Stem   : constant String := Leaf_Stem (Leaf);
      Nested : constant String :=
        Ada.Directories.Compose
          (Ada.Directories.Compose (Vendor, Stem), Leaf);
      Search : Ada.Directories.Search_Type;
      Ent    : Ada.Directories.Directory_Entry_Type;
      Filter : constant Ada.Directories.Filter_Type :=
        (Ada.Directories.Directory => True, others => False);
   begin
      if Leaf'Length = 0 then
         return Leaf;
      end if;
      if Ada.Directories.Exists (Direct) then
         return Direct;
      end if;
      if Ada.Directories.Exists (Nested) then
         return Nested;
      end if;
      if Ada.Directories.Exists (Vendor) then
         begin
            Ada.Directories.Start_Search (Search, Vendor, "", Filter);
            while Ada.Directories.More_Entries (Search) loop
               Ada.Directories.Get_Next_Entry (Search, Ent);
               declare
                  Cand : constant String :=
                    Ada.Directories.Compose
                      (Ada.Directories.Full_Name (Ent), Leaf);
               begin
                  if Ada.Directories.Exists (Cand) then
                     Ada.Directories.End_Search (Search);
                     return Cand;
                  end if;
               end;
            end loop;
            Ada.Directories.End_Search (Search);
         exception
            when others =>
               null;
         end;
      end if;
      return Leaf;
   end Resolve_System_Include;

   function Remap_Gfx_Library (Lib : String) return String is
      Simple : constant String := Ada.Directories.Simple_Name (Lib);
      Low    : constant String := Fold_Lower (Simple);
   begin
      if Low = "alb_gfx.dll" and then Gfx_Backend_Len > 0 then
         Gfx_Runtime_Used := True;
         return "alb_gfx_" & Gfx_Backend_Name (1 .. Gfx_Backend_Len) & ".dll";
      elsif Low'Length >= 8
        and then Low (Low'First .. Low'First + 7) = "alb_gfx_"
      then
         Gfx_Runtime_Used := True;
      elsif Low = "alb_gfx.dll" then
         Gfx_Runtime_Used := True;
      end if;
      return Simple;
   end Remap_Gfx_Library;

   function Resolve_Vendor_Dll (Lib : String) return String is
      Mapped : constant String := Remap_Gfx_Library (Lib);
      Vendor : constant String := Vendor_Root;
      Gfx_Bin : constant String :=
        Ada.Directories.Compose
          (Ada.Directories.Compose
             (Ada.Directories.Compose (Vendor, "alb_gfx"), "bin"),
           Mapped);
      function Normalize_Slashes (Path : String) return String is
         Result : String (1 .. Path'Length);
      begin
         for I in Path'Range loop
            Result (I - Path'First + 1) :=
              (if Path (I) = '\' then '/' else Path (I));
         end loop;
         return Result;
      end Normalize_Slashes;
   begin
      if Mapped'Length = 0 then
         return Mapped;
      end if;
      if Ada.Directories.Exists (Mapped) then
         return Normalize_Slashes (Mapped);
      end if;
      if Ada.Directories.Exists (Gfx_Bin) then
         return Normalize_Slashes (Gfx_Bin);
      end if;
      declare
         Stem : constant String := Leaf_Stem (Mapped);
         Nested : constant String :=
           Ada.Directories.Compose
             (Ada.Directories.Compose
                (Ada.Directories.Compose (Vendor, Stem), "bin"),
              Mapped);
      begin
         if Ada.Directories.Exists (Nested) then
            return Normalize_Slashes (Nested);
         end if;
      end;
      return Mapped;
   end Resolve_Vendor_Dll;

   function Default_Output_Name (Input : String) return String is
   begin
      case Target is
         when Backend_C =>
            return Base_Name (Input) & ".c";
         when Backend_Ada =>
            return Base_Name (Input) & ".adb";
         when Backend_FASM | Backend_FASM16 | Backend_6502 | Backend_Z80 | Backend_8086 =>
            return Base_Name (Input) & ".asm";
         when Backend_Java =>
            return Base_Name (Input) & ".java";
         when Backend_Rust =>
            return Base_Name (Input) & ".rs";
         when Backend_Zig =>
            return Base_Name (Input) & ".zig";
         when Backend_PureBasic =>
            return Base_Name (Input) & ".pb";
         when Backend_AGK =>
            return Base_Name (Input) & ".agc";
         when Backend_GLBasic =>
            return Base_Name (Input) & ".gbas";
         when Backend_Hollywood =>
            return Base_Name (Input) & ".hws";
         when Backend_CSharp =>
            return Base_Name (Input) & ".cs";
         when Backend_COBOL =>
            return Base_Name (Input) & ".cbl";
         when Backend_StructuredText =>
            return Base_Name (Input) & ".st";
         when Backend_Verilog =>
            return Base_Name (Input) & ".v";
         when Backend_ComputeShaders =>
            return Base_Name (Input) & ".glsl";
         when Backend_Forth =>
            return Base_Name (Input) & ".fs";
         when Backend_Factor =>
            return Base_Name (Input) & ".factor";
         when Backend_Raptor =>
            return Base_Name (Input) & ".rap";
         when Backend_Brainfuck =>
            return Base_Name (Input) & ".bf";
         when Backend_WASM =>
            return Base_Name (Input) & ".wat";
      end case;
   end Default_Output_Name;

