   procedure Parse_Decimal (Str : in String; Val : out U64; Success : out Boolean) is
      Temp       : U64 := 0;
      Negative   : Boolean := False;
      Seen_Sign  : Boolean := False;
      Seen_Digit : Boolean := False;
   begin
      Success := True;

      for I in Str'Range loop
         if Str (I) = ' '
           or else Str (I) = ASCII.HT
           or else Str (I) = ASCII.LF
           or else Str (I) = ASCII.CR
         then
            null;
         elsif Str (I) = '_' then
            null;
         elsif Str (I) = '-' and then not Seen_Sign and then not Seen_Digit then
            Negative := True;
            Seen_Sign := True;
         elsif Str (I) = '+' and then not Seen_Sign and then not Seen_Digit then
            Seen_Sign := True;
         elsif Str (I) in '0' .. '9' then
            Seen_Digit := True;
            Temp := Temp * 10 + U64 (Character'Pos (Str (I)) - Character'Pos ('0'));
         else
            Success := False;
            return;
         end if;
      end loop;

      if not Seen_Digit then
         Success := False;
         return;
      end if;

      if Negative then
         Val := 0 - Temp;
      else
         Val := Temp;
      end if;
   end Parse_Decimal;


   procedure Parse_Hex (Str : in String; Val : out U64; Success : out Boolean) is
      Temp : U64 := 0;
      C : Character;
   begin
      Success := True;
      for I in Str'Range loop
         C := Str (I);
         if C = '$' or C = '_' then null;
         elsif C in '0' .. '9' then Temp := Temp * 16 + U64 (Character'Pos (C) - Character'Pos ('0'));
         elsif C in 'A' .. 'F' then Temp := Temp * 16 + U64 (Character'Pos (C) - Character'Pos ('A') + 10);
         elsif C in 'a' .. 'f' then Temp := Temp * 16 + U64 (Character'Pos (C) - Character'Pos ('a') + 10);
         else Success := False; return; end if;
      end loop;
      Val := Temp;
   end Parse_Hex;
   
   procedure Parse_Octal (Str : in String; Val : out U64; Success : out Boolean) is
      Temp : U64 := 0;
   begin
      Success := True;
      for I in Str'Range loop
         if Str (I) = '&' or Str (I) = 'O' or Str (I) = 'o' or Str (I) = '_' then null;
         elsif Str (I) in '0' .. '7' then Temp := Temp * 8 + U64 (Character'Pos (Str (I)) - Character'Pos ('0'));
         else Success := False; return; end if;
      end loop;
      Val := Temp;
   end Parse_Octal;

   procedure Parse_Binary (Str : in String; Val : out U64; Success : out Boolean) is
      Temp : U64 := 0;
   begin
      Success := True;
      for I in Str'Range loop
         if Str (I) = '%' or Str (I) = '_' then null;
         elsif Str (I) = '0' then Temp := Temp * 2;
         elsif Str (I) = '1' then Temp := Temp * 2 + 1;
         else Success := False; return; end if;
      end loop;
      Val := Temp;
   end Parse_Binary;
   
   -- =========================================================================
   -- DA TYPE ORACLE (Inference Engine)
   -- =========================================================================
   function Infer_Type_Tag (Idx : Node_Index) return ALB_Type_Tag is
      N : AST_Node;
      Sym : Symbol_Record;
      Found : Boolean;
   begin
      if Idx = 0 then return Type_None; end if;
      N := Tree(Idx);
      
      case N.Kind is
         when AST_Number_Expr =>
            if Is_Real_Number_Text (Raw_Lexeme (Tree (Idx).Token_Index)) then
               return Type_F64;
            elsif Raw_Lexeme (Tree (Idx).Token_Index)'Length > 0
              and then Raw_Lexeme (Tree (Idx).Token_Index)
                (Raw_Lexeme (Tree (Idx).Token_Index)'First) = '-'
            then
               return Type_S32;
            end if;
            return Type_U64;

         when AST_Hex_Expr 
            | AST_Bin_Expr 
            | AST_Octal_Expr =>
            return Type_U64;

         when AST_SYS_RENDERER
            | AST_READ_PIXEL
            | AST_Rnd_Expr =>
            if Target = Backend_FASM16 then
               return Type_U32;
            else
               return Type_U64;
            end if;

         when AST_Inline_Asm_Expr | AST_Inline_C_Expr =>
            if Target = Backend_FASM16 then
               return Type_U32;
            else
               return Type_U64;
            end if;

         when AST_AddressOf | AST_Ref_Expr =>
            if Target = Backend_FASM16 then
               return Type_U16;
            else
               return Type_U64;
            end if;

         when AST_File_Open | AST_File_Len | AST_File_Seek =>
            if Target = Backend_FASM16 then
               return Type_U16;
            else
               return Type_U64;
            end if;

         when AST_File_Read =>
            return Type_Binary;

         when AST_Peek_Expr | AST_Deref_Expr =>
            if Target = Backend_FASM16 then
               if N.Left_Child > 0
                 and then Tree (N.Left_Child).Kind in AST_AddressOf | AST_Ref_Expr
               then
                  declare
                     Target_Node : constant Node_Index := Tree (N.Left_Child).Left_Child;
                  begin
                     if Target_Node > 0 and then Tree (Target_Node).Kind = AST_Var_Expr then
                        declare
                           Tok        : Token := Tokens (Tree (Target_Node).Token_Index);
                           Lex        : String := Input_Buffer (Tok.Start .. Tok.Start + Tok.Length - 1);
                           Target_Lex : constant String := Scoped_Lexeme (Lex);
                        begin
                           Find_Symbol (Hash_String (Target_Lex), Current_Scope, Found, Sym);

                           if not Found then
                              Find_Symbol (Hash_String (Lex), Current_Scope, Found, Sym);
                           end if;

                           if Found then
                              return Sym.Tag;
                           end if;
                        end;

                     elsif Target_Node > 0
                       and then Tree (Target_Node).Kind = AST_Member_Expr
                     then
                       return Infer_Type_Tag (Target_Node);
                     end if;
                  end;
               elsif N.Left_Child > 0
                 and then Tree (N.Left_Child).Kind = AST_Var_Expr
               then
                  declare
                     Tok        : Token := Tokens (Tree (N.Left_Child).Token_Index);
                     Lex        : String := Input_Buffer (Tok.Start .. Tok.Start + Tok.Length - 1);
                     Target_Lex : constant String := Scoped_Lexeme (Lex);
                     Ptr_Tag    : constant ALB_Type_Tag :=
                       Find_FASM16_Pointer_Meta (Target_Lex, Current_Scope);
                  begin
                     if Ptr_Tag /= Type_None then
                        return Ptr_Tag;
                     end if;
                  end;
               end if;

               return Type_U16;
            else
               return Type_U64;
            end if;

         -- Logic query expressions are truth-values, except FIND which returns
         -- the located bound value.
         when AST_Query
            | AST_Knows_Query =>
            return Type_Boolean;

         when AST_Find_Query =>
            if Target = Backend_FASM16 then
               return Type_U32;
            else
               return Type_U64;
            end if;
            
         when AST_String_Expr => 
            return Type_Binary; 
            
         when AST_Str_Len =>
            if Target = Backend_FASM16 then
               return Type_U32;
            else
               return Type_U64;
            end if;

         when AST_Str_Left | AST_Str_Right | AST_Str_Mid | AST_Str_Concat =>
            return Type_Binary;

            
         when AST_True | AST_False => 
            return Type_Boolean;
            
         when AST_Constructor | AST_Cast_Expr =>
            declare
               Tok : Token := Tokens(N.Token_Index);
               Lex : String := Input_Buffer(Tok.Start .. Tok.Start + Tok.Length - 1);
            begin
               if Lex = "PURE" or else Lex = "RATIONAL" then return Type_Pure;
               elsif Lex = "S8" or else Lex = "I8" or else Lex = "INT8" then return Type_S8;
               elsif Lex = "S16" or else Lex = "I16" or else Lex = "INT16" then return Type_S16;
               elsif Lex = "S32" or else Lex = "I32" or else Lex = "INT32" then return Type_S32;
               elsif Lex = "S64" or else Lex = "I64" or else Lex = "INT64" then return Type_S64;
               elsif Lex = "HW8" then return Type_HW8;
               elsif Lex = "HW16" then return Type_HW16;
               elsif Lex = "HW32" then return Type_HW32;
               elsif Lex = "U8" then return Type_U8;
               elsif Lex = "U16" then return Type_U16;
               elsif Lex = "U32" then return Type_U32;
               elsif Lex = "U64" then return Type_U64;
               elsif Lex = "F32" or else Lex = "SINGLE" then return Type_F32;
               elsif Lex = "F64" or else Lex = "REAL" then return Type_F64;
               else return Type_U64; end if;
            end;
            
         --  when AST_Var_Expr | AST_Call_Stmt | AST_Func_Call =>
         --     declare
         --        Tok : Token := Tokens(N.Token_Index);
         --        Lex : String := Input_Buffer(Tok.Start .. Tok.Start + Tok.Length - 1);
         --     begin
         --        Find_Symbol(Hash_String(Lex), Current_Scope, Found, Sym);
         --        -- DA FIX: If we dinna ken the function (like RND or Module calls), safely default tae U64!
         --        if Found then return Sym.Tag; else return Type_U64; end if;
         --     end;
            
         --  when AST_Var_Expr =>
         --     declare
         --        Tok        : Token := Tokens(N.Token_Index);
         --        Lex        : String := Input_Buffer(Tok.Start .. Tok.Start + Tok.Length - 1);
         --        Target_Lex : constant String := Scoped_Lexeme (Lex);
         --     begin
         --        Find_Symbol(Hash_String(Target_Lex), Current_Scope, Found, Sym);
         --        if Found then return Sym.Tag; else return Type_U64; end if;
         --     end;
         
         when AST_Var_Expr =>
            declare
               Tok        : Token := Tokens(N.Token_Index);
               Lex        : String := Input_Buffer(Tok.Start .. Tok.Start + Tok.Length - 1);
               Target_Lex : constant String := Scoped_Lexeme (Lex);
            begin
               
               if N.Left_Child > 0 then
                  declare
                     R : constant Natural := Find_Range_Array(Target_Lex);
                  begin
                     if R > 0 then
                        return Range_Types(R).Base_Tag;
                     end if;
                  end;
               end if;
               -- 1. Try the fully scoped module name first
               Find_Symbol(Hash_String(Target_Lex), Current_Scope, Found, Sym);
               if Found then 
                  return Sym.Tag; 
               end if;

               -- 2. Fallback: Try the raw lexeme (for local variables and parameters)
               Find_Symbol(Hash_String(Lex), Current_Scope, Found, Sym);
               if Found then 
                  return Sym.Tag; 
               end if;

               -- 3. Universal safety default
               return Type_U64; 
            end;

         --  when AST_Call_Stmt | AST_Func_Call =>
         --     declare
         --        Target_Node : constant Node_Index := N.Left_Child;
         --     begin
         --        if Target_Node > 0 and then Tree(Target_Node).Kind = AST_Var_Expr then
         --           declare
         --              Tok : Token := Tokens(Tree(Target_Node).Token_Index);
         --              Lex : String := Input_Buffer(Tok.Start .. Tok.Start + Tok.Length - 1);
         --           begin
         --              if Lex = "PURE" or else
         --                 Lex = "PURE_ADD" or else
         --                 Lex = "PURE_SUB" or else
         --                 Lex = "PURE_MUL" or else
         --                 Lex = "PURE_DIV" or else
         --                 Lex = "PURE_POW"
         --              then
         --                 return Type_Pure;
         --              elsif Lex = "PURE_NUM" or else Lex = "PURE_DEN" then
         --                 return Type_U64;
         --              end if;
         --           end;
         --        end if;
         --  
         --        return Type_U64;
         --     end;

            
         --  when AST_Call_Stmt | AST_Func_Call =>
         --     declare
         --        Target_Node : constant Node_Index := N.Left_Child;
         --     begin
         --        if Target_Node > 0 and then Tree(Target_Node).Kind = AST_Var_Expr then
         --           declare
         --              Tok : Token := Tokens(Tree(Target_Node).Token_Index);
         --              Lex : String := Input_Buffer(Tok.Start .. Tok.Start + Tok.Length - 1);
         --           begin
         --              if Lex = "PURE" or else
         --                 Lex = "PURE_ADD" or else
         --                 Lex = "PURE_SUB" or else
         --                 Lex = "PURE_MUL" or else
         --                 Lex = "PURE_DIV" or else
         --                 Lex = "PURE_POW"
         --              then
         --                 return Type_Pure;
         --              elsif Lex = "PURE_NUM" or else Lex = "PURE_DEN" then
         --                 return Type_U64;
         --              end if;
         --           end;
         --        end if;
         --  
         --        return Type_U64;
         --     end;
         
         when AST_Call_Stmt | AST_Func_Call =>
            declare
               Target_Node : constant Node_Index := N.Left_Child;
            begin
               if Target_Node > 0 and then Tree(Target_Node).Kind = AST_Var_Expr then
                  declare
                     Tok        : Token := Tokens(Tree(Target_Node).Token_Index);
                     Lex        : String := Input_Buffer(Tok.Start .. Tok.Start + Tok.Length - 1);
                     Target_Lex : constant String := Scoped_Lexeme(Lex);
                  begin
                     if Lex = "|" then
                        return Type_Binary;

                     elsif Lex = "PURE" or else
                        Lex = "RATIONAL" or else
                        Lex = "PURE_ADD" or else
                        Lex = "PURE_SUB" or else
                        Lex = "PURE_MUL" or else
                       Lex = "PURE_DIV" or else
                       Lex = "PURE_POW"
                     then
                        return Type_Pure;

                    elsif Lex = "PURE_NUM"
                    then
                       if Target = Backend_FASM16 then
                          return Type_S32;
                       else
                          return Type_U64;
                       end if;

                    elsif Lex = "PURE_DEN"
                    then
                       if Target = Backend_FASM16 then
                          return Type_S32;
                       else
                          return Type_U64;
                       end if;

                    elsif Lex = "LEN"
                    then
                       if Target = Backend_FASM16 then
                          return Type_U32;
                       else
                          return Type_U64;
                       end if;

                     elsif Lex = "COLLIDE_RECT" or else
                       Lex = "ALB_COLLIDE_RECT"
                     then
                        return Type_U64;

                     elsif Lex = "VIRTUAL_ALLOC"
                       or else Lex = "VIRTUAL_FREE"
                       or else Lex = "VIRTUAL_PROTECT"
                     then
                        return Type_U64;

                     elsif Lex = "LEFT" or else
                      Lex = "RIGHT" or else
                      Lex = "MID" or else
                      Lex = "MID$" or else
                      Lex = "CHR" or else
                      Lex = "CONCAT"
                     then
                        return Type_Binary;

                     elsif Lex = "ASC" then
                        return Type_U64;

                     elsif Lex = "U8" then
                        return Type_U8;

                     elsif Lex = "U16" then
                        return Type_U16;

                     elsif Lex = "U32" then
                        return Type_U32;

                     elsif Lex = "U64" then
                        return Type_U64;

                     elsif Lex = "S8" or else Lex = "I8" or else Lex = "INT8" then
                        return Type_S8;

                     elsif Lex = "S16" or else Lex = "I16" or else Lex = "INT16" then
                        return Type_S16;

                     elsif Lex = "S32" or else Lex = "I32" or else Lex = "INT32" then
                        return Type_S32;

                     elsif Lex = "S64" or else Lex = "I64" or else Lex = "INT64" then
                        return Type_S64;

                     elsif Lex = "HW8" then
                        return Type_HW8;

                     elsif Lex = "HW16" then
                        return Type_HW16;

                     elsif Lex = "HW32" then
                        return Type_HW32;

                     elsif Lex = "BOOLEAN" or else Lex = "BOOL" then
                        return Type_Boolean;

                     elsif Lex = "F64" or else Lex = "REAL" then
                        return Type_F64;

                     -- Built-in transcendental / float math: always F64.
                     -- Missing this made FASM emit cvtsi2sd on SIN/COS results
                     -- (rax already holds IEEE bits), which silently killed
                     -- camera orbits and any SIN(x)*literal mix.
                     elsif Lex = "SIN" or else Lex = "COS"
                       or else Lex = "SQRT" or else Lex = "EXP"
                     then
                        return Type_F64;

                     end if;
                     
                     declare
                        TName : String (1 .. 128) := (others => ' ');
                        TLen  : Natural := 0;
                        ASig  : ALB_Signature;
                     begin
                        Resolve_ALB_Call_Name(Target_Node, TName, TLen);

                        if TLen > 0 and then Find_ALB_Signature(TName(1 .. TLen), ASig) then
                           return ASig.Return_Tag;
                        end if;
                     end;

                     Find_Symbol(Hash_String(Target_Lex), Current_Scope, Found, Sym);
                     if Found then
                        return Sym.Tag;
                     end if;

                     Find_Symbol(Hash_String(Lex), Current_Scope, Found, Sym);
                     if Found then
                        return Sym.Tag;
                     end if;
                  end;

               elsif Target_Node > 0
                 and then Tree(Target_Node).Kind = AST_Member_Expr
               then
                  declare
                     TName : String (1 .. 128) := (others => ' ');
                     TLen  : Natural := 0;
                     ASig  : ALB_Signature;
                  begin
                     Resolve_ALB_Call_Name(Target_Node, TName, TLen);

                     if TLen > 0
                       and then Find_ALB_Signature(TName(1 .. TLen), ASig)
                     then
                        return ASig.Return_Tag;
                     end if;
                  end;
               end if;

               return Type_U64;
            end;


            
         when AST_Member_Expr =>
            declare
               Var_Node   : Node_Index := Tree(Idx).Left_Child;
               Field_Node : Node_Index := Tree(Idx).Right_Child;
               V_Tok      : Token := Tokens(Tree(Var_Node).Token_Index);
               V_Lex      : String := Input_Buffer(V_Tok.Start .. V_Tok.Start+V_Tok.Length-1);
               V_Target   : constant String := Scoped_Lexeme (V_Lex);
               F_Tok      : Token := Tokens(Tree(Field_Node).Token_Index);
               F_Lex      : String := Input_Buffer(F_Tok.Start .. F_Tok.Start+F_Tok.Length-1);
               Backing_Target : constant String := V_Target & "_" & F_Lex;
               Backing_Lex    : constant String := V_Lex & "_" & F_Lex;
               Field      : Struct_Field;
               F_Found    : Boolean;
            begin
               Find_Symbol(Hash_String(V_Target), Current_Scope, Found, Sym);

               if not Found then
                  Find_Symbol(Hash_String(V_Lex), Current_Scope, Found, Sym);
               end if;

               if Found and then Sym.Struct_ID > 0 then
                  Find_Struct_Field(Sym.Struct_ID, Hash_String(F_Lex), F_Found, Field);
                  if F_Found then return Field.Tag; end if;
               end if;

               Find_Symbol(Hash_String(Backing_Target), Current_Scope, Found, Sym);
               if not Found then
                  Find_Symbol(Hash_String(Backing_Lex), Current_Scope, Found, Sym);
               end if;

               if Found then
                  return Sym.Tag;
               end if;

               if Target = Backend_FASM16 then
                  return Type_U16;
               end if;
               return Type_U64; -- Default fallback
            end;
            
         when AST_Simd_Intrinsic =>
            declare
               Tok : Token := Tokens(Tree(Idx).Token_Index);
            begin
               if Tok.Kind = Tok_Dot_Prod then 
                  return Type_F32; -- Dot product returns a scalar!
               else 
                  return Type_F32x4; -- Default fallback for vector math
               end if; 
            end;
            
         when AST_Temporal_Ref =>
            declare
               Sel_Tok : Token := Tokens (N.Token_Index);
            begin
               if Sel_Tok.Kind = Tok_Timeline then
                  if Target = Backend_FASM16 then
                     return Type_U16;
                  else
                     return Type_U64;
                  end if;
               else
                  return Infer_Type_Tag (N.Left_Child);
               end if;
            end;

         
         when AST_Unary_Minus =>
            declare
               Child_Tag : constant ALB_Type_Tag := Infer_Type_Tag (N.Left_Child);
            begin
               if Child_Tag = Type_F32 then
                  return Type_F32;
               elsif Child_Tag = Type_F64 then
                  return Type_F64;
               else
                  return Type_S32;
               end if;
            end;

         when AST_BinOp =>
            declare
               Tok   : Token := Tokens(N.Token_Index);
               L_Tag : ALB_Type_Tag := Infer_Type_Tag(N.Left_Child);
               R_Tag : ALB_Type_Tag := Infer_Type_Tag(N.Right_Child);
            begin
               case Tok.Kind is
                  when TOK_ASSIGN | TOK_EQUAL | TOK_NOT_EQUAL |
                       TOK_LESS | TOK_GREATER | TOK_LESS_EQUAL | TOK_GREATER_EQUAL =>
                     if Target = Backend_FASM16 then
                        return Type_U32;
                     else
                        return Type_U64;
                     end if;

                  when TOK_PLUS | TOK_MINUS | TOK_MUL | TOK_DIV | TOK_MOD | TOK_POW =>
                     if L_Tag = Type_Pure or else R_Tag = Type_Pure then
                        return Type_Pure;
                     elsif L_Tag = Type_F64 or else R_Tag = Type_F64 then
                        return Type_F64;
                     elsif L_Tag = Type_F32 or else R_Tag = Type_F32 then
                        return Type_F32;
                     end if;

                     if L_Tag = Type_U64
                       and then Tree (N.Left_Child).Kind in
                         AST_Number_Expr | AST_Hex_Expr | AST_Bin_Expr |
                         AST_Octal_Expr
                       and then R_Tag /= Type_None
                     then
                        return R_Tag;
                     elsif R_Tag = Type_U64
                       and then Tree (N.Right_Child).Kind in
                         AST_Number_Expr | AST_Hex_Expr | AST_Bin_Expr |
                         AST_Octal_Expr
                       and then L_Tag /= Type_None
                     then
                        return L_Tag;
                     elsif L_Tag = Type_S32 or else R_Tag = Type_S32 then
                        return Type_S32;
                     end if;

                  when others =>
                     null;
               end case;

               if L_Tag /= Type_None then
                  return L_Tag;
               else
                  return Type_U64;
               end if;
            end;

            
         when AST_Choose =>
            declare
               Pair_Node : Node_Index := N.Right_Child;
               T_Tag     : ALB_Type_Tag := Type_U64;
               F_Tag     : ALB_Type_Tag := Type_U64;
            begin
               if Pair_Node > 0 then
                  T_Tag := Infer_Type_Tag (Tree(Pair_Node).Left_Child);
                  F_Tag := Infer_Type_Tag (Tree(Pair_Node).Right_Child);

                  if T_Tag = F_Tag then
                     return T_Tag;
                  elsif T_Tag = Type_Binary or else F_Tag = Type_Binary then
                     return Type_Binary;
                  elsif T_Tag /= Type_None then
                     return T_Tag;
                  else
                     return F_Tag;
                  end if;
               end if;

               return Type_U64;
            end;

            
         when others => 
            return Type_U64; -- Universal safety default
      end case;
   end Infer_Type_Tag;
   
   function Statement_Guarantees_Return (Stmt : Node_Index) return Boolean;

   function Statement_Guarantees_Return (Stmt : Node_Index) return Boolean is
      Curr      : Node_Index := 0;
      Then_Node : Node_Index := 0;
      Else_Node : Node_Index := 0;
      Has_Else  : Boolean := False;
   begin
      if Stmt = 0 then
         return False;
      end if;

      case Tree(Stmt).Kind is
         when AST_Return_Stmt =>
            return True;

         when AST_Block_Stmt =>
            Curr := Tree(Stmt).Left_Child;
            while Curr /= 0 loop
               if Statement_Guarantees_Return(Curr) then
                  return True;
               end if;
               Curr := Tree(Curr).Next_Sibling;
            end loop;
            return False;

         when AST_If_Stmt =>
            Then_Node := Tree(Stmt).Right_Child;

            if Then_Node /= 0 then
               Else_Node := Tree(Then_Node).Next_Sibling;
            end if;

            return Then_Node /= 0
              and then Else_Node /= 0
              and then Statement_Guarantees_Return(Then_Node)
              and then Statement_Guarantees_Return(Else_Node);

         when AST_Select_Stmt | AST_Match_Stmt =>
            Curr := Tree (Stmt).Right_Child;
            if Curr = 0 then
               return False;
            end if;

            while Curr /= 0 loop
               if Tree (Curr).Left_Child = 0 then
                  Has_Else := True;
               end if;

               if not Statement_Guarantees_Return (Tree (Curr).Right_Child) then
                  return False;
               end if;

               Curr := Tree (Curr).Next_Sibling;
            end loop;

            return Has_Else;

         when others =>
            return False;
      end case;
   end Statement_Guarantees_Return;


   function First_Value_Return (Stmt : Node_Index) return Node_Index is
      Curr : Node_Index := 0;
      Hit  : Node_Index := 0;
   begin
      if Stmt = 0 then
         return 0;
      end if;

      if Tree(Stmt).Kind = AST_Return_Stmt then
         if Tree(Stmt).Left_Child /= 0 then
            return Stmt;
         end if;
         return 0;
      end if;

      if Tree(Stmt).Kind = AST_Block_Stmt then
         Curr := Tree(Stmt).Left_Child;
         while Curr /= 0 loop
            Hit := First_Value_Return(Curr);
            if Hit /= 0 then
               return Hit;
            end if;
            Curr := Tree(Curr).Next_Sibling;
         end loop;
         return 0;
      end if;

      Hit := First_Value_Return(Tree(Stmt).Left_Child);
      if Hit /= 0 then
         return Hit;
      end if;

      Hit := First_Value_Return(Tree(Stmt).Right_Child);
      if Hit /= 0 then
         return Hit;
      end if;

      return First_Value_Return(Tree(Stmt).Next_Sibling);
   end First_Value_Return;


   function First_Invalid_Function_Return
     (Stmt         : Node_Index;
      Expected_Tag : ALB_Type_Tag) return Node_Index
   is
      Curr       : Node_Index := 0;
      Hit        : Node_Index := 0;
      Actual_Tag : ALB_Type_Tag := Type_None;
   begin
      if Stmt = 0 then
         return 0;
      end if;

      --  if Tree(Stmt).Kind = AST_Return_Stmt then
      --     if Tree(Stmt).Left_Child = 0 then
      --        return Stmt;
      --     end if;
      --  
      --     Actual_Tag := Infer_Type_Tag(Tree(Stmt).Left_Child);
      --     if not Tags_Compatible(Expected_Tag, Actual_Tag) then
      --        return Stmt;
      --     end if;
      --  
      --     return 0;
      --  end if;
      
      if Tree(Stmt).Kind = AST_Return_Stmt then
         declare
            Ret_Expr : constant Node_Index := Tree(Stmt).Left_Child;
            Lit_Val  : U64 := 0;
         begin
            if Ret_Expr = 0 then
               return Stmt;
            end if;

            Actual_Tag := Infer_Type_Tag(Ret_Expr);

            if Tags_Compatible(Expected_Tag, Actual_Tag)
              or else Integer_Call_Params_Compatible (Expected_Tag, Actual_Tag)
            then
               return 0;
            end if;

            if Try_Literal_U64(Ret_Expr, Lit_Val) then
               case Expected_Tag is
                  when Type_Boolean =>
                     if Lit_Val <= 1 then
                        return 0;
                     end if;
                  when Type_U8 =>
                     if Lit_Val <= 16#FF# then
                        return 0;
                     end if;
                  when Type_U16 =>
                     if Lit_Val <= 16#FFFF# then
                        return 0;
                     end if;
                  when Type_U32 =>
                     if Lit_Val <= 16#FFFF_FFFF# then
                        return 0;
                     end if;
                  when Type_S32 =>
                     if Lit_Val <= 16#7FFF_FFFF# then
                        return 0;
                     end if;
                  when others =>
                     null;
               end case;
            end if;

            return Stmt;
         end;
      end if;


      if Tree(Stmt).Kind = AST_Block_Stmt then
         Curr := Tree(Stmt).Left_Child;
         while Curr /= 0 loop
            Hit := First_Invalid_Function_Return(Curr, Expected_Tag);
            if Hit /= 0 then
               return Hit;
            end if;
            Curr := Tree(Curr).Next_Sibling;
         end loop;
         return 0;
      end if;

      Hit := First_Invalid_Function_Return(Tree(Stmt).Left_Child, Expected_Tag);
      if Hit /= 0 then
         return Hit;
      end if;

      Hit := First_Invalid_Function_Return(Tree(Stmt).Right_Child, Expected_Tag);
      if Hit /= 0 then
         return Hit;
      end if;

      return First_Invalid_Function_Return(Tree(Stmt).Next_Sibling, Expected_Tag);
   end First_Invalid_Function_Return;
   
   procedure Validate_Return_Shape
     (Decl_Node : Node_Index;
      Name      : String;
      Body_Node : Node_Index;
      Success   : in out Boolean;
      Diag      : in out Compiler_Diagnostic)
   is
      Bad_Return : Node_Index := 0;
      Name_Tok   : Natural := 0;
   begin
      if Decl_Node = 0 then
         return;
      end if;

      if Tree(Decl_Node).Left_Child /= 0 then
         Name_Tok := Tree(Tree(Decl_Node).Left_Child).Token_Index;
      else
         Name_Tok := Tree(Decl_Node).Token_Index;
      end if;

      if Tree(Decl_Node).Kind = AST_Procedure_Decl then
         Bad_Return := First_Value_Return(Body_Node);

         if Bad_Return /= 0 then
            Fail_Call_Diagnostic
              ("RETURN",
               Tree(Bad_Return).Token_Index,
               Err_Type_Conflict,
               Success,
               Diag);
            return;
         end if;

      elsif Tree(Decl_Node).Kind = AST_Function_Decl then
         if not Statement_Guarantees_Return(Body_Node) then
            Fail_Call_Diagnostic
              (Name,
               Name_Tok,
               Err_Type_Conflict,
               Success,
               Diag);
            return;
         end if;
      end if;
   end Validate_Return_Shape;


   procedure Validate_Return_Types
     (Decl_Node : Node_Index;
      Body_Node : Node_Index;
      Success   : in out Boolean;
      Diag      : in out Compiler_Diagnostic)
   is
      Bad_Return   : Node_Index := 0;
      Expected_Tag : ALB_Type_Tag := Type_None;
   begin
      if Decl_Node = 0 then
         return;
      end if;

      if Tree(Decl_Node).Kind /= AST_Function_Decl then
         return;
      end if;

      if Tree(Decl_Node).Token_Index > 0 then
         Expected_Tag := Type_Tag_From_Name(Raw_Lexeme(Tree(Decl_Node).Token_Index));
      else
         Expected_Tag := Type_U64;
      end if;

      Bad_Return := First_Invalid_Function_Return(Body_Node, Expected_Tag);

      if Bad_Return /= 0 then
         Fail_Call_Diagnostic
           ("RETURN",
            Tree(Bad_Return).Token_Index,
            Err_Type_Conflict,
            Success,
            Diag);
         return;
      end if;
   end Validate_Return_Types;
   
   function Try_Literal_U64
     (Expr_Node : Node_Index;
      Value     : out U64) return Boolean
   is
      Tok : Token;
      Lex : String (1 .. 64) := (others => ' ');
      Len : Natural := 0;
      OK  : Boolean := False;
   begin
      Value := 0;

      if Expr_Node = 0 then
         return False;
      end if;

      if Tree(Expr_Node).Kind not in AST_Number_Expr | AST_Hex_Expr | AST_Octal_Expr then
         return False;
      end if;

      Tok := Tokens(Tree(Expr_Node).Token_Index);
      Len := Tok.Length;

      if Len = 0 or else Len > Lex'Length then
         return False;
      end if;

      Lex(1 .. Len) := Input_Buffer(Tok.Start .. Tok.Start + Tok.Length - 1);

      if Tree(Expr_Node).Kind = AST_Number_Expr then
         if Is_Real_Number_Text (Lex (1 .. Len)) then
            return False;
         end if;
         Parse_Decimal(Lex(1 .. Len), Value, OK);
      elsif Tree(Expr_Node).Kind = AST_Hex_Expr then
         Parse_Hex(Lex(1 .. Len), Value, OK);
      else
         Parse_Octal(Lex(1 .. Len), Value, OK);
      end if;

      return OK;
   end Try_Literal_U64;

   
   
   function Is_Literal_Zero (Expr_Node : Node_Index) return Boolean is
      Tok : Token;
      Lex : String (1 .. 64) := (others => ' ');
      Len : Natural := 0;
      Val : U64 := 0;
      OK  : Boolean := False;
   begin
      if Expr_Node = 0 then
         return False;
      end if;

      if Tree(Expr_Node).Kind not in AST_Number_Expr | AST_Hex_Expr | AST_Octal_Expr then
         return False;
      end if;

      Tok := Tokens(Tree(Expr_Node).Token_Index);
      Len := Tok.Length;

      if Len = 0 or else Len > Lex'Length then
         return False;
      end if;

      Lex(1 .. Len) := Input_Buffer(Tok.Start .. Tok.Start + Tok.Length - 1);

      if Tree(Expr_Node).Kind = AST_Number_Expr then
         if Is_Real_Number_Text (Lex (1 .. Len)) then
            return False;
         end if;
         Parse_Decimal(Lex(1 .. Len), Val, OK);
      elsif Tree(Expr_Node).Kind = AST_Hex_Expr then
         Parse_Hex(Lex(1 .. Len), Val, OK);
      else
         Parse_Octal(Lex(1 .. Len), Val, OK);
      end if;

      return OK and then Val = 0;
   end Is_Literal_Zero;
   

   function Is_Divide_Or_Mod_Op (Op : Token_Kind) return Boolean is
   begin
      return Op = Tok_Div or else Op = Tok_Mod;
   end Is_Divide_Or_Mod_Op;
   



begin
   Ada.Command_Line.Set_Exit_Status (Ada.Command_Line.Failure);
   Log ("=== ALBT Transpiler v0.0.6.18 ===");
   
   if Ada.Command_Line.Argument_Count < 1 then
      Log ("FATAL: No input file provided.");
      Log ("Usage: albt.exe <source.alb> [-o output.ext] [-t FASM|FASM16|C|...] [--outdir dir] [--build] [--dll] [--fasm16-format com|exe] [--metrics] [--quiet] [--secure] [--prune-dead[=verbose]] [--embed-assets] [--embed-blackbox] [--gfx=<opengl|vulkan|d3d6|d3d7|d3d8|d3d9|d3d10|d3d11|d3d12>]");
      Log ("Backends: FASM|FASM16|C|...");
      Log ("FASM 64 bit, FASM16 DOS 16 bit, C 32 Bit and 64 Bit");
      Log ("System includes: INCLUDE <name.albi> resolves under SDK stdlib/vendor/.");
      return;
   end if;

   for I in 1 .. Ada.Command_Line.Argument_Count loop
      if Skip_Next then
         Skip_Next := False;
      else
         declare
            Arg : String := Ada.Command_Line.Argument (I);
         begin
            if Arg = "-o" then
               if I < Ada.Command_Line.Argument_Count then
                  declare
                     Next_Arg : String := Ada.Command_Line.Argument (I + 1);
                  begin
                     if Next_Arg'Length > Max_Path_Len then
                        Log ("FATAL: Output path is too long.");
                        return;
                     end if;
                     Store_Path (Next_Arg, Output_File, Output_Flen, "output");
                  end;
                  Skip_Next := True;
               else
                  Log ("FATAL: '-o' requires an output filename.");
                  return;
               end if;
            elsif Arg = "--outdir" then
               if I < Ada.Command_Line.Argument_Count then
                  declare
                     Next_Arg : String := Ada.Command_Line.Argument (I + 1);
                  begin
                     if Next_Arg'Length > Max_Path_Len then
                        Log ("FATAL: Output directory path is too long.");
                        return;
                     end if;
                     Store_Path (Next_Arg, Out_Dir, Out_Dir_Len, "output directory");
                  end;
                  Skip_Next := True;
               else
                  Log ("FATAL: '--outdir' requires a directory.");
                  return;
               end if;
            elsif Arg = "--target" or Arg = "-t" then
               if I < Ada.Command_Line.Argument_Count then
                  declare
                     Next_Arg : String := Ada.Command_Line.Argument (I + 1);
                  begin
                     if Next_Arg = "c" then Target := Backend_C;
                     elsif Next_Arg = "ada" then Target := Backend_Ada;
                     elsif Next_Arg = "fasm" then Target := Backend_FASM;
                     elsif Next_Arg = "fasm16" then Target := Backend_FASM16;
                     elsif Next_Arg = "wasm" then Target := Backend_WASM;
                     elsif Next_Arg = "java" then Target := Backend_Java;
                     elsif Next_Arg = "rust" then Target := Backend_Rust;
                     elsif Next_Arg = "zig" then Target := Backend_Zig;
                     elsif Next_Arg = "purebasic" then Target := Backend_PureBasic;
                     elsif Next_Arg = "agk" then Target := Backend_AGK;
                     elsif Next_Arg = "glbasic" then Target := Backend_GLBasic;
                     elsif Next_Arg = "hollywood" then Target := Backend_Hollywood;
                     elsif Next_Arg = "csharp" then Target := Backend_CSharp;
                     elsif Next_Arg = "6502" then Target := Backend_6502;
                     elsif Next_Arg = "z80" then Target := Backend_Z80;
                     elsif Next_Arg = "8086" then Target := Backend_8086;
                     elsif Next_Arg = "cobol" then Target := Backend_COBOL;
                     elsif Next_Arg = "st" then Target := Backend_StructuredText;
                     elsif Next_Arg = "verilog" then Target := Backend_Verilog;
                     elsif Next_Arg = "glsl" then Target := Backend_ComputeShaders;
                     elsif Next_Arg = "forth" then Target := Backend_Forth;
                     elsif Next_Arg = "factor" then Target := Backend_Factor;
                     elsif Next_Arg = "raptor" then Target := Backend_Raptor;
                     else
                        Log ("FATAL: Unknown Target Backend '" & Next_Arg & "'");
                        return;
                     end if;
                  end;
                  Skip_Next := True;
               else
                  Log ("FATAL: '--target' requires a backend name.");
                  return;
               end if;
            elsif Arg = "--fasm16-format" or else Arg = "--16-format" then
               if I < Ada.Command_Line.Argument_Count then
                  declare
                     Next_Arg : String := Ada.Command_Line.Argument (I + 1);
                  begin
                     if Next_Arg = "com" then
                        FASM16_Format := Emit_Native_FASM16.Format_COM;
                     elsif Next_Arg = "exe" or else Next_Arg = "mz" then
                        FASM16_Format := Emit_Native_FASM16.Format_MZ_EXE;
                     else
                        Log ("FATAL: '--fasm16-format' expects 'com' or 'exe'.");
                        return;
                     end if;
                  end;
                  FASM16_Format_Set := True;
                  Skip_Next := True;
               else
                  Log ("FATAL: '--fasm16-format' requires 'com' or 'exe'.");
                  return;
               end if;
            elsif Arg = "--fasm16-com" then
               FASM16_Format := Emit_Native_FASM16.Format_COM;
               FASM16_Format_Set := True;
            elsif Arg = "--fasm16-exe" then
               FASM16_Format := Emit_Native_FASM16.Format_MZ_EXE;
               FASM16_Format_Set := True;
            elsif Arg = "--metrics" or Arg = "-m" then
               Metrics_Requested := True;
            elsif Arg = "--build" or Arg = "-b" then
               Build_Mode := True;
            elsif Arg = "--dll" then
               FASM_DLL_Mode_Requested := True;
            elsif Arg = "--quiet" or Arg = "-q" then
               Quiet_Mode := True;
            elsif Arg = "--secure" then
               Code_Vault.Secure_Mode := True;
            elsif Arg = "--prune-dead" then
               Prune_Dead_Mode := True;
            elsif Arg = "--prune-dead=verbose" then
               Prune_Dead_Mode := True;
               Prune_Dead_Verbose := True;
            elsif Arg = "--embed-assets" then
               Embed_Assets_Mode := True;
            elsif Arg = "--embed-blackbox" then
               Embed_Blackbox_Mode := True;
            elsif Arg'Length >= 6 and then Arg (Arg'First .. Arg'First + 5) = "--gfx=" then
               declare
                  Val : constant String := Fold_Lower (Arg (Arg'First + 6 .. Arg'Last));
               begin
                  if Val = "opengl" or else Val = "vulkan"
                    or else Val = "d3d6" or else Val = "d3d7" or else Val = "d3d8"
                    or else Val = "d3d9" or else Val = "d3d10" or else Val = "d3d11"
                    or else Val = "d3d12"
                  then
                     if Val'Length > Gfx_Backend_Name'Length then
                        Log ("FATAL: --gfx backend name too long.");
                        return;
                     end if;
                     Gfx_Backend_Name (1 .. Val'Length) := Val;
                     Gfx_Backend_Len := Val'Length;
                  else
                     Log ("FATAL: Unknown --gfx backend '" & Val & "' (use opengl|vulkan|d3d6|d3d7|d3d8|d3d9|d3d10|d3d11|d3d12).");
                     return;
                  end if;
               end;
            elsif Arg = "--gfx" then
               if I < Ada.Command_Line.Argument_Count then
                  declare
                     Val : constant String :=
                       Fold_Lower (Ada.Command_Line.Argument (I + 1));
                  begin
                     if Val = "opengl" or else Val = "vulkan"
                       or else Val = "d3d6" or else Val = "d3d7" or else Val = "d3d8"
                       or else Val = "d3d9" or else Val = "d3d10" or else Val = "d3d11"
                       or else Val = "d3d12"
                     then
                        if Val'Length > Gfx_Backend_Name'Length then
                           Log ("FATAL: --gfx backend name too long.");
                           return;
                        end if;
                        Gfx_Backend_Name (1 .. Val'Length) := Val;
                        Gfx_Backend_Len := Val'Length;
                     else
                        Log ("FATAL: Unknown --gfx backend '" & Val & "' (use opengl|vulkan|d3d6|d3d7|d3d8|d3d9|d3d10|d3d11|d3d12).");
                        return;
                     end if;
                  end;
                  Skip_Next := True;
               else
                  Log ("FATAL: '--gfx' requires a backend name (opengl|vulkan|d3d6|d3d7|d3d8|d3d9|d3d10|d3d11|d3d12).");
                  return;
               end if;
            else
               if Arg'Length > Max_Path_Len then
                  Log ("FATAL: Input path is too long.");
                  return;
               end if;
               Store_Path (Arg, Input_File, Input_Flen, "input");
            end if;
         end;
      end if;
   end loop;

   if Input_Flen = 0 then
      Log ("FATAL: No input file provided.");
      return;
   end if;

   if FASM16_Format_Set and then Target /= Backend_FASM16 then
      Log ("FATAL: FASM16 output format flags are only valid with '-t fasm16'.");
      return;
   end if;

   if FASM_DLL_Mode_Requested
     and then Target /= Backend_FASM
     and then Target /= Backend_C
   then
      Log ("FATAL: '--dll' is currently only valid with '-t fasm' or '-t c'.");
      return;
   end if;

   if Build_Mode and then not Build_Mode_Supported_Target then
      Log ("FATAL: '--build' is currently only supported for '-t fasm', '-t fasm16', and '-t c'.");
      return;
   end if;

   Resolve_Output_Paths;

   if Output_Flen = 0 then
      return;
   end if;

   if Final_Dir_Len > 0 then
      begin
         Ada.Directories.Create_Path (Final_Dir (1 .. Final_Dir_Len));
      exception
         when others =>
            Log ("FATAL: Could not create output directory '" & Final_Dir (1 .. Final_Dir_Len) & "'.");
            return;
      end;
   end if;

   if Final_Dir_Len > 0 then
      Open_Log (Final_Dir (1 .. Final_Dir_Len));
   else
      Open_Log ("");
   end if;

   memory_allocator.Alloc_Static_Pool (1048576, Mem_Success);
   
   -- DA FIX: Initialize the Module Kist
   Module_Vault.Initialize_Vault;

   -- Initialize the Grand Switchboard
   Transpiler_Native_HAL.Init_HAL (Target, Emit_Success);
   if not Emit_Success then
      Log ("FATAL: Selected Backend could not be initialized.");
      return;
   end if;

   if Target = Backend_FASM16 and then not FASM16_Format_Set then
      FASM16_Format := Emit_Native_FASM16.Format_MZ_EXE;
   end if;

   if Target = Backend_FASM16 then
      Emit_Native_FASM16.Set_Output_Format (FASM16_Format);
   end if;
   
   Log ("Step 0: Forging the Source Map and Weaving Includes...");
   declare
      procedure Process_File_Weave (F_Name : String; Success : in out Boolean) is
         Local_Buffer : File_Buffer_Ptr := new String (1 .. 524288); -- 512KB safe heap
         Local_Len    : Natural := 0;
         File         : Ada.Streams.Stream_IO.File_Type;
         Stream_Ptr   : Ada.Streams.Stream_IO.Stream_Access;
         Char         : Character;
         File_Dir     : constant String := Parent_Directory (F_Name);
         function Compose_Include_Path
           (Dir  : String;
            Leaf : String) return String
         is
         begin
            if Dir'Length = 0 then
               return Leaf;
            elsif Leaf'Length = 0 then
               return Dir;
            elsif Is_Absolute_Path (Leaf) then
               return Leaf;
            end if;

            for J in Leaf'Range loop
               if Leaf (J) = '\' or else Leaf (J) = '/' then
                  if Dir (Dir'Last) = '\' or else Dir (Dir'Last) = '/' then
                     return Dir & Leaf;
                  else
                     return Dir & "\" & Leaf;
                  end if;
               end if;
            end loop;

            return Ada.Directories.Compose (Dir, Leaf);
         end Compose_Include_Path;

         function At_Directive_Start (Pos : Natural) return Boolean is
            J : Natural := Pos;
         begin
            if Pos = 1 then
               return True;
            end if;
            J := Pos - 1;
            loop
               if Local_Buffer (J) = ASCII.LF then
                  return True;
               elsif Local_Buffer (J) /= ' '
                 and then Local_Buffer (J) /= ASCII.HT
                 and then Local_Buffer (J) /= ASCII.CR
               then
                  return False;
               end if;
               exit when J = 1;
               J := J - 1;
            end loop;
            return True;
         end At_Directive_Start;
         
         My_File_ID   : Natural := 0;
         Rel_Line     : Positive := 1;
         I            : Natural := 1;
         
         Inc_Start, Inc_End : Natural;
         Inc_File     : String (1 .. 256) := (others => ' ');
         Inc_Flen     : Natural;
      begin
         if Is_Already_Included (F_Name) then
            Log ("   -> Skipping already loaded include: " & F_Name);
            Free_File_Buffer(Local_Buffer);
            return;
         end if;
         
         Log ("   -> Weaving File: " & F_Name);
         Register_Include (F_Name, Success, My_File_ID);
         if not Success then Free_File_Buffer(Local_Buffer); return; end if;
         
         -- Anchor the map for this file!
         Source_Map(Abs_Line_Count) := (File_ID => My_File_ID, Rel_Line => Rel_Line);
         
         begin
            Ada.Streams.Stream_IO.Open (File, Ada.Streams.Stream_IO.In_File, F_Name);
            Stream_Ptr := Ada.Streams.Stream_IO.Stream (File);
            while not Ada.Streams.Stream_IO.End_Of_File (File) loop
               Character'Read (Stream_Ptr, Char);
               if Local_Len < 524288 then
                  Local_Len := Local_Len + 1;
                  Local_Buffer (Local_Len) := Char;
               else
                  Log ("FATAL: File exceeds 512KB weave buffer: " & F_Name);
                  Success := False; Ada.Streams.Stream_IO.Close (File); Free_File_Buffer(Local_Buffer); return;
               end if;
            end loop;
            Ada.Streams.Stream_IO.Close (File);
         exception
            when others =>
               Log ("FATAL: Couldna open or read file: " & F_Name);
               Success := False; Free_File_Buffer(Local_Buffer); return;
         end;
         
         while I <= Local_Len loop
            declare
               Match_Include : Boolean := False;
            begin
               if I + 6 <= Local_Len and then (Local_Buffer (I .. I + 6) = "INCLUDE" or Local_Buffer (I .. I + 6) = "include") then
                  if At_Directive_Start (I)
                     and then (I + 7 <= Local_Len
                       and then (Local_Buffer (I + 7) = ' '
                          or else Local_Buffer (I + 7) = '"'
                          or else Local_Buffer (I + 7) = '<'))
                  then
                     Match_Include := True;
                  end if;
               end if;

               if Match_Include then
                  I := I + 7;
                  while I <= Local_Len and then Local_Buffer (I) = ' ' loop I := I + 1; end loop;

                  if I <= Local_Len and then Local_Buffer (I) = '"' then
                     I := I + 1;
                     Inc_Start := I;
                     while I <= Local_Len and then Local_Buffer (I) /= '"' loop I := I + 1; end loop;
                     Inc_End := I - 1;

                     if Inc_End >= Inc_Start then
                        Inc_Flen := Inc_End - Inc_Start + 1;
                        Inc_File (1 .. Inc_Flen) := Local_Buffer (Inc_Start .. Inc_End);
                        
                        -- RECURSE THE WEAVE!
                        declare
                           Resolved_Include : constant String :=
                             (if Is_Absolute_Path (Inc_File (1 .. Inc_Flen))
                                 or else File_Dir'Length = 0
                              then Inc_File (1 .. Inc_Flen)
                              else Compose_Include_Path
                                (File_Dir, Inc_File (1 .. Inc_Flen)));
                        begin
                           Process_File_Weave (Resolved_Include, Success);
                        end;
                        if not Success then Free_File_Buffer(Local_Buffer); return; end if;
                        
                        -- Re-Anchor the map for THIS file returning frae the include!
                        Source_Map(Abs_Line_Count) := (File_ID => My_File_ID, Rel_Line => Rel_Line);
                     end if;
                     I := I + 1; 
                     while I <= Local_Len and then Local_Buffer (I) /= ASCII.LF loop I := I + 1; end loop;
                  elsif I <= Local_Len and then Local_Buffer (I) = '<' then
                     I := I + 1;
                     Inc_Start := I;
                     while I <= Local_Len
                       and then Local_Buffer (I) /= '>'
                       and then Local_Buffer (I) /= ASCII.LF
                     loop
                        I := I + 1;
                     end loop;
                     if I > Local_Len or else Local_Buffer (I) /= '>' then
                        Log ("FATAL: Unclosed system INCLUDE <...> in " & F_Name);
                        Success := False;
                        Free_File_Buffer (Local_Buffer);
                        return;
                     end if;
                     Inc_End := I - 1;
                     if Inc_End >= Inc_Start then
                        Inc_Flen := Inc_End - Inc_Start + 1;
                        Inc_File (1 .. Inc_Flen) := Local_Buffer (Inc_Start .. Inc_End);
                        declare
                           Resolved_Include : constant String :=
                             Resolve_System_Include (Inc_File (1 .. Inc_Flen));
                        begin
                           if not Ada.Directories.Exists (Resolved_Include) then
                              Log ("FATAL: System include not found: <"
                                   & Inc_File (1 .. Inc_Flen) & "> (searched under "
                                   & Vendor_Root & ")");
                              Success := False;
                              Free_File_Buffer (Local_Buffer);
                              return;
                           end if;
                           Log ("   -> System include <"
                                & Inc_File (1 .. Inc_Flen) & "> -> "
                                & Resolved_Include);
                           Process_File_Weave (Resolved_Include, Success);
                        end;
                        if not Success then Free_File_Buffer(Local_Buffer); return; end if;
                        Source_Map(Abs_Line_Count) := (File_ID => My_File_ID, Rel_Line => Rel_Line);
                     end if;
                     I := I + 1;
                     while I <= Local_Len and then Local_Buffer (I) /= ASCII.LF loop I := I + 1; end loop;
                  end if;
               else
                  if Input_Len < 4194304 then
                     Input_Len := Input_Len + 1;
                     Input_Buffer (Input_Len) := Local_Buffer (I);
                     
                     if Local_Buffer (I) = ASCII.LF then
                        if Abs_Line_Count < Max_Absolute_Lines then Abs_Line_Count := Abs_Line_Count + 1; end if;
                        Rel_Line := Rel_Line + 1;
                        Source_Map(Abs_Line_Count) := (File_ID => My_File_ID, Rel_Line => Rel_Line);
                     end if;
                  else
                     Log ("FATAL: Script exceeds 4MB static buffer limit."); Success := False; Free_File_Buffer(Local_Buffer); return;
                  end if;
                  I := I + 1;
               end if;
            end;
         end loop;
         
         if Input_Len > 0 and then Input_Buffer(Input_Len) /= ASCII.LF then
            if Input_Len < 4194304 then
               Input_Len := Input_Len + 1;
               Input_Buffer(Input_Len) := ASCII.LF;
               if Abs_Line_Count < Max_Absolute_Lines then Abs_Line_Count := Abs_Line_Count + 1; end if;
               Rel_Line := Rel_Line + 1;
               Source_Map(Abs_Line_Count) := (File_ID => My_File_ID, Rel_Line => Rel_Line);
            end if;
         end if;
         Free_File_Buffer(Local_Buffer);
      end Process_File_Weave;
      
   begin
      Input_Len := 0;
      Abs_Line_Count := 1;
      Process_File_Weave(Input_File(1 .. Input_Flen), Emit_Success);
      if not Emit_Success then return; end if;
   end;

   --  Log ("Step 1: Tokenizing Script...");
   --  Tokenizer.Tokenize (Input_Buffer (1 .. Input_Len), Tokens, Token_Count, Lex_Diag);
   --  if not Lex_Diag.Success then
   --     ALB_Oracle.Render_Consultation
   --       (Input_Buffer (1 .. Input_Len), Lex_Diag.Error_Line, Lex_Diag.Error_Col, Lex_Diag.Code);
   --     return;
   --  end if;
   Log ("Step 1: Tokenizing Script...");
   Tokenizer.Tokenize (Input_Buffer (1 .. Input_Len), Tokens, Token_Count, Lex_Diag);
   if not Lex_Diag.Success then
      declare
         M_Rec : constant Source_Map_Record := Source_Map(Lex_Diag.Error_Line);
         FName : constant String := Include_Vault(M_Rec.File_ID)(1 .. Include_Lens(M_Rec.File_ID));
      begin
         ALB_Oracle.Render_Consultation
           (Input_Buffer (1 .. Input_Len), Lex_Diag.Error_Line, M_Rec.Rel_Line, Lex_Diag.Error_Col, FName, Lex_Diag.Code);
      end;
      return;
   end if;

   --  Log ("Step 2: Parsing AST...");
   --  Parser.Parse (Tokens, Token_Count, Tree, Root, Parse_Success, Parse_Diag);
   --  if not Parse_Success then
   --     ALB_Oracle.Render_Consultation
   --       (Input_Buffer (1 .. Input_Len), Parse_Diag.Error_Line, Parse_Diag.Error_Col, Parse_Diag.Code);
   --     return;
   --  end if;
   
   Log ("Step 2: Parsing AST...");
   Log ("Token_Count is " & Token_Count'Image);
   Parser.Parse (Tokens, Token_Count, Tree, Root, Parse_Success, Parse_Diag);

   -- =====================================================================
   -- DA ERGONOMIC DIAGNOSTICS ENGINE
   -- =====================================================================
   if Parse_Diag.Error_Count > 0 then
      Ada.Text_IO.New_Line;
      Ada.Text_IO.Put_Line ("========================================================");
      Ada.Text_IO.Put_Line (" ALB COMPILER DIAGNOSTICS (" & Natural'Image(Parse_Diag.Error_Count) & " Events)");
      Ada.Text_IO.Put_Line ("========================================================");
      
      declare
         Has_Fatal : Boolean := False;
      begin
         for I in 1 .. Parse_Diag.Error_Count loop
            declare
               Err : constant Parser.Error_Record := Parse_Diag.Errors(I);
               M_Rec : constant Source_Map_Record := Source_Map(Err.Line);
               FName : constant String := Include_Vault(M_Rec.File_ID)(1 .. Include_Lens(M_Rec.File_ID));
            begin
               if Err.Severity = Parser.Fatal then
                  Ada.Text_IO.Put (" [FATAL ERROR]   "); Has_Fatal := True;
               else
                  Ada.Text_IO.Put (" [GHOST WARNING] ");
               end if;
               Ada.Text_IO.Put_Line ("[" & FName & "] Line" & Positive'Image(M_Rec.Rel_Line) & ", Col" & Positive'Image(Err.Col) & " -> " & ALB_Oracle.Oracle_Code'Image(Err.Code));
            end;
         end loop;
         
         Ada.Text_IO.Put_Line ("========================================================");
         
         if Has_Fatal then
            Ada.Text_IO.Put_Line ("*** BUILD HALTED: Fix the fatal syntax errors abune tae proceed. ***");
            declare
               Bad_Tok : Token; Found : Boolean := False;
               Arg_Str : String (1 .. 64) := (others => ' '); Arg_Len : Natural := 0;
               Target_Idx : Positive := 1; Err_Tok_Idx : Positive := 1;
            begin
               for I in 1 .. Parse_Diag.Error_Count loop
                  if Parse_Diag.Errors(I).Severity = Parser.Fatal then Target_Idx := I; exit; end if;
               end loop;
               
               for I in 1 .. Token_Count loop
                  if Tokens(I).Line = Parse_Diag.Errors(Target_Idx).Line and then Tokens(I).Column = Parse_Diag.Errors(Target_Idx).Col then
                     Bad_Tok := Tokens(I); Err_Tok_Idx := I; Found := True; exit;
                  end if;
               end loop;
               
               if Found and then Err_Tok_Idx > 1 and then Tokens(Err_Tok_Idx - 1).Line = Bad_Tok.Line then
                  if Tokens(Err_Tok_Idx - 1).Kind = Tok_Atom or else Tokens(Err_Tok_Idx - 1).Kind = Tok_Logic_Var then
                     Bad_Tok := Tokens(Err_Tok_Idx - 1);
                  end if;
               end if;
               
               if Found and then Bad_Tok.Length > 0 then
                  Arg_Len := Bad_Tok.Length; if Arg_Len > 64 then Arg_Len := 64; end if;
                  Arg_Str(1 .. Arg_Len) := Input_Buffer(Bad_Tok.Start .. Bad_Tok.Start + Arg_Len - 1);
               end if;
               
               declare
                  M_Rec : constant Source_Map_Record := Source_Map(Parse_Diag.Errors(Target_Idx).Line);
                  FName : constant String := Include_Vault(M_Rec.File_ID)(1 .. Include_Lens(M_Rec.File_ID));
               begin
                  ALB_Oracle.Render_Consultation
                    (Input_Buffer (1 .. Input_Len), Parse_Diag.Errors(Target_Idx).Line, M_Rec.Rel_Line, 
                     Parse_Diag.Errors(Target_Idx).Col, FName, Parse_Diag.Errors(Target_Idx).Code, Arg_Str(1 .. Arg_Len));
               end;
            end;
            return; 
         else
            Ada.Text_IO.Put_Line ("*** RECOVERY SUCCESS: Ghost tokens applied. Pipeline proceeding! ***");
            Ada.Text_IO.New_Line;
         end if;
      end;
   end if;

   Seed_Win32_Memory_Consts;

   if Embed_Blackbox_Mode and then Target /= Backend_FASM then
      Log ("FATAL: --embed-blackbox requires '-t fasm'.");
      return;
   end if;

   if Embed_Assets_Mode then
      Log ("NOTE: --embed-assets active (compile-time bake; fail-loud on missing assets).");
   end if;

   if Target = Backend_FASM then
      if Embed_Blackbox_Mode then
         Emit_Native_FASM.Set_Blackbox_Mode (True);
         Log ("NOTE: --embed-blackbox active (VEH + heap-free alb_blackbox.txt dump).");
      end if;
      FASM_DLL_Mode_Active :=
        FASM_DLL_Mode_Requested or else Has_Shared_Library_Exports (Root);

      if FASM_DLL_Mode_Active then
         Emit_Native_FASM.Set_Output_Format (Emit_Native_FASM.Format_PE64_DLL);
         if not FASM_DLL_Mode_Requested then
            Log ("NOTE: EXPORT_* detected on -t fasm; enabling DLL output mode.");
         end if;
      elsif Has_Create_Window_Feature (Root) then
         Emit_Native_FASM.Set_Output_Format (Emit_Native_FASM.Format_PE64_GUI);
      else
         Emit_Native_FASM.Set_Output_Format (Emit_Native_FASM.Format_PE64_Console);
      end if;
   else
      FASM_DLL_Mode_Active := False;
   end if;

   if Target = Backend_C then
      C_Shared_Library_Mode_Active :=
        FASM_DLL_Mode_Requested or else Has_Shared_Library_Exports (Root);

      if C_Shared_Library_Mode_Active and then not FASM_DLL_Mode_Requested then
         Log ("NOTE: EXPORT_* detected on -t c; enabling shared-library wrapper mode.");
      end if;
   else
      C_Shared_Library_Mode_Active := False;
   end if;

   Safe_Process_Runtime_Used := Target = Backend_FASM and then Has_Safe_Process_Features (Root);

   Log ("Step 3: Beginning Text Emission...");

   Transpiler_Native_HAL.Emit_Program_Start ("Payload", Emit_Success);
   
   Log ("Hoisting Prototypes (Kiling Circular Dependencies)...");
   
   Log ("Generating Logic Bodies...");

   declare
      
      procedure Comptime_Eval_Expr
        (Node    : in Node_Index;
         Value   : out U64;
         Success : in out Boolean;
         Diag    : in out Compiler_Diagnostic);

      procedure Comptime_Execute
        (Node    : in Node_Index;
         Success : in out Boolean;
         Diag    : in out Compiler_Diagnostic);

      procedure Fail_Node
        (N       : Node_Index;
         Code    : Oracle_Code;
         Culprit : String;
         Success : in out Boolean;
         Diag    : in out Compiler_Diagnostic) is
         Tok_Idx  : Natural := 0;
         Clip_Len : Natural := Culprit'Length;
      begin
         Diag.Success := False;
         Diag.Code := Code;

         if N /= 0 then
            Tok_Idx := Tree(N).Token_Index;
         end if;

         if Tok_Idx > 0 then
            Diag.Error_Line := Tokens(Tok_Idx).Line;
            Diag.Error_Col := Tokens(Tok_Idx).Column;
         else
            Diag.Error_Line := 1;
            Diag.Error_Col := 1;
         end if;

         if Clip_Len > Diag.Culprit'Length then
            Clip_Len := Diag.Culprit'Length;
         end if;

         Diag.Culprit_Len := Clip_Len;
         if Clip_Len > 0 then
            Diag.Culprit(1 .. Clip_Len) := Culprit(Culprit'First .. Culprit'First + Clip_Len - 1);
         end if;

         Success := False;
      end Fail_Node;

      procedure Store_Name (Dest : out String; Dest_Len : out Natural; Source : String) is
      begin
         Dest := (others => ' ');
         Dest_Len := Source'Length;
         if Dest_Len > Dest'Length then
            Dest_Len := Dest'Length;
         end if;

         if Dest_Len > 0 then
            Dest(Dest'First .. Dest'First + Dest_Len - 1) :=
              Source(Source'First .. Source'First + Dest_Len - 1);
         end if;
      end Store_Name;

      Max_MML_Source_Bytes  : constant Natural := 8192;
      Max_Music_Events      : constant Natural := 2048;
      Music_PCM_Sample_Rate : constant Natural := 22050;
      Music_Base_A_Freq     : constant Long_Float := 432.0;
      PC_Speaker_Base_Hz    : constant Long_Float := 1_193_180.0;

      subtype Music_Event_Index is Positive range 1 .. Max_Music_Events;

      type Music_Event_Record is record
         Freq_Hz     : Long_Float := 0.0;
         Duration_Ms : Natural := 0;
         Volume      : Natural := 100;
         Is_Rest     : Boolean := False;
      end record;

      type Music_Event_Array is array (Music_Event_Index) of Music_Event_Record;

      function Trim_Image (Value : Integer) return String is
         S : constant String := Integer'Image (Value);
      begin
         return S (S'First + 1 .. S'Last);
      end Trim_Image;

      function To_Upper_Char (C : Character) return Character is
      begin
         if C >= 'a' and then C <= 'z' then
            return Character'Val (Character'Pos (C) - 32);
         end if;

         return C;
      end To_Upper_Char;

      function Source_File_For_Node (Node : Node_Index) return String is
         Tok_Idx : Natural := 0;
         Line_No : Positive := 1;
      begin
         if Node > 0 then
            Tok_Idx := Tree (Node).Token_Index;
         end if;

         if Tok_Idx > 0 then
            Line_No := Tokens (Tok_Idx).Line;
         end if;

         if Line_No <= Max_Absolute_Lines then
            declare
               M_Rec : constant Source_Map_Record := Source_Map (Line_No);
            begin
               if M_Rec.File_ID >= 1
                 and then M_Rec.File_ID <= Include_Count
                 and then Include_Lens (M_Rec.File_ID) > 0
               then
                  return Include_Vault (M_Rec.File_ID) (1 .. Include_Lens (M_Rec.File_ID));
               end if;
            end;
         end if;

         if Input_Flen > 0 then
            return Input_File (1 .. Input_Flen);
         end if;

         return "";
      end Source_File_For_Node;

      function Parent_Directory (Path : String) return String is
      begin
         for I in reverse Path'Range loop
            if Path (I) = '\' or else Path (I) = '/' then
               return Path (Path'First .. I);
            end if;
         end loop;

         return "";
      end Parent_Directory;

      function Try_Read_Text_File_Limited
        (Path    : String;
         Success : out Boolean) return String
      is
         use type Ada.Streams.Stream_IO.Count;
         use type Ada.Streams.Stream_Element_Offset;

         F         : Ada.Streams.Stream_IO.File_Type;
         File_Size : Ada.Streams.Stream_IO.Count := 0;
      begin
         Ada.Streams.Stream_IO.Open
           (F,
            Ada.Streams.Stream_IO.In_File,
            Path);
         File_Size := Ada.Streams.Stream_IO.Size (F);

         declare
            Len : Natural := 0;
         begin
            if File_Size > Ada.Streams.Stream_IO.Count (Max_MML_Source_Bytes) then
               Len := Max_MML_Source_Bytes;
            else
               Len := Natural (File_Size);
            end if;

            if Len = 0 then
               Ada.Streams.Stream_IO.Close (F);
               Success := True;
               return "";
            end if;

            declare
               Buffer : Ada.Streams.Stream_Element_Array
                 (1 .. Ada.Streams.Stream_Element_Offset (Len));
               Last   : Ada.Streams.Stream_Element_Offset := 0;
            begin
               Ada.Streams.Stream_IO.Read (F, Buffer, Last);
               Ada.Streams.Stream_IO.Close (F);

               if Last = 0 then
                  Success := True;
                  return "";
               end if;

               declare
                  Count_Read : constant Natural := Natural (Last);
                  Text       : String (1 .. Count_Read);
               begin
                  for I in 1 .. Count_Read loop
                     Text (I) :=
                       Character'Val
                         (Integer
                            (Buffer (Ada.Streams.Stream_Element_Offset (I))));
                  end loop;

                  Success := True;
                  return Text;
               end;
            end;
         end;
      exception
         when others =>
            if Ada.Streams.Stream_IO.Is_Open (F) then
               Ada.Streams.Stream_IO.Close (F);
            end if;
            Success := False;
            return "";
      end Try_Read_Text_File_Limited;

      function Pythagorean_Frequency
        (Semitones_From_A4 : Integer) return Long_Float
      is
         Note_Class   : constant Integer := Semitones_From_A4 mod 12;
         Octave_Shift : Integer := Semitones_From_A4 / 12;
         Ratio        : Long_Float := 1.0;
         Result       : Long_Float := Music_Base_A_Freq;
      begin
         if Semitones_From_A4 < 0 and then (Semitones_From_A4 mod 12) /= 0 then
            Octave_Shift := Octave_Shift - 1;
         end if;

         case Note_Class is
            when 0  => Ratio := 1.0 / 1.0;
            when 1  => Ratio := 256.0 / 243.0;
            when 2  => Ratio := 9.0 / 8.0;
            when 3  => Ratio := 32.0 / 27.0;
            when 4  => Ratio := 81.0 / 64.0;
            when 5  => Ratio := 4.0 / 3.0;
            when 6  => Ratio := 729.0 / 512.0;
            when 7  => Ratio := 3.0 / 2.0;
            when 8  => Ratio := 128.0 / 81.0;
            when 9  => Ratio := 27.0 / 16.0;
            when 10 => Ratio := 16.0 / 9.0;
            when 11 => Ratio := 243.0 / 128.0;
            when others => Ratio := 1.0;
         end case;

         Result := Result * Ratio;

         if Octave_Shift > 0 then
            for I in 1 .. Octave_Shift loop
               Result := Result * 2.0;
            end loop;
         elsif Octave_Shift < 0 then
            for I in 1 .. (-Octave_Shift) loop
               Result := Result / 2.0;
            end loop;
         end if;

         return Result;
      end Pythagorean_Frequency;

      function Pure_Frequency_For_Note
        (Note_Class : Integer;
         Octave     : Integer) return Long_Float
      is
         Semitones_From_A4 : constant Integer :=
           ((Octave - 4) * 12) + (Note_Class - 9);
      begin
         return Pythagorean_Frequency (Semitones_From_A4);
      end Pure_Frequency_For_Note;

      function Load_Music_Source
        (Node      : Node_Index;
         Expr_Node : Node_Index;
         From_File : Boolean;
         Success   : in out Boolean;
         Diag      : in out Compiler_Diagnostic) return String
      is
         Loaded_OK : Boolean := False;
      begin
         if Expr_Node = 0 or else Tree (Expr_Node).Kind /= AST_String_Expr then
            if From_File then
               Fail_Node
                 (Node,
                  Err_Type_Conflict,
                  "PLAY MUSIC FROM requires a quoted .mml path",
                  Success,
                  Diag);
            else
               Fail_Node
                 (Node,
                  Err_Type_Conflict,
                  "PLAY MUSIC requires a quoted MML string",
                  Success,
                  Diag);
            end if;
            return "";
         end if;

         declare
            Raw_Text    : constant String := "" & Strip_String_Node (Expr_Node);
            Source_File : constant String := Source_File_For_Node (Node);
            Source_Dir  : constant String := Parent_Directory (Source_File);
         begin
            if not From_File then
               return Raw_Text;
            end if;

            if Raw_Text'Length = 0 then
               Fail_Node (Expr_Node, Err_Type_Conflict, "empty MML path", Success, Diag);
               return "";
            end if;

            if Raw_Text'Length >= 2 and then Raw_Text (Raw_Text'First + 1) = ':' then
               declare
                  Text : constant String :=
                    Try_Read_Text_File_Limited (Raw_Text, Loaded_OK);
               begin
                  if Loaded_OK then
                     return Text;
                  end if;
               end;
            end if;

            if Source_Dir'Length > 0 then
               declare
                  Text : constant String :=
                    Try_Read_Text_File_Limited (Source_Dir & Raw_Text, Loaded_OK);
               begin
                  if Loaded_OK then
                     return Text;
                  end if;
               end;
            end if;

            declare
               Text : constant String :=
                 Try_Read_Text_File_Limited (Raw_Text, Loaded_OK);
            begin
               if Loaded_OK then
                  return Text;
               end if;
            end;

            if Source_Dir'Length > 0 then
               declare
                  Text : constant String :=
                    Try_Read_Text_File_Limited (Source_Dir & "MUSIC\" & Raw_Text, Loaded_OK);
               begin
                  if Loaded_OK then
                     return Text;
                  end if;
               end;
            end if;

            declare
               Text : constant String :=
                 Try_Read_Text_File_Limited ("MUSIC\" & Raw_Text, Loaded_OK);
            begin
               if Loaded_OK then
                  return Text;
               end if;
            end;

            -- --embed-assets / SET_SHOEBOX: bake from asset root
            if Shoebox_Path_Len > 0 then
               declare
                  Box : constant String := Shoebox_Path (1 .. Shoebox_Path_Len);
                  Text : constant String :=
                    Try_Read_Text_File_Limited (Box & "\" & Raw_Text, Loaded_OK);
               begin
                  if Loaded_OK then
                     return Text;
                  end if;
               end;
               declare
                  Box : constant String := Shoebox_Path (1 .. Shoebox_Path_Len);
                  Text : constant String :=
                    Try_Read_Text_File_Limited (Box & "\MUSIC\" & Raw_Text, Loaded_OK);
               begin
                  if Loaded_OK then
                     return Text;
                  end if;
               end;
            end if;
         end;

         if Embed_Assets_Mode then
            Fail_Node
              (Expr_Node,
               Err_Type_Conflict,
               "MML file not found (--embed-assets requires compile-time bake)",
               Success,
               Diag);
         else
            Fail_Node (Expr_Node, Err_Type_Conflict, "MML file not found", Success, Diag);
         end if;
         return "";
      end Load_Music_Source;

      procedure Parse_MML_Source
        (Node        : Node_Index;
         Source      : String;
         Event_Count : out Natural;
         Events      : out Music_Event_Array;
         Success     : in out Boolean;
         Diag        : in out Compiler_Diagnostic)
      is
         Cursor         : Natural := 0;
         Current_Octave : Integer := 4;
         Default_Length : Natural := 4;
         Current_Tempo  : Natural := 120;
         Current_Volume : Natural := 100;

         function Note_Base (C : Character) return Integer is
         begin
            case C is
               when 'C' => return 0;
               when 'D' => return 2;
               when 'E' => return 4;
               when 'F' => return 5;
               when 'G' => return 7;
               when 'A' => return 9;
               when 'B' => return 11;
               when others => return 0;
            end case;
         end Note_Base;

         function Parse_Number return Natural is
            Value : Natural := 0;
         begin
            while Cursor <= Source'Last
              and then Source (Cursor) in '0' .. '9'
            loop
               if Value > (Natural'Last / 10) then
                  Value := Natural'Last / 2;
               else
                  Value :=
                    (Value * 10)
                    + Natural (Character'Pos (Source (Cursor)) - Character'Pos ('0'));
               end if;
               Cursor := Cursor + 1;
            end loop;

            return Value;
         end Parse_Number;

         function Duration_Ms
           (Tempo  : Natural;
            Length : Natural;
            Dotted : Boolean) return Natural
         is
            Base : Long_Float := 0.0;
         begin
            if Tempo = 0 or else Length = 0 then
               return 125;
            end if;

            Base :=
              (60_000.0 / Long_Float (Tempo))
              * (4.0 / Long_Float (Length));

            if Dotted then
               Base := Base * 1.5;
            end if;

            if Base < 1.0 then
               return 1;
            end if;

            return Natural (Integer (Base + 0.5));
         end Duration_Ms;

         procedure Append_Event
           (Freq_Hz  : Long_Float;
            Duration : Natural;
            Volume   : Natural;
            Is_Rest  : Boolean)
         is
            Safe_Volume : Natural := Volume;
            Safe_Dur    : Natural := Duration;
         begin
            if Event_Count >= Max_Music_Events then
               Fail_Node (Node, Err_Mem_Out_Of_Bounds, "PLAY MUSIC", Success, Diag);
               return;
            end if;

            if Safe_Volume > 100 then
               Safe_Volume := 100;
            end if;

            if Safe_Dur = 0 then
               Safe_Dur := 1;
            end if;

            Event_Count := Event_Count + 1;
            Events (Music_Event_Index (Event_Count)) :=
              (Freq_Hz     => Freq_Hz,
               Duration_Ms => Safe_Dur,
               Volume      => Safe_Volume,
               Is_Rest     => Is_Rest);
         end Append_Event;

      begin
         Event_Count := 0;

         if Source'Length = 0 then
            return;
         end if;

         Cursor := Source'First;

         while Cursor <= Source'Last loop
            declare
               Ch : constant Character := To_Upper_Char (Source (Cursor));
            begin
               case Ch is
                  when ' ' | Character'Val (9) | Character'Val (10)
                    | Character'Val (13) | ','
                  =>
                     Cursor := Cursor + 1;

                  when ';' =>
                     Cursor := Cursor + 1;
                     while Cursor <= Source'Last
                       and then Source (Cursor) /= Character'Val (10)
                       and then Source (Cursor) /= Character'Val (13)
                     loop
                        Cursor := Cursor + 1;
                     end loop;

                  when 'O' =>
                     Cursor := Cursor + 1;
                     declare
                        Parsed : constant Natural := Parse_Number;
                     begin
                        Current_Octave := Integer (Parsed);
                        if Current_Octave < 0 then
                           Current_Octave := 0;
                        elsif Current_Octave > 8 then
                           Current_Octave := 8;
                        end if;
                     end;

                  when 'L' =>
                     Cursor := Cursor + 1;
                     declare
                        Parsed : constant Natural := Parse_Number;
                     begin
                        if Parsed > 0 then
                           Default_Length := Parsed;
                        end if;
                     end;

                  when 'T' =>
                     Cursor := Cursor + 1;
                     declare
                        Parsed : constant Natural := Parse_Number;
                     begin
                        if Parsed > 0 then
                           Current_Tempo := Parsed;
                        end if;
                     end;

                  when 'V' =>
                     Cursor := Cursor + 1;
                     declare
                        Parsed : constant Natural := Parse_Number;
                     begin
                        Current_Volume := Parsed;
                        if Current_Volume > 100 then
                           Current_Volume := 100;
                        end if;
                     end;

                  when '>' =>
                     Cursor := Cursor + 1;
                     if Current_Octave < 8 then
                        Current_Octave := Current_Octave + 1;
                     end if;

                  when '<' =>
                     Cursor := Cursor + 1;
                     if Current_Octave > 0 then
                        Current_Octave := Current_Octave - 1;
                     end if;

                  when 'A' | 'B' | 'C' | 'D' | 'E' | 'F' | 'G' | 'P' | 'R' =>
                     declare
                        Note_Char   : constant Character := Ch;
                        Accidental  : Integer := 0;
                        Note_Length : Natural := 0;
                        Note_Dotted : Boolean := False;
                        Total_Dur   : Natural := 0;
                     begin
                        Cursor := Cursor + 1;

                        if Cursor <= Source'Last then
                           if Source (Cursor) = '#'
                             or else Source (Cursor) = '+'
                           then
                              Accidental := 1;
                              Cursor := Cursor + 1;
                           elsif Source (Cursor) = '-' then
                              Accidental := -1;
                              Cursor := Cursor + 1;
                           end if;
                        end if;

                        Note_Length := Parse_Number;
                        if Note_Length = 0 then
                           Note_Length := Default_Length;
                        end if;
                        if Note_Length = 0 then
                           Note_Length := 4;
                        end if;

                        if Cursor <= Source'Last
                          and then Source (Cursor) = '.'
                        then
                           Note_Dotted := True;
                           Cursor := Cursor + 1;
                        end if;

                        Total_Dur :=
                          Duration_Ms (Current_Tempo, Note_Length, Note_Dotted);

                        while Cursor <= Source'Last
                          and then Source (Cursor) = '&'
                        loop
                           Cursor := Cursor + 1;

                           declare
                              Tie_Length : Natural := Parse_Number;
                              Tie_Dot    : Boolean := False;
                           begin
                              if Tie_Length = 0 then
                                 Tie_Length := Default_Length;
                              end if;
                              if Tie_Length = 0 then
                                 Tie_Length := 4;
                              end if;

                              if Cursor <= Source'Last
                                and then Source (Cursor) = '.'
                              then
                                 Tie_Dot := True;
                                 Cursor := Cursor + 1;
                              end if;

                              Total_Dur :=
                                Total_Dur
                                + Duration_Ms
                                    (Current_Tempo,
                                     Tie_Length,
                                     Tie_Dot);
                           end;
                        end loop;

                        if Note_Char = 'P' or else Note_Char = 'R' then
                           Append_Event
                             (Freq_Hz  => 0.0,
                              Duration => Total_Dur,
                              Volume   => Current_Volume,
                              Is_Rest  => True);
                        else
                           Append_Event
                             (Freq_Hz =>
                                Pure_Frequency_For_Note
                                  (Note_Base (Note_Char) + Accidental,
                                   Current_Octave),
                              Duration => Total_Dur,
                              Volume   => Current_Volume,
                              Is_Rest  => False);
                        end if;

                        if not Success then
                           return;
                        end if;
                     end;

                  when others =>
                     Fail_Node (Node, Err_Type_Conflict, "Invalid MML token", Success, Diag);
                     return;
               end case;
            end;
         end loop;
      end Parse_MML_Source;

      procedure Emit_Play_Music_FASM
        (Node      : Node_Index;
         From_File : Boolean;
         Success   : in out Boolean;
         Diag      : in out Compiler_Diagnostic)
      is
         Expr_Node   : constant Node_Index := Tree (Node).Left_Child;
         MML_Text    : constant String :=
           Load_Music_Source (Node, Expr_Node, From_File, Success, Diag);
         Event_Count : Natural := 0;
         Events      : Music_Event_Array;
         Label_Base  : constant String := "ALB_Music_" & Trim_Image (Integer (Node));
         Line_Buffer : String (1 .. 512) := (others => ' ');
         Line_Len    : Natural := 0;
         Word_Count  : Natural := 0;

         procedure Flush_Line is
         begin
            if Line_Len = 0 then
               return;
            end if;

            Transpiler_Native_HAL.Emit_Raw (Line_Buffer (1 .. Line_Len), Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            Line_Len := 0;
            Word_Count := 0;
         end Flush_Line;

         procedure Append_Line_Text (Text : String) is
         begin
            if Line_Len + Text'Length > Line_Buffer'Length then
               Flush_Line;
            end if;

            if Text'Length > Line_Buffer'Length then
               Fail_Node (Node, Err_Mem_Out_Of_Bounds, "PLAY MUSIC", Success, Diag);
               return;
            end if;

            Line_Buffer (Line_Len + 1 .. Line_Len + Text'Length) := Text;
            Line_Len := Line_Len + Text'Length;
         end Append_Line_Text;

         procedure Append_Sample (Value : Integer) is
         begin
            if Word_Count = 0 then
               Append_Line_Text ("  dw ");
            else
               Append_Line_Text (", ");
            end if;

            Append_Line_Text (Trim_Image (Value));
            Word_Count := Word_Count + 1;

            if Word_Count >= 12 then
               Flush_Line;
            end if;
         end Append_Sample;
      begin
         if not Success or else not Diag.Success then
            return;
         end if;

         Parse_MML_Source (Node, MML_Text, Event_Count, Events, Success, Diag);
         if not Success or else not Diag.Success then
            return;
         end if;

         if Event_Count = 0 then
            return;
         end if;

         Transpiler_Native_HAL.Set_Global_Buffer_Mode (True);
         Transpiler_Native_HAL.Emit_Raw ("  align 8", Success);
         Transpiler_Native_HAL.Emit_Newline (Success);
         Transpiler_Native_HAL.Emit_Raw (Label_Base & ":", Success);
         Transpiler_Native_HAL.Emit_Newline (Success);

         for I in 1 .. Event_Count loop
            declare
               Samples_For_Event : Natural :=
                 Natural
                   (Integer
                      (((Long_Float (Events (Music_Event_Index (I)).Duration_Ms)
                         * Long_Float (Music_PCM_Sample_Rate))
                        / 1000.0)
                       + 0.5));
            begin
               if Samples_For_Event = 0 then
                  Samples_For_Event := 1;
               end if;

               if Events (Music_Event_Index (I)).Is_Rest
                 or else Events (Music_Event_Index (I)).Freq_Hz <= 0.0
               then
                  for S in 1 .. Samples_For_Event loop
                     Append_Sample (0);
                     if not Success or else not Diag.Success then
                        exit;
                     end if;
                  end loop;
               else
                  declare
                     Step_A       : constant Long_Float :=
                       Events (Music_Event_Index (I)).Freq_Hz
                       / Long_Float (Music_PCM_Sample_Rate);
                     Step_B       : constant Long_Float := Step_A * 1.003;
                     Phase_A      : Long_Float := 0.0;
                     Phase_B      : Long_Float := 0.0;
                     Volume_Scale : constant Long_Float :=
                       Long_Float (Events (Music_Event_Index (I)).Volume) / 100.0;
                     Fade_Samples : Natural := 64;
                  begin
                     if (Samples_For_Event / 8) < Fade_Samples then
                        Fade_Samples := Samples_For_Event / 8;
                     end if;
                     if Fade_Samples = 0 then
                        Fade_Samples := 1;
                     end if;

                     for S in 0 .. Samples_For_Event - 1 loop
                        declare
                           Wave_A : constant Long_Float :=
                             (if Phase_A < 0.5 then 1.0 else -1.0);
                           Wave_B : constant Long_Float :=
                             (if Phase_B < 0.5 then 1.0 else -1.0);
                           Env    : Long_Float := 1.0;
                           Amp    : Long_Float := 0.0;
                           Sample : Integer := 0;
                        begin
                           if S < Fade_Samples then
                              Env := Long_Float (S) / Long_Float (Fade_Samples);
                           elsif S >= Samples_For_Event - Fade_Samples then
                              Env :=
                                Long_Float (Samples_For_Event - S)
                                / Long_Float (Fade_Samples);
                              if Env < 0.0 then
                                 Env := 0.0;
                              end if;
                           end if;

                           Amp :=
                             ((Wave_A + Wave_B) * 0.5)
                             * 0.35
                             * Volume_Scale
                             * Env;
                           Sample := Integer (Amp * 32767.0);

                           if Sample > 32767 then
                              Sample := 32767;
                           elsif Sample < -32767 then
                              Sample := -32767;
                           end if;

                           Append_Sample (Sample);

                           Phase_A := Phase_A + Step_A;
                           while Phase_A >= 1.0 loop
                              Phase_A := Phase_A - 1.0;
                           end loop;

                           Phase_B := Phase_B + Step_B;
                           while Phase_B >= 1.0 loop
                              Phase_B := Phase_B - 1.0;
                           end loop;
                        end;

                        exit when not Success or else not Diag.Success;
                     end loop;
                  end;
               end if;

               exit when not Success or else not Diag.Success;
            end;
         end loop;

         Flush_Line;
         Transpiler_Native_HAL.Emit_Raw (Label_Base & "_End:", Success);
         Transpiler_Native_HAL.Emit_Newline (Success);
         Transpiler_Native_HAL.Set_Global_Buffer_Mode (False);

         if not Success or else not Diag.Success then
            return;
         end if;

         Transpiler_Native_HAL.Emit_Raw ("  lea rcx, [" & Label_Base & "]", Success);
         Transpiler_Native_HAL.Emit_Newline (Success);
         Transpiler_Native_HAL.Emit_Raw
           ("  mov edx, " & Label_Base & "_End - " & Label_Base,
            Success);
         Transpiler_Native_HAL.Emit_Newline (Success);
         Transpiler_Native_HAL.Emit_Raw ("  call ALB_Play_Music_Buffer", Success);
         Transpiler_Native_HAL.Emit_Newline (Success);
      end Emit_Play_Music_FASM;

      procedure Emit_Play_Music_FASM16
        (Node      : Node_Index;
         From_File : Boolean;
         Success   : in out Boolean;
         Diag      : in out Compiler_Diagnostic)
      is
         Expr_Node   : constant Node_Index := Tree (Node).Left_Child;
         MML_Text    : constant String :=
           Load_Music_Source (Node, Expr_Node, From_File, Success, Diag);
         Event_Count : Natural := 0;
         Events      : Music_Event_Array;
         Label_Base  : constant String := "ALB16_Music_" & Trim_Image (Integer (Node));
      begin
         if not Success or else not Diag.Success then
            return;
         end if;

         Parse_MML_Source (Node, MML_Text, Event_Count, Events, Success, Diag);
         if not Success or else not Diag.Success then
            return;
         end if;

         if Event_Count = 0 then
            return;
         end if;

         Transpiler_Native_HAL.Set_Global_Buffer_Mode (True);
         Transpiler_Native_HAL.Emit_Raw (Label_Base & ":", Success);
         Transpiler_Native_HAL.Emit_Newline (Success);

         for I in 1 .. Event_Count loop
            declare
               Divisor : Natural := 0;
               Dur_Ms  : Natural := Events (Music_Event_Index (I)).Duration_Ms;
            begin
               if not Events (Music_Event_Index (I)).Is_Rest
                 and then Events (Music_Event_Index (I)).Freq_Hz > 0.0
               then
                  Divisor :=
                    Natural
                      (Integer
                         ((PC_Speaker_Base_Hz
                           / Events (Music_Event_Index (I)).Freq_Hz)
                          + 0.5));
                  if Divisor = 0 then
                     Divisor := 1;
                  elsif Divisor > 65535 then
                     Divisor := 65535;
                  end if;
               end if;

               if Dur_Ms = 0 then
                  Dur_Ms := 1;
               elsif Dur_Ms > 65535 then
                  Dur_Ms := 65535;
               end if;

               Transpiler_Native_HAL.Emit_Raw
                 ("  dw "
                  & Trim_Image (Integer (Divisor))
                  & ", "
                  & Trim_Image (Integer (Dur_Ms)),
                  Success);
               Transpiler_Native_HAL.Emit_Newline (Success);
            end;
         end loop;

         Transpiler_Native_HAL.Set_Global_Buffer_Mode (False);
         Transpiler_Native_HAL.Emit_Raw ("  mov ax, " & Label_Base, Success);
         Transpiler_Native_HAL.Emit_Newline (Success);
         Transpiler_Native_HAL.Emit_Raw
           ("  mov cx, " & Trim_Image (Integer (Event_Count)),
            Success);
         Transpiler_Native_HAL.Emit_Newline (Success);
         Transpiler_Native_HAL.Emit_Raw ("  call ALB16_Play_Music_Score", Success);
         Transpiler_Native_HAL.Emit_Newline (Success);
      end Emit_Play_Music_FASM16;

      function Find_Parallel_Group (Name : String) return Natural is
         H : constant U32 := Hash_String (Name);
      begin
         for I in 1 .. Parallel_Group_Count loop
            if Parallel_Groups (I).Active
              and then Parallel_Groups (I).Name_Hash = H
              and then Parallel_Groups (I).Name_Len = Name'Length
              and then Parallel_Groups (I).Name (1 .. Name'Length) = Name
            then
               return I;
            end if;
         end loop;

         return 0;
      end Find_Parallel_Group;

      procedure Register_Parallel_Group
        (Name     : in String;
         Capacity : in Natural;
         Origin   : in Node_Index;
         Group_Idx : out Natural;
         Success  : in out Boolean;
         Diag     : in out Compiler_Diagnostic)
      is
      begin
         Group_Idx := Find_Parallel_Group (Name);
         if Group_Idx /= 0 then
            Fail_Node (Origin, Err_Type_Conflict, Name, Success, Diag);
            return;
         end if;

         if Parallel_Group_Count >= Max_Parallel_Groups then
            Fail_Node (Origin, Err_Mem_Out_Of_Bounds, Name, Success, Diag);
            return;
         end if;

         Parallel_Group_Count := Parallel_Group_Count + 1;
         Group_Idx := Parallel_Group_Count;

         Parallel_Groups (Group_Idx).Name_Hash := Hash_String (Name);
         Store_Name
           (Parallel_Groups (Group_Idx).Name,
            Parallel_Groups (Group_Idx).Name_Len,
            Name);
         Parallel_Groups (Group_Idx).Capacity := Capacity;
         Parallel_Groups (Group_Idx).Field_First := Parallel_Field_Count + 1;
         Parallel_Groups (Group_Idx).Field_Count := 0;
         Parallel_Groups (Group_Idx).Active := True;
      end Register_Parallel_Group;

      procedure Register_Parallel_Field
        (Group_Idx    : in Natural;
         Backing_Name : in String;
         Origin       : in Node_Index;
         Success      : in out Boolean;
         Diag         : in out Compiler_Diagnostic)
      is
      begin
         if Group_Idx = 0
           or else Group_Idx > Parallel_Group_Count
           or else not Parallel_Groups (Group_Idx).Active
         then
            Fail_Node (Origin, Err_Compiler_AST_Mismatch, Backing_Name, Success, Diag);
            return;
         end if;

         if Parallel_Field_Count >= Max_Parallel_Fields then
            Fail_Node (Origin, Err_Mem_Out_Of_Bounds, Backing_Name, Success, Diag);
            return;
         end if;

         Parallel_Field_Count := Parallel_Field_Count + 1;
         Parallel_Fields (Parallel_Field_Count).Backing_Hash := Hash_String (Backing_Name);
         Store_Name
           (Parallel_Fields (Parallel_Field_Count).Backing_Name,
            Parallel_Fields (Parallel_Field_Count).Backing_Len,
            Backing_Name);
         Parallel_Fields (Parallel_Field_Count).Active := True;
         Parallel_Groups (Group_Idx).Field_Count := Parallel_Groups (Group_Idx).Field_Count + 1;
      end Register_Parallel_Field;

      function Type_From_Lexeme (Lex : String) return ALB_Type_Tag is
         U : constant String := Upper_ASCII (Lex);
         T : ALB_Type_Tag := Type_None;
      begin
         T := Resolve_Type_Name (Lex);
         if T /= Type_None then
            return T;
         end if;

         declare
            R : constant Natural := Find_Range_Type (U);
         begin
            if R > 0 then
               return Range_Types (R).Base_Tag;
            end if;
         end;

         return Type_None;
      end Type_From_Lexeme;
      
      procedure Register_Range_Type
        (Node    : in Node_Index;
         Success : in out Boolean;
         Diag    : in out Compiler_Diagnostic)
      is
         Name_Node : constant Node_Index := Tree(Node).Left_Child;
         Base_Node : constant Node_Index := Tree(Node).Right_Child;
         Low_Node  : Node_Index := 0;
         High_Node : Node_Index := 0;

         Type_Name : constant String := Upper_ASCII(Raw_Lexeme(Tree(Name_Node).Token_Index));
         Base_Name : constant String := Upper_ASCII(Raw_Lexeme(Tree(Base_Node).Token_Index));
         Base_Tag  : ALB_Type_Tag := Type_None;

         Low_Val   : U64 := 0;
         High_Val  : U64 := 0;
         Found_Idx : Natural := 0;
      begin
         if Name_Node = 0 or else Base_Node = 0 then
            Fail_Node(Node, Err_Compiler_AST_Mismatch, "TYPE RANGE", Success, Diag);
            return;
         end if;

         Low_Node := Tree(Base_Node).Left_Child;
         if Low_Node /= 0 then
            High_Node := Tree(Low_Node).Next_Sibling;
         end if;

         if Low_Node = 0 or else High_Node = 0 then
            Fail_Node(Node, Err_Compiler_AST_Mismatch, "TYPE RANGE", Success, Diag);
            return;
         end if;

         Base_Tag := Type_From_Lexeme(Base_Name);

         if Base_Tag not in Type_U8 | Type_U16 | Type_U32 | Type_U64 | Type_Binary then
            Fail_Node(Node, Err_Type_Conflict, Base_Name, Success, Diag);
            return;
         end if;

         Comptime_Eval_Expr(Low_Node, Low_Val, Success, Diag);
         if not Success then return; end if;

         Comptime_Eval_Expr(High_Node, High_Val, Success, Diag);
         if not Success then return; end if;

         if High_Val < Low_Val then
            Fail_Node(Node, Err_Type_Conflict, Type_Name, Success, Diag);
            return;
         end if;

         if Base_Tag = Type_U8 and then High_Val > 255 then
            Fail_Node(Node, Err_Type_Conflict, Type_Name, Success, Diag);
            return;
         elsif Base_Tag = Type_U16 and then High_Val > 65535 then
            Fail_Node(Node, Err_Type_Conflict, Type_Name, Success, Diag);
            return;
         elsif Base_Tag = Type_U32 and then High_Val > 4294967295 then
            Fail_Node(Node, Err_Type_Conflict, Type_Name, Success, Diag);
            return;
         end if;

         for I in 1 .. Range_Type_Count loop
            if Range_Types(I).Active
              and then Range_Types(I).Name_Hash = Hash_String(Type_Name)
              and then Range_Types(I).Name_Len = Type_Name'Length
              and then Range_Types(I).Name(1 .. Type_Name'Length) = Type_Name
            then
               Found_Idx := I;
               exit;
            end if;
         end loop;

         if Found_Idx = 0 then
            if Range_Type_Count >= Max_Range_Types then
               Fail_Node(Node, Err_Mem_Out_Of_Bounds, "TYPE RANGE", Success, Diag);
               return;
            end if;

            Range_Type_Count := Range_Type_Count + 1;
            Found_Idx := Range_Type_Count;
         end if;

         Range_Types(Found_Idx).Name_Hash := Hash_String(Type_Name);
         Range_Types(Found_Idx).Name_Len := Type_Name'Length;
         Range_Types(Found_Idx).Name := (others => ' ');
         Range_Types(Found_Idx).Name(1 .. Type_Name'Length) := Type_Name;
         Range_Types(Found_Idx).Base_Tag := Base_Tag;
         Range_Types(Found_Idx).Low_Value := Low_Val;
         Range_Types(Found_Idx).High_Value := High_Val;
         Range_Types(Found_Idx).Is_String_Length := Base_Tag = Type_Binary;
         Range_Types(Found_Idx).Active := True;
      end Register_Range_Type;

      

      procedure Parse_Comptime_Decimal (Lexeme : in String; Value : out U64; Success : out Boolean) is
         Temp : U64 := 0;
      begin
         if Lexeme'Length > 0 and then Lexeme(Lexeme'First) = '-' then
            if Lexeme'Length = 1 then
               Success := False;
               Value := 0;
               return;
            end if;

            Parse_Decimal(Lexeme(Lexeme'First + 1 .. Lexeme'Last), Temp, Success);
            if Success then
               Value := 0 - Temp;
            else
               Value := 0;
            end if;
         else
            Parse_Decimal(Lexeme, Value, Success);
         end if;
      end Parse_Comptime_Decimal;

      function Find_Comptime_Scalar (Name : String) return Natural is
      begin
         for I in 1 .. Comptime_Scalar_Count loop
            if Comptime_Scalars(I).Active
              and then Comptime_Scalars(I).Name_Len = Name'Length
              and then Comptime_Scalars(I).Name(1 .. Name'Length) = Name
            then
               return I;
            end if;
         end loop;
         return 0;
      end Find_Comptime_Scalar;

      function Find_Comptime_Array (Name : String) return Natural is
      begin
         for I in 1 .. Comptime_Array_Count loop
            if Comptime_Arrays(I).Active
              and then Comptime_Arrays(I).Name_Len = Name'Length
              and then Comptime_Arrays(I).Name(1 .. Name'Length) = Name
            then
               return I;
            end if;
         end loop;
         return 0;
      end Find_Comptime_Array;

      function Find_Strict_Array (Name : String) return Natural is
         H : constant U32 := Hash_String (Name);
      begin
         for I in 1 .. Strict_Array_Count loop
            if Strict_Arrays(I).Active
              and then Strict_Arrays(I).Name_Hash = H
              and then Strict_Arrays(I).Name_Len = Name'Length
              and then Strict_Arrays(I).Name(1 .. Name'Length) = Name
            then
               return I;
            end if;
         end loop;

         return 0;
      end Find_Strict_Array;

      procedure Register_Strict_Array
        (Name      : in String;
         Size_Node : in Node_Index;
         Origin    : in Node_Index;
         Success   : in out Boolean;
         Diag      : in out Compiler_Diagnostic)
      is
         Curr_Bnd    : Node_Index := Size_Node;
         Dim_Count   : Natural := 0;
         Local_Dims  : Comptime_Dim_Array := (others => 0);
         Arr_Idx     : Natural := 0;
      begin
         while Curr_Bnd > 0 loop
            Dim_Count := Dim_Count + 1;

            if Dim_Count > Max_Comptime_Array_Dims then
               Fail_Node (Origin, Err_Compiler_AST_Mismatch, Name, Success, Diag);
               return;
            end if;

            declare
               Parsed_Size : U64 := 0;
            begin
               Comptime_Eval_Expr (Curr_Bnd, Parsed_Size, Success, Diag);
               if not Success
                 or else Parsed_Size = 0
                 or else Parsed_Size > U64 (Natural'Last)
               then
                  Fail_Node (Origin, Err_Mem_Out_Of_Bounds, Name, Success, Diag);
                  return;
               end if;

               Local_Dims(Dim_Count) := Natural (Parsed_Size);
            end;

            Curr_Bnd := Tree (Curr_Bnd).Next_Sibling;
         end loop;

         if Dim_Count = 0 then
            Fail_Node (Origin, Err_Compiler_AST_Mismatch, Name, Success, Diag);
            return;
         end if;

         Arr_Idx := Find_Strict_Array (Name);

         if Arr_Idx = 0 then
            if Strict_Array_Count >= Max_Strict_Arrays then
               Fail_Node (Origin, Err_Mem_Out_Of_Bounds, Name, Success, Diag);
               return;
            end if;

            Strict_Array_Count := Strict_Array_Count + 1;
            Arr_Idx := Strict_Array_Count;
         end if;

         Strict_Arrays(Arr_Idx).Name_Hash := Hash_String (Name);
         Store_Name (Strict_Arrays(Arr_Idx).Name, Strict_Arrays(Arr_Idx).Name_Len, Name);
         Strict_Arrays(Arr_Idx).Dim_Count := Dim_Count;
         Strict_Arrays(Arr_Idx).Dims := Local_Dims;
         Strict_Arrays(Arr_Idx).Active := True;
      end Register_Strict_Array;
      
      function Find_Slide_Array (Name : String) return Natural is
         H : constant U32 := Hash_String(Name);
      begin
         for I in 1 .. Slide_Array_Count loop
            if Slide_Arrays(I).Is_Used
              and then Slide_Arrays(I).Name_Hash = H
              and then Slide_Arrays(I).Name_Len = Name'Length
              and then Slide_Arrays(I).Name(1 .. Name'Length) = Name
            then
               return I;
            end if;
         end loop;

         return 0;
      end Find_Slide_Array;

      function Resolve_Existing_Name (Lexeme : String) return String is
         Scoped : constant String := Scoped_Lexeme (Lexeme);
         Raw    : constant String := FASM_Safe_Symbol (Lexeme);

         function Exists_For_Ref (Name : String) return Boolean is
            Found : Boolean := False;
            Sym   : Symbol_Record;
         begin
            Find_Symbol (Hash_String (Name), Current_Scope, Found, Sym);
            if not Found and then Current_Scope /= 0 then
               Find_Symbol (Hash_String (Name), 0, Found, Sym);
            end if;

            return Found
              or else Find_Strict_Array (Name) > 0
              or else Find_Slide_Array (Name) > 0
              or else Find_Parallel_Group (Name) > 0
              or else Find_Range_Array (Name) > 0
              or else Find_Range_Var (Name) > 0
              or else Find_Comptime_Array (Name) > 0;
         end Exists_For_Ref;
      begin
         if Exists_For_Ref (Scoped) then
            return Scoped;
         elsif Raw /= Scoped and then Exists_For_Ref (Raw) then
            return Raw;
         else
            return Scoped;
         end if;
      end Resolve_Existing_Name;

      procedure Register_Slide_Array
        (Name      : in String;
         Capacity  : in Natural;
         Active    : in Natural;
         Origin    : in Node_Index;
         Success   : in out Boolean;
         Diag      : in out Compiler_Diagnostic)
      is
         Arr_Idx : Natural := Find_Slide_Array(Name);
      begin
         if Capacity = 0 or else Active = 0 or else Active > Capacity then
            Fail_Node(Origin, Err_Mem_Out_Of_Bounds, Name, Success, Diag);
            return;
         end if;

         if Arr_Idx = 0 then
            if Slide_Array_Count >= Max_Slide_Arrays then
               Fail_Node(Origin, Err_Mem_Out_Of_Bounds, Name, Success, Diag);
               return;
            end if;

            Slide_Array_Count := Slide_Array_Count + 1;
            Arr_Idx := Slide_Array_Count;
         end if;

         Slide_Arrays(Arr_Idx).Name_Hash := Hash_String(Name);
         Store_Name(Slide_Arrays(Arr_Idx).Name, Slide_Arrays(Arr_Idx).Name_Len, Name);
         Slide_Arrays(Arr_Idx).Capacity := Capacity;
         Slide_Arrays(Arr_Idx).Active := Active;
         Slide_Arrays(Arr_Idx).Is_Used := True;
      end Register_Slide_Array;

      procedure Remember_Array_Element_Tag
        (Name : in String;
         Tag  : in ALB_Type_Tag)
      is
         Strict_Idx : constant Natural := Find_Strict_Array (Name);
         Slide_Idx  : constant Natural := Find_Slide_Array (Name);
      begin
         if Strict_Idx > 0 then
            Strict_Arrays (Strict_Idx).Element_Tag := Tag;
         end if;

         if Slide_Idx > 0 then
            Slide_Arrays (Slide_Idx).Element_Tag := Tag;
         end if;
      end Remember_Array_Element_Tag;

      function Array_Declared_Tag
        (Name     : String;
         Fallback : ALB_Type_Tag) return ALB_Type_Tag
      is
         Strict_Idx : constant Natural := Find_Strict_Array (Name);
         Slide_Idx  : constant Natural := Find_Slide_Array (Name);
      begin
         if Strict_Idx > 0
           and then Strict_Arrays (Strict_Idx).Element_Tag /= Type_None
         then
            return Strict_Arrays (Strict_Idx).Element_Tag;
         elsif Slide_Idx > 0
           and then Slide_Arrays (Slide_Idx).Element_Tag /= Type_None
         then
            return Slide_Arrays (Slide_Idx).Element_Tag;
         else
            return Fallback;
         end if;
      end Array_Declared_Tag;

      procedure Validate_Slide_Array_Literal_Indexes
        (Array_Name       : in String;
         First_Index_Node : in Node_Index;
         Origin           : in Node_Index;
         Success          : in out Boolean;
         Diag             : in out Compiler_Diagnostic)
      is
         Arr_Idx    : Natural := Find_Slide_Array(Array_Name);
         Curr_Index : Node_Index := First_Index_Node;
         Dim_Count  : Natural := 0;
         Lit_Val    : U64 := 0;
      begin
         if Arr_Idx = 0 then
            return;
         end if;

         while Curr_Index > 0 loop
            Dim_Count := Dim_Count + 1;

            if Dim_Count > 1 then
               Fail_Node(Origin, Err_Mem_Out_Of_Bounds, Array_Name, Success, Diag);
               return;
            end if;

            if Try_Literal_U64(Curr_Index, Lit_Val) then
               if Lit_Val = 0
                 or else Lit_Val > U64(Slide_Arrays(Arr_Idx).Active)
               then
                  Fail_Node(Curr_Index, Err_Mem_Out_Of_Bounds, Array_Name, Success, Diag);
                  return;
               end if;
            end if;

            Curr_Index := Tree(Curr_Index).Next_Sibling;
         end loop;

         if Dim_Count /= 1 then
            Fail_Node(Origin, Err_Mem_Out_Of_Bounds, Array_Name, Success, Diag);
            return;
         end if;
      end Validate_Slide_Array_Literal_Indexes;

      
      
      procedure Validate_Strict_Array_Literal_Indexes
        (Array_Name       : in String;
         First_Index_Node : in Node_Index;
         Origin           : in Node_Index;
         Success          : in out Boolean;
         Diag             : in out Compiler_Diagnostic)
      is
         Arr_Idx    : Natural := Find_Strict_Array(Array_Name);
         Curr_Index : Node_Index := First_Index_Node;
         Dim_No     : Natural := 0;
         Lit_Val    : U64 := 0;
      begin
         if Arr_Idx = 0 then
            return;
         end if;

         while Curr_Index > 0 loop
            Dim_No := Dim_No + 1;

            if Dim_No > Strict_Arrays(Arr_Idx).Dim_Count then
               Fail_Node(Origin, Err_Mem_Out_Of_Bounds, Array_Name, Success, Diag);
               return;
            end if;

            if Try_Literal_U64(Curr_Index, Lit_Val) then
               if Lit_Val = 0
                 or else Lit_Val > U64(Strict_Arrays(Arr_Idx).Dims(Dim_No))
               then
                  Fail_Node(Curr_Index, Err_Mem_Out_Of_Bounds, Array_Name, Success, Diag);
                  return;
               end if;
            end if;

            Curr_Index := Tree(Curr_Index).Next_Sibling;
         end loop;

         if Dim_No < Strict_Arrays(Arr_Idx).Dim_Count then
            Fail_Node(Origin, Err_Mem_Out_Of_Bounds, Array_Name, Success, Diag);
            return;
         end if;
      end Validate_Strict_Array_Literal_Indexes;


      

      function Is_Comptime_Baked (Name : String) return Boolean is
         Scalar_Idx : constant Natural := Find_Comptime_Scalar(Name);
      begin
         return Find_Comptime_Array(Name) > 0
           or else (Scalar_Idx > 0 and then Comptime_Scalars(Scalar_Idx).Exported);
      end Is_Comptime_Baked;

      procedure Ensure_Comptime_Global
        (Name     : in String;
         Tag      : in ALB_Type_Tag;
         Origin   : in Node_Index;
         Success  : in out Boolean;
         Diag     : in out Compiler_Diagnostic) is
         Found         : Boolean;
         Dummy_Sym     : Symbol_Record;
         Local_Success : Boolean;
      begin
         Find_Symbol(Hash_String(Name), 0, Found, Dummy_Sym);
         if not Found then
            Add_Global_Symbol(Hash_String(Name), Tag, (Target_None, 0), 0, 0, Local_Success);
            if not Local_Success then
               Fail_Node(Origin, Err_Mem_Out_Of_Bounds, Name, Success, Diag);
            end if;
         end if;
      end Ensure_Comptime_Global;
      
      function Find_Temporal (Name : String) return Natural is
      begin
         for I in 1 .. Temporal_Count loop
            if Temporal_Entries(I).Active
              and then Temporal_Entries(I).Name_Len = Name'Length
              and then Temporal_Entries(I).Name(1 .. Name'Length) = Name
            then
               return I;
            end if;
         end loop;

         return 0;
      end Find_Temporal;

      procedure Register_Temporal_Global
        (Name          : in String;
         Tag           : in ALB_Type_Tag;
         History_Depth : in Natural;
         Origin        : in Node_Index;
         Success       : in out Boolean;
         Diag          : in out Compiler_Diagnostic)
      is
         Found         : Boolean := False;
         Dummy_Sym     : Symbol_Record;
         Local_Success : Boolean := True;
      begin
         if Name'Length > 128 then
            Fail_Node (Origin, Err_Mem_Out_Of_Bounds, Name, Success, Diag);
            return;
         end if;

         if Find_Temporal (Name) > 0 then
            Fail_Node (Origin, Err_Type_Conflict, Name, Success, Diag);
            return;
         end if;

         Find_Symbol (Hash_String (Name), 0, Found, Dummy_Sym);
         if Found then
            Fail_Node (Origin, Err_Type_Conflict, Name, Success, Diag);
            return;
         end if;

         if Temporal_Count >= Max_Temporal_Entries then
            Fail_Node (Origin, Err_Mem_Out_Of_Bounds, Name, Success, Diag);
            return;
         end if;

         Add_Global_Symbol
           (Hash_String (Name),
            Tag,
            (Target => Target_Variable, Index => 0),
            0,
            0,
            Local_Success);

         if not Local_Success then
            Fail_Node (Origin, Err_Mem_Out_Of_Bounds, Name, Success, Diag);
            return;
         end if;

         Temporal_Count := Temporal_Count + 1;
         Temporal_Entries(Temporal_Count).Name_Hash := Hash_String (Name);
         Store_Name
           (Temporal_Entries(Temporal_Count).Name,
            Temporal_Entries(Temporal_Count).Name_Len,
            Name);
         Temporal_Entries(Temporal_Count).Tag := Tag;
         Temporal_Entries(Temporal_Count).History_Depth := History_Depth;
         Temporal_Entries(Temporal_Count).Active := True;
         Temporal_Used := True;
      end Register_Temporal_Global;


      procedure Register_Chrono_Global
        (Name          : in String;
         Needs_Address : in Boolean;
         Origin        : in Node_Index;
         Success       : in out Boolean;
         Diag          : in out Compiler_Diagnostic) is
      begin
         for I in 1 .. Chrono_Count loop
            if Chrono_Entries(I).Active
              and then Chrono_Entries(I).Name_Len = Name'Length
              and then Chrono_Entries(I).Name(1 .. Name'Length) = Name
            then
               Chrono_Entries(I).Needs_Address := Needs_Address;
               return;
            end if;
         end loop;

         if Chrono_Count >= Max_Chrono_Entries then
            Fail_Node(Origin, Err_Mem_Out_Of_Bounds, Name, Success, Diag);
            return;
         end if;

         Chrono_Count := Chrono_Count + 1;
         Chrono_Entries(Chrono_Count).Name_Hash := Hash_String(Name);
         Store_Name(Chrono_Entries(Chrono_Count).Name, Chrono_Entries(Chrono_Count).Name_Len, Name);
         Chrono_Entries(Chrono_Count).Needs_Address := Needs_Address;
         Chrono_Entries(Chrono_Count).Active := True;
      end Register_Chrono_Global;

      procedure Put_Comptime_Scalar
        (Name     : in String;
         Tag      : in ALB_Type_Tag;
         Value    : in U64;
         Exported : in Boolean;
         Origin   : in Node_Index;
         Success  : in out Boolean;
         Diag     : in out Compiler_Diagnostic) is
         Idx      : Natural := Find_Comptime_Scalar(Name);
         Real_Tag : ALB_Type_Tag := Tag;
      begin
         if Idx = 0 then
            if Comptime_Scalar_Count >= Max_Comptime_Scalars then
               Fail_Node(Origin, Err_Mem_Out_Of_Bounds, Name, Success, Diag);
               return;
            end if;

            if Real_Tag = Type_None then
               Real_Tag := Type_U64;
            end if;

            Comptime_Scalar_Count := Comptime_Scalar_Count + 1;
            Idx := Comptime_Scalar_Count;

            Comptime_Scalars(Idx).Name_Hash := Hash_String(Name);
            Store_Name(Comptime_Scalars(Idx).Name, Comptime_Scalars(Idx).Name_Len, Name);
            Comptime_Scalars(Idx).Tag := Real_Tag;
            Comptime_Scalars(Idx).Active := True;
         else
            if Real_Tag = Type_None then
               Real_Tag := Comptime_Scalars(Idx).Tag;
            end if;
            Comptime_Scalars(Idx).Tag := Real_Tag;
         end if;

         Comptime_Scalars(Idx).Value := Value;

         if Exported then
            Comptime_Scalars(Idx).Exported := True;
            Ensure_Comptime_Global(Name, Comptime_Scalars(Idx).Tag, Origin, Success, Diag);
         end if;
      end Put_Comptime_Scalar;

      procedure Resolve_Comptime_Array_Index
        (Array_Idx : in Natural;
         Index_Node: in Node_Index;
         Origin    : in Node_Index;
         Flat      : out Natural;
         Success   : in out Boolean;
         Diag      : in out Compiler_Diagnostic) is
         Curr_Idx   : Node_Index := Index_Node;
         Index_Val  : U64 := 0;
         Flat_Index : Natural := 0;
      begin
         Flat := 0;

         if Array_Idx = 0 then
            Fail_Node(Origin, Err_Compiler_AST_Mismatch, "COMPTIME_ARRAY", Success, Diag);
            return;
         end if;

         for I in 1 .. Comptime_Arrays(Array_Idx).Dim_Count loop
            if Curr_Idx = 0 then
               Fail_Node(Origin, Err_Compiler_AST_Mismatch, Comptime_Arrays(Array_Idx).Name(1 .. Comptime_Arrays(Array_Idx).Name_Len), Success, Diag);
               return;
            end if;

            Comptime_Eval_Expr(Curr_Idx, Index_Val, Success, Diag);
            if not Success then return; end if;

            if Index_Val >= U64(Comptime_Arrays(Array_Idx).Dims(I)) then
               Fail_Node(Origin, Err_Mem_Out_Of_Bounds, Comptime_Arrays(Array_Idx).Name(1 .. Comptime_Arrays(Array_Idx).Name_Len), Success, Diag);
               return;
            end if;

            Flat_Index := Flat_Index * Comptime_Arrays(Array_Idx).Dims(I) + Natural(Index_Val);
            Curr_Idx := Tree(Curr_Idx).Next_Sibling;
         end loop;

         if Curr_Idx /= 0 then
            Fail_Node(Origin, Err_Compiler_AST_Mismatch, Comptime_Arrays(Array_Idx).Name(1 .. Comptime_Arrays(Array_Idx).Name_Len), Success, Diag);
            return;
         end if;

         Flat := Flat_Index;
      end Resolve_Comptime_Array_Index;

      procedure Define_Comptime_Array
        (Name     : in String;
         Dim_Node : in Node_Index;
         Origin   : in Node_Index;
         Success  : in out Boolean;
         Diag     : in out Compiler_Diagnostic) is
         Curr_Dim      : Node_Index := Dim_Node;
         Parsed        : U64 := 0;
         Element_Count : U64 := 1;
         Dim_Count     : Natural := 0;
         Arr_Idx       : Natural := 0;
      begin
         if Find_Comptime_Scalar(Name) > 0 or else Find_Comptime_Array(Name) > 0 then
            Fail_Node(Origin, Err_Type_Conflict, Name, Success, Diag);
            return;
         end if;

         while Curr_Dim /= 0 loop
            Dim_Count := Dim_Count + 1;
            if Dim_Count > Max_Comptime_Array_Dims then
               Fail_Node(Origin, Err_Mem_Out_Of_Bounds, Name, Success, Diag);
               return;
            end if;

            Comptime_Eval_Expr(Curr_Dim, Parsed, Success, Diag);
            if not Success then return; end if;

            if Parsed = 0 then
               Fail_Node(Origin, Err_Type_Conflict, Name, Success, Diag);
               return;
            end if;

            if Parsed /= 0 and then Element_Count > U64(Max_Comptime_Array_Values) / Parsed then
               Fail_Node(Origin, Err_Mem_Out_Of_Bounds, Name, Success, Diag);
               return;
            end if;

            Element_Count := Element_Count * Parsed;
            Curr_Dim := Tree(Curr_Dim).Next_Sibling;
         end loop;

         if Dim_Count = 0 then
            Fail_Node(Origin, Err_Compiler_AST_Mismatch, Name, Success, Diag);
            return;
         end if;

         if Element_Count = 0 or else Natural(Element_Count) > Max_Comptime_Array_Values - Comptime_Data_Top then
            Fail_Node(Origin, Err_Mem_Out_Of_Bounds, Name, Success, Diag);
            return;
         end if;

         if Comptime_Array_Count >= Max_Comptime_Arrays then
            Fail_Node(Origin, Err_Mem_Out_Of_Bounds, Name, Success, Diag);
            return;
         end if;

         Comptime_Array_Count := Comptime_Array_Count + 1;
         Arr_Idx := Comptime_Array_Count;

         Comptime_Arrays(Arr_Idx).Name_Hash := Hash_String(Name);
         Store_Name(Comptime_Arrays(Arr_Idx).Name, Comptime_Arrays(Arr_Idx).Name_Len, Name);
         Comptime_Arrays(Arr_Idx).Dim_Count := Dim_Count;
         Comptime_Arrays(Arr_Idx).Element_Count := Natural(Element_Count);
         Comptime_Arrays(Arr_Idx).Data_First := Comptime_Data_Top + 1;
         Comptime_Arrays(Arr_Idx).Active := True;

         Curr_Dim := Dim_Node;
         for I in 1 .. Dim_Count loop
            Comptime_Eval_Expr(Curr_Dim, Parsed, Success, Diag);
            if not Success then return; end if;
            Comptime_Arrays(Arr_Idx).Dims(I) := Natural(Parsed);
            Curr_Dim := Tree(Curr_Dim).Next_Sibling;
         end loop;

         Comptime_Data_Top := Comptime_Data_Top + Natural(Element_Count);
         for I in Comptime_Arrays(Arr_Idx).Data_First .. Comptime_Data_Top loop
            Comptime_Array_Data(I) := 0;
         end loop;

         Ensure_Comptime_Global(Name, Type_U64, Origin, Success, Diag);
      end Define_Comptime_Array;

      procedure Comptime_Eval_Expr
        (Node    : in Node_Index;
         Value   : out U64;
         Success : in out Boolean;
         Diag    : in out Compiler_Diagnostic) is
         Left_Value  : U64 := 0;
         Right_Value : U64 := 0;
      begin
         Value := 0;

         if not Success or else Node = 0 then
            return;
         end if;

         case Tree(Node).Kind is
            when AST_Number_Expr =>
               declare
                  Lexeme   : constant String := Raw_Lexeme(Tree(Node).Token_Index);
                  Parse_OK : Boolean := False;
               begin
                  Parse_Comptime_Decimal(Lexeme, Value, Parse_OK);
                  if not Parse_OK then
                     Fail_Node(Node, Err_Compiler_AST_Mismatch, Lexeme, Success, Diag);
                  end if;
               end;

            when AST_Hex_Expr =>
               declare
                  Lexeme   : constant String := Raw_Lexeme(Tree(Node).Token_Index);
                  Parse_OK : Boolean := False;
               begin
                  Parse_Hex(Lexeme, Value, Parse_OK);
                  if not Parse_OK then
                     Fail_Node(Node, Err_Compiler_AST_Mismatch, Lexeme, Success, Diag);
                  end if;
               end;

            when AST_Bin_Expr =>
               declare
                  Lexeme   : constant String := Raw_Lexeme(Tree(Node).Token_Index);
                  Parse_OK : Boolean := False;
               begin
                  Parse_Binary(Lexeme, Value, Parse_OK);
                  if not Parse_OK then
                     Fail_Node(Node, Err_Compiler_AST_Mismatch, Lexeme, Success, Diag);
                  end if;
               end;

            when AST_Octal_Expr =>
               declare
                  Lexeme   : constant String := Raw_Lexeme(Tree(Node).Token_Index);
                  Parse_OK : Boolean := False;
               begin
                  Parse_Octal(Lexeme, Value, Parse_OK);
                  if not Parse_OK then
                     Fail_Node(Node, Err_Compiler_AST_Mismatch, Lexeme, Success, Diag);
                  end if;
               end;

            when AST_True =>
               Value := 1;

            when AST_False =>
               Value := 0;

            when AST_Const_Ref =>
               declare
                  Lexeme : constant String := Raw_Lexeme(Tree(Node).Token_Index);
                  H      : constant U32 := Hash_String(Lexeme);
                  Found  : Boolean := False;
               begin
                  for I in 1 .. Const_Count loop
                     if Const_Vault(I).Hash = H then
                        Value := Const_Vault(I).Val;
                        Found := True;
                        exit;
                     end if;
                  end loop;

                  if not Found then
                     Fail_Node(Node, Err_Compiler_AST_Mismatch, Lexeme, Success, Diag);
                  end if;
               end;

            when AST_Var_Expr =>
               declare
                  Name       : constant String := Raw_Lexeme(Tree(Node).Token_Index);
                  Scalar_Idx : constant Natural := Find_Comptime_Scalar(Name);
                  Array_Idx  : constant Natural := Find_Comptime_Array(Name);
                  Flat       : Natural := 0;
               begin
                  if Tree(Node).Left_Child /= 0 then
                     if Array_Idx = 0 then
                        Fail_Node(Node, Err_Compiler_AST_Mismatch, Name, Success, Diag);
                        return;
                     end if;

                     Resolve_Comptime_Array_Index(Array_Idx, Tree(Node).Left_Child, Node, Flat, Success, Diag);
                     if not Success then return; end if;

                     Value := Comptime_Array_Data(Comptime_Arrays(Array_Idx).Data_First + Flat);
                  else
                     if Scalar_Idx = 0 then
                        Fail_Node(Node, Err_Compiler_AST_Mismatch, Name, Success, Diag);
                        return;
                     end if;

                     Value := Comptime_Scalars(Scalar_Idx).Value;
                  end if;
               end;

            when AST_Unary_Minus =>
               Comptime_Eval_Expr(Tree(Node).Left_Child, Left_Value, Success, Diag);
               if not Success then return; end if;
               Value := 0 - Left_Value;

            when AST_Not =>
               Comptime_Eval_Expr(Tree(Node).Left_Child, Left_Value, Success, Diag);
               if not Success then return; end if;
               Value := (if Left_Value = 0 then 1 else 0);

            when AST_BinOp =>
               Comptime_Eval_Expr(Tree(Node).Left_Child, Left_Value, Success, Diag);
               if not Success then return; end if;

               Comptime_Eval_Expr(Tree(Node).Right_Child, Right_Value, Success, Diag);
               if not Success then return; end if;

                case Tokens(Tree(Node).Token_Index).Kind is
                   when TOK_PLUS =>
                      Value := Left_Value + Right_Value;
                      if Exact_Depth > 0 and then Value < Left_Value then
                         Fail_Node(Node, Err_Type_Conflict, "EXACT_ADD_OVERFLOW", Success, Diag);
                         return;
                      end if;
                   when TOK_MINUS =>
                      if Exact_Depth > 0 and then Right_Value > Left_Value then
                         Fail_Node(Node, Err_Type_Conflict, "EXACT_SUB_UNDERFLOW", Success, Diag);
                         return;
                      end if;
                      Value := Left_Value - Right_Value;
                   when TOK_MUL =>
                      Value := Left_Value * Right_Value;
                      if Exact_Depth > 0 and then Right_Value /= 0
                        and then Value / Right_Value /= Left_Value
                      then
                         Fail_Node(Node, Err_Type_Conflict, "EXACT_MUL_OVERFLOW", Success, Diag);
                         return;
                      end if;
                   when TOK_DIV =>
                      if Right_Value = 0 then
                         Fail_Node(Node, Err_Type_Conflict, "DIV0", Success, Diag);
                         return;
                      end if;
                      Value := Left_Value / Right_Value;
                      if Exact_Depth > 0 and then Left_Value mod Right_Value /= 0 then
                         Fail_Node(Node, Err_Type_Conflict, "EXACT_DIV_REMAINDER", Success, Diag);
                         return;
                      end if;
                   when TOK_MOD =>
                      if Right_Value = 0 then
                         Fail_Node(Node, Err_Type_Conflict, "MOD0", Success, Diag);
                         return;
                      end if;
                      Value := Left_Value mod Right_Value;
                   when TOK_AND =>
                      Value := Left_Value and Right_Value;
                   when TOK_OR =>
                      Value := Left_Value or Right_Value;
                   when TOK_XOR =>
                      Value := Left_Value xor Right_Value;
                  when TOK_SHL =>
                     if Right_Value > 63 then
                        Value := 0;
                     else
                        Value := Left_Value;
                        for I in 1 .. Natural(Right_Value) loop
                           Value := Value * 2;
                        end loop;
                     end if;
                  when TOK_SHR =>
                     if Right_Value > 63 then
                        Value := 0;
                     else
                        Value := Left_Value;
                        for I in 1 .. Natural(Right_Value) loop
                           Value := Value / 2;
                        end loop;
                     end if;
                  when TOK_ASSIGN | TOK_EQUAL =>
                     Value := (if Left_Value = Right_Value then 1 else 0);
                  when TOK_NOT_EQUAL =>
                     Value := (if Left_Value /= Right_Value then 1 else 0);
                  when TOK_LESS =>
                     Value := (if Left_Value < Right_Value then 1 else 0);
                  when TOK_GREATER =>
                     Value := (if Left_Value > Right_Value then 1 else 0);
                  when TOK_LESS_EQUAL =>
                     Value := (if Left_Value <= Right_Value then 1 else 0);
                  when TOK_GREATER_EQUAL =>
                     Value := (if Left_Value >= Right_Value then 1 else 0);
                  when others =>
                     Fail_Node(Node, Err_Compiler_AST_Mismatch, "COMPTIME_EXPR", Success, Diag);
               end case;

            when others =>
               Fail_Node(Node, Err_Compiler_AST_Mismatch, "COMPTIME_EXPR", Success, Diag);
         end case;
      end Comptime_Eval_Expr;

      procedure Comptime_Execute
        (Node    : in Node_Index;
         Success : in out Boolean;
         Diag    : in out Compiler_Diagnostic) is
         procedure Comptime_Print_Chain
           (Print_Node   : in Node_Index;
            Add_Newline  : in Boolean) is
            Curr       : Node_Index := Print_Node;
            Expr_Node  : Node_Index := 0;
            Value      : U64 := 0;

            function Img (N : U64) return String is
               Raw : constant String := U64'Image (N);
            begin
               if Raw'Length > 0 and then Raw (Raw'First) = ' ' then
                  return Raw (Raw'First + 1 .. Raw'Last);
               else
                  return Raw;
               end if;
            end Img;
         begin
            while Curr /= 0 loop
               Expr_Node := Tree (Curr).Left_Child;

               if Expr_Node = 0 then
                  Fail_Node (Curr, Err_Compiler_AST_Mismatch, "COMPTIME_PRINT", Success, Diag);
                  return;
               end if;

               if Tree (Expr_Node).Kind = AST_String_Expr then
                  Ada.Text_IO.Put (Strip_String_Node (Expr_Node));
               else
                  Comptime_Eval_Expr (Expr_Node, Value, Success, Diag);
                  if not Success then
                     return;
                  end if;

                  Ada.Text_IO.Put (Img (Value));
               end if;

               Curr := Tree (Curr).Right_Child;
            end loop;

            if Add_Newline then
               Ada.Text_IO.New_Line;
            end if;
         end Comptime_Print_Chain;
      begin
         if not Success or else Node = 0 then
            return;
         end if;

         case Tree(Node).Kind is
            when AST_Program | AST_Block_Stmt =>
               declare
                  Curr : Node_Index := Tree(Node).Left_Child;
               begin
                  while Curr /= 0 loop
                     Comptime_Execute(Curr, Success, Diag);
                     if not Success then return; end if;
                     Curr := Tree(Curr).Next_Sibling;
                  end loop;
               end;

            when AST_Comptime_Block =>
               Comptime_Execute(Tree(Node).Left_Child, Success, Diag);

            when AST_Print_Stmt =>
               Comptime_Print_Chain (Node, True);

            when AST_Print_Str_Stmt =>
               Comptime_Print_Chain (Node, False);

            when AST_Const_Decl =>
               declare
                  Ref_Node    : constant Node_Index := Tree(Node).Left_Child;
                  Value_Node  : constant Node_Index := Tree(Node).Right_Child;
                  Ref_Name    : constant String := Raw_Lexeme(Tree(Ref_Node).Token_Index);
                  H           : constant U32 := Hash_String(Ref_Name);
                  Val         : U64 := 0;
                  Replaced    : Boolean := False;
               begin
                  Comptime_Eval_Expr(Value_Node, Val, Success, Diag);
                  if not Success then return; end if;

                  for I in 1 .. Const_Count loop
                     if Const_Vault(I).Hash = H then
                        Const_Vault(I).Val := Val;
                        Replaced := True;
                        exit;
                     end if;
                  end loop;

                  if not Replaced then
                     if Const_Count >= Max_Consts then
                        Fail_Node(Node, Err_Mem_Out_Of_Bounds, Ref_Name, Success, Diag);
                        return;
                     end if;

                     Const_Count := Const_Count + 1;
                     Const_Vault(Const_Count) := (H, Val);
                  end if;
               end;

            when AST_Strict_Stmt =>
               declare
                  Name_Node : constant Node_Index := Tree(Node).Left_Child;
                  Name      : constant String := Raw_Lexeme(Tree(Name_Node).Token_Index);
               begin
                  Define_Comptime_Array(Name, Tree(Node).Right_Child, Node, Success, Diag);
               end;

            when AST_Let_Stmt =>
               declare
                  Target_Node : constant Node_Index := Tree(Node).Left_Child;
                  RHS_Node    : constant Node_Index := Tree(Node).Right_Child;
                  Name        : constant String := Raw_Lexeme(Tree(Target_Node).Token_Index);
                  Value       : U64 := 0;
                  Flat        : Natural := 0;
                  Tag         : ALB_Type_Tag := Type_None;
                  Array_Idx   : Natural := 0;
                  Baked_Scalar : Natural := 0;
               begin
                  if Tree(Target_Node).Kind /= AST_Var_Expr then
                     Fail_Node(Node, Err_Compiler_AST_Mismatch, Name, Success, Diag);
                     return;
                  end if;

                  if Tree(Node).Token_Index > 0 then
                     Tag := Type_From_Lexeme(Raw_Lexeme(Tree(Node).Token_Index));
                     if Tag = Type_None then
                        Fail_Node(Node, Err_Type_Conflict, Name, Success, Diag);
                        return;
                     end if;
                  end if;

                  if RHS_Node /= 0 then
                     Comptime_Eval_Expr(RHS_Node, Value, Success, Diag);
                     if not Success then return; end if;
                  end if;

                  if Tree(Target_Node).Left_Child = 0 then
                     Put_Comptime_Scalar(Name, Tag, Value, True, Node, Success, Diag);
                  else
                     Array_Idx := Find_Comptime_Array(Name);
                     if Array_Idx = 0 then
                        Fail_Node(Node, Err_Compiler_AST_Mismatch, Name, Success, Diag);
                        return;
                     end if;

                     Resolve_Comptime_Array_Index(Array_Idx, Tree(Target_Node).Left_Child, Node, Flat, Success, Diag);
                     if not Success then return; end if;

                     Comptime_Array_Data(Comptime_Arrays(Array_Idx).Data_First + Flat) := Value;
                  end if;
               end;

            when AST_If_Stmt =>
               declare
                  Cond_Node : constant Node_Index := Tree(Node).Left_Child;
                  Body_Node : constant Node_Index := Tree(Node).Right_Child;
                  Else_Node : Node_Index := 0;
                  Cond_Val  : U64 := 0;
               begin
                  if Body_Node /= 0 then
                     Else_Node := Tree(Body_Node).Next_Sibling;
                  end if;

                  Comptime_Eval_Expr(Cond_Node, Cond_Val, Success, Diag);
                  if not Success then return; end if;

                  if Cond_Val /= 0 then
                     Comptime_Execute(Body_Node, Success, Diag);
                  elsif Else_Node /= 0 then
                     Comptime_Execute(Else_Node, Success, Diag);
                  end if;
               end;

            when AST_While_Stmt =>
               declare
                  Cond_Val : U64 := 0;
               begin
                  for I in 1 .. Max_Comptime_Loop_Steps loop
                     Comptime_Eval_Expr(Tree(Node).Left_Child, Cond_Val, Success, Diag);
                     if not Success then return; end if;
                     exit when Cond_Val = 0;

                     Comptime_Execute(Tree(Node).Right_Child, Success, Diag);
                     if not Success then return; end if;
                  end loop;

                  Comptime_Eval_Expr(Tree(Node).Left_Child, Cond_Val, Success, Diag);
                  if Success and then Cond_Val /= 0 then
                     Fail_Node(Node, Err_Call_Stack_Overflow, "COMPTIME_WHILE", Success, Diag);
                  end if;
               end;

            when AST_For_Stmt =>
               declare
                  Loop_Name  : constant String := Raw_Lexeme(Tree(Node).Token_Index);
                  Dummy_Node : constant Node_Index := Tree(Node).Left_Child;
                  Start_Node : constant Node_Index := Tree(Dummy_Node).Left_Child;
                  End_Node   : constant Node_Index := Tree(Dummy_Node).Right_Child;
                  Body_Node  : constant Node_Index := Tree(Node).Right_Child;
                  Real_End   : Node_Index := End_Node;
                  Step_Node  : Node_Index := 0;
                  Start_Val  : U64 := 0;
                  End_Val    : U64 := 0;
                  Step_Val   : U64 := 1;
                  Curr_Val   : U64 := 0;
               begin
                  if Tree(End_Node).Kind = AST_Arg_List then
                     Real_End := Tree(End_Node).Left_Child;
                     Step_Node := Tree(Real_End).Next_Sibling;
                  end if;

                  Comptime_Eval_Expr(Start_Node, Start_Val, Success, Diag);
                  if not Success then return; end if;

                  Comptime_Eval_Expr(Real_End, End_Val, Success, Diag);
                  if not Success then return; end if;

                  if Step_Node /= 0 then
                     Comptime_Eval_Expr(Step_Node, Step_Val, Success, Diag);
                     if not Success then return; end if;
                  end if;

                  if Step_Val = 0 then
                     Fail_Node(Node, Err_Type_Conflict, "STEP0", Success, Diag);
                     return;
                  end if;

                  Curr_Val := Start_Val;
                  for I in 1 .. Max_Comptime_Loop_Steps loop
                     exit when Curr_Val > End_Val;

                     Put_Comptime_Scalar(Loop_Name, Type_U64, Curr_Val, False, Node, Success, Diag);
                     if not Success then return; end if;

                     Comptime_Execute(Body_Node, Success, Diag);
                     if not Success then return; end if;

                     exit when Curr_Val > U64'Last - Step_Val;
                     Curr_Val := Curr_Val + Step_Val;
                  end loop;

                  if Curr_Val <= End_Val then
                     Fail_Node(Node, Err_Call_Stack_Overflow, Loop_Name, Success, Diag);
                  end if;
               end;

            when others =>
               Fail_Node(Node, Err_Compiler_AST_Mismatch, "COMPTIME_STMT", Success, Diag);
         end case;
      end Comptime_Execute;

