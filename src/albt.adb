                           end if;
                        else
                        -- (Original C logic here)
                           Transpiler_Native_HAL.Emit_Expression_Open (Success);
                           
                           declare
                              Needs_Cast : Boolean := (Mapped_Op in OP_CMP_LT .. OP_CMP_GTE or Mapped_Op = OP_DIV);
                           begin
                              if Needs_Cast then Transpiler_Native_HAL.Emit_Raw ("(int64_t)(", Success); end if;
