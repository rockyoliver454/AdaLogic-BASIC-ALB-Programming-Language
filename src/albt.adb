                           Transpiler_Native_HAL.Emit_Raw ("  movzx rax, al", Success);
                        elsif Mapped_Op = OP_CMP_LTE then
                           Transpiler_Native_HAL.Emit_Raw ("  cmp rax, rbx", Success); Transpiler_Native_HAL.Emit_Newline (Success);
                           Transpiler_Native_HAL.Emit_Raw ("  setle al", Success); Transpiler_Native_HAL.Emit_Newline (Success);
                           Transpiler_Native_HAL.Emit_Raw ("  movzx rax, al", Success);
                         elsif Mapped_Op = OP_CMP_GTE then
