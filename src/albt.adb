            --        else
            --           if Target_Node > 0 then
            --              Transpiler_Native_HAL.Emit_Raw ("fgets((char*)(uintptr_t)(", Success);
            --              Walk_AST (Target_Node, Depth + 1, Right_Tag, Success, Diag);
            --              Transpiler_Native_HAL.Emit_Raw ("), 2048, stdin)", Success);
            --           else
            --              Transpiler_Native_HAL.Emit_Raw ("{ static char _rl_buf[2]; fgets(_rl_buf, 2, stdin); }", Success);
            --           end if;
            --        end if;
            --        Out_Tag := Type_None;
            --     end;
            
           when AST_Readline_Stmt =>
               declare
                  Target_Node : Node_Index := Tree (Node).Left_Child;
                  Idx_Str     : String := Natural'Image (Node);
                  Clean_Idx   : String (1 .. Idx_Str'Length - 1) :=
                    Idx_Str (2 .. Idx_Str'Length);
                  Ok_Lbl      : constant String := ".alb_readline_ok_" & Clean_Idx;
                  Done_Lbl    : constant String := ".alb_readline_done_" & Clean_Idx;
               begin
                  if Target = Backend_FASM then
                     if Target_Node > 0 then
                        Walk_AST (Target_Node, Depth + 1, Right_Tag, Success, Diag);
                        Transpiler_Native_HAL.Emit_Raw ("  mov rcx, rax", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw
                          ("  call ALB_Input_Read_Line", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw
                          ("  test rax, rax", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  jnz " & Ok_Lbl, Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  mov qword [rcx], 0", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  jmp " & Done_Lbl, Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw (Ok_Lbl & ":", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw
                          ("  lea rax, [ALB_Input_Buffer]", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  mov [rcx], rax", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw (Done_Lbl & ":", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                     else
                        Transpiler_Native_HAL.Emit_Raw
                          ("  call ALB_Input_Read_Line", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw
                          ("  lea rax, [ALB_Input_Buffer]", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                     end if;

                  elsif Target = Backend_FASM16 then
                     Transpiler_Native_HAL.Emit_Raw ("  call ALB16_Readline_Read", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);

                     if Target_Node > 0 then
                        if Tree (Target_Node).Kind /= AST_Var_Expr
                          or else Tree (Target_Node).Left_Child > 0
                        then
                           Fail_Node
                             (Node,
                              Err_Type_Conflict,
                              "FASM16 READLINE target must be a simple STRING/BINARY variable",
                              Success,
                              Diag);
                           return;
                        end if;

                        declare
                           Tok        : Token := Tokens (Tree (Target_Node).Token_Index);
                           Lex        : String := Input_Buffer (Tok.Start .. Tok.Start + Tok.Length - 1);
                           Safe_Name  : constant String := Scoped_Lexeme (Lex);
                           Raw_Name   : constant String := FASM_Safe_Symbol (Lex);
                           Target_Lex : String (1 .. 128) := (others => ' ');
                           Target_Len : Natural := 0;
                           Sym        : Symbol_Record;
                           Found      : Boolean := False;

                           procedure Set_Target (Name : String) is
                           begin
                              Target_Lex := (others => ' ');
                              Target_Lex (1 .. Name'Length) := Name;
                              Target_Len := Name'Length;
                           end Set_Target;
                        begin
                           if Safe_Name'Length <= Target_Lex'Length then
                              Set_Target (Safe_Name);
                              Find_Symbol
                                (Hash_String (Target_Lex (1 .. Target_Len)),
                                 Current_Scope,
                                 Found,
                                 Sym);
                           end if;

                           if not Found and then Raw_Name'Length <= Target_Lex'Length then
                              Set_Target (Raw_Name);
                              Find_Symbol
                                (Hash_String (Target_Lex (1 .. Target_Len)),
                                 Current_Scope,
                                 Found,
                                 Sym);
                           end if;

                           if not Found then
                              Fail_Node
                                (Node,
                                 Err_Type_Conflict,
                                 "FASM16 READLINE target must be declared",
                                 Success,
                                 Diag);
                              return;
                           end if;

                           if Sym.Tag /= Type_Binary then
                              Fail_Node
                                (Node,
                                 Err_Type_Conflict,
                                 "FASM16 READLINE target must be STRING/BINARY",
                                 Success,
                                 Diag);
                              return;
                           end if;

                           declare
                              Cell : constant String :=
                                FASM16_Cell_Name
                                  (Sym, Target_Lex (1 .. Target_Len));
                           begin
                              Transpiler_Native_HAL.Emit_Raw
                                ("  mov word [" & Cell & "], ax", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                           end;
                        end;
                     end if;

                  else
                     if Target_Node > 0 then
                        Transpiler_Native_HAL.Emit_Raw ("fgets((char*)(uintptr_t)(", Success);
                        Walk_AST (Target_Node, Depth + 1, Right_Tag, Success, Diag);
                        Transpiler_Native_HAL.Emit_Raw ("), 2048, stdin)", Success);
                     else
                        Transpiler_Native_HAL.Emit_Raw ("{ static char _rl_buf[2]; fgets(_rl_buf, 2, stdin); }", Success);
                     end if;
                  end if;

                  Out_Tag := Type_None;
               end;


            when AST_Cut_Stmt =>
