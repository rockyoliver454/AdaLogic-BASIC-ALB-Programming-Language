   function To_Upper (S : String) return String is
      R : String (S'Range);
   begin
      for I in S'Range loop
         if S(I) >= 'a' and S(I) <= 'z' then
            R(I) := Character'Val(Character'Pos(S(I)) - 32);
         else
            R(I) := S(I);
         end if;
      end loop;
      return R;
   end To_Upper;

   function Raw_Lexeme (Tok_Idx : Natural) return String is
      Tok : Token := Tokens (Tok_Idx);
   begin
      return Input_Buffer (Tok.Start .. Tok.Start + Tok.Length - 1);
   end Raw_Lexeme;

   function Starts_With (Text : String; Prefix : String) return Boolean is
   begin
      return Text'Length >= Prefix'Length
        and then Text (Text'First .. Text'First + Prefix'Length - 1) = Prefix;
   end Starts_With;

   function Native_ASM_Family_From_Lexeme
     (Lexeme : String) return Native_ASM_Family
   is
      Upper_Lexeme : constant String := To_Upper (Lexeme);
   begin
      if Upper_Lexeme = "ENABLEASM" then
         return ASM_Family_Generic;
      elsif Upper_Lexeme = "ENABLEASM_X64"
        or else Upper_Lexeme = "ENABLEASM_X86_64"
        or else Upper_Lexeme = "ENABLEASM_AMD64"
      then
         return ASM_Family_X64;
      elsif Upper_Lexeme = "ENABLEASM_8086" then
         return ASM_Family_8086;
      elsif Upper_Lexeme = "ENABLEASM_6502" then
         return ASM_Family_6502;
      elsif Starts_With (Upper_Lexeme, "ENABLEASM_") then
         return ASM_Family_Unknown;
      else
         return ASM_Family_Unknown;
      end if;
   end Native_ASM_Family_From_Lexeme;

   function Native_ASM_Family_Is_Active
     (Family : Native_ASM_Family) return Boolean
   is
   begin
      case Target is
         when Backend_FASM =>
            return Family = ASM_Family_Generic
              or else Family = ASM_Family_X64;

         when Backend_FASM16 =>
            return Family = ASM_Family_8086;

         when Backend_C =>
            -- Track 8 (C): ENABLEASM_X64 routes inline ASM through a
            -- FASM-assembled side file that is linked into the C exe.
            return Family = ASM_Family_Generic
              or else Family = ASM_Family_X64;

         when others =>
            return False;
      end case;
   end Native_ASM_Family_Is_Active;

   function Native_ASM_Should_Skip_Node (Node : Node_Index) return Boolean is
   begin
      return Node /= 0
        and then Native_ASM_State = ASM_Mode_Ignored
        and then Tree (Node).Kind /= AST_Disable_Asm;
   end Native_ASM_Should_Skip_Node;

   function Strip_String_Node (Idx : Node_Index) return String is
      Tok : Token := Tokens (Tree(Idx).Token_Index);
   begin
      if Tok.Length >= 2 then
         return Input_Buffer (Tok.Start + 1 .. Tok.Start + Tok.Length - 2);
      else
         return "";
      end if;
   end Strip_String_Node;

   function Looks_Like_Header (Lib : String) return Boolean is
      U : constant String := To_Upper (Lib);
   begin
      for I in U'Range loop
         if U(I) = '/' or else U(I) = '\' then
            return True;
         end if;
      end loop;

      if U'Length >= 2 and then U(U'Last - 1 .. U'Last) = ".H" then
         return True;
      end if;

      if U'Length >= 4 and then U(U'Last - 3 .. U'Last) = ".HPP" then
         return True;
      end if;

      return False;
   end Looks_Like_Header;

   function Is_Scalar_FFI_Type (Type_Name : String) return Boolean is
      U : constant String := To_Upper (Type_Name);
   begin
      return U = "U8"
        or else U = "U16"
        or else U = "U32"
        or else U = "U64"
        or else U = "U128"
        or else U = "S8"
        or else U = "S16"
        or else U = "S32"
        or else U = "S64"
        or else U = "I8"
        or else U = "I16"
        or else U = "I32"
        or else U = "I64"
        or else U = "INT8"
        or else U = "INT16"
        or else U = "INT32"
        or else U = "INT64"
        or else U = "F64"
        or else U = "REAL"
        or else U = "STRING"
        or else U = "BOOLEAN"
        or else U = "BOOL"
        or else U = "PURE"
        or else U = "RATIONAL"
        or else U = "BINARY";
   end Is_Scalar_FFI_Type;

   function C_FFI_Type (Type_Name : String) return String is
      U : constant String := To_Upper (Type_Name);
      T : constant ALB_Type_Tag := Resolve_Type_Name (Type_Name);
   begin
      case T is
         when Type_U8 =>
            return "uint8_t";
         when Type_U16 =>
            return "uint16_t";
         when Type_U32 =>
            return "uint32_t";
         when Type_U64 =>
            return "uint64_t";
         when Type_U128 =>
            return "unsigned __int128";
         when Type_S8 =>
            return "int8_t";
         when Type_S16 =>
            return "int16_t";
         when Type_S32 =>
            return "int32_t";
         when Type_S64 | Type_HW64 =>
            return "int64_t";
         when Type_F32 =>
            return "float";
         when Type_F64 | Type_F128 =>
            return "double";
         when Type_Boolean =>
            return "uint8_t";
         when Type_Binary =>
            return "char*";
         when Type_Char =>
            return "char";
         when others =>
            if U = "STRING" then
               return "char*";
            end if;
            return "uint64_t";
      end case;
   end C_FFI_Type;
   
