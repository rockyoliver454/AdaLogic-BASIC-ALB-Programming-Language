            when AST_File_Read =>
               if Target = Backend_FASM then
                  Walk_AST (Tree (Node).Left_Child, Depth + 1, Left_Tag, Success, Diag);
                  Transpiler_Native_HAL.Emit_Raw ("  push rax", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);

                  Walk_AST (Tree (Node).Right_Child, Depth + 1, Right_Tag, Success, Diag);
                  Transpiler_Native_HAL.Emit_Raw ("  mov rdx, rax", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);
                  Transpiler_Native_HAL.Emit_Raw ("  pop rcx", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);
                  Transpiler_Native_HAL.Emit_Raw ("  call ALB_File_Read", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);
               elsif Target = Backend_FASM16 then
                  Walk_AST (Tree (Node).Left_Child, Depth + 1, Left_Tag, Success, Diag);
                  if not Success then return; end if;

                  Transpiler_Native_HAL.Emit_Raw ("  push ax", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);

                  Walk_AST (Tree (Node).Right_Child, Depth + 1, Right_Tag, Success, Diag);
                  if not Success then return; end if;

                  Transpiler_Native_HAL.Emit_Raw ("  mov cx, ax", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);
                  Transpiler_Native_HAL.Emit_Raw ("  pop bx", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);
                  Transpiler_Native_HAL.Emit_Raw ("  call ALB16_File_Read", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);
               else
                  Transpiler_Native_HAL.Emit_File_Read_Start (Success);
                  Walk_AST (Tree (Node).Left_Child, Depth + 1, Left_Tag, Success, Diag);
                  Transpiler_Native_HAL.Emit_File_Read_Mid (Success);
                  Walk_AST (Tree (Node).Right_Child, Depth + 1, Right_Tag, Success, Diag);
                  Transpiler_Native_HAL.Emit_Expression_Close (Success);
                  Transpiler_Native_HAL.Emit_Expression_Close (Success);
               end if;
               Out_Tag := Type_Binary;

            when AST_File_Write =>
               if Target = Backend_FASM then
                  Walk_AST (Tree (Node).Right_Child, Depth + 1, Right_Tag, Success, Diag);
                  Transpiler_Native_HAL.Emit_Raw ("  push rax", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);

                  Walk_AST (Tree (Node).Left_Child, Depth + 1, Left_Tag, Success, Diag);
                  Transpiler_Native_HAL.Emit_Raw ("  mov rdx, rax", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);
                  Transpiler_Native_HAL.Emit_Raw ("  pop rcx", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);
                  Transpiler_Native_HAL.Emit_Raw ("  call ALB_File_Write", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);
               elsif Target = Backend_FASM16 then
                  Walk_AST (Tree (Node).Right_Child, Depth + 1, Right_Tag, Success, Diag);
                  if not Success then return; end if;

                  Transpiler_Native_HAL.Emit_Raw ("  push dx", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);

                  Walk_AST (Tree (Node).Left_Child, Depth + 1, Left_Tag, Success, Diag);
                  if not Success then return; end if;

                  Transpiler_Native_HAL.Emit_Raw ("  mov bx, ax", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);
                  Transpiler_Native_HAL.Emit_Raw ("  pop dx", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);
                  Transpiler_Native_HAL.Emit_Raw ("  call ALB16_File_Write", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);
               else
                  Transpiler_Native_HAL.Emit_File_Write_Start (Success);
                  Walk_AST (Tree (Node).Right_Child, Depth + 1, Right_Tag, Success, Diag);
                  Transpiler_Native_HAL.Emit_File_Write_Mid (Success);
                  Walk_AST (Tree (Node).Left_Child, Depth + 1, Left_Tag, Success, Diag);
                  Transpiler_Native_HAL.Emit_Expression_Close (Success);
                  Transpiler_Native_HAL.Emit_Expression_Close (Success);
                  Transpiler_Native_HAL.Emit_Statement_End (Success);
               end if;
               Out_Tag := Type_None;

            when AST_File_Close =>
               if Target = Backend_FASM then
                  Walk_AST (Tree (Node).Left_Child, Depth + 1, Left_Tag, Success, Diag);
                  Transpiler_Native_HAL.Emit_Raw ("  mov rcx, rax", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);
                  Transpiler_Native_HAL.Emit_Raw ("  call ALB_File_Close", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);
               elsif Target = Backend_FASM16 then
                  Walk_AST (Tree (Node).Left_Child, Depth + 1, Left_Tag, Success, Diag);
                  if not Success then return; end if;

                  Transpiler_Native_HAL.Emit_Raw ("  mov bx, ax", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);
                  Transpiler_Native_HAL.Emit_Raw ("  call ALB16_File_Close", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);
               else
                  Transpiler_Native_HAL.Emit_File_Close_Start (Success);
                  Walk_AST (Tree (Node).Left_Child, Depth + 1, Left_Tag, Success, Diag);
                  Transpiler_Native_HAL.Emit_Expression_Close (Success);
                  Transpiler_Native_HAL.Emit_Expression_Close (Success);
                  Transpiler_Native_HAL.Emit_Statement_End (Success);
               end if;
               Out_Tag := Type_None;
            
            when AST_Try_Stmt =>
               declare
                  Try_Node    : Node_Index := Tree (Node).Left_Child;
                  Catch_Node  : Node_Index := Tree (Node).Right_Child;
                  Err_Var     : String (1 .. 64) := (others => ' ');
                  Err_Len     : Natural := 0;
                  Target_Err  : String (1 .. 128) := (others => ' ');
                  Target_Elan : Natural := 0;
                  Catch_Cell  : String (1 .. 128) := (others => ' ');
                  Catch_CLen  : Natural := 0;
               begin
                  if Tree (Node).Token_Index > 0 then
                     declare
                        Tok : Token := Tokens (Tree (Node).Token_Index);
                     begin
                        Err_Len := Tok.Length;
                        Err_Var (1 .. Err_Len) := Input_Buffer (Tok.Start .. Tok.Start + Tok.Length - 1);
                     end;
                  end if;

                  if Err_Len > 0 then
                     if Active_Module_Len > 0 then
                        Target_Err (1 .. Active_Module_Len) := Active_Module_Name (1 .. Active_Module_Len);
                        Target_Err (Active_Module_Len + 1) := '_';
                        Target_Err (Active_Module_Len + 2 .. Active_Module_Len + 1 + Err_Len) := Err_Var (1 .. Err_Len);
                        Target_Elan := Active_Module_Len + 1 + Err_Len;
                     else
                        Target_Err (1 .. Err_Len) := Err_Var (1 .. Err_Len);
                        Target_Elan := Err_Len;
                     end if;

                     declare
                        Dummy_Tag : ALB_Type_Tag;
                        Catch_Tag : constant ALB_Type_Tag :=
                          (if Target = Backend_FASM16 then Type_Binary else Type_U64);
                        Dummy_Sym : Symbol_Record := Resolve_Symbol (Err_Var (1 .. Err_Len), Catch_Tag, 0, False, Dummy_Tag);
                     begin
                        if Target = Backend_FASM16 then
                           declare
                              Cell : constant String :=
                                FASM16_Cell_Name
                                  (Dummy_Sym,
                                   Target_Err (1 .. Target_Elan));
                           begin
                              Catch_CLen := Cell'Length;
                              Catch_Cell (1 .. Catch_CLen) := Cell;
                           end;
                        end if;
                        null;
                     end;
                  end if;

                  Transpiler_Native_HAL.Emit_Try_Start (Success);
                  if not Success then return; end if;
                  Walk_AST (Try_Node, Depth + 1, Right_Tag, Success, Diag);
                  if not Success then return; end if;

                  if Target_Elan > 0 then
                     if Target = Backend_FASM16 and then Catch_CLen > 0 then
                        Transpiler_Native_HAL.Emit_Catch_Start (Catch_Cell (1 .. Catch_CLen), Success);
                     else
                        Transpiler_Native_HAL.Emit_Catch_Start (Target_Err (1 .. Target_Elan), Success);
                     end if;
                  else
                     Transpiler_Native_HAL.Emit_Catch_Start ("", Success);
                  end if;
                  if not Success then return; end if;

                  Walk_AST (Catch_Node, Depth + 1, Right_Tag, Success, Diag);
                  if not Success then return; end if;
                  Transpiler_Native_HAL.Emit_Try_End (Success);
                  if not Success then return; end if;
               end;

            when AST_Throw_Stmt =>
               Transpiler_Native_HAL.Emit_Throw_Start (Success);
               if not Success then return; end if;
               Walk_AST (Tree (Node).Left_Child, Depth + 1, Right_Tag, Success, Diag);
               if not Success then return; end if;
               Transpiler_Native_HAL.Emit_Throw_End (Success);
               if not Success then return; end if;
               
            when AST_Create_Window =>
               declare
                  Title_Node : Node_Index := Tree (Node).Left_Child;
                  Args_Node  : Node_Index := Tree (Node).Right_Child;
                  W_Node     : Node_Index := 0;
                  H_Node     : Node_Index := 0;
                  Title_Str  : String (1 .. 256) := (others => ' ');
                  T_Len      : Natural := 0;
                  Dim_Tag    : ALB_Type_Tag := Type_S32;
               begin
                  Has_Create_Window := True;
                  if Args_Node /= 0 then
                     if Tree (Args_Node).Left_Child /= 0 then
                        W_Node := Tree (Args_Node).Left_Child;
                     else
                        W_Node := Args_Node;
                     end if;

                     if Tree (Args_Node).Right_Child /= 0 then
                        H_Node := Tree (Args_Node).Right_Child;
                     elsif W_Node /= 0 then
                        H_Node := Tree (W_Node).Next_Sibling;
                     end if;
                  end if;

                  if Tree (Title_Node).Kind = AST_String_Expr then
                     declare
                        Tok : Token := Tokens (Tree (Title_Node).Token_Index);
                     begin
                        if Tok.Length > 2 then
                           T_Len := Tok.Length - 2;
                           Title_Str (1 .. T_Len) := Input_Buffer (Tok.Start + 1 .. Tok.Start + Tok.Length - 2);
                        end if;
                     end;
                  end if;
                  
                  if Target = Backend_FASM16 then
                     FASM16_Uses_Graphics := True;
                  end if;

                  Dim_Tag := Type_None;
                  if Target = Backend_C then
                     Transpiler_Native_HAL.Emit_Raw ("ALB_Screen_Width = ", Success);
                     Walk_AST (W_Node, Depth + 1, Dim_Tag, Success, Diag);
                     if not Success then return; end if;
                     Transpiler_Native_HAL.Emit_Raw (";", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                  else
                     Walk_AST (W_Node, Depth + 1, Dim_Tag, Success, Diag);
                     if not Success then return; end if;
                  end if;

                  if Target = Backend_FASM then
                     Transpiler_Native_HAL.Emit_Raw ("  mov qword [ALB_Screen_Width], rax", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                  elsif Target = Backend_FASM16 then
                     Transpiler_Native_HAL.Emit_Raw ("  mov word [ALB_Screen_Width], ax", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                  elsif Target = Backend_Java then
                     Transpiler_Native_HAL.Emit_Raw ("  alb_window_width[0] = (int)alb_native_result;", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                  end if;

                  Dim_Tag := Type_None;
                  if Target = Backend_C then
                     Transpiler_Native_HAL.Emit_Raw ("ALB_Screen_Height = ", Success);
                     Walk_AST (H_Node, Depth + 1, Dim_Tag, Success, Diag);
                     if not Success then return; end if;
                     Transpiler_Native_HAL.Emit_Raw (";", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                  else
                     Walk_AST (H_Node, Depth + 1, Dim_Tag, Success, Diag);
                     if not Success then return; end if;
                  end if;

                  if Target = Backend_FASM then
                     Transpiler_Native_HAL.Emit_Raw ("  mov qword [ALB_Screen_Height], rax", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                  elsif Target = Backend_FASM16 then
                     Transpiler_Native_HAL.Emit_Raw ("  mov word [ALB_Screen_Height], ax", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                  elsif Target = Backend_Java then
                     Transpiler_Native_HAL.Emit_Raw ("  alb_window_height[0] = (int)alb_native_result;", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                  end if;

                  Transpiler_Native_HAL.Emit_Window_Creation (Title_Str (1 .. T_Len), Success);
               end;

            when AST_Set_Fullscreen | AST_Set_Resizable | AST_Set_Stretchy =>
               if Target = Backend_FASM then
                  Walk_AST (Tree (Node).Left_Child, Depth + 1, Right_Tag, Success, Diag);
                  if Tree (Node).Kind = AST_Set_Fullscreen then
                     Transpiler_Native_HAL.Emit_Set_Fullscreen (Success);
                  elsif Tree (Node).Kind = AST_Set_Resizable then
                     Transpiler_Native_HAL.Emit_Set_Resizable (Success);
                  else
                     Transpiler_Native_HAL.Emit_Set_Stretchy (Success);
                  end if;
               elsif Target = Backend_C then
                  if Tree (Node).Kind = AST_Set_Fullscreen then
                     Transpiler_Native_HAL.Emit_Raw ("ALB_Set_Fullscreen(", Success);
                  elsif Tree (Node).Kind = AST_Set_Resizable then
                     Transpiler_Native_HAL.Emit_Raw ("ALB_Set_Resizable(", Success);
                  else
                     Transpiler_Native_HAL.Emit_Raw ("ALB_Set_Stretchy(", Success);
                  end if;

                  Walk_AST (Tree (Node).Left_Child, Depth + 1, Right_Tag, Success, Diag);
                  if not Success then
                     return;
                  end if;

                  Transpiler_Native_HAL.Emit_Raw (");", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);
               elsif Target = Backend_FASM16 then
                  Fail_Node
                    (Node,
                     Err_Type_Conflict,
                     "SET FULLSCREEN/RESIZABLE/STRETCHY not supported on FASM16/DOS",
                     Success,
                     Diag);
                  return;
               else
                  Fail_Node
