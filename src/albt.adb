          --  
          --        when others =>
          --           null;
          --     end case;
          --  end Emit_FASM16_Type_Store_Check_AX;
          
          procedure Emit_FASM16_Type_Store_Check_AX
            (Tag : in ALB_Type_Tag)
          is
          begin
             case Tag is
                when Type_Boolean =>
                   Transpiler_Native_HAL.Emit_Raw ("  cmp dx, 0", Success);
                   Transpiler_Native_HAL.Emit_Newline (Success);
                   Emit_FASM16_Long_Trap_Jcc ("jne", "ALB16_Runtime_Range");
                   Transpiler_Native_HAL.Emit_Raw ("  cmp ax, 1", Success);
                   Transpiler_Native_HAL.Emit_Newline (Success);
                   Emit_FASM16_Long_Trap_Jcc ("ja", "ALB16_Runtime_Range");

                when Type_U8 | Type_HW8 =>
                   Transpiler_Native_HAL.Emit_Raw ("  cmp dx, 0", Success);
                   Transpiler_Native_HAL.Emit_Newline (Success);
                   Emit_FASM16_Long_Trap_Jcc ("jne", "ALB16_Runtime_Range");
                   Transpiler_Native_HAL.Emit_Raw ("  cmp ax, 255", Success);
                   Transpiler_Native_HAL.Emit_Newline (Success);
                   Emit_FASM16_Long_Trap_Jcc ("ja", "ALB16_Runtime_Range");

                when Type_U16 | Type_HW16  =>
                   Transpiler_Native_HAL.Emit_Raw ("  cmp dx, 0", Success);
                   Transpiler_Native_HAL.Emit_Newline (Success);
                   Emit_FASM16_Long_Trap_Jcc ("jne", "ALB16_Runtime_Range");

                when Type_U32 | Type_S32 | Type_HW32 | Type_Pure =>
                   null;

                when others =>
                   null;
             end case;
          end Emit_FASM16_Type_Store_Check_AX;

         procedure Emit_FASM16_Literal_DXAX
           (Value      : in U64;
            Error_Node : in Node_Index;
            Culprit    : in String)
          is
             Lo : constant U64 := Value mod 16#10000#;
             Hi : constant U64 := (Value / 16#10000#) mod 16#10000#;
          begin
             -- FASM16 values travel in DX:AX.
             -- Accept normal U32 literals plus S32 negative literals already
             -- parsed into U64 two's-complement form.
             if Value > 16#FFFF_FFFF#
               and then Value < 16#FFFF_FFFF_8000_0000#
             then
                Fail_Node
                  (Error_Node,
                   Err_Type_Conflict,
                   Culprit,
                   Success,
                   Diag);
                return;
             end if;

             Transpiler_Native_HAL.Emit_Raw ("  mov ax, ", Success);
             Transpiler_Native_HAL.Emit_Literal_U64 (Lo, Success);
             Transpiler_Native_HAL.Emit_Newline (Success);

             Transpiler_Native_HAL.Emit_Raw ("  mov dx, ", Success);
             Transpiler_Native_HAL.Emit_Literal_U64 (Hi, Success);
             Transpiler_Native_HAL.Emit_Newline (Success);
         end Emit_FASM16_Literal_DXAX;

         function Fresh_FASM16_Long_Trap_Label return String is
         begin
            FASM16_Long_Trap_Counter := FASM16_Long_Trap_Counter + 1;

            declare
               Img : constant String :=
                 Natural'Image (FASM16_Long_Trap_Counter);
            begin
               return ".ALB16_TRAP_SKIP_" & Img (Img'First + 1 .. Img'Last);
            end;
         end Fresh_FASM16_Long_Trap_Label;

         procedure Emit_FASM16_Long_Trap_Jcc
           (Cond : in String;
            Trap : in String)
         is
            Skip_Label : constant String := Fresh_FASM16_Long_Trap_Label;
         begin
            if Cond = "jb" then
               Transpiler_Native_HAL.Emit_Raw ("  jae " & Skip_Label, Success);
               Transpiler_Native_HAL.Emit_Newline (Success);
            elsif Cond = "ja" then
               Transpiler_Native_HAL.Emit_Raw ("  jbe " & Skip_Label, Success);
               Transpiler_Native_HAL.Emit_Newline (Success);
            elsif Cond = "jc" then
               Transpiler_Native_HAL.Emit_Raw ("  jnc " & Skip_Label, Success);
               Transpiler_Native_HAL.Emit_Newline (Success);
            elsif Cond = "je" or else Cond = "jz" then
               Transpiler_Native_HAL.Emit_Raw ("  jne " & Skip_Label, Success);
               Transpiler_Native_HAL.Emit_Newline (Success);
            elsif Cond = "jne" or else Cond = "jnz" then
               Transpiler_Native_HAL.Emit_Raw ("  je " & Skip_Label, Success);
               Transpiler_Native_HAL.Emit_Newline (Success);
            else
               Fail_Node
                 (Node,
                  Err_Compiler_AST_Mismatch,
                  "FASM16 LONG TRAP JCC " & Cond,
                  Success,
                  Diag);
               return;
            end if;

            Transpiler_Native_HAL.Emit_Raw ("  mov bx, " & Trap, Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            Transpiler_Native_HAL.Emit_Raw ("  jmp bx", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            Transpiler_Native_HAL.Emit_Raw (Skip_Label & ":", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
         end Emit_FASM16_Long_Trap_Jcc;
         
         function FASM16_Storage_Bytes (Tag : ALB_Type_Tag) return Natural is
          begin
             case Tag is
                when Type_U8 | Type_S8 | Type_HW8 | Type_Boolean | Type_Char =>
                   return 1;
                when Type_U16 | Type_S16 | Type_HW16 | Type_Binary | Type_Reference =>
                   return 2;
                when others =>
                   return 4;
             end case;
          end FASM16_Storage_Bytes;

          --  Bytes occupied by a call argument on the 16-bit stack. Callers
          --  always push whole words (see Emit_FASM16_Push_Args), so every
          --  scalar argument occupies at least one word (2 bytes) regardless
          --  of its declared storage size. This MUST mirror the push logic so
          --  that parameter frame offsets and the callee's `ret N` line up
          --  with what the caller actually pushed. A U8 parameter therefore
          --  lives in a 2-byte slot (low byte holds the value), not 1 byte.
          function FASM16_Param_Slot_Bytes (Tag : ALB_Type_Tag) return Natural is
          begin
             case Tag is
                when Type_U32 | Type_S32 | Type_HW32 | Type_Pure =>
                   return 4;
                when others =>
                   return 2;
             end case;
          end FASM16_Param_Slot_Bytes;

         function FASM16_Scalar_Supported (Tag : ALB_Type_Tag) return Boolean is
         begin
            return Tag /= Type_None;
         end FASM16_Scalar_Supported;

         function FASM16_Infer_For_Tag
           (Tag : ALB_Type_Tag) return ALB_Type_Tag
         is
         begin
            case Tag is
               when Type_Boolean =>
                  return Type_Boolean;

               when Type_U8 | Type_HW8 =>
                  return Type_U8;

               when Type_U16 | Type_HW16 =>
                  return Type_U16;

               when Type_U32 | Type_HW32 =>
                  return Type_U32;

               when Type_S8 | Type_S16 | Type_S32 =>
                  return Type_S32;
                  
               when Type_U64 =>
                  return Type_U64;
                  
               when Type_S64 =>
                  return Type_S64;

               when others =>
                  return Type_None;
            end case;
         end FASM16_Infer_For_Tag;

         function FASM16_Select_For_Tag
           (Start_Tag : ALB_Type_Tag;
            End_Tag   : ALB_Type_Tag;
            Step_Tag  : ALB_Type_Tag) return ALB_Type_Tag
         is
            S : constant ALB_Type_Tag := FASM16_Infer_For_Tag (Start_Tag);
            E : constant ALB_Type_Tag := FASM16_Infer_For_Tag (End_Tag);
            P : constant ALB_Type_Tag := FASM16_Infer_For_Tag (Step_Tag);
         begin
            if S = Type_S32 or else E = Type_S32 or else P = Type_S32 then
               return Type_S32;
            elsif S = Type_U32 or else E = Type_U32 or else P = Type_U32 then
               return Type_U32;
            elsif S = Type_U16 or else E = Type_U16 or else P = Type_U16 then
               return Type_U16;
            elsif S = Type_U8 or else E = Type_U8 or else P = Type_U8 then
               return Type_U8;
            elsif S = Type_Boolean
              or else E = Type_Boolean
              or else P = Type_Boolean
            then
               return Type_Boolean;
            else
               -- Keep the old failure path for untyped wide literals or
               -- unsupported loop domains. Explicit constructors fix that.
               return Type_U64;
            end if;
         end FASM16_Select_For_Tag;

         function FASM16_Normalize_Memory_Tag
           (Tag : ALB_Type_Tag) return ALB_Type_Tag;

         procedure Emit_FASM16_Load_Cell_To_DXAX
            (Cell : String;
             Tag  : ALB_Type_Tag)
         is
            MTag : constant ALB_Type_Tag := FASM16_Normalize_Memory_Tag (Tag);
         begin
             if MTag = Type_U8 or else MTag = Type_S8 or else MTag = Type_HW8 or else MTag = Type_Boolean or else MTag = Type_Char then
                Transpiler_Native_HAL.Emit_Raw ("  xor ax, ax", Success);
                Transpiler_Native_HAL.Emit_Newline (Success);
                Transpiler_Native_HAL.Emit_Raw ("  xor dx, dx", Success);
                Transpiler_Native_HAL.Emit_Newline (Success);
                Transpiler_Native_HAL.Emit_Raw ("  mov al, byte [" & Cell & "]", Success);

             elsif MTag = Type_U32 or else MTag = Type_S32 or else MTag = Type_HW32 or else MTag = Type_Pure then
                Transpiler_Native_HAL.Emit_Raw ("  mov ax, word [" & Cell & "]", Success);
                Transpiler_Native_HAL.Emit_Newline (Success);
                Transpiler_Native_HAL.Emit_Raw ("  mov dx, word [" & Cell & "+2]", Success);

             elsif MTag = Type_Binary or else MTag = Type_Reference then
                Transpiler_Native_HAL.Emit_Raw ("  mov dx, word [" & Cell & "]", Success);
                Transpiler_Native_HAL.Emit_Newline (Success);
                Transpiler_Native_HAL.Emit_Raw ("  mov ax, dx", Success);

             else
                Transpiler_Native_HAL.Emit_Raw ("  mov ax, word [" & Cell & "]", Success);
                Transpiler_Native_HAL.Emit_Newline (Success);
                Transpiler_Native_HAL.Emit_Raw ("  xor dx, dx", Success);
             end if;

             Transpiler_Native_HAL.Emit_Newline (Success);
         end Emit_FASM16_Load_Cell_To_DXAX;

         procedure Emit_FASM16_Cast_DXAX
           (Source_Tag : ALB_Type_Tag;
            Target_Tag : ALB_Type_Tag)
         is
            S_Bytes : constant Natural := FASM16_Storage_Bytes (Source_Tag);
            T_Bytes : constant Natural := FASM16_Storage_Bytes (Target_Tag);
         begin
            if S_Bytes = T_Bytes then
               return;
            end if;

            if S_Bytes = 1 then
               if Source_Tag = Type_S8 then
                  Transpiler_Native_HAL.Emit_Raw ("  cbw", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);
                  if T_Bytes >= 4 then
                     Transpiler_Native_HAL.Emit_Raw ("  cwd", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                  end if;
               else
                  Transpiler_Native_HAL.Emit_Raw ("  xor ah, ah", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);
                  if T_Bytes >= 4 then
                     Transpiler_Native_HAL.Emit_Raw ("  xor dx, dx", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                  end if;
               end if;
            elsif S_Bytes = 2 then
               if T_Bytes >= 4 then
                  if Source_Tag = Type_S16 then
                     Transpiler_Native_HAL.Emit_Raw ("  cwd", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                  else
                     Transpiler_Native_HAL.Emit_Raw ("  xor dx, dx", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                  end if;
               end if;
            elsif S_Bytes >= 4 and then T_Bytes <= 2 then
               null;
            end if;
         end Emit_FASM16_Cast_DXAX;

         procedure Emit_FASM16_Store_DXAX_To_Cell
            (Cell : String;
             Tag  : ALB_Type_Tag)
         is
            MTag : constant ALB_Type_Tag := FASM16_Normalize_Memory_Tag (Tag);
         begin
             if MTag = Type_U8 or else MTag = Type_S8 or else MTag = Type_HW8 or else MTag = Type_Boolean or else MTag = Type_Char then
                Transpiler_Native_HAL.Emit_Raw ("  mov byte [" & Cell & "], al", Success);

             elsif MTag = Type_U32 or else MTag = Type_S32 or else MTag = Type_HW32 or else MTag = Type_Pure then
                Transpiler_Native_HAL.Emit_Raw ("  mov word [" & Cell & "], ax", Success);
                Transpiler_Native_HAL.Emit_Newline (Success);
                Transpiler_Native_HAL.Emit_Raw ("  mov word [" & Cell & "+2], dx", Success);

             elsif MTag = Type_Binary or else MTag = Type_Reference then
                Transpiler_Native_HAL.Emit_Raw ("  mov word [" & Cell & "], ax", Success);

             else
                Transpiler_Native_HAL.Emit_Raw ("  mov word [" & Cell & "], ax", Success);
             end if;

             Transpiler_Native_HAL.Emit_Newline (Success);
         end Emit_FASM16_Store_DXAX_To_Cell;

         procedure Emit_FASM16_Array_Index_Offset_To_BX
            (Array_Name       : in String;
             First_Index_Node : in Node_Index;
             Elem_Bytes       : in Natural);

          function FASM16_Cell_Name
            (Sym         : Symbol_Record;
             Global_Name : String) return String;

          function FASM16_Normalize_Memory_Tag
            (Tag : ALB_Type_Tag) return ALB_Type_Tag
          is
          begin
             case Tag is
                when Type_U8 | Type_S8 | Type_HW8 | Type_Boolean | Type_Char =>
                   return Tag;

                when Type_U16 | Type_S16 | Type_HW16 | Type_Binary | Type_Reference =>
                   return Tag;

                when Type_S32 | Type_S64 | Type_S128 =>
                   return Type_S32;

                when Type_HW32 | Type_HW64 =>
                   return Type_HW32;

                when Type_U32 =>
                   return Type_U32;

                when Type_U64 | Type_U128 =>
                   return Type_U32;

                when Type_Pure =>
                   return Type_Pure;

                when others =>
                   return Type_U32;
             end case;
          end FASM16_Normalize_Memory_Tag;

          function FASM16_LValue_Tag
            (Target_Node : Node_Index) return ALB_Type_Tag
          is
          begin
             if Target_Node = 0 then
                return Type_U16;
             end if;

             case Tree (Target_Node).Kind is
                when AST_Var_Expr =>
                   declare
                      Tok        : Token := Tokens (Tree (Target_Node).Token_Index);
                      Lex        : String := Input_Buffer (Tok.Start .. Tok.Start + Tok.Length - 1);
                      Target_Lex : constant String := Scoped_Lexeme (Lex);
                      Found      : Boolean := False;
                      Sym        : Symbol_Record;
                   begin
                      if Tree (Target_Node).Left_Child > 0 then
                         declare
                            R : constant Natural := Find_Range_Array (Target_Lex);
                         begin
                            if R > 0 then
                               return FASM16_Normalize_Memory_Tag (Range_Types (R).Base_Tag);
                            end if;
                         end;
                      end if;

                      Find_Symbol (Hash_String (Target_Lex), Current_Scope, Found, Sym);

                      if not Found then
                         Find_Symbol (Hash_String (Lex), Current_Scope, Found, Sym);
                      end if;

                      if Found then
                         return FASM16_Normalize_Memory_Tag (Sym.Tag);
                      end if;

                      return Type_U16;
                   end;

                when AST_Member_Expr =>
                   declare
                      Var_Node    : constant Node_Index := Tree (Target_Node).Left_Child;
                      Field_Node  : constant Node_Index := Tree (Target_Node).Right_Child;
                      Sym         : Symbol_Record;
                      Found       : Boolean := False;
                      Field       : Struct_Field;
                      Field_Found : Boolean := False;
                   begin
                      if Var_Node > 0 and then Field_Node > 0
                        and then Tree (Var_Node).Kind = AST_Var_Expr
                      then
                         declare
                            V_Tok    : Token := Tokens (Tree (Var_Node).Token_Index);
                            F_Tok    : Token := Tokens (Tree (Field_Node).Token_Index);
                            V_Lex    : String := Input_Buffer (V_Tok.Start .. V_Tok.Start + V_Tok.Length - 1);
                            F_Lex    : String := Input_Buffer (F_Tok.Start .. F_Tok.Start + F_Tok.Length - 1);
                            V_Target : constant String := Scoped_Lexeme (V_Lex);
                         begin
                            Find_Symbol (Hash_String (V_Target), Current_Scope, Found, Sym);

                            if not Found then
                               Find_Symbol (Hash_String (V_Lex), Current_Scope, Found, Sym);
                            end if;

                            if Found and then Sym.Struct_ID > 0 then
                               Find_Struct_Field
                                 (Sym.Struct_ID,
                                  Hash_String (F_Lex),
                                  Field_Found,
                                  Field);

                               if Field_Found then
                                  return FASM16_Normalize_Memory_Tag (Field.Tag);
                               end if;
                            end if;
                         end;
                      end if;

                      return Type_U16;
                   end;

                when others =>
                   return FASM16_Normalize_Memory_Tag (Infer_Type_Tag (Target_Node));
             end case;
          end FASM16_LValue_Tag;

          --  function FASM16_Addressed_Tag
          --    (Address_Node : Node_Index;
          --     Fallback    : Node_Index) return ALB_Type_Tag
          --  is
          --  begin
          --     if Address_Node > 0
          --       and then Tree (Address_Node).Kind in AST_AddressOf | AST_Ref_Expr
          --     then
          --        return FASM16_LValue_Tag (Tree (Address_Node).Left_Child);
          --     elsif Address_Node > 0
          --       and then Tree (Address_Node).Kind = AST_Var_Expr
          --     then
          --        declare
          --           Tok        : Token := Tokens (Tree (Address_Node).Token_Index);
          --           Lex        : String := Input_Buffer (Tok.Start .. Tok.Start + Tok.Length - 1);
          --           Target_Lex : constant String := Scoped_Lexeme (Lex);
          --           Ptr_Tag    : constant ALB_Type_Tag :=
          --             Find_FASM16_Pointer_Meta (Target_Lex, Current_Scope);
          --        begin
          --           if Ptr_Tag /= Type_None then
          --              return FASM16_Normalize_Memory_Tag (Ptr_Tag);
          --           end if;
          --        end;
          --     elsif Fallback > 0 then
          --        return FASM16_Normalize_Memory_Tag (Infer_Type_Tag (Fallback));
          --     else
          --        return Type_U16;
          --     end if;
          --  end FASM16_Addressed_Tag;
          function FASM16_Addressed_Tag
           (Address_Node : Node_Index;
            Fallback     : Node_Index) return ALB_Type_Tag
         is
         begin
            if Address_Node > 0
              and then Tree (Address_Node).Kind in AST_AddressOf | AST_Ref_Expr
            then
               return FASM16_LValue_Tag (Tree (Address_Node).Left_Child);
            elsif Address_Node > 0
              and then Tree (Address_Node).Kind = AST_Var_Expr
            then
               declare
                  Tok        : Token := Tokens (Tree (Address_Node).Token_Index);
                  Lex        : String := Input_Buffer (Tok.Start .. Tok.Start + Tok.Length - 1);
                  Target_Lex : constant String := Scoped_Lexeme (Lex);
                  Ptr_Tag    : constant ALB_Type_Tag :=
                    Find_FASM16_Pointer_Meta (Target_Lex, Current_Scope);
               begin
                  if Ptr_Tag /= Type_None then
                     return FASM16_Normalize_Memory_Tag (Ptr_Tag);
                  end if;
                  
                  -- Patch: If the pointer meta isn't found, route to the standard fallback
                  if Fallback > 0 then
                     return FASM16_Normalize_Memory_Tag (Infer_Type_Tag (Fallback));
                  else
                     return Type_U16;
                  end if;
               end;
            elsif Fallback > 0 then
               return FASM16_Normalize_Memory_Tag (Infer_Type_Tag (Fallback));
            else
               return Type_U16;
            end if;
         end FASM16_Addressed_Tag;

          function FASM16_Object_Bytes
            (Target_Node : Node_Index) return Natural
          is
             Tag        : constant ALB_Type_Tag := FASM16_LValue_Tag (Target_Node);
             Elem_Bytes : constant Natural := FASM16_Storage_Bytes (Tag);
             Total      : U64 := 1;
          begin
             if Target_Node > 0
               and then Tree (Target_Node).Kind = AST_Var_Expr
             then
                declare
                   Tok        : Token := Tokens (Tree (Target_Node).Token_Index);
                   Lex        : String := Input_Buffer (Tok.Start .. Tok.Start + Tok.Length - 1);
                   Target_Lex : constant String := Scoped_Lexeme (Lex);
                   Arr_Idx    : constant Natural := Find_Strict_Array (Target_Lex);
                begin
                   if Arr_Idx > 0 then
                      for I in 1 .. Strict_Arrays (Arr_Idx).Dim_Count loop
                         Total := Total * U64 (Strict_Arrays (Arr_Idx).Dims (I));
                      end loop;

                      -- ALB arrays reserve physical slot 0 as a sentinel.
                      Total := Total + 1;

                      if Total > U64 (Natural'Last / Elem_Bytes) then
                         return 16#FFFF#;
                      end if;

                      if Total * U64 (Elem_Bytes) > 16#FFFF# then
                         return 16#FFFF#;
                      end if;

                      return Natural (Total * U64 (Elem_Bytes));
                   end if;
                end;
             end if;

             return Elem_Bytes;
          end FASM16_Object_Bytes;

          procedure Emit_FASM16_Load_Ptr_To_DXAX
            (Tag : ALB_Type_Tag)
          is
             MTag : constant ALB_Type_Tag := FASM16_Normalize_Memory_Tag (Tag);
          begin
             if MTag = Type_S8 then
                Transpiler_Native_HAL.Emit_Raw ("  mov al, byte [bx]", Success);
                Transpiler_Native_HAL.Emit_Newline (Success);
                Transpiler_Native_HAL.Emit_Raw ("  cbw", Success);
                Transpiler_Native_HAL.Emit_Newline (Success);
                Transpiler_Native_HAL.Emit_Raw ("  cwd", Success);

             elsif MTag = Type_U8
               or else MTag = Type_HW8
               or else MTag = Type_Boolean
               or else MTag = Type_Char
             then
                Transpiler_Native_HAL.Emit_Raw ("  xor ax, ax", Success);
                Transpiler_Native_HAL.Emit_Newline (Success);
                Transpiler_Native_HAL.Emit_Raw ("  xor dx, dx", Success);
                Transpiler_Native_HAL.Emit_Newline (Success);
                Transpiler_Native_HAL.Emit_Raw ("  mov al, byte [bx]", Success);

             elsif MTag = Type_U32
               or else MTag = Type_S32
               or else MTag = Type_HW32
               or else MTag = Type_Pure
             then
                Transpiler_Native_HAL.Emit_Raw ("  mov ax, word [bx]", Success);
                Transpiler_Native_HAL.Emit_Newline (Success);
                Transpiler_Native_HAL.Emit_Raw ("  mov dx, word [bx+2]", Success);

             elsif MTag = Type_Binary or else MTag = Type_Reference then
                Transpiler_Native_HAL.Emit_Raw ("  mov ax, word [bx]", Success);
                Transpiler_Native_HAL.Emit_Newline (Success);
                Transpiler_Native_HAL.Emit_Raw ("  mov dx, ax", Success);

             elsif MTag = Type_S16 then
                Transpiler_Native_HAL.Emit_Raw ("  mov ax, word [bx]", Success);
                Transpiler_Native_HAL.Emit_Newline (Success);
                Transpiler_Native_HAL.Emit_Raw ("  cwd", Success);

             else
                Transpiler_Native_HAL.Emit_Raw ("  mov ax, word [bx]", Success);
                Transpiler_Native_HAL.Emit_Newline (Success);
                Transpiler_Native_HAL.Emit_Raw ("  xor dx, dx", Success);
             end if;

             Transpiler_Native_HAL.Emit_Newline (Success);
          end Emit_FASM16_Load_Ptr_To_DXAX;

          procedure Emit_FASM16_Store_DXAX_To_Ptr
            (Tag : ALB_Type_Tag)
          is
             MTag : constant ALB_Type_Tag := FASM16_Normalize_Memory_Tag (Tag);
          begin
             if MTag = Type_U8
               or else MTag = Type_S8
               or else MTag = Type_HW8
               or else MTag = Type_Boolean
               or else MTag = Type_Char
             then
                Transpiler_Native_HAL.Emit_Raw ("  mov byte [bx], al", Success);

             elsif MTag = Type_U32
               or else MTag = Type_S32
               or else MTag = Type_HW32
               or else MTag = Type_Pure
             then
                Transpiler_Native_HAL.Emit_Raw ("  mov word [bx], ax", Success);
                Transpiler_Native_HAL.Emit_Newline (Success);
                Transpiler_Native_HAL.Emit_Raw ("  mov word [bx+2], dx", Success);

             else
                Transpiler_Native_HAL.Emit_Raw ("  mov word [bx], ax", Success);
             end if;

             Transpiler_Native_HAL.Emit_Newline (Success);
          end Emit_FASM16_Store_DXAX_To_Ptr;

          procedure Emit_FASM16_Lea_Cell_To_DXAX
            (Cell : String)
          is
          begin
             Transpiler_Native_HAL.Emit_Raw ("  lea ax, [" & Cell & "]", Success);
             Transpiler_Native_HAL.Emit_Newline (Success);
             Transpiler_Native_HAL.Emit_Raw ("  xor dx, dx", Success);
             Transpiler_Native_HAL.Emit_Newline (Success);
          end Emit_FASM16_Lea_Cell_To_DXAX;

          procedure Emit_FASM16_Address_Of_Node
            (Target_Node : Node_Index)
          is
          begin
             if Target_Node = 0 then
                Transpiler_Native_HAL.Emit_Raw ("  xor ax, ax", Success);
                Transpiler_Native_HAL.Emit_Newline (Success);
                Transpiler_Native_HAL.Emit_Raw ("  xor dx, dx", Success);
                Transpiler_Native_HAL.Emit_Newline (Success);
                return;
             end if;

             if Tree (Target_Node).Kind = AST_Var_Expr then
                declare
                   Tok        : Token := Tokens (Tree (Target_Node).Token_Index);
                   Lex        : String := Input_Buffer (Tok.Start .. Tok.Start + Tok.Length - 1);
                   Target_Lex : constant String := Scoped_Lexeme (Lex);
                   Found      : Boolean := False;
                   Sym        : Symbol_Record;
                begin
                   Find_Symbol (Hash_String (Target_Lex), Current_Scope, Found, Sym);

                   if not Found then
                      Find_Symbol (Hash_String (Lex), Current_Scope, Found, Sym);
                   end if;

                   if Tree (Target_Node).Left_Child > 0 then
                      declare
                         Elem_Tag   : ALB_Type_Tag := Type_U16;
                         Elem_Bytes : Natural := 2;
                      begin
                         if Found then
                            Elem_Tag := FASM16_Normalize_Memory_Tag (Sym.Tag);
                         end if;

                         Elem_Bytes := FASM16_Storage_Bytes (Elem_Tag);
                         Emit_FASM16_Array_Index_Offset_To_BX
                           (Target_Lex,
                            Tree (Target_Node).Left_Child,
                            Elem_Bytes);

                         if not Success then
                            return;
                         end if;

                         if Found and then Sym.Class = Class_Local and then Sym.Offset < 0 then
                            declare
                               Img : constant String := Integer'Image (-Sym.Offset);
                               Off : constant String := Img (Img'First + 1 .. Img'Last);
                            begin
                               Transpiler_Native_HAL.Emit_Raw ("  mov si, bx", Success);
                               Transpiler_Native_HAL.Emit_Newline (Success);
                               Emit_FASM16_Lea_Cell_To_DXAX ("bp+si-" & Off);
                            end;

                         elsif Found and then Sym.Class = Class_Local and then Sym.Offset > 0 then
                            declare
                               Img : constant String := Integer'Image (Sym.Offset);
                               Off : constant String := Img (Img'First + 1 .. Img'Last);
                            begin
                               Transpiler_Native_HAL.Emit_Raw ("  mov si, bx", Success);
                               Transpiler_Native_HAL.Emit_Newline (Success);
                               Emit_FASM16_Lea_Cell_To_DXAX ("bp+si+" & Off);
                            end;

                         else
                            Emit_FASM16_Lea_Cell_To_DXAX (Target_Lex & " + bx");
                         end if;
                      end;

                   elsif Found then
                      Emit_FASM16_Lea_Cell_To_DXAX
                        (FASM16_Cell_Name (Sym, Target_Lex));

                   else
                      Emit_FASM16_Lea_Cell_To_DXAX (Target_Lex);
                   end if;
                end;

             elsif Tree (Target_Node).Kind = AST_Member_Expr then
                declare
                   Var_Node   : constant Node_Index := Tree (Target_Node).Left_Child;
                   Field_Node : constant Node_Index := Tree (Target_Node).Right_Child;
                begin
                   if Var_Node > 0 and then Field_Node > 0
                     and then Tree (Var_Node).Kind = AST_Var_Expr
                   then
                      declare
                         Var_Tok     : Token := Tokens (Tree (Var_Node).Token_Index);
                         Field_Tok   : Token := Tokens (Tree (Field_Node).Token_Index);
                         V_Lex       : String := Input_Buffer (Var_Tok.Start .. Var_Tok.Start + Var_Tok.Length - 1);
                         F_Lex       : String := Input_Buffer (Field_Tok.Start .. Field_Tok.Start + Field_Tok.Length - 1);
                         V_Target    : constant String := Scoped_Lexeme (V_Lex);
                         Sym         : Symbol_Record;
                         Found       : Boolean := False;
                         Field       : Struct_Field;
                         Field_Found : Boolean := False;
                      begin
                         Find_Symbol (Hash_String (V_Target), Current_Scope, Found, Sym);

                         if not Found then
                            Find_Symbol (Hash_String (V_Lex), Current_Scope, Found, Sym);
                         end if;

                         if Found and then Sym.Struct_ID > 0 then
                            Find_Struct_Field
                              (Sym.Struct_ID,
                               Hash_String (F_Lex),
                               Field_Found,
                               Field);

                            if Field_Found then
                               declare
                                  FImg : constant String := Natural'Image (Field.Offset);
                                  FOff : constant String := FImg (FImg'First + 1 .. FImg'Last);
                               begin
                                  if Sym.Class = Class_Local and then Sym.Offset < 0 then
                                     declare
                                        BImg : constant String := Integer'Image (-Sym.Offset);
                                        BOff : constant String := BImg (BImg'First + 1 .. BImg'Last);
                                     begin
                                        Emit_FASM16_Lea_Cell_To_DXAX ("bp-" & BOff & "+" & FOff);
                                     end;

                                  elsif Sym.Class = Class_Local and then Sym.Offset > 0 then
                                     declare
                                        BImg : constant String := Integer'Image (Sym.Offset);
                                        BOff : constant String := BImg (BImg'First + 1 .. BImg'Last);
                                     begin
                                        Emit_FASM16_Lea_Cell_To_DXAX ("bp+" & BOff & "+" & FOff);
                                     end;

                                  else
                                     Emit_FASM16_Lea_Cell_To_DXAX (V_Target & "+" & FOff);
                                  end if;

                                  return;
                               end;
                            end if;
                         end if;

                         Emit_FASM16_Lea_Cell_To_DXAX (V_Lex & "_" & F_Lex);
                      end;

                   else
                      Walk_AST (Target_Node, Depth + 1, Out_Tag, Success, Diag);
                   end if;
                end;

             else
                Walk_AST (Target_Node, Depth + 1, Out_Tag, Success, Diag);
             end if;
          end Emit_FASM16_Address_Of_Node;

          procedure Emit_FASM16_String_Len_Call
            (Expr_Node : Node_Index)
          is
          begin
             Walk_AST (Expr_Node, Depth + 1, Right_Tag, Success, Diag);
             Transpiler_Native_HAL.Emit_Raw ("  call ALB16_String_Len", Success);
             Transpiler_Native_HAL.Emit_Newline (Success);
          end Emit_FASM16_String_Len_Call;

          procedure Emit_FASM16_String_Left_Right_Call
            (Expr_Node  : Node_Index;
             Count_Node : Node_Index;
             Is_Right   : Boolean)
          is
          begin
             Walk_AST (Expr_Node, Depth + 1, Left_Tag, Success, Diag);
             Transpiler_Native_HAL.Emit_Raw ("  push dx", Success);
             Transpiler_Native_HAL.Emit_Newline (Success);

             Walk_AST (Count_Node, Depth + 1, Right_Tag, Success, Diag);
             Transpiler_Native_HAL.Emit_Raw ("  pop dx", Success);
             Transpiler_Native_HAL.Emit_Newline (Success);

             if Is_Right then
                Transpiler_Native_HAL.Emit_Raw ("  call ALB16_String_Right", Success);
             else
                Transpiler_Native_HAL.Emit_Raw ("  call ALB16_String_Left", Success);
             end if;
             Transpiler_Native_HAL.Emit_Newline (Success);
          end Emit_FASM16_String_Left_Right_Call;

          procedure Emit_FASM16_String_Mid_Call
            (Expr_Node  : Node_Index;
             Start_Node : Node_Index;
             Len_Node   : Node_Index)
          is
          begin
             Walk_AST (Expr_Node, Depth + 1, Left_Tag, Success, Diag);
             Transpiler_Native_HAL.Emit_Raw ("  push dx", Success);
             Transpiler_Native_HAL.Emit_Newline (Success);

             Walk_AST (Start_Node, Depth + 1, Right_Tag, Success, Diag);
             Transpiler_Native_HAL.Emit_Raw ("  push ax", Success);
             Transpiler_Native_HAL.Emit_Newline (Success);

             Walk_AST (Len_Node, Depth + 1, Right_Tag, Success, Diag);
             Transpiler_Native_HAL.Emit_Raw ("  mov bx, ax", Success);
             Transpiler_Native_HAL.Emit_Newline (Success);
             Transpiler_Native_HAL.Emit_Raw ("  pop ax", Success);
             Transpiler_Native_HAL.Emit_Newline (Success);
             Transpiler_Native_HAL.Emit_Raw ("  pop dx", Success);
             Transpiler_Native_HAL.Emit_Newline (Success);
             Transpiler_Native_HAL.Emit_Raw ("  call ALB16_String_Mid", Success);
             Transpiler_Native_HAL.Emit_Newline (Success);
          end Emit_FASM16_String_Mid_Call;

          procedure Emit_FASM16_String_Concat_Call
            (Left_Node  : Node_Index;
             Right_Node : Node_Index)
          is
          begin
             Walk_AST (Left_Node, Depth + 1, Left_Tag, Success, Diag);
             Transpiler_Native_HAL.Emit_Raw ("  push dx", Success);
             Transpiler_Native_HAL.Emit_Newline (Success);

             Walk_AST (Right_Node, Depth + 1, Right_Tag, Success, Diag);
             Transpiler_Native_HAL.Emit_Raw ("  mov bx, dx", Success);
             Transpiler_Native_HAL.Emit_Newline (Success);
             Transpiler_Native_HAL.Emit_Raw ("  pop dx", Success);
             Transpiler_Native_HAL.Emit_Newline (Success);
             Transpiler_Native_HAL.Emit_Raw ("  call ALB16_String_Concat", Success);
             Transpiler_Native_HAL.Emit_Newline (Success);
          end Emit_FASM16_String_Concat_Call;

          function Is_Text_Pipe_Unsigned_Tag
            (Tag : ALB_Type_Tag) return Boolean
          is
          begin
             return Tag = Type_U8
               or else Tag = Type_U16
               or else Tag = Type_U32
               or else Tag = Type_U64
               or else Tag = Type_Boolean;
          end Is_Text_Pipe_Unsigned_Tag;

          function Is_Text_Pipe_Signed_Tag
            (Tag : ALB_Type_Tag) return Boolean
          is
          begin
             return Tag = Type_S8
               or else Tag = Type_S16
               or else Tag = Type_S32
               or else Tag = Type_S64
               or else Tag = Type_HW8
               or else Tag = Type_HW16
               or else Tag = Type_HW32
               or else Tag = Type_HW64;
          end Is_Text_Pipe_Signed_Tag;

          procedure Emit_Text_Pipe_Segment
            (Expr_Node : Node_Index)
          is
             Expr_Tag : constant ALB_Type_Tag := Infer_Type_Tag (Expr_Node);
          begin
             if Expr_Tag = Type_Binary then
                Walk_AST (Expr_Node, Depth + 1, Right_Tag, Success, Diag);
                return;
             end if;

            if Expr_Tag = Type_Pure then
               if Target = Backend_FASM then
                  Walk_AST (Expr_Node, Depth + 1, Right_Tag, Success, Diag);
                  if not Success then
                     return;
                   end if;
                   Transpiler_Native_HAL.Emit_Raw ("  call ALB_String_From_Pure", Success);
                   Transpiler_Native_HAL.Emit_Newline (Success);
                elsif Target = Backend_FASM16 then
                   Walk_AST (Expr_Node, Depth + 1, Right_Tag, Success, Diag);
                   if not Success then
                      return;
                   end if;
                   Transpiler_Native_HAL.Emit_Raw ("  call ALB16_String_From_Pure", Success);
                   Transpiler_Native_HAL.Emit_Newline (Success);
                else
                   Transpiler_Native_HAL.Emit_Raw ("ALB_String_From_Pure(", Success);
                   Walk_AST (Expr_Node, Depth + 1, Right_Tag, Success, Diag);
                   if not Success then
                      return;
                   end if;
                   Transpiler_Native_HAL.Emit_Raw (")", Success);
               end if;
               return;
            end if;

            if Expr_Tag = Type_F64 then
               if Target = Backend_FASM16 then
                  Fail_Node
                    (Expr_Node,
                     Err_Type_Conflict,
                     "FASM16 text pipes do not support REAL segments",
                     Success,
                     Diag);
                  return;
               end if;

               if Target = Backend_FASM then
                  Walk_AST (Expr_Node, Depth + 1, Right_Tag, Success, Diag);
                  if not Success then
                     return;
                  end if;
                  Transpiler_Native_HAL.Emit_Raw ("  call ALB_String_From_F64", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);
               else
                  Transpiler_Native_HAL.Emit_Raw ("ALB_String_From_F64(", Success);
                  Walk_AST (Expr_Node, Depth + 1, Right_Tag, Success, Diag);
                  if not Success then
                     return;
                  end if;
                  Transpiler_Native_HAL.Emit_Raw (")", Success);
               end if;
               return;
            end if;

            if Is_Text_Pipe_Signed_Tag (Expr_Tag) then
               if Target = Backend_FASM16 and then Expr_Tag = Type_S64 then
                  Fail_Node
                    (Expr_Node,
                     Err_Type_Conflict,
                      "FASM16 text pipes support up to S32 segments",
                      Success,
                      Diag);
                   return;
                end if;

                if Target = Backend_FASM then
                   Walk_AST (Expr_Node, Depth + 1, Right_Tag, Success, Diag);
                   if not Success then
                      return;
                   end if;
                   Transpiler_Native_HAL.Emit_Raw ("  call ALB_String_From_S64", Success);
                   Transpiler_Native_HAL.Emit_Newline (Success);
                elsif Target = Backend_FASM16 then
                   Walk_AST (Expr_Node, Depth + 1, Right_Tag, Success, Diag);
                   if not Success then
                      return;
                   end if;
                   Transpiler_Native_HAL.Emit_Raw ("  call ALB16_String_From_S32", Success);
                   Transpiler_Native_HAL.Emit_Newline (Success);
                else
                   Transpiler_Native_HAL.Emit_Raw ("ALB_String_From_S64(", Success);
                   Walk_AST (Expr_Node, Depth + 1, Right_Tag, Success, Diag);
                   if not Success then
                      return;
                   end if;
                   Transpiler_Native_HAL.Emit_Raw (")", Success);
                end if;
                return;
             end if;

             if Is_Text_Pipe_Unsigned_Tag (Expr_Tag) then
                if Target = Backend_FASM16
                  and then (Expr_Tag = Type_U64 or else Expr_Tag = Type_HW64)
                then
                   Fail_Node
                     (Expr_Node,
                      Err_Type_Conflict,
                      "FASM16 text pipes support up to U32/HW32 segments",
                      Success,
                      Diag);
                   return;
                end if;

                if Target = Backend_FASM then
                   Walk_AST (Expr_Node, Depth + 1, Right_Tag, Success, Diag);
                   if not Success then
                      return;
                   end if;
                   Transpiler_Native_HAL.Emit_Raw ("  call ALB_String_From_U64", Success);
                   Transpiler_Native_HAL.Emit_Newline (Success);
                elsif Target = Backend_FASM16 then
                   Walk_AST (Expr_Node, Depth + 1, Right_Tag, Success, Diag);
                   if not Success then
                      return;
                   end if;
                   Transpiler_Native_HAL.Emit_Raw ("  call ALB16_String_From_U32", Success);
                   Transpiler_Native_HAL.Emit_Newline (Success);
                else
                   Transpiler_Native_HAL.Emit_Raw ("ALB_String_From_U64(", Success);
                   Walk_AST (Expr_Node, Depth + 1, Right_Tag, Success, Diag);
                   if not Success then
                      return;
                   end if;
                   Transpiler_Native_HAL.Emit_Raw (")", Success);
                end if;
                return;
             end if;

            Fail_Node
              (Expr_Node,
               Err_Type_Conflict,
               "TEXT pipes support STRING/BINARY, integer, BOOLEAN, REAL, and PURE segments only",
               Success,
               Diag);
          end Emit_Text_Pipe_Segment;

          
           function FASM16_Cell_Name
             (Sym         : Symbol_Record;
              Global_Name : String) return String
          is
          begin
             if Sym.Class = Class_Local and then Sym.Offset < 0 then
                declare
                   Img : constant String := Integer'Image (-Sym.Offset);
                begin
                   return "bp-" & Img (Img'First + 1 .. Img'Last);
                end;

             elsif Sym.Class = Class_Local and then Sym.Offset > 0 then
                declare
                   Img : constant String := Integer'Image (Sym.Offset);
                begin
                   return "bp+" & Img (Img'First + 1 .. Img'Last);
                end;

             else
                return Global_Name;
             end if;
          end FASM16_Cell_Name;

          procedure Emit_FASM_Range_Check_RAX
            (Range_ID : in Natural)
          is
          begin
             if Range_ID = 0 or else Range_ID > Range_Type_Count then
                return;
             end if;

              if Range_Types(Range_ID).Is_String_Length then
                 Transpiler_Native_HAL.Emit_Raw ("  test rax, rax", Success);
                 Transpiler_Native_HAL.Emit_Newline (Success);
                 Emit_Fallback_Or_Trap ("jz", "ALB_Runtime_Trap_Range");

                 Transpiler_Native_HAL.Emit_Raw ("  push rax", Success);
                 Transpiler_Native_HAL.Emit_Newline (Success);
                 Transpiler_Native_HAL.Emit_Raw ("  push rdi", Success);
                 Transpiler_Native_HAL.Emit_Newline (Success);
                 Transpiler_Native_HAL.Emit_Raw ("  mov rdi, rax", Success);
                 Transpiler_Native_HAL.Emit_Newline (Success);
                 Transpiler_Native_HAL.Emit_Raw ("  xor rcx, rcx", Success);
                 Transpiler_Native_HAL.Emit_Newline (Success);
                 Transpiler_Native_HAL.Emit_Raw ("  not rcx", Success);
                 Transpiler_Native_HAL.Emit_Newline (Success);
                 Transpiler_Native_HAL.Emit_Raw ("  xor al, al", Success);
                 Transpiler_Native_HAL.Emit_Newline (Success);
                 Transpiler_Native_HAL.Emit_Raw ("  repne scasb", Success);
                 Transpiler_Native_HAL.Emit_Newline (Success);
                 Transpiler_Native_HAL.Emit_Raw ("  not rcx", Success);
                 Transpiler_Native_HAL.Emit_Newline (Success);
                 Transpiler_Native_HAL.Emit_Raw ("  dec rcx", Success);
                 Transpiler_Native_HAL.Emit_Newline (Success);
                 Transpiler_Native_HAL.Emit_Raw ("  mov r10, rcx", Success);
                 Transpiler_Native_HAL.Emit_Newline (Success);
                 Transpiler_Native_HAL.Emit_Raw ("  pop rdi", Success);
                 Transpiler_Native_HAL.Emit_Newline (Success);
                 Transpiler_Native_HAL.Emit_Raw ("  pop rax", Success);
                 Transpiler_Native_HAL.Emit_Newline (Success);

                 Transpiler_Native_HAL.Emit_Raw ("  cmp r10, ", Success);
                 Transpiler_Native_HAL.Emit_Literal_U64 (Range_Types(Range_ID).Low_Value, Success);
                 Transpiler_Native_HAL.Emit_Newline (Success);
                 Emit_Fallback_Or_Trap ("jb", "ALB_Runtime_Trap_Range");

                 Transpiler_Native_HAL.Emit_Raw ("  cmp r10, ", Success);
                 Transpiler_Native_HAL.Emit_Literal_U64 (Range_Types(Range_ID).High_Value, Success);
                 Transpiler_Native_HAL.Emit_Newline (Success);
                 Emit_Fallback_Or_Trap ("ja", "ALB_Runtime_Trap_Range");
              else
                 Transpiler_Native_HAL.Emit_Raw ("  cmp rax, ", Success);
                 Transpiler_Native_HAL.Emit_Literal_U64 (Range_Types(Range_ID).Low_Value, Success);
                 Transpiler_Native_HAL.Emit_Newline (Success);
                 Emit_Fallback_Or_Trap ("jb", "ALB_Runtime_Trap_Range");

                 Transpiler_Native_HAL.Emit_Raw ("  cmp rax, ", Success);
                 Transpiler_Native_HAL.Emit_Literal_U64 (Range_Types(Range_ID).High_Value, Success);
                 Transpiler_Native_HAL.Emit_Newline (Success);
                 Emit_Fallback_Or_Trap ("ja", "ALB_Runtime_Trap_Range");
             end if;
         end Emit_FASM_Range_Check_RAX;
         
          procedure Emit_FASM16_Push_Args
            (Curr    : Node_Index;
             Sig     : ALB_Signature;
             Pos     : Natural;
             Use_Sig : Boolean)
          is
             Arg_Tag : ALB_Type_Tag := Type_U16;
          begin
             if Curr = 0 then
                return;
             end if;

             -- Push later source arguments first so [bp+4] is argument 1.
             Emit_FASM16_Push_Args
               (Tree (Curr).Next_Sibling,
                Sig,
                Pos + 1,
                Use_Sig);

             if not Success or else not Diag.Success then
                return;
             end if;

             if Use_Sig and then Pos <= Sig.Param_Count then
                Arg_Tag := Sig.Param_Tags (Pos);
             else
                Arg_Tag := Infer_Type_Tag (Curr);
             end if;

             Walk_AST (Curr, Depth + 1, Right_Tag, Success, Diag);
             if not Success or else not Diag.Success then
                return;
             end if;

             if Arg_Tag = Type_U32
               or else Arg_Tag = Type_S32
               or else Arg_Tag = Type_HW32
               or else Arg_Tag = Type_Pure
             then
                Transpiler_Native_HAL.Emit_Raw ("  push dx", Success);
                Transpiler_Native_HAL.Emit_Newline (Success);
                Transpiler_Native_HAL.Emit_Raw ("  push ax", Success);
                Transpiler_Native_HAL.Emit_Newline (Success);
             else
                Transpiler_Native_HAL.Emit_Raw ("  push ax", Success);
                Transpiler_Native_HAL.Emit_Newline (Success);
             end if;
          end Emit_FASM16_Push_Args;

         procedure Emit_FASM16_Push_Args_Forced
           (Curr        : Node_Index;
            Param_Tags  : ALB_Param_Tag_Array;
            Param_Count : Natural;
            Pos         : Natural;
            Graphics_Arg_Count : Natural := 0)
         is
            Arg_Tag : ALB_Type_Tag := Type_U16;
         begin
            if Curr = 0 then
               return;
            end if;

            Emit_FASM16_Push_Args_Forced
              (Tree (Curr).Next_Sibling,
               Param_Tags,
               Param_Count,
               Pos + 1,
               Graphics_Arg_Count);

            if not Success or else not Diag.Success then
               return;
            end if;

            if Pos <= Param_Count then
               Arg_Tag := Param_Tags (Pos);
            else
               Arg_Tag := Infer_Type_Tag (Curr);
            end if;

            if Pos <= Graphics_Arg_Count then
               Emit_FASM16_Graphics_Expr_To_DXAX (Curr);
            else
               Walk_AST (Curr, Depth + 1, Right_Tag, Success, Diag);
            end if;
            if not Success or else not Diag.Success then
               return;
            end if;

            if Arg_Tag = Type_U32
              or else Arg_Tag = Type_S32
              or else Arg_Tag = Type_HW32
              or else Arg_Tag = Type_Pure
            then
               Transpiler_Native_HAL.Emit_Raw ("  push dx", Success);
               Transpiler_Native_HAL.Emit_Newline (Success);
               Transpiler_Native_HAL.Emit_Raw ("  push ax", Success);
               Transpiler_Native_HAL.Emit_Newline (Success);
            else
               Transpiler_Native_HAL.Emit_Raw ("  push ax", Success);
               Transpiler_Native_HAL.Emit_Newline (Success);
            end if;
         end Emit_FASM16_Push_Args_Forced;
         
         function FASM16_Asm_Name (Name : String) return String is
         begin
            return "ALB16_USER_" & Name;
         end FASM16_Asm_Name;

         procedure Emit_FASM16_Call_With_Args
           (Name        : String;
            Arg_List    : Node_Index;
            Source_Name : String := "")
         is
            Curr    : Node_Index := Arg_List;
            Sig     : ALB_Signature;
            Use_Sig : Boolean := False;
         begin
            if Curr /= 0 and then Tree (Curr).Kind = AST_Arg_List then
               Curr := Tree (Curr).Left_Child;
            end if;

            if Source_Name'Length > 0 then
               Use_Sig := Find_ALB_Signature (Source_Name, Sig);
            end if;

            Emit_FASM16_Push_Args (Curr, Sig, 1, Use_Sig);
            if not Success or else not Diag.Success then
               return;
            end if;

            Transpiler_Native_HAL.Emit_Raw ("  call " & Name, Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
         end Emit_FASM16_Call_With_Args;

         procedure Emit_FASM16_Call_With_Forced_Tags
           (Name        : String;
            Arg_List    : Node_Index;
            Param_Tags  : ALB_Param_Tag_Array;
            Param_Count : Natural;
            Graphics_Arg_Count : Natural := 0)
         is
            Curr : Node_Index := Arg_List;
         begin
            if Curr /= 0 and then Tree (Curr).Kind = AST_Arg_List then
               Curr := Tree (Curr).Left_Child;
            end if;

            Emit_FASM16_Push_Args_Forced
              (Curr,
               Param_Tags,
               Param_Count,
               1,
               Graphics_Arg_Count);
            if not Success or else not Diag.Success then
               return;
            end if;

            Transpiler_Native_HAL.Emit_Raw ("  call " & Name, Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
         end Emit_FASM16_Call_With_Forced_Tags;
         
