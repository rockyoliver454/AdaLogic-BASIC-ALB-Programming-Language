                        Transpiler_Native_HAL.Emit_Raw
                          ("), ""wb""); if (_alb_fp_" & Label_Suffix & ") { fwrite(",
                           Success);
                        if Array_Byte_Size (Target_Lex, Buffer_Tag) > 0 then
                           Transpiler_Native_HAL.Emit_Raw
                             (C_Array_Data_Expr (Target_Lex),
                              Success);
                        else
                           Transpiler_Native_HAL.Emit_Raw ("&" & Target_Lex, Success);
                        end if;
                        if Size_Node > 0 then
                           Transpiler_Native_HAL.Emit_Raw
                             (", 1, (size_t)(uintptr_t)(", Success);
                           Walk_AST (Size_Node, Depth + 1, Right_Tag, Success, Diag);
                           if not Success then
                              return;
                           end if;
                           Transpiler_Native_HAL.Emit_Raw
                             ("), _alb_fp_" & Label_Suffix & "); fclose(_alb_fp_" & Label_Suffix & "); } }",
                              Success);
                        else
                           Transpiler_Native_HAL.Emit_Raw
                             (", 1, " & Nat_Img (Buffer_Bytes) & ", _alb_fp_" & Label_Suffix & "); fclose(_alb_fp_" & Label_Suffix & "); } }",
                              Success);
                        end if;
                     end if;
                     Transpiler_Native_HAL.Emit_Newline (Success);
                  else
                     Transpiler_Native_HAL.Emit_OS_Flush (Target_Lex, "TARGET_FILE_DYNAMIC", Success);
                  end if;
               end;
               
