         procedure Emit_FASM_Load_Scalar_To_RAX
            (Name    : in String;
             Tag     : in ALB_Type_Tag;
             Success : out Boolean)
          is
         begin
             if FASM_Target_Is_Out (Name) then
                Transpiler_Native_HAL.Emit_Raw
                  ("  mov rbx, qword [" & Name & "]", Success);
                Transpiler_Native_HAL.Emit_Newline (Success);
                case Tag is
                   when Type_U8 | Type_Boolean =>
                      Transpiler_Native_HAL.Emit_Raw
                        ("  movzx rax, byte [rbx]", Success);
                   when Type_S8 | Type_HW8 =>
                      Transpiler_Native_HAL.Emit_Raw
                        ("  movsx rax, byte [rbx]", Success);
                   when Type_U16 =>
                      Transpiler_Native_HAL.Emit_Raw
                        ("  movzx rax, word [rbx]", Success);
                   when Type_S16 | Type_HW16 =>
                      Transpiler_Native_HAL.Emit_Raw
                        ("  movsx rax, word [rbx]", Success);
                   when Type_U32 =>
                      Transpiler_Native_HAL.Emit_Raw
                        ("  mov eax, dword [rbx]", Success);
                   when Type_S32 | Type_HW32 =>
                      Transpiler_Native_HAL.Emit_Raw
                        ("  movsxd rax, dword [rbx]", Success);
                   when Type_F32 =>
                      -- F32 memory is dd; promote to F64 bits in RAX.
                      Transpiler_Native_HAL.Emit_Raw
                        ("  movd xmm0, dword [rbx]", Success);
                      Transpiler_Native_HAL.Emit_Newline (Success);
                      Transpiler_Native_HAL.Emit_Raw
                        ("  cvtss2sd xmm0, xmm0", Success);
                      Transpiler_Native_HAL.Emit_Newline (Success);
                      Transpiler_Native_HAL.Emit_Raw
                        ("  movq rax, xmm0", Success);
                   when others =>
                      Transpiler_Native_HAL.Emit_Raw
                        ("  mov rax, qword [rbx]", Success);
                end case;
                Transpiler_Native_HAL.Emit_Newline (Success);
                return;
             end if;

             case Tag is
                when Type_U8 | Type_Boolean =>
                   Transpiler_Native_HAL.Emit_Raw ("  movzx rax, byte [" & Name & "]", Success);
                when Type_S8 | Type_HW8 =>
                   Transpiler_Native_HAL.Emit_Raw ("  movsx rax, byte [" & Name & "]", Success);
                when Type_U16 =>
                   Transpiler_Native_HAL.Emit_Raw ("  movzx rax, word [" & Name & "]", Success);
                when Type_S16 | Type_HW16 =>
                   Transpiler_Native_HAL.Emit_Raw ("  movsx rax, word [" & Name & "]", Success);
                when Type_U32 =>
                   Transpiler_Native_HAL.Emit_Raw ("  mov eax, dword [" & Name & "]", Success);
                when Type_S32 | Type_HW32 =>
                   Transpiler_Native_HAL.Emit_Raw ("  movsxd rax, dword [" & Name & "]", Success);
                when Type_F32 =>
                   Transpiler_Native_HAL.Emit_Raw
                     ("  movd xmm0, dword [" & Name & "]", Success);
                   Transpiler_Native_HAL.Emit_Newline (Success);
                   Transpiler_Native_HAL.Emit_Raw
                     ("  cvtss2sd xmm0, xmm0", Success);
                   Transpiler_Native_HAL.Emit_Newline (Success);
                   Transpiler_Native_HAL.Emit_Raw
                     ("  movq rax, xmm0", Success);
                when others =>
                   Transpiler_Native_HAL.Emit_Raw ("  mov rax, qword [" & Name & "]", Success);
             end case;

             Transpiler_Native_HAL.Emit_Newline (Success);
          end Emit_FASM_Load_Scalar_To_RAX;

           procedure Emit_FASM_Store_RAX_To_Scalar
             (Name    : in String;
              Tag     : in ALB_Type_Tag;
              Success : out Boolean)
           is
           begin
              if FASM_Target_Is_Out (Name) then
                 Transpiler_Native_HAL.Emit_Raw
                   ("  mov rbx, qword [" & Name & "]", Success);
                 Transpiler_Native_HAL.Emit_Newline (Success);
                 case Tag is
                    when Type_U8 | Type_S8 | Type_HW8 | Type_Boolean =>
                       Transpiler_Native_HAL.Emit_Raw
                         ("  mov byte [rbx], al", Success);
                    when Type_U16 | Type_S16 | Type_HW16 =>
                       Transpiler_Native_HAL.Emit_Raw
                         ("  mov word [rbx], ax", Success);
                    when Type_U32 | Type_HW32 | Type_S32 =>
                       Transpiler_Native_HAL.Emit_Raw
                         ("  mov dword [rbx], eax", Success);
                    when Type_F32 =>
                       -- RAX holds F64 bits; demote to F32 memory.
                       Transpiler_Native_HAL.Emit_Raw
                         ("  movq xmm0, rax", Success);
                       Transpiler_Native_HAL.Emit_Newline (Success);
                       Transpiler_Native_HAL.Emit_Raw
                         ("  cvtsd2ss xmm0, xmm0", Success);
                       Transpiler_Native_HAL.Emit_Newline (Success);
                       Transpiler_Native_HAL.Emit_Raw
                         ("  movd dword [rbx], xmm0", Success);
                    when Type_U128 | Type_S128 | Type_F128 | Type_Pure
                       | Type_F32x4 | Type_Mat2x2 =>
                       Transpiler_Native_HAL.Emit_Raw
                         ("  mov qword [rbx], rax", Success);
                       Transpiler_Native_HAL.Emit_Newline (Success);
                       Transpiler_Native_HAL.Emit_Raw
                         ("  mov qword [rbx + 8], 0", Success);
                    when others =>
                       Transpiler_Native_HAL.Emit_Raw
                         ("  mov qword [rbx], rax", Success);
                 end case;
                 Transpiler_Native_HAL.Emit_Newline (Success);
                 return;
              end if;

              if Exact_Depth > 0 then
                 case Tag is
                    when Type_U8 | Type_HW8 =>
                       Transpiler_Native_HAL.Emit_Raw ("  cmp rax, 255", Success);
                       Transpiler_Native_HAL.Emit_Newline (Success);
                       Emit_Fallback_Or_Trap ("ja", "ALB_Runtime_Trap_Range");
                    when Type_S8 =>
                       Transpiler_Native_HAL.Emit_Raw ("  cmp rax, 127", Success);
                       Transpiler_Native_HAL.Emit_Newline (Success);
                       Emit_Fallback_Or_Trap ("jg", "ALB_Runtime_Trap_Range");
                       Transpiler_Native_HAL.Emit_Raw ("  cmp rax, -128", Success);
                       Transpiler_Native_HAL.Emit_Newline (Success);
                       Emit_Fallback_Or_Trap ("jl", "ALB_Runtime_Trap_Range");
                    when Type_Boolean =>
                       Transpiler_Native_HAL.Emit_Raw ("  cmp rax, 1", Success);
                       Transpiler_Native_HAL.Emit_Newline (Success);
                       Emit_Fallback_Or_Trap ("ja", "ALB_Runtime_Trap_Range");
                    when Type_U16 | Type_HW16 =>
                       Transpiler_Native_HAL.Emit_Raw ("  cmp rax, 65535", Success);
                       Transpiler_Native_HAL.Emit_Newline (Success);
                       Emit_Fallback_Or_Trap ("ja", "ALB_Runtime_Trap_Range");
                    when Type_S16 =>
                       Transpiler_Native_HAL.Emit_Raw ("  cmp rax, 32767", Success);
                       Transpiler_Native_HAL.Emit_Newline (Success);
                       Emit_Fallback_Or_Trap ("jg", "ALB_Runtime_Trap_Range");
                       Transpiler_Native_HAL.Emit_Raw ("  cmp rax, -32768", Success);
                       Transpiler_Native_HAL.Emit_Newline (Success);
                       Emit_Fallback_Or_Trap ("jl", "ALB_Runtime_Trap_Range");
                    when Type_U32 | Type_HW32 | Type_S32 =>
                       Transpiler_Native_HAL.Emit_Raw ("  mov r10, rax", Success);
                       Transpiler_Native_HAL.Emit_Newline (Success);
                       Transpiler_Native_HAL.Emit_Raw ("  shr r10, 32", Success);
                       Transpiler_Native_HAL.Emit_Newline (Success);
                       Emit_Fallback_Or_Trap ("jnz", "ALB_Runtime_Trap_Range");
                    when others =>
                       null;
                 end case;
              end if;
              case Tag is
                 when Type_U8 | Type_S8 | Type_HW8 | Type_Boolean =>
                    Transpiler_Native_HAL.Emit_Raw ("  mov byte [" & Name & "], al", Success);
                 when Type_U16 | Type_S16 | Type_HW16 =>
                    Transpiler_Native_HAL.Emit_Raw ("  mov word [" & Name & "], ax", Success);
                 when Type_U32 | Type_HW32 | Type_S32 =>
                    Transpiler_Native_HAL.Emit_Raw ("  mov dword [" & Name & "], eax", Success);
                 when Type_F32 =>
                    Transpiler_Native_HAL.Emit_Raw ("  movq xmm0, rax", Success);
                    Transpiler_Native_HAL.Emit_Newline (Success);
                    Transpiler_Native_HAL.Emit_Raw ("  cvtsd2ss xmm0, xmm0", Success);
                    Transpiler_Native_HAL.Emit_Newline (Success);
                    Transpiler_Native_HAL.Emit_Raw
                      ("  movd dword [" & Name & "], xmm0", Success);
                 when Type_U128 | Type_S128 | Type_F128 | Type_Pure
                    | Type_F32x4 | Type_Mat2x2 =>
                    -- Soft lane in RAX; keep high qword zeroed for honesty.
                    Transpiler_Native_HAL.Emit_Raw
                      ("  mov qword [" & Name & "], rax", Success);
                    Transpiler_Native_HAL.Emit_Newline (Success);
                    Transpiler_Native_HAL.Emit_Raw
                      ("  mov qword [" & Name & " + 8], 0", Success);
                 when others =>
                    Transpiler_Native_HAL.Emit_Raw ("  mov qword [" & Name & "], rax", Success);
              end case;

              Transpiler_Native_HAL.Emit_Newline (Success);
           end Emit_FASM_Store_RAX_To_Scalar;

          procedure Emit_FASM_Test_RAX_For_Truth
            (Tag     : in ALB_Type_Tag;
             Success : out Boolean)
          is
          begin
             if Tag = Type_Pure then
                Transpiler_Native_HAL.Emit_Raw ("  mov r10, rax", Success);
                Transpiler_Native_HAL.Emit_Newline (Success);
                Transpiler_Native_HAL.Emit_Raw ("  sar r10, 32", Success);
                Transpiler_Native_HAL.Emit_Newline (Success);
                Transpiler_Native_HAL.Emit_Raw ("  test r10, r10", Success);
             else
                Transpiler_Native_HAL.Emit_Raw ("  test rax, rax", Success);
             end if;

             Transpiler_Native_HAL.Emit_Newline (Success);
          end Emit_FASM_Test_RAX_For_Truth;

          function C_Trim_Image (Text : String) return String is
             First : Natural := Text'First;
          begin
             while First <= Text'Last and then Text (First) = ' ' loop
                First := First + 1;
             end loop;

             if First > Text'Last then
                return "0";
             end if;

             return Text (First .. Text'Last);
          end C_Trim_Image;

          function C_Reversible_Current_Expr
            (Name : String;
             Tag  : ALB_Type_Tag) return String
          is
          begin
             case Tag is
                when Type_U8 | Type_Boolean =>
                   return "((uint64_t)(uint8_t)(" & Name & "))";

                when Type_HW8 =>
                   return "((uint64_t)(uint8_t)(int8_t)(" & Name & "))";

                when Type_U16 =>
                   return "((uint64_t)(uint16_t)(" & Name & "))";

                when Type_HW16 =>
                   return "((uint64_t)(uint16_t)(int16_t)(" & Name & "))";

                when Type_U32 =>
                   return "((uint64_t)(uint32_t)(" & Name & "))";

                when Type_S32 | Type_HW32 =>
                   return "((uint64_t)(uint32_t)(int32_t)(" & Name & "))";

                when others =>
                   return "((uint64_t)(" & Name & "))";
             end case;
          end C_Reversible_Current_Expr;

          function C_Reversible_Assign_Expr
            (Tag        : ALB_Type_Tag;
             Value_Expr : String) return String
          is
          begin
             case Tag is
                when Type_U8 | Type_Boolean =>
                   return "((uint8_t)(" & Value_Expr & "))";

                when Type_HW8 =>
                   return "((int8_t)(uint8_t)(" & Value_Expr & "))";

                when Type_U16 =>
                   return "((uint16_t)(" & Value_Expr & "))";

                when Type_HW16 =>
                   return "((int16_t)(uint16_t)(" & Value_Expr & "))";

                when Type_U32 =>
                   return "((uint32_t)(" & Value_Expr & "))";

                when Type_S32 | Type_HW32 =>
                   return "((int32_t)(uint32_t)(" & Value_Expr & "))";

                when others =>
                   return "((uint64_t)(" & Value_Expr & "))";
             end case;
          end C_Reversible_Assign_Expr;

          function C_Reversible_Width_Bits
            (Tag : ALB_Type_Tag) return Natural
          is
          begin
             case Tag is
                when Type_U8 | Type_HW8 | Type_Boolean =>
                   return 8;

                when Type_U16 | Type_HW16 =>
                   return 16;

                when Type_U32 | Type_S32 | Type_HW32 =>
                   return 32;

                when others =>
                   return 64;
             end case;
          end C_Reversible_Width_Bits;

          procedure Emit_C_Temporal_Future_Helper
            (Name    : in String;
             Tag     : in ALB_Type_Tag;
             Success : in out Boolean)
          is
             procedure Ensure_C_Chrono_Decls is
                Saved_Success : Boolean := Success;
             begin
                if Target /= Backend_C or else Chrono_C_Decls_Emitted or else not Success then
                   return;
                end if;

                Chrono_C_Decls_Emitted := True;
                Transpiler_Native_HAL.Set_Global_Buffer_Mode (True);
                Transpiler_Native_HAL.Emit_Raw ("void ALB_Save_State(void);", Saved_Success);
                Transpiler_Native_HAL.Emit_Newline (Saved_Success);
                Transpiler_Native_HAL.Emit_Raw ("void ALB_Load_State(void);", Saved_Success);
                Transpiler_Native_HAL.Emit_Newline (Saved_Success);
                Transpiler_Native_HAL.Emit_Raw ("uint64_t ALB_ON_TICK_func(void);", Saved_Success);
                Transpiler_Native_HAL.Emit_Newline (Saved_Success);
                Transpiler_Native_HAL.Emit_Newline (Saved_Success);
                Transpiler_Native_HAL.Set_Global_Buffer_Mode (False);
                Success := Saved_Success;
             end Ensure_C_Chrono_Decls;
           begin
              Chrono_Used := True;
             Ensure_C_Chrono_Decls;

              if not Temporal_Future_Used then
                 Temporal_Future_Used := True;
              end if;

             Transpiler_Native_HAL.Set_Global_Buffer_Mode (True);
             Transpiler_Native_HAL.Emit_Indent (Success);
             Transpiler_Native_HAL.Emit_Raw
               ("static uint64_t ALB_TEMP_FUTURE_" & Name & "(void) {", Success);
             Transpiler_Native_HAL.Emit_Newline (Success);
             Transpiler_Native_HAL.Increase_Indent;

             Transpiler_Native_HAL.Emit_Indent (Success);
             Transpiler_Native_HAL.Emit_Raw ("if (ALB_TEMP_Future_Depth != 0) { return ", Success);
             Transpiler_Native_HAL.Emit_Temporal_Load_Now (Name, Tag, Success);
             Transpiler_Native_HAL.Emit_Raw ("; }", Success);
             Transpiler_Native_HAL.Emit_Newline (Success);

             Transpiler_Native_HAL.Emit_Indent (Success);
             Transpiler_Native_HAL.Emit_Raw ("ALB_TEMP_Future_Depth = 1;", Success);
             Transpiler_Native_HAL.Emit_Newline (Success);

             Transpiler_Native_HAL.Emit_Indent (Success);
             Transpiler_Native_HAL.Emit_Raw ("ALB_Save_State();", Success);
             Transpiler_Native_HAL.Emit_Newline (Success);

             Transpiler_Native_HAL.Emit_Indent (Success);
             Transpiler_Native_HAL.Emit_Raw ("ALB_TEMP_Future_Suppress_IO = 1;", Success);
             Transpiler_Native_HAL.Emit_Newline (Success);

             Transpiler_Native_HAL.Emit_Indent (Success);
             Transpiler_Native_HAL.Emit_Raw ("ALB_ON_TICK_func();", Success);
             Transpiler_Native_HAL.Emit_Newline (Success);

             Transpiler_Native_HAL.Emit_Indent (Success);
             Transpiler_Native_HAL.Emit_Raw ("ALB_TEMP_Future_Suppress_IO = 0;", Success);
             Transpiler_Native_HAL.Emit_Newline (Success);

             Transpiler_Native_HAL.Emit_Indent (Success);
             Transpiler_Native_HAL.Emit_Raw ("ALB_TEMP_Future_Result = ", Success);
             Transpiler_Native_HAL.Emit_Temporal_Load_Now (Name, Tag, Success);
             Transpiler_Native_HAL.Emit_Raw (";", Success);
             Transpiler_Native_HAL.Emit_Newline (Success);

             Transpiler_Native_HAL.Emit_Indent (Success);
             Transpiler_Native_HAL.Emit_Raw ("ALB_Load_State();", Success);
             Transpiler_Native_HAL.Emit_Newline (Success);

             Transpiler_Native_HAL.Emit_Indent (Success);
             Transpiler_Native_HAL.Emit_Raw ("ALB_TEMP_Future_Depth = 0;", Success);
             Transpiler_Native_HAL.Emit_Newline (Success);

             Transpiler_Native_HAL.Emit_Indent (Success);
             Transpiler_Native_HAL.Emit_Raw ("return ALB_TEMP_Future_Result;", Success);
             Transpiler_Native_HAL.Emit_Newline (Success);

             Transpiler_Native_HAL.Decrease_Indent;
             Transpiler_Native_HAL.Emit_Indent (Success);
             Transpiler_Native_HAL.Emit_Raw ("}", Success);
             Transpiler_Native_HAL.Emit_Newline (Success);
             Transpiler_Native_HAL.Emit_Newline (Success);
             Transpiler_Native_HAL.Set_Global_Buffer_Mode (False);
          end Emit_C_Temporal_Future_Helper;

          procedure Emit_Temporal_Record_All
            (Success : in out Boolean;
             Diag    : in out Compiler_Diagnostic)
         is
            Local_Success : Boolean := True;
         begin
            for I in 1 .. Temporal_Count loop
               if Temporal_Entries(I).Active then
                  Transpiler_Native_HAL.Emit_Temporal_Record_Current
                    (Temporal_Entries(I).Name(1 .. Temporal_Entries(I).Name_Len),
                     Temporal_Entries(I).Tag,
                     Temporal_Entries(I).History_Depth,
                     Local_Success);

                  if not Local_Success then
                     Success := False;
                     Diag.Success := False;
                     Diag.Code := Err_Type_Conflict;
                     return;
                  end if;
               end if;
            end loop;
         end Emit_Temporal_Record_All;

         procedure Emit_FASM_Copy_QWords
           (Src     : in String;
            Dest    : in String;
            Count   : in Natural;
            Success : out Boolean)
         is
            Img        : constant String := Natural'Image (Count);
            Count_Text : constant String := Img (Img'First + 1 .. Img'Last);
         begin
            Transpiler_Native_HAL.Emit_Raw ("  push rsi", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            Transpiler_Native_HAL.Emit_Raw ("  push rdi", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);

            Transpiler_Native_HAL.Emit_Raw ("  lea rsi, [" & Src & "]", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            Transpiler_Native_HAL.Emit_Raw ("  lea rdi, [" & Dest & "]", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            Transpiler_Native_HAL.Emit_Raw ("  mov rcx, " & Count_Text, Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            Transpiler_Native_HAL.Emit_Raw ("  rep movsq", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);

            Transpiler_Native_HAL.Emit_Raw ("  pop rdi", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            Transpiler_Native_HAL.Emit_Raw ("  pop rsi", Success);
