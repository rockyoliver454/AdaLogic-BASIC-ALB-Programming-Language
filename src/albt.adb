      procedure Ensure_Static_Graphics_Runtime is
      begin
         if Static_Graphics_Runtime_Used
           or else (Target /= Backend_FASM and then Target /= Backend_C)
         then
            return;
         end if;

         Static_Graphics_Runtime_Used := True;
         if Target = Backend_FASM then
