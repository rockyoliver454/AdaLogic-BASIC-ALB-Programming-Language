   procedure Register_FASM16_Pointer_Meta
     (Name        : String;
      Scope       : Natural;
      Pointee_Tag : ALB_Type_Tag)
   is
      H        : constant U32 := Hash_String (Name);
      Clip_Len : Natural := Name'Length;
   begin
      if Clip_Len > 128 then
         Clip_Len := 128;
      end if;

      for I in 1 .. FASM16_Pointer_Meta_Count loop
         if FASM16_Pointer_Meta (I).Active
           and then FASM16_Pointer_Meta (I).Name_Hash = H
           and then FASM16_Pointer_Meta (I).Scope = Scope
           and then FASM16_Pointer_Meta (I).Name_Len = Clip_Len
           and then FASM16_Pointer_Meta (I).Name (1 .. Clip_Len) =
             Name (Name'First .. Name'First + Clip_Len - 1)
         then
            if Pointee_Tag = Type_None then
               FASM16_Pointer_Meta (I).Active := False;
            else
               FASM16_Pointer_Meta (I).Pointee_Tag := Pointee_Tag;
            end if;
            return;
         end if;
      end loop;

      if Pointee_Tag = Type_None then
         return;
      end if;

      if FASM16_Pointer_Meta_Count < Max_FASM16_Pointer_Meta then
         FASM16_Pointer_Meta_Count := FASM16_Pointer_Meta_Count + 1;
         FASM16_Pointer_Meta (FASM16_Pointer_Meta_Count).Name_Hash := H;
         FASM16_Pointer_Meta (FASM16_Pointer_Meta_Count).Name_Len := Clip_Len;
         FASM16_Pointer_Meta (FASM16_Pointer_Meta_Count).Name := (others => ' ');
         if Clip_Len > 0 then
            FASM16_Pointer_Meta (FASM16_Pointer_Meta_Count).Name (1 .. Clip_Len) :=
              Name (Name'First .. Name'First + Clip_Len - 1);
         end if;
         FASM16_Pointer_Meta (FASM16_Pointer_Meta_Count).Scope := Scope;
         FASM16_Pointer_Meta (FASM16_Pointer_Meta_Count).Pointee_Tag := Pointee_Tag;
         FASM16_Pointer_Meta (FASM16_Pointer_Meta_Count).Active := True;
      end if;
   end Register_FASM16_Pointer_Meta;

   function Find_FASM16_Pointer_Meta
     (Name  : String;
      Scope : Natural) return ALB_Type_Tag
   is
      H        : constant U32 := Hash_String (Name);
      Clip_Len : Natural := Name'Length;
      Best_Tag : ALB_Type_Tag := Type_None;
      Best_Scope : Natural := 0;
   begin
      if Clip_Len > 128 then
         Clip_Len := 128;
      end if;

      for I in 1 .. FASM16_Pointer_Meta_Count loop
         if FASM16_Pointer_Meta (I).Active
           and then FASM16_Pointer_Meta (I).Name_Hash = H
           and then FASM16_Pointer_Meta (I).Scope <= Scope
           and then FASM16_Pointer_Meta (I).Scope >= Best_Scope
           and then FASM16_Pointer_Meta (I).Name_Len = Clip_Len
           and then FASM16_Pointer_Meta (I).Name (1 .. Clip_Len) =
             Name (Name'First .. Name'First + Clip_Len - 1)
         then
            Best_Tag := FASM16_Pointer_Meta (I).Pointee_Tag;
            Best_Scope := FASM16_Pointer_Meta (I).Scope;
         end if;
      end loop;

      return Best_Tag;
   end Find_FASM16_Pointer_Meta;

   procedure Drop_FASM16_Pointer_Meta (Target_Scope : Natural) is
   begin
      for I in 1 .. FASM16_Pointer_Meta_Count loop
         if FASM16_Pointer_Meta (I).Active
           and then FASM16_Pointer_Meta (I).Scope >= Target_Scope
         then
            FASM16_Pointer_Meta (I).Active := False;
         end if;
      end loop;
   end Drop_FASM16_Pointer_Meta;
   
   function Find_Range_Type (Name : String) return Natural is
      U : constant String := Upper_ASCII(Name);
      H : constant U32 := Hash_String(U);
   begin
      for I in 1 .. Range_Type_Count loop
         if Range_Types(I).Active
           and then Range_Types(I).Name_Hash = H
           and then Range_Types(I).Name_Len = U'Length
           and then Range_Types(I).Name(1 .. U'Length) = U
         then
            return I;
         end if;
      end loop;

      return 0;
   end Find_Range_Type;

   function Find_Range_Var (Name : String) return Natural is
