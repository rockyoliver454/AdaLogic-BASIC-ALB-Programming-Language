                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw
                          ("  je .alb_flush_strlen_done_" & Label_Suffix,
                           Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  inc r8", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw
