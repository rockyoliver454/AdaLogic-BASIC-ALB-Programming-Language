                  Transpiler_Native_HAL.Emit_Raw ("ALB_CEASE();", Success);
                  if not Success then return; end if;
                  Transpiler_Native_HAL.Emit_Newline (Success);
               elsif Target = Backend_FASM or else Target = Backend_FASM16 then
                  Transpiler_Native_HAL.Emit_Indent (Success);
                  if not Success then return; end if;
                  Transpiler_Native_HAL.Emit_Raw ("call ALB_CEASE", Success);
                  if not Success then return; end if;
                  Transpiler_Native_HAL.Emit_Newline (Success);
               end if;
               Out_Tag := Type_None;

            when AST_On_Block =>
               declare
                  Tok : Token := Tokens (Tree (Node).Token_Index);
                  Block_Node : Node_Index := Tree (Node).Left_Child;
                  Saved_Local_Offset : constant Integer := Local_Offset;
                  Opened_Scope       : constant Boolean := Target /= Backend_FASM16;
               begin
                  -- We hoist the ON blocks intae global C functions!
                  if Tok.Kind = Tok_Tick then
                     Transpiler_Native_HAL.Emit_Procedure_Decl_Start ("ALB_ON_TICK", Success);
                     Has_On_Tick := True; -- DA FLAG!
                  elsif Tok.Kind = Tok_Paint then
                     Transpiler_Native_HAL.Emit_Procedure_Decl_Start ("ALB_ON_PAINT", Success);
                     Has_On_Paint := True; -- DA FLAG!
                  else
                     Transpiler_Native_HAL.Emit_Procedure_Decl_Start ("ALB_ON_EVENT", Success);
                     Has_On_Event := True;
                  end if;

                  if Opened_Scope then
                     Current_Scope := Current_Scope + 1;
                     Local_Offset := 0;
                  end if;
                  
                  Walk_AST (Block_Node, Depth + 1, Out_Tag, Success, Diag);
                  
                  if Tok.Kind = Tok_Tick then
                     Transpiler_Native_HAL.Emit_Procedure_End ("ALB_ON_TICK", Success);
                  elsif Tok.Kind = Tok_Paint then
                     Transpiler_Native_HAL.Emit_Procedure_End ("ALB_ON_PAINT", Success);
                  else
                     Transpiler_Native_HAL.Emit_Procedure_End ("ALB_ON_EVENT", Success);
                  end if;

                  if Opened_Scope then
                        Symbol_Table.Drop_Scope (Current_Scope, Success);
                        Clear_Out_Params;
                        Current_Scope := Current_Scope - 1;
                     Local_Offset := Saved_Local_Offset;
                  end if;
               end;
               
            when AST_Key_State =>
