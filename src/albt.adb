            when AST_Call_Stmt =>
               declare
                  Expr_Node : Node_Index := Tree (Node).Left_Child;
               begin
                  if Expr_Node > 0 then
                     if Tree(Expr_Node).Kind = AST_Func_Call then
                        declare
                           Target_Node : Node_Index := Tree (Expr_Node).Left_Child;
                           Arg_Node    : Node_Index := Tree (Expr_Node).Right_Child;
                           TName       : String (1 .. 128) := (others => ' ');
                           TLen        : Natural := 0;
                        begin
                           Resolve_ALB_Call_Name(Target_Node, TName, TLen);

                           if TLen = 0 then
                              Fail_Call_Diagnostic("CALL", Tree(Node).Token_Index, Err_Proc_Not_Found, Success, Diag);
                              return;
                           end if;

                           if Is_ALB_Builtin_Call_Name(TName(1 .. TLen)) then
                              -- Built-ins such as PRINT_PURE still lower through
                              -- the expression router because they are special forms.
                              Walk_AST (Expr_Node, Depth + 1, Out_Tag, Success, Diag);

                              if Target = Backend_C then
                                 Transpiler_Native_HAL.Emit_Statement_End(Success);
                              end if;
                           else
                              Validate_Foreign_Call(TName(1 .. TLen), Arg_Node, Tree(Node).Token_Index, Success, Diag);
                              if not Success or else not Diag.Success then return; end if;

                              Validate_ALB_Call(TName(1 .. TLen), Arg_Node, Tree(Node).Token_Index, False, Success, Diag);
                              if not Success or else not Diag.Success then return; end if;

                              if Target = Backend_FASM then
                                 Emit_FASM_Call_With_Args (TName (1 .. TLen), Arg_Node);
                              elsif Target = Backend_FASM16 then
                                 Emit_FASM16_Call_With_Args
                                   (FASM16_Asm_Name (TName (1 .. TLen)),
                                    Arg_Node,
                                    TName (1 .. TLen));
                              else
                                 Transpiler_Native_HAL.Emit_Call_Start (TName (1 .. TLen), Success);
                                 if Arg_Node > 0 then
                                    if Tree (Arg_Node).Kind = AST_Arg_List then
                                       Arg_Node := Tree (Arg_Node).Left_Child;
                                    end if;

                                    while Arg_Node > 0 loop
                                       Walk_AST (Arg_Node, Depth + 1, Right_Tag, Success, Diag);
                                       Arg_Node := Tree (Arg_Node).Next_Sibling;
                                       if Arg_Node > 0 then
                                          Transpiler_Native_HAL.Emit_Comma (Success);
                                       end if;
                                    end loop;
                                 end if;
                                 Transpiler_Native_HAL.Emit_Call_End (Success);
                                 Transpiler_Native_HAL.Emit_Statement_End (Success);
                              end if;
                           end if;
                        end;
                     else
                        -- It's a zero-arity bare call parsed as an AST_Var_Expr
                        declare
                           TName : String (1 .. 128) := (others => ' ');
                           TLen  : Natural := 0;
                        begin
                           Resolve_ALB_Call_Name(Expr_Node, TName, TLen);

                           if TLen = 0 then
                              Fail_Call_Diagnostic("CALL", Tree(Node).Token_Index, Err_Proc_Not_Found, Success, Diag);
                              return;
                           end if;

                           if not Is_ALB_Builtin_Call_Name(TName(1 .. TLen)) then
                              Validate_Foreign_Call(TName(1 .. TLen), 0, Tree(Node).Token_Index, Success, Diag);
                              if not Success or else not Diag.Success then return; end if;

                              Validate_ALB_Call(TName(1 .. TLen), 0, Tree(Node).Token_Index, False, Success, Diag);
                              if not Success or else not Diag.Success then return; end if;
                           end if;

                           if Target = Backend_FASM then
                              Emit_FASM_Call_With_Args (TName (1 .. TLen), 0);
                           elsif Target = Backend_FASM16 then
                              Emit_FASM16_Call_With_Args (FASM16_Asm_Name (TName (1 .. TLen)), 0, TName (1 .. TLen));
                           else
                              Transpiler_Native_HAL.Emit_Call_Start (TName (1 .. TLen), Success);
                              Transpiler_Native_HAL.Emit_Call_End (Success);
                              Transpiler_Native_HAL.Emit_Statement_End (Success);
                           end if;
                        end;
                     end if;
                  end if;
                  Out_Tag := Type_None;
               end;
               
            
            when AST_Func_Call | AST_Constructor =>
               declare
                  Target_Node : Node_Index := Tree (Node).Left_Child;
                  Arg_Node    : Node_Index := Tree (Node).Right_Child;
                  Tok         : Token := Tokens (Tree (Target_Node).Token_Index);
                  Lexeme      : String := Input_Buffer (Tok.Start .. Tok.Start + Tok.Length - 1);
               begin
                  if Tree (Target_Node).Kind = AST_Var_Expr and then Lexeme = "|" then
                     declare
                        Curr_Segment : Node_Index := Arg_Node;
                     begin
                        if Curr_Segment > 0 and then Tree (Curr_Segment).Kind = AST_Arg_List then
                           Curr_Segment := Tree (Curr_Segment).Left_Child;
                        end if;

                        if Curr_Segment = 0 then
                           Fail_Node
                             (Node,
                              Err_Compiler_AST_Mismatch,
                              "TEXT pipe missing segment",
                              Success,
                              Diag);
                           return;
                        end if;

                        if Target = Backend_FASM then
                           Emit_Text_Pipe_Segment (Curr_Segment);
                           if not Success then
                              return;
                           end if;

                           Curr_Segment := Tree (Curr_Segment).Next_Sibling;
                           while Curr_Segment > 0 loop
                              Transpiler_Native_HAL.Emit_Raw ("  push rax", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);

                              Emit_Text_Pipe_Segment (Curr_Segment);
                              if not Success then
                                 return;
                              end if;

                              Transpiler_Native_HAL.Emit_Raw ("  mov rdx, rax", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  pop rcx", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  call ALB_String_Concat", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);

                              Curr_Segment := Tree (Curr_Segment).Next_Sibling;
                           end loop;

                        elsif Target = Backend_FASM16 then
                           Emit_Text_Pipe_Segment (Curr_Segment);
                           if not Success then
                              return;
                           end if;

                           Curr_Segment := Tree (Curr_Segment).Next_Sibling;
                           while Curr_Segment > 0 loop
                              Transpiler_Native_HAL.Emit_Raw ("  push dx", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);

                              Emit_Text_Pipe_Segment (Curr_Segment);
                              if not Success then
                                 return;
                              end if;

                              Transpiler_Native_HAL.Emit_Raw ("  mov bx, dx", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  pop dx", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  call ALB16_String_Concat", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);

                              Curr_Segment := Tree (Curr_Segment).Next_Sibling;
                           end loop;

                        else
                           Transpiler_Native_HAL.Emit_Raw ("(ALB_Text_Pipe_Left = (", Success);
                           Emit_Text_Pipe_Segment (Curr_Segment);
                           if not Success then
                              return;
                           end if;
                           Transpiler_Native_HAL.Emit_Raw (")", Success);

                           Curr_Segment := Tree (Curr_Segment).Next_Sibling;
                           while Curr_Segment > 0 loop
                              Transpiler_Native_HAL.Emit_Raw
                                (", ALB_Text_Pipe_Right = (",
                                 Success);
                              Emit_Text_Pipe_Segment (Curr_Segment);
                              if not Success then
                                 return;
                              end if;
                              Transpiler_Native_HAL.Emit_Raw
                                ("), ALB_Text_Pipe_Left = ALB_String_Concat(ALB_Text_Pipe_Left, ALB_Text_Pipe_Right)",
                                 Success);

                              Curr_Segment := Tree (Curr_Segment).Next_Sibling;
                           end loop;

                           Transpiler_Native_HAL.Emit_Raw
                             (", ALB_Text_Pipe_Left)",
                              Success);
                        end if;

                        Out_Tag := Type_Binary;
                        return;
                     end;
                  end if;

                  if Tree(Target_Node).Kind = AST_Var_Expr and then 
                      (Lexeme = "PURE" or else Lexeme = "RATIONAL" or else Lexeme = "PURE_ADD" or else Lexeme = "PURE_SUB" or else 
                       Lexeme = "PURE_MUL" or else Lexeme = "PURE_DIV" or else Lexeme = "PRINT_PURE" or else
                       Lexeme = "PURE_POW" or else Lexeme = "PURE_NUM" or else Lexeme = "PURE_DEN" or else
                       Lexeme = "HW8" or else Lexeme = "HW16" or else Lexeme = "HW32" or else Lexeme = "U8" or else 
                       Lexeme = "U16" or else Lexeme = "U32" or else Lexeme = "U64" or else 
                       Lexeme = "U128" or else Lexeme = "S8" or else Lexeme = "S16" or else
                       Lexeme = "S32" or else Lexeme = "S64" or else Lexeme = "I8" or else
                       Lexeme = "I16" or else Lexeme = "I32" or else Lexeme = "I64" or else
                       Lexeme = "INT8" or else Lexeme = "INT16" or else Lexeme = "INT32" or else
                       Lexeme = "INT64" or else Lexeme = "F64" or else Lexeme = "REAL" or else 
                       Lexeme = "LEN" or else Lexeme = "LEFT" or else Lexeme = "RIGHT" or else
                      Lexeme = "MID" or else Lexeme = "MID$" or else Lexeme = "CHR" or else Lexeme = "ASC" or else Lexeme = "CONCAT" or else
                      Lexeme = "SIN" or else Lexeme = "COS" or else 
                      Lexeme = "SQRT" or else Lexeme = "EXP")
                  then
                     declare
                        Actual_Func : String (1 .. 64) := (others => ' ');
                        Func_Len    : Natural := Lexeme'Length;
                     begin
                        Actual_Func (1 .. Func_Len) := Lexeme;
                        if Actual_Func (1 .. Func_Len) = "PURE" or else
                           Actual_Func (1 .. Func_Len) = "RATIONAL" or else
                           Actual_Func (1 .. Func_Len) = "PURE_ADD" or else
                           Actual_Func (1 .. Func_Len) = "PURE_SUB" or else
                           Actual_Func (1 .. Func_Len) = "PURE_MUL" or else
                           Actual_Func (1 .. Func_Len) = "PURE_DIV" or else
                           Actual_Func (1 .. Func_Len) = "PURE_POW" or else
                           Actual_Func (1 .. Func_Len) = "PURE_NUM" or else -- NEW!
                           Actual_Func (1 .. Func_Len) = "PURE_DEN" or else -- NEW!
                           Actual_Func (1 .. Func_Len) = "PRINT_PURE" or else
                           Actual_Func (1 .. Func_Len) = "HW8"  or else
                           Actual_Func (1 .. Func_Len) = "HW16" or else
                           Actual_Func (1 .. Func_Len) = "HW32" or else
                           Actual_Func (1 .. Func_Len) = "U8"   or else
                           Actual_Func (1 .. Func_Len) = "U16"  or else
                           Actual_Func (1 .. Func_Len) = "U32"  or else
                           Actual_Func (1 .. Func_Len) = "U64"  or else
                           Actual_Func (1 .. Func_Len) = "U128" or else
                           Actual_Func (1 .. Func_Len) = "S8"   or else
                           Actual_Func (1 .. Func_Len) = "S16"  or else
                           Actual_Func (1 .. Func_Len) = "S32"  or else
                           Actual_Func (1 .. Func_Len) = "S64"  or else
                           Actual_Func (1 .. Func_Len) = "I8"   or else
                           Actual_Func (1 .. Func_Len) = "I16"  or else
                           Actual_Func (1 .. Func_Len) = "I32"  or else
                           Actual_Func (1 .. Func_Len) = "I64"  or else
                           Actual_Func (1 .. Func_Len) = "INT8" or else
                           Actual_Func (1 .. Func_Len) = "INT16" or else
                           Actual_Func (1 .. Func_Len) = "INT32" or else
                           Actual_Func (1 .. Func_Len) = "INT64" or else
                           Actual_Func (1 .. Func_Len) = "F64" or else
                           Actual_Func (1 .. Func_Len) = "REAL" then
                           
                           if Target = Backend_FASM then
                              if Actual_Func (1 .. Func_Len) = "PURE"
                                or else Actual_Func (1 .. Func_Len) = "RATIONAL"
                              then
                                 -- DA 64-BIT PACKED PURE FORGE!
                                 declare
                                    Num_Node : Node_Index := Arg_Node;
                                    Den_Node : Node_Index := 0;
                                 begin
                                    if Num_Node > 0 and then Tree(Num_Node).Kind = AST_Arg_List then
                                       Num_Node := Tree(Num_Node).Left_Child;
                                       if Num_Node > 0 then Den_Node := Tree(Num_Node).Next_Sibling; end if;
                                    end if;
                                    
                                    -- Walk Denominator intae rbx
                                    if Den_Node > 0 then
                                       Walk_AST (Den_Node, Depth + 1, Right_Tag, Success, Diag);
                                       Transpiler_Native_HAL.Emit_Raw ("  mov rbx, rax", Success); Transpiler_Native_HAL.Emit_Newline(Success);
                                    else
                                       Transpiler_Native_HAL.Emit_Raw ("  mov rbx, 1", Success); Transpiler_Native_HAL.Emit_Newline(Success);
                                    end if;
                                    
                                    -- Walk Numerator intae rax
                                    if Num_Node > 0 then
                                       Transpiler_Native_HAL.Emit_Raw ("  push rbx", Success); Transpiler_Native_HAL.Emit_Newline(Success);
                                       Walk_AST (Num_Node, Depth + 1, Right_Tag, Success, Diag);
                                       Transpiler_Native_HAL.Emit_Raw ("  pop rbx", Success); Transpiler_Native_HAL.Emit_Newline(Success);
                                    else
                                       Transpiler_Native_HAL.Emit_Raw ("  xor rax, rax", Success); Transpiler_Native_HAL.Emit_Newline(Success);
                                    end if;
                                    
                                    -- Pack 'em: (Num << 32) | (Den & 0xFFFFFFFF)
                                    Transpiler_Native_HAL.Emit_Raw ("  shl rax, 32", Success); Transpiler_Native_HAL.Emit_Newline(Success);
                                    Transpiler_Native_HAL.Emit_Raw ("  mov rcx, 0xFFFFFFFF", Success); Transpiler_Native_HAL.Emit_Newline(Success);
                                    Transpiler_Native_HAL.Emit_Raw ("  and rbx, rcx", Success); Transpiler_Native_HAL.Emit_Newline(Success);
                                    Transpiler_Native_HAL.Emit_Raw ("  or rax, rbx", Success); Transpiler_Native_HAL.Emit_Newline(Success);
                                    Transpiler_Native_HAL.Emit_Raw ("  call ALB_Pure_Normalize", Success); Transpiler_Native_HAL.Emit_Newline(Success);
                                 end;
                              elsif Actual_Func (1 .. Func_Len) = "PURE_NUM" then
                                 if Arg_Node > 0 then
                                    if Tree (Arg_Node).Kind = AST_Arg_List then Arg_Node := Tree (Arg_Node).Left_Child; end if;
                                    Walk_AST (Arg_Node, Depth + 1, Right_Tag, Success, Diag);
                                    Transpiler_Native_HAL.Emit_Raw ("  sar rax, 32", Success);
                                    Transpiler_Native_HAL.Emit_Newline (Success);
                                 else
                                    Transpiler_Native_HAL.Emit_Raw ("  xor rax, rax", Success);
                                    Transpiler_Native_HAL.Emit_Newline (Success);
                                 end if;

                              elsif Actual_Func (1 .. Func_Len) = "PURE_DEN" then
                                 if Arg_Node > 0 then
                                    if Tree (Arg_Node).Kind = AST_Arg_List then Arg_Node := Tree (Arg_Node).Left_Child; end if;
                                    Walk_AST (Arg_Node, Depth + 1, Right_Tag, Success, Diag);
                                    Transpiler_Native_HAL.Emit_Raw ("  mov rcx, 0xFFFFFFFF", Success);
                                    Transpiler_Native_HAL.Emit_Newline (Success);
                                    Transpiler_Native_HAL.Emit_Raw ("  and rax, rcx", Success);
                                    Transpiler_Native_HAL.Emit_Newline (Success);
                                 else
                                    Transpiler_Native_HAL.Emit_Raw ("  xor rax, rax", Success);
                                    Transpiler_Native_HAL.Emit_Newline (Success);
                                 end if;
                              elsif Actual_Func (1 .. Func_Len) = "PURE_ADD" or else
                                    Actual_Func (1 .. Func_Len) = "PURE_SUB" or else
                                    Actual_Func (1 .. Func_Len) = "PURE_MUL" or else
                                    Actual_Func (1 .. Func_Len) = "PURE_DIV" or else
                                    Actual_Func (1 .. Func_Len) = "PURE_POW"
                              then
                                 declare
                                    Left_Arg  : Node_Index := Arg_Node;
                                    Right_Arg : Node_Index := 0;
                                 begin
                                    if Left_Arg > 0 and then Tree (Left_Arg).Kind = AST_Arg_List then
                                       Left_Arg := Tree (Left_Arg).Left_Child;
                                       if Left_Arg > 0 then
                                          Right_Arg := Tree (Left_Arg).Next_Sibling;
                                       end if;
                                    end if;

                                    Walk_AST (Left_Arg, Depth + 1, Left_Tag, Success, Diag);
                                    if not Success then
                                       return;
                                    end if;
                                    Transpiler_Native_HAL.Emit_Raw ("  push rax", Success);
                                    Transpiler_Native_HAL.Emit_Newline (Success);

                                    Walk_AST (Right_Arg, Depth + 1, Right_Tag, Success, Diag);
                                    if not Success then
                                       return;
                                    end if;
                                    Transpiler_Native_HAL.Emit_Raw ("  mov rdx, rax", Success);
                                    Transpiler_Native_HAL.Emit_Newline (Success);
                                    Transpiler_Native_HAL.Emit_Raw ("  pop rcx", Success);
                                    Transpiler_Native_HAL.Emit_Newline (Success);

                                    if Actual_Func (1 .. Func_Len) = "PURE_ADD" then
                                       Transpiler_Native_HAL.Emit_Raw ("  fastcall ALB_Pure_Add", Success);
                                    elsif Actual_Func (1 .. Func_Len) = "PURE_SUB" then
                                       Transpiler_Native_HAL.Emit_Raw ("  fastcall ALB_Pure_Sub", Success);
