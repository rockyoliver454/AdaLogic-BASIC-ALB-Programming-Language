                  if Current_Function_Return_Range > 0 then
                     Emit_FASM_Range_Check_RAX(Current_Function_Return_Range);
                     if not Success then return; end if;
                  end if;
                  
                  -- 2. Undo SELECT stash + 32-byte shadow, then restore RBX
