                     Transpiler_Native_HAL.Emit_Raw
                       ("  invoke CreateFileA, rcx, GENERIC_WRITE, 0, 0, CREATE_ALWAYS, 0, 0",
                        Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Emit_Raw ("  cmp rax, -1", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Emit_Raw
                       ("  je .alb_flush_skip_" & Label_Suffix,
                        Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Emit_Raw ("  mov rbx, rax", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);

                     if Is_Text_Flush then
                        Walk_AST (Var_Node, Depth + 1, Right_Tag, Success, Diag);
                        if not Success then
                           return;
                        end if;

                        Transpiler_Native_HAL.Emit_Raw ("  mov rdx, rax", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  xor r8, r8", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  test rdx, rdx", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw
                          ("  je .alb_flush_text_done_" & Label_Suffix,
                           Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw
                          (".alb_flush_strlen_loop_" & Label_Suffix & ":",
