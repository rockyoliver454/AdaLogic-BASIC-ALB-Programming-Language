                           if not Success then
                              return;
                           end if;
                           Transpiler_Native_HAL.Emit_Raw ("  mov r8, rax", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                        else
                           Transpiler_Native_HAL.Emit_Raw
                             ("  mov r8, " & Nat_Img (Buffer_Bytes),
                              Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                        end if;
                        Transpiler_Native_HAL.Emit_Raw
                          ("  invoke WriteFile, rbx, rdx, r8, 0, 0",
                           Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                     end if;
                     Transpiler_Native_HAL.Emit_Raw
                       ("  invoke CloseHandle, rbx",
                        Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Emit_Raw
                       (".alb_flush_skip_" & Label_Suffix & ":",
                        Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                  elsif Target = Backend_C then
                     Transpiler_Native_HAL.Emit_Indent (Success);
                     if Is_Text_Flush then
