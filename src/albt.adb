            Transpiler_Native_HAL.Emit_Raw ("  mov qword [ALB_TEMP_Future_Suppress_IO], 1", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);

            

            for I in 1 .. Temporal_Count loop
               if Temporal_Entries(I).Active then
                  declare
                     N : constant String :=
                       Temporal_Entries(I).Name (1 .. Temporal_Entries(I).Name_Len);
                  begin
                     Transpiler_Native_HAL.Emit_Temporal_Load_Now
                       (N, Temporal_Entries(I).Tag, Success);
                     if not Success then return; end if;

                     Transpiler_Native_HAL.Emit_Raw
                       ("  mov qword [ALB_FUT_" & N & "_value], rax", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);

                     Transpiler_Native_HAL.Emit_Raw
                       ("  mov rax, qword [ALB_TEMP_" & N & "_head]", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Emit_Raw
                       ("  mov qword [ALB_FUT_" & N & "_head], rax", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);

                     Emit_FASM_Copy_QWords
                       ("ALB_TEMP_" & N & "_history",
                        "ALB_FUT_" & N & "_history",
                        Temporal_Entries(I).History_Depth,
                        Success);
                     if not Success then return; end if;
                  end;
               end if;
            end loop;

            Transpiler_Native_HAL.Emit_Raw ("  call ALB_ON_TICK", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            
            Transpiler_Native_HAL.Emit_Raw ("  mov qword [ALB_TEMP_Future_Suppress_IO], 0", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            

            Transpiler_Native_HAL.Emit_Temporal_Load_Now
              (Target_Name, Target_Tag, Success);
            if not Success then return; end if;

            Transpiler_Native_HAL.Emit_Raw
              ("  mov qword [ALB_TEMP_Future_Result], rax", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);

            for I in 1 .. Temporal_Count loop
               if Temporal_Entries(I).Active then
                  declare
                     N : constant String :=
                       Temporal_Entries(I).Name (1 .. Temporal_Entries(I).Name_Len);
                  begin
                     Transpiler_Native_HAL.Emit_Raw
                       ("  mov rax, qword [ALB_FUT_" & N & "_value]", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Emit_FASM_Store_RAX_To_Scalar
                       (N, Temporal_Entries(I).Tag, Success);
                     if not Success then return; end if;

                     Transpiler_Native_HAL.Emit_Raw
                       ("  mov rax, qword [ALB_FUT_" & N & "_head]", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Emit_Raw
                       ("  mov qword [ALB_TEMP_" & N & "_head], rax", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);

                     Emit_FASM_Copy_QWords
                       ("ALB_FUT_" & N & "_history",
                        "ALB_TEMP_" & N & "_history",
                        Temporal_Entries(I).History_Depth,
                        Success);
                     if not Success then return; end if;
                  end;
               end if;
            end loop;
            
            Emit_FASM_Future_Restore_World_State (Success);
            if not Success then return; end if;
            

            Transpiler_Native_HAL.Emit_Raw ("  dec qword [ALB_TEMP_Future_Depth]", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            Transpiler_Native_HAL.Emit_Raw ("  mov rax, qword [ALB_TEMP_Future_Result]", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            Transpiler_Native_HAL.Emit_Raw ("  jmp .alb_future_done_" & NID, Success);
            Transpiler_Native_HAL.Emit_Newline (Success);

            Transpiler_Native_HAL.Emit_Raw (".alb_future_nested_" & NID & ":", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            Transpiler_Native_HAL.Emit_Raw ("  ; nested @future aliases @now to prevent recursive prediction", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            Transpiler_Native_HAL.Emit_Temporal_Load_Now
              (Target_Name, Target_Tag, Success);

            Transpiler_Native_HAL.Emit_Raw (".alb_future_done_" & NID & ":", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
         end Emit_FASM_Temporal_Future_To_RAX;

