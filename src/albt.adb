         procedure Emit_FASM16_Index_Bounds_Check (Bound : in Natural) is
          begin
             if Bound = 0 then
                return;
             end if;

             declare
                Img : constant String := Natural'Image (Bound);
             begin
                Transpiler_Native_HAL.Emit_Raw ("  cmp dx, 0", Success);
                Transpiler_Native_HAL.Emit_Newline (Success);
                Emit_FASM16_Long_Trap_Jcc ("jne", "ALB16_Runtime_Bounds");

                Transpiler_Native_HAL.Emit_Raw ("  cmp ax, 0", Success);
                Transpiler_Native_HAL.Emit_Newline (Success);
                Emit_FASM16_Long_Trap_Jcc ("jz", "ALB16_Runtime_Bounds");

                Transpiler_Native_HAL.Emit_Raw ("  cmp ax, " & Img (Img'First + 1 .. Img'Last), Success);
                Transpiler_Native_HAL.Emit_Newline (Success);
                Emit_FASM16_Long_Trap_Jcc ("ja", "ALB16_Runtime_Bounds");
             end;
          end Emit_FASM16_Index_Bounds_Check;
         
         
         procedure Emit_FASM16_Array_Index_Offset_To_BX
           (Array_Name       : in String;
            First_Index_Node : in Node_Index;
            Elem_Bytes       : in Natural)
         is
            Arr_Idx    : Natural := Find_Strict_Array (Array_Name);
            Slide_Idx  : Natural := Find_Slide_Array (Array_Name);
            Dummy_Tag  : ALB_Type_Tag := Type_None;
            Bound      : Natural := 0;

            procedure Scale_AX_By_Element_Size is
            begin
               if Elem_Bytes = 2 then
                  Transpiler_Native_HAL.Emit_Raw ("  shl ax, 1", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);
               elsif Elem_Bytes = 4 then
                  Transpiler_Native_HAL.Emit_Raw ("  shl ax, 1", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);
                  Transpiler_Native_HAL.Emit_Raw ("  shl ax, 1", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);
               elsif Elem_Bytes /= 1 then
                  Fail_Node (First_Index_Node, Err_Type_Conflict, Array_Name, Success, Diag);
                  return;
               end if;
            end Scale_AX_By_Element_Size;
         begin
            if First_Index_Node = 0 then
               Transpiler_Native_HAL.Emit_Raw ("  xor bx, bx", Success);
               Transpiler_Native_HAL.Emit_Newline (Success);
               return;
            end if;

            if Arr_Idx > 0 and then Strict_Arrays (Arr_Idx).Dim_Count > 1 then
               declare
                  Curr_Index : Node_Index := First_Index_Node;
                  Dim_No     : Natural := 1;
               begin
                  Walk_AST (Curr_Index, Depth + 1, Dummy_Tag, Success, Diag);
                  if not Success then
                     return;
                  end if;

                  Emit_FASM16_Index_Bounds_Check (Strict_Arrays (Arr_Idx).Dims (Dim_No));
                  if not Success then
                     return;
                  end if;

                  Transpiler_Native_HAL.Emit_Raw ("  sub ax, 1", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);
                  Transpiler_Native_HAL.Emit_Raw ("  push ax", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);

                  while Dim_No < Strict_Arrays (Arr_Idx).Dim_Count loop
                     Curr_Index := Tree (Curr_Index).Next_Sibling;

                     if Curr_Index = 0 then
                        Fail_Node (First_Index_Node, Err_Type_Conflict, Array_Name, Success, Diag);
                        return;
                     end if;

                     Walk_AST (Curr_Index, Depth + 1, Dummy_Tag, Success, Diag);
                     if not Success then
                        return;
                     end if;

                     Dim_No := Dim_No + 1;
                     Emit_FASM16_Index_Bounds_Check (Strict_Arrays (Arr_Idx).Dims (Dim_No));
                     if not Success then
                        return;
                     end if;

                     Transpiler_Native_HAL.Emit_Raw ("  mov cx, ax", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Emit_Raw ("  dec cx", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Emit_Raw ("  pop ax", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Emit_Raw ("  mov bx, ", Success);
                     Transpiler_Native_HAL.Emit_Literal_U64
                       (U64 (Strict_Arrays (Arr_Idx).Dims (Dim_No)),
                        Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Emit_Raw ("  mul bx", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Emit_Raw ("  add ax, cx", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Emit_Raw ("  push ax", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                  end loop;

                  if Tree (Curr_Index).Next_Sibling > 0 then
                     Fail_Node (First_Index_Node, Err_Type_Conflict, Array_Name, Success, Diag);
                     return;
                  end if;

                  Transpiler_Native_HAL.Emit_Raw ("  pop ax", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);
                  Transpiler_Native_HAL.Emit_Raw ("  inc ax", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);

                  Scale_AX_By_Element_Size;
                  if not Success then
                     return;
                  end if;

                  Transpiler_Native_HAL.Emit_Raw ("  mov bx, ax", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);
                  return;
               end;
            elsif Tree (First_Index_Node).Next_Sibling > 0 then
               Fail_Node (First_Index_Node, Err_Type_Conflict, Array_Name, Success, Diag);
               return;
            end if;

            Walk_AST (First_Index_Node, Depth + 1, Dummy_Tag, Success, Diag);
            if not Success then
               return;
            end if;

            if Slide_Idx > 0 then
               Bound := Slide_Arrays (Slide_Idx).Active;
            elsif Arr_Idx > 0 and then Strict_Arrays (Arr_Idx).Dim_Count >= 1 then
               Bound := Strict_Arrays (Arr_Idx).Dims (1);
            end if;

            if Bound > 0
              and then not FASM16_Index_Is_Loop_Guarded (First_Index_Node, Bound)
            then
               Emit_FASM16_Index_Bounds_Check (Bound);
               if not Success then
                  return;
               end if;
            end if;

            Scale_AX_By_Element_Size;
            if not Success then
               return;
            end if;

            Transpiler_Native_HAL.Emit_Raw ("  mov bx, ax", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
         end Emit_FASM16_Array_Index_Offset_To_BX;
         
         
         procedure Validate_Static_Range_Expr
           (Expr_Node : in Node_Index;
            Range_ID  : in Natural;
            Origin    : in Node_Index;
            Success   : in out Boolean;
            Diag      : in out Compiler_Diagnostic)
         is
            Num_Val : U64 := 0;
            Str_Len : U64 := 0;
         begin
            if Range_ID = 0 or else Range_ID > Range_Type_Count or else Expr_Node = 0 then
               return;
            end if;

            if Range_Types(Range_ID).Is_String_Length then
               if Tree(Expr_Node).Kind = AST_String_Expr then
                  Str_Len := U64(Strip_String_Node(Expr_Node)'Length);

                  if Str_Len < Range_Types(Range_ID).Low_Value
                    or else Str_Len > Range_Types(Range_ID).High_Value
                  then
                     Fail_Node(Origin, Err_Type_Conflict,
                               Range_Types(Range_ID).Name(1 .. Range_Types(Range_ID).Name_Len),
                               Success, Diag);
                     return;
                  end if;
               end if;
            else
               if Try_Literal_U64(Expr_Node, Num_Val) then
                  if Num_Val < Range_Types(Range_ID).Low_Value
                    or else Num_Val > Range_Types(Range_ID).High_Value
                  then
                     Fail_Node(Origin, Err_Type_Conflict,
                               Range_Types(Range_ID).Name(1 .. Range_Types(Range_ID).Name_Len),
                               Success, Diag);
                     return;
                  end if;
               end if;
            end if;
         end Validate_Static_Range_Expr;

         


         procedure Emit_FASM_Array_Index_Offset_To_RAX
           (Array_Name       : in String;
            First_Index_Node : in Node_Index)
         is
            Arr_Idx    : Natural := Find_Strict_Array (Array_Name);
            Slide_Idx  : Natural := Find_Slide_Array (Array_Name);
            Dim_No     : Natural := 1;
            Curr_Index : Node_Index := First_Index_Node;
            Dummy_Tag  : ALB_Type_Tag := Type_None;
            Bound      : Natural := 0;
            Elem_Bytes : constant Natural :=
              Array_Element_Bytes (Array_Declared_Tag (Array_Name, Type_U64));

            procedure Scale_RAX_By_Element_Size is
            begin
               if Elem_Bytes = 2 then
                  Transpiler_Native_HAL.Emit_Raw ("  shl rax, 1", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);
               elsif Elem_Bytes = 4 then
                  Transpiler_Native_HAL.Emit_Raw ("  shl rax, 2", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);
               elsif Elem_Bytes = 8 then
                  Transpiler_Native_HAL.Emit_Raw ("  shl rax, 3", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);
               elsif Elem_Bytes /= 1 then
                  Fail_Node (First_Index_Node, Err_Type_Conflict, Array_Name, Success, Diag);
               end if;
            end Scale_RAX_By_Element_Size;
         begin
            if First_Index_Node = 0 then
               Transpiler_Native_HAL.Emit_Raw ("  xor rax, rax", Success);
               Transpiler_Native_HAL.Emit_Newline (Success);
               return;
            end if;

            if Arr_Idx = 0 or else Strict_Arrays(Arr_Idx).Dim_Count <= 1 then
               Walk_AST (First_Index_Node, Depth + 1, Dummy_Tag, Success, Diag);
               if not Success then return; end if;

               if Arr_Idx > 0 and then Strict_Arrays(Arr_Idx).Dim_Count >= 1 then
                  Bound := Strict_Arrays(Arr_Idx).Dims(1);
               elsif Slide_Idx > 0 then
                  Bound := Slide_Arrays(Slide_Idx).Active;
               end if;

               if Bound > 0 then
                  Emit_FASM_Index_Bounds_Check (Bound);
               end if;

               Scale_RAX_By_Element_Size;
               return;
            end if;

            Walk_AST (Curr_Index, Depth + 1, Dummy_Tag, Success, Diag);
            if not Success then return; end if;

            Emit_FASM_Index_Bounds_Check (Strict_Arrays(Arr_Idx).Dims(Dim_No));

            Transpiler_Native_HAL.Emit_Raw ("  sub rax, 1", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);

            while Dim_No < Strict_Arrays(Arr_Idx).Dim_Count loop
               Curr_Index := Tree (Curr_Index).Next_Sibling;

               if Curr_Index = 0 then
                  Fail_Node (First_Index_Node, Err_Compiler_AST_Mismatch, Array_Name, Success, Diag);
                  return;
               end if;

               Transpiler_Native_HAL.Emit_Raw ("  push rax", Success);
               Transpiler_Native_HAL.Emit_Newline (Success);
               Transpiler_Native_HAL.Emit_Raw ("  sub rsp, 8", Success);
               Transpiler_Native_HAL.Emit_Newline (Success);

               Walk_AST (Curr_Index, Depth + 1, Dummy_Tag, Success, Diag);
               if not Success then return; end if;

               Dim_No := Dim_No + 1;
               Emit_FASM_Index_Bounds_Check (Strict_Arrays(Arr_Idx).Dims(Dim_No));

               Transpiler_Native_HAL.Emit_Raw ("  mov rbx, rax", Success);
               Transpiler_Native_HAL.Emit_Newline (Success);
               Transpiler_Native_HAL.Emit_Raw ("  add rsp, 8", Success);
               Transpiler_Native_HAL.Emit_Newline (Success);
               Transpiler_Native_HAL.Emit_Raw ("  pop rax", Success);
               Transpiler_Native_HAL.Emit_Newline (Success);

               Transpiler_Native_HAL.Emit_Raw ("  imul rax, ", Success);
               Transpiler_Native_HAL.Emit_Literal_U64 (U64 (Strict_Arrays(Arr_Idx).Dims(Dim_No)), Success);
               Transpiler_Native_HAL.Emit_Newline (Success);

               Transpiler_Native_HAL.Emit_Raw ("  sub rbx, 1", Success);
               Transpiler_Native_HAL.Emit_Newline (Success);
               Transpiler_Native_HAL.Emit_Raw ("  add rax, rbx", Success);
               Transpiler_Native_HAL.Emit_Newline (Success);
            end loop;

            if Tree (Curr_Index).Next_Sibling > 0 then
               Fail_Node (First_Index_Node, Err_Compiler_AST_Mismatch, Array_Name, Success, Diag);
               return;
            end if;

            Transpiler_Native_HAL.Emit_Raw ("  add rax, 1", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            Scale_RAX_By_Element_Size;
         end Emit_FASM_Array_Index_Offset_To_RAX;


         
         procedure Emit_FASM_Logic_Value_To_RAX (Expr_Node : in Node_Index) is
            Dummy_Tag : ALB_Type_Tag := Type_None;
         begin
            if Expr_Node = 0 then
               Transpiler_Native_HAL.Emit_Raw ("  xor rax, rax", Success);
               Transpiler_Native_HAL.Emit_Newline (Success);

            elsif Tree (Expr_Node).Kind = AST_String_Expr then
               declare
                  Lex : constant String := Strip_String_Node (Expr_Node);
               begin
                  Transpiler_Native_HAL.Emit_Raw ("  mov rax, ", Success);
                  Transpiler_Native_HAL.Emit_Literal_U64 (U64 (Hash_String (Lex)), Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);
               end;

            elsif Tree (Expr_Node).Kind = AST_Atom then
               declare
                  Tok : Token := Tokens (Tree (Expr_Node).Token_Index);
                  Lex : String := Input_Buffer (Tok.Start .. Tok.Start + Tok.Length - 1);
               begin
                  Transpiler_Native_HAL.Emit_Raw ("  mov rax, ", Success);
                  Transpiler_Native_HAL.Emit_Literal_U64 (U64 (Hash_String (Lex)), Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);
               end;

            elsif Tree (Expr_Node).Kind = AST_Var_Expr
              and then Tree (Expr_Node).Left_Child = 0
            then
               declare
                  Tok : Token := Tokens (Tree (Expr_Node).Token_Index);
                  Lex : String := Input_Buffer (Tok.Start .. Tok.Start + Tok.Length - 1);
               begin
                  if Lex'Length > 0 and then Lex (Lex'First) in 'a' .. 'z' then
                     -- Prolog-style lowercase bare identifiers are atoms in logic context.
                     Transpiler_Native_HAL.Emit_Raw ("  mov rax, ", Success);
                     Transpiler_Native_HAL.Emit_Literal_U64 (U64 (Hash_String (Lex)), Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                  else
                     Walk_AST (Expr_Node, Depth + 1, Dummy_Tag, Success, Diag);
                  end if;
               end;

            else
               Walk_AST (Expr_Node, Depth + 1, Dummy_Tag, Success, Diag);
            end if;

         end Emit_FASM_Logic_Value_To_RAX;
         
         procedure Emit_FASM16_Load_Predicate_To_SI
           (Pred       : in String;
            Owner_Node : in Node_Index;
            Suffix     : in String)
         is
            Img   : constant String := Node_Index'Image (Owner_Node);
            NID   : constant String := Img (Img'First + 1 .. Img'Last);
            Label : constant String := ".alb16_pred_" & NID & "_" & Suffix;
         begin
            Transpiler_Native_HAL.Emit_Raw ("  jmp " & Label & "_skip", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            Transpiler_Native_HAL.Emit_Raw ("  " & Label & " db """ & Pred & """, 0", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            Transpiler_Native_HAL.Emit_Raw (Label & "_skip:", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
            Transpiler_Native_HAL.Emit_Raw ("  lea si, [" & Label & "]", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);
         end Emit_FASM16_Load_Predicate_To_SI;

         procedure Emit_FASM16_Logic_Value_To_DXAX (Expr_Node : in Node_Index) is
            Dummy_Tag : ALB_Type_Tag := Type_None;
         begin
            if Expr_Node = 0 then
               Transpiler_Native_HAL.Emit_Raw ("  xor ax, ax", Success);
               Transpiler_Native_HAL.Emit_Newline (Success);
               Transpiler_Native_HAL.Emit_Raw ("  xor dx, dx", Success);
               Transpiler_Native_HAL.Emit_Newline (Success);

            elsif Tree (Expr_Node).Kind = AST_String_Expr then
               declare
                  Lex : constant String := Strip_String_Node (Expr_Node);
               begin
                  Emit_FASM16_Literal_DXAX
                    (U64 (Hash_String (Lex)),
                     Expr_Node,
                     "FASM16 logic string hash exceeds U32");
               end;

            elsif Tree (Expr_Node).Kind = AST_Atom then
               declare
                  Tok : Token := Tokens (Tree (Expr_Node).Token_Index);
                  Lex : String := Input_Buffer (Tok.Start .. Tok.Start + Tok.Length - 1);
               begin
                  Emit_FASM16_Literal_DXAX
                    (U64 (Hash_String (Lex)),
                     Expr_Node,
                     "FASM16 logic atom hash exceeds U32");
               end;

            elsif Tree (Expr_Node).Kind = AST_Var_Expr
              and then Tree (Expr_Node).Left_Child = 0
            then
               declare
                  Tok : Token := Tokens (Tree (Expr_Node).Token_Index);
                  Lex : String := Input_Buffer (Tok.Start .. Tok.Start + Tok.Length - 1);
               begin
                  if Lex'Length > 0 and then Lex (Lex'First) in 'a' .. 'z' then
                     Emit_FASM16_Literal_DXAX
                       (U64 (Hash_String (Lex)),
                        Expr_Node,
                        "FASM16 logic bare atom hash exceeds U32");
                  else
                     Walk_AST (Expr_Node, Depth + 1, Dummy_Tag, Success, Diag);
                  end if;
               end;

            else
               Walk_AST (Expr_Node, Depth + 1, Dummy_Tag, Success, Diag);
            end if;
         end Emit_FASM16_Logic_Value_To_DXAX;
         
