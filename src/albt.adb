                            Transpiler_Native_HAL.Emit_Raw ("  push rax", Success);
                            Transpiler_Native_HAL.Emit_Newline (Success);
                           if Right_Expr_Tag = Type_Binary then
                              Transpiler_Native_HAL.Emit_Raw ("  mov rdx, rbx", Success);
                           else
                              Transpiler_Native_HAL.Emit_Raw ("  mov rax, rbx", Success); Transpiler_Native_HAL.Emit_Newline (Success);
                              if Right_Expr_Tag = Type_Pure then
                                 Transpiler_Native_HAL.Emit_Raw ("  call ALB_String_From_Pure", Success);
                              elsif Right_Expr_Tag = Type_F64 then
