            Emit_Global_Line ("#define ALB_NET_CLOSE_RAW(sock) closesocket(sock)");
            Emit_Global_Line ("#else");
            Emit_Global_Line ("typedef int ALB_SOCKET_T;");
            Emit_Global_Line ("typedef socklen_t ALB_SOCKLEN_T;");
            Emit_Global_Line ("#define ALB_INVALID_SOCKET (-1)");
            Emit_Global_Line ("#define ALB_NET_CLOSE_RAW(sock) close(sock)");
            Emit_Global_Line ("#endif");
            Emit_Global_Line ("static int ALB_NET_Ready = 0;");
            Emit_Global_Line ("static void ALB_NET_Pack_Cells(uint8_t* dst, const void* src_cells, uint64_t elements, uint64_t elem_bytes, uint64_t used_bytes) {");
            Emit_Global_Line ("    uint64_t i;");
            Emit_Global_Line ("    uint64_t j;");
            Emit_Global_Line ("    uint64_t offset;");
            Emit_Global_Line ("    const uint8_t* src = (const uint8_t*)src_cells;");
            Emit_Global_Line ("    for (i = 0; i < elements; i++) {");
            Emit_Global_Line ("        for (j = 0; j < elem_bytes; j++) {");
            Emit_Global_Line ("            offset = (i * elem_bytes) + j;");
            Emit_Global_Line ("            if (offset >= used_bytes) { return; }");
            Emit_Global_Line ("            dst[offset] = src[offset];");
            Emit_Global_Line ("        }");
            Emit_Global_Line ("    }");
            Emit_Global_Line ("}");
            Emit_Global_Line ("static void ALB_NET_Unpack_Cells(void* dest_cells, const uint8_t* src, uint64_t elements, uint64_t elem_bytes, uint64_t used_bytes) {");
            Emit_Global_Line ("    uint64_t i;");
            Emit_Global_Line ("    uint64_t j;");
            Emit_Global_Line ("    uint64_t offset;");
            Emit_Global_Line ("    uint8_t* dst = (uint8_t*)dest_cells;");
            Emit_Global_Line ("    for (i = 0; i < elements; i++) {");
            Emit_Global_Line ("        for (j = 0; j < elem_bytes; j++) {");
            Emit_Global_Line ("            offset = (i * elem_bytes) + j;");
            Emit_Global_Line ("            if (offset >= used_bytes) { break; }");
            Emit_Global_Line ("            dst[offset] = src[offset];");
            Emit_Global_Line ("        }");
            Emit_Global_Line ("    }");
            Emit_Global_Line ("}");
            Emit_Global_Line ("static int ALB_NET_Init(void) {");
            Emit_Global_Line ("#if defined(ALB_PLAT_WIN)");
            Emit_Global_Line ("    WSADATA wsa_data;");
            Emit_Global_Line ("#endif");
            Emit_Global_Line ("    if (ALB_NET_Ready) return 1;");
            Emit_Global_Line ("#if defined(ALB_PLAT_WIN)");
            Emit_Global_Line ("    if (WSAStartup(MAKEWORD(2, 2), &wsa_data) != 0) return 0;");
            Emit_Global_Line ("#endif");
            Emit_Global_Line ("    ALB_NET_Ready = 1;");
            Emit_Global_Line ("    return 1;");
            Emit_Global_Line ("}");
            Emit_Global_Line ("static uint64_t ALB_NET_Listen_Config(uint64_t* handle, uint64_t protocol, uint64_t port) {");
            Emit_Global_Line ("    ALB_SOCKET_T sock;");
            Emit_Global_Line ("    struct sockaddr_in addr;");
            Emit_Global_Line ("    int optval;");
            Emit_Global_Line ("    if (!handle) return ALB_U64_ZERO;");
            Emit_Global_Line ("    if (!ALB_NET_Init()) return ALB_U64_ZERO;");
            Emit_Global_Line ("    if (*handle != ALB_U64_ZERO) return ALB_U64_ONE;");
            Emit_Global_Line ("    if (protocol == 2) sock = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP); else sock = socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);");
            Emit_Global_Line ("    if (sock == ALB_INVALID_SOCKET) return ALB_U64_ZERO;");
            Emit_Global_Line ("    optval = 1;");
            Emit_Global_Line ("#if defined(ALB_PLAT_WIN)");
            Emit_Global_Line ("    setsockopt(sock, SOL_SOCKET, SO_REUSEADDR, (const char*)&optval, (int)sizeof(optval));");
            Emit_Global_Line ("#else");
            Emit_Global_Line ("    setsockopt(sock, SOL_SOCKET, SO_REUSEADDR, &optval, (ALB_SOCKLEN_T)sizeof(optval));");
            Emit_Global_Line ("#endif");
            Emit_Global_Line ("    memset(&addr, 0, sizeof(addr));");
            Emit_Global_Line ("    addr.sin_family = AF_INET;");
            Emit_Global_Line ("    addr.sin_port = htons((unsigned short)port);");
            Emit_Global_Line ("    addr.sin_addr.s_addr = htonl(INADDR_ANY);");
            Emit_Global_Line ("    if (bind(sock, (struct sockaddr*)&addr, sizeof(addr)) != 0) { ALB_NET_CLOSE_RAW(sock); return ALB_U64_ZERO; }");
            Emit_Global_Line ("    if (protocol != 2 && listen(sock, 4) != 0) { ALB_NET_CLOSE_RAW(sock); return ALB_U64_ZERO; }");
            Emit_Global_Line ("    *handle = (uint64_t)sock;");
            Emit_Global_Line ("    return ALB_U64_ONE;");
            Emit_Global_Line ("}");
            Emit_Global_Line ("static uint64_t ALB_NET_Accept_Config(uint64_t listen_handle, uint64_t protocol, struct sockaddr_in* peer, int* peer_len, uint64_t* out_handle) {");
            Emit_Global_Line ("    ALB_SOCKET_T accepted;");
            Emit_Global_Line ("    struct sockaddr_in temp_peer;");
            Emit_Global_Line ("    ALB_SOCKLEN_T addr_len;");
            Emit_Global_Line ("    if (!out_handle) return ALB_U64_ZERO;");
            Emit_Global_Line ("    *out_handle = ALB_U64_ZERO;");
            Emit_Global_Line ("    if (!ALB_NET_Init()) return ALB_U64_ZERO;");
            Emit_Global_Line ("    if (protocol == 2) { *out_handle = listen_handle; return ALB_U64_ONE; }");
            Emit_Global_Line ("    if (listen_handle == ALB_U64_ZERO) return ALB_U64_ZERO;");
            Emit_Global_Line ("    addr_len = (ALB_SOCKLEN_T)(peer_len ? *peer_len : (int)sizeof(temp_peer));");
            Emit_Global_Line ("    accepted = accept((ALB_SOCKET_T)listen_handle, (struct sockaddr*)(peer ? peer : &temp_peer), &addr_len);");
            Emit_Global_Line ("    if (accepted == ALB_INVALID_SOCKET) return ALB_U64_ZERO;");
            Emit_Global_Line ("    if (peer_len) *peer_len = (int)addr_len;");
            Emit_Global_Line ("    *out_handle = (uint64_t)accepted;");
            Emit_Global_Line ("    return ALB_U64_ONE;");
            Emit_Global_Line ("}");
            Emit_Global_Line ("static uint64_t ALB_NET_Receive_Config(uint64_t handle, uint64_t protocol, void* dest_cells, uint64_t element_count, uint64_t element_bytes, uint8_t* scratch, uint64_t scratch_size, struct sockaddr_in* peer, int* peer_len) {");
            Emit_Global_Line ("    uint64_t byte_count;");
            Emit_Global_Line ("    int recv_len;");
            Emit_Global_Line ("    struct sockaddr_in temp_peer;");
            Emit_Global_Line ("    ALB_SOCKLEN_T addr_len;");
            Emit_Global_Line ("    if (!dest_cells || !scratch || handle == ALB_U64_ZERO) return ALB_U64_ZERO;");
            Emit_Global_Line ("    byte_count = element_count * element_bytes;");
            Emit_Global_Line ("    if (byte_count > scratch_size) byte_count = scratch_size;");
            Emit_Global_Line ("    if (byte_count == 0) return ALB_U64_ZERO;");
            Emit_Global_Line ("    if (protocol == 2) {");
            Emit_Global_Line ("        addr_len = (ALB_SOCKLEN_T)(peer_len ? *peer_len : (int)sizeof(temp_peer));");
            Emit_Global_Line ("        recv_len = recvfrom((ALB_SOCKET_T)handle, (char*)scratch, (int)byte_count, 0, (struct sockaddr*)(peer ? peer : &temp_peer), &addr_len);");
            Emit_Global_Line ("        if (peer_len) *peer_len = (int)addr_len;");
            Emit_Global_Line ("    } else {");
            Emit_Global_Line ("        recv_len = recv((ALB_SOCKET_T)handle, (char*)scratch, (int)byte_count, 0);");
            Emit_Global_Line ("    }");
            Emit_Global_Line ("    if (recv_len <= 0) return ALB_U64_ZERO;");
            Emit_Global_Line ("    ALB_NET_Unpack_Cells(dest_cells, scratch, element_count, element_bytes, (uint64_t)recv_len);");
            Emit_Global_Line ("    return (uint64_t)recv_len;");
            Emit_Global_Line ("}");
            Emit_Global_Line ("static uint64_t ALB_NET_Send_Config(uint64_t handle, uint64_t protocol, const void* src_cells, uint64_t element_count, uint64_t element_bytes, uint8_t* scratch, uint64_t scratch_size, struct sockaddr_in* peer, int peer_len) {");
            Emit_Global_Line ("    uint64_t byte_count;");
            Emit_Global_Line ("    int sent_len;");
            Emit_Global_Line ("    if (!src_cells || !scratch || handle == ALB_U64_ZERO) return ALB_U64_ZERO;");
            Emit_Global_Line ("    byte_count = element_count * element_bytes;");
            Emit_Global_Line ("    if (byte_count > scratch_size) byte_count = scratch_size;");
            Emit_Global_Line ("    if (byte_count == 0) return ALB_U64_ZERO;");
            Emit_Global_Line ("    ALB_NET_Pack_Cells(scratch, src_cells, element_count, element_bytes, byte_count);");
            Emit_Global_Line ("    if (protocol == 2) {");
            Emit_Global_Line ("        if (!peer) return ALB_U64_ZERO;");
            Emit_Global_Line ("        sent_len = sendto((ALB_SOCKET_T)handle, (const char*)scratch, (int)byte_count, 0, (const struct sockaddr*)peer, (ALB_SOCKLEN_T)peer_len);");
            Emit_Global_Line ("    } else {");
            Emit_Global_Line ("        sent_len = send((ALB_SOCKET_T)handle, (const char*)scratch, (int)byte_count, 0);");
            Emit_Global_Line ("    }");
            Emit_Global_Line ("    return (sent_len < 0) ? ALB_U64_ZERO : (uint64_t)sent_len;");
            Emit_Global_Line ("}");
            Emit_Global_Line ("static void ALB_NET_Close_Handle(uint64_t* handle) {");
            Emit_Global_Line ("    if (!handle || *handle == ALB_U64_ZERO) return;");
            Emit_Global_Line ("    ALB_NET_CLOSE_RAW((ALB_SOCKET_T)(*handle));");
            Emit_Global_Line ("    *handle = ALB_U64_ZERO;");
            Emit_Global_Line ("}");
            Emit_Global_Line ("");
         end if;

         if Markov_Runtime_Used then
            Emit_Global_Line ("static uint64_t ALB_Markov_Predict(const int64_t* matrix, uint64_t states, uint64_t current_state) {");
            Emit_Global_Line ("    uint64_t row;");
            Emit_Global_Line ("    uint64_t col;");
            Emit_Global_Line ("    uint64_t best_col;");
            Emit_Global_Line ("    int64_t best_weight;");
            Emit_Global_Line ("    if (!matrix || states == 0 || current_state == 0) return ALB_U64_ZERO;");
            Emit_Global_Line ("    row = current_state - 1;");
            Emit_Global_Line ("    if (row >= states) row = states - 1;");
            Emit_Global_Line ("    best_col = 1;");
            Emit_Global_Line ("    best_weight = matrix[row * states];");
            Emit_Global_Line ("    for (col = 1; col < states; col++) {");
            Emit_Global_Line ("        if (matrix[(row * states) + col] > best_weight) {");
            Emit_Global_Line ("            best_weight = matrix[(row * states) + col];");
            Emit_Global_Line ("            best_col = col + 1;");
            Emit_Global_Line ("        }");
            Emit_Global_Line ("    }");
            Emit_Global_Line ("    return best_col;");
            Emit_Global_Line ("}");
            Emit_Global_Line ("");
         end if;

         if Neural_Runtime_Used then
            Emit_Global_Line ("static int64_t ALB_NN_Apply_Activation(int64_t value, uint64_t act_code) {");
            Emit_Global_Line ("    switch ((unsigned)act_code) {");
            Emit_Global_Line ("        case 1: return (value > 0) ? value : 0;");
            Emit_Global_Line ("        case 2: return (value > 0) ? 1 : 0;");
            Emit_Global_Line ("        case 3: if (value > 128) return 1024; if (value < -128) return -1024; return value * 8;");
            Emit_Global_Line ("        default: return value;");
            Emit_Global_Line ("    }");
            Emit_Global_Line ("}");
            Emit_Global_Line ("static void ALB_NN_Infer(const uint64_t* meta, const uint64_t* input, uint64_t* output) {");
            Emit_Global_Line ("    uint64_t layer_count;");
            Emit_Global_Line ("    const uint64_t* sizes;");
            Emit_Global_Line ("    const uint64_t* act_codes;");
            Emit_Global_Line ("    const uint64_t* neuron_offs;");
            Emit_Global_Line ("    const uint64_t* weight_offs;");
            Emit_Global_Line ("    const uint64_t* bias_offs;");
            Emit_Global_Line ("    int64_t* weights;");
            Emit_Global_Line ("    int64_t* biases;");
            Emit_Global_Line ("    int64_t* state;");
            Emit_Global_Line ("    uint64_t layer;");
            Emit_Global_Line ("    uint64_t i;");
            Emit_Global_Line ("    uint64_t j;");
            Emit_Global_Line ("    uint64_t prev_size;");
            Emit_Global_Line ("    uint64_t curr_size;");
            Emit_Global_Line ("    uint64_t prev_off;");
            Emit_Global_Line ("    uint64_t curr_off;");
            Emit_Global_Line ("    uint64_t weight_base;");
            Emit_Global_Line ("    uint64_t bias_base;");
            Emit_Global_Line ("    int64_t acc;");
            Emit_Global_Line ("    if (!meta || !input || !output) return;");
            Emit_Global_Line ("    layer_count = meta[0];");
            Emit_Global_Line ("    sizes = (const uint64_t*)(uintptr_t)meta[4];");
            Emit_Global_Line ("    act_codes = (const uint64_t*)(uintptr_t)meta[5];");
            Emit_Global_Line ("    neuron_offs = (const uint64_t*)(uintptr_t)meta[6];");
            Emit_Global_Line ("    weight_offs = (const uint64_t*)(uintptr_t)meta[7];");
            Emit_Global_Line ("    bias_offs = (const uint64_t*)(uintptr_t)meta[8];");
            Emit_Global_Line ("    weights = (int64_t*)(uintptr_t)meta[9];");
            Emit_Global_Line ("    biases = (int64_t*)(uintptr_t)meta[10];");
            Emit_Global_Line ("    state = (int64_t*)(uintptr_t)meta[11];");
            Emit_Global_Line ("    for (i = 0; i < sizes[0]; i++) { state[i] = (int64_t)input[i]; }");
            Emit_Global_Line ("    for (layer = 1; layer < layer_count; layer++) {");
            Emit_Global_Line ("        prev_size = sizes[layer - 1];");
            Emit_Global_Line ("        curr_size = sizes[layer];");
            Emit_Global_Line ("        prev_off = neuron_offs[layer - 1];");
            Emit_Global_Line ("        curr_off = neuron_offs[layer];");
            Emit_Global_Line ("        weight_base = weight_offs[layer];");
            Emit_Global_Line ("        bias_base = bias_offs[layer];");
            Emit_Global_Line ("        for (i = 0; i < curr_size; i++) {");
            Emit_Global_Line ("            acc = biases[bias_base + i];");
            Emit_Global_Line ("            for (j = 0; j < prev_size; j++) {");
            Emit_Global_Line ("                acc = acc + (state[prev_off + j] * weights[weight_base + (i * prev_size) + j]);");
            Emit_Global_Line ("            }");
            Emit_Global_Line ("            state[curr_off + i] = ALB_NN_Apply_Activation(acc, act_codes[layer]);");
            Emit_Global_Line ("        }");
            Emit_Global_Line ("    }");
