               Out_Tag := Type_None;

            when AST_Set_Shoebox_Stmt =>
               if Target /= Backend_FASM and then Target /= Backend_C then
                  Fail_Node (Node, Err_Type_Conflict, "SETSHOEBOX", Success, Diag);
                  return;
               end if;
               Out_Tag := Type_None;

            when AST_Apply_Lut_Stmt =>
               declare
                  Lut_Node    : constant Node_Index := Tree (Node).Left_Child;
                  Visual_Node : constant Node_Index := Tree (Node).Right_Child;
                  With_Node   : constant Node_Index :=
                    (if Visual_Node > 0 and then Tree (Visual_Node).Next_Sibling > 0
                     and then Tree (Tree (Visual_Node).Next_Sibling).Kind = AST_With_Clause
                     then Tree (Visual_Node).Next_Sibling
                     else 0);
               begin
                  if Target = Backend_C then
                     Ensure_Static_Graphics_Runtime;

                     Transpiler_Native_HAL.Emit_Indent (Success);
                     Transpiler_Native_HAL.Emit_Raw
                       ("ALB_STATIC_Active_Lut = (uint64_t)(",
                        Success);
                     Walk_AST (Lut_Node, Depth + 1, Left_Tag, Success, Diag);
                     if not Success then
                        return;
                     end if;
                     Transpiler_Native_HAL.Emit_Raw (");", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);

                     Transpiler_Native_HAL.Emit_Indent (Success);
                     Transpiler_Native_HAL.Emit_Raw
                       ("ALB_STATIC_Active_Visual = (uint64_t)(",
                        Success);
                     Walk_AST (Visual_Node, Depth + 1, Right_Tag, Success, Diag);
                     if not Success then
                        return;
                     end if;
                     Transpiler_Native_HAL.Emit_Raw (");", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);

                     if With_Node > 0 then
                        Transpiler_Native_HAL.Emit_Indent (Success);
                        Transpiler_Native_HAL.Emit_Raw
                          ("ALB_STATIC_Active_Context = (uint64_t)(",
                           Success);
                        Walk_AST
                          (Tree (With_Node).Left_Child,
                           Depth + 1,
                           Right_Tag,
                           Success,
                           Diag);
                        if not Success then
                           return;
                        end if;
                        Transpiler_Native_HAL.Emit_Raw (");", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);

                        Transpiler_Native_HAL.Emit_Indent (Success);
                        Transpiler_Native_HAL.Emit_Raw
                          ("ALB_STATIC_Active_Context_Used = 1;",
                           Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                     else
                        Transpiler_Native_HAL.Emit_Indent (Success);
                        Transpiler_Native_HAL.Emit_Raw
                          ("ALB_STATIC_Active_Context = 0;",
                           Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);

                        Transpiler_Native_HAL.Emit_Indent (Success);
                        Transpiler_Native_HAL.Emit_Raw
                          ("ALB_STATIC_Active_Context_Used = 0;",
                           Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                     end if;
                  elsif Target /= Backend_FASM then
                     Fail_Node (Node, Err_Type_Conflict, "APPLYLUT", Success, Diag);
                     return;
                  else
                     Ensure_Static_Graphics_Runtime;

                     Walk_AST (Lut_Node, Depth + 1, Left_Tag, Success, Diag);
                     if not Success then
                        return;
                     end if;
                     Transpiler_Native_HAL.Emit_Raw
                       ("  mov qword [ALB_STATIC_Active_Lut], rax",
                        Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);

                     Walk_AST (Visual_Node, Depth + 1, Right_Tag, Success, Diag);
                     if not Success then
                        return;
                     end if;
                     Transpiler_Native_HAL.Emit_Raw
                       ("  mov qword [ALB_STATIC_Active_Visual], rax",
                        Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);

                     if With_Node > 0 then
                        Walk_AST (Tree (With_Node).Left_Child, Depth + 1, Right_Tag, Success, Diag);
                        if not Success then
                           return;
                        end if;
                        Transpiler_Native_HAL.Emit_Raw
                          ("  mov qword [ALB_STATIC_Active_Context], rax",
                           Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw
                          ("  mov qword [ALB_STATIC_Active_Context_Used], 1",
                           Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                     else
                        Transpiler_Native_HAL.Emit_Raw
                          ("  xor rax, rax",
                           Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw
                          ("  mov qword [ALB_STATIC_Active_Context], rax",
                           Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw
                          ("  mov qword [ALB_STATIC_Active_Context_Used], rax",
                           Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                     end if;
                  end if;

                  Out_Tag := Type_None;
               end;

            when AST_Blit_Safe_Stmt =>
               declare
                  Visual_Node    : constant Node_Index := Tree (Node).Left_Child;
                  Visual_With    : constant Node_Index :=
                    (if Visual_Node > 0 and then Tree (Visual_Node).Next_Sibling > 0
                     and then Tree (Tree (Visual_Node).Next_Sibling).Kind = AST_With_Clause
                     then Tree (Visual_Node).Next_Sibling
                     else 0);
                  Target_Node    : constant Node_Index := Tree (Node).Right_Child;
                  Position_Node  : constant Node_Index :=
                    (if Target_Node > 0 then Tree (Target_Node).Next_Sibling else 0);
                  Clause_Node    : Node_Index := (if Position_Node > 0 then Tree (Position_Node).Next_Sibling else 0);
                  Viewport_Node  : Node_Index := 0;
                  Mode_Node      : Node_Index := 0;
                  Visual_Name    : constant String := Simple_Feature_Name (Visual_Node);
                  Rule_Idx       : constant Natural :=
                    (if Visual_Name'Length > 0 then Find_Visual_Rule (Visual_Name) else 0);
                  Img            : constant String := Node_Index'Image (Node);
                  NID            : constant String := Img (Img'First + 1 .. Img'Last);
                  Alpha_Mask     : Boolean := False;
               begin
                  if Target = Backend_C then
                     if Visual_Node = 0 or else Target_Node = 0 or else Position_Node = 0 then
                        Fail_Node (Node, Err_Compiler_AST_Mismatch, "BLITSAFE", Success, Diag);
                        return;
                     end if;

                     while Clause_Node /= 0 loop
                        case Tree (Clause_Node).Kind is
                           when AST_Constrain_To_Clause =>
                              Viewport_Node := Clause_Node;
                           when AST_Mode_Clause =>
                              Mode_Node := Clause_Node;
                           when others =>
                              null;
                        end case;
                        Clause_Node := Tree (Clause_Node).Next_Sibling;
                     end loop;

                     if Mode_Node > 0 then
                        declare
                           Mode_Text : constant String := To_Upper (Raw_Feature_Atom (Tree (Mode_Node).Left_Child));
                        begin
                           if Mode_Text /= "ALPHAMASK" then
                              Fail_Node (Mode_Node, Err_Type_Conflict, Mode_Text, Success, Diag);
                              return;
                           end if;
                           Alpha_Mask := True;
                        end;
                     end if;

                     Mark_Native_Graphics_Use (Node);
                     Ensure_Static_Graphics_Runtime;

                     Transpiler_Native_HAL.Emit_Indent (Success);
                     Transpiler_Native_HAL.Emit_Raw ("{", Success);
