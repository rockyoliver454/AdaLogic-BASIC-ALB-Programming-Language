      end Remove_File_If_Exists;

      function Escape_PowerShell_Single_Quoted
        (Text : String) return String
      is
         Extra : Natural := 0;
      begin
         for I in Text'Range loop
            if Text (I) = ''' then
               Extra := Extra + 1;
            end if;
         end loop;

         declare
            Result : String (1 .. Text'Length + Extra);
            Pos    : Natural := 0;
         begin
            for I in Text'Range loop
               Pos := Pos + 1;
               Result (Pos) := Text (I);
               if Text (I) = ''' then
                  Pos := Pos + 1;
                  Result (Pos) := ''';
               end if;
            end loop;
            return Result;
         end;
      end Escape_PowerShell_Single_Quoted;

      procedure Allocate_Temporary_Bmp_Path
        (Nearby_Path : String;
         Path_Buffer : out String;
         Path_Len    : out Natural;
         Success     : out Boolean)
      is
         Dir        : constant String := Parent_Directory (Nearby_Path);
         Stem       : constant String := Path_Leaf_Stem (Nearby_Path);
         Count_Text : constant String := Nat_Img (Temporary_Asset_Count + 1);
         Candidate  : constant String :=
           Compose_Path_Lenient
             (Dir,
              "__alb_png_" & Count_Text & "_" & Stem & ".bmp");
      begin
         Path_Buffer := (others => ' ');
         Path_Len := 0;
         if Candidate'Length = 0 or else Candidate'Length > Path_Buffer'Length then
            Success := False;
            return;
         end if;

         Temporary_Asset_Count := Temporary_Asset_Count + 1;
         Path_Len := Candidate'Length;
         Path_Buffer
           (Path_Buffer'First .. Path_Buffer'First + Path_Len - 1) := Candidate;
         Success := True;
      end Allocate_Temporary_Bmp_Path;

      procedure Prepare_Image_Asset_For_Baking
        (Source_Path      : String;
         Origin_Node      : Node_Index;
         Prepared_Path    : out String;
         Prepared_Len     : out Natural;
         Needs_Cleanup    : out Boolean;
         Success          : in out Boolean;
         Diag             : in out Compiler_Diagnostic)
      is
         Ext : constant String := File_Extension_Upper (Source_Path);
      begin
         Prepared_Path := (others => ' ');
         Prepared_Len := 0;
         Needs_Cleanup := False;

         if not Success then
            return;
         end if;

         if Ext = "BMP" then
            if Source_Path'Length = 0 or else Source_Path'Length > Prepared_Path'Length then
               Fail_Node (Origin_Node, Err_Mem_Out_Of_Bounds, Source_Path, Success, Diag);
               return;
            end if;
            Prepared_Len := Source_Path'Length;
            Prepared_Path
              (Prepared_Path'First .. Prepared_Path'First + Prepared_Len - 1) :=
                Source_Path;
            return;
         elsif Ext /= "PNG" then
            Fail_Node (Origin_Node, Err_Type_Conflict, Source_Path, Success, Diag);
            return;
         end if;

         declare
            Temp_Path : String (1 .. Max_Path_Len) := (others => ' ');
            Temp_Len  : Natural := 0;
            Made_Path : Boolean := False;
         begin
            Allocate_Temporary_Bmp_Path (Source_Path, Temp_Path, Temp_Len, Made_Path);
            if not Made_Path or else Temp_Len = 0 then
               Fail_Node (Origin_Node, Err_Mem_Out_Of_Bounds, Source_Path, Success, Diag);
               return;
            end if;

            declare
               Dest_Path : constant String := Temp_Path (1 .. Temp_Len);
               Esc_Source : constant String :=
                 Escape_PowerShell_Single_Quoted (Source_Path);
               Esc_Dest   : constant String :=
                 Escape_PowerShell_Single_Quoted (Dest_Path);
               Command_Text : constant String :=
                 "Add-Type -AssemblyName System.Drawing; " &
                 "$src='" & Esc_Source & "'; " &
                 "$dst='" & Esc_Dest & "'; " &
                 "$img=[System.Drawing.Bitmap]::FromFile($src); " &
                 "try { $img.Save($dst,[System.Drawing.Imaging.ImageFormat]::Bmp) } finally { $img.Dispose() }";
               Working_Dir : constant String :=
                 (if Parent_Directory (Source_Path)'Length > 0
                  then Parent_Directory (Source_Path)
                  else Ada.Directories.Current_Directory);
               Args : GNAT.OS_Lib.Argument_List (1 .. 4) :=
                 (1 => new String'("-NoProfile"),
                  2 => new String'("-NonInteractive"),
                  3 => new String'("-Command"),
                  4 => new String'(Command_Text));
               OK : Boolean := False;
            begin
               Remove_File_If_Exists (Dest_Path);
               OK := Spawn_And_Check (Working_Dir, "powershell.exe", Args);
               if not OK then
                  OK := Spawn_And_Check (Working_Dir, "pwsh.exe", Args);
               end if;
               Free_Argument_List (Args);

               if not OK or else not Path_Exists (Dest_Path) then
                  Fail_Node (Origin_Node, Err_Runtime_IO_Failure, Source_Path, Success, Diag);
                  Remove_File_If_Exists (Dest_Path);
                  return;
               end if;

               Prepared_Len := Temp_Len;
               Prepared_Path
                 (Prepared_Path'First .. Prepared_Path'First + Prepared_Len - 1) :=
                   Dest_Path;
               Needs_Cleanup := True;
            end;
         end;
      end Prepare_Image_Asset_For_Baking;

      procedure Cleanup_Prepared_Image_Asset
