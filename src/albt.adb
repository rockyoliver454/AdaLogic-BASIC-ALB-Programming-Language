                  else
                     Transpiler_Native_HAL.Emit_Raw ("  xor ax, ax", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Emit_Raw ("  xor dx, dx", Success);
