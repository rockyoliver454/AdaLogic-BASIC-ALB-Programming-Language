                              else
                                 Transpiler_Native_HAL.Emit_Raw ("  call ALB_String_From_U64", Success);
                              end if;
                               Transpiler_Native_HAL.Emit_Newline (Success);
                               Transpiler_Native_HAL.Emit_Raw ("  mov rdx, rax", Success);
                            end if;
                            Transpiler_Native_HAL.Emit_Newline (Success);
                            Transpiler_Native_HAL.Emit_Raw ("  pop rcx", Success); Transpiler_Native_HAL.Emit_Newline (Success);
                            Transpiler_Native_HAL.Emit_Raw ("  call ALB_String_Concat", Success);
                         end if;
                        end if;
                        Transpiler_Native_HAL.Emit_Newline (Success);
                     else
                        if Mapped_Op = OP_NOP
                          and then Tok.Kind in Tok_Pipe | Tok_Ampersand
                        then
                           Transpiler_Native_HAL.Emit_Raw ("(ALB_Text_Pipe_Left = (", Success);
                           Emit_Text_Pipe_Segment (Tree (Node).Left_Child);
                           if not Success then
                              return;
                           end if;
                           Transpiler_Native_HAL.Emit_Raw (")", Success);
                           Transpiler_Native_HAL.Emit_Raw (", ALB_Text_Pipe_Right = (", Success);
                           Emit_Text_Pipe_Segment (Tree (Node).Right_Child);
                           if not Success then
                              return;
                           end if;
                           Transpiler_Native_HAL.Emit_Raw
                             ("), ALB_Text_Pipe_Left = ALB_String_Concat(ALB_Text_Pipe_Left, ALB_Text_Pipe_Right), ALB_Text_Pipe_Left)",
                              Success);
                           if not Success then
                              return;
                           end if;
                        else
                        if Left_Expr_Tag = Type_F64 or else Right_Expr_Tag = Type_F64 then
                           if Mapped_Op = OP_ADD or else Mapped_Op = OP_SUB
                             or else Mapped_Op = OP_MUL or else Mapped_Op = OP_DIV
                           then
                              Transpiler_Native_HAL.Emit_Raw ("ALB_Double_As_U64(ALB_U64_As_Double(", Success);
                              Walk_AST (Tree (Node).Left_Child, Depth + 1, Left_Tag, Success, Diag);
                              Transpiler_Native_HAL.Emit_Raw (")", Success);
                              Transpiler_Native_HAL.Emit_BinOp (Mapped_Op, Success);
                              Transpiler_Native_HAL.Emit_Raw ("ALB_U64_As_Double(", Success);
                              Walk_AST (Tree (Node).Right_Child, Depth + 1, Right_Tag, Success, Diag);
                              Transpiler_Native_HAL.Emit_Raw ("))", Success);
                           elsif Mapped_Op = OP_CMP_EQ or else Mapped_Op = OP_CMP_NEQ
                             or else Mapped_Op = OP_CMP_LT or else Mapped_Op = OP_CMP_GT
                             or else Mapped_Op = OP_CMP_LTE or else Mapped_Op = OP_CMP_GTE
                           then
                              Transpiler_Native_HAL.Emit_Raw ("((uint64_t)(ALB_U64_As_Double(", Success);
                              Walk_AST (Tree (Node).Left_Child, Depth + 1, Left_Tag, Success, Diag);
                              Transpiler_Native_HAL.Emit_Raw (")", Success);
                              Transpiler_Native_HAL.Emit_BinOp (Mapped_Op, Success);
                              Transpiler_Native_HAL.Emit_Raw ("ALB_U64_As_Double(", Success);
                              Walk_AST (Tree (Node).Right_Child, Depth + 1, Right_Tag, Success, Diag);
                              Transpiler_Native_HAL.Emit_Raw (")))", Success);
                           else
                              Fail_Node
                                (Node,
                                 Err_Type_Conflict,
                                 "REAL expressions support +, -, *, /, and comparisons only",
                                 Success,
                                 Diag);
