                     Transpiler_Native_HAL.Emit_Raw ("  sub rsp, 64", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Emit_Raw ("  mov qword [rsp + 32], r10", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Emit_Raw ("  mov qword [rsp + 40], r11", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Emit_Raw
                       ("  mov qword [rsp + 48], " & Nat_Img (Buffer_Bytes), Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Emit_Raw ("  call ALB_PROC_Write_Buffer", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Emit_Raw ("  add rsp, 64", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                  else
                     Scalar_Tag := Infer_Type_Tag (Value_Node);
                     if Scalar_Tag = Type_None and then Value_Found then
                        Scalar_Tag := Value_Sym.Tag;
                     end if;

                     if Scalar_Tag not in Type_U8 | Type_U16 | Type_U32 | Type_U64 | Type_S32 | Type_S64 | Type_Boolean then
                        Fail_Node (Node, Err_Type_Conflict, "WRITE_PROCESS_MEMORY", Success, Diag);
                        return;
                     end if;

                     Walk_AST (Value_Node, Depth + 1, Right_Tag, Success, Diag);
                     if not Success then
                        return;
                     end if;
                     Transpiler_Native_HAL.Emit_Raw ("  mov r11, rax", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);

                     Walk_AST (Addr_Node, Depth + 1, Right_Tag, Success, Diag);
                     if not Success then
                        return;
                     end if;
                     Transpiler_Native_HAL.Emit_Raw ("  mov r10, rax", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);

                     Emit_FASM_Process_Config_Load
                       (Handle_Node,
                        Proc_Right_Write or Proc_Right_Query,
                        Node,
                        Success,
                        Diag);
                     if not Success then
                        return;
                     end if;

                     Transpiler_Native_HAL.Emit_Raw ("  sub rsp, 64", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Emit_Raw ("  mov qword [rsp + 32], r10", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Emit_Raw ("  mov qword [rsp + 40], r11", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Emit_Raw
                       ("  mov qword [rsp + 48], " &
                        Nat_Img (Process_Scalar_Code (Scalar_Tag)),
                        Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Emit_Raw ("  call ALB_PROC_Write_Scalar", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Emit_Raw ("  add rsp, 64", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                  end if;

                  Out_Tag := Type_None;
               end;

            when AST_Monitor_Process_Memory_Stmt =>
               declare
                  Handle_Node   : constant Node_Index := Tree (Node).Left_Child;
                  Addr_Node     : constant Node_Index := Tree (Node).Right_Child;
                  Type_Node     : constant Node_Index :=
                    (if Addr_Node > 0 then Tree (Addr_Node).Next_Sibling else 0);
                  Target_Node   : constant Node_Index :=
                    (if Type_Node > 0 then Tree (Type_Node).Next_Sibling else 0);
                  Changed_Node  : constant Node_Index :=
                    (if Target_Node > 0 then Tree (Target_Node).Next_Sibling else 0);
                  Handle_Name   : constant String := Process_Handle_Name (Handle_Node);
                  Target_Name   : constant String := Simple_Var_Name (Target_Node);
                  Changed_Name  : constant String := Simple_Var_Name (Changed_Node);
                  Scalar_Tag    : constant ALB_Type_Tag := Process_Scalar_Tag_From_Node (Type_Node);
                  Target_Found  : Boolean := False;
                  Changed_Found : Boolean := False;
                  Target_Sym    : Symbol_Record;
                  Changed_Sym   : Symbol_Record;
               begin
                  if Target /= Backend_FASM and then Target /= Backend_C then
                     Fail_Node (Node, Err_Type_Conflict, "MONITOR_PROCESS_MEMORY", Success, Diag);
                     return;
                  end if;

                  if Target = Backend_C then
                     -- Track 7 (C): read scalar, set Changed flag if differs, update Target.
                     Ensure_Process_Runtime_C;
                     if Handle_Name'Length = 0
                       or else Addr_Node = 0
                       or else Scalar_Tag = Type_None
                       or else Target_Name'Length = 0
                       or else Changed_Name'Length = 0
                     then
                        Fail_Node (Node, Err_Type_Conflict, "MONITOR_PROCESS_MEMORY", Success, Diag);
                        return;
                     end if;

                     Ensure_Firewall_Access (Target_Node, False, True, Node, Success, Diag);
                     Ensure_Firewall_Access (Changed_Node, False, True, Node, Success, Diag);
                     if not Success then
                        return;
                     end if;

                     Transpiler_Native_HAL.Emit_Indent (Success);
                     Transpiler_Native_HAL.Emit_Raw
                       ("ALB_PROC_Ensure(&" & Handle_Name & ", ALB_PROCCFG_" &
                        Handle_Name & "_PID, ALB_PROCCFG_" & Handle_Name &
                        "_IMAGE_C, ALB_PROCCFG_" & Handle_Name & "_Rights);",
                        Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);

                     Transpiler_Native_HAL.Emit_Indent (Success);
                     Transpiler_Native_HAL.Emit_Raw
                       ("{ uint64_t _alb_mon = ALB_PROC_Read_Scalar(" &
                        Handle_Name & ", (uint64_t)(",
                        Success);
                     Walk_AST (Addr_Node, Depth + 1, Right_Tag, Success, Diag);
                     if not Success then return; end if;
                     Transpiler_Native_HAL.Emit_Raw
                       ("), 8); " & Changed_Name & " = (_alb_mon != " &
                        Target_Name & ") ? 1 : 0; " &
                        Target_Name & " = _alb_mon; }",
                        Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);

                     Out_Tag := Type_None;
                     return;
                  end if;

                  if Handle_Name'Length = 0
                    or else Addr_Node = 0
