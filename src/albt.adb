      function Path_Exists (Path : String) return Boolean is
      begin
         return Path'Length > 0 and then Ada.Directories.Exists (Path);
      exception
         when others =>
            return False;
      end Path_Exists;

      function Compose_Path_Lenient
        (Dir  : String;
         Leaf : String) return String
      is
      begin
         if Dir'Length = 0 then
            return Leaf;
         elsif Leaf'Length = 0 then
            return Dir;
         elsif Is_Absolute_Path (Leaf) then
            return Leaf;
         end if;

         for I in Leaf'Range loop
            if Leaf (I) = '\' or else Leaf (I) = '/' then
               if Dir (Dir'Last) = '\' or else Dir (Dir'Last) = '/' then
                  return Dir & Leaf;
               else
                  return Dir & "\" & Leaf;
               end if;
            end if;
         end loop;

         return Ada.Directories.Compose (Dir, Leaf);
      end Compose_Path_Lenient;

      function Resolve_Static_Asset_Path
        (Raw_Path    : String;
         Origin_Node : Node_Index) return String
      is
         Source_File : constant String := Source_File_For_Node (Origin_Node);
         Source_Dir  : constant String := Parent_Directory (Source_File);
         Source_Path : constant String :=
           (if Is_Absolute_Path (Raw_Path) or else Source_Dir'Length = 0
            then Raw_Path
            else Compose_Path_Lenient (Source_Dir, Raw_Path));
         Shoebox_Path_Text : constant String :=
           (if Shoebox_Path_Len > 0 then Shoebox_Path (1 .. Shoebox_Path_Len) else "");
         Use_Shoebox : constant Boolean :=
           Embed_Assets_Mode
           or else (Shoebox_Active and then Shoebox_Path_Text'Length > 0);
         Shoebox_File : constant String :=
           (if Is_Absolute_Path (Raw_Path)
            then Raw_Path
            elsif Use_Shoebox and then Shoebox_Path_Text'Length > 0
            then Compose_Path_Lenient (Shoebox_Path_Text, Raw_Path)
            else Raw_Path);
      begin
         -- --embed-assets: prefer shoebox / asset root over sidecar paths
         if Embed_Assets_Mode and then Shoebox_Path_Text'Length > 0 then
            if Path_Exists (Shoebox_File) then
               return Shoebox_File;
            elsif Path_Exists (Source_Path) then
               return Source_Path;
            else
               return Shoebox_File;
            end if;
         end if;

         if Path_Exists (Source_Path) then
            return Source_Path;
         elsif Path_Exists (Shoebox_File) then
            return Shoebox_File;
         elsif Use_Shoebox and then Shoebox_Path_Text'Length > 0 then
            return Shoebox_File;
         else
            return Source_Path;
         end if;
      end Resolve_Static_Asset_Path;

      function File_Extension_Upper (Path : String) return String is
         Dot_Pos : Integer := 0;
      begin
         if Path'Length = 0 then
            return "";
         end if;

         for I in reverse Path'Range loop
            if Path (I) = '.' then
               Dot_Pos := I;
               exit;
            elsif Path (I) = '\' or else Path (I) = '/' then
               exit;
            end if;
         end loop;

         if Dot_Pos = 0 or else Dot_Pos >= Path'Last then
            return "";
         end if;

         return To_Upper (Path (Dot_Pos + 1 .. Path'Last));
      end File_Extension_Upper;

      function Path_Leaf_Stem (Path : String) return String is
         First_Pos : Integer := Path'First;
         Dot_Pos   : Integer := 0;
      begin
         if Path'Length = 0 then
            return "asset";
         end if;

         for I in reverse Path'Range loop
            if Path (I) = '\' or else Path (I) = '/' then
               First_Pos := I + 1;
               exit;
            end if;
         end loop;

         if First_Pos > Path'Last then
            return "asset";
         end if;

         for I in reverse First_Pos .. Path'Last loop
            if Path (I) = '.' then
               Dot_Pos := I;
               exit;
            end if;
         end loop;

         if Dot_Pos = 0 or else Dot_Pos <= First_Pos then
            return Path (First_Pos .. Path'Last);
         end if;

         return Path (First_Pos .. Dot_Pos - 1);
      end Path_Leaf_Stem;

      procedure Remove_File_If_Exists (Path : String) is
