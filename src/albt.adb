                            Transpiler_Native_HAL.Emit_Raw ("  setge al", Success); Transpiler_Native_HAL.Emit_Newline (Success);
                            Transpiler_Native_HAL.Emit_Raw ("  movzx rax, al", Success);

                         -- DA TEXT PIPE CONCATENATION: "text" | number
                         -- (Task B2: Tok_Ampersand is treated identically to Tok_Pipe.)
                         elsif Mapped_Op = OP_NOP
                           and then Tok.Kind in Tok_Pipe | Tok_Ampersand
