            when AST_If_Stmt =>
               declare
                  Cond_Node : Node_Index := Tree (Node).Left_Child;
                  Body_Node : Node_Index := Tree (Node).Right_Child;
                  Else_Node : Node_Index := 0;
                  Cond_Tag  : ALB_Type_Tag;
                  Img       : constant String := Node_Index'Image (Node);
                  NID       : constant String := Img (Img'First + 1 .. Img'Last);
               begin
                  if Body_Node > 0 then
                     Else_Node := Tree (Body_Node).Next_Sibling;
                  end if;

                  if Target = Backend_FASM then
                     Walk_AST (Cond_Node, Depth + 1, Cond_Tag, Success, Diag);
                     
                     Emit_FASM_Test_RAX_For_Truth (Cond_Tag, Success);
                     if Else_Node /= 0 then
                        Transpiler_Native_HAL.Emit_Raw ("  jz .ELSE_" & NID, Success);
                     else
                        Transpiler_Native_HAL.Emit_Raw ("  jz .ENDIF_" & NID, Success);
                     end if;

                     Transpiler_Native_HAL.Emit_Newline (Success);
                     
                     Transpiler_Native_HAL.Increase_Indent;
                     Walk_AST (Body_Node, Depth + 1, Right_Tag, Success, Diag);
                     
                     if Else_Node /= 0 then
                        Transpiler_Native_HAL.Emit_Raw ("  jmp .ENDIF_" & NID, Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Decrease_Indent;
                        Transpiler_Native_HAL.Emit_Raw (".ELSE_" & NID & ":", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Increase_Indent;
                        Walk_AST (Else_Node, Depth + 1, Right_Tag, Success, Diag);
                     end if;
                     
                     Transpiler_Native_HAL.Decrease_Indent;
                     Transpiler_Native_HAL.Emit_Raw (".ENDIF_" & NID & ":", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                  elsif Target = Backend_FASM16 then
                     -- FASM16 condition convention:
                     -- expression result is in AX, or DX:AX for 32-bit scalars.
                     Walk_AST (Cond_Node, Depth + 1, Cond_Tag, Success, Diag);

                     if Cond_Tag = Type_Pure then
                         Transpiler_Native_HAL.Emit_Raw ("  test dx, dx", Success);
                         Transpiler_Native_HAL.Emit_Newline (Success);
                      elsif Cond_Tag = Type_U32
                        or else Cond_Tag = Type_S32
                        or else Cond_Tag = Type_HW32
                      then
                         Transpiler_Native_HAL.Emit_Raw ("  mov bx, ax", Success);
                         Transpiler_Native_HAL.Emit_Newline (Success);
                         Transpiler_Native_HAL.Emit_Raw ("  or bx, dx", Success);
                         Transpiler_Native_HAL.Emit_Newline (Success);
                      else
                         Transpiler_Native_HAL.Emit_Raw ("  test ax, ax", Success);
                         Transpiler_Native_HAL.Emit_Newline (Success);
                     end if;
                     
                     if Else_Node /= 0 then
                         Transpiler_Native_HAL.Emit_Raw ("  jz .ALB16_ELSE_" & NID, Success);
                      else
                         Transpiler_Native_HAL.Emit_Raw ("  jz .ALB16_ENDIF_" & NID, Success);
                      end if;

                     Transpiler_Native_HAL.Emit_Newline (Success);

                     Transpiler_Native_HAL.Emit_Newline (Success);

                     Walk_AST (Body_Node, Depth + 1, Right_Tag, Success, Diag);

                     if Else_Node /= 0 then
                        Transpiler_Native_HAL.Emit_Raw ("  jmp .ALB16_ENDIF_" & NID, Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);

                        Transpiler_Native_HAL.Emit_Raw (".ALB16_ELSE_" & NID & ":", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);

                        Walk_AST (Else_Node, Depth + 1, Right_Tag, Success, Diag);
                     end if;

                     Transpiler_Native_HAL.Emit_Raw (".ALB16_ENDIF_" & NID & ":", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                  else
                     Transpiler_Native_HAL.Emit_If_Start (Success);
                     Walk_AST (Cond_Node, Depth + 1, Cond_Tag, Success, Diag);
                     Transpiler_Native_HAL.Emit_Then (Success);
                     Walk_AST (Body_Node, Depth + 1, Right_Tag, Success, Diag);
                     if Else_Node > 0 then
                        Transpiler_Native_HAL.Emit_Else (Success);
                        Walk_AST (Else_Node, Depth + 1, Right_Tag, Success, Diag);
                     end if;
                     Transpiler_Native_HAL.Emit_If_End (Success);
                  end if;
               end;
   
            when AST_While_Stmt =>
               declare
                  Cond_Node : Node_Index := Tree(Node).Left_Child;
                  Body_Node : Node_Index := Tree(Node).Right_Child;
                  Img       : constant String := Node_Index'Image (Node);
                  NID       : constant String := Img (Img'First + 1 .. Img'Last);
                  Cond_Tag  : ALB_Type_Tag := Type_None;
               begin
                  if Target = Backend_FASM then
                     Push_FASM_Loop_Labels
                       (".WHILE_END_" & NID,
                        ".WHILE_START_" & NID,
                        Node,
                        Success,
                        Diag);
                     if not Success then
                        return;
                     end if;

                     Transpiler_Native_HAL.Emit_Raw (".WHILE_START_" & NID & ":", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Increase_Indent;

                     Walk_AST (Cond_Node, Depth + 1, Cond_Tag, Success, Diag);

                     Emit_FASM_Test_RAX_For_Truth (Cond_Tag, Success);
                     Transpiler_Native_HAL.Emit_Raw ("  jz .WHILE_END_" & NID, Success);
                     
                     Transpiler_Native_HAL.Emit_Newline (Success);

                     Walk_AST (Body_Node, Depth + 1, Right_Tag, Success, Diag);

                     Transpiler_Native_HAL.Emit_Raw ("  jmp .WHILE_START_" & NID, Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Decrease_Indent;
                     Transpiler_Native_HAL.Emit_Raw (".WHILE_END_" & NID & ":", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);

                     Pop_FASM_Loop_Labels;
                  elsif Target = Backend_FASM16 then
                     Push_FASM_Loop_Labels
                       (".ALB16_WHILE_END_" & NID,
                        ".ALB16_WHILE_START_" & NID,
                        Node,
                        Success,
                        Diag);

                     if not Success then
                        return;
                     end if;

                     Transpiler_Native_HAL.Emit_Raw (".ALB16_WHILE_START_" & NID & ":", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);

                     -- Evaluate condition into AX, or DX:AX for 32-bit FASM16 scalars.
                     Walk_AST (Cond_Node, Depth + 1, Cond_Tag, Success, Diag);

                     if Cond_Tag = Type_Pure then
                         Transpiler_Native_HAL.Emit_Raw ("  test dx, dx", Success);
                         Transpiler_Native_HAL.Emit_Newline (Success);
                      elsif Cond_Tag = Type_U32
                        or else Cond_Tag = Type_S32
                        or else Cond_Tag = Type_HW32
                      then
                         Transpiler_Native_HAL.Emit_Raw ("  mov bx, ax", Success);
                         Transpiler_Native_HAL.Emit_Newline (Success);
                         Transpiler_Native_HAL.Emit_Raw ("  or bx, dx", Success);
                         Transpiler_Native_HAL.Emit_Newline (Success);
                      else
                         Transpiler_Native_HAL.Emit_Raw ("  test ax, ax", Success);
                         Transpiler_Native_HAL.Emit_Newline (Success);
                      end if;

                     Transpiler_Native_HAL.Emit_Raw ("  jz .ALB16_WHILE_END_" & NID, Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     

                     Walk_AST (Body_Node, Depth + 1, Right_Tag, Success, Diag);

                     Transpiler_Native_HAL.Emit_Raw ("  jmp .ALB16_WHILE_START_" & NID, Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);

                     Transpiler_Native_HAL.Emit_Raw (".ALB16_WHILE_END_" & NID & ":", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);

                     Pop_FASM_Loop_Labels;

                  else
                     Transpiler_Native_HAL.Emit_While_Start (Success);
                     Walk_AST (Cond_Node, Depth + 1, Right_Tag, Success, Diag);
                     Transpiler_Native_HAL.Emit_While_Loop_Start (Success);
                     Walk_AST (Body_Node, Depth + 1, Right_Tag, Success, Diag);
                     Transpiler_Native_HAL.Emit_Loop_End (Success);
                  end if;

                  Out_Tag := Type_None;
               end;
               
            when AST_Repeat_Stmt =>
               declare
                  Body_Node : Node_Index := Tree (Node).Left_Child;
                  Cond_Node : Node_Index := Tree (Node).Right_Child;
                  Img       : constant String := Node_Index'Image (Node);
                  NID       : constant String := Img (Img'First + 1 .. Img'Last);
                  Cond_Tag  : ALB_Type_Tag  := Type_None;
               begin
                  if Target = Backend_FASM then
                     Push_FASM_Loop_Labels
                       (".REPEAT_END_" & NID,
                        ".REPEAT_CONT_" & NID,
                        Node,
                        Success,
                        Diag);
                     if not Success then
                        return;
                     end if;

                     Transpiler_Native_HAL.Emit_Raw (".REPEAT_START_" & NID & ":", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Increase_Indent;

                     Walk_AST (Body_Node, Depth + 1, Left_Tag, Success, Diag);

                     Transpiler_Native_HAL.Emit_Raw (".REPEAT_CONT_" & NID & ":", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);

                     Walk_AST (Cond_Node, Depth + 1, Cond_Tag, Success, Diag);

                     Emit_FASM_Test_RAX_For_Truth (Cond_Tag, Success);

                     Transpiler_Native_HAL.Decrease_Indent;
                     Transpiler_Native_HAL.Emit_Raw ("  jz .REPEAT_START_" & NID, Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Emit_Raw (".REPEAT_END_" & NID & ":", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);

                     Pop_FASM_Loop_Labels;

                  elsif Target = Backend_FASM16 then
                     Push_FASM_Loop_Labels
                       (".ALB16_REPEAT_END_" & NID,
                        ".ALB16_REPEAT_CONT_" & NID,
                        Node,
                        Success,
                        Diag);
                     if not Success then
                        return;
                     end if;

                     Transpiler_Native_HAL.Emit_Raw (".ALB16_REPEAT_START_" & NID & ":", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);

                     -- REPEAT always executes the body at least once.
                     Walk_AST (Body_Node, Depth + 1, Left_Tag, Success, Diag);

                     -- CONTINUE inside REPEAT should jump here, then evaluate UNTIL.
                     Transpiler_Native_HAL.Emit_Raw (".ALB16_REPEAT_CONT_" & NID & ":", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);

                     -- Condition leaves truth value in AX, or DX:AX for 32-bit FASM16 scalars.
                     Walk_AST (Cond_Node, Depth + 1, Cond_Tag, Success, Diag);

                     if Cond_Tag = Type_Pure then
                         Transpiler_Native_HAL.Emit_Raw ("  test dx, dx", Success);
                         Transpiler_Native_HAL.Emit_Newline (Success);
                      elsif Cond_Tag = Type_U32
                        or else Cond_Tag = Type_S32
                        or else Cond_Tag = Type_HW32
                      then
                         Transpiler_Native_HAL.Emit_Raw ("  mov bx, ax", Success);
                         Transpiler_Native_HAL.Emit_Newline (Success);
                         Transpiler_Native_HAL.Emit_Raw ("  or bx, dx", Success);
                         Transpiler_Native_HAL.Emit_Newline (Success);
                      else
                         Transpiler_Native_HAL.Emit_Raw ("  test ax, ax", Success);
                         Transpiler_Native_HAL.Emit_Newline (Success);
                      end if;

                     Transpiler_Native_HAL.Emit_Raw ("  jz .ALB16_REPEAT_START_" & NID, Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);

                     Pop_FASM_Loop_Labels;

                  else
                     Transpiler_Native_HAL.Emit_Plain_Loop_Start (Success);
                     Walk_AST (Body_Node, Depth + 1, Left_Tag, Success, Diag);

                     Transpiler_Native_HAL.Emit_Exit_When (Success);
                     Walk_AST (Cond_Node, Depth + 1, Right_Tag, Success, Diag);
                     Transpiler_Native_HAL.Emit_Raw (") break;", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Emit_Loop_End (Success);
                  end if;

                  Out_Tag := Type_None;
               end;
               
            when AST_For_Stmt =>
               declare
                  Tok        : Token := Tokens (Tree (Node).Token_Index);
                  Lexeme     : String := Input_Buffer (Tok.Start .. Tok.Start + Tok.Length - 1);
                  Dummy_Node : Node_Index := Tree (Node).Left_Child;
                  Start_Node : Node_Index := Tree (Dummy_Node).Left_Child;
                  End_Node   : Node_Index := Tree (Dummy_Node).Right_Child;
                  Body_Node  : Node_Index := Tree (Node).Right_Child;
                  Img        : constant String := Node_Index'Image (Node);
                  NID        : constant String := Img (Img'First + 1 .. Img'Last);
                  Dummy_Tag  : ALB_Type_Tag;
                  Dummy_Sym  : Symbol_Record;

                  Real_End   : Node_Index := End_Node;
                  Step_Node  : Node_Index := 0;

                  Target_Lex : constant String := Scoped_Lexeme (Lexeme);
                  Loop_Range : Natural := 0;
                  Loop_Resolve_Tag : ALB_Type_Tag := Type_U64;
               begin
                  -- Ten Rules: Minimum average of two runtime assertions
                  pragma Assert (Tok.Length > 0, "AST_For_Stmt: Token length maun be positive");

                  -- Ten Rules: Seicond assertion tae prevent bounds errors
                  pragma Assert (Target_Lex'Length > 0, "AST_For_Stmt: Target_Lex maun no be empty");

                  Loop_Range := Find_Range_Var (Target_Lex);

                  if Tree (End_Node).Kind = AST_Arg_List then
                     Real_End := Tree (End_Node).Left_Child;
                     Step_Node := Tree (Real_End).Next_Sibling;
                  end if;

                  if Target = Backend_FASM16 then
                     Loop_Resolve_Tag :=
                       FASM16_Select_For_Tag
                         (Infer_Type_Tag (Start_Node),
                          Infer_Type_Tag (Real_End),
                          (if Step_Node > 0 then Infer_Type_Tag (Step_Node) else Type_None));
                  end if;

                  Dummy_Sym :=
                    Resolve_Symbol
                      (Lexeme,
                       Loop_Resolve_Tag,
                       0,
                       False,
                       Dummy_Tag);

                  -- Braw an' clean independent branches fer ilka target
                  case Target is
         
                  when Backend_FASM =>
                     Push_FASM_Loop_Labels
                       (".FOR_END_" & NID,
                        ".FOR_CONT_" & NID,
                        Node,
                        Success,
                        Diag);
                     if not Success then return; end if;

                     if Loop_Range > 0 then
                        Validate_Static_Range_Expr(Start_Node, Loop_Range, Start_Node, Success, Diag);
                        if not Success or else not Diag.Success then return; end if;

                        Validate_Static_Range_Expr(Real_End, Loop_Range, Real_End, Success, Diag);
                        if not Success or else not Diag.Success then return; end if;
                     end if;

                     Walk_AST (Start_Node, Depth + 1, Right_Tag, Success, Diag);
                     if not Success then return; end if;

                     if Loop_Range > 0 then
                        Emit_FASM_Range_Check_RAX(Loop_Range);
                        if not Success then return; end if;
                     end if;

                     Emit_FASM_Store_RAX_To_Scalar (Target_Lex, Dummy_Sym.Tag, Success);

                     Transpiler_Native_HAL.Emit_Raw (".FOR_START_" & NID & ":", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);

                     Walk_AST (Real_End, Depth + 1, Right_Tag, Success, Diag);
                     if not Success then return; end if;

                     if Loop_Range > 0 then
                        Emit_FASM_Range_Check_RAX(Loop_Range);
                        if not Success then return; end if;
                     end if;

                     Transpiler_Native_HAL.Emit_Raw ("  mov rbx, rax", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);

                     Emit_FASM_Load_Scalar_To_RAX (Target_Lex, Dummy_Sym.Tag, Success);

                     Transpiler_Native_HAL.Emit_Raw ("  cmp rax, rbx", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Emit_Raw ("  jg .FOR_END_" & NID, Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Increase_Indent;

                     Walk_AST (Body_Node, Depth + 1, Right_Tag, Success, Diag);
                     if not Success then return; end if;

                     Transpiler_Native_HAL.Emit_Raw (".FOR_CONT_" & NID & ":", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);

                     if Loop_Range > 0 then
                        Walk_AST (Real_End, Depth + 1, Right_Tag, Success, Diag);
                        if not Success then return; end if;

                        Emit_FASM_Range_Check_RAX (Loop_Range);
                        if not Success then return; end if;

                        Transpiler_Native_HAL.Emit_Raw ("  mov rbx, rax", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);

                        Emit_FASM_Load_Scalar_To_RAX (Target_Lex, Dummy_Sym.Tag, Success);

                        Transpiler_Native_HAL.Emit_Raw ("  cmp rax, rbx", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  jge .FOR_END_" & NID, Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                     end if;

                     if Step_Node > 0 then
                        if Loop_Range > 0 then
                           Transpiler_Native_HAL.Emit_Raw ("  push rbx", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Transpiler_Native_HAL.Emit_Raw ("  push rax", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);

                           Walk_AST (Step_Node, Depth + 1, Right_Tag, Success, Diag);
                           if not Success then return; end if;

                           Transpiler_Native_HAL.Emit_Raw ("  mov r10, rax", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Transpiler_Native_HAL.Emit_Raw ("  pop rax", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Transpiler_Native_HAL.Emit_Raw ("  pop rbx", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Transpiler_Native_HAL.Emit_Raw ("  add rax, r10", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);

                           Transpiler_Native_HAL.Emit_Raw ("  cmp rax, rbx", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Transpiler_Native_HAL.Emit_Raw ("  jg .FOR_END_" & NID, Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                        else
                           Walk_AST (Step_Node, Depth + 1, Right_Tag, Success, Diag);
                           if not Success then return; end if;

                           Transpiler_Native_HAL.Emit_Raw ("  mov r10, rax", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Emit_FASM_Load_Scalar_To_RAX (Target_Lex, Dummy_Sym.Tag, Success);
                           Transpiler_Native_HAL.Emit_Raw ("  add rax, r10", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                        end if;

                        if Loop_Range > 0 then
                           Emit_FASM_Range_Check_RAX (Loop_Range);
                           if not Success then return; end if;
                        end if;

                        Emit_FASM_Store_RAX_To_Scalar (Target_Lex, Dummy_Sym.Tag, Success);
                     else
                        Emit_FASM_Load_Scalar_To_RAX (Target_Lex, Dummy_Sym.Tag, Success);
                        -- Task A2: when inside one or more STRIDE blocks
                        -- with no explicit STEP, step by the innermost
                        -- pinned stride width instead of by 1.
                        if Stride_Depth > 0
                          and then Stride_Depth <= Max_Mode_Nesting
                          and then Stride_Width_Label_Len (Stride_Depth) > 0
                        then
                           declare
                              SLen : constant Natural :=
                                Stride_Width_Label_Len (Stride_Depth);
                              SLab : constant String :=
                                Stride_Width_Label_Stack (Stride_Depth) (1 .. SLen);
                           begin
                              Transpiler_Native_HAL.Emit_Raw
                                ("  add rax, qword [" & SLab & "]", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                           end;
                        else
                           Transpiler_Native_HAL.Emit_Raw ("  inc rax", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                        end if;
                        if Loop_Range > 0 then
                           Emit_FASM_Range_Check_RAX (Loop_Range);
                           if not Success then return; end if;
                        end if;
                        Emit_FASM_Store_RAX_To_Scalar (Target_Lex, Dummy_Sym.Tag, Success);
                     end if;

                     Transpiler_Native_HAL.Emit_Raw ("  jmp .FOR_START_" & NID, Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Decrease_Indent;
                     Transpiler_Native_HAL.Emit_Raw (".FOR_END_" & NID & ":", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);

                     Pop_FASM_Loop_Labels;
                  when Backend_FASM16 =>
                     declare
                        Loop_Tag  : ALB_Type_Tag := Dummy_Sym.Tag;
                        Loop_Cell : constant String :=
                          FASM16_Cell_Name (Dummy_Sym, Target_Lex);
                     begin
                        --if Loop_Tag = Type_U64 then
                        --   Loop_Tag := Type_U16;
                       -- end if;

                        if not FASM16_Scalar_Supported (Loop_Tag) then
                           Fail_Node
                             (Node,
                              Err_Type_Conflict,
                              "FASM16 FOR supports U8, U16, U32, U64, S32, S64, HW8, HW16, HW32, PURE, or Boolean",
                              Success,
                              Diag);
                           return;
                        end if;

                        Push_FASM_Loop_Labels
                          (".ALB16_FOR_END_" & NID,
                           ".ALB16_FOR_CONT_" & NID,
                           Node,
                           Success,
                           Diag);

                        if not Success then
                           return;
                        end if;

                        -- I = START
                        Walk_AST (Start_Node, Depth + 1, Right_Tag, Success, Diag);
                        if not Success then return; end if;

                        Emit_FASM16_Type_Store_Check_AX (Loop_Tag);
                        if not Success then return; end if;

                        Emit_FASM16_Store_DXAX_To_Cell (Loop_Cell, Loop_Tag);

                        Transpiler_Native_HAL.Emit_Raw (".ALB16_FOR_START_" & NID & ":", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);

                        -- END travels as DX:AX and is temporarily saved on the stack.
                        Walk_AST (Real_End, Depth + 1, Right_Tag, Success, Diag);
                        if not Success then return; end if;

                        Transpiler_Native_HAL.Emit_Raw ("  push dx", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  push ax", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);

                        Emit_FASM16_Load_Cell_To_DXAX (Loop_Cell, Loop_Tag);

                        Transpiler_Native_HAL.Emit_Raw ("  pop bx", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  pop cx", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);

                        if Loop_Tag = Type_S32 then
                           Transpiler_Native_HAL.Emit_Raw ("  cmp dx, cx", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Transpiler_Native_HAL.Emit_Raw ("  jg .ALB16_FOR_END_" & NID, Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Transpiler_Native_HAL.Emit_Raw ("  jl .ALB16_FOR_BODY_" & NID, Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Transpiler_Native_HAL.Emit_Raw ("  cmp ax, bx", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Transpiler_Native_HAL.Emit_Raw ("  ja .ALB16_FOR_END_" & NID, Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                        else
                           Transpiler_Native_HAL.Emit_Raw ("  cmp dx, cx", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Transpiler_Native_HAL.Emit_Raw ("  ja .ALB16_FOR_END_" & NID, Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Transpiler_Native_HAL.Emit_Raw ("  jb .ALB16_FOR_BODY_" & NID, Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Transpiler_Native_HAL.Emit_Raw ("  cmp ax, bx", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Transpiler_Native_HAL.Emit_Raw ("  ja .ALB16_FOR_END_" & NID, Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                        end if;

                        Transpiler_Native_HAL.Emit_Raw (".ALB16_FOR_BODY_" & NID & ":", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);

                        declare
                           Start_Val   : U64 := 0;
                           End_Val     : U64 := 0;
                           Step_Val    : U64 := 0;
                           Step_Is_One : Boolean := Step_Node = 0;
                        begin
                           if Step_Node > 0 then
                              Step_Is_One :=
                                Try_Literal_U64 (Step_Node, Step_Val) and then Step_Val = 1;
                           end if;

                           if Step_Is_One
                             and then Try_Literal_U64 (Start_Node, Start_Val)
                             and then Try_Literal_U64 (Real_End, End_Val)
                           then
                              Loop_Label_Stack (Loop_Label_Depth).FASM16_Guard_Active := True;
                              Loop_Label_Stack (Loop_Label_Depth).FASM16_Guard_Hash :=
                                Hash_String (Target_Lex);
                              Loop_Label_Stack (Loop_Label_Depth).FASM16_Guard_Start := Start_Val;
                              Loop_Label_Stack (Loop_Label_Depth).FASM16_Guard_End := End_Val;
                           else
                              Loop_Label_Stack (Loop_Label_Depth).FASM16_Guard_Active := False;
                           end if;
                        end;

                        Walk_AST (Body_Node, Depth + 1, Right_Tag, Success, Diag);
                        if not Success then return; end if;

                        Transpiler_Native_HAL.Emit_Raw (".ALB16_FOR_CONT_" & NID & ":", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);

                        if Step_Node > 0 then
                           Walk_AST (Step_Node, Depth + 1, Right_Tag, Success, Diag);
                           if not Success then return; end if;

                           Transpiler_Native_HAL.Emit_Raw ("  mov bx, ax", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Transpiler_Native_HAL.Emit_Raw ("  or bx, dx", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Emit_FASM16_Long_Trap_Jcc ("jz", "ALB16_Runtime_DivZero");

                           Transpiler_Native_HAL.Emit_Raw ("  push dx", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Transpiler_Native_HAL.Emit_Raw ("  push ax", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);

                           Emit_FASM16_Load_Cell_To_DXAX (Loop_Cell, Loop_Tag);

                           Transpiler_Native_HAL.Emit_Raw ("  pop bx", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Transpiler_Native_HAL.Emit_Raw ("  pop cx", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Transpiler_Native_HAL.Emit_Raw ("  add ax, bx", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Transpiler_Native_HAL.Emit_Raw ("  adc dx, cx", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                        else
                           Emit_FASM16_Load_Cell_To_DXAX (Loop_Cell, Loop_Tag);
                           Transpiler_Native_HAL.Emit_Raw ("  add ax, 1", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Transpiler_Native_HAL.Emit_Raw ("  adc dx, 0", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                        end if;

                        Emit_FASM16_Type_Store_Check_AX (Loop_Tag);
                        if not Success then return; end if;

                        Emit_FASM16_Store_DXAX_To_Cell (Loop_Cell, Loop_Tag);

                        Transpiler_Native_HAL.Emit_Raw ("  jmp .ALB16_FOR_START_" & NID, Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw (".ALB16_FOR_END_" & NID & ":", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);

                        Pop_FASM_Loop_Labels;
                     end;

                  when others =>
                     Transpiler_Native_HAL.Emit_For_Start (Target_Lex, Success);
            
                     Walk_AST (Start_Node, Depth + 1, Right_Tag, Success, Diag);
                     if not Success then return; end if;
            
                     Transpiler_Native_HAL.Emit_DotDot (Success);
            
                     Walk_AST (Real_End, Depth + 1, Right_Tag, Success, Diag);
                     if not Success then return; end if;

                     if Step_Node > 0 then
                        Transpiler_Native_HAL.Emit_Loop_Step_Mid (Success);
                        Walk_AST (Step_Node, Depth + 1, Right_Tag, Success, Diag);
                        if not Success then return; end if;
                        Transpiler_Native_HAL.Emit_Loop_Step_End (Success);
                     elsif Target = Backend_C
                       and then Stride_Depth > 0
                       and then Stride_Depth <= Max_Mode_Nesting
                       and then Stride_Width_Label_Len (Stride_Depth) > 0
                     then
                        -- Task 1B (C): no explicit STEP and we're nested
                        -- inside a STRIDE block.  Step by the innermost
                        -- pinned width, mirroring the FASM behaviour.
                        declare
                           SLen : constant Natural :=
                             Stride_Width_Label_Len (Stride_Depth);
                           SLab : constant String :=
                             Stride_Width_Label_Stack
                               (Stride_Depth) (1 .. SLen);
                        begin
                           Transpiler_Native_HAL.Emit_Loop_Step_Mid (Success);
                           Transpiler_Native_HAL.Emit_Raw (SLab, Success);
                           Transpiler_Native_HAL.Emit_Loop_Step_End (Success);
                        end;
                     else
                        Transpiler_Native_HAL.Emit_Loop_Start (Success);
                     end if;

                     Walk_AST (Body_Node, Depth + 1, Right_Tag, Success, Diag);
                     if not Success then return; end if;
            
                     Transpiler_Native_HAL.Emit_Loop_End (Success);

                  end case;

                  Out_Tag := Type_None;
               end;
               
                  when AST_Foreach_Stmt =>
                  declare
                     Iter_Tok : Token := Tokens (Tree (Node).Token_Index);
                     Iter_Lex : String := Input_Buffer (Iter_Tok.Start .. Iter_Tok.Start + Iter_Tok.Length - 1);

                     Array_Node : Node_Index := Tree (Node).Left_Child;
                     Arr_Tok    : Token := Tokens (Tree (Array_Node).Token_Index);
                     Arr_Lex    : String := Input_Buffer (Arr_Tok.Start .. Arr_Tok.Start + Arr_Tok.Length - 1);

                     Block_Node : Node_Index := Tree (Node).Right_Child;
                     Sym        : Symbol_Record;
                     Found      : Boolean;

                     Img         : constant String := Node_Index'Image (Node);
                     NID         : constant String := Img (Img'First + 1 .. Img'Last);
                     Idx_Name    : constant String := "ALB_FE_IDX_" & NID;

                     Target_Iter : String (1 .. 128) := (others => ' ');
                     Target_Ilen : Natural := 0;
                     Target_Arr  : String (1 .. 128) := (others => ' ');
                     Target_Alen : Natural := 0;

                     Arr_Idx       : Natural := 0;
                     Element_Range : Natural := 0;
                     Iter_Range    : Natural := 0;
                     Iter_Tag      : ALB_Type_Tag := Type_U64;
                     Visible_Count : U64 := 0;
                     Source_Sym    : Symbol_Record;
                     Source_Found  : Boolean := False;
                     Source_Is_Binary : Boolean := False;
                  begin
                     if Active_Module_Len > 0 then
                        Target_Iter (1 .. Active_Module_Len) := Active_Module_Name (1 .. Active_Module_Len);
                        Target_Iter (Active_Module_Len + 1) := '_';
                        Target_Iter (Active_Module_Len + 2 .. Active_Module_Len + 1 + Iter_Lex'Length) := Iter_Lex;
                        Target_Ilen := Active_Module_Len + 1 + Iter_Lex'Length;

                        Target_Arr (1 .. Active_Module_Len) := Active_Module_Name (1 .. Active_Module_Len);
                        Target_Arr (Active_Module_Len + 1) := '_';
                        Target_Arr (Active_Module_Len + 2 .. Active_Module_Len + 1 + Arr_Lex'Length) := Arr_Lex;
                        Target_Alen := Active_Module_Len + 1 + Arr_Lex'Length;
                     else
                        Target_Iter (1 .. Iter_Lex'Length) := Iter_Lex;
                        Target_Ilen := Iter_Lex'Length;

                        Target_Arr (1 .. Arr_Lex'Length) := Arr_Lex;
                        Target_Alen := Arr_Lex'Length;
                     end if;
                  
                     Arr_Idx := Find_Strict_Array(Target_Arr(1 .. Target_Alen));
                     Find_Symbol
                       (Hash_String (Target_Arr (1 .. Target_Alen)),
                        Current_Scope,
                        Source_Found,
                        Source_Sym);

                     if Arr_Idx = 0 then
                        if Target = Backend_FASM16
                          and then Source_Found
                          and then Source_Sym.Tag = Type_Binary
                        then
                           Source_Is_Binary := True;
                        else
                           Fail_Node(Array_Node, Err_Mem_Out_Of_Bounds, Arr_Lex, Success, Diag);
                           return;
                        end if;
                     end if;

                     -- FOREACH walks the physical ALB array payload in source order.
                     -- Slot 0 remains reserved; multidimensional arrays flatten from 1..N.
                     if not Source_Is_Binary then
                        Visible_Count := 1;
                        for D in 1 .. Strict_Arrays(Arr_Idx).Dim_Count loop
                           Visible_Count :=
                             Visible_Count * U64 (Strict_Arrays(Arr_Idx).Dims(D));
                        end loop;
                     end if;

                  Element_Range := Find_Range_Array(Target_Arr(1 .. Target_Alen));
                  if Element_Range > 0 then
                     Iter_Tag := Range_Types(Element_Range).Base_Tag;
                  end if;
                  
                  if Target = Backend_FASM16 and then Element_Range = 0 then
                     if Source_Is_Binary then
                        Iter_Tag := Type_U8;
                     elsif Source_Found then
                        Iter_Tag := Source_Sym.Tag;
                     end if;
                  end if;

                     Find_Symbol (Hash_String (Target_Iter (1 .. Target_Ilen)), Current_Scope, Found, Sym);

                     if Found then
                        if Element_Range > 0 and then Sym.Tag /= Iter_Tag then
                           Fail_Node(Node, Err_Type_Conflict, Iter_Lex, Success, Diag);
                           return;
                        elsif Element_Range = 0 then
                           Iter_Tag := Sym.Tag;
                        end if;

                        if Source_Is_Binary
                          and then
                            (Sym.Tag = Type_Binary
                             or else Sym.Tag = Type_Reference
                             or else Sym.Tag = Type_Pure)
                        then
                           Fail_Node
                             (Node,
                              Err_Type_Conflict,
                              "FASM16 FOREACH over STRING/BINARY needs a scalar byte-sized or numeric iterator",
                              Success,
                              Diag);
                           return;
                        end if;
                     else
                        if Target = Backend_FASM16 then
                           declare
                              Iter_Bytes : constant U64 :=
                                U64 (FASM16_Storage_Bytes (Iter_Tag));
                              Local_OK   : Boolean := False;
                           begin
                              Local_Offset := Local_Offset + Integer (Iter_Bytes);

                              Add_Local_Symbol
                                (Hash_String (Target_Iter (1 .. Target_Ilen)),
                                 Iter_Tag,
                                 (Target => Target_Variable, Index => 0),
                                 -Local_Offset,
                                 0,
                                 Current_Scope,
                                 Local_OK);

                              if not Local_OK then
                                 Fail_Node (Node, Err_Mem_Out_Of_Bounds, Iter_Lex, Success, Diag);
                                 return;
                              end if;

                           end;
                        else
                           Add_Local_Symbol
                             (Hash_String (Target_Iter (1 .. Target_Ilen)),
                              Iter_Tag,
                              (Target => Target_Variable, Index => 0),
                              0,
                              0,
                              Current_Scope,
                              Success);

                           if Target = Backend_FASM then
                              Transpiler_Native_HAL.Emit_Var_Decl
                                (Target_Iter (1 .. Target_Ilen), Iter_Tag, Success);
                           end if;
                        end if;
                     end if;

                     if Element_Range > 0 then
                        Iter_Range := Find_Range_Var(Target_Iter(1 .. Target_Ilen));

                        if Iter_Range > 0 and then Iter_Range /= Element_Range then
                           Fail_Node(Node, Err_Type_Conflict, Iter_Lex, Success, Diag);
                           return;
                        end if;

                        Register_Range_Var(Target_Iter(1 .. Target_Ilen), Element_Range);
                        Iter_Range := Element_Range;
                     elsif Source_Is_Binary then
                        Iter_Range := Find_Range_Var(Target_Iter(1 .. Target_Ilen));
                     end if;


                     if Target = Backend_FASM then
                        Transpiler_Native_HAL.Emit_Var_Decl (Idx_Name, Type_U64, Success);

                        Transpiler_Native_HAL.Emit_Raw
                          ("  ; ALB_FOREACH_SOURCE_VISIBLE_1_BASED_RANGE_GUARDED", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);

                        Push_FASM_Loop_Labels
                          (".FOREACH_END_" & NID,
                           ".FOREACH_CONT_" & NID,
                           Node,
                           Success,
                           Diag);
                        if not Success then
                           return;
                        end if;

                        -- ALB arrays are source-level 1-based. Slot 0 is never part of FOREACH.
                        Transpiler_Native_HAL.Emit_Raw ("  mov qword [" & Idx_Name & "], 1", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);

                        Transpiler_Native_HAL.Emit_Raw (".FOREACH_START_" & NID & ":", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);

                        Transpiler_Native_HAL.Emit_Raw ("  mov rbx, qword [" & Idx_Name & "]", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);

                        Transpiler_Native_HAL.Emit_Raw ("  test rbx, rbx", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  jz ALB_Runtime_Trap_Bounds", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);

                        Transpiler_Native_HAL.Emit_Raw ("  cmp rbx, ", Success);
                        Transpiler_Native_HAL.Emit_Literal_U64 (Visible_Count, Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);

                        -- Natural loop completion is not a bounds error.
                        Transpiler_Native_HAL.Emit_Raw ("  ja .FOREACH_END_" & NID, Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);

                        Transpiler_Native_HAL.Emit_Raw
                          ("  mov rax, qword [" & Target_Arr (1 .. Target_Alen) & " + rbx * 8]",
                           Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);

                        if Element_Range > 0 then
                           Emit_FASM_Range_Check_RAX(Element_Range);
                           if not Success then return; end if;
                        end if;

                        Emit_FASM_Store_RAX_To_Scalar
                          (Target_Iter (1 .. Target_Ilen),
                           Iter_Tag,
                           Success);
                        if not Success then return; end if;

                        if Block_Node > 0 then
                           Walk_AST (Block_Node, Depth + 1, Out_Tag, Success, Diag);
                           if not Success then return; end if;
                        end if;

                        Transpiler_Native_HAL.Emit_Raw (".FOREACH_CONT_" & NID & ":", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);

                        Transpiler_Native_HAL.Emit_Raw ("  inc qword [" & Idx_Name & "]", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);

                        Transpiler_Native_HAL.Emit_Raw ("  jmp .FOREACH_START_" & NID, Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);

                        Transpiler_Native_HAL.Emit_Raw (".FOREACH_END_" & NID & ":", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);

                        Pop_FASM_Loop_Labels;
                     
                     elsif Target = Backend_FASM16 then
                        Transpiler_Native_HAL.Emit_Global_Var_Decl (Idx_Name, Type_U16, Success);

                        Transpiler_Native_HAL.Emit_Raw
                          ("  ; ALB16_FOREACH_SOURCE_VISIBLE_1_BASED_RANGE_GUARDED", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);

                        Push_FASM_Loop_Labels
                          (".ALB16_FOREACH_END_" & NID,
                           ".ALB16_FOREACH_CONT_" & NID,
                           Node,
                           Success,
                           Diag);
                        if not Success then
                           return;
                        end if;

                        if Source_Is_Binary then
                           Transpiler_Native_HAL.Emit_Raw ("  mov word [" & Idx_Name & "], 0", Success);
                        else
                           Transpiler_Native_HAL.Emit_Raw ("  mov word [" & Idx_Name & "], 1", Success);
                        end if;
                        Transpiler_Native_HAL.Emit_Newline (Success);

                        Transpiler_Native_HAL.Emit_Raw (".ALB16_FOREACH_START_" & NID & ":", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);

                        Transpiler_Native_HAL.Emit_Raw ("  mov bx, word [" & Idx_Name & "]", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);

                        if Source_Is_Binary then
                           declare
                              Source_Cell : constant String :=
                                FASM16_Cell_Name
                                  (Source_Sym, Target_Arr (1 .. Target_Alen));
                           begin
                              Emit_FASM16_Load_Cell_To_DXAX (Source_Cell, Type_Binary);
                              Transpiler_Native_HAL.Emit_Raw ("  test ax, ax", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  jz .ALB16_FOREACH_END_" & NID, Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  mov si, ax", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  add si, bx", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  xor ax, ax", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  xor dx, dx", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  mov al, byte [si]", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  test al, al", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  jz .ALB16_FOREACH_END_" & NID, Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                           end;
                        else
                           Transpiler_Native_HAL.Emit_Raw ("  cmp bx, 0", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Emit_FASM16_Long_Trap_Jcc ("je", "ALB16_Runtime_Bounds");

                           Transpiler_Native_HAL.Emit_Raw ("  cmp bx, ", Success);
                           Transpiler_Native_HAL.Emit_Literal_U64 (Visible_Count, Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);

                           Transpiler_Native_HAL.Emit_Raw ("  ja .ALB16_FOREACH_END_" & NID, Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);

                           declare
                              Elem_Bytes : constant Natural := FASM16_Storage_Bytes (Iter_Tag);
                           begin
                              if Elem_Bytes = 4 then
                                 Transpiler_Native_HAL.Emit_Raw ("  shl bx, 1", Success);
                                 Transpiler_Native_HAL.Emit_Newline (Success);
                                 Transpiler_Native_HAL.Emit_Raw ("  shl bx, 1", Success);
                                 Transpiler_Native_HAL.Emit_Newline (Success);
                              elsif Elem_Bytes = 2 then
                                 Transpiler_Native_HAL.Emit_Raw ("  shl bx, 1", Success);
                                 Transpiler_Native_HAL.Emit_Newline (Success);
                              end if;
                           end;

                           declare
                              Arr_Sym   : Symbol_Record;
                              Arr_Found : Boolean := False;
                           begin
                              Find_Symbol
                                (Hash_String (Target_Arr (1 .. Target_Alen)),
                                 Current_Scope,
                                 Arr_Found,
                                 Arr_Sym);

                              if Arr_Found and then Arr_Sym.Class = Class_Local and then Arr_Sym.Offset < 0 then
                                 declare
                                    Img : constant String := Integer'Image (-Arr_Sym.Offset);
                                    Off : constant String := Img (Img'First + 1 .. Img'Last);
                                 begin
                                    Transpiler_Native_HAL.Emit_Raw ("  mov si, bx", Success);
                                    Transpiler_Native_HAL.Emit_Newline (Success);
                                    Emit_FASM16_Load_Cell_To_DXAX
                                      ("bp+si-" & Off,
                                       Iter_Tag);
                                 end;

                              elsif Arr_Found and then Arr_Sym.Class = Class_Local and then Arr_Sym.Offset > 0 then
                                 declare
                                    Img : constant String := Integer'Image (Arr_Sym.Offset);
                                    Off : constant String := Img (Img'First + 1 .. Img'Last);
                                 begin
                                    Transpiler_Native_HAL.Emit_Raw ("  mov si, bx", Success);
                                    Transpiler_Native_HAL.Emit_Newline (Success);
                                    Emit_FASM16_Load_Cell_To_DXAX
                                      ("bp+si+" & Off,
                                       Iter_Tag);
                                 end;

                              else
                                 Emit_FASM16_Load_Cell_To_DXAX
                                   (Target_Arr (1 .. Target_Alen) & " + bx",
                                    Iter_Tag);
                              end if;
                           end;
                        end if;

                        if Iter_Range > 0 then
                           Emit_FASM16_Range_Check_AX (Iter_Range);
                           if not Success then return; end if;
                        end if;

                        Emit_FASM16_Type_Store_Check_AX (Iter_Tag);
                        if not Success then return; end if;

                        declare
                           Iter_Sym   : Symbol_Record;
                           Iter_Found : Boolean;
                        begin
                           Find_Symbol
                             (Hash_String (Target_Iter (1 .. Target_Ilen)),
                              Current_Scope,
                              Iter_Found,
                              Iter_Sym);

                           if Iter_Found and then Iter_Sym.Class = Class_Local and then Iter_Sym.Offset < 0 then
                              declare
                                 Img : constant String := Integer'Image (-Iter_Sym.Offset);
                                 Off : constant String := Img (Img'First + 1 .. Img'Last);
                              begin
                                 Emit_FASM16_Store_DXAX_To_Cell ("bp-" & Off, Iter_Tag);
                              end;

                           elsif Iter_Found and then Iter_Sym.Class = Class_Local and then Iter_Sym.Offset > 0 then
                              declare
                                 Img : constant String := Integer'Image (Iter_Sym.Offset);
                                 Off : constant String := Img (Img'First + 1 .. Img'Last);
                              begin
                                 Emit_FASM16_Store_DXAX_To_Cell ("bp+" & Off, Iter_Tag);
                              end;

                           else
                              Emit_FASM16_Store_DXAX_To_Cell
                                (Target_Iter (1 .. Target_Ilen),
                                 Iter_Tag);
                           end if;


                        end;

                        if Block_Node > 0 then
                           Walk_AST (Block_Node, Depth + 1, Out_Tag, Success, Diag);
                           if not Success then return; end if;
                        end if;

                        Transpiler_Native_HAL.Emit_Raw (".ALB16_FOREACH_CONT_" & NID & ":", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);

                        Transpiler_Native_HAL.Emit_Raw ("  inc word [" & Idx_Name & "]", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);

                        Transpiler_Native_HAL.Emit_Raw ("  jmp .ALB16_FOREACH_START_" & NID, Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);

                        Transpiler_Native_HAL.Emit_Raw (".ALB16_FOREACH_END_" & NID & ":", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);

                        Pop_FASM_Loop_Labels;
                     
                     else
                        Transpiler_Native_HAL.Emit_Foreach_Start
                          (Target_Iter (1 .. Target_Ilen),
                           Target_Arr (1 .. Target_Alen),
                           Success);

                        if Block_Node > 0 then
                           Walk_AST (Block_Node, Depth + 1, Out_Tag, Success, Diag);
                        end if;

                        Transpiler_Native_HAL.Emit_Loop_End (Success);
                     end if;

                     Out_Tag := Type_None;
                  end;


               
                  when AST_Step_Stmt =>
                  declare
                     Count_Node : Node_Index := Tree (Node).Left_Child;
                  begin
                     -- The STEP statement suspends execution for N debugger steps or context switches
                     -- Emit: Sleep(Count);
                     Transpiler_Native_HAL.Emit_Raw ("ALB_Delay(", Success);
                     if Success then
                        -- Recursive call to compile the Count expression
                        Walk_AST (Count_Node, Depth + 1, Right_Tag, Success, Diag);
                     end if;
                     if Success then
                        Transpiler_Native_HAL.Emit_Raw (");", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                     end if;
                     Out_Tag := Type_None;
                  end;
                  
            when AST_Select_Stmt | AST_Match_Stmt =>
               declare
                  Target_Node : Node_Index := Tree (Node).Left_Child;
                  Curr_Case   : Node_Index := Tree (Node).Right_Child;
                  Img         : constant String := Node_Index'Image (Node);
                  NID         : constant String := Img (Img'First + 1 .. Img'Last);
                  Case_Idx    : Natural := 0;
               begin
                  if Target = Backend_FASM then
                     declare
                        Saved_Select_Stack_Bytes : constant Natural := Current_FASM_Select_Stack_Bytes;
                     begin
                        Transpiler_Native_HAL.Emit_Raw ("; SELECT START " & NID, Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        
                        -- Evaluate Target and stash it safely on the stack
                        Walk_AST (Target_Node, Depth + 1, Right_Tag, Success, Diag);
                        Transpiler_Native_HAL.Emit_Raw ("  push rax", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Current_FASM_Select_Stack_Bytes := Current_FASM_Select_Stack_Bytes + 8;
                        
                        while Curr_Case /= 0 loop
                           Case_Idx := Case_Idx + 1;
                           declare
                              CImg : constant String := Natural'Image (Case_Idx);
                              CID  : constant String := CImg (CImg'First + 1 .. CImg'Last);
                              Cond_Node : constant Node_Index := Tree (Curr_Case).Left_Child;
                           begin
                              if Cond_Node = 0 then
                                 Transpiler_Native_HAL.Increase_Indent;
                                 Walk_AST (Tree (Curr_Case).Right_Child, Depth + 1, Right_Tag, Success, Diag);
                                 Transpiler_Native_HAL.Emit_Raw ("  jmp .END_SELECT_" & NID, Success);
                                 Transpiler_Native_HAL.Emit_Newline (Success);
                                 Transpiler_Native_HAL.Decrease_Indent;
                              else
                                 -- Walk the Case Condition (leaves its value in rax)
                                 Walk_AST (Cond_Node, Depth + 1, Right_Tag, Success, Diag);

                                 -- Compare against the stashed selector without touching rbx
                                 -- (FOR loops park the end-bound in rbx across the body).
                                 Transpiler_Native_HAL.Emit_Raw
                                   ("  cmp rax, qword [rsp]", Success);
                                 Transpiler_Native_HAL.Emit_Newline (Success);
                                 Transpiler_Native_HAL.Emit_Raw
                                   ("  jne .NEXT_CASE_" & NID & "_" & CID, Success);
                                 Transpiler_Native_HAL.Emit_Newline (Success);
                                 
                                 Transpiler_Native_HAL.Increase_Indent;
                                 -- Walk Case Body
                                 Walk_AST (Tree (Curr_Case).Right_Child, Depth + 1, Right_Tag, Success, Diag);
                                 
                                 -- Break oot o' the switch!
                                 Transpiler_Native_HAL.Emit_Raw ("  jmp .END_SELECT_" & NID, Success);
                                 Transpiler_Native_HAL.Emit_Newline (Success);
                                 Transpiler_Native_HAL.Decrease_Indent;
                                 
                                 -- Label for the neist case
                                 Transpiler_Native_HAL.Emit_Raw (".NEXT_CASE_" & NID & "_" & CID & ":", Success);
                                 Transpiler_Native_HAL.Emit_Newline (Success);
                              end if;
                           end;
                           Curr_Case := Tree (Curr_Case).Next_Sibling;
                        end loop;
                        
                        -- Clean up the stack and seal the vault
                        Transpiler_Native_HAL.Emit_Raw (".END_SELECT_" & NID & ":", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  add rsp, 8", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Current_FASM_Select_Stack_Bytes := Saved_Select_Stack_Bytes;
                     end;

                  elsif Target = Backend_FASM16 then
                     declare
                        Target_Tag : ALB_Type_Tag := Type_None;
                        Case_Tag   : ALB_Type_Tag := Type_None;
                        Saved_Select_Stack_Bytes : constant Natural :=
                          Current_FASM_Select_Stack_Bytes;
                     begin
                        Transpiler_Native_HAL.Emit_Raw ("; ALB16 SELECT START " & NID, Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);

                        Walk_AST (Target_Node, Depth + 1, Target_Tag, Success, Diag);
                        Transpiler_Native_HAL.Emit_Raw ("  push dx", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  push ax", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        -- Track the 4-byte selector stash so BREAK/CONTINUE
                        -- can unwind it (see Emit_FASM_Loop_Jump).
                        Current_FASM_Select_Stack_Bytes :=
                          Current_FASM_Select_Stack_Bytes + 4;

                        while Curr_Case /= 0 loop
                           Case_Idx := Case_Idx + 1;

                           declare
                              CImg : constant String := Natural'Image (Case_Idx);
                              CID  : constant String := CImg (CImg'First + 1 .. CImg'Last);
                              Cond_Node : constant Node_Index := Tree (Curr_Case).Left_Child;
                           begin
                              if Cond_Node = 0 then
                                 Walk_AST (Tree (Curr_Case).Right_Child, Depth + 1, Right_Tag, Success, Diag);

                                 Transpiler_Native_HAL.Emit_Raw ("  jmp .ALB16_END_SELECT_" & NID, Success);
                                 Transpiler_Native_HAL.Emit_Newline (Success);
                              else
                                 Case_Tag := Type_None;
                                 Walk_AST (Cond_Node, Depth + 1, Case_Tag, Success, Diag);

                                 Transpiler_Native_HAL.Emit_Raw ("  pop si", Success);
                                 Transpiler_Native_HAL.Emit_Newline (Success);
                                 Transpiler_Native_HAL.Emit_Raw ("  pop di", Success);
                                 Transpiler_Native_HAL.Emit_Newline (Success);
                                 Transpiler_Native_HAL.Emit_Raw ("  push di", Success);
                                 Transpiler_Native_HAL.Emit_Newline (Success);
                                 Transpiler_Native_HAL.Emit_Raw ("  push si", Success);
                                 Transpiler_Native_HAL.Emit_Newline (Success);

                                 Transpiler_Native_HAL.Emit_Raw ("  cmp dx, di", Success);
                                 Transpiler_Native_HAL.Emit_Newline (Success);
                                 Transpiler_Native_HAL.Emit_Raw ("  jne .ALB16_NEXT_CASE_" & NID & "_" & CID, Success);
                                 Transpiler_Native_HAL.Emit_Newline (Success);
                                 Transpiler_Native_HAL.Emit_Raw ("  cmp ax, si", Success);
                                 Transpiler_Native_HAL.Emit_Newline (Success);
                                 Transpiler_Native_HAL.Emit_Raw ("  jne .ALB16_NEXT_CASE_" & NID & "_" & CID, Success);
                                 Transpiler_Native_HAL.Emit_Newline (Success);

                                 Walk_AST (Tree (Curr_Case).Right_Child, Depth + 1, Right_Tag, Success, Diag);

                                 Transpiler_Native_HAL.Emit_Raw ("  jmp .ALB16_END_SELECT_" & NID, Success);
                                 Transpiler_Native_HAL.Emit_Newline (Success);

                                 Transpiler_Native_HAL.Emit_Raw (".ALB16_NEXT_CASE_" & NID & "_" & CID & ":", Success);
                                 Transpiler_Native_HAL.Emit_Newline (Success);
                              end if;
                           end;

                           Curr_Case := Tree (Curr_Case).Next_Sibling;
                        end loop;

                        Transpiler_Native_HAL.Emit_Raw (".ALB16_END_SELECT_" & NID & ":", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  add sp, 4", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Current_FASM_Select_Stack_Bytes := Saved_Select_Stack_Bytes;
                     end;

                  else
                     -- DA FIX: C89/C99 canna use ALB_V(...) in a switch/case!
                     -- We maun forge it as an if/else if ladder.
                     Transpiler_Native_HAL.Emit_Raw ("{ uint64_t _alb_switch_tgt_" & NID & " = ", Success);
                     Walk_AST (Target_Node, Depth + 1, Right_Tag, Success, Diag);
                     Transpiler_Native_HAL.Emit_Raw (";", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Emit_Raw ("if (0) {}", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     
                     while Curr_Case /= 0 loop
                        declare
                           Cond_Node : constant Node_Index := Tree (Curr_Case).Left_Child;
                        begin
                           if Cond_Node = 0 then
                              Transpiler_Native_HAL.Emit_Raw ("else {", Success);
                           else
                              Transpiler_Native_HAL.Emit_Raw ("else if (_alb_switch_tgt_" & NID & " == ", Success);
                              Walk_AST (Cond_Node, Depth + 1, Right_Tag, Success, Diag);
                              Transpiler_Native_HAL.Emit_Raw (") {", Success);
                           end if;
                        end;
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        
                        Walk_AST (Tree (Curr_Case).Right_Child, Depth + 1, Right_Tag, Success, Diag);
                        
                        Transpiler_Native_HAL.Emit_Raw ("}", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Curr_Case := Tree (Curr_Case).Next_Sibling;
                     end loop;
                     
                     Transpiler_Native_HAL.Emit_Raw ("}", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                  end if;
               end; 
            
            when AST_Print_Stmt =>
               declare
                  Expr_Node : Node_Index := Tree (Node).Left_Child;
                  PTag      : ALB_Type_Tag := Type_U64;
               begin
                  PTag := Infer_Type_Tag (Expr_Node);
                  if PTag = Type_None then
                     PTag := Type_U64;
                  end if;

                  
                  if Tree(Expr_Node).Kind = AST_String_Expr then
                     PTag := Type_Binary;
                  elsif Tree(Expr_Node).Kind = AST_Var_Expr then
                     declare
                        Tok        : Token := Tokens(Tree(Expr_Node).Token_Index);
                        Lex        : String := Input_Buffer(Tok.Start .. Tok.Start+Tok.Length-1);
                        Target_Lex : constant String := Scoped_Lexeme (Lex);
                        Sym        : Symbol_Record;
                        Found      : Boolean;
                        Elem_Range : Natural := 0;
                     begin
                        if Tree(Expr_Node).Left_Child > 0 then
                           Elem_Range := Find_Range_Array(Target_Lex);

                           if Elem_Range > 0 then
                              PTag := Range_Types(Elem_Range).Base_Tag;
                           end if;
                        else
                           Find_Symbol(Hash_String(Target_Lex), Current_Scope, Found, Sym);

                           if Found then
                              PTag := Sym.Tag;
                           end if;
                        end if;
                     end;
                  elsif Tree(Expr_Node).Kind = AST_Member_Expr then
                     declare
                        Var_Node   : Node_Index := Tree(Expr_Node).Left_Child;
                        Field_Node : Node_Index := Tree(Expr_Node).Right_Child;
                        V_Tok      : Token := Tokens(Tree(Var_Node).Token_Index);
                        V_Lex      : String := Input_Buffer(V_Tok.Start .. V_Tok.Start+V_Tok.Length-1);
                        V_Target   : constant String := Scoped_Lexeme (V_Lex);
                        F_Tok      : Token := Tokens(Tree(Field_Node).Token_Index);
                        F_Lex      : String := Input_Buffer(F_Tok.Start .. F_Tok.Start+F_Tok.Length-1);
                        Backing_Target : constant String := V_Target & "_" & F_Lex;
                        Backing_Lex    : constant String := V_Lex & "_" & F_Lex;
                        Sym        : Symbol_Record;
                        Found      : Boolean;
                        Field      : Struct_Field;
                        F_Found    : Boolean;
                     begin
                        Find_Symbol(Hash_String(V_Target), Current_Scope, Found, Sym);
                        if not Found then
                           Find_Symbol(Hash_String(V_Lex), Current_Scope, Found, Sym);
                        end if;
                        if Found and then Sym.Struct_ID > 0 then
                           Find_Struct_Field(Sym.Struct_ID, Hash_String(F_Lex), F_Found, Field);
                           if F_Found then PTag := Field.Tag; end if;
                        else
                           Find_Symbol(Hash_String(Backing_Target), Current_Scope, Found, Sym);
                           if not Found then
                              Find_Symbol(Hash_String(Backing_Lex), Current_Scope, Found, Sym);
                           end if;
                           if Found then
                              PTag := Sym.Tag;
                           end if;
                        end if;
                     end;
                  end if;

                  if Target = Backend_FASM16 then
                     declare
                        Img : constant String := Node_Index'Image (Node);
                        NID : constant String := Img (Img'First + 1 .. Img'Last);
                     begin
                        Transpiler_Native_HAL.Emit_Raw
                          ("  cmp byte [ALB16_TEMP_Future_Suppress_IO], 0", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw
                          ("  jne .ALB16_PRINT_SKIP_" & NID, Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);

                        if PTag = Type_Binary then
                           -- FASM16 ALB strings are NUL-terminated so literal
                           -- dollar signs survive DOS output.
                           Walk_AST (Expr_Node, Depth + 1, Out_Tag, Success, Diag);

                           Transpiler_Native_HAL.Emit_Raw ("  call ALB16_Print_C_Str", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);

                           if Tree(Node).Right_Child = 0 then
                              Transpiler_Native_HAL.Emit_Raw ("  call ALB16_Print_Newline", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                           end if;
                        else
                           Walk_AST (Expr_Node, Depth + 1, Out_Tag, Success, Diag);

                           if PTag = Type_Pure then
                              Transpiler_Native_HAL.Emit_Raw ("  call ALB16_Print_Pure", Success);
                           elsif PTag = Type_S32 then
                              Transpiler_Native_HAL.Emit_Raw ("  call ALB16_Print_S32", Success);
                           else
                              Transpiler_Native_HAL.Emit_Raw ("  call ALB16_Print_U32", Success);
                           end if;
                           Transpiler_Native_HAL.Emit_Newline (Success);

                           if Tree(Node).Right_Child = 0 then
                              Transpiler_Native_HAL.Emit_Raw ("  call ALB16_Print_Newline", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                           end if;
                        end if;

                        Transpiler_Native_HAL.Emit_Raw
                          (".ALB16_PRINT_SKIP_" & NID & ":", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                     end;

                  elsif Target = Backend_FASM then
                     -- DA NEW FIX: Temporal IO Suppressor!
                     declare
                        Img : constant String := Node_Index'Image (Node);
                        NID : constant String := Img (Img'First + 1 .. Img'Last);
                     begin
                        Transpiler_Native_HAL.Emit_Raw
                          ("  cmp qword [ALB_TEMP_Future_Suppress_IO], 0", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw
                          ("  jne .ALB_PRINT_SKIP_" & NID, Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);

                        -- 1. Walk the expression first tae compute the result intae 'rax'
                        Walk_AST (Expr_Node, Depth + 1, Out_Tag, Success, Diag);
                        
                        -- 2. Move the result frae 'rax' tae 'rdx' (Win64 ABI 2nd argument)
                        Transpiler_Native_HAL.Emit_Raw ("  mov rdx, rax", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        
                        -- 3. Invoke printf wi' the proper format string frae the Data Vault!
                        if PTag = Type_Binary then
                           if Tree(Node).Right_Child > 0 then
                              Transpiler_Native_HAL.Emit_Raw ("  invoke printf, ALB_Fmt_Str_Raw, rdx", Success);
                           else
                              Transpiler_Native_HAL.Emit_Raw ("  invoke printf, ALB_Fmt_Str, rdx", Success);
                           end if;
                        elsif PTag = Type_Pure then
                           -- Unpack the PURE fraction directly intae the printf registers!
                           Transpiler_Native_HAL.Emit_Raw ("  mov r8d, edx", Success); Transpiler_Native_HAL.Emit_Newline (Success);
                           Transpiler_Native_HAL.Emit_Raw ("  movsxd r8, r8d", Success); Transpiler_Native_HAL.Emit_Newline (Success);
                           Transpiler_Native_HAL.Emit_Raw ("  sar rdx, 32", Success); Transpiler_Native_HAL.Emit_Newline (Success);
                           Transpiler_Native_HAL.Emit_Raw ("  invoke printf, ALB_Fmt_Pure, rdx, r8", Success);
                        elsif PTag = Type_S32
                          or else PTag = Type_HW8
                          or else PTag = Type_HW16
                          or else PTag = Type_HW32
                          or else PTag = Type_HW64
                        then
                           if Tree(Node).Right_Child > 0 then
                              Transpiler_Native_HAL.Emit_Raw ("  invoke printf, ALB_Fmt_Signed_Raw, rdx", Success);
                           else
                              Transpiler_Native_HAL.Emit_Raw ("  invoke printf, ALB_Fmt_Signed, rdx", Success);
                           end if;
                        elsif PTag = Type_F64 then
                           Transpiler_Native_HAL.Emit_Raw ("  movq xmm0, rdx", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           if Tree(Node).Right_Child > 0 then
                              Transpiler_Native_HAL.Emit_Raw ("  invoke printf, ALB_Fmt_F64_Raw, xmm0", Success);
                           else
                              Transpiler_Native_HAL.Emit_Raw ("  invoke printf, ALB_Fmt_F64, xmm0", Success);
                           end if;
                        else
                           if Tree(Node).Right_Child > 0 then
                              Transpiler_Native_HAL.Emit_Raw ("  invoke printf, ALB_Fmt_Num_Raw, rdx", Success);
                           else
                              Transpiler_Native_HAL.Emit_Raw ("  invoke printf, ALB_Fmt_Num, rdx", Success);
                           end if;
                        end if;

                        Transpiler_Native_HAL.Emit_Newline (Success);

                        -- Landing Zone for the IO Suppressor
                        Transpiler_Native_HAL.Emit_Raw
                          (".ALB_PRINT_SKIP_" & NID & ":", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                     end;
                  else
                     if PTag = Type_Pure then
                        if Tree(Node).Right_Child > 0 then
                           Transpiler_Native_HAL.Emit_Raw ("ALB_PRINT_PURE_PIPED(", Success);
                        else
                           Transpiler_Native_HAL.Emit_Raw ("ALB_PRINT_PURE(", Success);
                        end if;
                        Walk_AST (Expr_Node, Depth + 1, Out_Tag, Success, Diag);
                        Transpiler_Native_HAL.Emit_Raw (");", Success);
                        if Tree(Node).Right_Child = 0 then
                           Transpiler_Native_HAL.Emit_Newline (Success);
                        end if;
                     else
                        Transpiler_Native_HAL.Emit_Print_Start (PTag, Tree(Node).Right_Child > 0, Success);
                        Walk_AST (Expr_Node, Depth + 1, Out_Tag, Success, Diag);
                        Transpiler_Native_HAL.Emit_Print_End (PTag, Tree(Node).Right_Child > 0, Success);
                        if Tree(Node).Right_Child = 0 then
                           Transpiler_Native_HAL.Emit_Newline (Success);
                        end if;
                     end if;
                  end if;
                  
                  -- DA FIX: Walk the rest of the pipe!
                  if Tree(Node).Right_Child > 0 then
                     Walk_AST(Tree(Node).Right_Child, Depth, Out_Tag, Success, Diag);
                  end if;
               end;
            
            when AST_Print_Str_Stmt =>
               if Target = Backend_FASM16 then
                  declare
                     Img : constant String := Node_Index'Image (Node);
                     NID : constant String := Img (Img'First + 1 .. Img'Last);
                  begin
                     Transpiler_Native_HAL.Emit_Raw
                       ("  cmp byte [ALB16_TEMP_Future_Suppress_IO], 0", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Emit_Raw
                       ("  jne .ALB16_PRINT_SKIP_" & NID, Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);

                     -- Raw string print: no automatic newline.
                     Walk_AST (Tree (Node).Left_Child, Depth + 1, Right_Tag, Success, Diag);

                     Transpiler_Native_HAL.Emit_Raw ("  call ALB16_Print_C_Str", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);

                     Transpiler_Native_HAL.Emit_Raw
                       (".ALB16_PRINT_SKIP_" & NID & ":", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                  end;

               elsif Target = Backend_FASM then
                  -- DA NEW FIX: Temporal IO Suppressor!
                  declare
                     Img : constant String := Node_Index'Image (Node);
                     NID : constant String := Img (Img'First + 1 .. Img'Last);
                  begin
                     Transpiler_Native_HAL.Emit_Raw
                       ("  cmp qword [ALB_TEMP_Future_Suppress_IO], 0", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Emit_Raw
                       ("  jne .ALB_PRINT_SKIP_" & NID, Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);

                     -- 1. Evaluate the string pointer intae 'rax'
                     Walk_AST (Tree (Node).Left_Child, Depth + 1, Right_Tag, Success, Diag);
                     
                     -- 2. Move tae 'rdx' an' print it!
                     Transpiler_Native_HAL.Emit_Raw ("  mov rdx, rax", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     
                     Transpiler_Native_HAL.Emit_Raw ("  invoke printf, ALB_Fmt_Str_Raw, rdx", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);

                     -- Landing Zone
                     Transpiler_Native_HAL.Emit_Raw
                       (".ALB_PRINT_SKIP_" & NID & ":", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                  end;
               else
                  Transpiler_Native_HAL.Emit_Print_Function_Start (Success);
                  Transpiler_Native_HAL.Emit_Raw ("""%s"", (char*)(uintptr_t)(", Success);
                  Walk_AST (Tree (Node).Left_Child, Depth + 1, Right_Tag, Success, Diag);
                  Transpiler_Native_HAL.Emit_Raw (")", Success);
                  
                  Transpiler_Native_HAL.Emit_Raw (");", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);
               end if;
               
               -- DA FIX: Walk the rest of the pipe!
               if Tree(Node).Right_Child > 0 then
                  Walk_AST(Tree(Node).Right_Child, Depth, Out_Tag, Success, Diag);
               end if;
               
             -- =============================================================
             -- NEW RUNTIME FEATURE BLOCKS: EXPORT_PPM, FITS_CUBE, INI_BIND,
             -- STREAM_BYPASS, MOUNT_ARCHIVE, SYNTH_BAKE
             -- =============================================================
             when AST_Export_PPM_Block =>
                declare
                   Surf_Node : Node_Index := Tree (Node).Left_Child;
                   File_Node : Node_Index := Tree (Node).Right_Child;
                   Fmt_Node  : Node_Index := 0;
                   Body_Node : Node_Index := 0;
                begin
                   if File_Node /= 0 then
                      Fmt_Node := Tree (File_Node).Next_Sibling;
                      if Fmt_Node /= 0 then
                         Body_Node := Tree (Fmt_Node).Next_Sibling;
                      end if;
                   end if;
                   Archive_Runtime_Used := True;
                   if Target = Backend_FASM then
                      Walk_AST (Surf_Node, Depth + 1, Left_Tag, Success, Diag);
                      if not Success then return; end if;
                       Transpiler_Native_HAL.Emit_Raw ("  mov [ALB_PPM_DataPtr], rax", Success);
                      Transpiler_Native_HAL.Emit_Newline (Success);
                      Walk_AST (File_Node, Depth + 1, Right_Tag, Success, Diag);
                      if not Success then return; end if;
                      Transpiler_Native_HAL.Emit_Raw ("  call ALB_PPM_Export", Success);
                      Transpiler_Native_HAL.Emit_Newline (Success);
                      if Body_Node /= 0 then
                         Walk_AST (Body_Node, Depth + 1, Out_Tag, Success, Diag);
                      end if;
                   elsif Target = Backend_C then
                      --  Track 8 (C): best-effort PPM emit.  We open the
                      --  file, write a P6 header for a 1x1 placeholder
                      --  (real surface metadata is not threaded through to
                      --  this AST yet) and let the user body run.  The
                      --  Surf_Node pointer is walked but discarded so the
                      --  variable still type-checks as referenced.
                      Transpiler_Native_HAL.Emit_Indent (Success);
                      Transpiler_Native_HAL.Emit_Raw ("{ ", Success);
                      Transpiler_Native_HAL.Emit_Raw
                        ("uint64_t alb_ppm_src = (uint64_t)(", Success);
                      Walk_AST (Surf_Node, Depth + 1, Left_Tag, Success, Diag);
                      if not Success then return; end if;
                      Transpiler_Native_HAL.Emit_Raw ("); ", Success);
                      Transpiler_Native_HAL.Emit_Raw
                        ("FILE* alb_ppm_fp = fopen((const char*)(uintptr_t)(", Success);
                      Walk_AST (File_Node, Depth + 1, Right_Tag, Success, Diag);
                      if not Success then return; end if;
                      Transpiler_Native_HAL.Emit_Raw ("), ""wb""); ", Success);
                      Transpiler_Native_HAL.Emit_Raw
                        ("if (alb_ppm_fp) { fputs(""P6\n1 1\n255\n"", alb_ppm_fp); " &
                         "fputc(0, alb_ppm_fp); fputc(0, alb_ppm_fp); fputc(0, alb_ppm_fp); " &
                         "fclose(alb_ppm_fp); } (void)alb_ppm_src; }",
                         Success);
                      Transpiler_Native_HAL.Emit_Newline (Success);
                      if Body_Node /= 0 then
                         Walk_AST (Body_Node, Depth + 1, Out_Tag, Success, Diag);
                      end if;
                   else
                      if Body_Node /= 0 then
                         Walk_AST (Body_Node, Depth + 1, Out_Tag, Success, Diag);
                      end if;
                   end if;
                   Out_Tag := Type_None;
                end;

               when AST_Fits_Cube_Block =>
                  declare
                     Surf_Node     : Node_Index := Tree (Node).Left_Child;
                     Path_Node     : Node_Index := Tree (Node).Right_Child;
                     Body_Node     : Node_Index := 0;
                     Fallback_Node : Node_Index := 0;
                  begin
                     if Path_Node /= 0 then
                        Body_Node := Tree (Path_Node).Next_Sibling;
                        if Body_Node /= 0 then
                           Fallback_Node := Tree (Body_Node).Next_Sibling;
                        end if;
                     end if;
                     if Target = Backend_FASM then
                        declare
                           Img : constant String := Node_Index'Image (Node);
                           NID : constant String := Img (Img'First + 1 .. Img'Last);
                        begin
                           FITS_Runtime_Used := True;
                           declare
                              S_Lex  : constant String :=
                                Raw_Lexeme (Tree (Surf_Node).Token_Index);
                              T_Lex  : constant String := Scoped_Lexeme (S_Lex);
                              A_Idx  : constant Natural := Find_Strict_Array (T_Lex);
                              Elem_T : ALB_Type_Tag := Type_None;
                              Payload_Bytes : Natural := 0;
                              Store_Stride  : Natural := 8;
                           begin
                              if A_Idx = 0 then
                                 Fail_Node
                                   (Surf_Node,
                                    Err_Compiler_AST_Mismatch,
                                    "FITS_CUBE requires a STRICT array target",
                                    Success, Diag);
                                 return;
                              end if;

                              Elem_T :=
                                Array_Declared_Tag
                                  (T_Lex, Strict_Arrays (A_Idx).Element_Tag);
                              Payload_Bytes :=
                                Strict_Array_Total_Elements (A_Idx) * 4;
                              Store_Stride := 8;

                              Emit_FASM_Array_Data_Address
                                (T_Lex, Elem_T, "rax", Success);
                              if not Success then return; end if;
                              Transpiler_Native_HAL.Emit_Raw
                                ("  mov [ALB_FITS_DataPtr], rax", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw
                                ("  mov qword [ALB_FITS_DataSize], " &
                                 Nat_Img (Payload_Bytes), Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw
                                ("  mov qword [ALB_FITS_ExpDim1], " &
                                 Nat_Img (Strict_Arrays (A_Idx).Dims (1)),
                                 Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw
                                ("  mov qword [ALB_FITS_ExpDim2], " &
                                 (if Strict_Arrays (A_Idx).Dim_Count >= 2
                                  then Nat_Img (Strict_Arrays (A_Idx).Dims (2))
                                  else "1"), Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw
                                ("  mov qword [ALB_FITS_ExpDim3], " &
                                 (if Strict_Arrays (A_Idx).Dim_Count >= 3
                                  then Nat_Img (Strict_Arrays (A_Idx).Dims (3))
                                  else "1"), Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw
                                ("  mov qword [ALB_FITS_ExpDimCount], " &
                                 Nat_Img (Strict_Arrays (A_Idx).Dim_Count),
                                 Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw
                                ("  mov qword [ALB_FITS_ExpElemBytes], " &
                                 Nat_Img (Store_Stride), Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                           end;
                           Walk_AST
                             (Path_Node, Depth + 1, Right_Tag, Success, Diag);
                           if not Success then return; end if;
                           Transpiler_Native_HAL.Emit_Raw
                             ("  mov rcx, rax", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Transpiler_Native_HAL.Emit_Raw
                             ("  call ALB_FITS_Load", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Transpiler_Native_HAL.Emit_Raw
                             ("  test rax, rax", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Transpiler_Native_HAL.Emit_Raw
                             ("  jz .ALB_FITS_FAIL_" & NID, Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           if Body_Node /= 0 then
                              Walk_AST
                                (Body_Node, Depth + 1, Out_Tag, Success, Diag);
                           end if;
                           Transpiler_Native_HAL.Emit_Raw
                             ("  jmp .ALB_FITS_EXIT_" & NID, Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Transpiler_Native_HAL.Emit_Raw
                             (".ALB_FITS_FAIL_" & NID & ":", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           if Fallback_Node /= 0 then
                              Walk_AST
                                (Fallback_Node, Depth + 1, Out_Tag,
                                 Success, Diag);
                           end if;
                           Transpiler_Native_HAL.Emit_Raw
                             (".ALB_FITS_EXIT_" & NID & ":", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                        end;
                     elsif Target = Backend_C then
                        -- =============================================
                        -- Track 2 (C): FITS_CUBE runtime + dispatch
                        -- =============================================
                        if not Fits_Runtime_Emitted_C then
                           Emit_Global_Line ("/* ALB FITS runtime (C backend, Track 2) */");
                           Emit_Global_Line ("static uint64_t ALB_FITS_Load_Cube(uint64_t path_u64, void* base,");
                           Emit_Global_Line ("                                   uint64_t d1, uint64_t d2, uint64_t d3,");
                           Emit_Global_Line ("                                   uint64_t s1, uint64_t s2, uint64_t s3) {");
                           Emit_Global_Line ("    const char* path = (const char*)(uintptr_t)path_u64;");
                           Emit_Global_Line ("    FILE* fp = fopen(path, ""rb"");");
                           Emit_Global_Line ("    if (!fp) { fprintf(stderr, ""[FITS] open FAIL %s\n"", path); return 0; }");
                           Emit_Global_Line ("    char hdr[2880];");
                           Emit_Global_Line ("    long header_blocks = 0;");
                           Emit_Global_Line ("    int found_end = 0;");
                           Emit_Global_Line ("    long bitpix = 0, naxis = 0;");
                           Emit_Global_Line ("    long axis_dims[4] = {0,0,0,0};");
                           Emit_Global_Line ("    while (!found_end) {");
                           Emit_Global_Line ("        if (fread(hdr, 1, 2880, fp) != 2880) { fclose(fp); fprintf(stderr, ""[FITS] short header\n""); return 0; }");
                           Emit_Global_Line ("        header_blocks++;");
                           Emit_Global_Line ("        for (int r = 0; r < 36; r++) {");
                           Emit_Global_Line ("            const char* rec = &hdr[r * 80];");
                           Emit_Global_Line ("            if (memcmp(rec, ""END     "", 8) == 0) { found_end = 1; break; }");
                           Emit_Global_Line ("            if (memcmp(rec, ""BITPIX  "", 8) == 0) bitpix = atol(rec + 10);");
                           Emit_Global_Line ("            else if (memcmp(rec, ""NAXIS   "", 8) == 0) naxis = atol(rec + 10);");
                           Emit_Global_Line ("            else if (memcmp(rec, ""NAXIS1  "", 8) == 0) axis_dims[0] = atol(rec + 10);");
                           Emit_Global_Line ("            else if (memcmp(rec, ""NAXIS2  "", 8) == 0) axis_dims[1] = atol(rec + 10);");
                           Emit_Global_Line ("            else if (memcmp(rec, ""NAXIS3  "", 8) == 0) axis_dims[2] = atol(rec + 10);");
                           Emit_Global_Line ("        }");
                           Emit_Global_Line ("    }");
                           Emit_Global_Line ("    if (bitpix != -32) { fclose(fp); fprintf(stderr, ""[FITS] BITPIX %ld unsupported\n"", bitpix); return 0; }");
                           Emit_Global_Line ("    if ((uint64_t)naxis != ((d3 > 1) ? 3 : ((d2 > 1) ? 2 : 1))) {");
                           Emit_Global_Line ("        fprintf(stderr, ""[FITS] NAXIS %ld mismatch\n"", naxis);");
                           Emit_Global_Line ("    }");
                           Emit_Global_Line ("    uint64_t n_pixels = d1 * (d2 ? d2 : 1) * (d3 ? d3 : 1);");
                           Emit_Global_Line ("    uint64_t dd2 = d2 ? d2 : 1;");
                           Emit_Global_Line ("    uint64_t dd3 = d3 ? d3 : 1;");
                           Emit_Global_Line ("    uint8_t* base_b = (uint8_t*)base;");
                           Emit_Global_Line ("    for (uint64_t i = 0; i < n_pixels; i++) {");
                           Emit_Global_Line ("        uint32_t raw = 0;");
                           Emit_Global_Line ("        if (fread(&raw, 1, 4, fp) != 4) { fclose(fp); fprintf(stderr, ""[FITS] short data @ %llu\n"", (unsigned long long)i); return 0; }");
                           Emit_Global_Line ("        uint32_t sw = ((raw >> 24) & 0xff) | ((raw >> 8) & 0xff00) |");
                           Emit_Global_Line ("                      ((raw <<  8) & 0xff0000) | ((raw << 24) & 0xff000000);");
                           Emit_Global_Line ("        float val;");
                           Emit_Global_Line ("        memcpy(&val, &sw, 4);");
                           Emit_Global_Line ("        int g = (int)(val * 255.0f);");
                           Emit_Global_Line ("        if (g < 0) g = 0; if (g > 255) g = 255;");
                           Emit_Global_Line ("        /* Mirror FASM flat-write semantics: map sequential file pixel i");
                           Emit_Global_Line ("           into ALB array index (a, b, c) where dim3 varies fastest. */");
                           Emit_Global_Line ("        uint64_t c_idx = i % dd3;");
                           Emit_Global_Line ("        uint64_t b_idx = (i / dd3) % dd2;");
                           Emit_Global_Line ("        uint64_t a_idx = i / (dd2 * dd3);");
                           Emit_Global_Line ("        uint64_t off = (a_idx + 1) * s1 + (b_idx + 1) * s2 + (c_idx + 1) * s3;");
                           Emit_Global_Line ("        *(uint64_t*)(base_b + off) = (uint64_t)g;");
                           Emit_Global_Line ("    }");
                           Emit_Global_Line ("    fclose(fp);");
                           Emit_Global_Line ("    fprintf(stderr, ""[FITS] OK n=%llu dims=%ldx%ldx%ld\n"",");
                           Emit_Global_Line ("            (unsigned long long)n_pixels, axis_dims[0], axis_dims[1], axis_dims[2]);");
                           Emit_Global_Line ("    return 1;");
                           Emit_Global_Line ("}");
                           Fits_Runtime_Emitted_C := True;
                        end if;

                        -- Look up the strict array's dims to compute
                        -- byte strides for the C multi-dim layout
                        -- `<name>[(D1+1)][(D2+1)][(D3+1)]`.
                        declare
                           S_Lex : constant String :=
                             Raw_Lexeme (Tree (Surf_Node).Token_Index);
                           T_Lex : constant String := Scoped_Lexeme (S_Lex);
                           A_Idx : constant Natural :=
                             Find_Strict_Array (T_Lex);
                           D1, D2, D3 : Natural := 0;
                           D_Count    : Natural := 0;
                           S1, S2, S3 : Natural := 0;
                           Base_Expr  : String (1 .. 256) := (others => ' ');
                           Base_Len   : Natural := 0;
                        begin
                           if A_Idx = 0 then
                              Fail_Node
                                (Surf_Node,
                                 Err_Compiler_AST_Mismatch,
                                 "FITS_CUBE requires a STRICT array target",
                                 Success, Diag);
                              return;
                           end if;

                           D_Count := Strict_Arrays (A_Idx).Dim_Count;
                           D1 := Strict_Arrays (A_Idx).Dims (1);
                           if D_Count >= 2 then
                              D2 := Strict_Arrays (A_Idx).Dims (2);
                           else
                              D2 := 1;
                           end if;
                           if D_Count >= 3 then
                              D3 := Strict_Arrays (A_Idx).Dims (3);
                           else
                              D3 := 1;
                           end if;

                           -- Strides in bytes for the C multi-dim layout.
                           if D_Count = 1 then
                              S1 := 8;     S2 := 0; S3 := 0;
                           elsif D_Count = 2 then
                              S1 := (D2 + 1) * 8;
                              S2 := 8;
                              S3 := 0;
                           else
                              S1 := (D2 + 1) * (D3 + 1) * 8;
                              S2 := (D3 + 1) * 8;
                              S3 := 8;
                           end if;

                           -- Build a "(void*)&<name>[0][0][0]" expression
                           -- with the right number of [0] subscripts.
                           declare
                              Pref : constant String := "(void*)" & T_Lex;
                              Subs : constant String :=
                                (case D_Count is
                                   when 1 => "",
                                   when 2 => "",
                                   when others => "");
                              -- Just pass the array name; in C
                              -- multi-dim arrays decay to a pointer to
                              -- the first row, and our base_b uint8_t*
                              -- arithmetic works from there.
                           begin
                              Base_Expr (1 .. Pref'Length + Subs'Length) :=
                                Pref & Subs;
                              Base_Len := Pref'Length + Subs'Length;
                           end;

                           -- Emit the call: defaults to FALLBACK on fail.
                           Transpiler_Native_HAL.Emit_Raw
                             ("if (ALB_FITS_Load_Cube(", Success);
                           Walk_AST (Path_Node, Depth + 1, Right_Tag,
                                     Success, Diag);
                           if not Success then return; end if;
                           Transpiler_Native_HAL.Emit_Raw
                             (", " & Base_Expr (1 .. Base_Len) &
                              ", " & Nat_Img (D1) &
                              ", " & Nat_Img (D2) &
                              ", " & Nat_Img (D3) &
                              ", " & Nat_Img (S1) &
                              ", " & Nat_Img (S2) &
                              ", " & Nat_Img (S3) & ") > 0) {",
                              Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Transpiler_Native_HAL.Increase_Indent;
                           if Body_Node /= 0 then
                              Walk_AST
                                (Body_Node, Depth + 1, Out_Tag,
                                 Success, Diag);
                              if not Success then return; end if;
                           end if;
                           Transpiler_Native_HAL.Decrease_Indent;
                           Transpiler_Native_HAL.Emit_Raw ("} else {", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Transpiler_Native_HAL.Increase_Indent;
                           if Fallback_Node /= 0 then
                              Walk_AST
                                (Fallback_Node, Depth + 1, Out_Tag,
                                 Success, Diag);
                              if not Success then return; end if;
                           end if;
                           Transpiler_Native_HAL.Decrease_Indent;
                           Transpiler_Native_HAL.Emit_Raw ("}", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                        end;
                     else
                        if Body_Node /= 0 then
                           Walk_AST
                             (Body_Node, Depth + 1, Out_Tag, Success, Diag);
                        end if;
                        if Fallback_Node /= 0 then
                           Walk_AST
                             (Fallback_Node, Depth + 1, Out_Tag,
                              Success, Diag);
                        end if;
                     end if;
                     Out_Tag := Type_None;
                  end;

              when AST_Ini_Bind_Block =>
                declare
                   Tgt_Node      : Node_Index := Tree (Node).Left_Child;
                   pragma Unreferenced (Tgt_Node);
                   Path_Node     : Node_Index := Tree (Node).Right_Child;
                   Body_Node     : Node_Index := 0;
                   Fallback_Node : Node_Index := 0;
                   NID_Img       : constant String := Node_Index'Image (Node);
                   NID           : constant String :=
                     NID_Img (NID_Img'First + 1 .. NID_Img'Last);
                   Fail_Label    : constant String :=
                     ".ALB_INI_FAIL_" & NID;
                   Exit_Label    : constant String :=
                     ".ALB_INI_EXIT_" & NID;
                   Table_Label   : constant String :=
                     "ALB_INI_Table_" & NID;
                begin
                   if Path_Node /= 0 then
                      Body_Node := Tree (Path_Node).Next_Sibling;
                      if Body_Node /= 0 then
                         Fallback_Node := Tree (Body_Node).Next_Sibling;
                      end if;
                   end if;

                   if Target = Backend_FASM then
                      INI_Runtime_Used := True;

                      -- ===== Pre-scan body for top-level LET statements
                      -- Each LET <var> = <default> registers <var> as
                      -- an INI key and its storage label as the field
                      -- destination. Keys are emitted lowercase to match
                      -- the case-insensitive line-side fold in
                      -- ALB_INI_Parse.
                      declare
                         Stmt_Cursor : Node_Index := 0;
                         Field_Index : Natural := 0;
                      begin
                         if Body_Node /= 0 then
                            Stmt_Cursor := Tree (Body_Node).Left_Child;
                         end if;

                         while Stmt_Cursor /= 0 loop
                            if Tree (Stmt_Cursor).Kind = AST_Let_Stmt then
                               declare
                                  Tgt   : Node_Index :=
                                    Tree (Stmt_Cursor).Left_Child;
                                  T_Tok : Token;
                                  V_Lex : String (1 .. 128) := (others => ' ');
                                  V_Len : Natural := 0;
                                  Key_Label : constant String :=
