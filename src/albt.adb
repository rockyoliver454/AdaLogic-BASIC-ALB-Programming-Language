         procedure Emit_FASM_Temporal_Future_To_RAX
           (Target_Name : in String;
            Target_Tag  : in ALB_Type_Tag;
            Origin_Node : in Node_Index;
            Success     : in out Boolean;
            Diag        : in out Compiler_Diagnostic)
         is
