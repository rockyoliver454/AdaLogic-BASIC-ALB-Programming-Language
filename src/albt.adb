            Emit_Main_Line ("  mov rcx, rax");
            Emit_Main_Line ("  call ALB_PROC_Is_Owned_Handle");
            Emit_Main_Line ("  test eax, eax");
            Emit_Main_Line ("  jz .alb_proc_term_done");
            Emit_Main_Line ("  mov rcx, qword [rsp + 56]");
            Emit_Main_Line ("  xor edx, edx");
            Emit_Main_Line ("  call qword [TerminateProcess]");
            Emit_Main_Line ("  mov rcx, qword [rsp + 56]");
            Emit_Main_Line ("  call ALB_PROC_Unregister_Child");
            Emit_Main_Line ("  mov rcx, qword [rsp + 56]");
            Emit_Main_Line ("  call qword [CloseHandle]");
            Emit_Main_Line ("  mov rcx, qword [rsp + 48]");
            Emit_Main_Line ("  mov qword [rcx], 0");
            Emit_Main_Line (".alb_proc_term_done:");
            Emit_Main_Line ("  add rsp, 72");
            Emit_Main_Line ("  ret");
            Emit_Main_Line ("");

            Emit_Main_Line ("ALB_PROC_Dump:");
            Emit_Main_Line ("  mov r10, qword [rsp + 40]");
            Emit_Main_Line ("  mov r11, qword [rsp + 48]");
            Emit_Main_Line ("  mov r12, qword [rsp + 56]");
            Emit_Main_Line ("  push rbx");
            Emit_Main_Line ("  push r12");
            Emit_Main_Line ("  push r13");
            Emit_Main_Line ("  push r14");
            Emit_Main_Line ("  push r15");
            Emit_Main_Line ("  sub rsp, 112");
            Emit_Main_Line ("  mov qword [rsp + 80], r10");
            Emit_Main_Line ("  mov qword [rsp + 88], r11");
            Emit_Main_Line ("  mov qword [rsp + 96], r12");
            Emit_Main_Line ("  call ALB_PROC_Resolve_Handle");
            Emit_Main_Line ("  test rax, rax");
            Emit_Main_Line ("  jz .alb_proc_dump_fail");
            Emit_Main_Line ("  mov r15, rax");
            Emit_Main_Line ("  mov rcx, qword [rsp + 96]");
            Emit_Main_Line ("  mov edx, 40000000h");
            Emit_Main_Line ("  xor r8d, r8d");
            Emit_Main_Line ("  xor r9d, r9d");
            Emit_Main_Line ("  mov qword [rsp + 32], 2");
            Emit_Main_Line ("  mov qword [rsp + 40], 80h");
            Emit_Main_Line ("  mov qword [rsp + 48], 0");
            Emit_Main_Line ("  call qword [CreateFileA]");
            Emit_Main_Line ("  cmp rax, -1");
            Emit_Main_Line ("  je .alb_proc_dump_fail");
            Emit_Main_Line ("  mov r14, rax");
            Emit_Main_Line ("  mov r13, qword [rsp + 80]");
            Emit_Main_Line ("  mov r12, qword [rsp + 88]");
            Emit_Main_Line (".alb_proc_dump_loop:");
            Emit_Main_Line ("  test r12, r12");
            Emit_Main_Line ("  jz .alb_proc_dump_ok");
            Emit_Main_Line ("  mov rbx, r12");
            Emit_Main_Line ("  cmp rbx, 4096");
            Emit_Main_Line ("  jbe .alb_proc_dump_size_ready");
            Emit_Main_Line ("  mov rbx, 4096");
            Emit_Main_Line (".alb_proc_dump_size_ready:");
            Emit_Main_Line ("  mov rcx, r15");
            Emit_Main_Line ("  mov rdx, r13");
            Emit_Main_Line ("  lea r8, [ALB_PROC_File_Buffer]");
            Emit_Main_Line ("  mov r9, rbx");
            Emit_Main_Line ("  lea r10, [rsp + 56]");
            Emit_Main_Line ("  mov qword [rsp + 32], r10");
            Emit_Main_Line ("  call qword [ReadProcessMemory]");
            Emit_Main_Line ("  test eax, eax");
            Emit_Main_Line ("  jz .alb_proc_dump_close_fail");
            Emit_Main_Line ("  mov rbx, qword [rsp + 56]");
            Emit_Main_Line ("  test rbx, rbx");
            Emit_Main_Line ("  jz .alb_proc_dump_close_fail");
            Emit_Main_Line ("  mov rcx, r14");
            Emit_Main_Line ("  lea rdx, [ALB_PROC_File_Buffer]");
            Emit_Main_Line ("  mov r8d, ebx");
            Emit_Main_Line ("  lea r9, [rsp + 64]");
            Emit_Main_Line ("  mov qword [rsp + 32], 0");
            Emit_Main_Line ("  call qword [WriteFile]");
            Emit_Main_Line ("  test eax, eax");
            Emit_Main_Line ("  jz .alb_proc_dump_close_fail");
            Emit_Main_Line ("  add r13, rbx");
            Emit_Main_Line ("  sub r12, rbx");
            Emit_Main_Line ("  jmp .alb_proc_dump_loop");
            Emit_Main_Line (".alb_proc_dump_ok:");
            Emit_Main_Line ("  mov rcx, r14");
            Emit_Main_Line ("  call qword [CloseHandle]");
            Emit_Main_Line ("  mov eax, 1");
            Emit_Main_Line ("  jmp .alb_proc_dump_done");
            Emit_Main_Line (".alb_proc_dump_close_fail:");
            Emit_Main_Line ("  mov rcx, r14");
            Emit_Main_Line ("  call qword [CloseHandle]");
            Emit_Main_Line (".alb_proc_dump_fail:");
            Emit_Main_Line ("  xor eax, eax");
            Emit_Main_Line (".alb_proc_dump_done:");
            Emit_Main_Line ("  add rsp, 112");
            Emit_Main_Line ("  pop r15");
            Emit_Main_Line ("  pop r14");
            Emit_Main_Line ("  pop r13");
            Emit_Main_Line ("  pop r12");
            Emit_Main_Line ("  pop rbx");
            Emit_Main_Line ("  ret");
            Emit_Main_Line ("");

            Emit_Main_Line ("ALB_FILE_XOR_Transform:");
            Emit_Main_Line ("  push rbx");
            Emit_Main_Line ("  push r12");
            Emit_Main_Line ("  push r13");
            Emit_Main_Line ("  push r14");
            Emit_Main_Line ("  push r15");
            Emit_Main_Line ("  sub rsp, 120");
            Emit_Main_Line ("  mov qword [rsp + 80], rcx");
            Emit_Main_Line ("  mov qword [rsp + 88], rdx");
            Emit_Main_Line ("  mov qword [rsp + 96], r8");
            Emit_Main_Line ("  mov qword [rsp + 104], r9");
            Emit_Main_Line ("  mov rcx, qword [rsp + 80]");
            Emit_Main_Line ("  mov edx, 80000000h");
            Emit_Main_Line ("  xor r8d, r8d");
            Emit_Main_Line ("  xor r9d, r9d");
            Emit_Main_Line ("  mov qword [rsp + 32], 3");
            Emit_Main_Line ("  mov qword [rsp + 40], 80h");
            Emit_Main_Line ("  mov qword [rsp + 48], 0");
            Emit_Main_Line ("  call qword [CreateFileA]");
            Emit_Main_Line ("  cmp rax, -1");
            Emit_Main_Line ("  je .alb_file_xor_fail");
            Emit_Main_Line ("  mov r14, rax");
            Emit_Main_Line ("  mov rcx, qword [rsp + 104]");
            Emit_Main_Line ("  mov edx, 40000000h");
            Emit_Main_Line ("  xor r8d, r8d");
            Emit_Main_Line ("  xor r9d, r9d");
            Emit_Main_Line ("  mov qword [rsp + 32], 2");
            Emit_Main_Line ("  mov qword [rsp + 40], 80h");
            Emit_Main_Line ("  mov qword [rsp + 48], 0");
            Emit_Main_Line ("  call qword [CreateFileA]");
            Emit_Main_Line ("  cmp rax, -1");
            Emit_Main_Line ("  je .alb_file_xor_close_in_fail");
            Emit_Main_Line ("  mov r15, rax");
            Emit_Main_Line ("  mov r13, qword [rsp + 88]");
            Emit_Main_Line ("  mov r12, qword [rsp + 96]");
            Emit_Main_Line ("  test r12, r12");
            Emit_Main_Line ("  jnz .alb_file_xor_key_ready");
            Emit_Main_Line ("  test r13, r13");
            Emit_Main_Line ("  jz .alb_file_xor_key_ready");
            Emit_Main_Line ("  mov rcx, r13");
            Emit_Main_Line ("  call ALB_PROC_StrLen");
            Emit_Main_Line ("  mov r12, rax");
            Emit_Main_Line (".alb_file_xor_key_ready:");
            Emit_Main_Line ("  xor ebx, ebx");
            Emit_Main_Line (".alb_file_xor_loop:");
            Emit_Main_Line ("  mov rcx, r14");
            Emit_Main_Line ("  lea rdx, [ALB_PROC_File_Buffer]");
            Emit_Main_Line ("  mov r8d, 4096");
            Emit_Main_Line ("  lea r9, [rsp + 8]");
            Emit_Main_Line ("  mov qword [rsp + 32], 0");
            Emit_Main_Line ("  call qword [ReadFile]");
            Emit_Main_Line ("  test eax, eax");
            Emit_Main_Line ("  jz .alb_file_xor_close_fail");
            Emit_Main_Line ("  mov r11, qword [rsp + 8]");
            Emit_Main_Line ("  test r11, r11");
            Emit_Main_Line ("  jz .alb_file_xor_ok");
            Emit_Main_Line ("  test r12, r12");
            Emit_Main_Line ("  jz .alb_file_xor_write");
            Emit_Main_Line ("  xor r10, r10");
            Emit_Main_Line (".alb_file_xor_byte_loop:");
            Emit_Main_Line ("  cmp r10, r11");
            Emit_Main_Line ("  jae .alb_file_xor_write");
            Emit_Main_Line ("  mov al, byte [ALB_PROC_File_Buffer + r10]");
            Emit_Main_Line ("  xor al, byte [r13 + rbx]");
            Emit_Main_Line ("  mov byte [ALB_PROC_File_Buffer + r10], al");
            Emit_Main_Line ("  inc rbx");
            Emit_Main_Line ("  cmp rbx, r12");
            Emit_Main_Line ("  jb .alb_file_xor_key_keep");
            Emit_Main_Line ("  xor ebx, ebx");
            Emit_Main_Line (".alb_file_xor_key_keep:");
            Emit_Main_Line ("  inc r10");
            Emit_Main_Line ("  jmp .alb_file_xor_byte_loop");
            Emit_Main_Line (".alb_file_xor_write:");
            Emit_Main_Line ("  mov rcx, r15");
            Emit_Main_Line ("  lea rdx, [ALB_PROC_File_Buffer]");
            Emit_Main_Line ("  mov r8d, r11d");
            Emit_Main_Line ("  lea r9, [rsp + 16]");
            Emit_Main_Line ("  mov qword [rsp + 32], 0");
            Emit_Main_Line ("  call qword [WriteFile]");
            Emit_Main_Line ("  test eax, eax");
            Emit_Main_Line ("  jz .alb_file_xor_close_fail");
            Emit_Main_Line ("  jmp .alb_file_xor_loop");
            Emit_Main_Line (".alb_file_xor_ok:");
            Emit_Main_Line ("  mov rcx, r15");
            Emit_Main_Line ("  call qword [CloseHandle]");
            Emit_Main_Line ("  mov rcx, r14");
            Emit_Main_Line ("  call qword [CloseHandle]");
            Emit_Main_Line ("  mov eax, 1");
            Emit_Main_Line ("  jmp .alb_file_xor_done");
            Emit_Main_Line (".alb_file_xor_close_in_fail:");
            Emit_Main_Line ("  mov rcx, r14");
            Emit_Main_Line ("  call qword [CloseHandle]");
            Emit_Main_Line ("  jmp .alb_file_xor_fail");
            Emit_Main_Line (".alb_file_xor_close_fail:");
            Emit_Main_Line ("  mov rcx, r15");
            Emit_Main_Line ("  call qword [CloseHandle]");
            Emit_Main_Line ("  mov rcx, r14");
            Emit_Main_Line ("  call qword [CloseHandle]");
            Emit_Main_Line (".alb_file_xor_fail:");
            Emit_Main_Line ("  xor eax, eax");
            Emit_Main_Line (".alb_file_xor_done:");
            Emit_Main_Line ("  add rsp, 120");
            Emit_Main_Line ("  pop r15");
            Emit_Main_Line ("  pop r14");
            Emit_Main_Line ("  pop r13");
            Emit_Main_Line ("  pop r12");
            Emit_Main_Line ("  pop rbx");
            Emit_Main_Line ("  ret");
            Emit_Main_Line ("");
         end if;

         if FASM_Exports_Used and then Foreign_Export_Count > 0 then
            Emit_Main_Line ("section '.edata' export data readable");
            Emit_Main_Line ("  export '" & FASM_Export_Image_Name & "',\");
            for I in 1 .. Foreign_Export_Count loop
               declare
                  Export_Name : constant String :=
                    Foreign_Exports (I).Name (1 .. Foreign_Exports (I).Name_Len);
                  Tail : constant String :=
                    (if I < Foreign_Export_Count then ",\" else "");
               begin
                  Emit_Main_Line ("         " & Export_Name & ",'" & Export_Name & "'" & Tail);
               end;
            end loop;
            Emit_Main_Line ("");
            Emit_Main_Line ("section '.text' code readable executable");
            Emit_Main_Line ("");
         end if;

          -- ========================================================
          -- INI_BIND: struct-field metadata + runtime parser
          -- Task A5a: extracted into Emit_INI_Runtime.  Data labels
          -- (incl. the 64 KiB scratch buffer) now go to Buffer_Global
          -- so .text no longer carries 64 KiB of zero padding.
          -- ========================================================
          if INI_Runtime_Used then
             declare
                INI_OK : Boolean := True;
             begin
                Emit_Native_FASM.Emit_INI_Runtime (INI_OK);
             end;
          end if;

          -- ========================================================
          -- EXPORT_PPM: bulk write from surface metadata
          -- ========================================================
          if Archive_Runtime_Used then
             Emit_Main_Line ("ALB_PPM_TempName db '~alb_export.ppm',0");
             Emit_Main_Line ("ALB_PPM_FinalName db 'export.ppm',0");
             Emit_Main_Line ("ALB_PPM_Header rb 128");
             Emit_Main_Line ("ALB_PPM_DataPtr dq 0");
             Emit_Main_Line ("ALB_PPM_DataSize dq 0");
             Emit_Main_Line ("  jmp ALB_PPM_DONE");
             Emit_Main_Line ("ALB_PPM_Export:");
             Emit_Main_Line ("  push rbx");
             Emit_Main_Line ("  push rdi");
             Emit_Main_Line ("  ; Build PPM header (P6 format)");
             Emit_Main_Line ("  mov rdi, ALB_PPM_Header");
             Emit_Main_Line ("  mov word [rdi], 'P' + ('6' shl 8)");
             Emit_Main_Line ("  add rdi, 2");
             Emit_Main_Line ("  mov byte [rdi], 10");
             Emit_Main_Line ("  inc rdi");
             Emit_Main_Line ("  ; Write temp file, then rename");
             Emit_Main_Line ("  invoke fopen, ALB_PPM_TempName, 'wb'");
             Emit_Main_Line ("  test rax, rax");
             Emit_Main_Line ("  jz ALB_PPM_Exit");
             Emit_Main_Line ("  mov rbx, rax");
              Emit_Main_Line ("  sub rdi, ALB_PPM_Header");
              Emit_Main_Line ("  invoke fwrite, ALB_PPM_Header, 1, rdi, rbx");
             Emit_Main_Line ("  mov rcx, [ALB_PPM_DataPtr]");
             Emit_Main_Line ("  mov rdx, [ALB_PPM_DataSize]");
             Emit_Main_Line ("  invoke fwrite, rcx, 1, rdx, rbx");
             Emit_Main_Line ("  invoke fclose, rbx");
             Emit_Main_Line ("  invoke rename, ALB_PPM_TempName, ALB_PPM_FinalName");
             Emit_Main_Line ("ALB_PPM_Exit:");
             Emit_Main_Line ("  pop rdi");
             Emit_Main_Line ("  pop rbx");
             Emit_Main_Line ("  ret");
             Emit_Main_Line ("ALB_PPM_DONE:");
          end if;

           -- ========================================================
           -- STREAM_BYPASS: mapped-file + aligned SSE2 non-temporal copy
          -- ========================================================
          if Stream_Bypass_Runtime_Used then
             Emit_Main_Line ("ALB_STREAM_Src dq 0");
             Emit_Main_Line ("ALB_STREAM_Dst dq 0");
             Emit_Main_Line ("ALB_STREAM_Len dq 0");
             Emit_Main_Line ("  jmp ALB_STREAM_DONE");
             Emit_Main_Line ("ALB_STREAM_Copy:");
             Emit_Main_Line ("  push rbx");
             Emit_Main_Line ("  push rdi");
             Emit_Main_Line ("  push rsi");
              Emit_Main_Line ("  mov rsi, [ALB_STREAM_Src]");
              Emit_Main_Line ("  mov rdi, [ALB_STREAM_Dst]");
              Emit_Main_Line ("  mov rcx, [ALB_STREAM_Len]");
              Emit_Main_Line ("  ; null pointer guard");
              Emit_Main_Line ("  test rsi, rsi");
              Emit_Main_Line ("  jz ALB_STREAM_Done");
              Emit_Main_Line ("  test rdi, rdi");
              Emit_Main_Line ("  jz ALB_STREAM_Done");
              Emit_Main_Line ("  ; aligned SSE2 non-temporal fast path");
             Emit_Main_Line ("  test rsi, 15");
             Emit_Main_Line ("  jnz ALB_STREAM_Buffered");
             Emit_Main_Line ("  test rdi, 15");
             Emit_Main_Line ("  jnz ALB_STREAM_Buffered");
             Emit_Main_Line ("  cmp rcx, 128");
             Emit_Main_Line ("  jb ALB_STREAM_Buffered");
             Emit_Main_Line ("ALB_STREAM_SSE2:");
             Emit_Main_Line ("  cmp rcx, 16");
             Emit_Main_Line ("  jb ALB_STREAM_Done");
             Emit_Main_Line ("  movdqa xmm0, [rsi]");
             Emit_Main_Line ("  movntdq [rdi], xmm0");
             Emit_Main_Line ("  add rsi, 16");
             Emit_Main_Line ("  add rdi, 16");
             Emit_Main_Line ("  sub rcx, 16");
             Emit_Main_Line ("  jmp ALB_STREAM_SSE2");
             Emit_Main_Line ("ALB_STREAM_Buffered:");
             Emit_Main_Line ("  cmp rcx, 0");
             Emit_Main_Line ("  je ALB_STREAM_Done");
             Emit_Main_Line ("  mov al, [rsi]");
             Emit_Main_Line ("  mov [rdi], al");
             Emit_Main_Line ("  inc rsi");
             Emit_Main_Line ("  inc rdi");
             Emit_Main_Line ("  dec rcx");
             Emit_Main_Line ("  jmp ALB_STREAM_Buffered");
             Emit_Main_Line ("ALB_STREAM_Done:");
             Emit_Main_Line ("  pop rsi");
             Emit_Main_Line ("  pop rdi");
             Emit_Main_Line ("  pop rbx");
             Emit_Main_Line ("  ret");
              Emit_Main_Line ("ALB_STREAM_DONE:");
           end if;

           -- ========================================================
           -- FITS_CUBE: FITS file loader
           -- ========================================================
           if FITS_Runtime_Used then
              Emit_Native_FASM.Emit_FITS_Runtime (Emit_Success);
              if not Emit_Success then
                 Success := False;
                 return;
              end if;
           end if;

           -- ========================================================
           -- MOUNT_ARCHIVE: scoped read-only map, auto cleanup
           -- ========================================================
          if Archive_Runtime_Used then
             Emit_Main_Line ("ALB_ARCHIVE_Path rb 512");
             Emit_Main_Line ("ALB_ARCHIVE_Handle dq 0");
             Emit_Main_Line ("ALB_ARCHIVE_Map dq 0");
             Emit_Main_Line ("ALB_ARCHIVE_Data dq 0");
             Emit_Main_Line ("ALB_ARCHIVE_Size dq 0");
             Emit_Main_Line ("  jmp ALB_ARCHIVE_DONE");
             Emit_Main_Line ("ALB_ARCHIVE_Mount:");
             Emit_Main_Line ("  push rbx");
             Emit_Main_Line ("  invoke CreateFileA, ALB_ARCHIVE_Path, 0x80000000, 3, 0, 3, 0, 0");
             Emit_Main_Line ("  cmp rax, -1");
             Emit_Main_Line ("  je ALB_ARCHIVE_Fallback");
             Emit_Main_Line ("  mov [ALB_ARCHIVE_Handle], rax");
             Emit_Main_Line ("  invoke CreateFileMappingA, rax, 0, 2, 0, 0, 0");
             Emit_Main_Line ("  test rax, rax");
             Emit_Main_Line ("  jz ALB_ARCHIVE_CloseHandle");
             Emit_Main_Line ("  mov [ALB_ARCHIVE_Map], rax");
             Emit_Main_Line ("  invoke MapViewOfFile, rax, 4, 0, 0, 0");
             Emit_Main_Line ("  test rax, rax");
             Emit_Main_Line ("  jz ALB_ARCHIVE_CloseMap");
             Emit_Main_Line ("  mov [ALB_ARCHIVE_Data], rax");
             Emit_Main_Line ("  pop rbx");
             Emit_Main_Line ("  ret");
             Emit_Main_Line ("ALB_ARCHIVE_CloseMap:");
             Emit_Main_Line ("  invoke CloseHandle, [ALB_ARCHIVE_Map]");
             Emit_Main_Line ("ALB_ARCHIVE_CloseHandle:");
             Emit_Main_Line ("  invoke CloseHandle, [ALB_ARCHIVE_Handle]");
             Emit_Main_Line ("ALB_ARCHIVE_Fallback:");
             Emit_Main_Line ("  xor rax, rax");
             Emit_Main_Line ("  pop rbx");
             Emit_Main_Line ("  ret");
             Emit_Main_Line ("ALB_ARCHIVE_Unmount:");
             Emit_Main_Line ("  push rbx");
             Emit_Main_Line ("  cmp [ALB_ARCHIVE_Map], 0");
             Emit_Main_Line ("  je ALB_ARCHIVE_Unmount_Handle");
             Emit_Main_Line ("  invoke UnmapViewOfFile, [ALB_ARCHIVE_Data]");
             Emit_Main_Line ("  invoke CloseHandle, [ALB_ARCHIVE_Map]");
             Emit_Main_Line ("ALB_ARCHIVE_Unmount_Handle:");
             Emit_Main_Line ("  cmp [ALB_ARCHIVE_Handle], 0");
             Emit_Main_Line ("  je ALB_ARCHIVE_Unmount_Done");
             Emit_Main_Line ("  invoke CloseHandle, [ALB_ARCHIVE_Handle]");
             Emit_Main_Line ("ALB_ARCHIVE_Unmount_Done:");
             Emit_Main_Line ("  pop rbx");
             Emit_Main_Line ("  ret");
             Emit_Main_Line ("ALB_ARCHIVE_DONE:");
          end if;

          -- Pure EXPORT_DLL libraries have no CREATE_WINDOW, but engine modules
          -- may still emit COLOR/FILL RECT/DRAW TEXT. Provide no-op stubs so
          -- libgamedeck.dll links; hosts use Read* buffer exports instead.
          if FASM_DLL_Mode_Active then
             Emit_Main_Line ("ALB_Set_Color:");
             Emit_Main_Line ("  ret");
             Emit_Main_Line ("ALB_Fill_Rect:");
             Emit_Main_Line ("  ret");
             Emit_Main_Line ("ALB_Draw_Rect:");
             Emit_Main_Line ("  ret");
             Emit_Main_Line ("ALB_Draw_Text:");
             Emit_Main_Line ("  ret");
             Emit_Main_Line ("ALB_Key_State:");
             Emit_Main_Line ("  xor eax, eax");
             Emit_Main_Line ("  ret");
             Emit_Main_Line ("ALB_Mouse_Click_State:");
             Emit_Main_Line ("  xor eax, eax");
             Emit_Main_Line ("  ret");
          end if;

          if Need_Runtime_Block then
             Emit_Main_Line ("ALB_EXT_RUNTIME_DONE:");
          end if;
       end Emit_FASM_Extended_Runtime;

      procedure Emit_C_Extended_Runtime
        (Success : in out Boolean;
         Diag    : in out Compiler_Diagnostic)
      is
         pragma Unreferenced (Diag);

         Need_Export_Wrappers : constant Boolean :=
           Foreign_Export_Count > 0;

         procedure Emit_C_Export_Wrapper (Index : Natural) is
            Export_Node : constant Node_Index :=
              Foreign_Exports (Index).Node_Ref;
            Decl_Node   : constant Node_Index :=
              (if Export_Node > 0 then Tree (Export_Node).Left_Child else 0);
            Name_Node   : constant Node_Index :=
              (if Decl_Node > 0 then Tree (Decl_Node).Left_Child else 0);
            Target_Name : constant String :=
              Foreign_Exports (Index).Name (1 .. Foreign_Exports (Index).Name_Len);
            Ret_Name    : constant String :=
              (if Decl_Node > 0 and then Tree (Decl_Node).Token_Index > 0
               then Raw_Lexeme (Tree (Decl_Node).Token_Index)
               else "U64");
            Ret_Upper   : constant String := To_Upper (Ret_Name);
            Ret_C       : constant String :=
              (if Decl_Node > 0 and then Tree (Decl_Node).Kind = AST_Procedure_Decl
               then "void"
               else C_FFI_Type (Ret_Name));

            procedure Emit_Param_List is
               Param_Node : Node_Index := 0;
            begin
               if Name_Node /= 0
                 and then Tree (Name_Node).Right_Child /= 0
                 and then Tree (Tree (Name_Node).Right_Child).Kind = AST_Arg_List
               then
                  Param_Node := Tree (Tree (Name_Node).Right_Child).Left_Child;
               end if;

               if Param_Node = 0 then
                  Transpiler_Native_HAL.Emit_Raw ("void", Success);
