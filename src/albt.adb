                              Transpiler_Native_HAL.Emit_Raw ("  not rcx", Success); Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  dec rcx", Success); Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  mov rax, rcx", Success); Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  pop rdi", Success); Transpiler_Native_HAL.Emit_Newline (Success);
                           elsif Target = Backend_FASM16 then
                              if Arg_Node > 0 then
                                 if Tree (Arg_Node).Kind = AST_Arg_List then
                                    Arg_Node := Tree (Arg_Node).Left_Child;
                                 end if;
                                 Emit_FASM16_String_Len_Call (Arg_Node);
                              else
                                 Transpiler_Native_HAL.Emit_Raw ("  xor ax, ax", Success);
                                 Transpiler_Native_HAL.Emit_Newline (Success);
                                 Transpiler_Native_HAL.Emit_Raw ("  xor dx, dx", Success);
                                 Transpiler_Native_HAL.Emit_Newline (Success);
                              end if;
                           else
                              Transpiler_Native_HAL.Emit_Raw ("(uint64_t)strlen((char*)(uintptr_t)(", Success);
                              if Arg_Node > 0 then
                                 if Tree (Arg_Node).Kind = AST_Arg_List then Arg_Node := Tree (Arg_Node).Left_Child; end if;
                                 Walk_AST (Arg_Node, Depth + 1, Right_Tag, Success, Diag);
                              end if;
                              Transpiler_Native_HAL.Emit_Raw ("))", Success);
                           end if;
                           
                        elsif Actual_Func (1 .. Func_Len) = "SIN" or else
                              Actual_Func (1 .. Func_Len) = "COS" or else
                              Actual_Func (1 .. Func_Len) = "SQRT" or else
                              Actual_Func (1 .. Func_Len) = "EXP" then
                           if Target = Backend_FASM then
                              if Arg_Node > 0 then
                                 if Tree (Arg_Node).Kind = AST_Arg_List then
                                    Arg_Node := Tree (Arg_Node).Left_Child;
                                 end if;
                                 Walk_AST (Arg_Node, Depth + 1, Right_Tag, Success, Diag);
                              else
                                 Transpiler_Native_HAL.Emit_Raw ("  xor rax, rax", Success);
                                 Transpiler_Native_HAL.Emit_Newline (Success);
                              end if;

                              if Actual_Func (1 .. Func_Len) = "SQRT" then
                                 if Right_Tag = Type_F64 then
                                    Transpiler_Native_HAL.Emit_Raw ("  movq xmm0, rax", Success);
                                    Transpiler_Native_HAL.Emit_Newline (Success);
                                    Transpiler_Native_HAL.Emit_Raw ("  sqrtsd xmm0, xmm0", Success);
                                    Transpiler_Native_HAL.Emit_Newline (Success);
                                    Transpiler_Native_HAL.Emit_Raw ("  movq rax, xmm0", Success);
                                    Transpiler_Native_HAL.Emit_Newline (Success);
                                 else
                                    Transpiler_Native_HAL.Emit_Square_Root ("rax", Success);
                                 end if;
                              elsif Actual_Func (1 .. Func_Len) = "SIN" then
                                 Transpiler_Native_HAL.Emit_Sine ("rax", Success);
                                 Out_Tag := Type_F64;
                              elsif Actual_Func (1 .. Func_Len) = "COS" then
                                 Transpiler_Native_HAL.Emit_Cosine ("rax", Success);
                                 Out_Tag := Type_F64;
                              else
                                 Transpiler_Native_HAL.Emit_Raw ("  xor rax, rax", Success);
                                 Transpiler_Native_HAL.Emit_Newline (Success);
                              end if;
                              if Actual_Func (1 .. Func_Len) = "SQRT"
                                or else Actual_Func (1 .. Func_Len) = "EXP"
                              then
                                 Out_Tag := Type_F64;
                              end if;
                           elsif Target = Backend_FASM16 then
                              if Arg_Node > 0 then
                                 if Tree (Arg_Node).Kind = AST_Arg_List then
                                    Arg_Node := Tree (Arg_Node).Left_Child;
                                 end if;
                                 Walk_AST (Arg_Node, Depth + 1, Right_Tag, Success, Diag);
                              else
                                 Transpiler_Native_HAL.Emit_Raw ("  xor ax, ax", Success);
                                 Transpiler_Native_HAL.Emit_Newline (Success);
                                 Transpiler_Native_HAL.Emit_Raw ("  xor dx, dx", Success);
                                 Transpiler_Native_HAL.Emit_Newline (Success);
                              end if;

                              if not Success then
                                 return;
                              end if;

                              if Actual_Func (1 .. Func_Len) = "SQRT" then
                                 Transpiler_Native_HAL.Emit_Raw ("  call ALB16_Sqrt_U32", Success);
                                 Transpiler_Native_HAL.Emit_Newline (Success);
                              else
                                 Fail_Node
                                   (Node,
                                    Err_Type_Conflict,
                                    "FASM16 HW " & Actual_Func (1 .. Func_Len)
                                    & " not supported (SQRT only; use -t fasm/-t c for SIN/COS/EXP)",
                                    Success,
                                    Diag);
                                 return;
                              end if;
                           else
                              if Arg_Node > 0 and then Tree (Arg_Node).Kind = AST_Arg_List then
                                 Arg_Node := Tree (Arg_Node).Left_Child;
                              end if;

                              if Arg_Node > 0
                                and then Infer_Type_Tag (Arg_Node) = Type_F64
                                and then (Actual_Func (1 .. Func_Len) = "SQRT"
                                  or else Actual_Func (1 .. Func_Len) = "EXP")
                              then
                                 Transpiler_Native_HAL.Emit_Raw ("ALB_Double_As_U64(", Success);
                                 if Actual_Func (1 .. Func_Len) = "EXP" then
                                    Transpiler_Native_HAL.Emit_Raw ("exp(ALB_U64_As_Double(", Success);
                                 else
                                    Transpiler_Native_HAL.Emit_Raw ("sqrt(ALB_U64_As_Double(", Success);
                                 end if;
                                 if Arg_Node > 0 then
                                    Walk_AST (Arg_Node, Depth + 1, Right_Tag, Success, Diag);
                                 end if;
                                 Transpiler_Native_HAL.Emit_Raw (")))", Success);
                              else
                                 if Actual_Func(1..Func_Len) = "SIN" then
                                    Transpiler_Native_HAL.Emit_Raw
                                      ("(uint64_t)((int64_t)(sin(((double)(int64_t)(", Success);
                                 elsif Actual_Func(1..Func_Len) = "COS" then
                                    Transpiler_Native_HAL.Emit_Raw
                                      ("(uint64_t)((int64_t)(cos(((double)(int64_t)(", Success);
                                 else
                                    Transpiler_Native_HAL.Emit_Raw ("(uint64_t)", Success);
                                    if Actual_Func(1..Func_Len) = "EXP" then
                                       Transpiler_Native_HAL.Emit_Raw ("exp(", Success);
                                    else
                                       Transpiler_Native_HAL.Emit_Raw ("sqrt(", Success);
                                    end if;
                                    Transpiler_Native_HAL.Emit_Raw ("(double)(int64_t)(", Success);
                                 end if;

                                 if Arg_Node > 0 then
                                    Walk_AST (Arg_Node, Depth + 1, Right_Tag, Success, Diag);
                                 end if;
                                 if Actual_Func(1..Func_Len) = "SIN"
                                   or else Actual_Func(1..Func_Len) = "COS"
                                 then
                                    Transpiler_Native_HAL.Emit_Raw
                                      (")) * 0.017453292519943295) * 1024.0))",
                                       Success);
                                 else
                                    Transpiler_Native_HAL.Emit_Raw ("))", Success);
                                 end if;
                              end if;
                           end if;
                        end if;
                     end;
                  else
                     -- =========================================================
                     -- STANDARD FUNCTION CALL
                     -- =========================================================
                     declare
                        TName : String (1 .. 128) := (others => ' ');
                        TLen  : Natural := 0;
                     begin
                        Resolve_ALB_Call_Name (Target_Node, TName, TLen);

                        if TLen = 0 then
                           Fail_Call_Diagnostic
                             ("CALL",
                              Tree (Node).Token_Index,
                              Err_Proc_Not_Found,
                              Success,
                              Diag);
                           return;
                        end if;

                        -- =========================================================
                        -- DA TRUE MODULE SENTINEL FORGE (FUNCTION CALLS)
                        -- =========================================================
                        declare
                           H : U32 := 5381;
                           Found : Boolean;
                           Dummy_Sym : Symbol_Record;
                        begin
                           for I in 1 .. TLen loop
                              H := (H * 33) + U32(Character'Pos(TName(I)));
                           end loop;
                           
                           Find_Symbol(H, 0, Found, Dummy_Sym);

                           if not Found and then Tree(Target_Node).Kind = AST_Member_Expr then
                              Diag.Success := False;
                              Diag.Code := Err_Proc_Not_Found;
                              Diag.Error_Line := Tokens(Tree(Node).Token_Index).Line;
                              Diag.Error_Col  := Tokens(Tree(Node).Token_Index).Column;
                              Diag.Culprit_Len := TLen;
                              Diag.Culprit(1 .. TLen) := TName(1 .. TLen);
                              Success := False;
                              return;
                           end if;
                        end;
                        -- =========================================================
                        
                        -- DA NEW FIX: Shield Built-ins frae the strict user registry!
                        if not Is_ALB_Builtin_Call_Name(TName(1 .. TLen)) then
                           Validate_Foreign_Call (TName(1 .. TLen), Arg_Node, Tree(Node).Token_Index, Success, Diag);
                           if not Success or else not Diag.Success then
                              return;
                           end if;
                           
                           Validate_ALB_Call
                             (TName(1 .. TLen),
                              Arg_Node,
                              Tree(Node).Token_Index,
                              True,
                              Success,
                              Diag);

                           if not Success or else not Diag.Success then
                              return;
                           end if;
                        end if;

                        if Target = Backend_FASM then
                           if TName (1 .. TLen) = "VIRTUAL_ALLOC"
                             or else TName (1 .. TLen) = "VIRTUAL_FREE"
                             or else TName (1 .. TLen) = "VIRTUAL_PROTECT"
                           then
                              Emit_FASM_Virtual_Memory_Builtin
                                (TName (1 .. TLen), Arg_Node);
                           else
                              Emit_FASM_Call_With_Args (TName (1 .. TLen), Arg_Node);
                           end if;

                        elsif Target = Backend_FASM16 then
                           if TName (1 .. TLen) = "VIRTUAL_ALLOC"
                             or else TName (1 .. TLen) = "VIRTUAL_FREE"
                             or else TName (1 .. TLen) = "VIRTUAL_PROTECT"
                           then
                              Fail_Node
                                (Node,
                                 Err_Type_Conflict,
                                 TName (1 .. TLen) & " requires -t fasm (not FASM16)",
                                 Success,
                                 Diag);
                              return;
                           elsif TName (1 .. TLen) = "COLLIDE_RECT"
                             or else TName (1 .. TLen) = "ALB_COLLIDE_RECT"
                           then
                              declare
                                 Collide_Sig : constant ALB_Param_Tag_Array :=
                                   (1 => Type_S32,
                                    2 => Type_S32,
                                    3 => Type_S32,
                                    4 => Type_S32,
                                    5 => Type_S32,
                                    6 => Type_S32,
                                    7 => Type_S32,
                                    8 => Type_S32,
                                    others => Type_None);
                              begin
                                 Emit_FASM16_Call_With_Forced_Tags
                                   ("ALB_COLLIDE_RECT",
                                    Arg_Node,
                                    Collide_Sig,
                                    8);
                              end;
                           else
                              Emit_FASM16_Call_With_Args
                                (FASM16_Asm_Name (TName (1 .. TLen)),
                                 Arg_Node,
                                 TName (1 .. TLen));
                           end if;

                        else
                           if TName (1 .. TLen) = "VIRTUAL_ALLOC"
                             or else TName (1 .. TLen) = "VIRTUAL_FREE"
                             or else TName (1 .. TLen) = "VIRTUAL_PROTECT"
                           then
                              Fail_Node
                                (Node,
                                 Err_Type_Conflict,
                                 TName (1 .. TLen) & " requires -t fasm",
                                 Success,
                                 Diag);
                              return;
                           end if;
                           Transpiler_Native_HAL.Emit_Call_Start (TName (1 .. TLen), Success);
                           if Arg_Node > 0 then
                              if Tree (Arg_Node).Kind = AST_Arg_List then
                                 Arg_Node := Tree (Arg_Node).Left_Child;
                              end if;
                              while Arg_Node > 0 loop
                                 Walk_AST (Arg_Node, Depth + 1, Right_Tag, Success, Diag);
                                 Arg_Node := Tree (Arg_Node).Next_Sibling;
                                 if Arg_Node > 0 then
                                    Transpiler_Native_HAL.Emit_Comma (Success);
                                 end if;
                              end loop;
                           end if;
                           Transpiler_Native_HAL.Emit_Call_End (Success);
                        end if;

                     end;
                  end if;
                  --Out_Tag := Type_U64;
                  Out_Tag := Infer_Type_Tag (Node);
                  if Out_Tag = Type_None then
                     Out_Tag := Type_U64;
                  end if;
               end;
               
               
            when AST_Fact =>
               declare
                  Pred_Node : Node_Index := Tree (Node).Left_Child;
                  Arg_Node  : Node_Index := Tree (Pred_Node).Left_Child;
                  P_Tok     : Token := Tokens (Tree (Pred_Node).Token_Index);
                  P_Lexeme  : String := Input_Buffer (P_Tok.Start .. P_Tok.Start + P_Tok.Length - 1);
               begin
                  if Target = Backend_FASM then
                     if Arg_Node > 0 then
                        Walk_AST (Arg_Node, Depth + 1, Right_Tag, Success, Diag);
                     else
                        Transpiler_Native_HAL.Emit_Raw ("  xor rax, rax", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                     end if;
                     Transpiler_Native_HAL.Emit_Raw ("  fastcall ALB_Assert, <'", Success);
                     Transpiler_Native_HAL.Emit_Raw (P_Lexeme, Success);
                     Transpiler_Native_HAL.Emit_Raw ("',0>, rax, 0", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                  
                  elsif Target = Backend_FASM16 then
                     if Arg_Node > 0 then
                        Emit_FASM16_Logic_Value_To_DXAX (Arg_Node);
                     else
                        Transpiler_Native_HAL.Emit_Raw ("  xor ax, ax", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  xor dx, dx", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                     end if;

                     Transpiler_Native_HAL.Emit_Raw ("  xor bx, bx", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Emit_Raw ("  xor cx, cx", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);

                     Emit_FASM16_Load_Predicate_To_SI (P_Lexeme, Node, "fact");
                     Transpiler_Native_HAL.Emit_Raw ("  call ALB16_Assert", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     
                  else
                     Transpiler_Native_HAL.Emit_Raw ("ALB_Assert(""" & P_Lexeme & """, ", Success);
                     if Arg_Node > 0 then
                        Walk_AST (Arg_Node, Depth + 1, Right_Tag, Success, Diag);
                     else
                        if Target = Backend_C then
                           Transpiler_Native_HAL.Emit_Raw ("ALB_U64_ZERO", Success);
                        else
                           Transpiler_Native_HAL.Emit_Raw ("0ULL", Success);
                        end if;
                     end if;
                     if Target = Backend_C then
                        Transpiler_Native_HAL.Emit_Raw (", ALB_U64_ZERO);", Success);
                     else
                        Transpiler_Native_HAL.Emit_Raw (", 0ULL);", Success);
                     end if;
                     Transpiler_Native_HAL.Emit_Newline (Success);
                  end if;
               end;
               
            when AST_Str_Len =>
               if Target = Backend_FASM then
                  -- Evaluate the string pointer intae rax FIRST!
                  Walk_AST (Tree(Node).Left_Child, Depth+1, Left_Tag, Success, Diag);
                  
                  -- Inline x64 strlen using repne scasb (Preserving Windows ABI rdi!)
                  Transpiler_Native_HAL.Emit_Raw ("  push rdi", Success); Transpiler_Native_HAL.Emit_Newline (Success);
                  Transpiler_Native_HAL.Emit_Raw ("  mov rdi, rax", Success); Transpiler_Native_HAL.Emit_Newline (Success);
                  Transpiler_Native_HAL.Emit_Raw ("  xor rcx, rcx", Success); Transpiler_Native_HAL.Emit_Newline (Success);
                  Transpiler_Native_HAL.Emit_Raw ("  not rcx", Success); Transpiler_Native_HAL.Emit_Newline (Success);
                  Transpiler_Native_HAL.Emit_Raw ("  xor al, al", Success); Transpiler_Native_HAL.Emit_Newline (Success);
                  Transpiler_Native_HAL.Emit_Raw ("  repne scasb", Success); Transpiler_Native_HAL.Emit_Newline (Success);
                  Transpiler_Native_HAL.Emit_Raw ("  not rcx", Success); Transpiler_Native_HAL.Emit_Newline (Success);
                  Transpiler_Native_HAL.Emit_Raw ("  dec rcx", Success); Transpiler_Native_HAL.Emit_Newline (Success);
                  Transpiler_Native_HAL.Emit_Raw ("  mov rax, rcx", Success); Transpiler_Native_HAL.Emit_Newline (Success);
                  Transpiler_Native_HAL.Emit_Raw ("  pop rdi", Success); Transpiler_Native_HAL.Emit_Newline (Success);
               elsif Target = Backend_FASM16 then
                  Emit_FASM16_String_Len_Call (Tree(Node).Left_Child);
               else
                  Transpiler_Native_HAL.Emit_Raw ("(uint64_t)strlen((char*)(uintptr_t)(", Success);
                  Walk_AST (Tree(Node).Left_Child, Depth+1, Left_Tag, Success, Diag);
                  Transpiler_Native_HAL.Emit_Raw ("))", Success);
               end if;
               if Target = Backend_FASM16 then
                  Out_Tag := Type_U32;
               else
                  Out_Tag := Type_U64;
               end if;

            when AST_Str_Left =>
               if Target = Backend_FASM then
                  Walk_AST (Tree(Node).Left_Child, Depth+1, Left_Tag, Success, Diag);
                  Transpiler_Native_HAL.Emit_Raw ("  push rax", Success); Transpiler_Native_HAL.Emit_Newline (Success);
                  Walk_AST (Tree(Node).Right_Child, Depth+1, Right_Tag, Success, Diag);
                  Transpiler_Native_HAL.Emit_Raw ("  mov rdx, rax", Success); Transpiler_Native_HAL.Emit_Newline (Success);
                  Transpiler_Native_HAL.Emit_Raw ("  pop rcx", Success); Transpiler_Native_HAL.Emit_Newline (Success);
                  Transpiler_Native_HAL.Emit_Raw ("  call ALB_String_Left", Success); Transpiler_Native_HAL.Emit_Newline (Success);
               elsif Target = Backend_FASM16 then
                  Emit_FASM16_String_Left_Right_Call
                    (Tree(Node).Left_Child,
                     Tree(Node).Right_Child,
                     False);
               else
                  Transpiler_Native_HAL.Emit_Raw ("(uint64_t)(uintptr_t)ALB_String_Left(", Success);
                  Walk_AST (Tree(Node).Left_Child, Depth+1, Left_Tag, Success, Diag);
                  Transpiler_Native_HAL.Emit_Raw (", ", Success);
                  Walk_AST (Tree(Node).Right_Child, Depth+1, Right_Tag, Success, Diag);
                  Transpiler_Native_HAL.Emit_Raw (")", Success);
               end if;
               Out_Tag := Type_Binary;

            when AST_Str_Right =>
               if Target = Backend_FASM then
                  Walk_AST (Tree(Node).Left_Child, Depth+1, Left_Tag, Success, Diag);
                  Transpiler_Native_HAL.Emit_Raw ("  push rax", Success); Transpiler_Native_HAL.Emit_Newline (Success);
                  Walk_AST (Tree(Node).Right_Child, Depth+1, Right_Tag, Success, Diag);
                  Transpiler_Native_HAL.Emit_Raw ("  mov rdx, rax", Success); Transpiler_Native_HAL.Emit_Newline (Success);
                  Transpiler_Native_HAL.Emit_Raw ("  pop rcx", Success); Transpiler_Native_HAL.Emit_Newline (Success);
                  Transpiler_Native_HAL.Emit_Raw ("  call ALB_String_Right", Success); Transpiler_Native_HAL.Emit_Newline (Success);
               elsif Target = Backend_FASM16 then
                  Emit_FASM16_String_Left_Right_Call
                    (Tree(Node).Left_Child,
                     Tree(Node).Right_Child,
                     True);
               else
                  Transpiler_Native_HAL.Emit_Raw ("(uint64_t)(uintptr_t)ALB_String_Right(", Success);
                  Walk_AST (Tree(Node).Left_Child, Depth+1, Left_Tag, Success, Diag);
                  Transpiler_Native_HAL.Emit_Raw (", ", Success);
                  Walk_AST (Tree(Node).Right_Child, Depth+1, Right_Tag, Success, Diag);
                  Transpiler_Native_HAL.Emit_Raw (")", Success);
               end if;
               Out_Tag := Type_Binary;

            when AST_Str_Mid =>
               declare
                  Arg_List : Node_Index := Tree(Node).Right_Child;
                  Start_Node : Node_Index := Tree(Arg_List).Left_Child;
                  Len_Node : Node_Index := Tree(Start_Node).Next_Sibling;
               begin
                  if Target = Backend_FASM then
                     Walk_AST (Tree(Node).Left_Child, Depth+1, Left_Tag, Success, Diag);
                     Transpiler_Native_HAL.Emit_Raw ("  push rax", Success); Transpiler_Native_HAL.Emit_Newline (Success);
                     Walk_AST (Start_Node, Depth+1, Right_Tag, Success, Diag);
                     Transpiler_Native_HAL.Emit_Raw ("  push rax", Success); Transpiler_Native_HAL.Emit_Newline (Success);
                     Walk_AST (Len_Node, Depth+1, Right_Tag, Success, Diag);
                     Transpiler_Native_HAL.Emit_Raw ("  mov r8, rax", Success); Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Emit_Raw ("  pop rdx", Success); Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Emit_Raw ("  pop rcx", Success); Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Emit_Raw ("  call ALB_String_Mid", Success); Transpiler_Native_HAL.Emit_Newline (Success);
                  elsif Target = Backend_FASM16 then
                     Emit_FASM16_String_Mid_Call
                       (Tree(Node).Left_Child,
                        Start_Node,
                        Len_Node);
                  else
                     Transpiler_Native_HAL.Emit_Raw ("(uint64_t)(uintptr_t)ALB_String_Mid(", Success);
                     Walk_AST (Tree(Node).Left_Child, Depth+1, Left_Tag, Success, Diag);
                     Transpiler_Native_HAL.Emit_Raw (", ", Success);
                     Walk_AST (Start_Node, Depth+1, Right_Tag, Success, Diag);
                     Transpiler_Native_HAL.Emit_Raw (", ", Success);
                     Walk_AST (Len_Node, Depth+1, Right_Tag, Success, Diag);
                     Transpiler_Native_HAL.Emit_Raw (")", Success);
                  end if;
                  Out_Tag := Type_Binary;
               end;
               
            when AST_Knows_Query =>
               declare
                  Atom_Node : Node_Index := Tree (Node).Left_Child;
                  A_Tok     : Token := Tokens (Tree (Atom_Node).Token_Index);
                  A_Lex     : String := Input_Buffer (A_Tok.Start .. A_Tok.Start + A_Tok.Length - 1);
               begin
                  if Target = Backend_FASM then
                     Transpiler_Native_HAL.Emit_Prolog_Query_Call (A_Lex, "0", Success);
                     
                  elsif Target = Backend_FASM16 then
                     Transpiler_Native_HAL.Emit_Raw ("  xor ax, ax", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Emit_Raw ("  xor dx, dx", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Emit_FASM16_Load_Predicate_To_SI (A_Lex, Node, "knowsq");
                     Transpiler_Native_HAL.Emit_Raw ("  call ALB16_Query", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     
                  else
                     if Target = Backend_C then
                        Transpiler_Native_HAL.Emit_Raw ("ALB_Query(""" & A_Lex & """, ALB_U64_ZERO)", Success);
                     else
                        Transpiler_Native_HAL.Emit_Raw ("ALB_Query(""" & A_Lex & """, 0ULL)", Success);
                     end if;
                  end if;
                  Out_Tag := Type_Boolean;
               end;
            
            when AST_Query =>
               declare
                  Pred_Node : Node_Index := Tree (Node).Left_Child;
                  Arg_Node  : Node_Index := Tree (Pred_Node).Left_Child;
                  P_Tok     : Token := Tokens (Tree (Pred_Node).Token_Index);
                  P_Lexeme  : String := Input_Buffer (P_Tok.Start .. P_Tok.Start + P_Tok.Length - 1);
               begin
                  -- DA FIX: Ensure Arg_Node > 0 AND is valid afore checking its Kind!
                  if Arg_Node > 0 and then Tree (Arg_Node).Kind = AST_Logic_Var then
                     declare
                        Tok : Token := Tokens (Tree(Arg_Node).Token_Index);
                        Lex : String := Input_Buffer(Tok.Start .. Tok.Start + Tok.Length - 1);
                        Dummy_Tag : ALB_Type_Tag;
                        Dummy_Sym : Symbol_Record;
                     begin
                        -- FASM logic bindings are interned numeric symbols, not string pointers.
                        Dummy_Sym := Resolve_Symbol (Lex, Type_U64, 0, False, Dummy_Tag);

                        if Target = Backend_FASM then
                           Transpiler_Native_HAL.Emit_Raw ("  fastcall ALB_Find, <'", Success);
                           Transpiler_Native_HAL.Emit_Raw (P_Lexeme, Success);
                           Transpiler_Native_HAL.Emit_Raw ("',0>", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Transpiler_Native_HAL.Emit_Raw ("  mov qword [", Success);
                           Transpiler_Native_HAL.Emit_Raw (Lex, Success);
                           Transpiler_Native_HAL.Emit_Raw ("], rax", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Transpiler_Native_HAL.Emit_Raw ("  cmp rax, 0", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Transpiler_Native_HAL.Emit_Raw ("  setne al", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Transpiler_Native_HAL.Emit_Raw ("  movzx rax, al", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           
                        elsif Target = Backend_FASM16 then
                           Dummy_Sym := Resolve_Symbol (Lex, Type_U32, 0, False, Dummy_Tag);

                           declare
                              Cell       : constant String := FASM16_Cell_Name (Dummy_Sym, Scoped_Lexeme (Lex));
                              Img        : constant String := Node_Index'Image (Node);
                              NID        : constant String := Img (Img'First + 1 .. Img'Last);
                              True_Label : constant String := ".ALB16_LOGIC_FIND_TRUE_" & NID;
                              Done_Label : constant String := ".ALB16_LOGIC_FIND_DONE_" & NID;
                           begin
                              Emit_FASM16_Load_Predicate_To_SI (P_Lexeme, Node, "find");
                              Transpiler_Native_HAL.Emit_Raw ("  call ALB16_Find", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);

                              Emit_FASM16_Store_DXAX_To_Cell (Cell, Type_U32);

                              Transpiler_Native_HAL.Emit_Raw ("  cmp dx, 0", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  jne " & True_Label, Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  cmp ax, 0", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  jne " & True_Label, Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  xor ax, ax", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  xor dx, dx", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  jmp " & Done_Label, Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw (True_Label & ":", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  mov ax, 1", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  xor dx, dx", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw (Done_Label & ":", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                           end;
                        else
                           -- Switch tae our new C-string fetcher!
                           if Target = Backend_C then
                              Transpiler_Native_HAL.Emit_Raw ("(" & Lex & " = ALB_Find(""" & P_Lexeme & """)) ? ALB_U64_ONE : ALB_U64_ZERO", Success);
                           else
                              Transpiler_Native_HAL.Emit_Raw ("(" & Lex & " = ALB_Find(""" & P_Lexeme & """)) ? 1ULL : 0ULL", Success);
                           end if;
                        end if;
                     end;
                  else
                      if Target = Backend_FASM then
                        if Arg_Node > 0 and then Tree (Arg_Node).Kind /= AST_Null then
                           Emit_FASM_Logic_Value_To_RAX (Arg_Node);
                           Transpiler_Native_HAL.Emit_Raw ("  fastcall ALB_Query, <'", Success);
                           Transpiler_Native_HAL.Emit_Raw (P_Lexeme, Success);
                           Transpiler_Native_HAL.Emit_Raw ("',0>, rax", Success);
                        else
                           Transpiler_Native_HAL.Emit_Raw ("  fastcall ALB_Query, <'", Success);
                           Transpiler_Native_HAL.Emit_Raw (P_Lexeme, Success);
                           Transpiler_Native_HAL.Emit_Raw ("',0>, 0", Success);
                        end if;
                        Transpiler_Native_HAL.Emit_Newline (Success);

                     elsif Target = Backend_FASM16 then
                        if Arg_Node > 0 and then Tree (Arg_Node).Kind /= AST_Null then
                           Emit_FASM16_Logic_Value_To_DXAX (Arg_Node);
                        else
                           Transpiler_Native_HAL.Emit_Raw ("  xor ax, ax", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Transpiler_Native_HAL.Emit_Raw ("  xor dx, dx", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                        end if;

                        Emit_FASM16_Load_Predicate_To_SI (P_Lexeme, Node, "query");
                        Transpiler_Native_HAL.Emit_Raw ("  call ALB16_Query", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);

                     else
                        Transpiler_Native_HAL.Emit_Raw ("ALB_Query(""" & P_Lexeme & """, ", Success);

                        if Arg_Node > 0 and then Tree (Arg_Node).Kind /= AST_Null then
                           Walk_AST (Arg_Node, Depth + 1, Right_Tag, Success, Diag);
                        else
                           if Target = Backend_C then
                              Transpiler_Native_HAL.Emit_Raw ("ALB_U64_ZERO", Success);
                           else
                              Transpiler_Native_HAL.Emit_Raw ("0ULL", Success);
                           end if;
                        end if;

                        Transpiler_Native_HAL.Emit_Raw (")", Success);
                     end if;
                  end if;

                  Out_Tag := Type_Boolean;
               end;
               
            when AST_Atom =>
               declare
                  Tok : Token := Tokens (Tree(Node).Token_Index);
                  Lex : String := Input_Buffer (Tok.Start .. Tok.Start + Tok.Length - 1);
               begin
                  if Target = Backend_FASM then
                     Transpiler_Native_HAL.Emit_Raw ("  mov rax, ", Success);
                     Transpiler_Native_HAL.Emit_Literal_U64 (U64 (Hash_String (Lex)), Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Out_Tag := Type_Binary;

                  elsif Target = Backend_FASM16 then
                     Emit_FASM16_Literal_DXAX
                       (U64 (Hash_String (Lex)),
                        Node,
                        "FASM16 atom hash exceeds U32");
                     Out_Tag := Type_U32;

                  else
                     Transpiler_Native_HAL.Emit_Raw ("(uint64_t)(uintptr_t)""" & Lex & """", Success);
                     Out_Tag := Type_Binary;
                  end if;
               end;
               
            
            when AST_Assert_Stmt | AST_Retract_Stmt =>
               declare
                  Is_Assert : Boolean := (Tree(Node).Kind = AST_Assert_Stmt);
                  Tok : Token := Tokens(Tree(Node).Token_Index);
                  Lex : String := Input_Buffer(Tok.Start .. Tok.Start+Tok.Length-1);
                  Arg_Node : Node_Index := Tree(Node).Left_Child;
                  Sym : Symbol_Record; Found : Boolean;
               begin
                  if Target = Backend_FASM then
                     -- 1. Evaluate the dynamic argument intae rax, or zero it oot!
                     if Arg_Node > 0 then
                        Emit_FASM_Logic_Value_To_RAX (Arg_Node);
                     else
                        Transpiler_Native_HAL.Emit_Raw ("  xor rax, rax", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                     end if;

                     -- 2. Emit the fastcall to the Prolog Runtime
                     if Is_Assert then
                        Transpiler_Native_HAL.Emit_Raw ("  fastcall ALB_Assert, <'", Success);
                        Transpiler_Native_HAL.Emit_Raw (Lex, Success);
                        Transpiler_Native_HAL.Emit_Raw ("',0>, rax, 0", Success);
                     else
                        Transpiler_Native_HAL.Emit_Raw ("  fastcall ALB_Retract, <'", Success);
                        Transpiler_Native_HAL.Emit_Raw (Lex, Success);
                        Transpiler_Native_HAL.Emit_Raw ("',0>, rax", Success);
                     end if;

                     Transpiler_Native_HAL.Emit_Newline (Success);
                     
                  elsif Target = Backend_FASM16 then
                     if Arg_Node > 0 then
                        Emit_FASM16_Logic_Value_To_DXAX (Arg_Node);
                     else
                        Transpiler_Native_HAL.Emit_Raw ("  xor ax, ax", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  xor dx, dx", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                     end if;

                     Emit_FASM16_Load_Predicate_To_SI
                       (Lex,
                        Node,
                        (if Is_Assert then "assert" else "retract"));

                     if Is_Assert then
                        Transpiler_Native_HAL.Emit_Raw ("  xor bx, bx", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  xor cx, cx", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  call ALB16_Assert", Success);
                     else
                        Transpiler_Native_HAL.Emit_Raw ("  call ALB16_Retract", Success);
                     end if;

                     Transpiler_Native_HAL.Emit_Newline (Success);

                  elsif Target = Backend_C then
                     Transpiler_Native_HAL.Emit_Indent(Success);
                     if Is_Assert then
                        Transpiler_Native_HAL.Emit_Raw("ALB_Assert(""" & Lex & """, ", Success);
                     else
                        Transpiler_Native_HAL.Emit_Raw("ALB_Retract(""" & Lex & """, ", Success);
                     end if;
                     
                     -- If there is an argument, dynamically evaluate it!
                     if Arg_Node > 0 then
                        Walk_AST(Arg_Node, Depth + 1, Out_Tag, Success, Diag);
                     else
                        -- No argument provided. Fallback tae old atomic behavior!
                        Find_Symbol(Hash_String(Lex), Current_Scope, Found, Sym);
                        if Found then
                           Transpiler_Native_HAL.Emit_Raw(Lex, Success);
                        else
                           Transpiler_Native_HAL.Emit_Raw("0", Success);
                        end if;
                     end if;
                     
                     if Is_Assert then
                        Transpiler_Native_HAL.Emit_Raw(", 0);", Success);
                     else
                        Transpiler_Native_HAL.Emit_Raw(");", Success);
                     end if;
                     Transpiler_Native_HAL.Emit_Newline(Success);
                  end if;
                  
                  Out_Tag := Type_None;
               end;
            
            when AST_Update_Stmt =>
               declare
                  Atom_Node : Node_Index := Tree (Node).Left_Child;
                  Val_Node  : Node_Index := Tree (Node).Right_Child;
                  Pred_Node : Node_Index := Atom_Node;
                  Arg_List  : Node_Index := 0;
                  Arg_Node  : Node_Index := 0;
               begin
                  if Atom_Node > 0 and then Tree (Atom_Node).Kind = AST_Func_Call then
                     Pred_Node := Tree (Atom_Node).Left_Child;
                     Arg_List  := Tree (Atom_Node).Right_Child;

                     if Arg_List > 0 and then Tree (Arg_List).Kind = AST_Arg_List then
                        Arg_Node := Tree (Arg_List).Left_Child;
                     else
                        Arg_Node := Arg_List;
                     end if;
                  elsif Atom_Node > 0 then
                     Arg_Node := Tree (Atom_Node).Left_Child;

                     if Arg_Node > 0 and then Tree (Arg_Node).Kind = AST_Arg_List then
                        Arg_Node := Tree (Arg_Node).Left_Child;
                     end if;
                  end if;

                  declare
                     A_Tok : Token := Tokens (Tree (Pred_Node).Token_Index);
                     A_Lex : String := Input_Buffer (A_Tok.Start .. A_Tok.Start + A_Tok.Length - 1);
                  begin
                     if Target = Backend_FASM then
                        if Arg_Node > 0 then
                           Emit_FASM_Logic_Value_To_RAX (Arg_Node);
                        else
                           Transpiler_Native_HAL.Emit_Raw ("  xor rax, rax", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                        end if;

                        Transpiler_Native_HAL.Emit_Raw ("  push rax", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);

                        Emit_FASM_Logic_Value_To_RAX (Val_Node);

                        Transpiler_Native_HAL.Emit_Raw ("  mov r8, rax", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  pop rdx", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);

                        Transpiler_Native_HAL.Emit_Update_Call (A_Lex, "rdx", "r8", Success);
                        
                     elsif Target = Backend_FASM16 then
                        if Arg_Node > 0 then
                           Emit_FASM16_Logic_Value_To_DXAX (Arg_Node);
                        else
                           Transpiler_Native_HAL.Emit_Raw ("  xor ax, ax", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                           Transpiler_Native_HAL.Emit_Raw ("  xor dx, dx", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                        end if;

                        Transpiler_Native_HAL.Emit_Raw ("  push dx", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  push ax", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);

                        Emit_FASM16_Logic_Value_To_DXAX (Val_Node);

                        Transpiler_Native_HAL.Emit_Raw ("  mov bx, ax", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  mov cx, dx", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  pop ax", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  pop dx", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);

                        Emit_FASM16_Load_Predicate_To_SI (A_Lex, Node, "update");
                        Transpiler_Native_HAL.Emit_Raw ("  call ALB16_Update", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        
                     else
                        Transpiler_Native_HAL.Emit_Raw ("ALB_Update(""" & A_Lex & """, ", Success);

                        if Arg_Node > 0 then
                           Walk_AST (Arg_Node, Depth + 1, Right_Tag, Success, Diag);
                        else
                           if Target = Backend_C then
                              Transpiler_Native_HAL.Emit_Raw ("ALB_U64_ZERO", Success);
                           else
                              Transpiler_Native_HAL.Emit_Raw ("0ULL", Success);
                           end if;
                        end if;

                        Transpiler_Native_HAL.Emit_Raw (", ", Success);
                        Walk_AST (Val_Node, Depth + 1, Right_Tag, Success, Diag);
                        Transpiler_Native_HAL.Emit_Raw (");", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                     end if;
                  end;

                  Out_Tag := Type_None;
               end;



            when AST_Findall_Query =>
               declare
                  Pred_Node  : Node_Index := Tree (Node).Left_Child;
                  Var_Node   : Node_Index := Tree (Node).Right_Child;
                  P_Tok      : Token := Tokens (Tree (Pred_Node).Token_Index);
                  P_Lex      : String := Input_Buffer (P_Tok.Start .. P_Tok.Start + P_Tok.Length - 1);
                  V_Tok      : Token := Tokens (Tree (Var_Node).Token_Index);
                  V_Lex      : String := Input_Buffer (V_Tok.Start .. V_Tok.Start + V_Tok.Length - 1);
               begin
                  if Target = Backend_FASM then
                     Transpiler_Native_HAL.Emit_FindAll_Call
                      (P_Lex, Scoped_Lexeme (V_Lex), Success);
                     
                  elsif Target = Backend_FASM16 then
                     declare
                        Target_Lex : constant String := Scoped_Lexeme (V_Lex);
                        Out_Sym    : Symbol_Record;
                        Found      : Boolean;
                     begin
                        Find_Symbol (Hash_String (Target_Lex), Current_Scope, Found, Out_Sym);

                        if not Found then
                           Find_Symbol (Hash_String (V_Lex), Current_Scope, Found, Out_Sym);
                        end if;

                        if Found then
                           Transpiler_Native_HAL.Emit_Raw
                             ("  lea di, [" & FASM16_Cell_Name (Out_Sym, Target_Lex) & "]",
                              Success);
                        else
                           Transpiler_Native_HAL.Emit_Raw
                             ("  lea di, [" & Target_Lex & "]",
                              Success);
                        end if;

                        Transpiler_Native_HAL.Emit_Newline (Success);
                     end;

                     Emit_FASM16_Load_Predicate_To_SI (P_Lex, Node, "findall");
                     Transpiler_Native_HAL.Emit_Raw ("  call ALB16_FindAll", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                  else
                     Transpiler_Native_HAL.Emit_Raw ("ALB_FindAll(""" & P_Lex & """, ", Success);
                     Transpiler_Native_HAL.Emit_Raw (V_Lex, Success);
                     Transpiler_Native_HAL.Emit_Raw (");", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                  end if;
                  Out_Tag := Type_Boolean;
               end;
               
            when AST_Knows_Fact =>
               declare
                  Atom_Node : Node_Index := Tree (Node).Left_Child;
                  Val_Node  : Node_Index := Tree (Node).Right_Child;
                  Atom_Tok  : Token := Tokens (Tree (Atom_Node).Token_Index);
                  Atom_Lex  : String := Input_Buffer (Atom_Tok.Start .. Atom_Tok.Start + Atom_Tok.Length - 1);
               begin
                  if Target = Backend_FASM then
                     -- DA FIX: Walk the value FIRST sae it evaluates intae rax!
                     Emit_FASM_Logic_Value_To_RAX (Val_Node);
                     Transpiler_Native_HAL.Emit_Raw ("  fastcall ALB_Assert, <'", Success);
                     Transpiler_Native_HAL.Emit_Raw (Atom_Lex, Success);
                     Transpiler_Native_HAL.Emit_Raw ("',0>, 0, rax", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     
                  elsif Target = Backend_FASM16 then
                     Emit_FASM16_Logic_Value_To_DXAX (Val_Node);

                     Transpiler_Native_HAL.Emit_Raw ("  mov bx, ax", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Emit_Raw ("  mov cx, dx", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Emit_Raw ("  xor ax, ax", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Emit_Raw ("  xor dx, dx", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);

                     Emit_FASM16_Load_Predicate_To_SI (Atom_Lex, Node, "knowsfact");
                     Transpiler_Native_HAL.Emit_Raw ("  call ALB16_Assert", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     
                  else
                     if Target = Backend_C then
                        Transpiler_Native_HAL.Emit_Raw ("ALB_Assert(""" & Atom_Lex & """, ALB_U64_ZERO, ", Success);
                     else
                        Transpiler_Native_HAL.Emit_Raw ("ALB_Assert(""" & Atom_Lex & """, 0ULL, ", Success);
                     end if;
                     Walk_AST (Val_Node, Depth + 1, Right_Tag, Success, Diag);
                     Transpiler_Native_HAL.Emit_Raw (")", Success);
                     Transpiler_Native_HAL.Emit_Statement_End (Success);
                  end if;
               end;
               
            when AST_Knows_Change =>
                declare
                   Pred_Node  : Node_Index := Tree (Node).Right_Child;
                   Block_Node : Node_Index := Tree (Node).Left_Child;
                   Tok        : Token := Tokens (Tree(Pred_Node).Token_Index);
                   Lexeme     : String := Input_Buffer(Tok.Start .. Tok.Start + Tok.Length - 1);
                begin
                   Log ("   -> EMIT: Registering Event Hook for KNOWS_CHANGE " & Lexeme);

                   if Target = Backend_FASM or else Target = Backend_FASM16 then
                      Fail_Node
                        (Node,
                         Err_Type_Conflict,
                         "ON KNOWS_CHANGE requires -t c (not implemented on FASM/FASM16)",
                         Success,
                         Diag);
                      return;
                   else
                      -- 1. Hoist the callback intae the Global Vault!
                      Transpiler_Native_HAL.Emit_Procedure_Decl_Start ("ALB_ON_CHANGE_" & Lexeme, Success);
                      Walk_AST (Block_Node, Depth + 1, Right_Tag, Success, Diag);
                      Transpiler_Native_HAL.Emit_Procedure_End ("ALB_ON_CHANGE_" & Lexeme, Success);

                      -- 2. Inject the registration hook intae the Main Vault!
                      Transpiler_Native_HAL.Emit_Raw ("ALB_Register_Hook(""" & Lexeme & """, ALB_ON_CHANGE_" & Lexeme & ");", Success);
                      Transpiler_Native_HAL.Emit_Newline (Success);
                   end if;
                end;
               
               
            when AST_Logic_Var =>
               declare
                  Tok       : Token := Tokens (Tree (Node).Token_Index);
                  Lexeme    : String := Input_Buffer (Tok.Start .. Tok.Start + Tok.Length - 1);
                  Dummy_Tag : ALB_Type_Tag;
                  Dummy_Sym : Symbol_Record;
               begin
                  if Target = Backend_FASM16 then
                     Dummy_Sym := Resolve_Symbol (Lexeme, Type_U32, 0, False, Dummy_Tag);

                     Emit_FASM16_Load_Cell_To_DXAX
                       (FASM16_Cell_Name (Dummy_Sym, Scoped_Lexeme (Lexeme)),
                        Type_U32);

                     Out_Tag := Type_U32;

                  else
                     Dummy_Sym := Resolve_Symbol (Lexeme, Type_U64, 0, False, Dummy_Tag);

                     if Target = Backend_FASM then
                        Transpiler_Native_HAL.Emit_Raw ("  mov rax, qword [", Success);
                        Transpiler_Native_HAL.Emit_Raw (Lexeme, Success);
                        Transpiler_Native_HAL.Emit_Raw ("]", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                     else
                        Transpiler_Native_HAL.Emit_Variable_Ref (Lexeme, Success);
                     end if;

                     Out_Tag := Type_U64;
                  end if;
               end;
               
            when AST_Find_Query =>
               declare
                  Tok         : Token := Tokens(Tree(Node).Token_Index);
                  Lex         : String := Input_Buffer(Tok.Start .. Tok.Start+Tok.Length-1);
                  Find_Node   : Node_Index := Tree(Node).Left_Child;
                  Arg_Node    : Node_Index := 0;
                  Pred_Name   : String (1 .. 128) := (others => ' ');
                  Pred_Len    : Natural := 0;
               begin
                  if Find_Node > 0 and then Tree (Find_Node).Kind = AST_Func_Call then
                     Resolve_ALB_Call_Name (Tree (Find_Node).Left_Child, Pred_Name, Pred_Len);
                     Arg_Node := Tree (Find_Node).Right_Child;
                     if Arg_Node > 0 and then Tree (Arg_Node).Kind = AST_Arg_List then
                        Arg_Node := Tree (Arg_Node).Left_Child;
                     end if;
                  elsif Find_Node > 0 and then Tree (Find_Node).Kind = AST_Var_Expr then
                     declare
                        Pred_Tok : Token := Tokens (Tree (Find_Node).Token_Index);
                        Pred_Lex : String := Input_Buffer (Pred_Tok.Start .. Pred_Tok.Start + Pred_Tok.Length - 1);
                     begin
                        Pred_Len := Pred_Lex'Length;
                        Pred_Name (1 .. Pred_Len) := Pred_Lex;
                        Arg_Node := 0;
                     end;
                  else
                     Arg_Node := Find_Node;
                     if To_Upper (Lex) /= "FIND" then
                        Pred_Len := Lex'Length;
                        Pred_Name (1 .. Pred_Len) := Lex;
                     end if;
                  end if;

                  if Pred_Len = 0 then
                     Fail_Node
                       (Node,
                        Err_Type_Conflict,
                        "Malformed FIND query",
                        Success,
                        Diag);
                     return;
                  end if;

                  declare
                     Pred_Lex : constant String := Pred_Name (1 .. Pred_Len);
                  begin
                     if Target = Backend_FASM16 then
                        Emit_FASM16_Load_Predicate_To_SI (Pred_Lex, Node, "findquery");
                        Transpiler_Native_HAL.Emit_Raw ("  call ALB16_Find", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);

                        if Arg_Node > 0 and then Tree (Arg_Node).Kind = AST_Logic_Var then
                           declare
                              Arg_Tok    : Token := Tokens (Tree (Arg_Node).Token_Index);
                              Arg_Lex    : String := Input_Buffer (Arg_Tok.Start .. Arg_Tok.Start + Arg_Tok.Length - 1);
                              Dummy_Tag  : ALB_Type_Tag := Type_None;
                              Dummy_Sym  : Symbol_Record;
                           begin
                              Dummy_Sym := Resolve_Symbol (Arg_Lex, Type_U32, 0, False, Dummy_Tag);
                              declare
                                 Cell_Name : constant String := FASM16_Cell_Name (Dummy_Sym, Scoped_Lexeme (Arg_Lex));
                              begin
                                 Emit_FASM16_Store_DXAX_To_Cell (Cell_Name, Type_U32);
                              end;
                           end;
                        end if;

                        Out_Tag := Type_U32;
                     elsif Target = Backend_FASM then
                        Transpiler_Native_HAL.Emit_Raw ("  fastcall ALB_Find, <'", Success);
                        Transpiler_Native_HAL.Emit_Raw (Pred_Lex, Success);
                        Transpiler_Native_HAL.Emit_Raw ("',0>", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);

                        if Arg_Node > 0 and then Tree (Arg_Node).Kind = AST_Logic_Var then
                           declare
                              Arg_Tok : Token := Tokens (Tree (Arg_Node).Token_Index);
                              Arg_Lex : String := Input_Buffer (Arg_Tok.Start .. Arg_Tok.Start + Arg_Tok.Length - 1);
                           begin
                              Transpiler_Native_HAL.Emit_Raw ("  mov qword [", Success);
                              Transpiler_Native_HAL.Emit_Raw (Arg_Lex, Success);
                              Transpiler_Native_HAL.Emit_Raw ("], rax", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                           end;
                        end if;

                        Out_Tag := Type_U64;
                     elsif Target = Backend_C then
                        if Arg_Node > 0 and then Tree (Arg_Node).Kind = AST_Logic_Var then
                           declare
                              Arg_Tok : Token := Tokens (Tree (Arg_Node).Token_Index);
                              Arg_Lex : String := Input_Buffer (Arg_Tok.Start .. Arg_Tok.Start + Arg_Tok.Length - 1);
                           begin
                              Transpiler_Native_HAL.Emit_Raw ("(" & Arg_Lex & " = ALB_Find(""" & Pred_Lex & """))", Success);
                           end;
                        else
                           Transpiler_Native_HAL.Emit_Raw ("ALB_Find(""" & Pred_Lex & """)", Success);
                        end if;

                        Out_Tag := Type_U64;
                     else
                        Out_Tag := Type_U64;
                     end if;
                  end;
               end;
               
            
            when AST_BinOp =>
               declare
                  Tok        : Token := Tokens (Tree (Node).Token_Index);
                  Mapped_Op  : ALB_Opcode;
                  Left_Node  : Node_Index := Tree(Node).Left_Child;
                  Right_Node : Node_Index := Tree(Node).Right_Child;
                  Left_Expr_Tag  : ALB_Type_Tag := Infer_Type_Tag(Left_Node);
                  Right_Expr_Tag : ALB_Type_Tag := Infer_Type_Tag(Right_Node);
                  Is_Pure    : Boolean := Left_Expr_Tag = Type_Pure or else Right_Expr_Tag = Type_Pure;
                  Is_Pure_Compare : Boolean := False;
                  Is_String_Compare : Boolean := False;
                  Power_Uses_Real : Boolean := False;
               begin
                  case Tok.Kind is
                     when TOK_PLUS   => Mapped_Op := OP_ADD;
                     when TOK_MINUS  => Mapped_Op := OP_SUB;
                     when TOK_MUL    => Mapped_Op := OP_MUL;
                     when TOK_DIV    => Mapped_Op := OP_DIV;
                     
                     -- DA MISSING FORGE LINKS!
                     when TOK_MOD    => Mapped_Op := OP_MOD;
                     when TOK_AND    => Mapped_Op := OP_AND;
                     when TOK_OR     => Mapped_Op := OP_OR;
                     when TOK_XOR    => Mapped_Op := OP_XOR;
                     when TOK_SHL    => Mapped_Op := OP_SHL;
                     when TOK_SHR    => Mapped_Op := OP_SHR;
                     
                     when TOK_ASSIGN | TOK_EQUAL => Mapped_Op := OP_CMP_EQ;
                     when TOK_NOT_EQUAL => Mapped_Op := OP_CMP_NEQ;
                     when TOK_LESS   => Mapped_Op := OP_CMP_LT;
                     when TOK_GREATER => Mapped_Op := OP_CMP_GT;
                     when TOK_LESS_EQUAL => Mapped_Op := OP_CMP_LTE;
                     when TOK_GREATER_EQUAL => Mapped_Op := OP_CMP_GTE;
                     when others     => Mapped_Op := OP_NOP;
                  end case;

                  Power_Uses_Real :=
                    Tok.Kind = TOK_POW
                    and then
                      (Left_Expr_Tag = Type_F64 or else Right_Expr_Tag = Type_F64);

                  -- =========================================================
                  -- COMPILE-TIME DIVIDE BY ZERO SHIELD
                  -- =========================================================
                  if Is_Divide_Or_Mod_Op(Tok.Kind)
                    and then Is_Literal_Zero(Right_Node)
                  then
                     if Tok.Kind = TOK_MOD then
                        Fail_Node(Node, Err_Type_Conflict, "MOD_BY_ZERO", Success, Diag);
                     else
                        Fail_Node(Node, Err_Type_Conflict, "DIVIDE_BY_ZERO", Success, Diag);
                     end if;

                     return;
                  end if;
                  -- =========================================================

                  -- =========================================================
                  -- TASK B3: PIPE-AS-CONCAT WARNING
                  -- Fires when ALL of the following hold simultaneously:
                  --   (a) operator glyph is '|' (TOK_PIPE) -- not '&'
                  --       (using '&' for bitwise OR isn't a common idiom
                  --       in any language so we deliberately skip it).
                  --   (b) both operands inferred as integer scalars.
                  --   (c) this BinOp lives on the RHS of a LET / assign
                  --       whose declared LHS is a numeric integer type
                  --       (Numeric_Assign_Depth > 0).
                  -- The user can silence the warning with a trailing
                  -- "-- PIPE_OK" comment on the same source line as '|'.
                  -- This is a WARNING, not an error: legitimate numeric
                  -- concat (e.g. building a HUD string) must still work.
                  -- =========================================================
                  if Tok.Kind = TOK_PIPE
                    and then Numeric_Assign_Depth > 0
                    and then Left_Expr_Tag in
                        Type_U8 | Type_U16 | Type_U32 | Type_U64 |
                        Type_S8 | Type_S16 | Type_S32 | Type_S64 |
                        Type_HW8 | Type_HW16 | Type_HW32 | Type_HW64 |
                        Type_Boolean
                    and then Right_Expr_Tag in
                        Type_U8 | Type_U16 | Type_U32 | Type_U64 |
                        Type_S8 | Type_S16 | Type_S32 | Type_S64 |
                        Type_HW8 | Type_HW16 | Type_HW32 | Type_HW64 |
                        Type_Boolean
                  then
                     declare
                        Suppress : Boolean := False;
                        Scan_End : Natural := Tok.Start;
                     begin
                        -- Walk forward from the '|' token to end-of-line
                        -- (or end-of-buffer) looking for "-- PIPE_OK".
                        while Scan_End <= Input_Buffer'Last
                          and then Input_Buffer (Scan_End) /= ASCII.LF
                          and then Input_Buffer (Scan_End) /= ASCII.CR
                        loop
                           if Scan_End + 9 <= Input_Buffer'Last
                             and then
                               Input_Buffer (Scan_End .. Scan_End + 9) =
                                 "-- PIPE_OK"
                           then
                              Suppress := True;
                              exit;
                           end if;
                           Scan_End := Scan_End + 1;
                        end loop;

                        if not Suppress then
                           Pipe_Warn_Count := Pipe_Warn_Count + 1;
                           -- Always print to stderr-equivalent so the
                           -- warning surfaces even when --quiet is set
                           -- (warnings are non-info and must be visible).
                           Ada.Text_IO.Put_Line ("");
                           Ada.Text_IO.Put_Line ("PIPE-AS-CONCAT WARNING");
                           Ada.Text_IO.Put_Line
                             ("  Location : line " &
                              Positive'Image (Tok.Line) &
                              ", column " &
                              Positive'Image (Tok.Column));
                           Ada.Text_IO.Put_Line
                             ("  The | operator in ALB is STRING CONCAT, not bitwise OR.");
                           Ada.Text_IO.Put_Line
                             ("  If you intended bitwise OR  use the keyword  OR  instead.");
                           Ada.Text_IO.Put_Line
                             ("  If you intended bitwise XOR use the keyword  XOR  instead.");
                           Ada.Text_IO.Put_Line
                             ("  If you intended to concatenate two numbers into a string,");
                           Ada.Text_IO.Put_Line
                             ("  ignore this warning, or add a trailing  -- PIPE_OK  comment");
                           Ada.Text_IO.Put_Line ("  to silence it.");
                           if Log_Opened then
                              Ada.Text_IO.Put_Line
                                (Log_File,
                                 "PIPE-AS-CONCAT WARNING at line " &
                                 Positive'Image (Tok.Line) &
                                 " col " &
                                 Positive'Image (Tok.Column));
                           end if;
                        end if;
                     end;
                  end if;
                  -- =========================================================

                  -- =========================================================
                  -- SYMBOLIC CONSTANT FOLDING (Task A1)
                  -- When inside a SYMBOLIC ... END SYMBOLIC block, fold
                  -- integer-literal-only BinOps at emit time into a single
                  -- mov rax, <result> (FASM) or ((uint64_t)<result>) (C).
                  -- Skips PURE (128-bit) math and any non-foldable operator
                  -- (comparisons handled later).
                  -- =========================================================
                  if Symbolic_Depth > 0
                    and then Target in Backend_FASM | Backend_C
                    and then not Is_Pure
                  then
                     declare
                        L_Val  : U64 := 0;
                        R_Val  : U64 := 0;
                        Res    : U64 := 0;
                        Folded : Boolean := False;
                     begin
                        if Try_Literal_U64 (Left_Node, L_Val)
                          and then Try_Literal_U64 (Right_Node, R_Val)
                        then
                           case Mapped_Op is
                              when OP_ADD =>
                                 Res := L_Val + R_Val; Folded := True;
                              when OP_SUB =>
                                 Res := L_Val - R_Val; Folded := True;
                              when OP_MUL =>
                                 Res := L_Val * R_Val; Folded := True;
                              when OP_DIV =>
                                 if R_Val /= 0 then
                                    Res := L_Val / R_Val; Folded := True;
                                 end if;
                              when OP_MOD =>
                                 if R_Val /= 0 then
                                    Res := L_Val mod R_Val; Folded := True;
                                 end if;
                              when OP_AND =>
                                 Res := L_Val and R_Val; Folded := True;
                              when OP_OR =>
                                 Res := L_Val or R_Val; Folded := True;
                              when OP_XOR =>
                                 Res := L_Val xor R_Val; Folded := True;
                              when OP_LOGICAL_AND =>
                                 Res := L_Val and R_Val; Folded := True;
                              when OP_LOGICAL_OR =>
                                 Res := L_Val or R_Val; Folded := True;
                              when others =>
                                 if Tok.Kind = TOK_POW then
                                    Res := Static_Int_Pow_U64 (L_Val, R_Val);
                                    Folded := True;
                                 end if;
                           end case;
                           if Folded then
                              if Target = Backend_FASM then
                                 Transpiler_Native_HAL.Emit_Raw
                                   ("  ; SYMBOLIC fold: " & U64_Img (L_Val) &
                                    " op " & U64_Img (R_Val) &
                                    " = " & U64_Img (Res), Success);
                                 Transpiler_Native_HAL.Emit_Newline (Success);
                                 Transpiler_Native_HAL.Emit_Raw
                                   ("  mov rax, " & U64_Img (Res), Success);
                                 Transpiler_Native_HAL.Emit_Newline (Success);
                              else
                                 -- Backend_C: drop a literal in place of the
                                 -- BinOp.  This appears in expression
                                 -- context so we MUST NOT emit a newline.
                                 Transpiler_Native_HAL.Emit_Raw
                                   ("((uint64_t)" & U64_Img (Res) & "u)",
                                    Success);
                              end if;
                              Out_Tag := Type_U64;
                              return;
                           end if;
                        end if;
                     end;
                  end if;
                  -- =========================================================

                  Is_Pure_Compare :=
                    Is_Pure and then
                    (Mapped_Op = OP_CMP_EQ or else Mapped_Op = OP_CMP_NEQ or else
                     Mapped_Op = OP_CMP_LT or else Mapped_Op = OP_CMP_GT or else
                     Mapped_Op = OP_CMP_LTE or else Mapped_Op = OP_CMP_GTE);

                  Is_String_Compare :=
                    (Mapped_Op = OP_CMP_EQ or else Mapped_Op = OP_CMP_NEQ)
                    and then
                    (Left_Expr_Tag = Type_Binary or else Right_Expr_Tag = Type_Binary);

                  -- DA NEW OPERATOR SUGAR logic!
                  if Tok.Kind = TOK_POW then
                     if Is_Pure then
                        Fail_Node
                          (Node,
                           Err_Type_Conflict,
                           "POWER expects numeric scalars; PURE remains a separate exact-rational path",
                           Success,
                           Diag);
                        return;
                     elsif Target = Backend_FASM16 then
                        Fail_Node
                          (Node,
                           Err_Type_Conflict,
                           "POWER is unavailable on FASM16",
                           Success,
                           Diag);
                        return;
                     elsif Target = Backend_FASM then
                        declare
                           Label_Base : constant String := ".ALB_POW_" & Trim_Image (Integer (Node));
                        begin
                           Walk_AST (Tree (Node).Left_Child, Depth + 1, Left_Tag, Success, Diag);
                           Transpiler_Native_HAL.Emit_Raw ("  push rax", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);

                           Walk_AST (Tree (Node).Right_Child, Depth + 1, Right_Tag, Success, Diag);
                           Transpiler_Native_HAL.Emit_Raw ("  mov rbx, rax", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);

                           Transpiler_Native_HAL.Emit_Raw ("  pop rax", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);

                           if Power_Uses_Real then
                              --  Nested REAL expressions can leave one saved
                              --  value on the stack, so realign defensively
                              --  around the imported Win64 call.
                              Transpiler_Native_HAL.Emit_Raw ("  push r12", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  mov r12, rsp", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  and rsp, -16", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  sub rsp, 32", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  movq xmm0, rax", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  movq xmm1, rbx", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  call [pow]", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  movq rax, xmm0", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  mov rsp, r12", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  pop r12", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                           else
                              Transpiler_Native_HAL.Emit_Raw ("  mov rcx, rbx", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  mov r8, 1", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  mov r9, rax", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  test rcx, rcx", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  jns " & Label_Base & "_POS", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  cmp r9, 1", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  je " & Label_Base & "_DONE", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  cmp r9, -1", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  jne " & Label_Base & "_NEG_ZERO", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  test cl, 1", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  jz " & Label_Base & "_DONE", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  mov r8, -1", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  jmp " & Label_Base & "_DONE", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw (Label_Base & "_NEG_ZERO:", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  xor r8, r8", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  jmp " & Label_Base & "_DONE", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw (Label_Base & "_POS:", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  test rcx, rcx", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  jz " & Label_Base & "_DONE", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw (Label_Base & "_LOOP:", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  test rcx, 1", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  jz " & Label_Base & "_SKIP_MUL", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  imul r8, r9", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw (Label_Base & "_SKIP_MUL:", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  shr rcx, 1", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  jz " & Label_Base & "_DONE", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  imul r9, r9", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  jmp " & Label_Base & "_LOOP", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw (Label_Base & "_DONE:", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                              Transpiler_Native_HAL.Emit_Raw ("  mov rax, r8", Success);
                              Transpiler_Native_HAL.Emit_Newline (Success);
                           end if;
                        end;
                     else
                        if Power_Uses_Real then
                           Transpiler_Native_HAL.Emit_Raw ("ALB_Double_As_U64(pow(ALB_U64_As_Double(", Success);
                           Walk_AST (Tree (Node).Left_Child, Depth + 1, Left_Tag, Success, Diag);
                           Transpiler_Native_HAL.Emit_Raw ("), ALB_U64_As_Double(", Success);
                           Walk_AST (Tree (Node).Right_Child, Depth + 1, Right_Tag, Success, Diag);
                           Transpiler_Native_HAL.Emit_Raw (")))", Success);
                        else
                           Transpiler_Native_HAL.Emit_Raw ("((uint64_t)ALB_POW_S64((int64_t)(", Success);
                           Walk_AST (Tree (Node).Left_Child, Depth + 1, Left_Tag, Success, Diag);
                           Transpiler_Native_HAL.Emit_Raw ("), (int64_t)(", Success);
                           Walk_AST (Tree (Node).Right_Child, Depth + 1, Right_Tag, Success, Diag);
                           Transpiler_Native_HAL.Emit_Raw (")))", Success);
                        end if;
                     end if;
                  elsif Is_Pure and (Mapped_Op in OP_ADD .. OP_DIV) then
                     if Target = Backend_FASM then
                        -- FASM native 128-bit PURE math forge!
                        -- We emit fastcalls tae prevent C macros leakin' intae asm!
                        Walk_AST (Tree (Node).Left_Child, Depth + 1, Left_Tag, Success, Diag);
                        Transpiler_Native_HAL.Emit_Raw ("  push rax", Success); Transpiler_Native_HAL.Emit_Newline (Success);
                        
                        Walk_AST (Tree (Node).Right_Child, Depth + 1, Right_Tag, Success, Diag);
                        Transpiler_Native_HAL.Emit_Raw ("  mov rdx, rax", Success); Transpiler_Native_HAL.Emit_Newline (Success);
                        
                        Transpiler_Native_HAL.Emit_Raw ("  pop rcx", Success); Transpiler_Native_HAL.Emit_Newline (Success);
                        
                        if Mapped_Op = OP_ADD then Transpiler_Native_HAL.Emit_Raw ("  fastcall ALB_Pure_Add", Success);
                        elsif Mapped_Op = OP_SUB then Transpiler_Native_HAL.Emit_Raw ("  fastcall ALB_Pure_Sub", Success);
                        elsif Mapped_Op = OP_MUL then Transpiler_Native_HAL.Emit_Raw ("  fastcall ALB_Pure_Mul", Success);
                        else Transpiler_Native_HAL.Emit_Raw ("  fastcall ALB_Pure_Div", Success);
                        end if;
                        Transpiler_Native_HAL.Emit_Newline (Success);
                     elsif Target = Backend_FASM16 then
                        Walk_AST (Tree (Node).Left_Child, Depth + 1, Left_Tag, Success, Diag);
                        Transpiler_Native_HAL.Emit_Raw ("  push dx", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  push ax", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);

                        Walk_AST (Tree (Node).Right_Child, Depth + 1, Right_Tag, Success, Diag);
                        Transpiler_Native_HAL.Emit_Raw ("  mov bx, ax", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  mov cx, dx", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  pop ax", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  pop dx", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);

                        if Mapped_Op = OP_ADD then
                           Transpiler_Native_HAL.Emit_Raw ("  call ALB16_Pure_Add", Success);
                        elsif Mapped_Op = OP_SUB then
                           Transpiler_Native_HAL.Emit_Raw ("  call ALB16_Pure_Sub", Success);
                        elsif Mapped_Op = OP_MUL then
                           Transpiler_Native_HAL.Emit_Raw ("  call ALB16_Pure_Mul", Success);
                        else
                           Transpiler_Native_HAL.Emit_Raw ("  call ALB16_Pure_Div", Success);
                        end if;
                        Transpiler_Native_HAL.Emit_Newline (Success);
                     else
                        -- C-emission logic bides here perfectly safe
                        if Mapped_Op = OP_ADD then Transpiler_Native_HAL.Emit_Raw ("ALB_PURE_ADD(", Success);
                        elsif Mapped_Op = OP_SUB then Transpiler_Native_HAL.Emit_Raw ("ALB_PURE_SUB(", Success);
                        elsif Mapped_Op = OP_MUL then Transpiler_Native_HAL.Emit_Raw ("ALB_PURE_MUL(", Success);
                        else Transpiler_Native_HAL.Emit_Raw ("ALB_PURE_DIV(", Success);
                        end if;
                        Walk_AST (Tree (Node).Left_Child, Depth + 1, Left_Tag, Success, Diag);
                        Transpiler_Native_HAL.Emit_Comma (Success);
                        Walk_AST (Tree (Node).Right_Child, Depth + 1, Right_Tag, Success, Diag);
                        Transpiler_Native_HAL.Emit_Raw (")", Success);
                     end if;

                  elsif Is_Pure_Compare then
                     if Target = Backend_FASM then
                        Walk_AST (Tree (Node).Left_Child, Depth + 1, Left_Tag, Success, Diag);
                        Transpiler_Native_HAL.Emit_Raw ("  push rax", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);

                        Walk_AST (Tree (Node).Right_Child, Depth + 1, Right_Tag, Success, Diag);
                        Transpiler_Native_HAL.Emit_Raw ("  mov rcx, 0xFFFFFFFF", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  mov r10, rax", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  sar r10, 32", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  mov r11, rax", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  and r11, rcx", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);

                        Transpiler_Native_HAL.Emit_Raw ("  pop rax", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  mov r8, rax", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  sar r8, 32", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  mov r9, rax", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);
                        Transpiler_Native_HAL.Emit_Raw ("  and r9, rcx", Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);

