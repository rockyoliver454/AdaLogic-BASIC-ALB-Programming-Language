            when AST_Read_Process_Memory_Stmt =>
               declare
                  Handle_Node  : constant Node_Index := Tree (Node).Left_Child;
                  Addr_Node    : constant Node_Index := Tree (Node).Right_Child;
                  Target_Node  : constant Node_Index :=
                    (if Addr_Node > 0 then Tree (Addr_Node).Next_Sibling else 0);
                  Handle_Name  : constant String := Process_Handle_Name (Handle_Node);
                  Target_Name  : constant String := Simple_Var_Name (Target_Node);
                  Target_Found : Boolean := False;
                  Target_Sym   : Symbol_Record;
                  Buffer_Tag   : ALB_Type_Tag := Type_None;
                  Buffer_Bytes : Natural := 0;
               begin
                  if Target /= Backend_FASM and then Target /= Backend_C then
                     Fail_Node (Node, Err_Type_Conflict, "READ_PROCESS_MEMORY", Success, Diag);
                     return;
                  end if;

                  if Target = Backend_C then
                     -- Track 7 (C): scalar/buffer read via Win32 ReadProcessMemory.
                     Ensure_Process_Runtime_C;

                     if Handle_Name'Length = 0 or else Addr_Node = 0 or else Target_Name'Length = 0 then
                        Fail_Node (Node, Err_Type_Conflict, "READ_PROCESS_MEMORY", Success, Diag);
                        return;
                     end if;

                     Ensure_Firewall_Access (Target_Node, False, True, Node, Success, Diag);
                     if not Success then
                        return;
                     end if;

                     Find_Symbol_Visible (Target_Name, Target_Found, Target_Sym);
                     if not Target_Found then
                        Fail_Node (Node, Err_Type_Conflict, Target_Name, Success, Diag);
                        return;
                     end if;

                     declare
                        Buf_Cells : constant Natural :=
                          (if Find_Strict_Array (Target_Name) > 0
                           then Strict_Array_Total_Elements
                                  (Find_Strict_Array (Target_Name))
                           else 0);
                     begin
                        Transpiler_Native_HAL.Emit_Indent (Success);
                        Transpiler_Native_HAL.Emit_Raw
                          ("ALB_PROC_Ensure(&" & Handle_Name & ", ALB_PROCCFG_" &
                           Handle_Name & "_PID, ALB_PROCCFG_" & Handle_Name &
                           "_IMAGE_C, ALB_PROCCFG_" & Handle_Name & "_Rights);",
                           Success);
                        Transpiler_Native_HAL.Emit_Newline (Success);

                        if Buf_Cells > 0 then
                           Transpiler_Native_HAL.Emit_Indent (Success);
                           Transpiler_Native_HAL.Emit_Raw
                             ("ALB_PROC_Read_Buffer(" & Handle_Name & ", (uint64_t)(",
                              Success);
                           Walk_AST (Addr_Node, Depth + 1, Right_Tag, Success, Diag);
                           if not Success then return; end if;
                           Transpiler_Native_HAL.Emit_Raw
                             ("), &" & Target_Name & "[1], " &
                              Nat_Img (Buf_Cells) & ");",
                              Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                        else
                           Transpiler_Native_HAL.Emit_Indent (Success);
                           Transpiler_Native_HAL.Emit_Raw
                             (Target_Name & " = ALB_PROC_Read_Scalar(" &
                              Handle_Name & ", (uint64_t)(",
                              Success);
                           Walk_AST (Addr_Node, Depth + 1, Right_Tag, Success, Diag);
                           if not Success then return; end if;
                           Transpiler_Native_HAL.Emit_Raw ("), 8);", Success);
                           Transpiler_Native_HAL.Emit_Newline (Success);
                        end if;
                     end;

                     Out_Tag := Type_None;
                     return;
                  end if;

                  if Handle_Name'Length = 0 or else Addr_Node = 0 or else Target_Name'Length = 0 then
                     Fail_Node (Node, Err_Type_Conflict, "READ_PROCESS_MEMORY", Success, Diag);
                     return;
                  end if;

                  Ensure_Firewall_Access (Target_Node, False, True, Node, Success, Diag);
                  if not Success then
                     return;
                  end if;

                  Find_Symbol_Visible (Target_Name, Target_Found, Target_Sym);
                  if not Target_Found then
                     Fail_Node (Node, Err_Type_Conflict, Target_Name, Success, Diag);
                     return;
                  end if;

                  Buffer_Tag := Array_Declared_Tag (Target_Name, Target_Sym.Tag);
                  Buffer_Bytes := Array_Byte_Size (Target_Name, Buffer_Tag);

                  Walk_AST (Addr_Node, Depth + 1, Right_Tag, Success, Diag);
                  if not Success then
                     return;
                  end if;
                  Transpiler_Native_HAL.Emit_Raw ("  mov r10, rax", Success);
                  Transpiler_Native_HAL.Emit_Newline (Success);

                  Emit_FASM_Process_Config_Load
                    (Handle_Node,
                     Proc_Right_Read or Proc_Right_Query,
                     Node,
                     Success,
                     Diag);
                  if not Success then
                     return;
                  end if;

                  if Buffer_Bytes > 0 then
                     Emit_FASM_Array_Data_Address (Target_Name, Target_Sym.Tag, "r11", Success);
                     if not Success then
                        return;
                     end if;

                     Transpiler_Native_HAL.Emit_Raw ("  sub rsp, 64", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Emit_Raw ("  mov qword [rsp + 32], r10", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Emit_Raw ("  mov qword [rsp + 40], r11", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Emit_Raw
                       ("  mov qword [rsp + 48], " & Nat_Img (Buffer_Bytes), Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Emit_Raw ("  call ALB_PROC_Read_Buffer", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Emit_Raw ("  add rsp, 64", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                  else
                     if Target_Sym.Tag not in Type_U8 | Type_U16 | Type_U32 | Type_U64 | Type_S32 | Type_S64 | Type_Boolean then
                        Fail_Node (Node, Err_Type_Conflict, Target_Name, Success, Diag);
                        return;
                     end if;

                     Transpiler_Native_HAL.Emit_Raw ("  sub rsp, 64", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Emit_Raw ("  mov qword [rsp + 32], r10", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Emit_Raw
                       ("  mov qword [rsp + 40], " &
                        Nat_Img (Process_Scalar_Code (Target_Sym.Tag)),
                        Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Emit_Raw ("  call ALB_PROC_Read_Scalar", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Transpiler_Native_HAL.Emit_Raw ("  add rsp, 64", Success);
                     Transpiler_Native_HAL.Emit_Newline (Success);
                     Emit_FASM_Store_RAX_To_Scalar (Target_Name, Target_Sym.Tag, Success);
                  end if;

                  Out_Tag := Type_None;
               end;

            when AST_Write_Process_Memory_Stmt =>
               declare
                  Handle_Node  : constant Node_Index := Tree (Node).Left_Child;
                  Addr_Node    : constant Node_Index := Tree (Node).Right_Child;
