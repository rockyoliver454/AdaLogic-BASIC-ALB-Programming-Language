                                     Transpiler_Native_HAL.Emit_Raw ("  jg " & L_True, Success);
                                     Transpiler_Native_HAL.Emit_Newline (Success);
                                     Transpiler_Native_HAL.Emit_Raw ("  jl " & L_False, Success);
