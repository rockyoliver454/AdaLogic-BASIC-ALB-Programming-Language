                                     Transpiler_Native_HAL.Emit_Raw ("  ja " & L_True, Success);
                                     Transpiler_Native_HAL.Emit_Newline (Success);
                                     Transpiler_Native_HAL.Emit_Raw ("  jb " & L_False, Success);
                                  end if;
                                  Transpiler_Native_HAL.Emit_Newline (Success);
                                  Transpiler_Native_HAL.Emit_Raw ("  cmp ax, bx", Success);
                                  Transpiler_Native_HAL.Emit_Newline (Success);
                                  Transpiler_Native_HAL.Emit_Raw ("  ja " & L_True, Success);

                               elsif Mapped_Op = OP_CMP_LTE then
                                  Transpiler_Native_HAL.Emit_Raw ("  cmp dx, cx", Success);
                                  Transpiler_Native_HAL.Emit_Newline (Success);
                                  if Is_Signed_Compare then
                                     Transpiler_Native_HAL.Emit_Raw ("  jl " & L_True, Success);
                                     Transpiler_Native_HAL.Emit_Newline (Success);
                                     Transpiler_Native_HAL.Emit_Raw ("  jg " & L_False, Success);
                                  else
                                     Transpiler_Native_HAL.Emit_Raw ("  jb " & L_True, Success);
                                     Transpiler_Native_HAL.Emit_Newline (Success);
                                     Transpiler_Native_HAL.Emit_Raw ("  ja " & L_False, Success);
