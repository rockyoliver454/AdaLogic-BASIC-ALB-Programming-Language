         procedure Emit_FASM16_Temporal_Future_Common_Decls
           (Success : in out Boolean)
         is
            Has_State  : Boolean := False;
            First_Term : Boolean := True;
         begin
            if Temporal_Future_Used then
               return;
            end if;

            Temporal_Future_Used := True;
            Transpiler_Native_HAL.Set_Global_Buffer_Mode (True);

            Transpiler_Native_HAL.Emit_Raw ("  ALB16_TEMP_Future_KB rb ALB16_Fact_Size * 1024", Success);
            Transpiler_Native_HAL.Emit_Newline (Success);

            for I in 1 .. Chrono_Count loop
