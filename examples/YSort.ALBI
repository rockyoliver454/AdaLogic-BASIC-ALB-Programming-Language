-- ====================================================================
-- YSORT.ALBI
-- Dynamic Depth-Sorted Render Queue
-- ====================================================================

VERSION 1.0

DECLARE MODULE YSort
    PROCEDURE Reset()
    PROCEDURE Push(tex_id AS S32, sx AS S32, sy AS S32, sw AS S32, sh AS S32, dx AS S32, dy AS S32, dw AS S32, dh AS S32, tint AS S32, sort_y AS S32)
    PROCEDURE DrawAll()
END DECLARE MODULE

MODULE YSort

    LET op_count AS S32 = 0
    LET max_ops AS S32 = 4096

    STRICT op_tex[4096]  AS S32
    STRICT op_sx[4096]   AS S32
    STRICT op_sy[4096]   AS S32
    STRICT op_sw[4096]   AS S32
    STRICT op_sh[4096]   AS S32
    STRICT op_dx[4096]   AS S32
    STRICT op_dy[4096]   AS S32
    STRICT op_dw[4096]   AS S32
    STRICT op_dh[4096]   AS S32
    STRICT op_col[4096]  AS S32
    STRICT op_sort[4096] AS S32

    PROCEDURE Reset()
        op_count = 0
    END PROCEDURE

    PROCEDURE Push(tex_id AS S32, sx AS S32, sy AS S32, sw AS S32, sh AS S32, dx AS S32, dy AS S32, dw AS S32, dh AS S32, tint AS S32, sort_y AS S32)
        IF op_count < max_ops THEN
            op_count = op_count + 1
            op_tex[op_count] = tex_id
            op_sx[op_count] = sx
            op_sy[op_count] = sy
            op_sw[op_count] = sw
            op_sh[op_count] = sh
            op_dx[op_count] = dx
            op_dy[op_count] = dy
            op_dw[op_count] = dw
            op_dh[op_count] = dh
            op_col[op_count] = tint
            op_sort[op_count] = sort_y
        END IF
    END PROCEDURE

    PROCEDURE DrawAll()
        IF op_count = 0 THEN RETURN END IF

        -- HOISTED JVM-SAFE VARS
        LET s AS S32 = 1
        LET swapped AS U64 = 1
        
        LET t_tex  AS S32 = 0 
        LET t_sx   AS S32 = 0 LET t_sy AS S32 = 0 LET t_sw AS S32 = 0 LET t_sh AS S32 = 0 
        LET t_dx   AS S32 = 0 LET t_dy AS S32 = 0 LET t_dw AS S32 = 0 LET t_dh AS S32 = 0 
        LET t_col  AS S32 = 0 
        LET t_sort AS S32 = 0

        -- Insertion Sort logic converted to Bubble for array safety in flat memory
        swapped = 1
        WHILE swapped = 1
            swapped = 0
            s = 1
            WHILE s < op_count
                IF op_sort[s] > op_sort[s + 1] THEN
                    t_sort = op_sort[s] op_sort[s] = op_sort[s + 1] op_sort[s + 1] = t_sort
                    t_tex = op_tex[s] op_tex[s] = op_tex[s + 1] op_tex[s + 1] = t_tex
                    t_sx = op_sx[s] op_sx[s] = op_sx[s + 1] op_sx[s + 1] = t_sx
                    t_sy = op_sy[s] op_sy[s] = op_sy[s + 1] op_sy[s + 1] = t_sy
                    t_sw = op_sw[s] op_sw[s] = op_sw[s + 1] op_sw[s + 1] = t_sw
                    t_sh = op_sh[s] op_sh[s] = op_sh[s + 1] op_sh[s + 1] = t_sh
                    t_dx = op_dx[s] op_dx[s] = op_dx[s + 1] op_dx[s + 1] = t_dx
                    t_dy = op_dy[s] op_dy[s] = op_dy[s + 1] op_dy[s + 1] = t_dy
                    t_dw = op_dw[s] op_dw[s] = op_dw[s + 1] op_dw[s + 1] = t_dw
                    t_dh = op_dh[s] op_dh[s] = op_dh[s + 1] op_dh[s + 1] = t_dh
                    t_col = op_col[s] op_col[s] = op_col[s + 1] op_col[s + 1] = t_col
                    
                    swapped = 1
                END IF
                s = s + 1
            END WHILE
        END WHILE

        -- Flush Buffer to Screen
        s = 1
        WHILE s <= op_count
            COLOR op_col[s]
            FILL RECT op_dx[s], op_dy[s], op_dw[s], op_dh[s]
            s = s + 1
        END WHILE
    END PROCEDURE

END MODULE