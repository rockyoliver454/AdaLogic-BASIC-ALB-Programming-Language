-- ====================================================================
-- COLORS.ALBI
-- Named color constants for ALB UI work.
-- Hex values are 24-bit RGB in $RRGGBB form.
-- ====================================================================

-- --------------------------------------------------------------------
-- BASIC COLORS
-- --------------------------------------------------------------------
#CLR_BLACK        = $000000
#CLR_WHITE        = $FFFFFF
#CLR_RED          = $FF0000
#CLR_GREEN        = $00FF00
#CLR_BLUE         = $0000FF
#CLR_YELLOW       = $FFFF00
#CLR_CYAN         = $00FFFF
#CLR_MAGENTA      = $FF00FF
#CLR_ORANGE       = $FF8800
#CLR_BROWN        = $8B5A2B
#CLR_GOLD         = $D4AF37
#CLR_PINK         = $FF88CC
#CLR_VIOLET       = $8844FF
#CLR_LIME         = $99FF00
#CLR_NAVY         = $001840
#CLR_TEAL         = $004C4C
#CLR_OLIVE        = $666600
#CLR_MAROON       = $550000

-- --------------------------------------------------------------------
-- GRAYSCALE
-- --------------------------------------------------------------------
#GRAY_00          = $000000
#GRAY_10          = $1A1A1A
#GRAY_20          = $333333
